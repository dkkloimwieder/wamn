#!/usr/bin/env bash
# Remove explicitly named, retired wamn-gates images from every kind node.

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: kind-gate-image-remove --image REF [--image REF ...] [options]
  --cluster NAME                  kind cluster name (default: wamn)
  --image REF                     Exact wamn-gates tag to remove; repeatable
  --apply                         Perform the planned removals (default: dry-run)
  --remove-orphaned-containers    Remove exited CRI containers whose Pod is gone

Protected tags (dev, latest, and callable-flow-base-*) are always refused.
The command refuses a selected image when its content is shared by an
unselected tag or referenced by a Kubernetes workload.
EOF
}

cluster=wamn
apply=false
remove_orphaned_containers=false
declare -a requested_images=()

while (($#)); do
  case "$1" in
    --cluster) cluster=${2-}; shift 2 ;;
    --image) requested_images+=("${2-}"); shift 2 ;;
    --apply) apply=true; shift ;;
    --remove-orphaned-containers) remove_orphaned_containers=true; shift ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage; exit 2 ;;
  esac
done

if [[ ! "$cluster" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then
  echo "invalid --cluster value: $cluster" >&2
  exit 2
fi
if ((${#requested_images[@]} == 0)); then
  usage
  exit 2
fi

kind_executable=${KIND:-kind}
docker_executable=${DOCKER:-docker}
kubectl_executable=${KUBECTL:-kubectl}

for required in "$kind_executable" "$docker_executable" "$kubectl_executable" jq awk; do
  if ! command -v "$required" >/dev/null 2>&1; then
    echo "required executable not found: $required" >&2
    exit 2
  fi
done

normalize_gate_image() {
  local input=$1 tag
  case "$input" in
    wamn-gates:*) tag=${input#wamn-gates:} ;;
    docker.io/library/wamn-gates:*) tag=${input#docker.io/library/wamn-gates:} ;;
    *) return 1 ;;
  esac
  [[ "$tag" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]] || return 1
  printf 'docker.io/library/wamn-gates:%s' "$tag"
}

is_internal_kind_alias() {
  local reference=$1
  [[ "$reference" =~ ^sha256:[0-9a-f]{64}$ ]] ||
    [[ "$reference" =~ ^import-[0-9]{4}-[0-9]{2}-[0-9]{2}@sha256:[0-9a-f]{64}$ ]] ||
    [[ "$reference" =~ ^docker\.io/library/import-[0-9]{4}-[0-9]{2}-[0-9]{2}@sha256:[0-9a-f]{64}$ ]]
}

declare -a images=()
declare -A selected_images=()
for requested in "${requested_images[@]}"; do
  if ! canonical=$(normalize_gate_image "$requested"); then
    echo "refusing non-exact wamn-gates tag: $requested" >&2
    exit 2
  fi
  tag=${canonical#docker.io/library/wamn-gates:}
  case "$tag" in
    dev|latest|callable-flow-base-*)
      echo "refusing protected gate image: $requested" >&2
      exit 2
      ;;
  esac
  if [[ -z ${selected_images[$canonical]+present} ]]; then
    images+=("$canonical")
    selected_images[$canonical]=1
  fi
done

if ! node_output=$("$kind_executable" get nodes --name "$cluster"); then
  echo "failed to list nodes for kind cluster $cluster" >&2
  exit 1
fi
mapfile -t nodes < <(awk 'NF {print}' <<<"$node_output")
if ((${#nodes[@]} == 0)); then
  echo "kind cluster $cluster has no nodes" >&2
  exit 1
fi
for node in "${nodes[@]}"; do
  if [[ ! "$node" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then
    echo "kind returned an invalid node name: $node" >&2
    exit 1
  fi
done

context="kind-$cluster"
if ! pods_json=$("$kubectl_executable" --context "$context" get pods \
    --all-namespaces -o json); then
  echo "failed to list Pods through Kubernetes context $context" >&2
  exit 1
fi
if ! workloads_json=$("$kubectl_executable" --context "$context" get \
    deployments,statefulsets,daemonsets,replicasets,jobs,cronjobs \
    --all-namespaces -o json); then
  echo "failed to list workload image references through Kubernetes context $context" >&2
  exit 1
fi
if ! jq -e '.items | type == "array"' >/dev/null <<<"$pods_json" ||
   ! jq -e '.items | type == "array"' >/dev/null <<<"$workloads_json"; then
  echo "Kubernetes returned invalid inventory JSON" >&2
  exit 1
fi

work=$(mktemp -d)
cleanup() {
  rm -rf -- "$work"
}
trap cleanup EXIT
blockers="$work/blockers"
: >"$blockers"
pod_uid_inventory="$work/pod-uids"
pod_reference_inventory="$work/pod-references"
workload_reference_inventory="$work/workload-references"

if ! jq -r '.items[].metadata.uid // empty' <<<"$pods_json" >"$pod_uid_inventory"; then
  echo "failed to parse Kubernetes Pod UIDs" >&2
  exit 1
fi
if ! jq -r '
  .items[] as $pod
  | ($pod.spec.initContainers[]?, $pod.spec.containers[]?,
     $pod.spec.ephemeralContainers[]?)
  | ["Pod/\($pod.metadata.namespace)/\($pod.metadata.name)", .image]
  | @tsv
' <<<"$pods_json" >"$pod_reference_inventory"; then
  echo "failed to parse Kubernetes Pod image references" >&2
  exit 1
fi
if ! jq -r '
  .items[] as $workload
  | (if $workload.kind == "CronJob"
     then $workload.spec.jobTemplate.spec.template.spec
     else $workload.spec.template.spec end) as $spec
  | ($spec.initContainers[]?, $spec.containers[]?,
     $spec.ephemeralContainers[]?)
  | ["\($workload.kind)/\($workload.metadata.namespace)/\($workload.metadata.name)", .image]
  | @tsv
' <<<"$workloads_json" >"$workload_reference_inventory"; then
  echo "failed to parse Kubernetes workload image references" >&2
  exit 1
fi

declare -A live_pod_uids=()
while IFS= read -r uid; do
  [[ -n "$uid" ]] && live_pod_uids[$uid]=1
done <"$pod_uid_inventory"

record_workload_blocker() {
  local owner=$1 reference=$2 canonical
  if canonical=$(normalize_gate_image "$reference") &&
     [[ -n ${selected_images[$canonical]+present} ]]; then
    printf 'BLOCKED reference=%s reason=kubernetes-reference owner=%s\n' \
      "$canonical" "$owner" | tee -a "$blockers" >&2
  fi
}

while IFS=$'\t' read -r owner reference; do
  [[ -n "$owner" && -n "$reference" ]] &&
    record_workload_blocker "$owner" "$reference"
done <"$pod_reference_inventory"

while IFS=$'\t' read -r owner reference; do
  [[ -n "$owner" && -n "$reference" ]] &&
    record_workload_blocker "$owner" "$reference"
done <"$workload_reference_inventory"

image_plan_count=0
container_plan_count=0
for node in "${nodes[@]}"; do
  node_key=${node//[^A-Za-z0-9_.-]/_}
  cri_images="$work/$node_key.cri-images.json"
  cri_containers="$work/$node_key.cri-containers.json"
  image_inventory="$work/$node_key.images.tsv"
  image_plan="$work/$node_key.image-plan"
  alias_plan="$work/$node_key.alias-plan"
  container_plan="$work/$node_key.container-plan"
  : >"$image_plan"
  : >"$alias_plan"
  : >"$container_plan"

  if ! "$docker_executable" exec "$node" crictl images -o json >"$cri_images"; then
    echo "failed to list CRI images on kind node $node" >&2
    exit 1
  fi
  if ! "$docker_executable" exec "$node" crictl ps -a -o json >"$cri_containers"; then
    echo "failed to list CRI containers on kind node $node" >&2
    exit 1
  fi
  if ! ctr_images=$("$docker_executable" exec "$node" ctr -n k8s.io images ls); then
    echo "failed to list containerd images on kind node $node" >&2
    exit 1
  fi
  if ! jq -e '.images | type == "array"' "$cri_images" >/dev/null ||
     ! jq -e '.containers | type == "array"' "$cri_containers" >/dev/null; then
    echo "kind node $node returned invalid CRI inventory JSON" >&2
    exit 1
  fi
  awk 'NR > 1 && $3 ~ /^sha256:[0-9a-f]{64}$/ {print $1 "\t" $3}' \
    <<<"$ctr_images" >"$image_inventory"

  declare -A digest_by_image=()
  declare -A config_by_digest=()
  for image in "${images[@]}"; do
    target_digest=$(awk -F '\t' -v image="$image" '$1 == image {print $2}' \
      "$image_inventory")
    config_id=$(jq -r --arg image "$image" '
      [.images[] | select(any(.repoTags[]?; . == $image)) | .id]
      | unique
      | if length == 0 then ""
        elif length == 1 then .[0]
        else "AMBIGUOUS"
        end
    ' "$cri_images")
    if [[ -z "$target_digest" && -z "$config_id" ]]; then
      printf 'ABSENT node=%s reference=%s\n' "$node" "$image"
      continue
    fi
    if [[ ! "$target_digest" =~ ^sha256:[0-9a-f]{64}$ ]] ||
       [[ ! "$config_id" =~ ^sha256:[0-9a-f]{64}$ ]]; then
      printf 'BLOCKED node=%s reference=%s reason=inconsistent-image-inventory\n' \
        "$node" "$image" | tee -a "$blockers" >&2
      continue
    fi
    digest_by_image[$image]=$target_digest
    if [[ -n ${config_by_digest[$target_digest]+present} &&
          ${config_by_digest[$target_digest]} != "$config_id" ]]; then
      printf 'BLOCKED node=%s reference=%s reason=ambiguous-config-id\n' \
        "$node" "$image" | tee -a "$blockers" >&2
      continue
    fi
    config_by_digest[$target_digest]=$config_id
  done

  declare -A processed_digests=()
  for image in "${images[@]}"; do
    [[ -n ${digest_by_image[$image]+present} ]] || continue
    target_digest=${digest_by_image[$image]}
    [[ -z ${processed_digests[$target_digest]+present} ]] || continue
    processed_digests[$target_digest]=1
    config_id=${config_by_digest[$target_digest]}

    retained=false
    while IFS=$'\t' read -r reference digest; do
      [[ "$digest" == "$target_digest" ]] || continue
      if [[ -z ${selected_images[$reference]+present} ]] &&
         ! is_internal_kind_alias "$reference"; then
        printf 'BLOCKED node=%s digest=%s reason=shared-content retained=%s\n' \
          "$node" "$target_digest" "$reference" | tee -a "$blockers" >&2
        retained=true
      fi
    done <"$image_inventory"
    [[ "$retained" == false ]] || continue

    while IFS=$'\t' read -r reference digest; do
      [[ "$digest" == "$target_digest" ]] || continue
      if is_internal_kind_alias "$reference"; then
        printf '%s\n' "$reference" >>"$alias_plan"
      else
        printf '%s\n' "$reference" >>"$image_plan"
      fi
      printf 'PLAN node=%s remove-image=%s digest=%s\n' \
        "$node" "$reference" "$target_digest"
      ((image_plan_count += 1))
    done <"$image_inventory"

    container_inventory="$work/$node_key.${target_digest#sha256:}.containers.tsv"
    if ! jq -r --arg config_id "$config_id" '
      .containers[]
      | select(
          (.imageId // "") == $config_id or
          (.imageRef // "") == $config_id or
          (.image.image // "") == $config_id)
      | [.id, .state, (.labels["io.kubernetes.pod.uid"] // "-"),
         (.image.userSpecifiedImage // "-"), (.image.image // "-")]
      | @tsv
    ' "$cri_containers" >"$container_inventory"; then
      echo "failed to parse CRI containers on kind node $node" >&2
      exit 1
    fi
    while IFS=$'\t' read -r container_id state pod_uid user_image reported_image; do
      [[ -n "$container_id" ]] || continue
      requested_image=$user_image
      [[ "$requested_image" != - ]] || requested_image=$reported_image
      if ! container_image=$(normalize_gate_image "$requested_image") ||
         [[ -z ${selected_images[$container_image]+present} ]]; then
        printf 'BLOCKED node=%s container=%s reason=container-image-not-selected requested=%s\n' \
          "$node" "$container_id" "$requested_image" | tee -a "$blockers" >&2
      elif [[ "$state" != CONTAINER_EXITED ]]; then
        printf 'BLOCKED node=%s container=%s reason=container-state-%s\n' \
          "$node" "$container_id" "$state" | tee -a "$blockers" >&2
      elif [[ "$pod_uid" == - ]]; then
        printf 'BLOCKED node=%s container=%s reason=missing-pod-uid\n' \
          "$node" "$container_id" | tee -a "$blockers" >&2
      elif [[ -n ${live_pod_uids[$pod_uid]+present} ]]; then
        printf 'BLOCKED node=%s container=%s reason=pod-still-exists pod_uid=%s\n' \
          "$node" "$container_id" "$pod_uid" | tee -a "$blockers" >&2
      elif [[ "$remove_orphaned_containers" != true ]]; then
        printf 'BLOCKED node=%s container=%s reason=orphan-removal-not-authorized\n' \
          "$node" "$container_id" | tee -a "$blockers" >&2
      else
        printf '%s\n' "$container_id" >>"$container_plan"
        printf 'PLAN node=%s remove-orphaned-container=%s\n' "$node" "$container_id"
        ((container_plan_count += 1))
      fi
    done <"$container_inventory"
  done
done

if [[ -s "$blockers" ]]; then
  blocker_count=$(sort -u "$blockers" | wc -l)
  echo "refusing cleanup: $blocker_count blocker(s) found; no changes made" >&2
  exit 1
fi

mode=dry-run
[[ "$apply" == true ]] && mode=apply
printf 'SUMMARY mode=%s cluster=%s nodes=%s selected=%s image_refs=%s orphaned_containers=%s\n' \
  "$mode" "$cluster" "${#nodes[@]}" "${#images[@]}" "$image_plan_count" \
  "$container_plan_count"
if [[ "$apply" != true ]]; then
  exit 0
fi

status=0
for node in "${nodes[@]}"; do
  node_key=${node//[^A-Za-z0-9_.-]/_}
  container_plan="$work/$node_key.container-plan"
  alias_plan="$work/$node_key.alias-plan"
  image_plan="$work/$node_key.image-plan"
  node_status=0
  while IFS= read -r container_id; do
    [[ -n "$container_id" ]] || continue
    if ! "$docker_executable" exec "$node" crictl rm "$container_id"; then
      echo "failed to remove orphaned container $container_id from kind node $node" >&2
      node_status=1
      status=1
    fi
  done <"$container_plan"
  if ((node_status != 0)); then
    echo "preserving image references on $node after container removal failure" >&2
    continue
  fi
  while IFS= read -r reference; do
    [[ -n "$reference" ]] || continue
    if ! "$docker_executable" exec "$node" ctr -n k8s.io images rm --sync \
        "$reference"; then
      echo "failed to remove internal image alias $reference from kind node $node" >&2
      node_status=1
      status=1
    fi
  done <"$alias_plan"
  if ((node_status != 0)); then
    echo "preserving selected image tags on $node after alias removal failure" >&2
    continue
  fi
  while IFS= read -r reference; do
    [[ -n "$reference" ]] || continue
    if ! "$docker_executable" exec "$node" ctr -n k8s.io images rm --sync \
        "$reference"; then
      echo "failed to remove image reference $reference from kind node $node" >&2
      status=1
    fi
  done <"$image_plan"
done

for node in "${nodes[@]}"; do
  node_key=${node//[^A-Za-z0-9_.-]/_}
  container_plan="$work/$node_key.container-plan"
  alias_plan="$work/$node_key.alias-plan"
  image_plan="$work/$node_key.image-plan"
  if ! remaining_images=$("$docker_executable" exec "$node" ctr -n k8s.io images ls -q); then
    echo "failed to verify containerd images on kind node $node" >&2
    status=1
    continue
  fi
  if ! remaining_containers=$("$docker_executable" exec "$node" crictl ps -a -o json); then
    echo "failed to verify CRI containers on kind node $node" >&2
    status=1
    continue
  fi
  for plan in "$alias_plan" "$image_plan"; do
    while IFS= read -r reference; do
      [[ -n "$reference" ]] || continue
      if awk -v reference="$reference" '$0 == reference {found=1} END {exit !found}' \
          <<<"$remaining_images"; then
        echo "verification failed: image reference remains on $node: $reference" >&2
        status=1
      fi
    done <"$plan"
  done
  while IFS= read -r container_id; do
    [[ -n "$container_id" ]] || continue
    if jq -e --arg id "$container_id" 'any(.containers[]; .id == $id)' \
        >/dev/null <<<"$remaining_containers"; then
      echo "verification failed: container remains on $node: $container_id" >&2
      status=1
    fi
  done <"$container_plan"
done

if ((status != 0)); then
  echo "kind gate-image cleanup failed verification" >&2
  exit "$status"
fi
echo "kind gate-image cleanup complete"
