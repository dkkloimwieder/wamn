#!/usr/bin/env bash
# Proof for tools/journey-host-secrets.sh. No cluster: the function was split
# out of a loop that also applied Secrets precisely so this could run offline.
#
#   tools/journey-host-secrets-proof [repo_root]
#
# Every guard here has a NEGATIVE CONTROL -- a known-bad input that must fail
# it. A check with no such input has not been shown to check anything, and can
# go inert later when the code moves out from under it.
set -euo pipefail

repo_root=${1:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}
source "$repo_root/tools/journey-host-secrets.sh"
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
failures=0
NS=warehouse-eu-3
PGHOST=10.9.8.7

check() {
  if [[ $2 -eq 0 ]]; then printf '  ok    %s\n' "$1"
  else printf '  FAIL  %s\n' "$1"; failures=$((failures + 1)); fi
}

# Values a hardcoded stand-in cannot match by coincidence.
seed_secrets() { # <dir> <guest-file> <families...>
  local dir=$1 guest=$2; shift 2
  mkdir -p "$dir"
  local f
  for f in "$guest" "${@/%/.json}"; do
    printf '{"kind":"Secret","type":"Opaque","metadata":{"name":"probe-%s","namespace":"%s"},"stringData":{"url":"postgresql://u:p@%s:5432/d"}}\n' \
      "${f%.json}" "$NS" "$PGHOST" >"$dir/$f"
  done
}

RCV_FAMILIES="executor-platform identity-reader http-admitter event-materializer"
derive_into() { # <out-array-name> <dir> <families> [namespace] [host]
  eval "declare -gA _spec_$1=(
    [secret_directory]=$2
    [role_families]='$3'
    [guest_secret_file]=guest-sql.json
    [namespace]=${4:-$NS}
    [database_host]=${5:-$PGHOST}
  )"
  declare -gA "$1"
  derive_host_secrets "_spec_$1" "$1"
}

echo "1. the happy path, and a second application through it"
seed_secrets "$work/rcv" guest-sql.json $RCV_FAMILIES
derive_into rcv "$work/rcv" "$RCV_FAMILIES"
[[ ${rcv[name:guest]} == probe-guest-sql ]]; check "the App family resolves by its own file stem" $?
[[ ${rcv[name:executor-platform]} == probe-executor-platform ]]; check "each declared family resolves its name" $?
[[ ${rcv[path:identity-reader]} == "$work/rcv/identity-reader.json" ]]; check "each declared family resolves its path" $?
[[ ${#rcv[@]} -eq 10 ]]; check "five families yield five path/name pairs" $?

# A second consumer with a DIFFERENT family set. A constant is only proven
# generic when a second consumer with different values passes through it.
WMS_FAMILIES="executor-platform identity-reader"
seed_secrets "$work/wms" guest-sql.json $WMS_FAMILIES
derive_into wms "$work/wms" "$WMS_FAMILIES"
[[ ${#wms[@]} -eq 6 ]]; check "a two-family application yields three pairs, not five" $?

echo "2. the declared set is the assertion"
# Control: the directory holds a file the application did not declare.
seed_secrets "$work/extra" guest-sql.json $RCV_FAMILIES
cp "$work/extra/guest-sql.json" "$work/extra/retention.json"
! derive_into extra "$work/extra" "$RCV_FAMILIES" 2>/dev/null
check "control: an undeclared Secret in the directory is refused" $?
# Control: the application declares a family whose file is absent.
! derive_into absent "$work/rcv" "$RCV_FAMILIES retention" 2>/dev/null
check "control: a declared family with no Secret is refused" $?

echo "3. each Secret's shape"
# Control: right files, wrong namespace.
seed_secrets "$work/ns" guest-sql.json $RCV_FAMILIES
! derive_into wrongns "$work/ns" "$RCV_FAMILIES" some-other-namespace 2>/dev/null
check "control: a Secret for another namespace is refused" $?
# Control: right files, url pointing at a different database host.
! derive_into wrconsthost "$work/ns" "$RCV_FAMILIES" "$NS" 10.0.0.1 2>/dev/null
check "control: a url pointing at another database host is refused" $?
# Control: a Secret with an empty name.
seed_secrets "$work/empty" guest-sql.json $RCV_FAMILIES
printf '{"kind":"Secret","metadata":{"name":"","namespace":"%s"},"stringData":{"url":"postgresql://u:p@%s:5432/d"}}\n' \
  "$NS" "$PGHOST" >"$work/empty/http-admitter.json"
! derive_into emptyname "$work/empty" "$RCV_FAMILIES" 2>/dev/null
check "control: a Secret with an empty name is refused" $?

echo "4. the spec contract"
eval 'declare -A short_spec=([secret_directory]='"$work/rcv"' [role_families]="'"$RCV_FAMILIES"'" [namespace]='"$NS"' [database_host]='"$PGHOST"')'
declare -A short_out=()
! derive_host_secrets short_spec short_out 2>/dev/null
check "control: a missing required key is refused before any work" $?
# Isolated deliberately: the directory holds ONLY the App family's file, so the
# declared-set comparison would PASS and cannot be what refuses this. A control
# that is caught by a different guard proves that guard, not this one.
seed_secrets "$work/onlyguest" guest-sql.json
eval 'declare -A nofam_spec=([secret_directory]='"$work/onlyguest"' [role_families]="" [guest_secret_file]=guest-sql.json [namespace]='"$NS"' [database_host]='"$PGHOST"')'
declare -A nofam_out=()
# Assert the MESSAGE, not just the refusal. Both guards reject this input --
# an empty family list also builds a garbage ".json" expectation that the
# declared-set comparison then rejects -- so refusal alone cannot tell which
# one fired, and a mutation pass showed exactly that: deleting this guard left
# the proof green. What the guard is actually worth is saying the true cause
# instead of a confusing set mismatch, so that is what is asserted.
nofam_err=$(derive_host_secrets nofam_spec nofam_out 2>&1 >/dev/null || true)
[[ $nofam_err == *"declares no role families"* ]]
check "control: an empty family declaration is refused, naming that cause" $?

echo "5. nameref binding, both directions"
binds_correctly() { # <name the caller uses for BOTH arrays>
  local n=$1
  declare -gA "decoy_$n"
  eval "decoy_$n=([secret_directory]=/nonexistent [role_families]='$RCV_FAMILIES' [guest_secret_file]=guest-sql.json [namespace]=DECOYNS [database_host]=1.2.3.4)"
  # A global under the callee's own OUT name, pre-poisoned.
  declare -gA "$n"
  eval "$n=([name:guest]=DECOY-NAME)"
  collide() {
    eval "local -A $n=(
      [secret_directory]=$work/rcv
      [role_families]='$RCV_FAMILIES'
      [guest_secret_file]=guest-sql.json
      [namespace]=$NS
      [database_host]=$PGHOST
    )"
    eval "local -A out_$n=()"
    derive_host_secrets "$n" "out_$n" || return 1
    eval "[[ \${out_$n[name:guest]} == probe-guest-sql ]]"
  }
  collide 2>/dev/null
}
for n in spec out config params secrets host_secrets; do
  binds_correctly "$n"; check "a caller array named '$n' binds to the caller" $?
done
# Controls: the internal names themselves MUST collide, or the six above prove nothing.
! binds_correctly _dhs_spec; check "control: colliding on the internal IN name is detected" $?
! binds_correctly _dhs_out;  check "control: colliding on the internal OUT name is detected" $?

echo
if [[ $failures -eq 0 ]]; then echo "journey-host-secrets: all properties hold"; else
  echo "journey-host-secrets: $failures failed"; exit 1; fi
