#!/usr/bin/env bash
set -euo pipefail

readonly WAMN_USAGE='usage: tools/test-changes [--base REF] [--cluster [--name FILTER]] [run|dry-run]'

wamn_fail() {
  local -r exit_code="$1"
  shift
  printf 'test-changes: %s\n' "$*" >&2
  exit "$exit_code"
}

wamn_usage_error() {
  printf '%s\n' "$WAMN_USAGE" >&2
  wamn_fail 64 "$*"
}

readonly WAMN_TOOL_DIRECTORY="$(
  CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_REPOSITORY_ROOT="$(
  CDPATH= cd -- "$WAMN_TOOL_DIRECTORY/.." >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_CARGO="${CARGO:-cargo}"
readonly WAMN_DOCKER="${DOCKER:-docker}"
# The Dockerfile stage that builds the guests of the host image.
readonly WAMN_GUEST_STAGE='component-builder'

# The three Cargo workspaces, in run order: label and manifest.
readonly -a WAMN_WORKSPACES=(root apps no-std)
readonly -a WAMN_MANIFESTS=(Cargo.toml apps/Cargo.toml apps/platform/no-std/Cargo.toml)
# The root full run is the acceptance command of docs/operations/running-tests.md.
readonly -a WAMN_ROOT_FULL_FEATURES=(wamn-control/ops wamn-ctl/ops)

WAMN_BASE=''
WAMN_CLUSTER=false
WAMN_NAME=''
WAMN_COMMAND=''
while (($# > 0)); do
  case "$1" in
    --base)
      (($# >= 2)) || wamn_usage_error '--base requires a Git revision'
      WAMN_BASE="$2"
      shift 2
      ;;
    --cluster)
      WAMN_CLUSTER=true
      shift
      ;;
    --name)
      (($# >= 2)) || wamn_usage_error '--name requires a test name filter'
      WAMN_NAME="$2"
      shift 2
      ;;
    run | dry-run)
      [[ -z "$WAMN_COMMAND" ]] || wamn_usage_error 'expected at most one command'
      WAMN_COMMAND="$1"
      shift
      ;;
    *)
      wamn_usage_error "unknown argument '$1'"
      ;;
  esac
done
readonly WAMN_COMMAND="${WAMN_COMMAND:-run}"
readonly WAMN_CLUSTER WAMN_NAME
if [[ -n "$WAMN_NAME" && "$WAMN_CLUSTER" != true ]]; then
  wamn_usage_error '--name requires --cluster'
fi

cd -- "$WAMN_REPOSITORY_ROOT"
if [[ -z "$WAMN_BASE" ]]; then
  WAMN_BASE="$(git merge-base HEAD main)" || wamn_fail 65 'cannot find the merge base of HEAD and main'
fi
WAMN_BASE="$(git rev-parse --verify --quiet "$WAMN_BASE^{commit}")" ||
  wamn_fail 65 "the base is not a commit: $WAMN_BASE"
readonly WAMN_BASE

# The working tree against the base: committed, staged, unstaged, deleted, and
# untracked paths. Rename detection is off, so a renamed file counts at both paths.
declare -a WAMN_CHANGED=()
mapfile -d '' -t WAMN_CHANGED < <(
  git diff --name-only --no-renames -z "$WAMN_BASE" --
  git ls-files --others --exclude-standard -z
)
readonly WAMN_CHANGED

WAMN_RELEVANT="$(
  jq -n '$ARGS.positional | unique
    | map(select((startswith("docs/") or startswith(".beads/") or test("^[^/]+\\.md$")) | not))' \
    --args -- "${WAMN_CHANGED[@]}"
)"
readonly WAMN_RELEVANT

if ((${#WAMN_CHANGED[@]} == 0)); then
  printf 'working-directory: %q\n' "$WAMN_REPOSITORY_ROOT"
  printf 'base: %s\n' "$WAMN_BASE"
  printf 'selected: nothing\n'
  [[ -z "$WAMN_NAME" ]] ||
    wamn_fail 1 "no package is selected, so no ignored test matches the name filter '$WAMN_NAME'"
  exit 0
fi

if [[ "$WAMN_CARGO" == */* ]]; then
  [[ -x "$WAMN_CARGO" ]] || wamn_fail 127 "Cargo executable is not executable: $WAMN_CARGO"
else
  command -v "$WAMN_CARGO" >/dev/null 2>&1 || wamn_fail 127 "Cargo executable was not found: $WAMN_CARGO"
fi

declare -a WAMN_METADATA=()
for manifest in "${WAMN_MANIFESTS[@]}"; do
  metadata="$("$WAMN_CARGO" metadata --manifest-path "$WAMN_REPOSITORY_ROOT/$manifest" \
    --locked --offline --format-version 1)" || wamn_fail 65 "locked Cargo metadata failed for $manifest"
  WAMN_METADATA+=("$metadata")
done
readonly WAMN_METADATA

# One line per workspace with work: index, full (true or false), the first input
# that forced a full run as JSON, and the selected packages and features.
# A package selects its dependents in every workspace that resolves it: normal
# and build edges transitively, then one dev edge. With --cluster only the root
# workspace has work, and each selected package that declares a cluster feature
# gets it. Guest ignored tests need their separate workspace command.
# Shared WIT paths have direct bindgen readers outside Cargo dependency edges.
readonly WAMN_SELECTION='
def rel($root): ltrimstr($root + "/");
def closure($graph):
  {seen: ., next: .}
  | until(.next == []; .seen as $seen
      | ([.next[] | $graph[.][]?] | unique - $seen) as $new
      | {seen: ($seen + $new), next: $new})
  | .seen;
def graph($md; $kinds):
  reduce ($md.resolve.nodes[] | .id as $to | .deps[]
    | select(any(.dep_kinds[]; (.kind // "normal") | IN($kinds[])))
    | {from: .pkg, $to}) as $edge ({}; .[$edge.from] += [$edge.to]);
def features($package):
  [$package.targets[] | .["required-features"][]?] | unique
  | map(if contains("/") then . else "\($package.name)/\(.)" end);

$metadata[0].workspace_root as $root
| [$metadata | to_entries[] | .key as $index | .value as $md
    | $md.packages[] | select(.id | IN($md.workspace_members[]))
    | {index: $index, name, id, manifest: .manifest_path,
       dir: (.manifest_path | rtrimstr("/Cargo.toml") | rel($root))}] as $members
| [$relevant[] as $path
    | if $path == "Cargo.toml" or $path == "Cargo.lock" then {full: 0, $path}
      elif $path == "apps/Cargo.toml" or $path == "apps/Cargo.lock" then {full: 1, $path}
      elif $path == "apps/platform/no-std/Cargo.toml" or $path == "apps/platform/no-std/Cargo.lock"
      then {full: 2, $path}
      elif ($path | startswith("crates/execution/workflow/router/wit/")
             or startswith("crates/platform/runtime/wit/deps/"))
      then (range(0; 3) | {full: ., $path})
      elif ($path | startswith("crates/execution/host/wit/deps/wamn-router-delivery-0.4/")
             or startswith("apps/platform/execution/materializer/wit/deps/wasi-cli/")
             or startswith("apps/platform/execution/materializer/wit/deps/wasi-clocks/"))
      then (range(0; 2) | {full: ., $path})
      else ([$members[] | select(.dir as $dir | $path | startswith($dir + "/"))]
          | max_by(.dir | length)) as $owner
        | if $owner != null then {package: $owner.manifest}
          elif ($path | test("^apps/[^/]+/")) then
            ($path | capture("^(?<app>apps/[^/]+/)").app) as $app
            | ($members[] | select(.dir + "/" | startswith($app)) | {package: .manifest})
          else {full: 0, $path} end
      end] as $selections
| [$selections[] | .package // empty] | unique as $changed
| range(0; $metadata | length) as $index
| select(($cluster | not) or $index == 0)
| $metadata[$index] as $md
| ([$selections[] | select(.full == $index) | .path] | first) as $full
| ($md.workspace_members) as $workspace
| graph($md; ["normal", "build"]) as $linked
| graph($md; ["dev"]) as $dev
| [$md.packages[] | select(.manifest_path | IN($changed[])) | .id]
| closure($linked) | (. + [.[] | $dev[.][]?]) | unique as $dependents
| [$md.packages[] | select(.id | IN($workspace[]))
    | select($full != null or (.id | IN($dependents[])))] as $selected
| select($selected != [])
| [$index, ($full != null), ($full | tojson),
   ([$selected[].name] | sort | join(" ")),
   ([$selected[] | features(.)[]]
      + [$selected[] | select($cluster and (.features // {} | has("cluster")))
          | "\(.name)/cluster"]
      | unique | join(" "))]
| @tsv
'

WAMN_PLAN="$(
  printf '%s\n' "${WAMN_METADATA[@]}" | jq -rs --argjson relevant "$WAMN_RELEVANT" \
    --argjson cluster "$WAMN_CLUSTER" '. as $metadata | '"$WAMN_SELECTION"
)" || wamn_fail 65 'could not select packages from Cargo metadata'
readonly WAMN_PLAN

printf 'working-directory: %q\n' "$WAMN_REPOSITORY_ROOT"
printf 'base: %s\n' "$WAMN_BASE"
if [[ -z "$WAMN_PLAN" && -n "$WAMN_NAME" ]]; then
  printf 'selected: nothing\n'
  [[ -z "$WAMN_NAME" ]] ||
    wamn_fail 1 "no package is selected, so no ignored test matches the name filter '$WAMN_NAME'"
  exit 0
fi

# Path rules supplement Cargo edges, including readers outside their package.
WAMN_SUITES="$(jq -r --argjson paths "$(jq -n '$ARGS.positional' --args -- "${WAMN_CHANGED[@]}")" '
  [.[] | . as $rule | select(any($paths[]; test($rule.path))) | .suites[]]
  | unique | .[]' "$WAMN_TOOL_DIRECTORY/test-changes-suites.json")"
declare -a WAMN_SELECTED_PACKAGES=()
mapfile -t WAMN_SELECTED_PACKAGES < <(awk -F '\t' '$1 == 0 {print $4}' <<<"$WAMN_PLAN" | tr ' ' '\n')
wamn_package_selected() {
  local package
  for package in "${WAMN_SELECTED_PACKAGES[@]}"; do
    [[ "$package" != "$1" ]] || return 0
  done
  return 1
}
wamn_suite_selected() { grep -qxF -- "$1" <<<"$WAMN_SUITES"; }
# The runtime owns this ignored, local-only JetStream round trip.
if [[ "$WAMN_CLUSTER" != true ]] && wamn_package_selected wamn-runtime; then
  WAMN_SUITES+=$'\njetstream'
fi
printf 'suites: %s\n' "$(tr '\n' ' ' <<<"$WAMN_SUITES")"

failed=0
wamn_step() {
  local -r label="$1"
  shift
  if [[ "$WAMN_COMMAND" == dry-run ]]; then
    printf '%s:' "$label"
    printf ' %q' "$@"
    printf '\n'
    return 0
  fi
  printf 'test-changes: %s\n' "$label" >&2
  local exit_code=0
  "$@" </dev/null || exit_code=$?
  if ((exit_code == 0)); then
    printf 'test-changes: PASS: %s\n' "$label" >&2
  else
    printf 'test-changes: FAIL: %s (exit %d)\n' "$label" "$exit_code" >&2
    failed=1
  fi
  return "$exit_code"
}
wamn_test() {
  local label="$1"
  shift
  wamn_step "$label" "$WAMN_TOOL_DIRECTORY/require-test-result" "$WAMN_CARGO" test \
    --locked --offline --no-fail-fast "$@"
}

# Inputs are built before any test. A failed input stops dependent tests.
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$WAMN_REPOSITORY_ROOT/target}"
[[ "$CARGO_TARGET_DIR" == /* ]] || export CARGO_TARGET_DIR="$WAMN_REPOSITORY_ROOT/$CARGO_TARGET_DIR"
export WAMN_APPLICATION_COMPONENTS="$CARGO_TARGET_DIR/virtualized/std-empty-environment"
need_edge=false
need_packages=false
need_fixture=false
need_nats=false
need_route=false
if wamn_package_selected wamn-control || wamn_suite_selected package-digest; then
  need_packages=true
  need_fixture=true
fi
if wamn_package_selected wamn-schema-generator; then need_packages=true; fi
if wamn_package_selected wamn-control-provision || wamn_suite_selected provision; then need_fixture=true; fi
if wamn_package_selected wamn-edge || wamn_suite_selected prekind; then need_edge=true; fi
if wamn_suite_selected prekind; then need_nats=true; need_route=true; fi
if wamn_suite_selected jetstream; then need_nats=true; fi
# Clippy compiles every target, including generated application source and
# compile-time fixture reads. Derive those application roots from Cargo targets.
declare -a applications=()
declare -A application_seen=()
wamn_application() {
  local app="$1" base source
  [[ -z "${application_seen[$app]:-}" ]] || return 0
  application_seen[$app]=true
  # Authored base package IDs use one package = "id" line per dependency.
  while IFS= read -r base; do
    while IFS= read -r source; do
      if [[ "$(basename "${source%/wamn.k}")" == "$base" ]]; then
        wamn_application "${source%/wamn.k}"
        break
      fi
    done < <(rg --files apps -g wamn.k)
  done < <(sed -n 's/^[[:space:]]*package = "\([^" ]*\)".*/\1/p' "$app/wamn.k")
  applications+=("$app")
}
if wamn_suite_selected quality; then
  mapfile -t input_sources < <(printf '%s\n' "${WAMN_METADATA[@]}" | jq -rs -r '
    .[] | . as $md | .packages[] | select(.id | IN($md.workspace_members[]))
    | .manifest_path, .targets[].src_path')
  for source in "${input_sources[@]}"; do
    directory="${source%/*}"
    while [[ "$directory" == "$WAMN_REPOSITORY_ROOT/apps/"* ]]; do
      if [[ -f "$directory/wamn.k" ]]; then
        wamn_application "${directory#"$WAMN_REPOSITORY_ROOT/"}"
        break
      fi
      directory="${directory%/*}"
    done
  done
  # Native tests also include generated fixture files at compile time.
  need_fixture=true
fi
if [[ "$need_fixture" == true ]]; then
  wamn_application apps/platform_fixture
  wamn_application apps/platform_fixture_overlay
fi
if [[ "$need_packages" == true ]]; then
  while IFS= read -r app; do wamn_application "$app"; done \
    < <(jq -r '.packages[]' deploy/gcp/environments/*.json | sort -u)
  if wamn_package_selected wamn-schema-generator; then wamn_application apps/client_acme_receiving; fi
fi
if [[ "$need_edge" == true ]]; then wamn_application apps/edge_device; fi
if [[ "$need_nats" == true ]]; then
  if [[ "$WAMN_COMMAND" == dry-run ]]; then
    printf 'input nats: use WAMN_NATIVE_C_NATS_BIN or nats-server on PATH (prebuilt only)\n'
  else
    export WAMN_NATIVE_C_NATS_BIN="${WAMN_NATIVE_C_NATS_BIN:-$(command -v nats-server || :)}"
    [[ -n "$WAMN_NATIVE_C_NATS_BIN" && -x "$WAMN_NATIVE_C_NATS_BIN" ]] ||
      wamn_fail 65 'set WAMN_NATIVE_C_NATS_BIN to an existing prebuilt nats-server executable'
  fi
fi
if ((${#applications[@]} > 0)); then
  bins=(-p wamn-ctl --bin wamn -p wamn-test-infrastructure --bins)
  if wamn_suite_selected prekind; then bins+=(-p wamn-host); fi
  wamn_step 'input bins' "$WAMN_CARGO" build --locked --offline "${bins[@]}" || exit 1
fi
if [[ "$need_route" == true ]]; then
  export WAMN_HOST_BINARY="$CARGO_TARGET_DIR/debug/wamn-host"
  export WAMN_FLOW_HTTP_COMPONENT="$CARGO_TARGET_DIR/apps/wasm32-wasip2/release/http_route.wasm"
  export WAMN_MATERIALIZER_COMPONENT="$CARGO_TARGET_DIR/apps/wasm32-wasip2/debug/materializer.wasm"
  if [[ "$WAMN_COMMAND" == dry-run ]]; then guest_flags='$(tools/guest-rustflags)'
  else guest_flags="$("$WAMN_TOOL_DIRECTORY/guest-rustflags")"; fi
  wamn_step 'input http-route' env "RUSTFLAGS=$guest_flags" "$WAMN_CARGO" build --locked --offline \
    --release --manifest-path apps/Cargo.toml --target-dir "$CARGO_TARGET_DIR/apps" \
    --target wasm32-wasip2 -p http-route || exit 1
  wamn_step 'input materializer' env "RUSTFLAGS=$guest_flags" "$WAMN_CARGO" build --locked --offline \
    --manifest-path apps/Cargo.toml --target-dir "$CARGO_TARGET_DIR/apps" \
    --target wasm32-wasip2 -p materializer || exit 1
  wamn_step 'input native guest directory' mkdir -p "$CARGO_TARGET_DIR/wasm32-wasip2/debug" || exit 1
  for guest in transform http-request http-page; do
    wamn_step "input $guest" env "RUSTFLAGS=$guest_flags" "$WAMN_CARGO" build --locked --offline \
      --manifest-path apps/platform/no-std/Cargo.toml --target-dir "$CARGO_TARGET_DIR/no-std" \
      --target wasm32-wasip2 -p "$guest" || exit 1
    wamn_step "input native $guest" cp "$CARGO_TARGET_DIR/no-std/wasm32-wasip2/debug/${guest//-/_}.wasm" \
      "$CARGO_TARGET_DIR/wasm32-wasip2/debug/${guest//-/_}.wasm" || exit 1
  done
fi
if ((${#applications[@]} > 0)); then
  wamn_step 'input applications' "$CARGO_TARGET_DIR/debug/wamn-test-postgres" \
    --database prekind_build --url-env DATABASE_URL -- \
    "$CARGO_TARGET_DIR/debug/wamn" build "${applications[@]}" || exit 1
fi

# Every nonempty change set, including documentation, retains all lint legs.
if wamn_suite_selected quality; then
  wamn_step repo-lint "$WAMN_TOOL_DIRECTORY/repo-lint" run || :
fi

while IFS=$'\t' read -r index full trigger packages features; do
  [[ -n "$index" ]] || continue
  argv=(test --manifest-path "$WAMN_REPOSITORY_ROOT/${WAMN_MANIFESTS[$index]}"
    --locked --offline --no-fail-fast)
  label="${WAMN_WORKSPACES[$index]}"
  if [[ "$full" == true ]]; then
    label="$label (full: $trigger)"
    argv+=(--workspace)
    if ((index == 0)); then
      cluster_features=''
      for feature in $features; do
        [[ "$feature" != */cluster ]] || cluster_features+=" $feature"
      done
      features="${WAMN_ROOT_FULL_FEATURES[*]}$cluster_features"
    fi
  else
    for package in $packages; do
      argv+=(-p "$package")
    done
  fi
  for package in wamn-control wamn-ctl; do
    if [[ " $packages " == *" $package "* && " $features " != *" $package/ops "* ]]; then features+=" $package/ops"; fi
  done
  features="${features# }"
  if [[ -n "$features" ]]; then
    argv+=(--features "${features// /,}")
  fi
  if [[ -n "$WAMN_NAME" ]]; then
    argv+=("$WAMN_NAME")
  fi
  if [[ "$WAMN_CLUSTER" == true ]]; then
    # Ignored tests start clusters, brokers, and registries, so they run one at a time.
    argv+=(-- --ignored --test-threads=1)
  fi
  if [[ "$WAMN_COMMAND" == dry-run ]]; then
    printf '%s:' "$label"
    printf ' %q' "$WAMN_CARGO" "${argv[@]}"
    printf '\n'
    continue
  fi
  if [[ -n "$WAMN_NAME" ]]; then
    # Libtest lists each matching ignored test as `name: test`.
    listed="$("$WAMN_CARGO" "${argv[@]}" --list --format terse </dev/null)" ||
      wamn_fail 1 "cannot list the ignored tests of $label"
    grep -q ': test$' <<<"$listed" ||
      wamn_fail 1 "no ignored test in the selected packages matches the name filter '$WAMN_NAME'"
  fi
  printf 'test-changes: %s\n' "$label" >&2
  exit_code=0
  "$WAMN_TOOL_DIRECTORY/require-test-result" "$WAMN_CARGO" "${argv[@]}" </dev/null || exit_code=$?
  if ((exit_code == 0)); then
    printf 'test-changes: PASS: %s\n' "$label" >&2
  else
    printf 'test-changes: FAIL: %s (exit %d)\n' "$label" "$exit_code" >&2
    failed=1
  fi
done <<<"$WAMN_PLAN"

if [[ "$WAMN_CLUSTER" != true ]]; then
  if wamn_suite_selected package-digest && ! wamn_package_selected wamn-control; then
    wamn_test package-digest -p wamn-control --features ops --test package_digest || :
  fi
  if wamn_suite_selected provision && ! wamn_package_selected wamn-control-provision; then
    wamn_test provision -p wamn-control-provision || :
  fi
  if wamn_suite_selected ctl-ops && ! wamn_package_selected wamn-ctl; then
    wamn_test ctl-ops -p wamn-ctl --features ops || :
  fi
  if wamn_suite_selected prekind; then
    wamn_test prekind -p wamn-control --features ops --test environment_apply_kind \
      --test platform_apply_kind prekind || :
    wamn_test 'native host' -p wamn-control --features ops --test environment_apply_kind \
      prekind_host::prekind_http_host_runs_and_rejects_respond_without_caller \
      -- --ignored --exact --test-threads=1 || :
  fi
  if wamn_suite_selected web; then
    wamn_step 'web lint' pnpm run check || :
    for package in @wamn/web-runtime @wamn/platform-ui; do
      wamn_step "$package check" pnpm --filter "$package" check || :
      wamn_step "$package test" pnpm --filter "$package" test || :
    done
    wamn_step 'platform UI build' pnpm --filter @wamn/platform-ui build || :
  fi
fi

# Ask NATS itself for an unused port, bound only on loopback. Own this process
# and its storage, including on a signal or test failure. Never reuse a broker.
nats_pid=''
nats_directory=''
wamn_cleanup() {
  if [[ -n "$nats_pid" ]]; then
    kill "$nats_pid" 2>/dev/null || :
    wait "$nats_pid" 2>/dev/null || :
  fi
  if [[ -n "$nats_directory" ]]; then rm -rf -- "$nats_directory"; fi
}
trap wamn_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if [[ "$WAMN_CLUSTER" != true ]] && wamn_suite_selected jetstream; then
  if [[ "$WAMN_COMMAND" == dry-run ]]; then
    printf 'input jetstream: private nats-server -js -a 127.0.0.1 -p -1 -sd <temporary directory>\n'
  else
    nats_directory="$(mktemp -d "${TMPDIR:-/tmp}/wamn-test-changes-nats.XXXXXXXX")"
    "$WAMN_NATIVE_C_NATS_BIN" -js -a 127.0.0.1 -p -1 -sd "$nats_directory/data" \
      >"$nats_directory/server.log" 2>&1 &
    nats_pid=$!
    for ((attempt = 0; attempt < 100; attempt++)); do
      if grep -q 'Server is ready' "$nats_directory/server.log"; then break; fi
      kill -0 "$nats_pid" 2>/dev/null || break
      sleep 0.1
    done
    port="$(sed -n 's/.*Listening for client connections on 127.0.0.1:\([0-9]*\).*/\1/p' \
      "$nats_directory/server.log" | head -1)"
    if [[ -z "$port" ]] || ! grep -q 'Server is ready' "$nats_directory/server.log"; then
      cat "$nats_directory/server.log" >&2
      wamn_fail 1 'private NATS did not become ready'
    fi
    export WAMN_EVT_NATS_URL="nats://127.0.0.1:$port"
  fi
  wamn_test jetstream -p wamn-runtime --lib \
    plugins::wamn_jetstream::tests::live_derived_publish_replay_converges_through_jetstream_dedup \
    -- --ignored --exact --test-threads=1 || :
fi

# A change set that selects a guest of the host image also builds the guests
# with the Dockerfile guest stage, which checks the router pin that a local
# guest build also checks (wamn-lt7y). The guests are the packages that the
# stage builds, and they belong to the apps workspace.

if [[ "$WAMN_CLUSTER" != true ]]; then
  declare -a guests=()
  mapfile -t guests < <(
    awk -v stage="$WAMN_GUEST_STAGE" '$1 == "FROM" { in_stage = ($NF == stage); next } in_stage' Dockerfile |
      grep -oE -- '-p [A-Za-z0-9_-]+' | cut -d ' ' -f 2
  )
  ((${#guests[@]} > 0)) ||
    wamn_fail 65 "the Dockerfile stage $WAMN_GUEST_STAGE names no guest package"
  guest_selected=false
  while IFS=$'\t' read -r index _ _ packages _; do
    ((index == 1)) || continue
    for package in $packages; do
      for guest in "${guests[@]}"; do
        [[ "$package" != "$guest" ]] || guest_selected=true
      done
    done
  done <<<"$WAMN_PLAN"
  if [[ "$guest_selected" == true ]]; then
    wamn_step "guests (Dockerfile $WAMN_GUEST_STAGE)" \
      "$WAMN_DOCKER" build --target "$WAMN_GUEST_STAGE" --build-arg WAMN_CHECKOUT_KEY="$(printf '%s' "$(realpath "$WAMN_REPOSITORY_ROOT")" | sha256sum | cut -c1-16)" "$WAMN_REPOSITORY_ROOT" || :
  fi
fi
((failed == 0))
