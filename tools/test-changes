#!/usr/bin/env bash
set -euo pipefail

readonly WAMN_USAGE='usage: tools/test-changes [--base REF] [--tier T[,T] [--name FILTER]] [--suite ID[,ID]] [run|dry-run]'

wamn_fail() {
  local -r exit_code="$1"
  shift
  printf 'test-changes: %s\n' "$*" >&2
  exit "$exit_code"
}

wamn_usage_error() {
  printf '%s\n' "$WAMN_USAGE" >&2
  wamn_fail 64 "$*"
}

readonly WAMN_TOOL_DIRECTORY="$(
  CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_REPOSITORY_ROOT="$(
  CDPATH= cd -- "$WAMN_TOOL_DIRECTORY/.." >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_CARGO="${CARGO:-cargo}"
readonly WAMN_DOCKER="${DOCKER:-docker}"

# The three Cargo workspaces, in run order: label and manifest.
readonly -a WAMN_WORKSPACES=(root apps no-std)
readonly -a WAMN_MANIFESTS=(Cargo.toml apps/Cargo.toml apps/platform/no-std/Cargo.toml)

WAMN_BASE=''
WAMN_KIND=false
WAMN_EXPLICIT_TIER=false
WAMN_TIERS='unit,contract,live-postgres,live-nats'
WAMN_NAME=''
WAMN_REQUESTED_SUITES=''
WAMN_COMMAND=''
while (($# > 0)); do
  case "$1" in
    --base)
      (($# >= 2)) || wamn_usage_error '--base requires a Git revision'
      WAMN_BASE="$2"
      shift 2
      ;;
    --tier)
      (($# >= 2)) || wamn_usage_error '--tier requires one or more tiers'
      WAMN_EXPLICIT_TIER=true
      WAMN_TIERS="$2"
      shift 2
      ;;
    --name)
      (($# >= 2)) || wamn_usage_error '--name requires a test name filter'
      WAMN_NAME="$2"
      shift 2
      ;;
    --suite)
      (($# >= 2)) || wamn_usage_error '--suite requires one or more suite IDs'
      [[ -n "$2" && "$2" != ,* && "$2" != *, && "$2" != *,,* ]] ||
        wamn_usage_error '--suite requires nonempty suite IDs'
      WAMN_REQUESTED_SUITES="$2"
      shift 2
      ;;
    run | dry-run)
      [[ -z "$WAMN_COMMAND" ]] || wamn_usage_error 'expected at most one command'
      WAMN_COMMAND="$1"
      shift
      ;;
    *)
      wamn_usage_error "unknown argument '$1'"
      ;;
  esac
done
readonly WAMN_COMMAND="${WAMN_COMMAND:-run}"
[[ "$WAMN_TIERS" != ,* && "$WAMN_TIERS" != *, && "$WAMN_TIERS" != *,,* ]] ||
  wamn_usage_error '--tier requires nonempty tier names'
IFS=',' read -ra requested_tiers <<<"$WAMN_TIERS"
((${#requested_tiers[@]} > 0)) || wamn_usage_error '--tier requires one or more tiers'
for tier in "${requested_tiers[@]}"; do
  case "$tier" in
    unit | contract | live-postgres | live-nats) ;;
    kind) WAMN_KIND=true ;;
    *) wamn_usage_error "unknown tier '$tier'" ;;
  esac
done
readonly WAMN_KIND WAMN_TIERS WAMN_NAME WAMN_EXPLICIT_TIER
if [[ -n "$WAMN_NAME" && "$WAMN_KIND" != true ]]; then
  wamn_usage_error '--name requires --tier kind'
fi

cd -- "$WAMN_REPOSITORY_ROOT"
if [[ -z "$WAMN_BASE" ]]; then
  WAMN_BASE="$(git merge-base HEAD main)" || wamn_fail 65 'cannot find the merge base of HEAD and main'
fi
WAMN_BASE="$(git rev-parse --verify --quiet "$WAMN_BASE^{commit}")" ||
  wamn_fail 65 "the base is not a commit: $WAMN_BASE"
readonly WAMN_BASE

# The working tree against the base: committed, staged, unstaged, deleted, and
# untracked paths. Rename detection is off, so a renamed file counts at both paths.
declare -a WAMN_CHANGED=()
changed_file=$(mktemp "${TMPDIR:-/tmp}/wamn-test-changes.XXXXXXXX")
if ! git diff --name-only --no-renames -z "$WAMN_BASE" -- > "$changed_file"; then
  rm -f -- "$changed_file"
  wamn_fail 65 'cannot read changed paths with git diff'
fi
if ! git ls-files --others --exclude-standard -z >> "$changed_file"; then
  rm -f -- "$changed_file"
  wamn_fail 65 'cannot read untracked paths with git ls-files'
fi
mapfile -d '' -t WAMN_CHANGED < "$changed_file"
rm -f -- "$changed_file"
readonly WAMN_CHANGED

WAMN_POLICY_DATA="$(python3 - "$WAMN_REPOSITORY_ROOT/tests/selection.toml" "$WAMN_BASE" "${WAMN_CHANGED[@]}" <<'PYTHON'
import json
import re
import subprocess
import sys
import tomllib

with open(sys.argv[1], encoding="utf-8") as source:
    text = source.read()
policy = tomllib.loads(text)
if policy["version"] != 1:
    sys.exit("unsupported selection schema version")
identifiers = set()
for suite in policy["suites"]:
    identifier = suite["id"]
    if identifier in identifiers:
        sys.exit(f"duplicate suite: {identifier}")
    identifiers.add(identifier)
    if suite["tier"] not in ("unit", "contract", "live-postgres", "live-nats", "kind"):
        sys.exit(f"suite {identifier}: invalid tier")
    if suite["workspace"] not in ("root", "apps", "no-std"):
        sys.exit(f"suite {identifier}: invalid workspace")
    if suite["execution"] not in ("commands", "libtest", "docker-guests"):
        sys.exit(f"suite {identifier}: invalid execution policy")
    if suite["mode"] not in ("always", "local"):
        sys.exit(f"suite {identifier}: invalid mode")
    if suite["timeout"] != 1800 or not isinstance(suite["resource_lock"], str):
        sys.exit(f"suite {identifier}: use the shared 30-minute silent-stage limit and a resource lock string")
def shared_header(text, policy):
    # TOML drops comments. Keep comments outside suite tables and inline rows.
    comments = []
    suite = False
    braces = 0
    tokens = r'"""[\s\S]*?"""|\x27\x27\x27[\s\S]*?\x27\x27\x27|"(?:\\.|[^"\\])*"|\x27[^\x27]*\x27|^[ \t]*(?:\[\[[\w.-]+\]\]|\[[\w.-]+\])[ \t]*(?=#|$)|#[^\n]*|[{}]'
    for match in re.finditer(tokens, text, re.MULTILINE):
        token = match.group().lstrip()
        if token.startswith("["):
            suite = token.strip("[] ") == "suites" or token.startswith("[suites.")
        elif token == "{":
            braces += 1
        elif token == "}":
            braces -= 1
        elif token.startswith("#") and not suite and braces == 0:
            comments.append(token)
    return ({key: value for key, value in policy.items()
             if key not in ("suites", "targets", "exclusions")}, comments)

rows = None
removed = []
if "tests/selection.toml" in sys.argv[3:]:
    base_text = subprocess.check_output(
        ["git", "show", f"{sys.argv[2]}:tests/selection.toml"], text=True)
    base = tomllib.loads(base_text)
    before = {suite["id"]: suite for suite in base["suites"]}
    after = {suite["id"]: suite for suite in policy["suites"]}
    removed = sorted(before.keys() - after.keys())
    if ("tools/test-changes" not in sys.argv[3:]
            and shared_header(base_text, base) == shared_header(text, policy)):
        changed = [identifier for identifier, suite in after.items()
                   if before.get(identifier) != suite]
        rows = {"suites": changed, "tests": bool(changed or removed
                or base.get("targets") != policy.get("targets")
                or base.get("exclusions") != policy.get("exclusions"))}
print(json.dumps({"policy": policy, "rows": rows, "removed": removed}))
PYTHON
)" || wamn_fail 65 'cannot read tests/selection.toml'
WAMN_POLICY="$(jq -c '.policy' <<<"$WAMN_POLICY_DATA")"
WAMN_ROWS="$(jq -c '.rows' <<<"$WAMN_POLICY_DATA")"
while IFS= read -r suite; do
  references=''
  status=0
  references="$(git grep -w -l -F -e "$suite" -- . ':!tests/selection.toml' ':!docs/history/**' ':!docs/audit/**')" || status=$?
  ((status <= 1)) || wamn_fail 65 "cannot find references to removed suite '$suite'"
  [[ -z "$references" ]] || wamn_fail 65 "removed suite '$suite' is still named in: $references"
done < <(jq -r '.removed[]' <<<"$WAMN_POLICY_DATA")
readonly WAMN_ROWS
readonly WAMN_POLICY
if [[ -n "$WAMN_REQUESTED_SUITES" ]]; then
  IFS=',' read -ra requested_suites <<<"$WAMN_REQUESTED_SUITES"
  for suite in "${requested_suites[@]}"; do
    jq -e --arg id "$suite" 'any(.suites[]; .id == $id)' <<<"$WAMN_POLICY" >/dev/null ||
      wamn_usage_error "unknown suite '$suite'"
  done
fi
WAMN_RELEVANT="$(
  jq -n --argjson policy "$WAMN_POLICY" --argjson rows "$WAMN_ROWS" '$ARGS.positional | unique
    | map(select(. != "tests/selection.toml" or $rows == null))
    | map(select(. as $path | any($policy.documentation[];
        . as $pattern | $path | test($pattern)) | not))' \
    --args -- "${WAMN_CHANGED[@]}"
)"
readonly WAMN_RELEVANT

if [[ "$WAMN_RELEVANT" == '[]' && -z "$WAMN_REQUESTED_SUITES" && "$(jq '.tests // false' <<<"$WAMN_ROWS")" == false ]]; then
  printf 'working-directory: %q\n' "$WAMN_REPOSITORY_ROOT"
  printf 'base: %s\n' "$WAMN_BASE"
  printf 'selected: nothing\n'
  [[ -z "$WAMN_NAME" ]] ||
    wamn_fail 1 "no package is selected, so no ignored test matches the name filter '$WAMN_NAME'"
  exit 0
fi

if [[ "$WAMN_CARGO" == */* ]]; then
  [[ -x "$WAMN_CARGO" ]] || wamn_fail 127 "Cargo executable is not executable: $WAMN_CARGO"
else
  command -v "$WAMN_CARGO" >/dev/null 2>&1 || wamn_fail 127 "Cargo executable was not found: $WAMN_CARGO"
fi

declare -a WAMN_METADATA=()
for manifest in "${WAMN_MANIFESTS[@]}"; do
  metadata="$("$WAMN_CARGO" metadata --manifest-path "$WAMN_REPOSITORY_ROOT/$manifest" \
    --locked --offline --format-version 1)" || wamn_fail 65 "locked Cargo metadata failed for $manifest"
  WAMN_METADATA+=("$metadata")
done
readonly WAMN_METADATA

selector_errors="$(printf '%s\n' "${WAMN_METADATA[@]}" | jq -rs --argjson policy "$WAMN_POLICY" '
  . as $metadata | $policy.suites[] | select(.execution == "libtest") | . as $suite
  | (["root", "apps", "no-std"] | index($suite.workspace)) as $index
  | $metadata[$index] as $md
  | [$md.packages[] | select(.id | IN($md.workspace_members[]))
      | select(.name == $suite.package)] as $packages
  | if $packages == [] then "suite \($suite.id): missing package \($suite.package) in \($suite.workspace)"
    else $suite.target[] as $target
      | ($target | split(":")) as $parts
      | select(all($packages[0].targets[];
          .name != $parts[1] or (.kind | index($parts[0]) | not)))
      | "suite \($suite.id): missing target \($target) in \($suite.package)"
    end')" || wamn_fail 65 'cannot read suite selectors'
[[ -z "$selector_errors" ]] || wamn_fail 65 "$selector_errors"

# One line per workspace with work: index, full (true or false), the first input
# that forced a full run as JSON, and the selected packages and features.
# A package selects its dependents in every workspace that resolves it: normal
# and build edges transitively, then one dev edge. Kind selection enables
# each selected package's cluster feature.
# Shared WIT paths have direct bindgen readers outside Cargo dependency edges.
readonly WAMN_SELECTION='
def rel($root): ltrimstr($root + "/");
def closure($graph):
  {seen: ., next: .}
  | until(.next == []; .seen as $seen
      | ([.next[] | $graph[.][]?] | unique - $seen) as $new
      | {seen: ($seen + $new), next: $new})
  | .seen;
def graph($md; $kinds):
  reduce ($md.resolve.nodes[] | .id as $to | .deps[]
    | select(any(.dep_kinds[]; (.kind // "normal") | IN($kinds[])))
    | {from: .pkg, $to}) as $edge ({}; .[$edge.from] += [$edge.to]);
def features($package):
  [$package.targets[] | .["required-features"][]? | select(. != "cluster" or $cluster)] | unique
  | map(if contains("/") then . else "\($package.name)/\(.)" end);

$metadata[0].workspace_root as $root
| [$metadata | to_entries[] | .key as $index | .value as $md
    | $md.packages[] | select(.id | IN($md.workspace_members[]))
    | {index: $index, name, id, manifest: .manifest_path,
       dir: (.manifest_path | rtrimstr("/Cargo.toml") | rel($root))}] as $members
| [$relevant[] as $path
    | if $path == "Cargo.toml" or $path == "Cargo.lock" then {full: 0, $path}
      elif $path == "apps/Cargo.toml" or $path == "apps/Cargo.lock" then {full: 1, $path}
      elif $path == "apps/platform/no-std/Cargo.toml" or $path == "apps/platform/no-std/Cargo.lock"
      then {full: 2, $path}
      else ([$members[] | select(.dir as $dir | $path | startswith($dir + "/"))]
          | max_by(.dir | length)) as $owner
        | [$policy.rules[] | select(any(.inputs[];
            . as $pattern | $path | test($pattern)))] as $rules
        | [$rules[] | select(.application == true and $owner == null
            and all($rules[]; (.workspaces // []) == []))
            | ($path | capture("^(?<app>apps/[^/]+/)").app) as $app
            | $members[] | select(.dir + "/" | startswith($app))] as $applications
        | (if $owner != null then {package: $owner.manifest} else empty end),
          ($applications[] | {package: .manifest}),
          ($rules[] | .workspaces[]? as $workspace
            | {full: ($workspaces | index($workspace)), $path}),
          (if $owner == null and $applications == []
               and all($rules[]; (.workspaces // []) == [])
           then {unknown: true, $path} else empty end)
      end] as $selections
| [$selections[] | .package // empty] | unique as $changed
| ([$selections[] | select(.unknown) | .path] | first) as $unknown
| {unknown: ($unknown != null), workspaces: [range(0; $metadata | length) as $index
| $metadata[$index] as $md
| ($unknown // ([$selections[] | select(.full == $index) | .path] | first)) as $full
| ($md.workspace_members) as $workspace
| graph($md; ["normal", "build"]) as $linked
| graph($md; ["dev"]) as $dev
| [$md.packages[] | select(.manifest_path | IN($changed[])) | .id]
| closure($linked) | (. + [.[] | $dev[.][]?]) | unique as $dependents
| [$md.packages[] | select(.id | IN($workspace[]))
    | select($full != null or (.id | IN($dependents[])))
    | . as $package
    | select(($explicit | not) or any($policy.targets[]; .workspace == $workspaces[$index]
        and .package == $package.name and (.tier | IN($tiers[]))))] as $selected
| select($selected != [])
| [$index, ($full != null), ($full | tojson),
   ([$selected[].name] | sort | join(" ")),
   ([$selected[] | features(.)[]]
      + [$selected[] as $package | $policy.preparation[]
          | select(.packages | index($package.name)) | .features[]?
          | "\($package.name)/\(.)"]
      + [$selected[] | select($cluster and (.features // {} | has("cluster")))
          | "\(.name)/cluster"]
      | unique | join(" "))]
]}
'

WAMN_DISCOVERY="$(
  printf '%s\n' "${WAMN_METADATA[@]}" | jq -rs --argjson relevant "$WAMN_RELEVANT" \
    --argjson policy "$WAMN_POLICY" \
    --argjson workspaces "$(printf '%s\n' "${WAMN_WORKSPACES[@]}" | jq -Rsc 'split("\n")[:-1]')" \
    --argjson cluster "$WAMN_KIND" --argjson explicit "$WAMN_EXPLICIT_TIER" --arg tiers "$WAMN_TIERS" '($tiers | split(",")) as $tiers | . as $metadata | '"$WAMN_SELECTION"
)" || wamn_fail 65 'could not select packages from Cargo metadata'
# Keep an empty feature column from shifting the target column in Bash.
if [[ "$WAMN_EXPLICIT_TIER" == false ]]; then
  WAMN_PLAN="$(jq -r '.workspaces[] | @tsv' <<<"$WAMN_DISCOVERY")"
else
WAMN_PLAN="$(printf '%s\n' "${WAMN_METADATA[@]}" | jq -rs \
  --argjson discovery "$WAMN_DISCOVERY" --argjson policy "$WAMN_POLICY" \
  --arg tiers "$WAMN_TIERS" '
  ($tiers | split(",")) as $tiers
  | . as $metadata | $discovery.workspaces[]
  | . as $plan | .[0] as $index
  | (["root", "apps", "no-std"][$index]) as $workspace
  | [.[3] | split(" ")[] | . as $package
      | [$policy.targets[] | select(.workspace == $workspace and .package == $package)] as $all
      | {package: $package, all: $all, selected: [$all[] | select(.tier | IN($tiers[]))]}] as $packages
  | if all($packages[]; .all == .selected)
      and ($plan[1] == false or
        all($metadata[$index].packages[] | select(.id | IN($metadata[$index].workspace_members[]));
          .name | IN($packages[].package)))
    then $plan | @tsv
    else $packages[] | select(.selected != [])
      | . as $package
      | [$index, false, $plan[2], .package,
          ($plan[4] | split(" ") | map(select(startswith($package.package + "/")))
            | join(" ") | if . == "" then " " else . end),
          (.selected | map(.target) | join(" "))] | @tsv
    end')"
fi
if [[ -n "$WAMN_REQUESTED_SUITES" ]]; then WAMN_PLAN=''; fi
if [[ "$(jq '.tests // false' <<<"$WAMN_ROWS")" == true && ",$WAMN_TIERS," == *,contract,* ]] &&
  ! jq -e '.workspaces[] | select(.[0] == 0) | .[3] | split(" ") | index("wamn-conformance-tests")' <<<"$WAMN_DISCOVERY" >/dev/null; then
  WAMN_PLAN+="${WAMN_PLAN:+$'\n'}"$'0\tfalse\tnull\twamn-conformance-tests\t \ttest:test_changes test:test_tiers'
fi

printf 'working-directory: %q\n' "$WAMN_REPOSITORY_ROOT"
printf 'base: %s\n' "$WAMN_BASE"
if [[ -z "$WAMN_PLAN" && -n "$WAMN_NAME" ]]; then
  printf 'selected: nothing\n'
  [[ -z "$WAMN_NAME" ]] ||
    wamn_fail 1 "no package is selected, so no ignored test matches the name filter '$WAMN_NAME'"
  exit 0
fi

# Path rules supplement Cargo edges, including readers outside their package.
WAMN_PACKAGES="$(printf '%s\n' "${WAMN_METADATA[@]}" | jq -rs '[.[] | . as $md
  | .packages[] | select(.id | IN($md.workspace_members[])) | .name] | unique')"
WAMN_SELECTED="$(jq '[.workspaces[] | {index: .[0], packages: (.[3] | split(" "))}]' <<<"$WAMN_DISCOVERY")"
if [[ -n "$WAMN_REQUESTED_SUITES" ]]; then WAMN_SELECTED='[]'; fi
WAMN_GUEST_RULE="$(jq -c '.suites[] | select(.execution == "docker-guests")' <<<"$WAMN_POLICY")"
WAMN_GUEST_STAGE="$(jq -r '.stage' <<<"$WAMN_GUEST_RULE")"
WAMN_DOCKERFILE="$(jq -r '.dockerfile' <<<"$WAMN_GUEST_RULE")"
if [[ -f "$WAMN_DOCKERFILE" ]]; then
  guest_source="$(cat -- "$WAMN_DOCKERFILE")"
else
  guest_source="$(git show "$WAMN_BASE:$WAMN_DOCKERFILE")" ||
    wamn_fail 65 "cannot read deleted guest input $WAMN_DOCKERFILE from Git"
fi
declare -a guests=()
mapfile -t guests < <(
  awk -v stage="$WAMN_GUEST_STAGE" '$1 == "FROM" { in_stage = ($NF == stage); next } in_stage' <<<"$guest_source" |
    grep -oE -- '-p [A-Za-z0-9_-]+' | cut -d ' ' -f 2
)
((${#guests[@]} > 0)) ||
  wamn_fail 65 "the Dockerfile stage $WAMN_GUEST_STAGE names no guest package"
WAMN_SUITES="$(jq -r --argjson paths "$WAMN_RELEVANT" --argjson selected "$WAMN_SELECTED" \
  --argjson rows "$WAMN_ROWS" \
  --argjson discovery "$WAMN_DISCOVERY" --arg tiers "$WAMN_TIERS" --arg requested "$WAMN_REQUESTED_SUITES" \
  --argjson guests "$(printf '%s\n' "${guests[@]}" | jq -Rsc 'split("\n")[:-1]')" '
  .suites[] | . as $suite
  | if $requested != "" then select(.id | IN($requested | split(",") | .[])) else
    select(.mode == "always" or (.tier | IN($tiers | split(",") | .[])))
  | select((.id | IN($rows.suites[]?)) or $discovery.unknown or (.always == true and $paths != [])
      or any($paths[]; . as $path | any($suite.inputs[]; . as $pattern | $path | test($pattern)))
      or any($selected[].packages[]; IN($suite.select_packages[]?))
      or (.execution == "docker-guests" and any($selected[] | select(.index == 1) | .packages[]; IN($guests[]))))
  end | .id' <<<"$WAMN_POLICY")" || wamn_fail 65 'cannot select suites'
# Fold path-selected suites into the target selection. Features belong to the
# selected build, not to the path that selected it. An ignored suite owns its
# cases; the root's prerequisite pass must leave those cases to that suite.
WAMN_TARGET_SELECTION="$(printf '%s\n' "${WAMN_METADATA[@]}" | jq -cs . | python3 -c '
import json
import sys

policy = json.loads(sys.argv[1])
suites = [suite for suite in policy["suites"] if suite["id"] in sys.argv[3].splitlines()]
metadata = json.load(sys.stdin)
plans = [row.split("\t") for row in sys.argv[2].splitlines()]
workspaces = ["root", "apps", "no-std"]
name, tiers = sys.argv[4:6]
kind = "kind" in tiers.split(",")

def targets(suite):
    if suite["target"]:
        return suite["target"]
    md = metadata[workspaces.index(suite["workspace"])]
    package = next(p for p in md["packages"] if p["name"] == suite["package"])
    return [t["kind"][0] + ":" + t["name"] for t in package["targets"] if t.get("test", True)]

coverage = set()
for plan in plans:
    index = int(plan[0])
    packages = plan[3].split()
    features = plan[4].split()
    if plan[1] == "true" and index == 0:
        features = policy["root_features"] + [
            package + "/" + feature
            for step in policy["preparation"] for package in step.get("packages", [])
            if package in packages for feature in step.get("features", [])
        ] + [feature for feature in features if feature.endswith("/cluster")]
    selected = plan[5].split() if len(plan) > 5 else []
    for suite in suites:
        if (suite["execution"] == "libtest" and suite["workspace"] == workspaces[index]
                and suite["package"] in packages
                and (not selected or set(targets(suite)) & set(selected))):
            features += [suite["package"] + "/" + feature for feature in suite["features"]]
    plan[4] = " ".join(dict.fromkeys(features)) or " "
    for package in metadata[index]["packages"]:
        if package["name"] not in packages:
            continue
        for target in package["targets"]:
            key = target["kind"][0] + ":" + target["name"]
            if target.get("test", True) and (not selected or key in selected):
                coverage.add((workspaces[index], package["name"], key))

# Exact kind suites select the aggregate journey. A name that selects focused
# cases instead keeps the target in the root command and omits that suite.
kind_owned = set()
for suite in suites:
    if suite["execution"] == "libtest" and suite["tier"] == "kind" and suite["tests"]:
        suite["tests"] = [test for test in suite["tests"] if name in test]
        if suite["tests"]:
            kind_owned.update((suite["workspace"], suite["package"], target) for target in targets(suite))

run_suites = []
for suite in suites:
    if suite["execution"] == "libtest":
        if suite["tier"] == "kind" and not suite["tests"] and name:
            continue
        root_covers_mode = (suite.get("ignored", False) and kind) or (not suite.get("ignored", False) and tiers != "kind")
        if root_covers_mode and not name and suite["tier"] != "kind":
            remaining = [target for target in targets(suite)
                         if (suite["workspace"], suite["package"], target) not in coverage]
            if not remaining:
                continue
            suite["target"] = remaining
    run_suites.append(suite)

if kind:
    remaining_plans = []
    for plan in plans:
