#!/usr/bin/env bash
set -euo pipefail

readonly WAMN_USAGE='usage: tools/test-changes [--base REF] [--cluster [--name FILTER]] [run|dry-run]'

wamn_fail() {
  local -r exit_code="$1"
  shift
  printf 'test-changes: %s\n' "$*" >&2
  exit "$exit_code"
}

wamn_usage_error() {
  printf '%s\n' "$WAMN_USAGE" >&2
  wamn_fail 64 "$*"
}

readonly WAMN_TOOL_DIRECTORY="$(
  CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_REPOSITORY_ROOT="$(
  CDPATH= cd -- "$WAMN_TOOL_DIRECTORY/.." >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_CARGO="${CARGO:-cargo}"

# The three Cargo workspaces, in run order: label and manifest.
readonly -a WAMN_WORKSPACES=(root apps no-std)
readonly -a WAMN_MANIFESTS=(Cargo.toml apps/Cargo.toml apps/platform/no-std/Cargo.toml)
# The root full run is the acceptance command of docs/operations/running-tests.md.
readonly -a WAMN_ROOT_FULL_FEATURES=(wamn-ctl/ops)

WAMN_BASE=''
WAMN_CLUSTER=false
WAMN_NAME=''
WAMN_COMMAND=''
while (($# > 0)); do
  case "$1" in
    --base)
      (($# >= 2)) || wamn_usage_error '--base requires a Git revision'
      WAMN_BASE="$2"
      shift 2
      ;;
    --cluster)
      WAMN_CLUSTER=true
      shift
      ;;
    --name)
      (($# >= 2)) || wamn_usage_error '--name requires a test name filter'
      WAMN_NAME="$2"
      shift 2
      ;;
    run | dry-run)
      [[ -z "$WAMN_COMMAND" ]] || wamn_usage_error 'expected at most one command'
      WAMN_COMMAND="$1"
      shift
      ;;
    *)
      wamn_usage_error "unknown argument '$1'"
      ;;
  esac
done
readonly WAMN_COMMAND="${WAMN_COMMAND:-run}"
readonly WAMN_CLUSTER WAMN_NAME
if [[ -n "$WAMN_NAME" && "$WAMN_CLUSTER" != true ]]; then
  wamn_usage_error '--name requires --cluster'
fi

cd -- "$WAMN_REPOSITORY_ROOT"
if [[ -z "$WAMN_BASE" ]]; then
  WAMN_BASE="$(git merge-base HEAD main)" || wamn_fail 65 'cannot find the merge base of HEAD and main'
fi
WAMN_BASE="$(git rev-parse --verify --quiet "$WAMN_BASE^{commit}")" ||
  wamn_fail 65 "the base is not a commit: $WAMN_BASE"
readonly WAMN_BASE

# The working tree against the base: committed, staged, unstaged, deleted, and
# untracked paths. Rename detection is off, so a renamed file counts at both paths.
declare -a WAMN_CHANGED=()
mapfile -d '' -t WAMN_CHANGED < <(
  git diff --name-only --no-renames -z "$WAMN_BASE" --
  git ls-files --others --exclude-standard -z
)
readonly WAMN_CHANGED

WAMN_RELEVANT="$(
  jq -n '$ARGS.positional | unique
    | map(select((startswith("docs/") or startswith(".beads/") or test("^[^/]+\\.md$")) | not))' \
    --args -- "${WAMN_CHANGED[@]}"
)"
readonly WAMN_RELEVANT

if [[ "$WAMN_RELEVANT" == '[]' ]]; then
  printf 'working-directory: %q\n' "$WAMN_REPOSITORY_ROOT"
  printf 'base: %s\n' "$WAMN_BASE"
  printf 'selected: nothing\n'
  exit 0
fi

if [[ "$WAMN_CARGO" == */* ]]; then
  [[ -x "$WAMN_CARGO" ]] || wamn_fail 127 "Cargo executable is not executable: $WAMN_CARGO"
else
  command -v "$WAMN_CARGO" >/dev/null 2>&1 || wamn_fail 127 "Cargo executable was not found: $WAMN_CARGO"
fi

declare -a WAMN_METADATA=()
for manifest in "${WAMN_MANIFESTS[@]}"; do
  metadata="$("$WAMN_CARGO" metadata --manifest-path "$WAMN_REPOSITORY_ROOT/$manifest" \
    --locked --offline --format-version 1)" || wamn_fail 65 "locked Cargo metadata failed for $manifest"
  WAMN_METADATA+=("$metadata")
done
readonly WAMN_METADATA

# One line per workspace with work: index, full (true or false), the first input
# that forced a full run as JSON, and the selected packages and features.
# A package selects its dependents in every workspace that resolves it: normal
# and build edges transitively, then one dev edge. With --cluster only the root
# workspace has work, because the other workspaces hold no ignored tests.
readonly WAMN_SELECTION='
def rel($root): ltrimstr($root + "/");
def closure($graph):
  {seen: ., next: .}
  | until(.next == []; .seen as $seen
      | ([.next[] | $graph[.][]?] | unique - $seen) as $new
      | {seen: ($seen + $new), next: $new})
  | .seen;
def graph($md; $kinds):
  reduce ($md.resolve.nodes[] | .id as $to | .deps[]
    | select(any(.dep_kinds[]; (.kind // "normal") | IN($kinds[])))
    | {from: .pkg, $to}) as $edge ({}; .[$edge.from] += [$edge.to]);
def features($package):
  [$package.targets[] | .["required-features"][]?] | unique
  | map(if contains("/") then . else "\($package.name)/\(.)" end);

$metadata[0].workspace_root as $root
| [$metadata | to_entries[] | .key as $index | .value as $md
    | $md.packages[] | select(.id | IN($md.workspace_members[]))
    | {index: $index, name, id, manifest: .manifest_path,
       dir: (.manifest_path | rtrimstr("/Cargo.toml") | rel($root))}] as $members
| [$relevant[] as $path
    | if $path == "Cargo.toml" or $path == "Cargo.lock" then {full: 0, $path}
      elif $path == "apps/Cargo.toml" or $path == "apps/Cargo.lock" then {full: 1, $path}
      elif $path == "apps/platform/no-std/Cargo.toml" or $path == "apps/platform/no-std/Cargo.lock"
      then {full: 2, $path}
      else ([$members[] | select(.dir as $dir | $path | startswith($dir + "/"))]
          | max_by(.dir | length)) as $owner
        | if $owner != null then {package: $owner.manifest}
          elif ($path | test("^apps/[^/]+/")) then
            ($path | capture("^(?<app>apps/[^/]+/)").app) as $app
            | ($members[] | select(.dir + "/" | startswith($app)) | {package: .manifest})
          else {full: 0, $path} end
      end] as $selections
| [$selections[] | .package // empty] | unique as $changed
| range(0; $metadata | length) as $index
| select(($cluster | not) or $index == 0)
| $metadata[$index] as $md
| ([$selections[] | select(.full == $index) | .path] | first) as $full
| ($md.workspace_members) as $workspace
| graph($md; ["normal", "build"]) as $linked
| graph($md; ["dev"]) as $dev
| [$md.packages[] | select(.manifest_path | IN($changed[])) | .id]
| closure($linked) | (. + [.[] | $dev[.][]?]) | unique as $dependents
| [$md.packages[] | select(.id | IN($workspace[]))
    | select($full != null or (.id | IN($dependents[])))] as $selected
| select($selected != [])
| [$index, ($full != null), ($full | tojson),
   ([$selected[].name] | sort | join(" ")),
   ([$selected[] | features(.)[]] | unique | join(" "))]
| @tsv
'

WAMN_PLAN="$(
  printf '%s\n' "${WAMN_METADATA[@]}" | jq -rs --argjson relevant "$WAMN_RELEVANT" \
    --argjson cluster "$WAMN_CLUSTER" '. as $metadata | '"$WAMN_SELECTION"
)" || wamn_fail 65 'could not select packages from Cargo metadata'
readonly WAMN_PLAN

printf 'working-directory: %q\n' "$WAMN_REPOSITORY_ROOT"
printf 'base: %s\n' "$WAMN_BASE"
if [[ -z "$WAMN_PLAN" ]]; then
  printf 'selected: nothing\n'
  exit 0
fi

failed=0
while IFS=$'\t' read -r index full trigger packages features; do
  argv=(test --manifest-path "$WAMN_REPOSITORY_ROOT/${WAMN_MANIFESTS[$index]}"
    --locked --offline --no-fail-fast)
  label="${WAMN_WORKSPACES[$index]}"
  if [[ "$full" == true ]]; then
    label="$label (full: $trigger)"
    argv+=(--workspace)
    if ((index == 0)); then
      features="${WAMN_ROOT_FULL_FEATURES[*]}"
    fi
  else
    for package in $packages; do
      argv+=(-p "$package")
    done
  fi
  if [[ -n "$features" ]]; then
    argv+=(--features "${features// /,}")
  fi
  if [[ -n "$WAMN_NAME" ]]; then
    argv+=("$WAMN_NAME")
  fi
  if [[ "$WAMN_CLUSTER" == true ]]; then
    # Ignored tests start clusters, brokers, and registries, so they run one at a time.
    argv+=(-- --ignored --test-threads=1)
  fi
  if [[ "$WAMN_COMMAND" == dry-run ]]; then
    printf '%s:' "$label"
    printf ' %q' "$WAMN_CARGO" "${argv[@]}"
    printf '\n'
    continue
  fi
  if [[ -n "$WAMN_NAME" ]]; then
    # Libtest lists each matching ignored test as `name: test`.
    listed="$("$WAMN_CARGO" "${argv[@]}" --list --format terse </dev/null)" ||
      wamn_fail 1 "cannot list the ignored tests of $label"
    grep -q ': test$' <<<"$listed" ||
      wamn_fail 1 "no ignored test in the selected packages matches the name filter '$WAMN_NAME'"
  fi
  printf 'test-changes: %s\n' "$label" >&2
  exit_code=0
  "$WAMN_CARGO" "${argv[@]}" </dev/null || exit_code=$?
  if ((exit_code == 0)); then
    printf 'test-changes: PASS: %s\n' "$label" >&2
  else
    printf 'test-changes: FAIL: %s (exit %d)\n' "$label" "$exit_code" >&2
    failed=1
  fi
done <<<"$WAMN_PLAN"
((failed == 0))
