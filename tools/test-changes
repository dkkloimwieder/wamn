#!/usr/bin/env bash
set -euo pipefail

readonly WAMN_USAGE='usage: tools/test-changes [--base REF] [--tier T[,T] [--name FILTER]] [run|dry-run]'

wamn_fail() {
  local -r exit_code="$1"
  shift
  printf 'test-changes: %s\n' "$*" >&2
  exit "$exit_code"
}

wamn_usage_error() {
  printf '%s\n' "$WAMN_USAGE" >&2
  wamn_fail 64 "$*"
}

readonly WAMN_TOOL_DIRECTORY="$(
  CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_REPOSITORY_ROOT="$(
  CDPATH= cd -- "$WAMN_TOOL_DIRECTORY/.." >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_CARGO="${CARGO:-cargo}"
readonly WAMN_DOCKER="${DOCKER:-docker}"

# The three Cargo workspaces, in run order: label and manifest.
readonly -a WAMN_WORKSPACES=(root apps no-std)
readonly -a WAMN_MANIFESTS=(Cargo.toml apps/Cargo.toml apps/platform/no-std/Cargo.toml)

WAMN_BASE=''
WAMN_KIND=false
WAMN_EXPLICIT_TIER=false
WAMN_TIERS='unit,contract,live-postgres,live-nats'
WAMN_NAME=''
WAMN_COMMAND=''
while (($# > 0)); do
  case "$1" in
    --base)
      (($# >= 2)) || wamn_usage_error '--base requires a Git revision'
      WAMN_BASE="$2"
      shift 2
      ;;
    --tier)
      (($# >= 2)) || wamn_usage_error '--tier requires one or more tiers'
      WAMN_EXPLICIT_TIER=true
      WAMN_TIERS="$2"
      shift 2
      ;;
    --name)
      (($# >= 2)) || wamn_usage_error '--name requires a test name filter'
      WAMN_NAME="$2"
      shift 2
      ;;
    run | dry-run)
      [[ -z "$WAMN_COMMAND" ]] || wamn_usage_error 'expected at most one command'
      WAMN_COMMAND="$1"
      shift
      ;;
    *)
      wamn_usage_error "unknown argument '$1'"
      ;;
  esac
done
readonly WAMN_COMMAND="${WAMN_COMMAND:-run}"
[[ "$WAMN_TIERS" != ,* && "$WAMN_TIERS" != *, && "$WAMN_TIERS" != *,,* ]] ||
  wamn_usage_error '--tier requires nonempty tier names'
IFS=',' read -ra requested_tiers <<<"$WAMN_TIERS"
((${#requested_tiers[@]} > 0)) || wamn_usage_error '--tier requires one or more tiers'
for tier in "${requested_tiers[@]}"; do
  case "$tier" in
    unit | contract | live-postgres | live-nats) ;;
    kind) WAMN_KIND=true ;;
    *) wamn_usage_error "unknown tier '$tier'" ;;
  esac
done
readonly WAMN_KIND WAMN_TIERS WAMN_NAME WAMN_EXPLICIT_TIER
if [[ -n "$WAMN_NAME" && "$WAMN_KIND" != true ]]; then
  wamn_usage_error '--name requires --tier kind'
fi

cd -- "$WAMN_REPOSITORY_ROOT"
if [[ -z "$WAMN_BASE" ]]; then
  WAMN_BASE="$(git merge-base HEAD main)" || wamn_fail 65 'cannot find the merge base of HEAD and main'
fi
WAMN_BASE="$(git rev-parse --verify --quiet "$WAMN_BASE^{commit}")" ||
  wamn_fail 65 "the base is not a commit: $WAMN_BASE"
readonly WAMN_BASE

# The working tree against the base: committed, staged, unstaged, deleted, and
# untracked paths. Rename detection is off, so a renamed file counts at both paths.
declare -a WAMN_CHANGED=()
changed_file=$(mktemp "${TMPDIR:-/tmp}/wamn-test-changes.XXXXXXXX")
if ! git diff --name-only --no-renames -z "$WAMN_BASE" -- > "$changed_file"; then
  rm -f -- "$changed_file"
  wamn_fail 65 'cannot read changed paths with git diff'
fi
if ! git ls-files --others --exclude-standard -z >> "$changed_file"; then
  rm -f -- "$changed_file"
  wamn_fail 65 'cannot read untracked paths with git ls-files'
fi
mapfile -d '' -t WAMN_CHANGED < "$changed_file"
rm -f -- "$changed_file"
readonly WAMN_CHANGED

WAMN_POLICY="$(python3 - "$WAMN_REPOSITORY_ROOT/tests/selection.toml" <<'PYTHON'
import json
import sys
import tomllib

with open(sys.argv[1], "rb") as source:
    policy = tomllib.load(source)
if policy["version"] != 1:
    sys.exit("unsupported selection schema version")
identifiers = set()
for suite in policy["suites"]:
    identifier = suite["id"]
    if identifier in identifiers:
        sys.exit(f"duplicate suite: {identifier}")
    identifiers.add(identifier)
    if suite["tier"] not in ("unit", "contract", "live-postgres", "live-nats", "kind"):
        sys.exit(f"suite {identifier}: invalid tier")
    if suite["workspace"] not in ("root", "apps", "no-std"):
        sys.exit(f"suite {identifier}: invalid workspace")
    if suite["execution"] not in ("commands", "libtest", "docker-guests"):
        sys.exit(f"suite {identifier}: invalid execution policy")
    if suite["mode"] not in ("always", "local"):
        sys.exit(f"suite {identifier}: invalid mode")
    if suite["timeout"] != 1800 or not isinstance(suite["resource_lock"], str):
        sys.exit(f"suite {identifier}: use the shared 30-minute silent-stage limit and a resource lock string")
print(json.dumps(policy))
PYTHON
)" || wamn_fail 65 'cannot read tests/selection.toml'
readonly WAMN_POLICY
WAMN_RELEVANT="$(
  jq -n --argjson policy "$WAMN_POLICY" '$ARGS.positional | unique
    | map(select(. as $path | any($policy.documentation[];
        . as $pattern | $path | test($pattern)) | not))' \
    --args -- "${WAMN_CHANGED[@]}"
)"
readonly WAMN_RELEVANT

if [[ "$WAMN_RELEVANT" == '[]' ]]; then
  printf 'working-directory: %q\n' "$WAMN_REPOSITORY_ROOT"
  printf 'base: %s\n' "$WAMN_BASE"
  printf 'selected: nothing\n'
  [[ -z "$WAMN_NAME" ]] ||
    wamn_fail 1 "no package is selected, so no ignored test matches the name filter '$WAMN_NAME'"
  exit 0
fi

if [[ "$WAMN_CARGO" == */* ]]; then
  [[ -x "$WAMN_CARGO" ]] || wamn_fail 127 "Cargo executable is not executable: $WAMN_CARGO"
else
  command -v "$WAMN_CARGO" >/dev/null 2>&1 || wamn_fail 127 "Cargo executable was not found: $WAMN_CARGO"
fi

declare -a WAMN_METADATA=()
for manifest in "${WAMN_MANIFESTS[@]}"; do
  metadata="$("$WAMN_CARGO" metadata --manifest-path "$WAMN_REPOSITORY_ROOT/$manifest" \
    --locked --offline --format-version 1)" || wamn_fail 65 "locked Cargo metadata failed for $manifest"
  WAMN_METADATA+=("$metadata")
done
readonly WAMN_METADATA

selector_errors="$(printf '%s\n' "${WAMN_METADATA[@]}" | jq -rs --argjson policy "$WAMN_POLICY" '
  . as $metadata | $policy.suites[] | select(.execution == "libtest") | . as $suite
  | (["root", "apps", "no-std"] | index($suite.workspace)) as $index
  | $metadata[$index] as $md
  | [$md.packages[] | select(.id | IN($md.workspace_members[]))
      | select(.name == $suite.package)] as $packages
  | if $packages == [] then "suite \($suite.id): missing package \($suite.package) in \($suite.workspace)"
    else $suite.target[] as $target
      | ($target | split(":")) as $parts
      | select(all($packages[0].targets[];
          .name != $parts[1] or (.kind | index($parts[0]) | not)))
      | "suite \($suite.id): missing target \($target) in \($suite.package)"
    end')" || wamn_fail 65 'cannot read suite selectors'
[[ -z "$selector_errors" ]] || wamn_fail 65 "$selector_errors"

# One line per workspace with work: index, full (true or false), the first input
# that forced a full run as JSON, and the selected packages and features.
# A package selects its dependents in every workspace that resolves it: normal
# and build edges transitively, then one dev edge. Kind selection enables
# each selected package's cluster feature.
# Shared WIT paths have direct bindgen readers outside Cargo dependency edges.
readonly WAMN_SELECTION='
def rel($root): ltrimstr($root + "/");
def closure($graph):
  {seen: ., next: .}
  | until(.next == []; .seen as $seen
      | ([.next[] | $graph[.][]?] | unique - $seen) as $new
      | {seen: ($seen + $new), next: $new})
  | .seen;
def graph($md; $kinds):
  reduce ($md.resolve.nodes[] | .id as $to | .deps[]
    | select(any(.dep_kinds[]; (.kind // "normal") | IN($kinds[])))
    | {from: .pkg, $to}) as $edge ({}; .[$edge.from] += [$edge.to]);
def features($package):
  [$package.targets[] | .["required-features"][]? | select(. != "cluster" or $cluster)] | unique
  | map(if contains("/") then . else "\($package.name)/\(.)" end);

$metadata[0].workspace_root as $root
| [$metadata | to_entries[] | .key as $index | .value as $md
    | $md.packages[] | select(.id | IN($md.workspace_members[]))
    | {index: $index, name, id, manifest: .manifest_path,
       dir: (.manifest_path | rtrimstr("/Cargo.toml") | rel($root))}] as $members
| [$relevant[] as $path
    | if $path == "Cargo.toml" or $path == "Cargo.lock" then {full: 0, $path}
      elif $path == "apps/Cargo.toml" or $path == "apps/Cargo.lock" then {full: 1, $path}
      elif $path == "apps/platform/no-std/Cargo.toml" or $path == "apps/platform/no-std/Cargo.lock"
      then {full: 2, $path}
      else ([$members[] | select(.dir as $dir | $path | startswith($dir + "/"))]
          | max_by(.dir | length)) as $owner
        | [$policy.rules[] | select(any(.inputs[];
            . as $pattern | $path | test($pattern)))] as $rules
        | [$rules[] | select(.application == true and $owner == null
            and all($rules[]; (.workspaces // []) == []))
            | ($path | capture("^(?<app>apps/[^/]+/)").app) as $app
            | $members[] | select(.dir + "/" | startswith($app))] as $applications
        | (if $owner != null then {package: $owner.manifest} else empty end),
          ($applications[] | {package: .manifest}),
          ($rules[] | .workspaces[]? as $workspace
            | {full: ($workspaces | index($workspace)), $path}),
          (if $owner == null and $applications == []
               and all($rules[]; (.workspaces // []) == [])
           then {unknown: true, $path} else empty end)
      end] as $selections
| [$selections[] | .package // empty] | unique as $changed
| ([$selections[] | select(.unknown) | .path] | first) as $unknown
| {unknown: ($unknown != null), workspaces: [range(0; $metadata | length) as $index
| $metadata[$index] as $md
| ($unknown // ([$selections[] | select(.full == $index) | .path] | first)) as $full
| ($md.workspace_members) as $workspace
| graph($md; ["normal", "build"]) as $linked
| graph($md; ["dev"]) as $dev
| [$md.packages[] | select(.manifest_path | IN($changed[])) | .id]
| closure($linked) | (. + [.[] | $dev[.][]?]) | unique as $dependents
| [$md.packages[] | select(.id | IN($workspace[]))
    | select($full != null or (.id | IN($dependents[])))
    | . as $package
    | select(($explicit | not) or any($policy.targets[]; .workspace == $workspaces[$index]
        and .package == $package.name and (.tier | IN($tiers[]))))] as $selected
| select($selected != [])
| [$index, ($full != null), ($full | tojson),
   ([$selected[].name] | sort | join(" ")),
   ([$selected[] | features(.)[]]
      + [$selected[] as $package | $policy.preparation[]
          | select(.packages | index($package.name)) | .features[]?
          | "\($package.name)/\(.)"]
      + [$selected[] | select($cluster and (.features // {} | has("cluster")))
          | "\(.name)/cluster"]
      | unique | join(" "))]
]}
'

WAMN_DISCOVERY="$(
  printf '%s\n' "${WAMN_METADATA[@]}" | jq -rs --argjson relevant "$WAMN_RELEVANT" \
    --argjson policy "$WAMN_POLICY" \
    --argjson workspaces "$(printf '%s\n' "${WAMN_WORKSPACES[@]}" | jq -Rsc 'split("\n")[:-1]')" \
    --argjson cluster "$WAMN_KIND" --argjson explicit "$WAMN_EXPLICIT_TIER" --arg tiers "$WAMN_TIERS" '($tiers | split(",")) as $tiers | . as $metadata | '"$WAMN_SELECTION"
)" || wamn_fail 65 'could not select packages from Cargo metadata'
# Keep an empty feature column from shifting the target column in Bash.
if [[ "$WAMN_EXPLICIT_TIER" == false ]]; then
  WAMN_PLAN="$(jq -r '.workspaces[] | @tsv' <<<"$WAMN_DISCOVERY")"
else
WAMN_PLAN="$(printf '%s\n' "${WAMN_METADATA[@]}" | jq -rs \
  --argjson discovery "$WAMN_DISCOVERY" --argjson policy "$WAMN_POLICY" \
  --arg tiers "$WAMN_TIERS" '
  ($tiers | split(",")) as $tiers
  | . as $metadata | $discovery.workspaces[]
  | . as $plan | .[0] as $index
  | (["root", "apps", "no-std"][$index]) as $workspace
  | [.[3] | split(" ")[] | . as $package
      | [$policy.targets[] | select(.workspace == $workspace and .package == $package)] as $all
      | {package: $package, all: $all, selected: [$all[] | select(.tier | IN($tiers[]))]}] as $packages
  | if all($packages[]; .all == .selected)
      and ($plan[1] == false or
        all($metadata[$index].packages[] | select(.id | IN($metadata[$index].workspace_members[]));
          .name | IN($packages[].package)))
    then $plan | @tsv
    else $packages[] | select(.selected != [])
      | . as $package
      | [$index, false, $plan[2], .package,
          ($plan[4] | split(" ") | map(select(startswith($package.package + "/")))
            | join(" ") | if . == "" then " " else . end),
          (.selected | map(.target) | join(" "))] | @tsv
    end')"
fi
readonly WAMN_PLAN

printf 'working-directory: %q\n' "$WAMN_REPOSITORY_ROOT"
printf 'base: %s\n' "$WAMN_BASE"
if [[ -z "$WAMN_PLAN" && -n "$WAMN_NAME" ]]; then
  printf 'selected: nothing\n'
  [[ -z "$WAMN_NAME" ]] ||
    wamn_fail 1 "no package is selected, so no ignored test matches the name filter '$WAMN_NAME'"
  exit 0
fi

# Path rules supplement Cargo edges, including readers outside their package.
WAMN_PACKAGES="$(printf '%s\n' "${WAMN_METADATA[@]}" | jq -rs '[.[] | . as $md
  | .packages[] | select(.id | IN($md.workspace_members[])) | .name] | unique')"
WAMN_SELECTED="$(jq '[.workspaces[] | {index: .[0], packages: (.[3] | split(" "))}]' <<<"$WAMN_DISCOVERY")"
WAMN_GUEST_RULE="$(jq -c '.suites[] | select(.execution == "docker-guests")' <<<"$WAMN_POLICY")"
WAMN_GUEST_STAGE="$(jq -r '.stage' <<<"$WAMN_GUEST_RULE")"
WAMN_DOCKERFILE="$(jq -r '.dockerfile' <<<"$WAMN_GUEST_RULE")"
if [[ -f "$WAMN_DOCKERFILE" ]]; then
  guest_source="$(cat -- "$WAMN_DOCKERFILE")"
else
  guest_source="$(git show "$WAMN_BASE:$WAMN_DOCKERFILE")" ||
    wamn_fail 65 "cannot read deleted guest input $WAMN_DOCKERFILE from Git"
fi
declare -a guests=()
mapfile -t guests < <(
  awk -v stage="$WAMN_GUEST_STAGE" '$1 == "FROM" { in_stage = ($NF == stage); next } in_stage' <<<"$guest_source" |
    grep -oE -- '-p [A-Za-z0-9_-]+' | cut -d ' ' -f 2
)
((${#guests[@]} > 0)) ||
  wamn_fail 65 "the Dockerfile stage $WAMN_GUEST_STAGE names no guest package"
WAMN_SUITES="$(jq -r --argjson paths "$WAMN_RELEVANT" --argjson selected "$WAMN_SELECTED" \
  --argjson discovery "$WAMN_DISCOVERY" --arg tiers "$WAMN_TIERS" \
  --argjson guests "$(printf '%s\n' "${guests[@]}" | jq -Rsc 'split("\n")[:-1]')" '
  .suites[] | . as $suite
  | select(.mode == "always" or (.tier | IN($tiers | split(",") | .[])))
  | select($discovery.unknown or .always == true
      or any($paths[]; . as $path | any($suite.inputs[]; . as $pattern | $path | test($pattern)))
      or any($selected[].packages[]; IN($suite.select_packages[]?))
      or (.execution == "docker-guests" and any($selected[] | select(.index == 1) | .packages[]; IN($guests[]))))
  | .id' <<<"$WAMN_POLICY")" || wamn_fail 65 'cannot select suites'
declare -a WAMN_SELECTED_PACKAGES=()
mapfile -t WAMN_SELECTED_PACKAGES < <(awk -F '\t' '$1 == 0 {print $4}' <<<"$WAMN_PLAN" | tr ' ' '\n')
wamn_package_selected() {
  local package
  for package in "${WAMN_SELECTED_PACKAGES[@]}"; do
    [[ "$package" != "$1" ]] || return 0
  done
  return 1
}
printf 'suites: %s\n' "$(paste -sd ' ' <<<"$WAMN_SUITES")"

failed=0
wamn_step() {
  local -r label="$1"
  shift
  if [[ "$WAMN_COMMAND" == dry-run ]]; then
    printf '%s:' "$label"
    printf ' %q' "$@"
    printf '\n'
    return 0
  fi
  printf 'test-changes: %s\n' "$label" >&2
  local exit_code=0
  "$@" </dev/null || exit_code=$?
  if ((exit_code == 0)); then
    printf 'test-changes: PASS: %s\n' "$label" >&2
  else
    printf 'test-changes: FAIL: %s (exit %d)\n' "$label" "$exit_code" >&2
    failed=1
  fi
  return "$exit_code"
}
wamn_test() {
  local label="$1"
  shift
  local -a result_flags=()
  if [[ ${1:-} == --expected-test ]]; then result_flags+=("$1" "$2"); shift 2; fi
  if [[ ${1:-} == --each-target ]]; then result_flags+=("$1"); shift; fi
  wamn_step "$label" "$WAMN_TOOL_DIRECTORY/require-test-result" "${result_flags[@]}" "$WAMN_CARGO" test \
    --locked --offline --no-fail-fast "$@"
}

wamn_suite_arguments() {
  local suite="$1" workspace index target feature
  workspace="$(jq -r '.workspace' <<<"$suite")"
  for index in "${!WAMN_WORKSPACES[@]}"; do
    [[ "${WAMN_WORKSPACES[$index]}" != "$workspace" ]] || break
  done
  suite_argv=(--manifest-path "$WAMN_REPOSITORY_ROOT/${WAMN_MANIFESTS[$index]}"
    -p "$(jq -r '.package' <<<"$suite")")
  while IFS= read -r target; do
    case "$target" in
      lib:*) suite_argv+=(--lib) ;;
      test:* | bin:* | example:* | bench:*) suite_argv+=("--${target%%:*}" "${target#*:}") ;;
      *) wamn_fail 65 "invalid suite target: $target" ;;
    esac
  done < <(jq -r '.target[]' <<<"$suite")
  feature="$(jq -r '.features | join(",")' <<<"$suite")"
  [[ -z "$feature" ]] || suite_argv+=(--features "$feature")
}

# Inputs are built before any test. A failed input stops dependent tests.
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$WAMN_REPOSITORY_ROOT/target}"
[[ "$CARGO_TARGET_DIR" == /* ]] || export CARGO_TARGET_DIR="$WAMN_REPOSITORY_ROOT/$CARGO_TARGET_DIR"
export PATH="$CARGO_TARGET_DIR/debug:$PATH"
export WAMN_APPLICATION_COMPONENTS="$CARGO_TARGET_DIR/virtualized/std-empty-environment"
export WAMN_EDGE_DEVICE_COMPONENT="$WAMN_REPOSITORY_ROOT/apps/target/wamn/edge_device/components/device.wasm"
export WAMN_PLATFORM_UI_DIST="$WAMN_REPOSITORY_ROOT/apps/platform_ui/dist"
export WAMN_JSONATA_COMPONENT="$WAMN_REPOSITORY_ROOT/apps/target/wamn/wamn_wms/components/jsonata.wasm"
need_edge=false
need_packages=false
need_fixture=false
need_nats=false
need_route=false
WAMN_PREREQUISITES="$(jq -r --argjson selected "$WAMN_SELECTED" --argjson members "$WAMN_PACKAGES" \
  --arg suites "$WAMN_SUITES" '
  [(.suites[] | select(.id | IN($suites | split("\n") | .[])) | .prerequisites[]),
   (.preparation[] | . as $rule
     | select(if .suites then
         any(.suites[]; IN($suites | split("\n") | .[])) and any($members[]; IN($rule.packages[]))
         else any($selected[] | select(.index == 0) | .packages[]; IN($rule.packages[])) end)
     | .prerequisites[]?)] | unique | .[]' <<<"$WAMN_POLICY")"
wamn_prerequisite() { grep -qxF -- "$1" <<<"$WAMN_PREREQUISITES"; }
if wamn_prerequisite packages; then need_packages=true; fi
if wamn_prerequisite fixture; then need_fixture=true; fi
if wamn_prerequisite edge; then need_edge=true; fi
if wamn_prerequisite nats; then need_nats=true; fi
if wamn_prerequisite route; then need_route=true; fi
# Clippy compiles every target, including generated application source and
# compile-time fixture reads. Derive those application roots from Cargo targets.
declare -a applications=()
declare -A application_seen=()
wamn_application() {
  local app="$1" base source
  [[ -z "${application_seen[$app]:-}" ]] || return 0
  application_seen[$app]=true
  # Authored base package IDs use one package = "id" line per dependency.
  while IFS= read -r base; do
    while IFS= read -r source; do
      if [[ "$(basename "${source%/wamn.k}")" == "$base" ]]; then
        wamn_application "${source%/wamn.k}"
        break
      fi
    done < <(rg --files apps -g wamn.k)
  done < <(sed -n 's/^[[:space:]]*package = "\([^" ]*\)".*/\1/p' "$app/wamn.k")
  applications+=("$app")
}
if wamn_prerequisite applications; then
  mapfile -t input_sources < <(printf '%s\n' "${WAMN_METADATA[@]}" | jq -rs -r '
    .[] | . as $md | .packages[] | select(.id | IN($md.workspace_members[]))
    | .manifest_path, .targets[].src_path? // empty')
  for source in "${input_sources[@]}"; do
    directory="${source%/*}"
    while [[ "$directory" == "$WAMN_REPOSITORY_ROOT/apps/"* ]]; do
      if [[ -f "$directory/wamn.k" ]]; then
        wamn_application "${directory#"$WAMN_REPOSITORY_ROOT/"}"
        break
      fi
      directory="${directory%/*}"
    done
  done
fi
if [[ "$need_fixture" == true ]]; then
  wamn_application apps/platform_fixture
  wamn_application apps/platform_fixture_overlay
fi
if [[ "$need_packages" == true ]]; then
  while IFS= read -r app; do wamn_application "$app"; done \
    < <(jq -r '.packages[]' deploy/gcp/environments/*.json | sort -u)
  if wamn_prerequisite client-acme; then wamn_application apps/client_acme_receiving; fi
fi
if [[ "$need_edge" == true ]]; then wamn_application apps/edge_device; fi
if [[ "$need_nats" == true ]]; then
  if [[ "$WAMN_COMMAND" == dry-run ]]; then
    printf 'input nats: use WAMN_NATIVE_C_NATS_BIN or nats-server on PATH (prebuilt only)\n'
  else
    export WAMN_NATIVE_C_NATS_BIN="${WAMN_NATIVE_C_NATS_BIN:-$(command -v nats-server || :)}"
    [[ -n "$WAMN_NATIVE_C_NATS_BIN" && -x "$WAMN_NATIVE_C_NATS_BIN" ]] ||
      wamn_fail 65 'set WAMN_NATIVE_C_NATS_BIN to an existing prebuilt nats-server executable'
  fi
fi
if ((${#applications[@]} > 0)); then
  bins=(-p wamn-ctl --bin wamn -p wamn-test-infrastructure --bins)
  if [[ "$need_route" == true ]]; then bins+=(-p wamn-host); fi
  wamn_step 'input bins' "$WAMN_CARGO" build --locked --offline "${bins[@]}" || exit 1
fi
if [[ "$need_route" == true ]]; then
  export WAMN_HOST_BINARY="$CARGO_TARGET_DIR/debug/wamn-host"
  export WAMN_FLOW_HTTP_COMPONENT="$CARGO_TARGET_DIR/apps/wasm32-wasip2/release/http_route.wasm"
  export WAMN_MATERIALIZER_COMPONENT="$CARGO_TARGET_DIR/apps/wasm32-wasip2/debug/materializer.wasm"
  if [[ "$WAMN_COMMAND" == dry-run ]]; then guest_flags='$(tools/guest-rustflags)'
  else guest_flags="$("$WAMN_TOOL_DIRECTORY/guest-rustflags")"; fi
  wamn_step 'input http-route' env "RUSTFLAGS=$guest_flags" "$WAMN_CARGO" build --locked --offline \
    --release --manifest-path apps/Cargo.toml --target-dir "$CARGO_TARGET_DIR/apps" \
    --target wasm32-wasip2 -p http-route || exit 1
  wamn_step 'input materializer' env "RUSTFLAGS=$guest_flags" "$WAMN_CARGO" build --locked --offline \
    --manifest-path apps/Cargo.toml --target-dir "$CARGO_TARGET_DIR/apps" \
    --target wasm32-wasip2 -p materializer || exit 1
  wamn_step 'input native guest directory' mkdir -p "$CARGO_TARGET_DIR/wasm32-wasip2/debug" || exit 1
  for guest in transform http-request http-page; do
    wamn_step "input $guest" env "RUSTFLAGS=$guest_flags" "$WAMN_CARGO" build --locked --offline \
      --manifest-path apps/platform/no-std/Cargo.toml --target-dir "$CARGO_TARGET_DIR/no-std" \
      --target wasm32-wasip2 -p "$guest" || exit 1
    wamn_step "input native $guest" cp "$CARGO_TARGET_DIR/no-std/wasm32-wasip2/debug/${guest//-/_}.wasm" \
      "$CARGO_TARGET_DIR/wasm32-wasip2/debug/${guest//-/_}.wasm" || exit 1
  done
fi
if ((${#applications[@]} > 0)); then
  wamn_step 'input applications' "$CARGO_TARGET_DIR/debug/wamn-test-postgres" \
    --database prekind_build --url-env DATABASE_URL -- \
    "$CARGO_TARGET_DIR/debug/wamn" build "${applications[@]}" || exit 1
fi

# Resolve every selected exact selector before any test execution.
if [[ "$WAMN_COMMAND" != dry-run ]]; then
  while IFS= read -r suite; do
    wamn_suite_arguments "$suite"
    while IFS= read -r name; do
      list_argv=("${suite_argv[@]}" "$name" -- --exact --list --format terse)
      if [[ "$(jq -r '.ignored // false' <<<"$suite")" == true ]]; then list_argv+=(--ignored); fi
      listed="$("$WAMN_CARGO" test --locked --offline "${list_argv[@]}" </dev/null)" ||
        wamn_fail 65 "cannot list exact selector $name"
      grep -qxF -- "$name: test" <<<"$listed" ||
        wamn_fail 65 "suite $(jq -r '.id' <<<"$suite"): missing exact test $name"
    done < <(jq -r '.tests[]' <<<"$suite")
  done < <(jq -c --arg suites "$WAMN_SUITES" '.suites[]
    | select(.id | IN($suites | split("\n") | .[]))
    | select(.execution == "libtest" and .tests != [])' <<<"$WAMN_POLICY")
fi

wamn_run_suite() {
  local suite="$1" label execution name filter resource
  label="$(jq -r '.label // .id' <<<"$suite")"
  execution="$(jq -r '.execution' <<<"$suite")"
  resource="$(jq -r '.resource_lock' <<<"$suite")"
  if [[ -n "$resource" && "$WAMN_COMMAND" != dry-run ]]; then
    mkdir -p "$CARGO_TARGET_DIR/test-locks"
    exec 9>"$CARGO_TARGET_DIR/test-locks/$resource"
    flock 9
  fi
  case "$execution" in
    commands)
      while IFS= read -r command; do
        mapfile -d '' -t command_argv < <(jq -j '.[] | ., "\u0000"' <<<"$command")
        wamn_step "${command_argv[@]}" || :
      done < <(jq -c '.commands[]' <<<"$suite")
      ;;
    libtest)
      if [[ "$(jq -r '.covered_by_package // false' <<<"$suite")" == true ]] &&
        wamn_package_selected "$(jq -r '.package' <<<"$suite")"; then return 0; fi
      wamn_suite_arguments "$suite"
      filter="$(jq -r '.filter // ""' <<<"$suite")"
      if [[ "$(jq '.tests | length' <<<"$suite")" == 0 ]]; then
        [[ -z "$filter" ]] || suite_argv+=("$filter")
        if [[ "$(jq -r '.ignored // false' <<<"$suite")" == true ]]; then
          suite_argv+=(-- --ignored --test-threads=1)
        fi
        result_flags=()
        if [[ "$(jq '.target | length' <<<"$suite")" != 0 ]]; then result_flags+=(--each-target); fi
        wamn_test "$label" "${result_flags[@]}" "${suite_argv[@]}" || :
      else
        while IFS= read -r name; do
          exact_argv=("${suite_argv[@]}" "$name" -- --exact --test-threads=1)
          if [[ "$(jq -r '.ignored // false' <<<"$suite")" == true ]]; then exact_argv+=(--ignored); fi
          wamn_test "$label" --expected-test "$name" --each-target "${exact_argv[@]}" || :
        done < <(jq -r '.tests[]' <<<"$suite")
      fi
      ;;
    docker-guests)
      wamn_step "$label" "$WAMN_DOCKER" build --target "$(jq -r '.stage' <<<"$suite")" \
        --build-arg WAMN_CHECKOUT_KEY="$(printf '%s' "$(realpath "$WAMN_REPOSITORY_ROOT")" | sha256sum | cut -c1-16)" \
        "$WAMN_REPOSITORY_ROOT" || :
      ;;
  esac
  if [[ -n "$resource" && "$WAMN_COMMAND" != dry-run ]]; then exec 9>&-; fi
}

while IFS= read -r suite; do wamn_run_suite "$suite"; done < <(
  jq -c --arg suites "$WAMN_SUITES" '.suites[] | select(.mode == "always")
    | select(.id | IN($suites | split("\n") | .[]))' <<<"$WAMN_POLICY"
)

while IFS=$'\t' read -r index full trigger packages features targets; do
  [[ -n "$index" ]] || continue
  argv=(test --manifest-path "$WAMN_REPOSITORY_ROOT/${WAMN_MANIFESTS[$index]}"
    --locked --offline --no-fail-fast)
  label="${WAMN_WORKSPACES[$index]}"
  if [[ "$full" == true ]]; then
    label="$label (full: $trigger)"
    argv+=(--workspace)
    if ((index == 0)); then
      cluster_features=''
      for feature in $features; do
        [[ "$feature" != */cluster ]] || cluster_features+=" $feature"
      done
      features="$(jq -r '.root_features | join(" ")' <<<"$WAMN_POLICY")$cluster_features"
    fi
  else
    for package in $packages; do
      argv+=(-p "$package")
    done
  fi
  features="${features# }"
  if [[ -n "$features" ]]; then
    argv+=(--features "${features// /,}")
  fi
  for target in $targets; do
    case "$target" in
      lib:* | cdylib:* | staticlib:* | rlib:* | dylib:*) argv+=(--lib) ;;
      test:* | bin:* | example:* | bench:*) argv+=("--${target%%:*}" "${target#*:}") ;;
      *) wamn_fail 65 "invalid target: $target" ;;
    esac
  done
  if [[ -n "$WAMN_NAME" ]]; then
    argv+=("$WAMN_NAME")
  fi
  if [[ "$WAMN_TIERS" == kind ]]; then
    # Kind tests run one at a time.
    argv+=(-- --ignored --test-threads=1)
  elif [[ "$WAMN_KIND" == true ]]; then
    argv+=(-- --include-ignored --test-threads=1)
  fi
  if [[ "$WAMN_COMMAND" == dry-run ]]; then
    printf '%s:' "$label"
    printf ' %q' "$WAMN_CARGO" "${argv[@]}"
    printf '\n'
    continue
  fi
  if [[ -n "$WAMN_NAME" ]]; then
    # Libtest lists each matching ignored test as `name: test`.
    listed="$("$WAMN_CARGO" "${argv[@]}" --list --format terse </dev/null)" ||
      wamn_fail 1 "cannot list the ignored tests of $label"
    grep -q ': test$' <<<"$listed" ||
      wamn_fail 1 "no ignored test in the selected packages matches the name filter '$WAMN_NAME'"
  fi
  printf 'test-changes: %s\n' "$label" >&2
  exit_code=0
  "$WAMN_TOOL_DIRECTORY/require-test-result" "$WAMN_CARGO" "${argv[@]}" </dev/null || exit_code=$?
  if ((exit_code == 0)); then
    printf 'test-changes: PASS: %s\n' "$label" >&2
  else
    printf 'test-changes: FAIL: %s (exit %d)\n' "$label" "$exit_code" >&2
    failed=1
  fi
done <<<"$WAMN_PLAN"

# Ask NATS itself for an unused port, bound only on loopback. Own this process
# and its storage, including on a signal or test failure. Never reuse a broker.
nats_pid=''
nats_directory=''
wamn_cleanup() {
  if [[ -n "$nats_pid" ]]; then
    kill "$nats_pid" 2>/dev/null || :
    wait "$nats_pid" 2>/dev/null || :
  fi
  if [[ -n "$nats_directory" ]]; then rm -rf -- "$nats_directory"; fi
}
trap wamn_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if wamn_prerequisite private-nats; then
  if [[ "$WAMN_COMMAND" == dry-run ]]; then
    printf 'input jetstream: private nats-server -js -a 127.0.0.1 -p -1 -sd <temporary directory>\n'
  else
    nats_directory="$(mktemp -d "${TMPDIR:-/tmp}/wamn-test-changes-nats.XXXXXXXX")"
    "$WAMN_NATIVE_C_NATS_BIN" -js -a 127.0.0.1 -p -1 -sd "$nats_directory/data" \
      >"$nats_directory/server.log" 2>&1 &
    nats_pid=$!
    for ((attempt = 0; attempt < 100; attempt++)); do
      if grep -q 'Server is ready' "$nats_directory/server.log"; then break; fi
      kill -0 "$nats_pid" 2>/dev/null || break
      sleep 0.1
    done
    port="$(sed -n 's/.*Listening for client connections on 127.0.0.1:\([0-9]*\).*/\1/p' \
      "$nats_directory/server.log" | head -1)"
    if [[ -z "$port" ]] || ! grep -q 'Server is ready' "$nats_directory/server.log"; then
      cat "$nats_directory/server.log" >&2
      wamn_fail 1 'private NATS did not become ready'
    fi
    export WAMN_EVT_NATS_URL="nats://127.0.0.1:$port"
  fi
fi

while IFS= read -r suite; do wamn_run_suite "$suite"; done < <(
  jq -c --arg suites "$WAMN_SUITES" '.suites[] | select(.mode == "local")
    | select(.id | IN($suites | split("\n") | .[]))' <<<"$WAMN_POLICY"
)
((failed == 0))
