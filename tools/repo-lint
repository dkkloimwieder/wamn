#!/usr/bin/env bash
set -euo pipefail

readonly WAMN_USAGE='usage: tools/repo-lint [run|dry-run]'

wamn_fail() {
  local -r exit_code="$1"
  shift
  printf 'repo-lint: %s\n' "$*" >&2
  exit "$exit_code"
}

wamn_usage_error() {
  printf '%s\n' "$WAMN_USAGE" >&2
  wamn_fail 64 "$*"
}

readonly WAMN_TOOL_DIRECTORY="$(
  CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_REPOSITORY_ROOT="$(
  CDPATH= cd -- "$WAMN_TOOL_DIRECTORY/.." >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_ROOT_MANIFEST="$WAMN_REPOSITORY_ROOT/Cargo.toml"
readonly WAMN_COMPONENT_MANIFEST="$WAMN_REPOSITORY_ROOT/components/Cargo.toml"
readonly WAMN_CARGO="${CARGO:-cargo}"
readonly WAMN_CONNECTION_HTTP_NATIVE_RUSTFLAGS='-C panic=abort'

# The trusted HTTP connection effect must construct one client per invocation
# and drop it at function exit. The wash-runtime pooled egress path keys its
# connection pool by workload_id alone, so any client that outlives a single
# invocation would let two credential generations share one connection.
readonly WAMN_CONNECTION_HTTP_SOURCE="$WAMN_REPOSITORY_ROOT/crates/platform/runtime/src/plugins/connection_http.rs"
readonly WAMN_CONNECTION_HTTP_BUILDER='reqwest::Client::builder('
readonly -a WAMN_CONNECTION_HTTP_REFUSED_PATTERN=(
  '^[[:space:]]+[A-Za-z_]+:[^=]*Client'
  '(^|[[:space:]])static[[:space:]]|OnceLock|OnceCell|LazyLock|lazy_static|once_cell'
  'OutgoingHandler|send_request|wasmtime_wasi_http|wasi_http|wasi:http'
)
readonly -a WAMN_CONNECTION_HTTP_REFUSED_REASON=(
  'holds an HTTP client in a struct field'
  'holds an HTTP client in a process-wide or lazily initialized cell'
  'reaches the wash-runtime pooled egress path, keyed by workload_id alone'
)

readonly -a WAMN_ROOT_FORMAT=(
  fmt --manifest-path "$WAMN_ROOT_MANIFEST" --all -- --check
)
readonly -a WAMN_COMPONENT_FORMAT=(
  fmt --manifest-path "$WAMN_COMPONENT_MANIFEST" --all -- --check
)
readonly -a WAMN_ROOT_CLIPPY=(
  clippy --manifest-path "$WAMN_ROOT_MANIFEST" --locked --workspace
  --all-targets -- -D warnings
)
readonly -a WAMN_COMPONENT_NATIVE_CLIPPY=(
  clippy --manifest-path "$WAMN_COMPONENT_MANIFEST" --locked --workspace
  --exclude flowrunner --exclude connection-http-standard
  --all-targets -- -D warnings
)
readonly -a WAMN_CONNECTION_HTTP_NATIVE_CLIPPY=(
  clippy --manifest-path "$WAMN_COMPONENT_MANIFEST" --locked
  --package connection-http-standard -- -D warnings
)
readonly -a WAMN_FLOWRUNNER_NATIVE_CLIPPY=(
  clippy --manifest-path "$WAMN_COMPONENT_MANIFEST" --locked
  --package flowrunner --all-targets -- -D warnings -A dead-code
)
readonly -a WAMN_COMPONENT_WASM_CLIPPY=(
  clippy --manifest-path "$WAMN_COMPONENT_MANIFEST" --locked --workspace
  --exclude flowrunner --target wasm32-wasip2 -- -D warnings
)
readonly -a WAMN_FLOWRUNNER_WASM_CLIPPY=(
  clippy --manifest-path "$WAMN_COMPONENT_MANIFEST" --locked
  --package flowrunner --target wasm32-wasip2 -- -D warnings -A dead-code
)

wamn_print_plan() {
  local -r label="$1"
  shift
  printf '%s:' "$label"
  printf ' %q' "$WAMN_CARGO" "$@"
  printf '\n'
}

wamn_dry_run() {
  printf 'working-directory: %q\n' "$WAMN_REPOSITORY_ROOT"
  printf 'connection-http-construction: %q\n' "$WAMN_CONNECTION_HTTP_SOURCE"
  wamn_print_plan 'root-rustfmt' "${WAMN_ROOT_FORMAT[@]}"
  wamn_print_plan 'components-rustfmt' "${WAMN_COMPONENT_FORMAT[@]}"
  wamn_print_plan 'root-clippy' "${WAMN_ROOT_CLIPPY[@]}"
  wamn_print_plan 'components-native-clippy' "${WAMN_COMPONENT_NATIVE_CLIPPY[@]}"
  printf 'connection-http-native-clippy: RUSTFLAGS=%q' \
    "$WAMN_CONNECTION_HTTP_NATIVE_RUSTFLAGS"
  printf ' %q' "$WAMN_CARGO" "${WAMN_CONNECTION_HTTP_NATIVE_CLIPPY[@]}"
  printf '\n'
  wamn_print_plan 'flowrunner-native-clippy' "${WAMN_FLOWRUNNER_NATIVE_CLIPPY[@]}"
  wamn_print_plan 'components-wasm-clippy' "${WAMN_COMPONENT_WASM_CLIPPY[@]}"
  wamn_print_plan 'flowrunner-wasm-clippy' "${WAMN_FLOWRUNNER_WASM_CLIPPY[@]}"
}

wamn_require_cargo() {
  if [[ "$WAMN_CARGO" == */* ]]; then
    [[ -x "$WAMN_CARGO" ]] || {
      wamn_fail 127 "Cargo executable is not executable: $WAMN_CARGO"
    }
  else
    command -v "$WAMN_CARGO" >/dev/null 2>&1 || {
      wamn_fail 127 "Cargo executable was not found: $WAMN_CARGO"
    }
  fi
}

WAMN_ANY_LEG_FAILED=0

wamn_report_leg() {
  local -r label="$1"
  local -r exit_code="$2"
  if ((exit_code == 0)); then
    printf 'repo-lint: PASS: %s\n' "$label" >&2
  else
    printf 'repo-lint: FAIL: %s (exit %d)\n' "$label" "$exit_code" >&2
    WAMN_ANY_LEG_FAILED=1
  fi
}

wamn_run() {
  local -r label="$1"
  shift
  printf 'repo-lint: %s\n' "$label" >&2
  local exit_code=0
  "$WAMN_CARGO" "$@" || exit_code=$?
  wamn_report_leg "$label" "$exit_code"
}

wamn_run_connection_http_native_clippy() {
  local -r label='connection-http-standard native Clippy'
  printf 'repo-lint: %s\n' "$label" >&2
  local exit_code=0
  RUSTFLAGS="$WAMN_CONNECTION_HTTP_NATIVE_RUSTFLAGS" \
    "$WAMN_CARGO" "${WAMN_CONNECTION_HTTP_NATIVE_CLIPPY[@]}" || exit_code=$?
  wamn_report_leg "$label" "$exit_code"
}

# Pin the per-invocation client construction that keeps credentialed HTTP
# egress free of cross-generation connection reuse.
wamn_connection_http_construction() {
  local -r label='connection HTTP per-invocation client'
  printf 'repo-lint: %s\n' "$label" >&2
  if [[ ! -r "$WAMN_CONNECTION_HTTP_SOURCE" ]]; then
    printf 'repo-lint: connection HTTP source is unreadable: %s\n' \
      "$WAMN_CONNECTION_HTTP_SOURCE" >&2
    wamn_report_leg "$label" 65
    return
  fi

  local builders
  builders="$(
    { grep -o -F -e "$WAMN_CONNECTION_HTTP_BUILDER" -- "$WAMN_CONNECTION_HTTP_SOURCE" || true; } |
      wc -l
  )"
  if ((builders != 1)); then
    printf 'repo-lint: connection_http.rs must contain exactly one %s) construction; found %d\n' \
      "$WAMN_CONNECTION_HTTP_BUILDER" "$builders" >&2
    wamn_report_leg "$label" 65
    return
  fi

  local index found
  for index in "${!WAMN_CONNECTION_HTTP_REFUSED_PATTERN[@]}"; do
    found="$({
      grep -n -E -e "${WAMN_CONNECTION_HTTP_REFUSED_PATTERN[index]}" \
        -- "$WAMN_CONNECTION_HTTP_SOURCE" || true
    })"
    if [[ -n "$found" ]]; then
      printf 'repo-lint: connection_http.rs %s: %s\n' \
        "${WAMN_CONNECTION_HTTP_REFUSED_REASON[index]}" "$found" >&2
      wamn_report_leg "$label" 65
      return
    fi
  done
  wamn_report_leg "$label" 0
}

(($# <= 1)) || wamn_usage_error 'expected at most one command'
readonly WAMN_COMMAND="${1:-run}"

case "$WAMN_COMMAND" in
  dry-run)
    wamn_dry_run
    ;;
  run)
    wamn_require_cargo
    cd -- "$WAMN_REPOSITORY_ROOT"
    wamn_connection_http_construction
    wamn_run 'root rustfmt' "${WAMN_ROOT_FORMAT[@]}"
    wamn_run 'components rustfmt' "${WAMN_COMPONENT_FORMAT[@]}"
    wamn_run 'root Clippy' "${WAMN_ROOT_CLIPPY[@]}"
    wamn_run 'components native Clippy' "${WAMN_COMPONENT_NATIVE_CLIPPY[@]}"
    wamn_run_connection_http_native_clippy
    wamn_run 'flowrunner native Clippy' "${WAMN_FLOWRUNNER_NATIVE_CLIPPY[@]}"
    wamn_run 'components wasm Clippy' "${WAMN_COMPONENT_WASM_CLIPPY[@]}"
    wamn_run 'flowrunner wasm Clippy' "${WAMN_FLOWRUNNER_WASM_CLIPPY[@]}"
    ((WAMN_ANY_LEG_FAILED == 0))
    ;;
  *)
    wamn_usage_error "unknown command '$WAMN_COMMAND'"
    ;;
esac
