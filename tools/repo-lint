#!/usr/bin/env bash
set -euo pipefail

readonly WAMN_USAGE='usage: tools/repo-lint [run|dry-run]'

wamn_fail() {
  local -r exit_code="$1"
  shift
  printf 'repo-lint: %s\n' "$*" >&2
  exit "$exit_code"
}

wamn_usage_error() {
  printf '%s\n' "$WAMN_USAGE" >&2
  wamn_fail 64 "$*"
}

readonly WAMN_TOOL_DIRECTORY="$(
  CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_REPOSITORY_ROOT="$(
  CDPATH= cd -- "$WAMN_TOOL_DIRECTORY/.." >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_ROOT_MANIFEST="$WAMN_REPOSITORY_ROOT/Cargo.toml"
readonly WAMN_COMPONENT_MANIFEST="$WAMN_REPOSITORY_ROOT/apps/Cargo.toml"
readonly WAMN_NO_STD_MANIFEST="$WAMN_REPOSITORY_ROOT/apps/platform/no-std/Cargo.toml"
readonly WAMN_CARGO="${CARGO:-cargo}"
# A no_std guest supplies its own #[panic_handler], and the precompiled core
# library panics by unwinding, so a NATIVE check of one fails to link with
# "unwinding panics are not supported without std" unless panics abort. The
# wasm32-wasip2 checks need no such flag. Measured at 72107f35: without it,
# the apps/platform/no-std native leg exits 101 on both members.
readonly WAMN_CONNECTION_HTTP_NATIVE_RUSTFLAGS='-C panic=abort'
readonly WAMN_NO_STD_NATIVE_RUSTFLAGS='-C panic=abort'

# The retained client owner must keep the complete approved authority scope.
# Runtime isolation tests prove behavior; this leg guards its source structure.
readonly WAMN_CONNECTION_HTTP_SOURCE="$WAMN_REPOSITORY_ROOT/crates/platform/runtime/src/plugins/connection_http.rs"
readonly WAMN_CONNECTION_HTTP_TRANSPORT="$WAMN_REPOSITORY_ROOT/crates/platform/runtime/src/plugins/connection_http/transport.rs"

readonly -a WAMN_ROOT_FORMAT=(
  fmt --manifest-path "$WAMN_ROOT_MANIFEST" --all -- --check
)
readonly -a WAMN_COMPONENT_FORMAT=(
  fmt --manifest-path "$WAMN_COMPONENT_MANIFEST" --all -- --check
)
readonly -a WAMN_ROOT_CLIPPY=(
  clippy --manifest-path "$WAMN_ROOT_MANIFEST" --locked --workspace
  --all-targets -- -D warnings
)
readonly -a WAMN_COMPONENT_NATIVE_CLIPPY=(
  clippy --manifest-path "$WAMN_COMPONENT_MANIFEST" --locked --workspace
  --exclude connection-http-standard
  --all-targets -- -D warnings
)
readonly -a WAMN_CONNECTION_HTTP_NATIVE_CLIPPY=(
  clippy --manifest-path "$WAMN_COMPONENT_MANIFEST" --locked
  --package connection-http-standard -- -D warnings
)
readonly -a WAMN_COMPONENT_WASM_CLIPPY=(
  clippy --manifest-path "$WAMN_COMPONENT_MANIFEST" --locked --workspace
  --target wasm32-wasip2 -- -D warnings
)
# The second component workspace. It exists because Cargo feature unification is
# additive-only and per-invocation, so the no_std guests cannot share one with a
# std sibling (wamn-0h0g.11.56). Separate workspace, therefore separate legs.
# None of the three takes --all-targets: a no_std cdylib guest has no meaningful
# lib-test target, and --all-targets is the invocation that is not green-capable
# here rather than a stricter one that is.
readonly -a WAMN_NO_STD_FORMAT=(
  fmt --manifest-path "$WAMN_NO_STD_MANIFEST" --all -- --check
)
readonly -a WAMN_NO_STD_NATIVE_CLIPPY=(
  clippy --manifest-path "$WAMN_NO_STD_MANIFEST" --locked --workspace
  -- -D warnings
)
readonly -a WAMN_NO_STD_WASM_CLIPPY=(
  clippy --manifest-path "$WAMN_NO_STD_MANIFEST" --locked --workspace
  --target wasm32-wasip2 -- -D warnings
)

wamn_print_plan() {
  local -r label="$1"
  shift
  printf '%s:' "$label"
  printf ' %q' "$WAMN_CARGO" "$@"
  printf '\n'
}

wamn_dry_run() {
  printf 'working-directory: %q\n' "$WAMN_REPOSITORY_ROOT"
  printf 'connection-http-scope: %q %q\n' \
    "$WAMN_CONNECTION_HTTP_SOURCE" "$WAMN_CONNECTION_HTTP_TRANSPORT"
  wamn_print_plan 'root-rustfmt' "${WAMN_ROOT_FORMAT[@]}"
  wamn_print_plan 'components-rustfmt' "${WAMN_COMPONENT_FORMAT[@]}"
  wamn_print_plan 'no-std-rustfmt' "${WAMN_NO_STD_FORMAT[@]}"
  wamn_print_plan 'root-clippy' "${WAMN_ROOT_CLIPPY[@]}"
  wamn_print_plan 'components-native-clippy' "${WAMN_COMPONENT_NATIVE_CLIPPY[@]}"
  printf 'connection-http-native-clippy: RUSTFLAGS=%q' \
    "$WAMN_CONNECTION_HTTP_NATIVE_RUSTFLAGS"
  printf ' %q' "$WAMN_CARGO" "${WAMN_CONNECTION_HTTP_NATIVE_CLIPPY[@]}"
  printf '\n'
  wamn_print_plan 'components-wasm-clippy' "${WAMN_COMPONENT_WASM_CLIPPY[@]}"
  printf 'no-std-native-clippy: RUSTFLAGS=%q' "$WAMN_NO_STD_NATIVE_RUSTFLAGS"
  printf ' %q' "$WAMN_CARGO" "${WAMN_NO_STD_NATIVE_CLIPPY[@]}"
  printf '\n'
  wamn_print_plan 'no-std-wasm-clippy' "${WAMN_NO_STD_WASM_CLIPPY[@]}"
}

wamn_require_cargo() {
  if [[ "$WAMN_CARGO" == */* ]]; then
    [[ -x "$WAMN_CARGO" ]] || {
      wamn_fail 127 "Cargo executable is not executable: $WAMN_CARGO"
    }
  else
    command -v "$WAMN_CARGO" >/dev/null 2>&1 || {
      wamn_fail 127 "Cargo executable was not found: $WAMN_CARGO"
    }
  fi
}

WAMN_ANY_LEG_FAILED=0

wamn_report_leg() {
  local -r label="$1"
  local -r exit_code="$2"
  if ((exit_code == 0)); then
    printf 'repo-lint: PASS: %s\n' "$label" >&2
  else
    printf 'repo-lint: FAIL: %s (exit %d)\n' "$label" "$exit_code" >&2
    WAMN_ANY_LEG_FAILED=1
  fi
}

wamn_run() {
  local -r label="$1"
  shift
  printf 'repo-lint: %s\n' "$label" >&2
  local exit_code=0
  "$WAMN_CARGO" "$@" || exit_code=$?
  wamn_report_leg "$label" "$exit_code"
}

wamn_run_connection_http_native_clippy() {
  local -r label='connection-http-standard native Clippy'
  printf 'repo-lint: %s\n' "$label" >&2
  local exit_code=0
  RUSTFLAGS="$WAMN_CONNECTION_HTTP_NATIVE_RUSTFLAGS" \
    "$WAMN_CARGO" "${WAMN_CONNECTION_HTTP_NATIVE_CLIPPY[@]}" || exit_code=$?
  wamn_report_leg "$label" "$exit_code"
}

wamn_run_no_std_native_clippy() {
  local -r label='no-std native Clippy'
  printf 'repo-lint: %s\n' "$label" >&2
  local exit_code=0
  RUSTFLAGS="$WAMN_NO_STD_NATIVE_RUSTFLAGS" \
    "$WAMN_CARGO" "${WAMN_NO_STD_NATIVE_CLIPPY[@]}" || exit_code=$?
  wamn_report_leg "$label" "$exit_code"
}

# Deliberately recognizes these concrete declarations, not arbitrary Rust.
# A different representation requires an explicit guard update and runtime proof.
wamn_connection_http_scope() {
  local -r label='connection HTTP scoped retained clients'
  printf 'repo-lint: %s\n' "$label" >&2
  local exit_code=0
  python3 - "$WAMN_CONNECTION_HTTP_SOURCE" "$WAMN_CONNECTION_HTTP_TRANSPORT" <<'PY' || exit_code=$?
import pathlib
import re
import sys


def refuse(reason):
    print(f"repo-lint: connection HTTP scope: {reason}", file=sys.stderr)
    sys.exit(65)


def source(path):
    try:
        text = pathlib.Path(path).read_text()
    except (OSError, UnicodeError):
        refuse("source is unreadable")
    # Comments and string literals cannot stand in for required declarations.
    text = re.sub(r'/\*.*?\*/|//[^\n]*|r(#+)".*?"\1|"(?:\\.|[^"\\])*"',
                  " ", text, flags=re.S)
    return text.split("#[cfg(test)]", 1)[0]


def compact(text):
    return re.sub(r"\s+", "", re.sub(r"\bpub(?:\([^)]*\))?\s+", "", text))


parent, transport = map(source, sys.argv[1:])
declarations = list(re.finditer(
    r"((?:#\[[^\]]*\]\s*)*)(?:pub(?:\([^)]*\))?\s+)?struct\s+(\w+)\s*\{([^{}]*)\}",
    parent + "\n" + transport))
structs = {}
for declaration in declarations:
    attributes, name, body = declaration.groups()
    if name in structs:
        refuse(f"duplicate {name} declaration")
    structs[name] = (attributes, compact(body))

expected = {
    "ConnectionScope": "tenant:Box<str>,project:Box<str>,environment:Box<str>,instance:Box<str>,",
    "ClientScope": "connection:ConnectionScope,package:Box<str>,component_digest:Box<str>,"
                   "requirement:Box<str>,binding_hash:Box<str>,definition_hash:Box<str>,generation:i64,",
    "ClientKey": "scope:ClientScope,target:Target,",
    "Target": "authority:Box<str>,peer:SocketAddr,tls_name:Option<Box<str>>,",
    "State": "clients:HashMap<ClientKey,CachedClient>,scopes:HashMap<ConnectionScope,Weak<ScopeQuota>>,",
    "CachedClient": "http:HttpClient,life:Arc<ClientLife>,used:Instant,",
}
for name, fields in expected.items():
    if name not in structs:
        refuse(f"missing or unsupported {name} declaration")
    attributes, actual = structs[name]
    if "invocation" in actual.lower():
        refuse(f"{name} must not retain invocation identity")
    # Fields can have generic commas; only a following field name ends a type.
    wanted = dict(re.findall(r"(\w+):(.+?),(?=\w+:|$)", fields))
    found = dict(re.findall(r"(\w+):(.+?),(?=\w+:|$)", actual))
    for field, kind in wanted.items():
        if found.get(field) != kind:
            refuse(f"{name}.{field} must remain {kind}")
    if actual != fields:
        refuse(f"unsupported extra, reordered, or duplicate {name} fields")
    if name not in ("State", "CachedClient"):
        derives = re.findall(r"#\[derive\(([^)]*)\)\]", attributes)
        if not {"Eq", "Hash", "PartialEq"} <= set(",".join(derives).replace(" ", "").split(",")):
            refuse(f"{name} must derive Eq, Hash, and PartialEq over its complete scope")

client_type = re.compile(r"\b(?:HttpClient|CachedClient|Client)\b")
for name, (_, fields) in structs.items():
    if client_type.search(fields) and name not in ("State", "CachedClient"):
        refuse(f"unscoped retained HTTP client in {name}")
# Tuple/enum/alias retention and static cells are unsupported, not silently skipped.
without_structs = re.sub(
    r"(?:pub(?:\([^)]*\))?\s+)?struct\s+\w+\s*\{[^{}]*\}", "", parent + "\n" + transport)
without_structs = without_structs.replace("type HttpClient = Client<PinnedConnector, Full<Bytes>>;", "")
if re.search(r"\b(?:struct|enum|type|static|const)\s+\w+[^;{}]*\b(?:HttpClient|CachedClient|Client)\b",
             without_structs):
    refuse("unsupported HTTP client retention declaration")
for declaration in re.findall(r"\b(?:struct|enum)\s+\w+[^;{]*\{[^}]*\}", without_structs):
    if client_type.search(declaration):
        refuse("unsupported HTTP client retention declaration")
acquisitions = re.findall(r"let scope = ClientScope \{(.*?)\n        \};", parent, re.S)
expected_acquisition = """
connection:ConnectionScope{tenant:self.tenant.clone(),project:self.project.clone(),
environment:environment.into(),instance:snapshot.instance_id.as_deref().ok_or(ConnectionError::Unbound)?.into(),},
package:invocation.package_id.clone().into(),component_digest:invocation.component_digest.clone().into(),
requirement:request.requirement.clone().into(),
binding_hash:snapshot.validation_hash.as_deref().ok_or(ConnectionError::Unbound)?.into(),
definition_hash:snapshot.definition_hash.as_deref().ok_or(ConnectionError::CredentialUnavailable)?.into(),
generation:snapshot.generation.ok_or(ConnectionError::CredentialUnavailable)?,
"""
if len(acquisitions) != 1 or compact(acquisitions[0]) != compact(expected_acquisition):
    refuse("ClientScope acquisition must use the attested tenant/project/environment/binding/generation values")
if compact(transport).count("letkey=ClientKey{scope,target};") != 1:
    refuse("ClientKey acquisition must retain both supplied scope and approved target")
PY
  wamn_report_leg "$label" "$exit_code"
}

(($# <= 1)) || wamn_usage_error 'expected at most one command'
readonly WAMN_COMMAND="${1:-run}"

case "$WAMN_COMMAND" in
  dry-run)
    wamn_dry_run
    ;;
  run)
    wamn_require_cargo
    cd -- "$WAMN_REPOSITORY_ROOT"
    wamn_connection_http_scope
    wamn_run 'root rustfmt' "${WAMN_ROOT_FORMAT[@]}"
    wamn_run 'components rustfmt' "${WAMN_COMPONENT_FORMAT[@]}"
    wamn_run 'no-std rustfmt' "${WAMN_NO_STD_FORMAT[@]}"
    wamn_run 'root Clippy' "${WAMN_ROOT_CLIPPY[@]}"
    wamn_run 'components native Clippy' "${WAMN_COMPONENT_NATIVE_CLIPPY[@]}"
    wamn_run_connection_http_native_clippy
    wamn_run 'components wasm Clippy' "${WAMN_COMPONENT_WASM_CLIPPY[@]}"
    wamn_run_no_std_native_clippy
    wamn_run 'no-std wasm Clippy' "${WAMN_NO_STD_WASM_CLIPPY[@]}"
    ((WAMN_ANY_LEG_FAILED == 0))
    ;;
  *)
    wamn_usage_error "unknown command '$WAMN_COMMAND'"
    ;;
esac
