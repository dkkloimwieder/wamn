#!/usr/bin/env bash
set -euo pipefail

readonly WAMN_USAGE='usage: tools/repo-lint [run|dry-run]'

wamn_fail() {
  local -r exit_code="$1"
  shift
  printf 'repo-lint: %s\n' "$*" >&2
  exit "$exit_code"
}

wamn_usage_error() {
  printf '%s\n' "$WAMN_USAGE" >&2
  wamn_fail 64 "$*"
}

readonly WAMN_TOOL_DIRECTORY="$(
  CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_REPOSITORY_ROOT="$(
  CDPATH= cd -- "$WAMN_TOOL_DIRECTORY/.." >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_ROOT_MANIFEST="$WAMN_REPOSITORY_ROOT/Cargo.toml"
readonly WAMN_COMPONENT_MANIFEST="$WAMN_REPOSITORY_ROOT/apps/Cargo.toml"
readonly WAMN_NO_STD_MANIFEST="$WAMN_REPOSITORY_ROOT/apps/platform/no-std/Cargo.toml"
readonly WAMN_CARGO="${CARGO:-cargo}"
# A no_std guest supplies its own #[panic_handler], and the precompiled core
# library panics by unwinding, so a NATIVE test of one fails to link with
# "unwinding panics are not supported without std" unless panics abort. The
# wasm32-wasip2 tests need no such flag. Measured at 72107f35: without it,
# the apps/platform/no-std native leg exits 101 on both members.
readonly WAMN_CONNECTION_HTTP_NATIVE_RUSTFLAGS='-C panic=abort'
readonly WAMN_NO_STD_NATIVE_RUSTFLAGS='-C panic=abort'

readonly -a WAMN_ROOT_FORMAT=(
  fmt --manifest-path "$WAMN_ROOT_MANIFEST" --all -- --check
)
readonly -a WAMN_COMPONENT_FORMAT=(
  fmt --manifest-path "$WAMN_COMPONENT_MANIFEST" --all -- --check
)
readonly -a WAMN_ROOT_CLIPPY=(
  clippy --manifest-path "$WAMN_ROOT_MANIFEST" --locked --workspace
  --all-targets -- -D warnings
)
readonly -a WAMN_COMPONENT_NATIVE_CLIPPY=(
  clippy --manifest-path "$WAMN_COMPONENT_MANIFEST" --locked --workspace
  --exclude connection-http-standard
  --all-targets -- -D warnings
)
readonly -a WAMN_CONNECTION_HTTP_NATIVE_CLIPPY=(
  clippy --manifest-path "$WAMN_COMPONENT_MANIFEST" --locked
  --package connection-http-standard -- -D warnings
)
readonly -a WAMN_CONNECTION_HTTP_WASM_CLIPPY=(
  clippy --manifest-path "$WAMN_COMPONENT_MANIFEST" --locked
  --package connection-http-standard --target wasm32-wasip2 -- -D warnings
)
# connection-http-standard is excluded for the same reason the native leg
# excludes it: the fixture is no_std with its own #[panic_handler], and a
# --workspace build unifies features so that std links in and duplicates the
# panic_impl lang item (E0152). It keeps its own leg above and below instead.
readonly -a WAMN_COMPONENT_WASM_CLIPPY=(
  clippy --manifest-path "$WAMN_COMPONENT_MANIFEST" --locked --workspace
  --exclude connection-http-standard
  --target wasm32-wasip2 -- -D warnings
)
# The second component workspace. It exists because Cargo feature unification is
# additive-only and per-invocation, so the no_std guests cannot share one with a
# std sibling (wamn-0h0g.11.56). Separate workspace, therefore separate legs.
# None of the three takes --all-targets: a no_std cdylib guest has no meaningful
# lib-test target, and --all-targets is the invocation that is not green-capable
# here rather than a stricter one that is.
readonly -a WAMN_NO_STD_FORMAT=(
  fmt --manifest-path "$WAMN_NO_STD_MANIFEST" --all -- --check
)
readonly -a WAMN_NO_STD_NATIVE_CLIPPY=(
  clippy --manifest-path "$WAMN_NO_STD_MANIFEST" --locked --workspace
  -- -D warnings
)
readonly -a WAMN_NO_STD_WASM_CLIPPY=(
  clippy --manifest-path "$WAMN_NO_STD_MANIFEST" --locked --workspace
  --target wasm32-wasip2 -- -D warnings
)

# The repository policy lints: tests of source and repository files, which
# are lints rather than tests (docs/operations/running-tests.md).
readonly -a WAMN_REPOSITORY_POLICY=(
  run --manifest-path "$WAMN_ROOT_MANIFEST" --locked --quiet
  --package wamn-conformance-tests --bin repo-policy -- "$WAMN_REPOSITORY_ROOT"
)

wamn_print_plan() {
  local -r label="$1"
  shift
  printf '%s:' "$label"
  printf ' %q' "$WAMN_CARGO" "$@"
  printf '\n'
}

wamn_dry_run() {
  printf 'working-directory: %q\n' "$WAMN_REPOSITORY_ROOT"
  wamn_print_plan 'root-rustfmt' "${WAMN_ROOT_FORMAT[@]}"
  wamn_print_plan 'components-rustfmt' "${WAMN_COMPONENT_FORMAT[@]}"
  wamn_print_plan 'no-std-rustfmt' "${WAMN_NO_STD_FORMAT[@]}"
  wamn_print_plan 'root-clippy' "${WAMN_ROOT_CLIPPY[@]}"
  wamn_print_plan 'components-native-clippy' "${WAMN_COMPONENT_NATIVE_CLIPPY[@]}"
  printf 'connection-http-native-clippy: RUSTFLAGS=%q' \
    "$WAMN_CONNECTION_HTTP_NATIVE_RUSTFLAGS"
  printf ' %q' "$WAMN_CARGO" "${WAMN_CONNECTION_HTTP_NATIVE_CLIPPY[@]}"
  printf '\n'
  wamn_print_plan 'connection-http-wasm-clippy' "${WAMN_CONNECTION_HTTP_WASM_CLIPPY[@]}"
  wamn_print_plan 'components-wasm-clippy' "${WAMN_COMPONENT_WASM_CLIPPY[@]}"
  printf 'no-std-native-clippy: RUSTFLAGS=%q' "$WAMN_NO_STD_NATIVE_RUSTFLAGS"
  printf ' %q' "$WAMN_CARGO" "${WAMN_NO_STD_NATIVE_CLIPPY[@]}"
  printf '\n'
  wamn_print_plan 'no-std-wasm-clippy' "${WAMN_NO_STD_WASM_CLIPPY[@]}"
  printf 'dependency-boundaries: python3 %q %q\n' "$WAMN_TOOL_DIRECTORY/repo-lint-dependencies" "$WAMN_CARGO"
  wamn_print_plan 'repository-policy' "${WAMN_REPOSITORY_POLICY[@]}"
}

wamn_require_cargo() {
  if [[ "$WAMN_CARGO" == */* ]]; then
    [[ -x "$WAMN_CARGO" ]] || {
      wamn_fail 127 "Cargo executable is not executable: $WAMN_CARGO"
    }
  else
    command -v "$WAMN_CARGO" >/dev/null 2>&1 || {
      wamn_fail 127 "Cargo executable was not found: $WAMN_CARGO"
    }
  fi
}

WAMN_ANY_LEG_FAILED=0

wamn_report_leg() {
  local -r label="$1"
  local -r exit_code="$2"
  if ((exit_code == 0)); then
    printf 'repo-lint: PASS: %s\n' "$label" >&2
  else
    printf 'repo-lint: FAIL: %s (exit %d)\n' "$label" "$exit_code" >&2
    WAMN_ANY_LEG_FAILED=1
  fi
}

wamn_run() {
  local -r label="$1"
  shift
  printf 'repo-lint: %s\n' "$label" >&2
  local exit_code=0
  "$WAMN_CARGO" "$@" || exit_code=$?
  wamn_report_leg "$label" "$exit_code"
}

wamn_run_connection_http_native_clippy() {
  local -r label='connection-http-standard native Clippy'
  printf 'repo-lint: %s\n' "$label" >&2
  local exit_code=0
  RUSTFLAGS="$WAMN_CONNECTION_HTTP_NATIVE_RUSTFLAGS" \
    "$WAMN_CARGO" "${WAMN_CONNECTION_HTTP_NATIVE_CLIPPY[@]}" || exit_code=$?
  wamn_report_leg "$label" "$exit_code"
}

wamn_run_no_std_native_clippy() {
  local -r label='no-std native Clippy'
  printf 'repo-lint: %s\n' "$label" >&2
  local exit_code=0
  RUSTFLAGS="$WAMN_NO_STD_NATIVE_RUSTFLAGS" \
    "$WAMN_CARGO" "${WAMN_NO_STD_NATIVE_CLIPPY[@]}" || exit_code=$?
  wamn_report_leg "$label" "$exit_code"
}

wamn_dependency_boundaries() {
  local -r label='dependency boundaries'
  printf 'repo-lint: %s\n' "$label" >&2
  local exit_code=0
  python3 "$WAMN_TOOL_DIRECTORY/repo-lint-dependencies" "$WAMN_CARGO" || exit_code=$?
  wamn_report_leg "$label" "$exit_code"
}

(($# <= 1)) || wamn_usage_error 'expected at most one command'
readonly WAMN_COMMAND="${1:-run}"

case "$WAMN_COMMAND" in
  dry-run)
    wamn_dry_run
    ;;
  run)
    wamn_require_cargo
    cd -- "$WAMN_REPOSITORY_ROOT"
    wamn_run 'root rustfmt' "${WAMN_ROOT_FORMAT[@]}"
    wamn_run 'components rustfmt' "${WAMN_COMPONENT_FORMAT[@]}"
    wamn_run 'no-std rustfmt' "${WAMN_NO_STD_FORMAT[@]}"
    wamn_run 'root Clippy' "${WAMN_ROOT_CLIPPY[@]}"
    wamn_run 'components native Clippy' "${WAMN_COMPONENT_NATIVE_CLIPPY[@]}"
    wamn_run_connection_http_native_clippy
    wamn_run 'connection-http-standard wasm Clippy' \
      "${WAMN_CONNECTION_HTTP_WASM_CLIPPY[@]}"
    wamn_run 'components wasm Clippy' "${WAMN_COMPONENT_WASM_CLIPPY[@]}"
    wamn_run_no_std_native_clippy
    wamn_run 'no-std wasm Clippy' "${WAMN_NO_STD_WASM_CLIPPY[@]}"
    wamn_dependency_boundaries
    wamn_run 'repository policy' "${WAMN_REPOSITORY_POLICY[@]}"
    ((WAMN_ANY_LEG_FAILED == 0))
    ;;
  *)
    wamn_usage_error "unknown command '$WAMN_COMMAND'"
    ;;
esac
