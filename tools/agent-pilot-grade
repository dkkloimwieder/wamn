#!/usr/bin/env bash
# Agent-authoring pilot grader. Spec item A7.
#
# The grader is generic: it knows the manifest interface and nothing about any
# application. It is also NOT A SECOND POLICY. Where the loop already fences a
# rule, the grader reports the loop's verdict and runs nothing of its own. It
# runs only the checks the loop has no fence for.
#
#   agent-pilot-grade --run <nnn>
#   agent-pilot-grade --replay <dir>
#   agent-pilot-grade --placement <dir>
#   agent-pilot-grade --contract <dir>
#
# --replay grades a recorded run directory and needs no environment. It scores
# every step from the requests and responses the run wrote into
# grade/http.jsonl, under the same predicates, so a rubric change re-scores
# every recorded run for free. wamn-nvbd.10.
#
# A REPLAY NEVER WRITES OVER THE RECORD IT GRADES. It writes
# checklist-replay.json beside the original checklist.json and leaves
# grade/http.jsonl and grade/results.json exactly as the run left them.
#
# --placement prints the request body the grader builds for each route step and
# stops. It sends nothing and needs no environment, so the placement rule can be
# proven against a package tree alone. wamn-nvbd.11.
#
# --contract asserts the brief's data contract against the contracts the package
# publishes, one line per statement. It reads two documents and nothing else, so
# a brief that disagrees with the reference is caught before an agent reads it
# and refuses half the fixture. wamn-nvbd.13.
#
# Exit codes: 0 ok · 2 usage · 10 environment · 30 a grading failure.
set -euo pipefail
umask 077

readonly EX_USAGE=2 EX_ENV=10 EX_GRADE=30
readonly PILOT_HOME="${XDG_CACHE_HOME:-$HOME/.cache}/wamn-pilot"

die() { printf 'agent-pilot-grade: %s\n' "$1" >&2; exit "${2:-$EX_USAGE}"; }
note() { printf '[grade] %s\n' "$*" >&2; }

RUN=""; REPLAY=""; PLACEMENT=""; CONTRACT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --run) RUN="${2:-}"; shift 2 ;;
    --replay) REPLAY="${2:-}"; shift 2 ;;
    --placement) PLACEMENT="${2:-}"; shift 2 ;;
    --contract) CONTRACT="${2:-}"; shift 2 ;;
    *) die "unknown flag $1" ;;
  esac
done

TREE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

if [[ -n "$CONTRACT" ]]; then
  DIR="$(cd "$CONTRACT" && pwd -P)" || die "--contract $CONTRACT is not a directory"
elif [[ -n "$PLACEMENT" ]]; then
  DIR="$(cd "$PLACEMENT" && pwd -P)" || die "--placement $PLACEMENT is not a directory"
elif [[ -n "$REPLAY" ]]; then
  DIR="$(cd "$REPLAY" && pwd -P)" || die "--replay $REPLAY is not a directory"
else
  [[ -n "$RUN" ]] || die "--run, --replay, --placement or --contract is required"
  matches=()
  for candidate in "$PILOT_HOME"/runs/"$RUN"-*; do
    [[ -d "$candidate" ]] && matches+=("$candidate")
  done
  [[ ${#matches[@]} -eq 1 ]] || die "expected exactly one run directory for $RUN" "$EX_ENV"
  DIR="${matches[0]}"
fi

MANIFEST="$DIR/task.json"
[[ -s "$MANIFEST" ]] || die "no task manifest at $MANIFEST" "$EX_ENV"
mkdir -p "$DIR/grade"

# Where this grade writes. A replay gets its own checklist and its own reuse
# ledger, so grading a recorded run cannot destroy the recording.
if [[ -n "$PLACEMENT" || -n "$CONTRACT" ]]; then
  # Placement writes no checklist. It answers one question and prints it.
  CHECKLIST=""
  RESULTS="$DIR/grade/placement-results.json"
elif [[ -n "$REPLAY" ]]; then
  CHECKLIST="$DIR/checklist-replay.json"
  RESULTS="$DIR/grade/replay-results.json"
else
  CHECKLIST="$DIR/checklist.json"
  RESULTS="$DIR/grade/results.json"
fi

ROUTE_HOST="$(jq -r '.identity.route_host' "$MANIFEST")"
OVERLAY_ROOT="$(jq -r '.overlay_root' "$MANIFEST")"

# wamn-nvbd.12: the grading fixture and the grade block live OUTSIDE the run
# directory, because the run directory is handed to the agent. Older runs kept
# them inside it, so resolution falls back through the two places they used.
#
#   1. the harness grading directory, which nothing exports  (022 onward)
#   2. the run directory root                                (013 to 021)
#   3. the agent's own fixture directory                     (001 to 012)
RUN_KEY="$(basename "$DIR")"
GRADING="$PILOT_HOME/grading/${RUN_KEY%%-*}"
GRADE_MANIFEST="$GRADING/task.json"
jq -e 'has("grade")' "$GRADE_MANIFEST" >/dev/null 2>&1 || GRADE_MANIFEST="$MANIFEST"
jq -e 'has("grade")' "$GRADE_MANIFEST" >/dev/null 2>&1 \
  || die "no grade block for $RUN_KEY in $GRADING or $MANIFEST" "$EX_ENV"

STEPS_NAME="$(jq -r '.grade.steps // "steps.json"' "$GRADE_MANIFEST")"
STEPS="$GRADING/$STEPS_NAME"
[[ -s "$STEPS" ]] || STEPS="$DIR/$STEPS_NAME"
[[ -s "$STEPS" ]] || STEPS="$DIR/fixture/$STEPS_NAME"

# The brief the task hands the author, resolved through the same three places.
# The agent reads it, so it stays in the fixture directory the agent is handed.
BRIEF_NAME="$(jq -r '.grade.brief // "SCENARIO.md"' "$GRADE_MANIFEST")"
BRIEF="$GRADING/$BRIEF_NAME"
[[ -s "$BRIEF" ]] || BRIEF="$DIR/$BRIEF_NAME"
[[ -s "$BRIEF" ]] || BRIEF="$DIR/fixture/$BRIEF_NAME"

COMMIT="$(jq -r '.commit // ""' "$DIR/run.json" 2>/dev/null || true)"

# FIXTURE NAMES ARE UNIQUE PER RUN. A fixture value marked {{run}} is expanded
# to the run key. Arm 032 lost every step after create-dock: the agent had
# already created a dock named Door 7 while testing its own package, so the
# package refused the duplicate with the typed error it had declared, and the
# reuse chain below it had no id to pass.
#
# THE MARK IS EXPLICIT AND PER VALUE. A silent suffix on every string would
# corrupt a timestamp, a status and the idempotency key a replay case reuses on
# purpose, so a value the fixture does not mark is sent byte for byte. The
# expansion is the run key, which is fixed for the life of a run, so a replay
# scores the bytes the run sent.
if [[ -s "$STEPS" ]]; then
  EXPANDED="$(mktemp)"
  jq -c --arg run "$RUN_KEY" \
    'walk(if type == "string" then gsub("\\{\\{run\\}\\}"; $run) else . end)' \
    "$STEPS" > "$EXPANDED" 2>/dev/null || die "steps at $STEPS are not readable json" "$EX_ENV"
  STEPS="$EXPANDED"
fi

HELD_PID=""
cleanup() {
  rm -f "${EXPANDED:-}"
  if [[ -n "$HELD_PID" ]] && kill -0 "$HELD_PID" 2>/dev/null; then
    kill -INT "$HELD_PID" 2>/dev/null || true
    local waited=0
    while kill -0 "$HELD_PID" 2>/dev/null && (( waited < 30 )); do sleep 1; waited=$((waited + 1)); done
    kill -KILL "$HELD_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

# ---- 1. the loop -----------------------------------------------------------
# Twelve stages and a served endpoint, from the agent's own committed worktree.
# The grader runs the loop itself rather than trusting the agent's last run,
# because a report that reproduces is the whole point of H-5.
grade_loop() {
  # A replay reads the verdict out of the log the loop itself wrote. The
  # earlier version read grade/checklist-input.json, which no run writes, so
  # every replay failed the loop and skipped every step.
  if [[ -n "$REPLAY" ]]; then
    [[ -s "$DIR/grade/dev.out" ]] || die "no recorded loop log at $DIR/grade/dev.out" "$EX_ENV"
    LOOP_STAGES="$(sed -n 's/^run completed: //p' "$DIR/grade/dev.out" | tr ',' '\n' | grep -c . || true)"
    BASE_URL="$(sed -n 's/^run served: \([^ ]*\) host=.*/\1/p' "$DIR/grade/dev.out" | head -1)"
    if [[ "${LOOP_STAGES:-0}" -eq 12 && -n "$BASE_URL" ]]; then LOOP_PASS=true; else LOOP_PASS=false; fi
    return 0
  fi
  # THE RUN'S OWN TARGET, NAMED BY THE RUN. This picked the first target
  # directory alphabetically, which was right while only one existed. With
  # several, run 031 was graded by run 020's binary: the agent declared
  # idempotent_by correctly and a binary from two platform changes earlier
  # refused the field as unknown. A grade is worthless if it is not the run's
  # own binary, so a run that does not name one refuses rather than guesses.
  local target; target="$(jq -r '.build.target // ""' "$DIR/run.json")"
  [[ -n "$target" ]] \
    || die "run.json names no build target; this run predates the fix and cannot be graded live" "$EX_ENV"
  [[ -x "$target/debug/wamn" ]] || die "the run's own wamn is missing at $target/debug/wamn" "$EX_ENV"

  ( cd "$DIR/worktree" && "$target/debug/wamn" dev \
      --config "$DIR/env/dev.json" --overlay-root "$DIR/worktree/$OVERLAY_ROOT" --hold ) \
    > "$DIR/grade/dev.out" 2>&1 &
  HELD_PID=$!

  local waited=0
  until grep -q '^run holding$' "$DIR/grade/dev.out" 2>/dev/null; do
    kill -0 "$HELD_PID" 2>/dev/null || break
    waited=$((waited + 1)); (( waited < 900 )) || break
    sleep 1
  done

  local stages
  stages="$(sed -n 's/^run completed: //p' "$DIR/grade/dev.out" | tr ',' '\n' | grep -c . || true)"
  BASE_URL="$(sed -n 's/^run served: \([^ ]*\) host=.*/\1/p' "$DIR/grade/dev.out" | head -1)"
  if [[ "${stages:-0}" -eq 12 && -n "$BASE_URL" ]]; then LOOP_PASS=true; else LOOP_PASS=false; fi
  LOOP_STAGES="${stages:-0}"
}

# ---- 2. paths --------------------------------------------------------------
grade_paths() {
  OUTSIDE="$(jq -c '.git.outside_allowed_paths // []' "$DIR/run.json")"
  # The tracker check reads the recorded worktree and needs no environment, so
  # a replay runs it too and reaches the same verdict as the live grade.
  local tracker_touched=""
  if [[ -d "$DIR/worktree" ]]; then
    tracker_touched="$(git -C "$DIR/worktree" diff --name-only "$COMMIT"..HEAD -- .beads .claude .codex 2>/dev/null || true)"
  fi
  if [[ "$OUTSIDE" == "[]" && -z "$tracker_touched" ]]; then PATHS_PASS=true; else PATHS_PASS=false; fi
  TRACKER_TOUCHED="$tracker_touched"
}

# ---- 3. steps --------------------------------------------------------------
# Steps only drive routes. The agent's own naming choice is RECORDED, not
# failed: a step names an operation and the grader resolves the path from the
# package's published attachments.
resolve_attachments() {
  ATTACHMENTS="$(find "$DIR/worktree/$OVERLAY_ROOT" -path '*publication/attachments.json' -type f 2>/dev/null | head -1)"
  [[ -n "$ATTACHMENTS" ]] || note "no attachments.json under $OVERLAY_ROOT; route steps will refuse"
}

# attachments.json is an OBJECT keyed by attachment id. An entry carries a
# wiring-id and a definition; it does NOT carry an operation field. So the
# operation a step names is matched against the wiring id, which is the
# operation with its dot replaced by an underscore, and failing that against a
# route path whose last two segments are the domain and the action. Both are
# conventions the agent follows or does not, and either way the answer is
# recorded rather than the step failed for a naming choice.
route_path_for() {
  local operation="$1"
  [[ -n "$ATTACHMENTS" ]] || { echo ""; return; }
  local wiring="${operation//./_}" domain="${operation%%.*}" action="${operation#*.}"
  jq -r --arg w "$wiring" --arg op "$operation" --arg tail "/$domain/$action" '
    [ .. | objects
      | select(((.["wiring-id"] // "") == $w) or ((.operation // "") == $op))
      | (.definition.route.path // .route.path // .path // empty) ] as $byname
    | if ($byname | length) > 0 then $byname[0]
      else
        [ .. | objects | (.route.path // empty) | select(endswith($tail)) ][0] // ""
      end
  ' "$ATTACHMENTS"
}

bearer_token() {
  jq -r '.stringData.token' "$DIR/env/route-caller-pat.json"
}

# ---- the shape the agent published -----------------------------------------
# THE GRADER ADAPTS. It already resolves a route path from the agent's own
# attachments rather than pinning one. The wire SHAPE is the same kind of fact.
#
# Two legal authoring choices publish two different shapes for one operation.
# A custom operation lists dotted field paths, flat or nested under a value
# object. A model CRUD operation names its envelope keys at the top level and
# lists the domain fields it accepts under writable_fields. The fixture names
# DOMAIN fields only, so the grader reads the published input contract and
# places each value at the path that contract declares for that name.
#
# The envelope is platform law, and the grader supplies it. request_id and
# idempotency_key go at the paths the contract declares for them, exactly like
# a domain field.
contract_file() {
  local operation="$1" kind="$2"
  [[ -n "$operation" ]] || { echo ""; return; }
  find "$DIR/worktree/$OVERLAY_ROOT" -type f \
    -path "*/contracts/${operation%%.*}/${operation#*.}.$kind.json" 2>/dev/null | head -1
}

# Every path an input contract declares, one per line.
#
#   fields          a custom operation, whose paths are dotted and may nest
#   writable_fields a model CRUD operation, whose paths are all top level. Its
#                   envelope keys are the top-level members that carry both a
#                   type and a required flag, which is what separates
#                   request_id, id and idempotency_key from server_owned_fields
#                   and the pagination block.
declared_input_paths() {
  jq -r '
    if (.fields | type) == "array" then .fields[] | .path
    else
      ( to_entries[]
        | select((.value | type) == "object")
        | select((.value | has("type")) and (.value | has("required")))
        | .key ),
      ( .writable_fields // [] | .[] | .field )
    end' "$1" 2>/dev/null
}

declared_result_paths() { jq -r '.fields[]? | .path' "$1" 2>/dev/null; }

# A field NAME is the last dotted segment of a declared path, with the list
# marker removed. The map answers name to path. Where two paths carry one name
# the shorter wins, so a top-level dock_id beats appointments[].dock_id.
name_path_map() {
  jq -Rn '
    reduce inputs as $path ({};
      ($path | gsub("\\[\\]"; "") | split(".")) as $parts
      | ($parts | last) as $name
      | if (has($name) | not)
           or (($parts | length) < (.[$name] | gsub("\\[\\]"; "") | split(".") | length))
        then .[$name] = $path else . end)'
}

input_map_for() {
  local contract; contract="$(contract_file "$1" input)"
  [[ -n "$contract" ]] || { echo ""; return; }
  declared_input_paths "$contract" | name_path_map
}

result_map_for() {
  local contract; contract="$(contract_file "$1" result)"
  [[ -n "$contract" ]] || { echo '{}'; return; }
  declared_result_paths "$contract" | name_path_map
}

# A reuse clause names a step and a field, like create-dock.value.dock_id. The
# last segment is a NAME, so it is resolved against that step's published
# result contract exactly as a body field is resolved against an input one.
read_result() {
  local from_step="$1" path="$2" operation declared resolved="$2"
  operation="$(jq -r --arg id "$from_step" \
    '[.[] | select(.id == $id)] | first | .route.operation // ""' "$STEPS")"
  declared="$(jq -rn --argjson m "$(result_map_for "$operation")" --arg n "${path##*.}" \
    '$m[$n] // ""')"
  [[ -z "$declared" ]] || resolved="${path%.*}.$declared"
  jq -r --arg id "$from_step" --arg p "$resolved" \
    '[.[] | select(.id == $id)] | first | getpath($p | split(".")) // ""' "$RESULTS"
}

# A reuse clause pulls a value a previous step returned, so a create can feed
# the check-in that follows it without the fixture knowing any id in advance.
#
# On success the shaped body is printed and the status is zero. On failure the
# reason is printed instead and the status is one, so the caller records the
# reason as the step's evidence. Both travel on stdout because the caller reads
# this through a command substitution, which no variable escapes.
resolve_body() {
  local step="$1" operation="$2" request_id="$3"
  local map; map="$(input_map_for "$operation")"
  if [[ -z "$map" ]]; then
    printf 'no published input contract for %s under %s' "$operation" "$OVERLAY_ROOT"
    return 1
  fi

  # Every value this step sends, by field NAME. The fixture body first, then
  # each reuse clause, then the two fields the platform owns.
  local values; values="$(jq -c '.body // {}' <<< "$step")"
  local field source value
  while read -r field; do
    [[ -n "$field" ]] || continue
    source="$(jq -r --arg f "$field" '.reuse[$f]' <<< "$step")"
    value="$(read_result "${source%%.*}" "${source#*.}")"
    values="$(jq -c --arg f "$field" --arg v "$value" '.[$f] = $v' <<< "$values")"
  done < <(jq -r '.reuse // {} | keys[]' <<< "$step")

  values="$(jq -c --arg rid "$request_id" '.request_id = $rid' <<< "$values")"
  # A command declares an idempotency key and a projection does not. A fixture
  # that names its own key KEEPS it, because a replay case and a changed-body
  # case reuse the first call's key on purpose.
  if [[ "$(jq -rn --argjson m "$map" '$m | has("idempotency_key")')" == true \
        && "$(jq -r 'has("idempotency_key")' <<< "$values")" == false ]]; then
    values="$(jq -c --arg k "$(jq -r .id <<< "$step")" '.idempotency_key = $k' <<< "$values")"
  fi

  # A name the contract does not declare is a fixture defect, and the line says
  # so in full: the name looked for, the operation looked in, and every path
  # that operation does declare. A reader of the checklist alone can fix the
  # fixture from it without opening either document.
  local missing
  missing="$(jq -r --argjson m "$map" \
    '[keys[] | . as $name | select($m | has($name) | not)] | join(", ")' <<< "$values")"
  if [[ -n "$missing" ]]; then
    local declared
    declared="$(jq -rn --argjson m "$map" '[$m[]] | sort | join(", ")')"
    printf 'fixture field %s matches no declared path for %s. the contract declares %s' \
      "$missing" "$operation" "$declared"
    return 1
  fi

  jq -c --argjson m "$map" '
    to_entries | reduce .[] as $entry ({}; setpath($m[$entry.key] | split("."); $entry.value))' \
    <<< "$values"
}

fire_step() {
  local step="$1" path="$2" body="$3"
  local envelope; envelope="$(jq -cn --argjson body "$body" '[$body]')"
  # A transport failure is a step result, not a grader crash. Without this the
  # first unreachable route takes the whole run down under set -e.
  curl --silent --show-error --max-time 60 \
    --header "Host: $ROUTE_HOST" \
    --header "Authorization: Bearer $(bearer_token)" \
    --header 'content-type: application/json' \
    --data "$envelope" \
    --write-out '\n%{http_code}' \
    "$BASE_URL$path" 2>>"$DIR/grade/http.err" || true
}

grade_steps() {
  # Only a live grade writes the request log. Truncating it under --replay
  # destroyed the recorded responses of three runs, which is the one thing a
  # replay exists to read.
  if [[ -z "$REPLAY" ]]; then
    : > "$DIR/grade/http.jsonl"
    : > "$DIR/grade/http.err"
  fi
  echo '[]' > "$RESULTS"
  STEP_RESULTS='[]'

  # No release, no steps. Driving routes against nothing would record a page of
  # transport failures that all say the same thing the loop already said, and
  # the run has already failed on the loop.
  if [[ "$LOOP_PASS" != true || -z "${BASE_URL:-}" ]]; then
    STEP_RESULTS="$(jq -c '[.[] | {id, must: (.must // false), invariant: (.invariant // ""),
                                   proves: (.proves // ""),
                                   pass: false, evidence: "not run: the loop served no release"}]' "$STEPS")"
    note "steps skipped: the loop served no release"
    return 0
  fi

  [[ -n "$REPLAY" ]] || resolve_attachments

  local step id must invariant proves operation path body response status payload verdict evidence
  while read -r step; do
    id="$(jq -r .id <<< "$step")"
    must="$(jq -r '.must // false' <<< "$step")"
    invariant="$(jq -r '.invariant // ""' <<< "$step")"
    proves="$(jq -r '.proves // ""' <<< "$step")"
    verdict=false; evidence=""
    # Reset per step. A loop variable that survives the iteration would record
    # the previous step's answer against a sql or concurrent step, which sends
    # no request of its own.
    payload=""; status=""; response=""

    if jq -e 'has("sql")' <<< "$step" >/dev/null; then
      # A read-only assertion against the durable database. Nothing seeds it;
      # the rows under test were written by the steps above through routes.
      local sql expect_rows rows
      sql="$(jq -r .sql <<< "$step")"
      expect_rows="$(jq -r '.expect.rows // empty' <<< "$step")"
      if [[ -n "$REPLAY" ]]; then
        rows="$(jq -r --arg id "$id" 'select(.id == $id) | .rows // empty' "$DIR/grade/http.jsonl" 2>/dev/null | head -1)"
        [[ -n "$rows" ]] || rows="unrecorded"
      else
        rows="$(psql "$(jq -r '.target_database_url // .project_database_url // empty' "$DIR/env/dev.json")" \
                  -Atqc "$sql" 2>>"$DIR/grade/http.err" | grep -c . || true)"
        # The row count joins the responses in the request log, so a later
        # replay scores this step from the record like any other.
        jq -cn --arg id "$id" --arg sql "$sql" --arg rows "$rows" '{id:$id, sql:$sql, rows:$rows}' \
          >> "$DIR/grade/http.jsonl"
      fi
      [[ "$rows" == "$expect_rows" ]] && verdict=true
      evidence="sql rows=$rows expected=$expect_rows"

    elif jq -e 'has("concurrent")' <<< "$step" >/dev/null; then
      # Contention. Fired in parallel on purpose: exactly one must refuse, and
      # a sequential pair would pass whether or not the invariant holds.
      local code refusals=0 target
      code="$(jq -r '.expect.exactly_one.error_code' <<< "$step")"
      # The scoring half below already reads files the run wrote. Only the
      # firing half needs a live release, so a replay skips it.
      if [[ -z "$REPLAY" ]]; then
        local -a pids=()
        local arm arm_operation arm_body
        while read -r target; do
          arm="$(jq -c --arg t "$target" '[.[] | select(.id == $t)] | first' "$STEPS")"
          arm_operation="$(jq -r '.route.operation' <<< "$arm")"
          # An arm whose body cannot be shaped writes the reason where the
          # scoring half looks, so a shape defect reads as a shape defect
          # rather than as a missing refusal.
          if arm_body="$(resolve_body "$arm" "$arm_operation" "$id-$target")"; then
            ( fire_step "$arm" "$(route_path_for "$arm_operation")" "$arm_body" \
                > "$DIR/grade/$id-$target.out" 2>&1 ) &
            pids+=($!)
          else
            printf '%s\n' "$arm_body" > "$DIR/grade/$id-$target.out"
          fi
        done < <(jq -r '.concurrent[]' <<< "$step")
        [[ ${#pids[@]} -eq 0 ]] || wait "${pids[@]}" 2>/dev/null || true
      fi
      while read -r target; do
        grep -q "\"$code\"" "$DIR/grade/$id-$target.out" 2>/dev/null && refusals=$((refusals + 1))
      done < <(jq -r '.concurrent[]' <<< "$step")
      [[ "$refusals" -eq 1 ]] && verdict=true
      evidence="concurrent refusals=$refusals expected=1 code=$code"

    elif [[ -n "$REPLAY" ]]; then
      # Score the bytes the run recorded, under the same predicates. This is
      # the whole point of the verb: a rubric change re-scores every recorded
      # run with no host, no database and no agent time.
      local record
      record="$(jq -c --arg id "$id" 'select(.id == $id)' "$DIR/grade/http.jsonl" 2>/dev/null | head -1)"
      if [[ -z "$record" ]]; then
        evidence="not replayable: the run recorded no response for $id"
      else
        path="$(jq -r '.path // ""' <<< "$record")"
        status="$(jq -r '.status // ""' <<< "$record")"
        payload="$(jq -r '.response // ""' <<< "$record")"
        verdict_for_step "$step" "$status" "$payload" "$(jq -r '.route.operation // ""' <<< "$step")"
      fi

    else
      operation="$(jq -r '.route.operation' <<< "$step")"
      path="$(route_path_for "$operation")"
      if [[ -z "$path" ]]; then
        evidence="no attachment publishes operation $operation"
      elif ! body="$(resolve_body "$step" "$operation" "$id")"; then
        evidence="$body"
      else
        response="$(fire_step "$step" "$path" "$body")"
        status="$(tail -1 <<< "$response")"
        payload="$(sed '$d' <<< "$response")"
        jq -cn --arg id "$id" --arg path "$path" --argjson body "$body" \
               --arg status "$status" --arg payload "$payload" \
               '{id:$id, path:$path, request:$body, status:$status, response:$payload}' \
          >> "$DIR/grade/http.jsonl"
        verdict_for_step "$step" "$status" "$payload" "$operation"
      fi
    fi

    STEP_RESULTS="$(jq -c --arg id "$id" --argjson must "$must" --arg inv "$invariant" \
      --arg proves "$proves" --argjson pass "$verdict" --arg ev "$evidence" \
      '. + [{id:$id, must:$must, invariant:$inv, proves:$proves, pass:$pass, evidence:$ev}]' <<< "$STEP_RESULTS")"
    jq -c --arg id "$id" --arg payload "${payload:-}" \
      '. + [{id:$id, value:(($payload | fromjson? // {}) | if type == "array" then .[0].value // {} else . end)}]' \
      "$RESULTS" > "$RESULTS.tmp" && mv "$RESULTS.tmp" "$RESULTS"
  done < <(jq -c '.[]' "$STEPS")
}

# The result is read the same way the request is shaped. An expect naming
# appointment_id finds it whether the contract publishes it flat or nested, and
# a name the contract does not declare is read where the fixture named it.
RESULT_MAP='{}'
result_path() {
  jq -rn --argjson m "$RESULT_MAP" --arg p "$1" '$m[$p] // $p'
}

verdict_for_step() {
  local step="$1" status="$2" payload="$3" operation="${4:-}"
  RESULT_MAP="$(result_map_for "$operation")"
  local want_status item want_code
  want_status="$(jq -r '.expect.status // 200' <<< "$step")"
  item="$(jq -r '.expect.item // "value"' <<< "$step")"
  want_code="$(jq -r '.expect.error_code // ""' <<< "$step")"

  verdict=false
  evidence="status=$status"
  [[ "$status" == "$want_status" ]] || return 0

  local first; first="$(jq -c 'if type == "array" then .[0] else . end' <<< "$payload" 2>/dev/null || echo '{}')"
  if [[ "$item" == "error" ]]; then
    local got; got="$(jq -r '.error.code // ""' <<< "$first")"
    evidence="$evidence error_code=$got"
    [[ "$got" == "$want_code" ]] && verdict=true
    return 0
  fi

  jq -e 'has("value")' <<< "$first" >/dev/null || { evidence="$evidence no value item"; return 0; }
  local value; value="$(jq -c '.value' <<< "$first")"
  verdict=true

  # present: the path exists and is not empty. This is what a create asserts:
  # the identity it minted is addressable, which is the only thing about a
  # create that a later step can build on.
  local path at
  while read -r path; do
    [[ -n "$path" ]] || continue
    at="$(result_path "$path")"
    local got; got="$(jq -r --arg p "$at" 'getpath($p | split(".")) // "" | tostring' <<< "$value")"
    evidence="$evidence present:$at=${got:-<empty>}"
    [[ -n "$got" && "$got" != "null" ]] || verdict=false
  done < <(jq -r '.expect.present // [] | .[]' <<< "$step")

  # value: the path equals a literal the fixture pinned.
  while read -r path; do
    [[ -n "$path" ]] || continue
    at="$(result_path "$path")"
    local want mine
    want="$(jq -r --arg p "$path" '.expect.value[$p] | tostring' <<< "$step")"
    mine="$(jq -r --arg p "$at" 'getpath($p | split(".")) | tostring' <<< "$value")"
    evidence="$evidence $at=$mine want=$want"
    [[ "$mine" == "$want" ]] || verdict=false
  done < <(jq -r '.expect.value // {} | keys[]' <<< "$step")

  # equals: the path equals a value an earlier step returned. This is how the
  # claim law is checked without the grader knowing any id in advance.
  local other
  while read -r path; do
    [[ -n "$path" ]] || continue
    at="$(result_path "$path")"
    other="$(jq -r --arg p "$path" '.expect.equals[$p]' <<< "$step")"
    local mine theirs
    mine="$(jq -r --arg p "$at" 'getpath($p | split(".")) | tostring' <<< "$value")"
    theirs="$(read_result "${other%%.*}" "${other#*.}")"
    evidence="$evidence $at=$mine vs $theirs"
    [[ "$mine" == "$theirs" && -n "$mine" && "$mine" != "null" ]] || verdict=false
  done < <(jq -r '.expect.equals // {} | keys[]' <<< "$step")

  # count: the array at the path has exactly this many entries.
  if jq -e '.expect | has("count")' <<< "$step" >/dev/null; then
    local cpath want got
    cpath="$(result_path "$(jq -r '.expect.count.path' <<< "$step")")"
    want="$(jq -r '.expect.count.is' <<< "$step")"
    got="$(jq -r --arg p "$cpath" 'getpath($p | split(".")) | length' <<< "$value")"
    evidence="$evidence count:$cpath=$got want=$want"
    [[ "$got" == "$want" ]] || verdict=false
  fi

  # sorted_by: the array at the path is ordered by the named field. An order
  # assertion cannot name the ids, because the agent minted them.
  #
  # The list itself is found through the entry field. A contract that declares
  # appointments[].slot_start names both the list and the field in one path, so
  # the fixture's own path is used only when the contract declares no list.
  if jq -e '.expect | has("sorted_by")' <<< "$step" >/dev/null; then
    local spath field direction ordered declared
    spath="$(jq -r '.expect.sorted_by.path' <<< "$step")"
    field="$(jq -r '.expect.sorted_by.field' <<< "$step")"
    direction="$(jq -r '.expect.sorted_by.direction // "asc"' <<< "$step")"
    declared="$(jq -rn --argjson m "$RESULT_MAP" --arg f "$field" '$m[$f] // ""')"
    if [[ "$declared" == *"[]"* ]]; then
      spath="$(jq -rn --arg d "$declared" '$d | split("[]")[0] | rtrimstr(".")')"
    fi
    ordered="$(jq -r --arg p "$spath" --arg f "$field" --arg d "$direction" '
      (getpath($p | split(".")) // []) as $rows
      | ($rows | map(.[$f])) as $keys
      | if ($keys | length) < 1 then "empty"
        elif $d == "asc" then ($keys == ($keys | sort) | tostring)
        else ($keys == ($keys | sort | reverse) | tostring) end' <<< "$value")"
    evidence="$evidence sorted_by:$spath.$field=$ordered"
    [[ "$ordered" == "true" ]] || verdict=false
  fi
}

# ---- 4. checks and fence reports -------------------------------------------
# The loop already fences three rules. The grader REPORTS its verdicts and runs
# nothing of its own for them: a second policy that disagrees with the loop
# would be a second policy, and the loop is the one that ships.
report_fences() {
  local out; out="$DIR/grade/dev.out"
  local migrate admit
  migrate="$(sed -n 's/^\(.*\) at Migrate: \(.*\)$/\1: \2/p' "$out" | head -1)"
  admit="$(sed -n 's/^\(.*\) at Admit: \(.*\)$/\1: \2/p' "$out" | head -1)"

  FENCES="$(jq -n \
    --arg capability "$( [[ -z "$admit" ]] && echo "Admit passed" || echo "$admit" )" \
    --arg migration "$( [[ -z "$migrate" ]] && echo "Migrate passed" || echo "$migrate" )" \
    '{ "capability-surface": {source:"Admit", verdict:$capability},
       "additive-migration": {source:"Migrate", verdict:$migration},
       "no-environment-data": {source:"Admit", verdict:"unfenced"} }')"
}

# The checks below have NO fence in the loop, which is the only reason they are
# here. `naming` is removed the day Gate fences it.
run_checks() {
  local replay changed naming row_version

  # claim-replay: proven through the steps, not re-implemented. A fixture that
  # names no replay step leaves this unproven and says so.
  if [[ "$LOOP_PASS" != true ]]; then
    replay="not run: the loop served no release"
  else
    # wamn-nvbd.7. Select on what a step DECLARES it proves, never on text in
    # another field. This matched `replay|idempot` against `invariant`, which
    # holds invariant IDS like DOCK-2, so it reported "no replay step" through
    # three runs whose replay and changed-body steps both passed as must steps.
    replay="$(jq -r '
      [.[] | select(.proves == "claim-replay")] as $r
      | if ($r | length) == 0 then "no step declares claim-replay"
        elif ($r | all(.pass)) then "pass" else "fail" end' <<< "$STEP_RESULTS")"
  fi

  # row_version: the concurrency column is spelled exactly so, everywhere the
  # agent declared one.
  row_version="pass"
  if [[ -d "$DIR/worktree/$OVERLAY_ROOT" ]]; then
    local wrong
    wrong="$(grep -rlE 'rowversion|row_ver\b|version_row|rowVersion' \
      "$DIR/worktree/$OVERLAY_ROOT" 2>/dev/null | head -5 | tr '\n' ' ' || true)"
    [[ -z "$wrong" ]] || row_version="fail: $wrong"
  fi

  # naming: singular snake_case wire identifiers and no version suffixes.
  naming="pass"
  if [[ -f "$DIR/worktree/$OVERLAY_ROOT/wamn.json" ]]; then
    local offenders
    offenders="$(jq -r '
      [ .. | objects | (.name? // empty) ]
      | map(select(type == "string"))
      | map(select(test("^[a-z][a-z0-9_]*$") | not) // select(test("_v[0-9]+$")))
      | unique | join(", ")' "$DIR/worktree/$OVERLAY_ROOT/wamn.json" 2>/dev/null || echo "")"
    [[ -z "$offenders" ]] || naming="fail: $offenders"
  fi

  CHECKS="$(jq -n --arg replay "$replay" --arg row_version "$row_version" --arg naming "$naming" \
    '{"claim-replay":$replay, "row_version":$row_version, "naming":$naming}')"
}

# ---- 5. stop the held loop and prove the database went with it -------------
verify_teardown() {
  cleanup; HELD_PID=""
  # Whether the loop removed its verification database is a question only the
  # live run can ask. A replay carries the answer that run recorded.
  if [[ -n "$REPLAY" ]]; then
    VERIFICATION_DB_REMOVED="$(jq -r '.teardown.verification_database_removed // false' \
      "$DIR/checklist.json" 2>/dev/null || echo false)"
    return 0
  fi
  # The database to look for is the one the configuration NAMES, not a guessed
  # pattern. The standup creates it and the loop drops and recreates it per run,
  # so a leftover after the interrupt means the loop's cleanup did not run.
  local admin verification
  admin="$(jq -r '.system_database_url // empty' "$DIR/env/dev.json")"
  verification="$(jq -r '.verification_database_url // empty' "$DIR/env/dev.json" \
    | sed 's|.*/||; s|?.*||')"
  if [[ -n "$admin" && -n "$verification" ]]; then
    local remaining
    remaining="$(psql "$admin" -Atqc \
      "select count(*) from pg_database where datname = '$verification'" 2>/dev/null || echo 1)"
    if [[ "$remaining" == "0" ]]; then VERIFICATION_DB_REMOVED=true
    else VERIFICATION_DB_REMOVED=false; note "the verification database $verification remains"; fi
  else
    VERIFICATION_DB_REMOVED=false
  fi
}

# ---- 6. the checklist ------------------------------------------------------
write_checklist() {
  jq -n \
    --argjson loop "$(jq -n --argjson pass "$LOOP_PASS" --argjson stages "${LOOP_STAGES:-0}" \
                       --arg base_url "${BASE_URL:-}" '{pass:$pass, stages:$stages, base_url:$base_url}')" \
    --argjson paths "$(jq -n --argjson pass "$PATHS_PASS" --argjson outside "$OUTSIDE" \
                        --arg tracker "$TRACKER_TOUCHED" '{pass:$pass, outside:$outside, tracker:$tracker}')" \
    --argjson steps "$STEP_RESULTS" \
    --argjson contract "$(jq -n --arg state "${CONTRACT_STATE:-not-checked}" \
                           --argjson misses "${CONTRACT_MISSES:-0}" \
                           '{state:$state, deviations:$misses}')" \
    --argjson checks "$CHECKS" \
    --argjson fences "$FENCES" \
    --argjson teardown "$VERIFICATION_DB_REMOVED" \
    '{loop:$loop, paths:$paths, contract:$contract, steps:$steps, checks:$checks, fences:$fences,
      teardown:{verification_database_removed:$teardown},
      human:{Q3:null, Q7:null, Q8:null, Q9:null, "Q10.activated":null, Q11:null,
             E1:null, E2:null, E3:null, E4:null, E5:null, E6:null, E7:null,
             "H-1":null, "H-2":null, "H-3":null, "H-4":null, "H-5":null, "H-6":null,
             "S-1":null, "S-2":null, "S-3":null}}' \
    > "$CHECKLIST"
}

# Any miss on the loop, the allow-list, or a must step is a run FAIL. Other
# steps are recorded and decide nothing.
decide_outcome() {
  local failures=()
  [[ "$LOOP_PASS" == true ]] || failures+=("loop")
  [[ "$PATHS_PASS" == true ]] || failures+=("paths")
  local missed
  missed="$(jq -r '[.[] | select(.must == true and .pass == false) | .id] | join(",")' <<< "$STEP_RESULTS")"
  [[ -z "$missed" ]] || failures+=("steps: $missed")

  if [[ ${#failures[@]} -eq 0 ]]; then
    OUTCOME="PASS"
  else
    OUTCOME="FAIL (items: ${failures[*]})"
  fi
  jq --arg outcome "$OUTCOME" '.outcome = $outcome' "$CHECKLIST" \
    > "$CHECKLIST.tmp" && mv "$CHECKLIST.tmp" "$CHECKLIST"
  note "$OUTCOME"
}

# ---- 7. placement, on its own ----------------------------------------------
# The request body for every route step, and nothing else. Placement reads only
# the package's published contracts and the fixture, so the rule is provable
# with no host, no database and no agent. A run that recorded its responses
# feeds the reuse clauses; without one they resolve to empty.
grade_placement() {
  echo '[]' > "$RESULTS"
  local step id operation body value
  while read -r step; do
    id="$(jq -r .id <<< "$step")"
    operation="$(jq -r '.route.operation // ""' <<< "$step")"
    if [[ -n "$operation" ]]; then
      if body="$(resolve_body "$step" "$operation" "$id")"; then
        jq -cn --arg id "$id" --arg op "$operation" --argjson body "$body" \
          '{id:$id, operation:$op, ok:true, body:$body}'
      else
        jq -cn --arg id "$id" --arg op "$operation" --arg ev "$body" \
          '{id:$id, operation:$op, ok:false, evidence:$ev}'
      fi
    fi
    value="$( { jq -r --arg id "$id" 'select(.id == $id) | .response // ""' \
      "$DIR/grade/http.jsonl" 2>/dev/null || true; } | head -1)"
    jq -c --arg id "$id" --arg payload "$value" \
      '. + [{id:$id, value:(($payload | fromjson? // {}) | if type == "array" then .[0].value // {} else . end)}]' \
      "$RESULTS" > "$RESULTS.tmp" && mv "$RESULTS.tmp" "$RESULTS"
  done < <(jq -c '.[]' "$STEPS")
}

# ---- 8. the brief, against what the package declares ------------------------
# A REFERENCE IS NEVER MORE LENIENT THAN THE CONTRACT IT PROVES, and the brief
# is asserted against it here. The brief said a timestamp is UTC RFC 3339 with
# six fractional digits while the fixture sent bare seconds. One agent parsed
# any RFC 3339 and passed, one enforced the sentence and refused every
# timestamped step, and both readings were defensible. That cost two arms,
# because nothing compared the two documents.
#
# THE SUBJECT IS THE TABLE, AND ONLY THE TABLE. Every cell of the data contract
# is a comma separated list of `name` type pairs, and a cell that is not is
# reported rather than guessed at: a parser that reads prose invents a contract
# nobody wrote. The one prose claim that is machine-checkable, the canonical
# spelling of a scalar, is carried as a second table naming the token the input
# contract publishes.
brief_table() {
  sed -n '/^## The data contract/,/^## [A-Z]/p' "$BRIEF" | jq -Rn '
    def cells: [ splits("\\|") | gsub("^ +| +$"; "") ] | map(select(. != ""));
    def entries: [ splits(",") | gsub("^ +| +$"; "") | select(. != "")
                   | if test("^`[a-z_]+` [a-z]+$")
                     then capture("^`(?<name>[a-z_]+)` (?<type>[a-z]+)$")
                     else {unreadable: .} end ];
    def token: ltrimstr("`") | rtrimstr("`");
    [ inputs | select(startswith("|")) | cells ] as $rows
    | { operations:
          [ $rows[] | select(length == 3) | select(.[0] | test("^`[a-z_]+\\.[a-z_]+`$"))
            | { operation: (.[0] | token), input: (.[1] | entries), result: (.[2] | entries) } ],
        scalars:
          [ $rows[] | select(length == 2)
            | select((.[0] | test("^`[a-z_]+`$")) and (.[1] | test("^`[a-z_0-9]+`$")))
            | { scalar: (.[0] | token), form: (.[1] | token) } ] }'
}

# The type word a brief writes, and the type token a contract publishes. The
# platform has no date type, so a date is carried as text.
contract_token() {
  case "$1" in
    text|uuid|list) printf '%s' "$1" ;;
    timestamp) printf 'timestamptz' ;;
    date) printf 'text' ;;
    *) printf '' ;;
  esac
}

# Every field one contract declares, as name, path and type. The two published
# shapes are read exactly as the placement rule reads them.
declared_fields() {
  local contract; contract="$(contract_file "$1" "$2")"
  [[ -n "$contract" ]] || { echo ""; return; }
  jq -c '
    ( if (.fields | type) == "array" then [ .fields[] | {path, type} ]
      else
        [ to_entries[] | select((.value | type) == "object")
          | select((.value | has("type")) and (.value | has("required")))
          | {path: .key, type: .value.type} ]
        + [ .writable_fields // [] | .[] | {path: .field, type} ]
      end )
    | map(. + {name: (.path | gsub("\\[\\]"; "") | split(".") | last)})' "$contract"
}

assert_field() {
  local operation="$1" side="$2" declared="$3" name="$4" type="$5" row
  row="$(jq -cn --argjson declared "${declared:-null}" --arg op "$operation" --arg side "$side" \
    --arg n "$name" --arg t "$type" --arg want "$(contract_token "$type")" '
    [ ($declared // [])[] | select(.name == $n) ] as $named
    | [ ($declared // [])[] | select(.path | startswith($n + "[]")) ] as $listed
    | { operation:$op, side:$side, field:$n, type:$t }
      + if $declared == null then
          {ok:false, evidence:"the package publishes no \($side) contract"}
        elif $want == "" then
          {ok:false, evidence:"the brief names a type the platform does not publish"}
        elif $want == "list" then
          (if ($listed | length) > 0 then {ok:true, declared:($listed[0].path)}
           else {ok:false, evidence:"no declared path begins with \($n)[]"} end)
        elif ($named | length) == 0 then
          {ok:false, evidence:"the package declares no \($side) field named \($n). it declares \([$declared[].path] | sort | join(", "))"}
        elif ([$named[].type] | unique) != [$want] then
          {ok:false, declared:($named[0].path),
           evidence:"declared \([$named[].type] | unique | join(", ")), the brief says \($t), which the platform publishes as \($want)"}
        else {ok:true, declared:"\($named[0].path) \($named[0].type)"} end')"
  printf '%s\n' "$row"
  [[ "$(jq -r .ok <<< "$row")" == true ]]
}

# A canonical form the brief names must be the one every input contract that
# publishes it declares, and at least one must publish it. A projection is not
# hashed and publishes no canonicalization at all, so an operation that
# declares nothing is silent rather than wrong.
assert_scalar() {
  local scalar="$1" form="$2" table="$3"
  local key operation file got declared="" wrong=""
  key="$(contract_token "$scalar")"
  while read -r operation; do
    file="$(contract_file "$operation" input)"
    [[ -n "$file" ]] || continue
    got="$(jq -r --arg k "$key" '.canonicalization[$k] // ""' "$file")"
    [[ -n "$got" ]] || continue
    declared="$declared $operation"
    [[ "$got" == "$form" ]] || wrong="$wrong $operation=$got"
  done < <(jq -r '.operations[].operation' <<< "$table")

  local row
  row="$(jq -cn --arg s "$scalar" --arg k "$key" --arg form "$form" \
    --arg declared "${declared# }" --arg wrong "${wrong# }" '
    {scalar:$s, key:$k, form:$form}
    + if $declared == "" then
        {ok:false, evidence:"no input contract publishes a canonicalization for \($k)"}
      elif $wrong != "" then
        {ok:false, evidence:"declared otherwise by \($wrong)"}
      else {ok:true, declared:$declared} end')"
  printf '%s\n' "$row"
  [[ "$(jq -r .ok <<< "$row")" == true ]]
}

grade_contract() {
  [[ -s "$BRIEF" ]] || die "no brief at $BRIEF" "$EX_ENV"
  local table; table="$(brief_table)"
  [[ "$(jq -r '.operations | length' <<< "$table")" -gt 0 ]] \
    || die "the data contract in $BRIEF names no operation" "$EX_GRADE"

  local misses=0 row operation side entry name type declared
  while read -r row; do
    operation="$(jq -r .operation <<< "$row")"
    for side in input result; do
      declared="$(declared_fields "$operation" "$side")"
      while read -r entry; do
        name="$(jq -r '.name // ""' <<< "$entry")"
        type="$(jq -r '.type // ""' <<< "$entry")"
        if [[ -z "$name" ]]; then
          jq -cn --arg op "$operation" --arg side "$side" --arg cell "$(jq -r .unreadable <<< "$entry")" \
            '{operation:$op, side:$side, ok:false,
              evidence:"the entry \($cell) is not a `name` type pair"}'
          misses=$((misses + 1))
        elif ! assert_field "$operation" "$side" "$declared" "$name" "$type"; then
          misses=$((misses + 1))
        fi
      done < <(jq -c --arg side "$side" '.[$side][]' <<< "$row")
    done
  done < <(jq -c '.operations[]' <<< "$table")

  while read -r row; do
    assert_scalar "$(jq -r .scalar <<< "$row")" "$(jq -r .form <<< "$row")" "$table" \
      || misses=$((misses + 1))
  done < <(jq -c '.scalars[]' <<< "$table")

  [[ "$misses" -eq 0 ]] \
    || { note "the brief fails $misses assertion(s) against $OVERLAY_ROOT"; return "$EX_GRADE"; }
  note "the brief's data contract holds against $OVERLAY_ROOT"
}

# The contract check REPORTS on the live path and never gates it. A field name
# the package declares otherwise is a deviation from what the agent was handed,
# and naming it in one line beats nine steps producing nine refusals. It is a
# different property from behaviour, so the steps still run and the checklist
# carries both: the cause and the effect.
report_contract() {
  CONTRACT_MISSES=0
  CONTRACT_STATE="not-checked"
  [[ -s "$BRIEF" ]] || { note "no brief to check the contract against"; return 0; }
  [[ -d "$DIR/worktree/$OVERLAY_ROOT" ]] || return 0
  if grade_contract > "$DIR/grade/contract.jsonl" 2>>"$DIR/grade/http.err"; then
    CONTRACT_STATE="holds"
  else
    CONTRACT_STATE="deviates"
    CONTRACT_MISSES="$(jq -s '[.[] | select(.ok == false)] | length' \
      "$DIR/grade/contract.jsonl" 2>/dev/null || echo 0)"
    local first
    first="$(jq -rs '[.[] | select(.ok == false)] | first
      | "\(.operation // .scalar).\(.field // .key)"' "$DIR/grade/contract.jsonl" 2>/dev/null)"
    note "contract mismatch on $first; $CONTRACT_MISSES deviation(s) from the brief"
  fi
}

if [[ -n "$CONTRACT" ]]; then
  grade_contract || exit "$?"
  exit 0
fi

if [[ -n "$PLACEMENT" ]]; then
  grade_placement
  exit 0
fi

grade_loop
grade_paths
report_contract
grade_steps
report_fences
run_checks
verify_teardown
write_checklist
decide_outcome
[[ "$OUTCOME" == "PASS" ]] || exit "$EX_GRADE"
