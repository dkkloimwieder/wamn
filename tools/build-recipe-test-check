#!/usr/bin/env bash
set -euo pipefail

readonly WAMN_TOOL_DIRECTORY="$(
  CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_REPOSITORY_ROOT="$(
  CDPATH= cd -- "$WAMN_TOOL_DIRECTORY/.." >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_BUILD_RECIPE_DOC="$WAMN_REPOSITORY_ROOT/docs/archive/build-and-test.md"

wamn_fail() {
  printf 'build-recipe-test-check: %s\n' "$*" >&2
  exit 1
}

wamn_trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

[[ -r "$WAMN_BUILD_RECIPE_DOC" ]] || {
  wamn_fail "cannot read $WAMN_BUILD_RECIPE_DOC"
}

mapfile -t WAMN_RECIPE_TESTS < <(
  sed -n 's/^[[:space:]]*# recipe-test:[[:space:]]*//p' "$WAMN_BUILD_RECIPE_DOC"
)
((${#WAMN_RECIPE_TESTS[@]} > 0)) || {
  wamn_fail 'no recipe-test directives found'
}

declare -A WAMN_SEEN_IDS=()
readonly WAMN_CARGO="${CARGO:-cargo}"

for directive in "${WAMN_RECIPE_TESTS[@]}"; do
  IFS='|' read -r raw_id raw_proof raw_package raw_kind raw_target raw_filter \
    raw_minimum raw_boundary extra <<<"$directive"
  [[ -z "${extra:-}" ]] || wamn_fail "too many fields in directive: $directive"

  id="$(wamn_trim "${raw_id:-}")"
  proof="$(wamn_trim "${raw_proof:-}")"
  package="$(wamn_trim "${raw_package:-}")"
  kind="$(wamn_trim "${raw_kind:-}")"
  target="$(wamn_trim "${raw_target:-}")"
  filter="$(wamn_trim "${raw_filter:-}")"
  minimum="$(wamn_trim "${raw_minimum:-}")"
  boundary="$(wamn_trim "${raw_boundary:-}")"

  [[ "$id" =~ ^[A-Z0-9-]+$ ]] || wamn_fail "invalid recipe id '$id'"
  [[ -z "${WAMN_SEEN_IDS[$id]:-}" ]] || wamn_fail "duplicate recipe id '$id'"
  WAMN_SEEN_IDS["$id"]=1
  [[ -n "$proof" ]] || wamn_fail "$id has no proof class"
  [[ "$package" =~ ^[A-Za-z0-9_-]+$ ]] || {
    wamn_fail "$id has invalid package '$package'"
  }
  [[ -n "$boundary" ]] || wamn_fail "$id has no boundary"
  [[ "$minimum" =~ ^[1-9][0-9]*$ ]] || {
    wamn_fail "$id has invalid minimum '$minimum'"
  }

  arguments=(test --locked --offline -p "$package")
  case "$kind" in
    lib)
      [[ "$target" == "-" ]] || wamn_fail "$id lib target must be '-'"
      arguments+=(--lib)
      ;;
    test)
      [[ "$target" =~ ^[A-Za-z0-9_-]+$ ]] || {
        wamn_fail "$id has invalid integration-test target '$target'"
      }
      arguments+=(--test "$target")
      ;;
    *)
      wamn_fail "$id has unsupported target kind '$kind'"
      ;;
  esac
  if [[ "$filter" != "-" ]]; then
    [[ -n "$filter" && "$filter" != *[[:space:]]* ]] || {
      wamn_fail "$id has invalid filter '$filter'"
    }
    arguments+=("$filter")
  fi
  arguments+=(-- --list)

  if ! output="$(
    cd "$WAMN_REPOSITORY_ROOT"
    "$WAMN_CARGO" "${arguments[@]}" 2>&1
  )"; then
    printf '%s\n' "$output" >&2
    wamn_fail "$id could not list $package $kind tests"
  fi

  matches="$(awk '/: test$/ { count += 1 } END { print count + 0 }' <<<"$output")"
  if ((matches < minimum)); then
    printf '%s\n' "$output" >&2
    wamn_fail \
      "$id selected $matches tests; expected at least $minimum for $package/$kind/$target filter '$filter'"
  fi

  printf '%s: %s tests (minimum %s) — %s; %s\n' \
    "$id" "$matches" "$minimum" "$proof" "$boundary"
done
