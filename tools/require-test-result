#!/usr/bin/env bash
# Run children with streaming output and a shared silence limit.
# Sourcing this file exposes the process boundary without requiring test results.
wamn_run_child() {
  python3 - "$@" <<'PYTHON'
import os
import selectors
import signal
import subprocess
import sys
import time

stage, *command = sys.argv[1:]
# The testing strategy permits 30 minutes of silence, regardless of runtime.
bound = float(os.environ.get("WAMN_TEST_SILENCE_SECONDS", "1800"))
if not 0 < bound < float("inf"):
    sys.exit("WAMN_TEST_SILENCE_SECONDS must be a finite positive number")
child = subprocess.Popen(command, stdin=subprocess.DEVNULL,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                         start_new_session=True)

def interrupted(signum, frame):
    raise SystemExit(128 + signum)

signal.signal(signal.SIGTERM, interrupted)
signal.signal(signal.SIGINT, interrupted)
try:
    with selectors.DefaultSelector() as selector:
        selector.register(child.stdout, selectors.EVENT_READ, sys.stdout.fileno())
        selector.register(child.stderr, selectors.EVENT_READ, sys.stderr.fileno())
        last_output = time.monotonic()
        while selector.get_map():
            events = selector.select(max(0, bound - (time.monotonic() - last_output)))
            if not events:
                raise subprocess.TimeoutExpired(command, bound)
            for key, _ in events:
                data = os.read(key.fd, 65536)
                if data:
                    last_output = time.monotonic()
                    # Write bytes immediately, including output without a newline.
                    view = memoryview(data)
                    while view:
                        view = view[os.write(key.data, view):]
                else:
                    selector.unregister(key.fileobj)
        status = child.wait(timeout=max(0, bound - (time.monotonic() - last_output)))
except subprocess.TimeoutExpired:
    print(f"test runner: {stage}: no child output for {bound:g} seconds", file=sys.stderr)
    status = 124
finally:
    # Terminate descendants too, including children that keep a pipe open.
    # Nested runners receive TERM so that they can stop their own process groups.
    try:
        os.killpg(child.pid, signal.SIGTERM)
        child.wait(timeout=1)
    except subprocess.TimeoutExpired:
        pass
    except ProcessLookupError:
        pass
    try:
        os.killpg(child.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    child.wait()
sys.exit(status if status >= 0 else 128 - status)
PYTHON
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0
set -euo pipefail
expected=''
each_target=false
if [[ ${1:-} == --expected-test ]]; then
  expected=$2
  shift 2
fi
if [[ ${1:-} == --each-target ]]; then
  each_target=true
  shift
fi
(($# > 0)) || { printf 'usage: tools/require-test-result COMMAND [ARG...]\n' >&2; exit 64; }
umask 077
result=$(mktemp "${TMPDIR:-/tmp}/wamn-required-test.XXXXXXXX")
trap 'rm -f -- "$result"' EXIT
status=0
wamn_run_child "$*" "$@" 2>&1 | tee "$result" || status=$?
((status == 0)) || exit "$status"
if ! awk '
  /^test result: ok\. [0-9]+ passed; 0 failed;/ { passed += $4 }
  END { exit !(passed > 0) }
' "$result"; then
  printf 'required test command reported no executed passing cases\n' >&2
  exit 1
fi
if [[ "$each_target" == true ]] && grep -q '^test result: ok\. 0 passed;' "$result"; then
  printf 'required test target reported no executed passing cases\n' >&2
  exit 1
fi
# The command exited zero, so no case failed. A case that ran prints its
# result after its own output, which may split "test NAME ... " from "ok";
# an ignored case prints "ignored" on its own line at once.
if [[ -n "$expected" ]] && ! awk -v start="test $expected ... " '
  index($0, start) == 1 && substr($0, length(start) + 1) !~ /^ignored/ { found = 1 }
  END { exit !found }
' "$result"; then
  printf 'required test did not pass: %s\n' "$expected" >&2
  exit 1
fi
