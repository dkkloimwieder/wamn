#!/usr/bin/env bash
# Proof for the rubric fence in tools/agent-pilot-run. wamn-nvbd.12.
#
# No machine and no agent: the check reads a directory layout, so the layout is
# synthesised and each reachable place is planted on its own. The defect it
# guards was a rubric that moved from one readable directory to another, so the
# proof plants it in every path the runner hands the agent.
set -euo pipefail

repo_root=${1:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
failures=0

check() {
  if [[ $2 -eq 0 ]]; then printf '  ok    %s\n' "$1"
  else printf '  FAIL  %s\n' "$1"; failures=$((failures + 1)); fi
}

# The function under test, lifted with the globals it reads. Lifting keeps the
# proof honest about WHICH code runs: a copy would drift from the runner.
fence() {
  sed -n '/^assert_rubric_unreachable() {/,/^}/p' "$repo_root/tools/agent-pilot-run"
}
cutter() {
  sed -n '/^strip_document_section() {/,/^}/p' "$repo_root/tools/agent-pilot-run"
}
eval "$(cutter)"
[[ -n "$(fence)" ]] || { echo "assert_rubric_unreachable not found in the runner" >&2; exit 2; }

# <dir> <what to plant: none|root|fixture|worktree|grade-manifest>
run_fence() {
  local d="$work/$2" plant="$3"
  rm -rf "$d"; mkdir -p "$d"/{fixture,bin,env,worktree,grade}
  echo '{"identity":{},"overlay_root":"p"}' > "$d/task.json"
  echo '{"identity":{},"overlay_root":"p"}' > "$d/fixture/task.json"
  mkdir -p "$d/worktree/docs/operations" "$d/worktree/tools"
  printf '## The full sweep\n\ncargo test\n\n### `[AGENT-PILOT]` - the harness\n\nit measures you\n\n### `[GUEST-DIGEST]` - digests\n\nkeep me\n' \
    > "$d/worktree/docs/operations/build-and-test.md"
  case "$plant" in
    none) strip_document_section "$d/worktree/docs/operations/build-and-test.md" '[AGENT-PILOT]' ;;
    section) ;;
    grader) strip_document_section "$d/worktree/docs/operations/build-and-test.md" '[AGENT-PILOT]'
            echo '#!/bin/sh' > "$d/worktree/tools/agent-pilot-grade" ;;
    root)     echo '[]' > "$d/steps.json" ;;
    fixture)  echo '[]' > "$d/fixture/steps.json" ;;
    worktree) echo '[]' > "$d/worktree/steps.json" ;;
    grade-manifest) echo '{"identity":{},"grade":{"steps":"steps.json"}}' > "$d/fixture/task.json" ;;
  esac
  ( set +e
    DIR="$d" TARGET="$work/target" EX_ENV=10
    GATE_DOCUMENT="docs/operations/build-and-test.md"
    PILOT_SECTION='[AGENT-PILOT]'
    die() { printf 'agent-pilot-run: %s\n' "$1" >&2; exit "${2:-2}"; }
    eval "$(fence)"
    assert_rubric_unreachable "steps.json"
  ) 2>/dev/null
}

refuses() { # <label> <dirname> <plant>
  local rc=0
  run_fence "$work" "$2" "$3" || rc=$?
  check "$1" "$([[ $rc -ne 0 ]] && echo 0 || echo 1)"
}
admits() { # <label> <dirname> <plant>
  local rc=0
  run_fence "$work" "$2" "$3" || rc=$?
  check "$1" "$rc"
}

admits  "a run with the rubric outside the run directory passes"        clean      none
refuses "the rubric at the run directory root is refused"               atroot     root
refuses "the rubric in the agent's task directory is refused"           atfixture  fixture
refuses "the rubric inside the worktree is refused"                     atworktree worktree
refuses "a task manifest that still carries the grade block is refused" atgrade    grade-manifest
refuses "a gate document that still names the pilot section is refused"  atsection  section
refuses "the grader left in the worktree is refused"                     atgrader   grader

# The section fence cuts one section and leaves its neighbours alone.
cut="$work/doc.md"
printf '## Keep\n\nfirst\n\n### `[AGENT-PILOT]` - the harness\n\nit measures you\n\n### `[GUEST-DIGEST]` - digests\n\nlast\n' > "$cut"
strip_document_section "$cut" '[AGENT-PILOT]'
check "the pilot section is gone from the document" "$(grep -q 'AGENT-PILOT' "$cut" && echo 1 || echo 0)"
check "the section before it survives" "$(grep -q '^first$' "$cut" && echo 0 || echo 1)"
check "the section after it survives" "$(grep -q '^last$' "$cut" && echo 0 || echo 1)"
check "the heading after it survives" "$(grep -q 'GUEST-DIGEST' "$cut" && echo 0 || echo 1)"

printf '\n%s\n' "agent-pilot-run rubric fence: $failures failure(s)"
[[ $failures -eq 0 ]]
