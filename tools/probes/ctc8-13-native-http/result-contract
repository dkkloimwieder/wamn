#!/usr/bin/env bash
# Exercise the wrapper's exact acceptance filter without transport or Cargo.
set -euo pipefail
[[ $# -eq 1 ]] || { echo 'usage: bash result-contract COMPLETE_STDOUT_JSONL' >&2; exit 2; }
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
filter=$(sed -n '/^  jq -se /,/shape-check.log/p' "$script_dir/run" | sed '1d;$d')
[[ -n "$filter" ]] || { echo 'the result filter is missing' >&2; exit 1; }
for mutation in complete missing duplicate missing_evidence error; do
  expected=1
  case "$mutation" in
    complete) rewrite='.'; expected=0 ;;
    missing) rewrite='.[0:-1]' ;;
    duplicate) rewrite='. + [.[0]]' ;;
    missing_evidence) rewrite='.[1] |= del(.evidence)' ;;
    error) rewrite='.[-1].verdict = "error"' ;;
  esac
  actual=0
  jq -s "$rewrite" "$1" | jq -e "$filter" >/dev/null 2>&1 || actual=1
  [[ "$actual" -eq "$expected" ]] || { echo "result-contract case=$mutation result=failed"; exit 1; }
  printf 'result-contract case=%s result=pass\n' "$mutation"
done
printf 'result-contract result=pass cases=5\n'
