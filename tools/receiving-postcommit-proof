#!/usr/bin/env bash
# Prove unchanged overlay reuse in two independent Receiving installations.
set -euo pipefail

usage() {
  echo 'usage: receiving-postcommit-proof [--apply] --evidence-dir NEW_DIRECTORY' >&2
}
apply=false
evidence_dir=
while (($#)); do
  case "$1" in
    --apply) apply=true; shift ;;
    --evidence-dir)
      [[ $# -ge 2 && -n "$2" ]] || { usage; exit 2; }
      evidence_dir=$2; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done
[[ -n "$evidence_dir" ]] || { usage; exit 2; }
repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd -- "$repo_root"
source_head=$(git rev-parse --verify HEAD)
main_root=$(dirname -- "$(git rev-parse --path-format=absolute --git-common-dir)")
evidence_dir=$(realpath -m -- "$evidence_dir")
evidence_root=$main_root/docs/perf/2026.09/receiving-postcommit
[[ "$evidence_dir" == "$evidence_root/"* && ! -e "$evidence_dir" ]] || {
  echo "Evidence must name a new directory under $evidence_root/" >&2
  exit 2
}
runner=$repo_root/tools/receiving-cluster-journey-run
if [[ "$apply" == false ]]; then
  printf 'Source: %s\n' "$source_head"
  printf 'Run two independent installations, then compare the unchanged overlay artifacts.\n'
  for base in baseline additive; do
    printf '  %q --apply --receiving-postcommit %s --evidence-dir %q\n' \
      "$runner" "$base" "$evidence_dir/$base"
  done
  printf 'Require both post-commit proofs, the ownership refusal, and both resource cleanup results.\n'
  exit 0
fi

ensure_source() {
  [[ $(git rev-parse HEAD) == "$source_head" && -z $(git status --porcelain \
    --untracked-files=normal -- . ':(exclude).beads/issues.jsonl' \
    ':(exclude).beads/interactions.jsonl') ]] || {
    echo 'The proof requires committed source that stays unchanged across both installations.' >&2
    return 1
  }
}
ensure_source
mkdir -- "$evidence_dir"
for base in baseline additive; do
  ensure_source
  printf 'Run the %s installation.\n' "$base"
  if "$runner" --apply --receiving-postcommit "$base" \
      --evidence-dir "$evidence_dir/$base" 2>&1 | tee "$evidence_dir/$base.log"; then
    printf '0\n' >"$evidence_dir/$base.exit-code"
  else
    status=$?
    printf '%s\n' "$status" >"$evidence_dir/$base.exit-code"
    exit "$status"
  fi
  ensure_source
done

python3 - "$evidence_dir" "$source_head" <<'PY'
import json
import re
import sys
from pathlib import Path

root = Path(sys.argv[1])
source = sys.argv[2]
sha256 = re.compile(r"sha256:[0-9a-f]{64}\Z")
namespace = "wamn-receiving-postcommit"

def require(condition, detail):
    if not condition:
        raise SystemExit(detail)

observations = {}
for base in ("baseline", "additive"):
    directory = root / base
    require((root / f"{base}.exit-code").read_text() == "0\n", f"{base} did not exit successfully")
    cleanup = (directory / "cleanup.receipt").read_text().split()
    require([item for item in cleanup if item.startswith("verdict=")] == ["verdict=pass"],
            f"{base} has no exact successful cleanup verdict")
    require([item for item in cleanup if item.startswith("cluster=")] == [f"cluster={namespace}"],
            f"{base} cleanup identifies another cluster")
    expected = f"RECEIVING POSTCOMMIT PASS source={source} namespace={namespace} base={base} cleanup=pass\n"
    require((directory / "postcommit-journey.receipt").read_text() == expected,
            f"{base} has no exact successful proof receipt for this source")
    verdict = json.loads((directory / "verdict.json").read_text())
    require(verdict == {
        "schema": "wamn-receiving-postcommit/v1", "verdict": "pass", "source": source, "base": base,
        "passing_arms": ["unchanged-overlay-routes", "schema-requirements-observed",
                         "duplicate-handler-delivery", "retry-exhaustion-dlq", "independent-event-progress"],
    }, f"{base} did not pass every required proof arm")
    postcommit = json.loads((directory / "postcommit.json").read_text())
    require(postcommit["schema"] == "wamn-receiving-postcommit/v0.1"
            and postcommit["source"] == source and postcommit["verdict"] == "pass"
            and postcommit["cleanup"] == {"lock_released": True, "materializer_restored": True},
            f"{base} post-commit proof lacks a successful result and resource restoration")
    document = json.loads((directory / "overlay-compatibility.json").read_text())
    require(document["case"] == "unchanged-overlay-compatibility" and document["base"] == base
            and document["stage"] == "installed-schema-observed", f"{base} compatibility observation is incomplete")
    schema = document["schema_observation"]
    require(schema["result"] == "satisfied" and all(type(schema[key]) is int and schema[key] > 0
            for key in ("tables", "fields", "constraints")), f"{base} did not execute every schema observation")
    files = document["overlay_files"]
    require(isinstance(files, dict) and "wamn.json" in files and "generated/package-weld.json" in files
            and all(isinstance(value, str) and sha256.fullmatch(value) for value in files.values()),
            f"{base} omitted the immutable overlay file identities")
    for key in ("overlay_component_sha256", "base_initial_migration_sha256", "catalog_sha256"):
        require(isinstance(document[key], str) and sha256.fullmatch(document[key]), f"{base} has invalid {key}")
    require(document["schema_admission_claim"] is False, "A schema observation cannot claim production admission enforcement")
    observations[base] = document

baseline, additive = observations["baseline"], observations["additive"]
for key in ("overlay_files", "overlay_component_sha256", "required_schema_contract"):
    require(baseline[key] == additive[key], f"The overlay changed between installations: {key}")
for key in ("base_initial_migration_sha256", "catalog_sha256"):
    require(baseline[key] != additive[key], f"The additive candidate did not change {key}")
breaking = baseline["breaking"]
require(breaking["cleanup"] == "database-absent" and breaking["overlay_unchanged"] is True,
        "The breaking installation lacks cleanup or unchanged overlay evidence")
require(re.fullmatch(r"receiving_overlay_break_[0-9a-f]{32}", breaking["database"]),
        "The breaking candidate lacks a separate database identity")
require(sha256.fullmatch(breaking["base_initial_migration_sha256"]), "The breaking candidate lacks its migration identity")
require(breaking["refusal"] == {
    "code": "base-definition-mutation-refused", "schema": "receiving", "relation": "purchase_order",
    "definition": "acme_inspection_required", "owner": "wamn_receiving", "partial_overlay_state": False,
}, "The breaking installation did not produce the required ownership refusal")
result = {
    "case": "receiving-postcommit-pair", "result": "pass", "source_commit": source,
    "independent_installations": 2, "overlay_file_count": len(baseline["overlay_files"]),
    "overlay_component_sha256": baseline["overlay_component_sha256"],
    "baseline_catalog_sha256": baseline["catalog_sha256"], "additive_catalog_sha256": additive["catalog_sha256"],
    "breaking_refusal": breaking["refusal"], "cleanup": "pass",
}
(root / "pair.json").write_text(json.dumps(result, indent=2) + "\n")
(root / "pair.receipt").write_text(f"RECEIVING POSTCOMMIT PAIR PASS source={source} installations=2 overlay=unchanged breaking=refused cleanup=pass\n")
PY
if ! ensure_source; then
  rm -- "$evidence_dir/pair.json" "$evidence_dir/pair.receipt"
  exit 1
fi
cat -- "$evidence_dir/pair.receipt"
