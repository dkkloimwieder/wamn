      ["wamn-compiler", "crates/schema/generator"], ["wamn-schema-introspection", "crates/schema/introspection"], ["wamn-runtime", "crates/platform/runtime"],
      ["wamn-ctl", "services/ctl"], ["wamn-receiving-tests", "apps/wamn_receiving/tests"],
      ["wamn-wms-tests", "apps/wamn_wms/tests"] else empty end
    | {name: .[0], id: .[0], manifest_path: ($root + "/" + .[1] + "/Cargo.toml"),
       targets: [{name: (.[0] | gsub("-"; "_")), kind: ["lib"]},
         {name: "migration_policy", kind: ["test"]},
         {name: "apply_package_live", kind: ["test"]},
         {name: "environment_apply_kind", kind: ["test"]},
         {name: "platform_apply_kind", kind: ["test"]},
         {name: "environment_render", kind: ["test"]},
         {name: "platform_render", kind: ["test"]},
         {name: "release_chart_render", kind: ["test"]},
         {name: "native_host", kind: ["test"]}]}]
    | {workspace_root: $root, packages: ., workspace_members: [.[].id],
       resolve: {nodes: [.[] | {id, deps: []}]}}'
elif [[ $1 == test ]]; then
  if [[ " $* " == *' --list '* ]]; then
    for argument in "$@"; do
      case "$argument" in prekind_host::* | plugins::*) printf '%s: test\n' "$argument" ;; esac
    done
    exit 0
  fi
  if [[ $* == *prekind_host::* ]]; then
    [[ $WAMN_HOST_BINARY == "$CARGO_TARGET_DIR/debug/wamn-host" ]]
    [[ $WAMN_FLOW_HTTP_COMPONENT == "$CARGO_TARGET_DIR/wasm32-wasip2/release/http_route.wasm" ]]
    [[ -f $CARGO_TARGET_DIR/wasm32-wasip2/debug/http_request.wasm ]]
  fi
  [[ ${FAKE_CARGO_FAIL_TEST:-false} != true ]] || exit 27
  if [[ $* == *live_derived* ]]; then
    [[ ${WAMN_EVT_NATS_URL:-} == nats://127.0.0.1:44222 ]]
  fi
  for argument in "$@"; do
    case "$argument" in prekind_host::* | plugins::*) printf 'test %s ... ok\n' "$argument" ;; esac
  done
  printf 'test result: ok. 1 passed; 0 failed; 0 ignored;\n'
elif [[ ${FAKE_FAIL_INPUT:-false} == true ]]; then exit 31
fi
FAKE
