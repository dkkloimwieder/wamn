cat > "$fixture/bin/git" <<'FAKE'
#!/usr/bin/env bash
set -euo pipefail
if [[ ${1:-} == -C ]]; then shift 2; fi
case "$*" in
  'rev-parse --show-toplevel') printf '%s\n' "$FAKE_STATE/repo" ;;
  'rev-parse --verify --quiet refs/remotes/origin/main') [[ ${FAKE_NO_ORIGIN:-false} != true ]] ;;
  merge-base*) printf '%s\n' "$*" > "$FAKE_STATE/base"; echo fake-commit ;;
  rev-parse*) echo fake-commit ;;
  diff*) [[ ${FAKE_DIFF_FAIL:-false} != true ]] || exit 23; printf '%s\0' "$FAKE_PATH" ;;
  ls-files*) [[ ${FAKE_LS_FILES_FAIL:-false} != true ]] || exit 24 ;;
  'worktree add --detach '*)
    work=$4
    printf '%s\n' "$work" > "$FAKE_STATE/worktree"
    mkdir -p "$work/tools"
    cp "$FAKE_STATE/revision-test-changes" "$work/tools/test-changes"
    ;;
  'worktree remove --force '*) rm -rf -- "$4" ;;
  'submodule update --init --recursive') printf 'submodules %s\n' "$PWD" >> "$FAKE_STATE/calls" ;;
  *) exit 64 ;;
esac
