# carrying the first one's literals.
jq -e --arg image "$materializer_ref" --arg namespace "$namespace" \
  --arg workload "$app_materializer_workload" --arg tenant "$app_tenant" \
  --arg project "$app_project" --arg environment "$app_environment" \
  --arg org "$app_org" --arg stream "$app_event_stream" '
