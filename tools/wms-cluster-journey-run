# matching work to do. This journey lost that bet once: 8a73233c renamed the
# route test from eleven to thirteen routes and did not sweep this file, so
# every run since executed no route test at all and failed later, at a missing
# artifact, under a message about Secret file modes.
#
# So the count is asserted at the invocation rather than inferred downstream.
assert_one_test_ran() {
  local log=$1 name=$2
  grep -qE '^test result: ok\. 1 passed; 0 failed;' "$log" || {
    echo "cargo test ran no matching test for $name -- an --exact name that does not exist exits 0 having executed nothing" >&2
    grep -E '^(running|test result)' "$log" >&2 || true
