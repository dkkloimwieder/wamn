#!/usr/bin/env python3
"""Prove installed CRDs and operator recovery inside the owned Receiving journey."""

import argparse
import base64
from datetime import datetime
import hashlib
import json
from pathlib import Path
import signal
import subprocess
import time

CONTEXT = "kind-wamn-receiving-journey"
NAMESPACE = "wamn-receiving-journey"
SYSTEM = "wamn-system"
JOB = "receiving-operator-recovery"
REQUEST_ID = "00000000-0000-4000-8000-000000000929"
# Native TTL 60s + periodic reconciliation 60s + heartbeat RPC 5s, plus 25s.
OUTAGE_SECONDS = 150
# Preserve the existing Receiving restart recovery ceiling.
RECOVERY_SECONDS = 120


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def encoded(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()


def digest(value):
    return hashlib.sha256(encoded(value)).hexdigest()


def normalized_crd(spec):
    # Kubernetes defaults these CRD fields. Preserve and compare every other field.
    result = dict(spec)
    result.setdefault("conversion", {"strategy": "None"})
    result.setdefault("preserveUnknownFields", False)
    return result


def ready(value):
    return any(c["type"] == "Ready" and c["status"] == "True"
               for c in value.get("status", {}).get("conditions", []))


def host_ids(items):
    return sorted((h["metadata"]["uid"], h["hostId"]) for h in items)


def pod_ids(items, container):
    result = []
    for pod in items:
        require(not pod["metadata"].get("deletionTimestamp"), "unexpected terminating process")
        statuses = [s for s in pod["status"].get("containerStatuses", []) if s["name"] == container]
        require(len(statuses) == 1 and statuses[0].get("ready"), "process is not ready")
        status = statuses[0]
        result.append((pod["metadata"]["uid"], status["containerID"], status["restartCount"], status["imageID"]))
    return sorted(result)


def classify_sample(line, expected_id):
    _, timestamp, status, curl_exit, content_type, seconds, body_b64 = line.split(" ", 6)
    body = base64.b64decode(body_b64, validate=True).decode()
    sample = dict(timestamp=int(timestamp), status=int(status), curl_exit=int(curl_exit),
                  content_type=content_type, seconds=float(seconds), body=body)
    if sample["status"] == 200 and sample["curl_exit"] == 0:
        value = json.loads(body)
        require(content_type.split(";")[0] == "application/json", "200 response is not JSON")
        require(isinstance(value, list) and len(value) == 1 and
                value[0].get("request_id") == REQUEST_ID and "error" not in value[0] and
                value[0].get("value", {}).get("id") == expected_id,
                "200 response did not return the actual Receiving purchase order")
        sample["result"] = "serving"
    elif sample["curl_exit"] == 0 and sample["status"] in (404, 503) and body == "":
        sample["result"] = "native_404" if sample["status"] == 404 else "native_503"
    elif sample["status"] == 0 and sample["curl_exit"] in (7, 28, 52, 56):
        sample["result"] = "transport_failure"
    else:
        raise RuntimeError(f"unexpected route response: {sample}")
    return sample


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--kubeconfig", required=True, type=Path)
    parser.add_argument("--evidence-dir", required=True, type=Path)
    parser.add_argument("--host-image", required=True)
    parser.add_argument("--route-caller-secret", required=True)
    parser.add_argument("--route-host", required=True)
    parser.add_argument("--probe-route", required=True)
    parser.add_argument("--probe-body", required=True)
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    evidence = args.evidence_dir.resolve()
    require(args.kubeconfig.is_absolute() and args.kubeconfig.is_file(), "use the owner's private kubeconfig")
    require(not evidence.is_relative_to(root), "evidence must remain outside the source tree")
    evidence.mkdir(mode=0o700)
    command_number = 0
    kube = ["kubectl", "--kubeconfig", str(args.kubeconfig), "--context", CONTEXT,
            "--request-timeout=20s"]

    def write(name, value):
        (evidence / name).write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")

    def run(label, arguments, *, timeout=30, input_value=None, tolerate=False):
        nonlocal command_number
        command_number += 1
        stem = f"{command_number:04d}-{label}"
        started = time.time()
        try:
            result = subprocess.run(arguments, input=input_value, capture_output=True, timeout=timeout)
            status, stdout, stderr = result.returncode, result.stdout, result.stderr
        except subprocess.TimeoutExpired as error:
            status, stdout, stderr = 124, error.stdout or b"", error.stderr or b""
        (evidence / f"{stem}.stdout").write_bytes(stdout)
        (evidence / f"{stem}.stderr").write_bytes(stderr)
        with (evidence / "commands.jsonl").open("a") as record:
            record.write(json.dumps(dict(command=arguments, exit_code=status, started=started,
                                         elapsed_seconds=time.time() - started, output_stem=stem)) + "\n")
        require(tolerate or status == 0, f"{label} failed with exit {status}; see {stem}.stderr")
        return stdout

    def get(label, namespace, resource, *extra):
        return json.loads(run(label, kube + ["-n", namespace, "get", resource, *extra, "-o", "json"]))

    require(run("private-context", kube + ["config", "get-contexts", "-o", "name"]).decode().split() == [CONTEXT],
            "kubeconfig must contain only the owned Receiving context")
    require(run("private-cluster", kube + ["config", "view", "--minify", "-o",
                                          "jsonpath={.contexts[0].context.cluster}"]).decode() == CONTEXT,
            "private context must select the owned Receiving cluster")
    source = root / "docs/perf/2026.09/wasmcloud-2-9-cutover"
    inventory = json.loads((source / "deployment-crds-001/crd-inventory.json").read_text())
    chart_identity = json.loads((source / "deployment-crds-001/distributed-chart-identities.json").read_text())["2.9.0"]
    expected = json.loads(run("distributed-crds-client-decode", kube + ["create", "--dry-run=client", "--validate=false", "-f",
                             str(source / "deployment-crds-001/helm-show-crds-2.9.0.stdout"), "-o", "json"]))
    expected = expected["items"]
    names = sorted(inventory["versions"]["2.9.0"])
    require(sorted(c["metadata"]["name"] for c in expected) == names and len(names) == 5,
            "distributed CRD inventory does not contain exactly five expected definitions")
    installed = json.loads(run("installed-crds", kube + ["get", "crd", *names, "-o", "json"]))["items"]
    actual_by_name = {c["metadata"]["name"]: c for c in installed}
    crd_rows = []
    for crd in expected:
        name = crd["metadata"]["name"]
        actual = actual_by_name[name]
        expected_hash = digest(crd["spec"])
        require(expected_hash == inventory["versions"]["2.9.0"][name]["spec_sha256"],
                f"captured distributed CRD source changed: {name}")
        require(normalized_crd(actual["spec"]) == normalized_crd(crd["spec"]),
                f"installed CRD differs from pinned distributed schema: {name}")
        require(all(any(c["type"] == kind and c["status"] == "True"
                        for c in actual["status"]["conditions"]) for kind in ("Established", "NamesAccepted")),
                f"installed CRD is not established: {name}")
        require(actual["status"]["storedVersions"] == ["v1alpha1"], "unexpected CRD storage version")
        crd_rows.append(dict(name=name, kind=crd["spec"]["names"]["kind"], uid=actual["metadata"]["uid"],
                             distributed_spec_sha256=expected_hash, installed_spec_sha256=digest(actual["spec"]),
                             defaulted_spec_sha256=digest(normalized_crd(actual["spec"]))))
    write("installed-crd-identity.json", dict(result="pass", chart=chart_identity, source=inventory["source_commit"],
                                           defaults=["conversion.strategy=None", "preserveUnknownFields=false"], crds=crd_rows))

    operator = get("operator-deployment", SYSTEM, "deployment/runtime-operator")
    nats = get("scheduler-deployment", SYSTEM, "deployment/nats")
    require(operator["spec"]["replicas"] == nats["spec"]["replicas"] == 1, "expected singleton operator and scheduler")
    require(any(c["image"] == "ghcr.io/wasmcloud/runtime-operator:2.9.0" and
                "-nats-url=nats://nats.wamn-system.svc.cluster.local:4222" in c.get("args", [])
                for c in operator["spec"]["template"]["spec"]["containers"]), "unexpected operator source or bus")
    host_deployment = get("host-deployment", NAMESPACE, "deployment/hostgroup-default")
    host_selector = ",".join(f"{k}={v}" for k, v in host_deployment["spec"]["selector"]["matchLabels"].items())
    require(host_selector and host_deployment["spec"]["replicas"] == 3, "expected three Receiving hosts")
    require(any(c["name"] == "host" and c["image"] == args.host_image
                for c in host_deployment["spec"]["template"]["spec"]["containers"]),
            "sampler must reuse the existing Receiving host image")

    def snapshot(label):
        value = dict(hosts=get(label + "-hosts", SYSTEM, "hosts", "-l", "hostgroup=default")["items"],
                     pods=get(label + "-host-pods", NAMESPACE, "pods", "-l", host_selector)["items"],
                     operator_pods=get(label + "-operator-pods", SYSTEM, "pods", "-l", "wasmcloud.com/name=runtime-operator")["items"],
                     endpointslices=get(label + "-endpointslices", NAMESPACE, "endpointslices", "-l",
                                        "kubernetes.io/service-name=flow-http")["items"],
                     workloads=get(label + "-workloads", NAMESPACE, "workloads")["items"])
        write(label + "-state.json", value)
        return value

    before = snapshot("before")
    require(len(before["hosts"]) == len(before["pods"]) == 3 and all(map(ready, before["hosts"])), "initial host fleet is not ready")
    original_hosts, original_pods = host_ids(before["hosts"]), pod_ids(before["pods"], "host")
    original_operator = pod_ids(before["operator_pods"], "runtime-operator")
    require(len(original_operator) == 1, "expected one operator process")
    image_identity = json.loads((source / "deployment-001/distributed-image.json").read_text())
    image_digests = [image_identity["digest"]] + [p["digest"] for p in image_identity["platforms"]
                                               if p["platform"] == {"architecture": "amd64", "os": "linux"}]
    require(any(original_operator[0][3].endswith(d) for d in image_digests), "operator image differs from distributed identity")
    write("operator-image-identity.json", dict(distributed=image_identity, observed=original_operator))

    def continuity(value, same_operator=True):
        require(host_ids(value["hosts"]) == original_hosts, "scheduler outage deleted or replaced a Host object")
        require(pod_ids(value["pods"], "host") == original_pods, "host process changed during operator recovery")
        if same_operator:
            require(pod_ids(value["operator_pods"], "runtime-operator") == original_operator,
                    "operator process changed during the scheduler outage")

    body = json.loads(args.probe_body)
    require(args.probe_route == "/purchase_order/get" and isinstance(body.get("id"), str),
            "use the existing read-only Receiving purchase-order probe")
    request = json.dumps([dict(body, request_id=REQUEST_ID)], separators=(",", ":"))
    script = r'''set -eu
start=$(date +%s)
while [ $(($(date +%s) - start)) -lt 840 ]; do
  : >/tmp/body
  rc=0
  metrics=$(curl --silent --show-error --connect-timeout 2 --max-time 5 \
    --output /tmp/body --write-out '%{http_code} %{content_type} %{time_total}' \
    --header "Host: $ROUTE_HOST" --header 'Content-Type: application/json' \
    --header "Authorization: Bearer $ROUTE_CALLER_PAT" --data "$REQUEST_BODY" "$ENDPOINT") || rc=$?
  status=$(printf '%s' "$metrics" | cut -d' ' -f1)
  ctype=$(printf '%s' "$metrics" | cut -d' ' -f2 | tr -d ' ')
  elapsed=$(printf '%s' "$metrics" | awk '{print $NF}')
  printf 'WAMN_OPERATOR_SAMPLE %s %s %s %s %s %s\n' "$(date +%s)" "${status:-000}" "$rc" "${ctype:--}" "${elapsed:-0}" "$(base64 -w0 </tmp/body)"
  sleep 5
done
'''
    job = dict(apiVersion="batch/v1", kind="Job", metadata=dict(name=JOB, namespace=NAMESPACE),
               spec=dict(activeDeadlineSeconds=900, backoffLimit=0, template=dict(spec=dict(
                   restartPolicy="Never", automountServiceAccountToken=False,
                   containers=[dict(name="probe", image=args.host_image, imagePullPolicy="Never", command=["/bin/sh", "-ec"], args=[script],
                                    env=[dict(name="ROUTE_CALLER_PAT", valueFrom=dict(secretKeyRef=dict(name=args.route_caller_secret, key="token"))),
                                         dict(name="ROUTE_HOST", value=args.route_host), dict(name="REQUEST_BODY", value=request),
                                         dict(name="ENDPOINT", value=f"http://flow-http.{NAMESPACE}.svc.cluster.local{args.probe_route}")])]))))
    write("probe-job.json", job)
    sampler_owned = scheduler_stopped = False
    phases = {}

    def samples():
        raw = run("route-samples", kube + ["-n", NAMESPACE, "logs", f"job/{JOB}", "--pod-running-timeout=60s"], timeout=75)
        parsed = [classify_sample(line, body["id"]) for line in raw.decode().splitlines()
                  if line.startswith("WAMN_OPERATOR_SAMPLE ")]
        write("route-samples.json", parsed)
        return parsed

    def recovered(label, after, same_operator):
        deadline = time.monotonic() + max(0, RECOVERY_SECONDS - (time.time() - after))
        ready_since = None
        while True:
            current = snapshot(label)
            continuity(current, same_operator)
            # A fresh status proves the operator actually hears this fleet again.
            fresh = all(datetime.fromisoformat(h["status"]["lastSeen"].replace("Z", "+00:00")).timestamp() >= after
                        for h in current["hosts"])
            if all(map(ready, current["hosts"])) and fresh:
                ready_since = ready_since or time.time()
            else:
                ready_since = None
            response = samples()
            if ready_since and response and response[-1]["timestamp"] >= ready_since and response[-1]["result"] == "serving":
                elapsed = time.time() - after
                require(elapsed <= RECOVERY_SECONDS, "recovery exceeded the unchanged 120-second ceiling")
                phases[label] = dict(started=after, ready_and_serving_after_seconds=elapsed,
                                     readiness_observed=ready_since, exact_200_after_readiness=response[-1],
                                     workload_uids=sorted(w["metadata"]["uid"] for w in current["workloads"]))
                write("phases.json", phases)
                return current
            require(time.monotonic() < deadline, f"{label} did not recover within 120 seconds")
            time.sleep(5)

    try:
        run("create-sampler", kube + ["create", "-f", str(evidence / "probe-job.json")])
        sampler_owned = True
        recovered("initial", time.time(), True)
        # Establish a full native fleet-witness window before interrupting NATS.
        settling = time.monotonic()
        while time.monotonic() - settling < 75:
            continuity(snapshot("settling"))
            require(samples()[-1]["result"] == "serving", "normal serving failed before the fault")
            time.sleep(5)
        scheduler_stopped = True
        run("stop-scheduler", kube + ["-n", SYSTEM, "scale", "deployment/nats", "--replicas=0"])
        deadline = time.monotonic() + 60
        while get("scheduler-stopping", SYSTEM, "pods", "-l", "wasmcloud.com/name=nats")["items"]:
            require(time.monotonic() < deadline, "scheduler did not stop within 60 seconds")
            time.sleep(2)
        stopped = time.time()
        outage_started = time.monotonic()
        phases["scheduler-stopped"] = dict(started=stopped, required_seconds=OUTAGE_SECONDS)
        write("phases.json", phases)
        guard_hosts = set()
        while time.monotonic() - outage_started < OUTAGE_SECONDS:
            require(not get("scheduler-still-stopped", SYSTEM, "pods", "-l", "wasmcloud.com/name=nats")["items"],
                    "scheduler resumed before the required outage interval ended")
            current = snapshot("scheduler-down")
            continuity(current)
            for host in current["hosts"]:
                if any(c["type"] == "Ready" and c["status"] == "Unknown" and
                       "operator has not been hearing the fleet" in c.get("message", "")
                       for c in host.get("status", {}).get("conditions", [])):
                    guard_hosts.add(host["metadata"]["uid"])
            samples()
            time.sleep(5)
        require(guard_hosts == {uid for uid, _ in original_hosts}, "native fleet-deaf guard was not observed for every Host")
        require(any(s["timestamp"] >= stopped for s in samples()), "no actual request sampled the stopped interval")
        resumed = time.time()
        phases["scheduler-stopped"].update(ended=resumed, actual_seconds=time.monotonic() - outage_started,
                                            fleet_guard_host_uids=sorted(guard_hosts))
        write("phases.json", phases)
        run("restore-scheduler", kube + ["-n", SYSTEM, "scale", "deployment/nats", "--replicas=1"])
        recovered("scheduler-recovery", resumed, True)
        scheduler_stopped = False
        run("scheduler-recovered-operator-log", kube + ["-n", SYSTEM, "logs", "deployment/runtime-operator", "--tail=2000"])
        restarted = time.time()
        run("restart-operator", kube + ["-n", SYSTEM, "rollout", "restart", "deployment/runtime-operator"])
        run("wait-operator", kube + ["-n", SYSTEM, "rollout", "status", "deployment/runtime-operator", "--timeout=100s"], timeout=110)
        after = recovered("operator-restart", restarted, False)
        new_operator = pod_ids(after["operator_pods"], "runtime-operator")
        require(len(new_operator) == 1 and new_operator[0][0] != original_operator[0][0] and
                new_operator[0][3] == original_operator[0][3], "operator process did not restart on the same image")
        final_samples = samples()
        write("route-summary.json", dict(sample_interval_seconds=5,
                                         classifications={kind: sum(s["result"] == kind for s in final_samples)
                                                          for kind in sorted({s["result"] for s in final_samples})},
                                         non_success=[s for s in final_samples if s["result"] != "serving"]))
        verdict = dict(result="pass", context=CONTEXT, scope="shared-scheduler-outage-and-operator-restart",
                                  phases=phases, hosts_preserved=original_hosts, host_processes_preserved=original_pods,
                                  operator_before=original_operator, operator_after=new_operator,
                                  before_workload_uids=sorted(w["metadata"]["uid"] for w in before["workloads"]),
                                  after_workload_uids=sorted(w["metadata"]["uid"] for w in after["workloads"]))
    finally:
        cleanup_errors = []
        if scheduler_stopped:
            try:
                run("restore-scheduler-after-failure", kube + ["-n", SYSTEM, "scale", "deployment/nats", "--replicas=1"])
            except RuntimeError as error:
                cleanup_errors.append(str(error))
        if sampler_owned:
            run("final-sampler-log", kube + ["-n", NAMESPACE, "logs", f"job/{JOB}"], tolerate=True)
            try:
                run("delete-sampler", kube + ["-n", NAMESPACE, "delete", f"job/{JOB}", "--wait=true", "--timeout=30s"], timeout=40)
            except RuntimeError as error:
                cleanup_errors.append(str(error))
        run("final-operator-log", kube + ["-n", SYSTEM, "logs", "deployment/runtime-operator", "--tail=2000"], tolerate=True)
        write("cleanup.json", dict(result="pass" if not cleanup_errors else "fail", errors=cleanup_errors))
        require(not cleanup_errors, "operator proof cleanup failed")
    write("result.json", verdict)
    with (evidence / "evidence.sha256").open("w") as hashes:
        for path in sorted(evidence.iterdir()):
            if path.is_file() and path.name != "evidence.sha256":
                hashes.write(f"{hashlib.sha256(path.read_bytes()).hexdigest()}  {path.relative_to(evidence.parent)}\n")


def interrupted(signum, _frame):
    raise RuntimeError(f"operator proof interrupted by signal {signum}")


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGINT, interrupted)
    main()
