#!/usr/bin/env bash
# Existing app fixtures own the stores, release publish, assertions, and cleanup.
set -euo pipefail
umask 077
action=${1:?build-native, receiving, wms, or remove-kept}
repository=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if [[ $action == build-native ]]; then
  target=${2:?absolute native target directory}
  [[ $target == /* ]] || { printf 'The native target directory must be absolute.\n' >&2; exit 64; }
  mkdir -p -- "$target"
  target=$(cd -- "$target" && pwd -P)
  cd "$repository"
  # One feature graph for candidate creation and qualification. Keep debug lines,
  # but remove the output directory from Rust and C compilation paths.
  flags=$'-C\x1flink-arg=-fuse-ld=mold\x1f--remap-path-prefix='"$target=/wamn-build"
  exec env -i PATH="$PATH" HOME="$HOME" \
    CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}" \
    LANG=C LC_ALL=C TZ=UTC SOURCE_DATE_EPOCH=0 \
    CARGO_INCREMENTAL=0 CARGO_BUILD_JOBS=2 SQLX_OFFLINE=true \
    CARGO_ENCODED_RUSTFLAGS="$flags" CC=clang CXX=clang++ \
    CFLAGS="-ffile-prefix-map=$target=/wamn-build" \
    CXXFLAGS="-ffile-prefix-map=$target=/wamn-build" \
    cargo build --locked --offline --profile dev --bins --target-dir "$target" \
      -p wamn-host -p wamn-ctl -p wamn-identity -p wamn-cdc-reader -p wamn-scenario-worker
fi
# The delivery cases run on one kept cluster that WAMN_DELIVERY_CLUSTER names
# (docs/operations/cluster-tests.md). Receiving first, then WMS, which checks
# the two applications side by side.
if [[ $action == receiving || $action == wms ]]; then
  # An optional existing parent directory for the test result directory.
  if [[ -n ${2:-} ]]; then parent=$(cd -- "$2" && pwd); export "WAMN_${action^^}_EVIDENCE_DIR=$parent"; fi
  [[ -z ${WAMN_DELIVERY_CANDIDATE:-} ]] || { printf 'The owned setup mints its own candidate.\n' >&2; exit 64; }
  cd "$repository"
  if [[ $action == receiving ]]; then
    exec "$repository/tools/require-test-result" cargo test --locked --offline -p wamn-receiving-tests --features cluster --test cluster \
      route_authentication_live::cluster::delivery_case::owned_release_delivery \
      -- --exact --ignored --nocapture
  fi
  exec "$repository/tools/require-test-result" cargo test --locked --offline -p wamn-wms-tests --features cluster --test cluster \
    cluster::delivery_case::owned_release_delivery -- --exact --ignored --nocapture
fi
if [[ $action == remove-kept ]]; then
  cd "$repository"
  exec cargo run --locked --offline -p wamn-test-infrastructure --bin wamn-test-cluster -- "${2:?kept delivery cluster name}"
fi
printf 'Unknown owned delivery action: %s\n' "$action" >&2
exit 64
