#!/usr/bin/env bash
# Native artifact builds.
set -euo pipefail
umask 077
action=${1:?build-native}
repository=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if [[ $action == build-native ]]; then
  target=${2:?absolute native target directory}
  [[ $target == /* ]] || { printf 'The native target directory must be absolute.\n' >&2; exit 64; }
  mkdir -p -- "$target"
  target=$(cd -- "$target" && pwd -P)
  cd "$repository"
  # One feature graph for native artifacts. Keep debug lines,
  # but remove the output directory from Rust and C compilation paths.
  flags=$'-C\x1flink-arg=-fuse-ld=mold\x1f--remap-path-prefix='"$target=/wamn-build"
  exec env -i PATH="$PATH" HOME="$HOME" \
    CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}" \
    LANG=C LC_ALL=C TZ=UTC SOURCE_DATE_EPOCH=0 \
    CARGO_INCREMENTAL=0 CARGO_BUILD_JOBS=2 SQLX_OFFLINE=true \
    CARGO_ENCODED_RUSTFLAGS="$flags" CC=clang CXX=clang++ \
    CFLAGS="-ffile-prefix-map=$target=/wamn-build" \
    CXXFLAGS="-ffile-prefix-map=$target=/wamn-build" \
    cargo build --locked --offline --profile dev --bins --target-dir "$target" \
      -p wamn-host -p wamn-ctl -p wamn-identity -p wamn-cdc-reader -p wamn-scenario-worker
fi
printf 'Unknown owned delivery action: %s\n' "$action" >&2
exit 64
