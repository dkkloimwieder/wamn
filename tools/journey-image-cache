#!/usr/bin/env bash
# Reuse cluster journey images across runs by the source they were built from.
#
# A journey used to tag its images with its own random cluster name, so two
# runs of the same source never found each other's images, and teardown deleted
# them. This names the image by the source it contains instead, keeps it after
# the run, and gives the run its own tag by relabeling (wamn-szr0).
#
# The identity is the hash of the HEAD tree entries that the Dockerfile copies.
# Two commits that change only an uncopied path share one identity, which is
# the point: the image is the same. The per-run tag still carries the run's own
# HEAD in wamn.dev/source-head, because that is what the loaded-image checks
# read.

set -euo pipefail

# Every path the root Dockerfile copies, plus the build definition itself.
readonly COPIED=(
  Dockerfile
  .dockerignore
  Cargo.toml
  Cargo.lock
  .cargo/config.toml
  crates
  apps
  services
  test-support
  tests
  deploy
)

# Identities kept per image repository, newest use first.
readonly RETAINED=3

docker_executable=${DOCKER:-docker}

state_root() {
  printf '%s/wamn-journey-images' "${XDG_CACHE_HOME:-$HOME/.cache}"
}

usage() {
  cat >&2 <<'EOF'
usage: journey-image-cache ACTION [arguments]
  identity REPOSITORY
      Print the source identity of REPOSITORY at HEAD.
  ensure REPOSITORY TARGET NAME HEAD TAG CLUSTER
      Build wamn-NAME for the Docker stage TARGET if no image of this identity
      exists, then relabel it to wamn-NAME:TAG carrying source-head=HEAD, and
      lease the identity for CLUSTER.
  release CLUSTER
      Drop every identity lease that CLUSTER holds.
  retain NAME
      Remove all but the newest retained identities of wamn-NAME. An identity
      under lease is never removed.
EOF
}

identity() {
  local repository=$1 path object
  git -C "$repository" rev-parse --verify --quiet HEAD >/dev/null ||
    { printf 'the repository has no HEAD commit\n' >&2; exit 64; }
  {
    for path in "${COPIED[@]}"; do
      object=$(git -C "$repository" rev-parse --verify --quiet "HEAD:$path") ||
        { printf 'HEAD does not carry the copied path %s\n' "$path" >&2; exit 64; }
      printf '%s %s\n' "$path" "$object"
    done
  } | sha256sum | cut -c1-16
}

# Docker cannot change the labels of an existing image, and the loaded-image
# checks compare source-head to the run's own commit. One FROM plus LABEL adds
# metadata and no layer, so the gates layer comparison still holds.
relabel() {
  local from=$1 to=$2 head=$3 directory
  directory=$(mktemp -d)
  printf 'FROM %s\nLABEL wamn.dev/source-head="%s" wamn.dev/build-profile="release"\n' \
    "$from" "$head" >"$directory/Dockerfile"
  "$docker_executable" build --platform=linux/amd64 --provenance=false --tag "$to" "$directory" >&2
  rm -rf "$directory"
}

ensure() {
  local repository=$1 target=$2 name=$3 head=$4 tag=$5 cluster=$6
  local source_identity image used leases
  source_identity=$(identity "$repository")
  image="wamn-$name:src-$source_identity"
  if ! "$docker_executable" image inspect "$image" >/dev/null 2>&1; then
    "$docker_executable" build --platform=linux/amd64 --provenance=false \
      --file "$repository/Dockerfile" --target "$target" --tag "$image" \
      --label "wamn.dev/source-identity=$source_identity" \
      --label wamn.dev/build-profile=release "$repository" >&2
  fi
  used=$(state_root)/used/$name
  leases=$(state_root)/leases/$name
  mkdir -p "$used" "$leases"
  # The retention order is last use, not build time, so an identity that every
  # run keeps reaching for outlives one built after it and never used again.
  : >"$used/$source_identity"
  : >"$leases/$source_identity--$cluster"
  relabel "$image" "wamn-$name:$tag" "$head"
  printf '%s\n' "$image"
}

release() {
  local cluster=$1 lease
  shopt -s nullglob
  for lease in "$(state_root)"/leases/*/*--"$cluster"; do
    rm -f "$lease"
  done
}

retain() {
  local name=$1 used leases identity_name kept=0 lease
  used=$(state_root)/used/$name
  leases=$(state_root)/leases/$name
  [[ -d $used ]] || return 0
  shopt -s nullglob
  # Newest use first: keep the first RETAINED, then remove the rest.
  while IFS= read -r identity_name; do
    [[ -n $identity_name ]] || continue
    if ((kept < RETAINED)); then
      kept=$((kept + 1))
      continue
    fi
    local held=false
    for lease in "$leases/$identity_name"--*; do
      held=true
      printf 'keeping wamn-%s:src-%s: %s still holds it\n' \
        "$name" "$identity_name" "${lease##*--}" >&2
      break
    done
    if [[ $held == true ]]; then
      continue
    fi
    if "$docker_executable" image inspect "wamn-$name:src-$identity_name" >/dev/null 2>&1; then
      "$docker_executable" image rm "wamn-$name:src-$identity_name" >&2 || true
    fi
    rm -f "$used/$identity_name"
  done < <(ls -1t "$used" 2>/dev/null)
}

case "${1-}" in
  identity) identity "${2:?repository}" ;;
  ensure)
    ensure "${2:?repository}" "${3:?docker target}" "${4:?image name}" \
      "${5:?source head}" "${6:?per-run tag}" "${7:?cluster}"
    ;;
  release) release "${2:?cluster}" ;;
  retain) retain "${2:?image name}" ;;
  --help | -h) usage; exit 0 ;;
  *) usage; exit 2 ;;
esac
