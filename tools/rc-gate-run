#!/usr/bin/env bash
# Explicit kind, Helm and Docker lifecycle actions for the Rust RC caller.
set -euo pipefail
case "${2-}" in wamn) printf 'The kind-wamn cluster is frozen.\n' >&2; exit 64 ;; esac
case "${1-}" in
  docker-version) docker version >/dev/null ;;
  clusters) kind get clusters ;;
  containers) docker ps --all --format '{{.Names}}' ;;
  images) docker images --format '{{.Repository}}:{{.Tag}}' ;;
  build-images)
    repository=$2; source_head=$3; host_image=$4; gates_image=$5; postgres_image=$6
    docker build --platform=linux/amd64 --provenance=false --target gates \
      --build-arg "SOURCE_HEAD=$source_head" --file "$repository/tests/integration/src/rc/Dockerfile" --tag "$gates_image" "$repository"
    docker build --platform=linux/amd64 --provenance=false --target host \
      --build-arg "SOURCE_HEAD=$source_head" --file "$repository/tests/integration/src/rc/Dockerfile" --tag "$host_image" "$repository"
    docker build --platform=linux/amd64 --provenance=false \
      --file "$repository/deploy/gates/m1-postgres.Dockerfile" --tag "$postgres_image" "$repository/deploy/gates"
    ;;
  create)
    cluster=$2; work=$3; host_image=$4; gates_image=$5; postgres_image=$6
    kind create cluster --name "$cluster" --config "$work/kind.yaml" --kubeconfig "$work/kubeconfig"
    kind load docker-image "$gates_image" --name "$cluster"
    kind load docker-image "$host_image" --name "$cluster"
    docker run --detach --name "$cluster-postgres" --network kind \
      --publish 127.0.0.1::5432 --env POSTGRES_HOST_AUTH_METHOD=trust "$postgres_image"
    docker run --detach --name "$cluster-nats" --network kind \
      --volume "$work/event-nats/nats.conf:/etc/nats/event-nats.conf:ro" \
      nats:2.10-alpine --config /etc/nats/event-nats.conf --jetstream --store_dir /data
    ;;
  inspect) docker inspect --format '{{json .NetworkSettings}}' "$2" ;;
  image-labels) docker image inspect --format '{{json .Config.Labels}}' "$2" ;;
  nodes) kind get nodes --name "$2" ;;
  node-image) docker exec "$2" crictl inspecti -o json "$3" ;;
  install-operator)
    cluster=$2; work=$3; values=$4
    helm upgrade --install --create-namespace --kubeconfig "$work/kubeconfig" --kube-context "kind-$cluster" \
      --namespace wamn-system wamn oci://ghcr.io/wasmcloud/charts/runtime-operator --version 2.9.0 \
      -f "$work/operator-base.yaml" -f "$values" --wait --timeout 5m
    ;;
  install-host)
    cluster=$2; work=$3; namespace=$4; values=$5
    helm upgrade --install --kubeconfig "$work/kubeconfig" --kube-context "kind-$cluster" \
      --namespace "$namespace" wamn-host oci://ghcr.io/wasmcloud/charts/runtime-operator --version 2.9.0 \
      -f "$values" --wait --timeout 5m
    ;;
  helm-releases) helm list --kubeconfig "$3/kubeconfig" --kube-context "kind-$2" --all-namespaces -o json ;;
  remove)
    cluster=$2; work=$3; shift 3
    status=0
    KUBECONFIG="$work/kubeconfig" kind delete cluster --name "$cluster" || status=1
    for container in "$cluster-postgres" "$cluster-nats"; do
      if docker container inspect "$container" >/dev/null 2>&1; then docker rm --force "$container" >/dev/null || status=1; fi
    done
    for image in "$@"; do
      if docker image inspect "$image" >/dev/null 2>&1; then docker image rm "$image" >/dev/null || status=1; fi
    done
    exit "$status"
    ;;
  --help|-h) printf '%s\n' 'RC lifecycle actions: build-images, create, install-operator, install-host, inspect, image-labels, nodes, node-image, helm-releases, remove.' ;;
  *) printf '%s\n' 'Use wamn-gates rc for the RC test run.' >&2; exit 2 ;;
esac
