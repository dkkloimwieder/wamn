#!/usr/bin/env bash
# Proof for the --replay and --placement verbs of tools/agent-pilot-grade.
# wamn-nvbd.10 and wamn-nvbd.11.
#
# No environment: no host, no database, no agent. The fixture is a synthetic
# recorded run directory, built from scratch so every condition can be
# violated on its own, which is the only way to know each one is load-bearing.
set -euo pipefail

repo_root=${1:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}
GRADE="$repo_root/tools/agent-pilot-grade"
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
failures=0

check() {
  if [[ $2 -eq 0 ]]; then printf '  ok    %s\n' "$1"
  else printf '  FAIL  %s\n' "$1"; failures=$((failures + 1)); fi
}

# A recorded run, rebuilt for each case. Four step kinds are represented,
# because each one takes a different path through the replay.
fixture() { # <dir>
  local d=$1
  rm -rf "$d"; mkdir -p "$d/grade" "$d/worktree/packages/dock"

  cat > "$d/task.json" <<'JSON'
{"task":"proof","identity":{"route_host":"proof.localhost"},"overlay_root":"packages/dock",
 "grade":{"steps":"steps.json","checks":["claim-replay"],"fence_reports":[]}}
JSON
  cat > "$d/run.json" <<'JSON'
{"commit":"0000000000000000000000000000000000000000","git":{"outside_allowed_paths":[]}}
JSON
  echo '{"name":"dock"}' > "$d/worktree/packages/dock/wamn.json"

  cat > "$d/steps.json" <<'JSON'
[
 {"id":"create","must":true,"route":{"operation":"dock.create"},
  "expect":{"status":200,"item":"value","present":["dock_id"]}},
 {"id":"book","must":true,"route":{"operation":"appointment.book"},
  "reuse":{"dock_id":"create.value.dock_id"},
  "expect":{"status":200,"item":"value","present":["appointment_id"]}},
 {"id":"book-replay","must":true,"proves":"claim-replay","route":{"operation":"appointment.book"},
  "expect":{"status":200,"item":"value","equals":{"appointment_id":"book.value.appointment_id"}}},
 {"id":"refused","must":true,"route":{"operation":"appointment.book"},
  "expect":{"status":200,"item":"error","error_code":"slot_unavailable"}},
 {"id":"exactly-one","must":true,"concurrent":["book","refused"],
  "expect":{"exactly_one":{"error_code":"slot_unavailable"}}},
 {"id":"count-rows","must":true,"sql":"select 1","expect":{"rows":"2"}}
]
JSON

  # The loop log the run wrote. Twelve stages and a served release.
  {
    echo "run completed: Migrate,Introspect,Generate,Build,Virtualize,Apply,Acl,Admit,Gate,Publish,Release,Activate"
    echo "run served: http://127.0.0.1:18080 host=proof.localhost"
    echo "run holding"
  } > "$d/grade/dev.out"

  # The requests and responses the run recorded, one line per step.
  python3 - "$d" <<'PY'
import json, sys
d = sys.argv[1]
D = "11111111-1111-1111-1111-111111111111"
A = "22222222-2222-2222-2222-222222222222"
def ok(v):  return json.dumps([{"request_id": "x", "value": v}])
def err(c): return json.dumps([{"request_id": "x", "error": {"code": c}}])
rows = [
    ("create",      "/dock/create",       ok({"dock_id": D})),
    ("book",        "/appointment/book",  ok({"appointment_id": A})),
    ("book-replay", "/appointment/book",  ok({"appointment_id": A})),
    ("refused",     "/appointment/book",  err("slot_unavailable")),
]
with open(d + "/grade/http.jsonl", "w") as f:
    for sid, path, payload in rows:
        f.write(json.dumps({"id": sid, "path": path, "request": {},
                            "status": "200", "response": payload}) + "\n")
    f.write(json.dumps({"id": "count-rows", "sql": "select 1", "rows": "2"}) + "\n")
PY

  # The two arms of the contended pair, as the run left them.
  echo '[{"value":{"appointment_id":"2222"}}]' > "$d/grade/exactly-one-book.out"
  echo '[{"error":{"code":"slot_unavailable"}}]' > "$d/grade/exactly-one-refused.out"

  echo '[]' > "$d/grade/results.json"
  echo '{"teardown":{"verification_database_removed":true},"outcome":"PASS"}' > "$d/checklist.json"
}

verdict() { # <dir> <step id> -> true|false
  jq -r --arg id "$2" '.steps[] | select(.id == $id) | .pass' "$1/checklist-replay.json"
}
evidence() { jq -r --arg id "$2" '.steps[] | select(.id == $id) | .evidence' "$1/checklist-replay.json"; }

d="$work/run"

# 1. A recorded directory grades end to end with nothing running.
fixture "$d"
"$GRADE" --replay "$d" > "$work/1.log" 2>&1 && rc=0 || rc=$?
check "a recorded run grades with no environment (exit 0)" "$rc"
check "the outcome is PASS" "$([[ "$(jq -r .outcome "$d/checklist-replay.json")" == PASS ]] && echo 0 || echo 1)"
check "the loop verdict comes from the recorded log" \
  "$([[ "$(jq -r '.loop.pass, .loop.stages' "$d/checklist-replay.json" | tr '\n' ' ')" == "true 12 " ]] && echo 0 || echo 1)"
check "claim-replay is scored from what a step declares it proves" \
  "$([[ "$(jq -r '.checks["claim-replay"]' "$d/checklist-replay.json")" == pass ]] && echo 0 || echo 1)"

# 2. The record is not touched. This is the defect that destroyed three runs.
fixture "$d"
http_before=$(sha256sum "$d/grade/http.jsonl" | cut -d' ' -f1)
list_before=$(sha256sum "$d/grade/results.json" | cut -d' ' -f1)
book_before=$(sha256sum "$d/checklist.json" | cut -d' ' -f1)
"$GRADE" --replay "$d" > /dev/null 2>&1 || true
check "a replay leaves grade/http.jsonl byte-identical" \
  "$([[ "$(sha256sum "$d/grade/http.jsonl" | cut -d' ' -f1)" == "$http_before" ]] && echo 0 || echo 1)"
check "a replay leaves grade/results.json byte-identical" \
  "$([[ "$(sha256sum "$d/grade/results.json" | cut -d' ' -f1)" == "$list_before" ]] && echo 0 || echo 1)"
check "a replay leaves the recorded checklist.json byte-identical" \
  "$([[ "$(sha256sum "$d/checklist.json" | cut -d' ' -f1)" == "$book_before" ]] && echo 0 || echo 1)"
check "a replay writes checklist-replay.json instead" "$([[ -s "$d/checklist-replay.json" ]] && echo 0 || echo 1)"

# 3. A route step is scored from the recorded response, not from anything else.
fixture "$d"
python3 - "$d" <<'PY'
import json, sys
p = sys.argv[1] + "/grade/http.jsonl"
out = []
for line in open(p):
    r = json.loads(line)
    if r["id"] == "book-replay":
        r["response"] = json.dumps([{"request_id": "x",
            "value": {"appointment_id": "33333333-3333-3333-3333-333333333333"}}])
    out.append(json.dumps(r))
open(p, "w").write("\n".join(out) + "\n")
PY
"$GRADE" --replay "$d" > /dev/null 2>&1 || true
check "a changed recorded response changes the step verdict" \
  "$([[ "$(verdict "$d" book-replay)" == false ]] && echo 0 || echo 1)"
check "and the check that reads it turns over with it" \
  "$([[ "$(jq -r '.checks["claim-replay"]' "$d/checklist-replay.json")" == fail ]] && echo 0 || echo 1)"

# 4. A step with no recorded response is reported, never passed.
fixture "$d"
grep -v '"id": "book-replay"' "$d/grade/http.jsonl" > "$d/grade/t" && mv "$d/grade/t" "$d/grade/http.jsonl"
"$GRADE" --replay "$d" > /dev/null 2>&1 || true
check "a step the run never recorded fails" "$([[ "$(verdict "$d" book-replay)" == false ]] && echo 0 || echo 1)"
check "and says so rather than blaming the response" \
  "$([[ "$(evidence "$d" book-replay)" == "not replayable"* ]] && echo 0 || echo 1)"

# 5. The contended pair is scored from the recorded arms.
fixture "$d"
echo '[{"value":{"appointment_id":"4444"}}]' > "$d/grade/exactly-one-refused.out"
"$GRADE" --replay "$d" > /dev/null 2>&1 || true
check "a contended pair with no refusal fails on the recorded arms" \
  "$([[ "$(verdict "$d" exactly-one)" == false ]] && echo 0 || echo 1)"

# 6. The sql step is scored from the row count the run recorded.
fixture "$d"
python3 - "$d" <<'PY'
import json, sys
p = sys.argv[1] + "/grade/http.jsonl"
out = []
for line in open(p):
    r = json.loads(line)
    if r["id"] == "count-rows":
        r["rows"] = "5"
    out.append(json.dumps(r))
open(p, "w").write("\n".join(out) + "\n")
PY
"$GRADE" --replay "$d" > /dev/null 2>&1 || true
check "a changed recorded row count changes the sql verdict" \
  "$([[ "$(verdict "$d" count-rows)" == false ]] && echo 0 || echo 1)"

# 7. A loop that served nothing skips the steps, exactly as the live grade does.
fixture "$d"
sed -i 's/^run served: .*$//' "$d/grade/dev.out"
"$GRADE" --replay "$d" > /dev/null 2>&1 && rc=0 || rc=$?
check "a run that served no release grades FAIL" "$([[ $rc -eq 30 ]] && echo 0 || echo 1)"
check "and every step says the loop served no release" \
  "$([[ "$(evidence "$d" create)" == "not run: the loop served no release" ]] && echo 0 || echo 1)"

# 8. The stage count is read, not assumed. A run that served a release but
# stopped short of twelve stages still fails the loop, and its steps are not
# graded from the record as though the loop had passed.
fixture "$d"
sed -i 's/^run completed: .*$/run completed: Migrate,Introspect,Generate,Build,Virtualize,Apply,Acl,Admit,Gate,Publish,Release/' "$d/grade/dev.out"
"$GRADE" --replay "$d" > /dev/null 2>&1 && rc=0 || rc=$?
check "eleven stages with a served release still fails the loop" \
  "$([[ "$(jq -r '.loop.pass, .loop.stages' "$d/checklist-replay.json" | tr '\n' ' ')" == "false 11 " ]] && echo 0 || echo 1)"
check "and the run grades FAIL rather than scoring the record" \
  "$([[ $rc -eq 30 && "$(jq -r .outcome "$d/checklist-replay.json")" == FAIL* ]] && echo 0 || echo 1)"

# ---------------------------------------------------------------------------
# PLACEMENT. The grader places the fixture's values at the paths the package
# published, exactly as it resolves a route path from the package's own
# attachments. Two legal authoring choices publish two shapes, so both are
# built here and neither is the grader's default.
# ---------------------------------------------------------------------------

# A package tree carrying published contracts and nothing else. Placement reads
# the contracts and the fixture, so this needs no responses and no release.
placement_fixture() { # <dir>
  local d=$1
  rm -rf "$d"; mkdir -p "$d/grade" "$d/worktree/packages/dock/generated/contracts"

  cat > "$d/task.json" <<'JSON'
{"task":"placement","identity":{"route_host":"proof.localhost"},"overlay_root":"packages/dock",
 "grade":{"steps":"steps.json","checks":[],"fence_reports":[]}}
JSON
  echo '{"commit":"0000000000000000000000000000000000000000"}' > "$d/run.json"
  echo '{"name":"dock"}' > "$d/worktree/packages/dock/wamn.json"
}

# One published contract pair for one operation.
contract() { # <dir> <domain> <action> <input json> <result json>
  local root="$1/worktree/packages/dock/generated/contracts/$2"
  mkdir -p "$root"
  printf '%s' "$4" > "$root/$3.input.json"
  printf '%s' "$5" > "$root/$3.result.json"
}

# The custom-command shape: dotted paths, nested under a value object.
NESTED_CREATE='{"fields":[{"path":"request_id","type":"text","nullable":false},
  {"path":"value.idempotency_key","type":"text","nullable":false},
  {"path":"value.name","type":"text","nullable":false}]}'
NESTED_CREATE_RESULT='{"class":"one","fields":[{"path":"carrier_id","type":"uuid","nullable":false}]}'

# The same operation authored flat. Legal, and a different wire body.
FLAT_CREATE='{"fields":[{"path":"request_id","type":"text","nullable":false},
  {"path":"idempotency_key","type":"text","nullable":false},
  {"path":"name","type":"text","nullable":false}]}'

# The model CRUD shape. It lists no fields array at all: the envelope keys are
# top-level members carrying a type and a required flag, and the domain fields
# it accepts are named in writable_fields.
CRUD_CREATE='{"request_id":{"type":"string","required":true},
  "idempotency_key":{"type":"text","required":true},
  "canonical_command":{"over":"writable_fields","payload":"canonical_compact_json","changed":"idempotency_conflict"},
  "server_owned_fields":{"fields":["id","row_version"],"if_supplied":"invalid_input"},
  "writable_fields":[{"field":"name","type":"text","omitted":"postgres_default","explicit_null":"invalid_input"}]}'

# A projection. It declares no idempotency key, so the grader supplies none.
FLAT_QUERY='{"fields":[{"path":"request_id","type":"text","nullable":false},
  {"path":"dock_id","type":"uuid","nullable":false},
  {"path":"day","type":"text","nullable":false}]}'
NESTED_QUERY_RESULT='{"class":"one","fields":[{"path":"dock_id","type":"uuid","nullable":false},
  {"path":"appointments[].appointment_id","type":"uuid","nullable":false},
  {"path":"appointments[].slot_start","type":"timestamptz","nullable":false}]}'

one_create_step() { # <dir>
  cat > "$1/steps.json" <<'JSON'
[{"id":"create-carrier","must":true,"invariant":"DOCK-0","route":{"operation":"carrier.create"},
  "body":{"name":"Northbound Freight"},
  "expect":{"status":200,"item":"value","present":["carrier_id"]}}]
JSON
}

placed() { # <dir> <step id> -> the body the grader would send
  "$GRADE" --placement "$1" 2>/dev/null | jq -c --arg id "$2" 'select(.id == $id) | .body // empty'
}
refusal() { "$GRADE" --placement "$1" 2>/dev/null | jq -r --arg id "$2" 'select(.id == $id) | .evidence'; }

p="$work/place"

# 9. The nested shape. The fixture's flat body reaches value.name, and both
# envelope fields reach the paths the contract declares for them.
placement_fixture "$p"; one_create_step "$p"
contract "$p" carrier create "$NESTED_CREATE" "$NESTED_CREATE_RESULT"
check "a nested contract puts the fixture value at value.name" \
  "$([[ "$(placed "$p" create-carrier | jq -r '.value.name')" == "Northbound Freight" ]] && echo 0 || echo 1)"
check "and request_id where the nested contract declares it" \
  "$([[ "$(placed "$p" create-carrier | jq -r '.request_id')" == "create-carrier" ]] && echo 0 || echo 1)"
check "and the idempotency key the platform owns at value.idempotency_key" \
  "$([[ "$(placed "$p" create-carrier | jq -r '.value.idempotency_key')" != "null" ]] && echo 0 || echo 1)"
check "and nothing at the top level the contract did not declare" \
  "$([[ "$(placed "$p" create-carrier | jq -r '[keys[]] | join(",")')" == "request_id,value" ]] && echo 0 || echo 1)"

# 10. The same fixture, the same step, a flat contract. THIS IS THE CASE A
# FLAT-ONLY GRADER PASSES AND A NESTED-ONLY GRADER FAILS, and the pair is the
# whole point: neither shape is the grader's default.
placement_fixture "$p"; one_create_step "$p"
contract "$p" carrier create "$FLAT_CREATE" "$NESTED_CREATE_RESULT"
check "a flat contract puts the same fixture value at the top level" \
  "$([[ "$(placed "$p" create-carrier | jq -r '.name')" == "Northbound Freight" ]] && echo 0 || echo 1)"
check "and the idempotency key beside it" \
  "$([[ "$(placed "$p" create-carrier | jq -r '.idempotency_key')" != "null" ]] && echo 0 || echo 1)"

# 11. The model CRUD shape, which lists no fields array at all.
placement_fixture "$p"; one_create_step "$p"
contract "$p" carrier create "$CRUD_CREATE" "$NESTED_CREATE_RESULT"
check "a writable_fields contract places the value at the writable field" \
  "$([[ "$(placed "$p" create-carrier | jq -r '.name')" == "Northbound Freight" ]] && echo 0 || echo 1)"
check "and supplies the idempotency key it declares" \
  "$([[ "$(placed "$p" create-carrier | jq -r '.idempotency_key')" != "null" ]] && echo 0 || echo 1)"
check "and sends nothing for server_owned_fields or canonical_command" \
  "$([[ "$(placed "$p" create-carrier | jq -r '[keys[]] | sort | join(",")')" == "idempotency_key,name,request_id" ]] && echo 0 || echo 1)"

# 12. A projection declares no idempotency key, so the grader supplies none.
placement_fixture "$p"
cat > "$p/steps.json" <<'JSON'
[{"id":"list","must":true,"invariant":"DOCK-6","route":{"operation":"appointment.query"},
  "body":{"day":"2026-10-01"},"reuse":{"dock_id":"create-dock.value.dock_id"},
  "expect":{"status":200,"item":"value","sorted_by":{"path":"appointments","field":"slot_start"}}}]
JSON
contract "$p" appointment query "$FLAT_QUERY" "$NESTED_QUERY_RESULT"
check "a projection is sent no idempotency key" \
  "$([[ "$(placed "$p" list | jq -r 'has("idempotency_key")')" == false ]] && echo 0 || echo 1)"

# 13. A fixture that names its own key keeps it. A replay case and a
# changed-body case reuse the first call's key on purpose.
placement_fixture "$p"
cat > "$p/steps.json" <<'JSON'
[{"id":"book-replay","must":true,"invariant":"DOCK-2","route":{"operation":"carrier.create"},
  "body":{"name":"Northbound Freight","idempotency_key":"dock-gate-book-1"},
  "expect":{"status":200,"item":"value","present":["carrier_id"]}}]
JSON
contract "$p" carrier create "$NESTED_CREATE" "$NESTED_CREATE_RESULT"
check "a fixture that names its own idempotency key keeps it" \
  "$([[ "$(placed "$p" book-replay | jq -r '.value.idempotency_key')" == "dock-gate-book-1" ]] && echo 0 || echo 1)"

# 14. A field the contract does not declare fails the step, and the line names
# the field, the operation and every path the contract does declare. A reader
# of the checklist alone can fix the fixture from it.
placement_fixture "$p"; one_create_step "$p"
contract "$p" carrier create \
  '{"fields":[{"path":"request_id","type":"text","nullable":false},{"path":"carrier_name","type":"text","nullable":false}]}' \
  "$NESTED_CREATE_RESULT"
check "a field naming no declared path refuses to shape the step" \
  "$([[ "$(placed "$p" create-carrier)" == "" ]] && echo 0 || echo 1)"
check "and the evidence names the field, the operation and the declared paths" \
  "$([[ "$(refusal "$p" create-carrier)" == \
        "fixture field name matches no declared path for carrier.create. the contract declares carrier_name, request_id" ]] \
     && echo 0 || echo 1)"

# 15. An operation with no published contract at all is refused, not guessed.
placement_fixture "$p"; one_create_step "$p"
check "an operation with no published input contract is refused" \
  "$([[ "$(refusal "$p" create-carrier)" == "no published input contract for carrier.create"* ]] && echo 0 || echo 1)"

# 16. One package, two shapes. The grader reads each operation's own contract,
# so a package that nests its commands and flattens its projection works.
placement_fixture "$p"
cat > "$p/steps.json" <<'JSON'
[{"id":"create-carrier","must":true,"invariant":"DOCK-0","route":{"operation":"carrier.create"},
  "body":{"name":"Northbound Freight"},
  "expect":{"status":200,"item":"value","present":["carrier_id"]}},
 {"id":"list","must":true,"invariant":"DOCK-6","route":{"operation":"appointment.query"},
  "body":{"day":"2026-10-01","dock_id":"11111111-1111-1111-1111-111111111111"},
  "expect":{"status":200,"item":"value","sorted_by":{"path":"appointments","field":"slot_start"}}}]
JSON
contract "$p" carrier create "$NESTED_CREATE" "$NESTED_CREATE_RESULT"
contract "$p" appointment query "$FLAT_QUERY" "$NESTED_QUERY_RESULT"
check "a nested command and a flat projection are each shaped by their own contract" \
  "$([[ "$(placed "$p" create-carrier | jq -r '.value.name')" == "Northbound Freight" \
        && "$(placed "$p" list | jq -r '.day')" == "2026-10-01" ]] && echo 0 || echo 1)"

# 17. A reuse clause lands at the declared path, and its VALUE is read from the
# earlier step's result by name, not by the fixture's spelling of the path.
placement_fixture "$p"
cat > "$p/steps.json" <<'JSON'
[{"id":"create-carrier","must":true,"invariant":"DOCK-0","route":{"operation":"carrier.create"},
  "body":{"name":"Northbound Freight"},
  "expect":{"status":200,"item":"value","present":["carrier_id"]}},
 {"id":"book","must":true,"invariant":"DOCK-2","route":{"operation":"appointment.book"},
  "body":{"slot_start":"2026-10-01T09:00:00Z"},
  "reuse":{"carrier_id":"create-carrier.value.carrier_id"},
  "expect":{"status":200,"item":"value","present":["appointment_id"]}}]
JSON
contract "$p" carrier create "$NESTED_CREATE" "$NESTED_CREATE_RESULT"
contract "$p" appointment book \
  '{"fields":[{"path":"request_id","type":"text","nullable":false},
    {"path":"value.idempotency_key","type":"text","nullable":false},
    {"path":"value.carrier_id","type":"uuid","nullable":false},
    {"path":"value.slot_start","type":"timestamptz","nullable":false}]}' \
  '{"class":"one","fields":[{"path":"appointment_id","type":"uuid","nullable":false}]}'
printf '%s\n' '{"id":"create-carrier","response":"[{\"request_id\":\"x\",\"value\":{\"carrier_id\":\"aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa\"}}]"}' \
  > "$p/grade/http.jsonl"
check "a reused value lands at the path the second contract declares" \
  "$([[ "$(placed "$p" book | jq -r '.value.carrier_id')" == "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa" ]] && echo 0 || echo 1)"

# ---------------------------------------------------------------------------
# THE RUN MARKER. A fixture value marked {{run}} is unique per run, and every
# other value is sent byte for byte. Arm 032 lost every step after create-dock:
# the agent had already created a dock named Door 7 while testing its own
# package, so the package refused the duplicate with the typed error it had
# declared, and the reuse chain below it had no id to pass.
# ---------------------------------------------------------------------------

marker_fixture() { # <dir>
  placement_fixture "$1"
  cat > "$1/steps.json" <<'JSON'
[{"id":"book-replay","must":true,"invariant":"DOCK-2","route":{"operation":"carrier.create"},
  "body":{"name":"Door 7 {{run}}","idempotency_key":"dock-gate-book-1"},
  "expect":{"status":200,"item":"value","present":["carrier_id"]}}]
JSON
  contract "$1" carrier create "$NESTED_CREATE" "$NESTED_CREATE_RESULT"
}

# 18. The marked value carries the run key, so two runs of one fixture against
# one database post two different names.
marker_fixture "$work/place-alpha"; marker_fixture "$work/place-beta"
alpha="$(placed "$work/place-alpha" book-replay | jq -r '.value.name')"
beta="$(placed "$work/place-beta" book-replay | jq -r '.value.name')"
check "a marked fixture value is expanded to the run key" \
  "$([[ "$alpha" == "Door 7 place-alpha" ]] && echo 0 || echo 1)"
check "so two runs of one fixture post two different names" \
  "$([[ "$alpha" != "$beta" && "$beta" == "Door 7 place-beta" ]] && echo 0 || echo 1)"

# 19. Everything the fixture did not mark is sent byte for byte. THIS IS THE
# CASE A GRADER THAT SUFFIXED EVERY STRING FAILS: a replay case and a
# changed-body case reuse the first call's idempotency key on purpose, and a
# key that moved per run would prove nothing about a replay.
check "an unmarked value is sent byte for byte, the reused idempotency key included" \
  "$(placed "$work/place-alpha" book-replay \
     | jq -e '.value.idempotency_key == "dock-gate-book-1" and .request_id == "book-replay"' \
     >/dev/null && echo 0 || echo 1)"

# ---------------------------------------------------------------------------
# THE BRIEF, AGAINST WHAT THE PACKAGE DECLARES. A reference implements platform
# law exactly, so a sentence in the brief the reference would not satisfy is a
# task defect. It cost two arms to find the last one by hand.
# ---------------------------------------------------------------------------

# A brief carrying one data contract section and nothing else. The rows are the
# subject; the sections around them are what the real brief puts there.
brief() { # <dir> <table rows> [a second table inside the section]
  { printf '# Proof scenario\n\n## The data contract\n\n'
    printf '| operation | input | result |\n|---|---|---|\n'
    printf '%s\n' "$2" "${3:-}"
    printf '\n## What the words mean here\n\nA dock is a physical door.\n'
  } > "$1/SCENARIO.md"
}

asserted() { "$GRADE" --contract "$1" 2>/dev/null; }
brief_rc() { "$GRADE" --contract "$1" >/dev/null 2>&1 && echo 0 || echo $?; }

ONE_ROW='| `carrier.create` | `name` text | `carrier_id` uuid |'

b="$work/brief"

# 20. A brief the package satisfies passes, with no host, no database and no
# agent. Both published shapes satisfy one brief, exactly as in placement.
placement_fixture "$b"; brief "$b" "$ONE_ROW"
contract "$b" carrier create "$NESTED_CREATE" "$NESTED_CREATE_RESULT"
check "a brief the package satisfies passes with no environment" "$(brief_rc "$b")"
placement_fixture "$b"; brief "$b" "$ONE_ROW"
contract "$b" carrier create "$FLAT_CREATE" "$NESTED_CREATE_RESULT"
check "and the flat shape satisfies the same brief" "$(brief_rc "$b")"
placement_fixture "$b"; brief "$b" "$ONE_ROW"
contract "$b" carrier create "$CRUD_CREATE" "$NESTED_CREATE_RESULT"
check "and so does the model CRUD shape" "$(brief_rc "$b")"

# 21. A field the brief names that the package does not declare turns the arm
