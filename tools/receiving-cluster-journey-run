' "$repo_root/deploy/platform/values-host-default.yaml" >"$host_base"
host_overlay=$work_dir/host-receiving.yaml
awk -v target_namespace="$namespace" -v component_base="$component_artifact_base" \
    -v release_base="$release_artifact_base" -v digest="$manifest_digest" \
    -v replicas="$host_replicas" -v trace_enabled="$measure_startup" \
    -v guest="$guest_secret_name" -v executor="$executor_platform_secret_name" \
    -v identity="$identity_secret_name" -v http="$http_secret_name" '
  /^      namespace: wamn-system$/ { print "      namespace: " target_namespace; next }
  /^      replicas: 3$/ { print "      replicas: " replicas; next }
  /^              name: wamn-host-db$/ { print "              name: " guest; next }
  /^              name: wamn-executor-platform-acme--receiving--dev$/ {
    print "              name: " executor; next
  }
  /^              name: wamn-identity-reader-acme--receiving--dev$/ {
    print "              name: " identity; next
  }
  /^              name: wamn-http-admitter-acme--receiving--dev$/ {
    print "              name: " http; next
  }
  /name: WAMN_WASMTIME_CACHE_DIR/ {
    print
    if (trace_enabled == "true") {
      print "        - { name: OTEL_EXPORTER_OTLP_ENDPOINT, value: http://otel-collector.wamn-system.svc.cluster.local:4317 }"
      print "        - { name: OTEL_BSP_SCHEDULE_DELAY, value: \"1\" }"
      print "        - { name: OTEL_BSP_MAX_EXPORT_BATCH_SIZE, value: \"1\" }"
    }
    next
  }
  /^          value: registry\.wamn-system\.svc\.cluster\.local:5000\/wamn\/components$/ {
    print "          value: " component_base; next
  }
  /^        - "--release-artifact-base=/ {
    print "        - \"--release-artifact-base=" release_base "\""; next
  }
  /^        - "--release-manifest-digest=/ {
    print "        - \"--release-manifest-digest=" digest "\""
    print "        - \"--allow-insecure-registries\""
    next
  }
  { print }
' "$repo_root/deploy/platform/values-host-receiving-pat.yaml" >"$host_overlay"
for expected in "$namespace" "$component_artifact_base" "$release_artifact_base" \
    "$manifest_digest" "$guest_secret_name" "$executor_platform_secret_name" \
    "$identity_secret_name" "$http_secret_name"; do
  grep -F -- "$expected" "$host_overlay" >/dev/null || {
    echo "rendered host overlay omitted $expected" >&2
    exit 1
  }
done
if [[ "$measure_startup" == true ]]; then
  grep -F -- 'OTEL_EXPORTER_OTLP_ENDPOINT' "$host_overlay" >/dev/null || {
    echo "rendered measurement overlay omitted OTLP export" >&2
    exit 1
  }
fi
run helm upgrade --install --kubeconfig "$kubeconfig" --kube-context "$context" \
  --namespace "$namespace" wamn-host "$chart" --version "$chart_version" \
  -f "$host_base" -f "$host_overlay" --wait --timeout 5m

measurement_pod=
measurement_uid=
cold_startup_ms=
if [[ "$measure_startup" == true ]]; then
  # Scale from zero without altering runtime-operator 2.8.0's native probes.
  # Port 80 becomes reachable at runtime-up; released wirings resolve only when
  # a routed request actually demands them.
  run "${kube[@]}" -n "$namespace" scale deployment/hostgroup-default --replicas=1
  run "${kube[@]}" -n "$namespace" wait --for=condition=Available \
    deployment/hostgroup-default --timeout=120s
  host_replicas=1

  "${kube[@]}" -n "$namespace" get deployment hostgroup-default -o json \
    >"$evidence_dir/host-measurement-deployment.json"
  jq -e '
    .spec.replicas == 1 and .status.availableReplicas == 1 and
    (.spec.template.spec.containers | length == 1) and
    .spec.template.spec.containers[0].name == "host" and
    (.spec.template.spec.containers[0].livenessProbe.tcpSocket.port == "http" or
     .spec.template.spec.containers[0].livenessProbe.tcpSocket.port == 80) and
    (.spec.template.spec.containers[0].readinessProbe.tcpSocket.port == "http" or
     .spec.template.spec.containers[0].readinessProbe.tcpSocket.port == 80) and
    (.spec.template.spec.containers[0].startupProbe // null) == null
  ' >/dev/null "$evidence_dir/host-measurement-deployment.json"
  measurement_selector=$(jq -er '
    .spec.selector.matchLabels | to_entries |
    if length == 0 then error("empty host selector")
    else map("\(.key)=\(.value)") | join(",") end
  ' "$evidence_dir/host-measurement-deployment.json")
  "${kube[@]}" -n "$namespace" get pods -l "$measurement_selector" -o json \
    >"$evidence_dir/host-cold.json"
  jq -e '
    (.items | length == 1) and all(.items[];
      any(.status.containerStatuses[]?;
        .name == "host" and .ready == true and .restartCount == 0))
  ' >/dev/null "$evidence_dir/host-cold.json"
  measurement_pod=$(jq -er '.items[0].metadata.name' "$evidence_dir/host-cold.json")
  measurement_uid=$(jq -er '.items[0].metadata.uid' "$evidence_dir/host-cold.json")
  "${kube[@]}" -n "$namespace" logs --timestamps "$measurement_pod" -c host \
    >"$evidence_dir/host-cold.log"

  runtime_startup_ms() {
    awk '
      /wamn-host runtime startup completed/ {
        for (field = 1; field <= NF; field++) {
          if ($field ~ /^elapsed_ms=/) {
            value = $field
            sub(/^elapsed_ms=/, "", value)
          }
        }
      }
      END { if (value == "") exit 1; print value }
    ' "$1"
  }
  cold_startup_ms=$(runtime_startup_ms "$evidence_dir/host-cold.log")
fi

run "${kube[@]}" -n "$namespace" rollout status \
  deployment/hostgroup-default --timeout=240s

helm list --kubeconfig "$kubeconfig" --kube-context "$context" --all-namespaces -o json \
