#!/usr/bin/env bash
# Prove the Receiving release on one disposable cluster without addressing kind-wamn.

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: receiving-cluster-journey-run [--apply] [--measure-startup] --evidence-dir DIR

Without --apply, print the immutable plan and exit.

  --apply              Build and run the journey, then tear down owned resources
  --measure-startup    Measure cold/restart startup and two warm requests, then stop
  --evidence-dir DIR   New directory retaining commands and machine evidence

The fixed scratch cluster is wamn-receiving-journey. Every Kubernetes and Helm
command carries its private kubeconfig and context. The frozen kind-wamn cluster
is never a target.
EOF
}

apply=false
measure_startup=false
evidence_dir=
while (($#)); do
  case "$1" in
    --apply) apply=true; shift ;;
    --measure-startup) measure_startup=true; shift ;;
    --evidence-dir) evidence_dir=${2-}; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage; exit 2 ;;
  esac
done

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "$script_dir/.." && pwd)
cd -- "$repo_root"

head=$(git rev-parse --verify HEAD)
short_head=${head:0:12}
cluster=wamn-receiving-journey
context=kind-wamn-receiving-journey
namespace=wamn-receiving-journey
system_namespace=wamn-system
chart=oci://ghcr.io/wasmcloud/charts/runtime-operator
chart_version=2.8.0
route_host=receiving.localhost
run_id=$$
host_tag=receiving-${short_head}-${run_id}-debug
host_image=wamn-host:${host_tag}
postgres_container=wamn-receiving-pg18-${short_head}-${run_id}
registry_container=wamn-receiving-registry-${short_head}-${run_id}
cargo_target_dir=${CARGO_TARGET_DIR:-$repo_root/target}

if [[ "$apply" != true ]]; then
  printf 'Receiving cluster journey dry-run (no mutation)\n'
  printf '  source: %s\n' "$head"
  printf '  cluster/context: %s / %s\n' "$cluster" "$context"
  printf '  namespace: %s\n' "$namespace"
  printf '  route host: %s (setup overlay only)\n' "$route_host"
  if [[ "$measure_startup" == true ]]; then
    printf '  order: build -> production mint/attest -> operator 2.8.0 -> cold request -> same-Pod restart -> restart-first/steady requests -> exact teardown\n'
  else
    printf '  order: build -> production mint/attest -> operator 2.8.0 -> host 2.8.0 -> schedule -> EndpointSlice -> HTTP -> cross-environment refusal -> exact teardown\n'
  fi
  exit 0
fi

if [[ -z "$evidence_dir" ]]; then
  usage
  exit 2
fi
if [[ -n $(git status --porcelain --untracked-files=normal) ]]; then
  echo "refusing to build a non-clean source tree; commit the final tip first" >&2
  exit 2
fi
if [[ $(uname -m) != x86_64 ]]; then
  echo "the debug host image requires an x86_64 build host" >&2
  exit 2
fi
for required in awk bash cargo chmod cmp cp curl date docker find flock git grep head helm \
    install jq kind kubectl mkdir openssl psql rm sed seq sha256sum sleep sort tee \
    stat timeout tr wash xargs; do
  if ! command -v "$required" >/dev/null 2>&1; then
    echo "required executable not found: $required" >&2
    exit 2
  fi
done
if [[ -e "$evidence_dir" ]]; then
  echo "--evidence-dir must not already exist: $evidence_dir" >&2
  exit 2
fi
mkdir -m 0700 -- "$evidence_dir"
evidence_dir=$(cd -- "$evidence_dir" && pwd)
commands_record=$evidence_dir/commands.log
: >"$commands_record"

record_command() {
  local argument
  printf '%s ' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$commands_record"
  for argument in "$@"; do
    printf '%q ' "$argument" >>"$commands_record"
  done
  printf '\n' >>"$commands_record"
}

run() {
  record_command "$@"
  "$@"
}

run_sensitive() {
  local label=$1
  shift
  record_command "$label" '<credential-bearing arguments redacted>'
  "$@"
}

work_dir=$(mktemp -d)
kubeconfig=$work_dir/kubeconfig
kind_config=$work_dir/kind-config.yaml
cluster_owned=false
postgres_owned=false
registry_owned=false
host_image_owned=false
run_complete=false

cleanup() {
  local status=$? cleanup_failed=false
  trap - EXIT HUP INT TERM
  set +e

  if [[ "$cluster_owned" == true ]] &&
     kind get clusters 2>/dev/null | grep -Fx -- "$cluster" >/dev/null; then
    record_command kind delete cluster --name "$cluster"
    kind delete cluster --name "$cluster" >/dev/null 2>&1 || cleanup_failed=true
  fi
  if [[ "$postgres_owned" == true ]] &&
     docker container inspect "$postgres_container" >/dev/null 2>&1; then
    record_command docker rm --force --volumes "$postgres_container"
    docker rm --force --volumes "$postgres_container" >/dev/null 2>&1 || cleanup_failed=true
  fi
  if [[ "$registry_owned" == true ]] &&
     docker container inspect "$registry_container" >/dev/null 2>&1; then
    record_command docker rm --force --volumes "$registry_container"
    docker rm --force --volumes "$registry_container" >/dev/null 2>&1 || cleanup_failed=true
  fi
  if [[ "$host_image_owned" == true ]] &&
     docker image inspect "$host_image" >/dev/null 2>&1; then
    record_command docker image rm "$host_image"
    docker image rm "$host_image" >/dev/null 2>&1 || cleanup_failed=true
  fi

  if kind get clusters 2>/dev/null | grep -Fx -- "$cluster" >/dev/null; then
    cleanup_failed=true
  fi
  if docker container inspect "$postgres_container" >/dev/null 2>&1; then
    cleanup_failed=true
  fi
  if docker container inspect "$registry_container" >/dev/null 2>&1; then
    cleanup_failed=true
  fi
  if docker image inspect "$host_image" >/dev/null 2>&1; then
    cleanup_failed=true
  fi
  record_command rm -rf -- "$work_dir"
  rm -rf -- "$work_dir" || cleanup_failed=true
  [[ ! -e "$work_dir" ]] || cleanup_failed=true

  if [[ "$cleanup_failed" == false ]]; then
    printf 'verdict=pass cluster=%s containers=%s,%s image=%s\n' \
      "$cluster" "$postgres_container" "$registry_container" "$host_image" \
      >"$evidence_dir/cleanup.receipt"
  else
    printf 'verdict=fail cluster=%s containers=%s,%s image=%s\n' \
      "$cluster" "$postgres_container" "$registry_container" "$host_image" \
      >"$evidence_dir/cleanup.receipt"
    [[ $status -ne 0 ]] || status=1
  fi

  if [[ $status -eq 0 && "$run_complete" == true && "$cleanup_failed" == false ]]; then
    if [[ "$measure_startup" == true ]]; then
      printf 'RECEIVING STARTUP MEASUREMENT PASS source=%s namespace=%s\n' \
        "$head" "$namespace" >"$evidence_dir/startup-measurement.receipt"
    else
      printf 'RECEIVING CLUSTER JOURNEY PASS source=%s namespace=%s host=%s\n' \
        "$head" "$namespace" "$route_host" >"$evidence_dir/journey.receipt"
    fi
    (
      cd -- "$evidence_dir" || exit 1
      find . -maxdepth 1 -type f ! -name evidence.sha256 -print0 \
        | sort -z | xargs -0 sha256sum >evidence.sha256
    ) || status=1
  elif [[ $status -eq 0 ]]; then
    status=1
  fi

  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

lock_file=${TMPDIR:-/tmp}/wamn-receiving-cluster-journey.lock
exec 9>"$lock_file"
if ! flock -n 9; then
  echo "another Receiving cluster journey owns the fixed scratch name" >&2
  exit 2
fi
if kind get clusters | grep -Fx -- "$cluster" >/dev/null; then
  echo "refusing pre-existing kind cluster: $cluster" >&2
  exit 2
fi
for container in "$postgres_container" "$registry_container"; do
  if docker container inspect "$container" >/dev/null 2>&1; then
    echo "refusing pre-existing container: $container" >&2
    exit 2
  fi
done
if docker image inspect "$host_image" >/dev/null 2>&1; then
  echo "refusing pre-existing host image: $host_image" >&2
  exit 2
fi

awk '
  /^    extraPortMappings:/ { skipping = 1; next }
  skipping && /^      / { next }
  { skipping = 0; print }
' "$repo_root/deploy/infra/kind-config.yaml" >"$kind_config"
if [[ $(grep -c '^  - role:' "$kind_config") -ne 3 ]] ||
   grep -q 'extraPortMappings\|hostPort:' "$kind_config"; then
  echo "rendered kind config did not retain exactly three nodes without host ports" >&2
  exit 2
fi

run env CARGO_TARGET_DIR="$cargo_target_dir" RUSTC_WRAPPER= \
  "$repo_root/tools/build-components" m1
run env CARGO_TARGET_DIR="$cargo_target_dir" RUSTC_WRAPPER= \
  cargo build --locked -p wamn-host -p wamn-ctl

flow_http_wasm=$cargo_target_dir/wasm32-wasip2/debug/http_route.wasm
component_directory=$cargo_target_dir/virtualized/std-empty-environment
components=(purchase_order_get purchase_order_query purchase_order_update receipt_get \
  receipt_query receiving_record_receipt)
for component in "${components[@]}"; do
  [[ -s "$component_directory/$component.wasm" ]] || {
    echo "missing virtualized Receiving component: $component" >&2
    exit 1
  }
done
[[ -s "$flow_http_wasm" ]] || {
  echo "missing built flow-http component: $flow_http_wasm" >&2
  exit 1
}
: >"$evidence_dir/component-bytes.sha256"
sha256sum "$flow_http_wasm" >>"$evidence_dir/component-bytes.sha256"
for component in "${components[@]}"; do
  sha256sum "$component_directory/$component.wasm" \
    >>"$evidence_dir/component-bytes.sha256"
done

host_context=$work_dir/host-image
mkdir -- "$host_context"
install -m 0755 "$cargo_target_dir/debug/wamn-host" "$host_context/wamn-host"
cat >"$host_context/Dockerfile" <<EOF
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \\
 && rm -rf /var/lib/apt/lists/*
COPY wamn-host /usr/local/bin/wamn-host
ENV HOME=/tmp
LABEL wamn.dev/source-head="$head" wamn.dev/build-profile="debug"
ENTRYPOINT ["/usr/local/bin/wamn-host"]
EOF
host_image_owned=true
run docker build --platform=linux/amd64 --provenance=false \
  --file "$host_context/Dockerfile" --tag "$host_image" "$host_context"
docker image inspect "$host_image" >"$evidence_dir/host-image.json"
jq -e --arg head "$head" '
  .[0].Config.Labels["wamn.dev/source-head"] == $head and
  .[0].Config.Labels["wamn.dev/build-profile"] == "debug"
' >/dev/null "$evidence_dir/host-image.json"

cluster_owned=true
run kind create cluster --name "$cluster" --config "$kind_config" \
  --kubeconfig "$kubeconfig"
kube=(kubectl --kubeconfig "$kubeconfig" --context "$context")
run "${kube[@]}" wait --for=condition=Ready nodes --all --timeout=180s
run "${kube[@]}" create namespace "$namespace"
"${kube[@]}" get nodes -o json >"$evidence_dir/nodes.json"
jq -e '
  (.items | length == 3) and
  ([.items[].metadata.name] | unique | length == 3) and
  all(.items[];
    .status.nodeInfo.architecture == "amd64" and
    any(.status.conditions[]?; .type == "Ready" and .status == "True"))
' >/dev/null "$evidence_dir/nodes.json"
run kind load docker-image "$host_image" --name "$cluster"

: >"$evidence_dir/host-image-nodes.jsonl"
first_image_tuple=
while IFS= read -r node; do
  inspect=$(docker exec "$node" crictl inspecti -o json "$host_image")
  runtime_digest=$(jq -er '
    [.status.repoDigests[]? |
     capture("@(?<digest>sha256:[0-9a-f]{64})$").digest] | unique |
    if length == 1 then .[0] else error("runtime digest missing or ambiguous") end
  ' <<<"$inspect")
  config_id=$(jq -er '.status.id | select(test("^sha256:[0-9a-f]{64}$"))' <<<"$inspect")
  tuple="$runtime_digest $config_id"
  if [[ -z "$first_image_tuple" ]]; then
    first_image_tuple=$tuple
  elif [[ "$first_image_tuple" != "$tuple" ]]; then
    echo "host image tuple differs across kind nodes" >&2
    exit 1
  fi
  jq -cn --arg node "$node" --arg digest "$runtime_digest" --arg config "$config_id" \
    '{node:$node,runtime_digest:$digest,config_id:$config}' \
    >>"$evidence_dir/host-image-nodes.jsonl"
done < <(kind get nodes --name "$cluster" | sort)
read -r host_runtime_digest host_config_id <<<"$first_image_tuple"

registry_username=wamn-receiving-journey
registry_password=$(openssl rand -hex 32)
htpasswd_file=$work_dir/htpasswd
run_sensitive htpasswd docker run --rm -i --entrypoint htpasswd httpd:2-alpine \
  -Bni "$registry_username" <<<"$registry_password" >"$htpasswd_file"
chmod 0600 "$htpasswd_file"

postgres_owned=true
run_sensitive postgres docker run --detach --name "$postgres_container" --network kind \
  --env POSTGRES_PASSWORD=probe \
  --publish 127.0.0.1::5432 \
  --volume "$repo_root/deploy/sql/postgres-init.sql:/docker-entrypoint-initdb.d/postgres-init.sql:ro" \
  postgres:18
registry_owned=true
run docker run --detach --name "$registry_container" --network kind \
  --env REGISTRY_AUTH=htpasswd \
  --env 'REGISTRY_AUTH_HTPASSWD_REALM=WAMN Receiving cluster journey' \
  --env REGISTRY_AUTH_HTPASSWD_PATH=/auth/htpasswd \
  --volume "$htpasswd_file:/auth/htpasswd:ro" registry:2

postgres_ip=$(docker inspect --format '{{.NetworkSettings.Networks.kind.IPAddress}}' \
  "$postgres_container")
postgres_host_port=$(docker port "$postgres_container" 5432/tcp)
postgres_host_port=${postgres_host_port##*:}
registry_ip=$(docker inspect --format '{{.NetworkSettings.Networks.kind.IPAddress}}' \
  "$registry_container")
for address in "$postgres_ip" "$registry_ip"; do
  if [[ ! "$address" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "owned container has no kind-network IPv4 address: $address" >&2
    exit 1
  fi
done
if [[ "$postgres_ip" == "$registry_ip" ]]; then
  echo "owned PostgreSQL and registry containers share one address" >&2
  exit 1
fi
if [[ ! "$postgres_host_port" =~ ^[1-9][0-9]*$ ]]; then
  echo "owned PostgreSQL has no loopback host port" >&2
  exit 1
fi

# The PostgreSQL image opens a temporary server while applying init scripts,
# then stops it and starts the final server. An early pg_isready can observe the
# temporary process and race the restart. Require the second readiness marker
# over its mapped loopback port, then separately prove the kind-network address
# handed to production verbs and emitted into the original Secret artifacts.
postgres_ready=false
for _ in $(seq 1 90); do
  readiness_markers=$(docker logs "$postgres_container" 2>&1 \
    | grep -Fc 'database system is ready to accept connections' || true)
  if [[ $readiness_markers -ge 2 ]] &&
     PGPASSWORD=probe psql -h 127.0.0.1 -p "$postgres_host_port" -U postgres -d postgres \
       -Atqc 'SELECT current_setting('\''server_version_num'\'')::int >= 180000' \
       | grep -Fx t >/dev/null &&
     PGPASSWORD=probe psql -h "$postgres_ip" -p 5432 -U postgres -d postgres \
       -Atqc 'SELECT current_setting('\''server_version_num'\'')::int >= 180000' \
       | grep -Fx t >/dev/null; then
    postgres_ready=true
    break
  fi
  sleep 1
done
if [[ "$postgres_ready" != true ]]; then
  echo "owned PostgreSQL 18 did not reach final externally reachable readiness" >&2
  exit 1
fi

registry_authority=$registry_ip:5000
docker_config_directory=$work_dir/docker
mkdir -- "$docker_config_directory"
jq -n --arg authority "$registry_authority" --arg username "$registry_username" \
  --arg password "$registry_password" \
  '{auths:{($authority):{username:$username,password:$password}}}' \
  >"$docker_config_directory/config.json"
chmod 0600 "$docker_config_directory/config.json"
curl_config=$work_dir/curl.conf
printf 'user = "%s:%s"\n' "$registry_username" "$registry_password" >"$curl_config"
chmod 0600 "$curl_config"
for _ in $(seq 1 60); do
  if curl --config "$curl_config" --silent --show-error --connect-timeout 2 \
      --max-time 5 --output /dev/null \
      "http://$registry_authority/v2/"; then
    break
  fi
  sleep 1
done
test "$(curl --silent --connect-timeout 2 --max-time 5 --output /dev/null \
  --write-out '%{http_code}' \
  "http://$registry_authority/v2/")" = 401
test "$(curl --config "$curl_config" --silent --show-error --connect-timeout 2 \
  --max-time 5 --output /dev/null --write-out '%{http_code}' \
  "http://$registry_authority/v2/")" = 200

system_url=postgresql://postgres:probe@$postgres_ip:5432/postgres
component_artifact_base=$registry_authority/wamn/components
release_artifact_base=$registry_authority/wamn/releases
host_secret_directory=$work_dir/host-secrets
install -d -m 0700 "$host_secret_directory"
route_caller_secret=$work_dir/route-caller-pat.json
record_command cargo test production_receiving_release_serves_all_six_pat_routes_with_correlated_traces \
  '<disposable PostgreSQL and OCI inputs redacted>'
WAMN_RECEIVING_ROUTE_PG18_URL="$system_url" \
WAMN_RECEIVING_ROUTE_COMPONENT_DIRECTORY="$component_directory" \
WAMN_RECEIVING_ROUTE_FLOW_HTTP_WASM="$flow_http_wasm" \
WAMN_RECEIVING_ROUTE_COMPONENT_ARTIFACT_BASE="$component_artifact_base" \
WAMN_RECEIVING_ROUTE_RELEASE_ARTIFACT_BASE="$release_artifact_base" \
WAMN_RECEIVING_ROUTE_HOST="$route_host" \
WAMN_RECEIVING_ROUTE_REGISTRY_AUTH_FILE="$docker_config_directory/config.json" \
WAMN_RECEIVING_ROUTE_SECRET_OUTPUT_DIRECTORY="$host_secret_directory" \
WAMN_RECEIVING_ROUTE_SECRET_NAMESPACE="$namespace" \
WAMN_RECEIVING_ROUTE_CALLER_SECRET_OUTPUT="$route_caller_secret" \
CARGO_TARGET_DIR="$cargo_target_dir" \
RUSTC_WRAPPER= \
  cargo test -p wamn-proof-integration --lib --locked --offline \
  route_authentication_live::production_receiving_release_serves_all_six_pat_routes_with_correlated_traces \
  -- --ignored --exact --nocapture --test-threads=1 \
  2>&1 | tee "$evidence_dir/production-route.log"

if [[ $(stat -c '%a' "$route_caller_secret") != 600 ]]; then
  echo "production journey emitted an unsafe route-caller Secret mode" >&2
  exit 1
fi
jq -e '
  .kind == "Secret" and .type == "Opaque" and
  .metadata.annotations["wamn.io/credential-purpose"] == "route-caller" and
  (.stringData.token | type == "string" and length > 0)
' >/dev/null "$route_caller_secret"
route_caller_kube_secret=$work_dir/route-caller-pat-kube.json
jq --arg namespace "$namespace" '.metadata.namespace = $namespace' \
  "$route_caller_secret" >"$route_caller_kube_secret"
route_caller_secret_name=$(jq -er '.metadata.name' "$route_caller_kube_secret")
run "${kube[@]}" apply -f "$route_caller_kube_secret"

flow_http_push_ref=$registry_authority/wamn/flow-http:$host_tag
record_command env WASH_REG_USER='<redacted>' WASH_REG_PASSWORD='<redacted>' wash push \
  --insecure --allow-latest --output json "$flow_http_push_ref" "$flow_http_wasm"
WASH_REG_USER="$registry_username" WASH_REG_PASSWORD="$registry_password" \
  wash push --insecure --allow-latest --output json \
  "$flow_http_push_ref" "$flow_http_wasm" \
  >"$evidence_dir/flow-http-push.json"
unset registry_password
jq -e '.success == true and (.digest | test("^sha256:[0-9a-f]{64}$"))' \
  >/dev/null "$evidence_dir/flow-http-push.json"
flow_http_digest=$(jq -er '.digest' "$evidence_dir/flow-http-push.json")
flow_http_ref=$registry_authority/wamn/flow-http@$flow_http_digest

instance_suffix=$(PGPASSWORD=probe psql -h "$postgres_ip" -p 5432 -U postgres \
  -d postgres -Atqc \
  "SELECT instance_suffix FROM registry.project_envs WHERE org='acme' AND project='receiving' AND env='dev'")
if [[ ! "$instance_suffix" =~ ^[a-z0-9]{8}$ ]]; then
  echo "production provisioning emitted an invalid project instance suffix" >&2
  exit 1
fi
project_database=wamn-db-acme--receiving--dev--$instance_suffix
project_url=postgresql://postgres:probe@$postgres_ip:5432/$project_database
ctl=$cargo_target_dir/debug/wamn-ctl
run_sensitive print-release-env "$ctl" print-release-env \
  --database-url "$project_url" --tenant receiving-route-auth \
  --effective-release-id 1 --artifact-base "$release_artifact_base" \
  >"$evidence_dir/print-release-env.receipt"
mapfile -t digest_lines < <(grep -E '^--release-manifest-digest=sha256:[0-9a-f]{64}$' \
  "$evidence_dir/print-release-env.receipt")
if [[ ${#digest_lines[@]} -ne 1 ]]; then
  echo "print-release-env did not emit exactly one release digest" >&2
  exit 1
fi
manifest_digest=${digest_lines[0]#*=}

guest_secret=$host_secret_directory/guest-sql.json
executor_platform_secret=$host_secret_directory/executor-platform.json
identity_secret=$host_secret_directory/identity-reader.json
http_secret=$host_secret_directory/http-admitter.json
mapfile -t emitted_host_secrets < <(find "$host_secret_directory" -maxdepth 1 -type f \
  -name '*.json' -printf '%f\n' | sort)
expected_host_secrets=(executor-platform.json guest-sql.json http-admitter.json identity-reader.json)
if [[ "${emitted_host_secrets[*]}" != "${expected_host_secrets[*]}" ]]; then
  echo "production journey did not emit exactly the four host credential Secrets" >&2
  exit 1
fi

for secret in "$guest_secret" "$executor_platform_secret" "$identity_secret" "$http_secret"; do
  jq -e --arg namespace "$namespace" --arg host "$postgres_ip" '
    .metadata.namespace == $namespace and
    (.metadata.name | type == "string" and length > 0) and
    (.stringData.url | type == "string" and contains("@" + $host + ":5432/"))
  ' >/dev/null "$secret"
  run "${kube[@]}" apply -f "$secret"
done
guest_secret_name=$(jq -er '.metadata.name' "$guest_secret")
executor_platform_secret_name=$(jq -er '.metadata.name' "$executor_platform_secret")
identity_secret_name=$(jq -er '.metadata.name' "$identity_secret")
http_secret_name=$(jq -er '.metadata.name' "$http_secret")

registry_pull=$work_dir/registry-pull.yaml
record_command "${kube[@]}" -n "$namespace" create secret generic wamn-registry-pull \
  --type=kubernetes.io/dockerconfigjson --from-file=.dockerconfigjson='<redacted>' \
  --dry-run=client -o yaml
"${kube[@]}" -n "$namespace" create secret generic wamn-registry-pull \
  --type=kubernetes.io/dockerconfigjson \
  --from-file=.dockerconfigjson="$docker_config_directory/config.json" \
  --dry-run=client -o yaml >"$registry_pull"
run "${kube[@]}" apply -f "$registry_pull"

run "${kube[@]}" apply -f "$repo_root/deploy/infra/cert-manager.yaml"
run "${kube[@]}" -n cert-manager wait --for=condition=Available \
  deployment --all --timeout=240s
operator_values=$work_dir/operator-values.yaml
cat >"$operator_values" <<EOF
operator:
  watchNamespaces: [$namespace]
  hostNamespaces: [$namespace]
  allowSharedHosts: false
EOF
run helm upgrade --install --create-namespace --kubeconfig "$kubeconfig" \
  --kube-context "$context" --namespace "$system_namespace" wamn "$chart" \
  --version "$chart_version" -f "$repo_root/deploy/infra/values-wamn.yaml" \
  -f "$operator_values" --wait --timeout 5m

if [[ "$measure_startup" == true ]]; then
  run "${kube[@]}" apply -f "$repo_root/deploy/infra/tempo.yaml"
  run "${kube[@]}" apply -f "$repo_root/deploy/infra/otel-collector.yaml"
  run "${kube[@]}" -n "$system_namespace" wait --for=condition=Available \
    deployment/tempo deployment/otel-collector --timeout=120s
fi

ca_source=$work_dir/wasmcloud-ca-source.json
ca_copy=$work_dir/wasmcloud-ca-copy.json
"${kube[@]}" -n "$system_namespace" get secret wasmcloud-ca -o json >"$ca_source"
jq 'del(.metadata) | .metadata = {name:"wasmcloud-ca",namespace:"cert-manager"}' \
