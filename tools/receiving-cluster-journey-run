jq -e --arg image "$materializer_ref" --arg namespace "$namespace" '
  .metadata.name == "receiving-materializer" and
  .metadata.namespace == $namespace and
  .spec.replicas == 1 and
  .spec.template.spec.environment == $namespace and
  .spec.template.spec.hostSelector == {hostgroup:"default"} and
  .spec.template.spec.service.image == $image and
  .spec.template.spec.service.localResources.config == {
    "wamn.tenant":"receiving-route-auth",
    "wamn.project":"receiving",
    "wamn.environment":"dev",
    "wamn.postgres.authority":"event-materializer"
  } and
  [.spec.template.spec.service.localResources.environment.config[
    "WAMN_MAT_STREAM","WAMN_MAT_ORG","WAMN_MAT_PROJECT","WAMN_MAT_ENV",
    "WAMN_MAT_TENANT","WAMN_MAT_FETCH_MS","WAMN_MAT_SWEEP_MS"
  ]] == ["EVT_acme_dev","acme","receiving","dev","receiving-route-auth","500","500"] and
  (.spec.template.spec.hostInterfaces | sort_by(.package)) == [
    {namespace:"wamn", package:"flow-http-routing", version:"0.1.0",
     interfaces:["routing"]},
    {namespace:"wamn", package:"jetstream", version:"0.1.0",
     interfaces:["types","consumer"]},
    {namespace:"wamn", package:"postgres", version:"0.1.0",
     interfaces:["types","client"]},
    {namespace:"wamn", package:"router-delivery", version:"0.1.0",
     interfaces:["delivery"]}
  ] and
  .status.currentReplicas == 1 and
  .status.replicas.expected == 1 and .status.replicas.current == 1 and
  .status.replicas.ready == 1 and (.status.replicas.unavailable // 0) == 0 and
  (.status.currentReplicaSet.name | type == "string" and length > 0) and
  any(.status.conditions[]?; .type == "Ready" and .status == "True")
' >/dev/null "$evidence_dir/materializer-deployment.json"
materializer_replicaset=$(jq -er '.status.currentReplicaSet.name' \
  "$evidence_dir/materializer-deployment.json")
"${kube[@]}" -n "$namespace" get workloadreplicaset "$materializer_replicaset" -o json \
  >"$evidence_dir/materializer-replicaset.json"
materializer_replicaset_uid=$(jq -er '.metadata.uid' \
  "$evidence_dir/materializer-replicaset.json")
for _ in $(seq 1 120); do
  "${kube[@]}" -n "$namespace" get workloads -o json >"$work_dir/materializer-workloads.json"
  if jq -e --arg uid "$materializer_replicaset_uid" '
      [.items[] | select(any(.metadata.ownerReferences[]?; .uid == $uid))] | length == 1
    ' >/dev/null "$work_dir/materializer-workloads.json"; then
    break
  fi
  sleep 2
done
jq -e --arg uid "$materializer_replicaset_uid" '
  [.items[] | select(any(.metadata.ownerReferences[]?; .uid == $uid))] |
  if length == 1 then .[0] else error("materializer Workload missing or ambiguous") end
' "$work_dir/materializer-workloads.json" >"$evidence_dir/materializer-workload.json"
jq -e --arg namespace "$namespace" \
  --arg host_id "$(jq -r '.status.hostId' "$evidence_dir/materializer-workload.json")" \
  --slurpfile hosts "$evidence_dir/hosts.json" '
  .status.conditions as $conditions |
  .status.environment == $namespace and (.status.hostId | length > 0) and
  .status.hostId == $host_id and any($hosts[0].items[]; .hostId == $host_id) and
  all(["Config","HostSelection","Placement","Sync","Ready"][];
    . as $type | any($conditions[]?; .type == $type and .status == "True"))
' >/dev/null "$evidence_dir/materializer-workload.json"

# Both production consumers are resident before this HTTP commit. The first
# request makes the untouched order inspection-bearing; the second creates the
# receipt whose causal CDC event the materializer consumes.
run "${kube[@]}" apply -f "$materializer_trigger"
run "${kube[@]}" -n "$namespace" wait --for=condition=Complete \
  job/receiving-materializer-trigger --timeout=120s
"${kube[@]}" -n "$namespace" logs job/receiving-materializer-trigger \
  >"$evidence_dir/materializer-trigger.log"
sed -n 's/^RECEIVING_MATERIALIZER_UPDATE //p' \
  "$evidence_dir/materializer-trigger.log" >"$evidence_dir/materializer-update.json"
sed -n 's/^RECEIVING_MATERIALIZER_RECEIPT //p' \
  "$evidence_dir/materializer-trigger.log" >"$evidence_dir/materializer-receipt.json"
jq -e '
  type == "array" and length == 1 and
  .[0].request_id == "materializer-order" and
  .[0].value.id == "00000000-0000-0000-0000-000000000304" and
  .[0].value.row_version == "2" and
  .[0].value.acme_inspection_required == true and
  .[0].value.acme_quality_status == "pending"
' >/dev/null "$evidence_dir/materializer-update.json"
jq -e '
  type == "array" and length == 1 and
  .[0].request_id == "materializer-receipt" and
  .[0].value.purchase_order_id == "00000000-0000-0000-0000-000000000304" and
  .[0].value.purchase_order_status == "complete" and
  .[0].value.row_version == "3" and
  .[0].value.acme_inspection_required == true and
  .[0].value.acme_quality_status == "pending" and
  (.[0].value.receipt_id | test("^[0-9a-f-]{36}$"))
' >/dev/null "$evidence_dir/materializer-receipt.json"
materializer_receipt_id=$(jq -er '.[0].value.receipt_id' \
  "$evidence_dir/materializer-receipt.json")

record_command cargo test production_materializer_consumes_the_causal_receipt_exactly_once \
  '<disposable PostgreSQL, NATS, and receipt inputs redacted>'
WAMN_RECEIVING_MATERIALIZER_PG_URL="$project_url" \
WAMN_RECEIVING_MATERIALIZER_NATS_URL="$nats_url" \
WAMN_RECEIVING_MATERIALIZER_RECEIPT_ID="$materializer_receipt_id" \
CARGO_TARGET_DIR="$cargo_target_dir" RUSTC_WRAPPER= \
  cargo test -p wamn-proof-integration --lib --locked --offline \
  route_authentication_live::production_materializer_consumes_the_causal_receipt_exactly_once \
  -- --ignored --exact --nocapture --test-threads=1 \
  2>&1 | tee "$evidence_dir/production-materializer.log"
assert_one_test_ran "$evidence_dir/production-materializer.log" \
  production_materializer_consumes_the_causal_receipt_exactly_once
if [[ $(grep -Fc 'RECEIVING_MATERIALIZER_PASS ' \
    "$evidence_dir/production-materializer.log") -ne 1 ]]; then
