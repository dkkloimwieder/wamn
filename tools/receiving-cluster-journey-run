# tools/wms-cluster-journey-run. The route workload and this one are separate
# arms of the pass; deleting either leaves that workload's placement unproven
# (wamn-362o.11, ruled 2026-09-06: comment the pair, do not extract it).
jq -e --arg namespace "$namespace" \
  --arg host_id "$(jq -r '.status.hostId' "$evidence_dir/materializer-workload.json")" \
  --slurpfile hosts "$evidence_dir/hosts.json" '
  .status.conditions as $conditions |
  .status.environment == $namespace and (.status.hostId | length > 0) and
  .status.hostId == $host_id and any($hosts[0].items[]; .hostId == $host_id) and
  all(["Config","HostSelection","Placement","Sync","Ready"][];
    . as $type | any($conditions[]?; .type == $type and .status == "True"))
' >/dev/null "$evidence_dir/materializer-workload.json"

# Both production consumers are resident before this HTTP commit. The first
# request makes the untouched order inspection-bearing; the second creates the
# receipt whose causal CDC event the materializer consumes.
run "${kube[@]}" apply -f "$materializer_trigger"
run "${kube[@]}" -n "$namespace" wait --for=condition=Complete \
  "job/$app_materializer_trigger" --timeout=120s
"${kube[@]}" -n "$namespace" logs "job/$app_materializer_trigger" \
  >"$evidence_dir/materializer-trigger.log"
sed -n 's/^RECEIVING_MATERIALIZER_UPDATE //p' \
  "$evidence_dir/materializer-trigger.log" >"$evidence_dir/materializer-update.json"
sed -n 's/^RECEIVING_MATERIALIZER_RECEIPT //p' \
  "$evidence_dir/materializer-trigger.log" >"$evidence_dir/materializer-receipt.json"
jq -e '
  type == "array" and length == 1 and
  .[0].request_id == "materializer-order" and
  .[0].value.id == "00000000-0000-0000-0000-000000000304" and
  .[0].value.row_version == "2" and
  .[0].value.acme_inspection_required == true and
  .[0].value.acme_quality_status == "pending"
' >/dev/null "$evidence_dir/materializer-update.json"
jq -e '
  type == "array" and length == 1 and
  .[0].request_id == "materializer-receipt" and
  .[0].value.purchase_order_id == "00000000-0000-0000-0000-000000000304" and
  .[0].value.purchase_order_status == "complete" and
  .[0].value.row_version == "3" and
  .[0].value.acme_inspection_required == true and
  .[0].value.acme_quality_status == "pending" and
  (.[0].value.receipt_id | test("^[0-9a-f-]{36}$"))
' >/dev/null "$evidence_dir/materializer-receipt.json"
materializer_receipt_id=$(jq -er '.[0].value.receipt_id' \
  "$evidence_dir/materializer-receipt.json")

# The materializer phase's inputs are amended in as ONE object, once. Two of
# them were not known when the document was written -- the project database is
# provisioned by the route phase and the receipt is produced by the trigger --
# and the third, the event stream, has only this phase as its reader.
amend_journey_document "$journey_schema" "$journey_document" materializer \
  "$(jq -n --arg project_pg_url "$project_url" --arg nats_url "$nats_url" \
    --arg receipt_id "$materializer_receipt_id" \
    '{project_pg_url: $project_pg_url, nats_url: $nats_url, receipt_id: $receipt_id}')"
record_command cargo test production_materializer_consumes_the_causal_receipt_exactly_once \
  '<journey document amended with the project database and receipt, redacted>'
WAMN_JOURNEY_DOCUMENT="$journey_document" \
CARGO_TARGET_DIR="$cargo_target_dir" RUSTC_WRAPPER= \
  cargo test -p wamn-proof-integration --lib --locked --offline \
  route_authentication_live::production_materializer_consumes_the_causal_receipt_exactly_once \
  -- --ignored --exact --nocapture --test-threads=1 \
  2>&1 | tee "$evidence_dir/production-materializer.log"
assert_one_test_ran "$evidence_dir/production-materializer.log" \
  production_materializer_consumes_the_causal_receipt_exactly_once
if [[ $(grep -Fc 'RECEIVING_MATERIALIZER_PASS ' \
    "$evidence_dir/production-materializer.log") -ne 1 ]]; then
  echo "production materializer emitted no unique causal receipt" >&2
  exit 1
fi

: >"$evidence_dir/materializer-host.log"
while IFS= read -r host_pod; do
  "${kube[@]}" -n "$namespace" logs "$host_pod" -c host \
    >>"$evidence_dir/materializer-host.log"
done < <(jq -r '.items[].metadata.name' "$evidence_dir/host-pods.json")
if grep -E 'wamn::materializer (REFUSED|.*failed)|router delivery did not settle' \
    "$evidence_dir/materializer-host.log" >/dev/null; then
  echo "production materializer logged a refusal or unsettled delivery" >&2
  exit 1
fi

negative_manifest=$work_dir/cross-environment-workload.json
jq --arg name flow-http-cross-environment --arg environment "${namespace}-denied" '
  del(.metadata.annotations, .metadata.creationTimestamp, .metadata.generateName,
      .metadata.finalizers, .metadata.generation, .metadata.managedFields,
      .metadata.ownerReferences,
      .metadata.resourceVersion, .metadata.uid, .status) |
  .metadata.name = $name |
  .metadata.labels = {app:$name} |
  .spec.environment = $environment |
  del(.spec.hostId)
' "$evidence_dir/flow-http-workload.json" >"$negative_manifest"
run "${kube[@]}" apply -f "$negative_manifest"
run "${kube[@]}" -n "$namespace" wait --for=condition=HostSelection=False \
  workload/flow-http-cross-environment --timeout=240s
record_command "${kube[@]}" -n "$namespace" get workload \
  flow-http-cross-environment -o json
"${kube[@]}" -n "$namespace" get workload flow-http-cross-environment -o json \
  >"$evidence_dir/cross-environment-workload.json"
negative_uid=$(jq -er '.metadata.uid' "$evidence_dir/cross-environment-workload.json")
jq -e --arg expected "${namespace}-denied" '
  .spec.environment == $expected and
  ((.status.hostId // "") == "") and ((.status.environment // "") == "") and
  any(.status.conditions[]?;
    .type == "HostSelection" and .status == "False" and
    (.message | contains("allowSharedHosts"))) and
  ([.status.conditions[]? | select(.type == "Ready" and .status == "True")] | length == 0)
' >/dev/null "$evidence_dir/cross-environment-workload.json"
record_command timeout 240s "${kube[@]}" -n "$namespace" get \
  events.events.k8s.io --field-selector "regarding.uid=$negative_uid" \
  --watch --output-watch-events -o json
set +o pipefail
if timeout 240s "${kube[@]}" -n "$namespace" get events.events.k8s.io \
    --field-selector "regarding.uid=$negative_uid" \
    --watch --output-watch-events -o json | \
  jq -ce --unbuffered -n --arg uid "$negative_uid" --arg namespace "$namespace" \
    --arg target "${namespace}-denied" '
    first(inputs | select(
      (.type == "ADDED" or .type == "MODIFIED") and
      .object.apiVersion == "events.k8s.io/v1" and
      .object.kind == "Event" and
      .object.regarding.apiVersion == "runtime.wasmcloud.dev/v1alpha1" and
      .object.regarding.kind == "Workload" and
      .object.regarding.namespace == $namespace and
      .object.regarding.name == "flow-http-cross-environment" and
      .object.regarding.uid == $uid and
      .object.type == "Warning" and
      .object.reason == "CrossEnvironmentSchedulingDenied" and
      .object.action == "Reject" and
      .object.reportingController == "workload-controller" and
      .object.note == ("Environment \"" + $target + "\" is outside \"" +
        $namespace + "\" and operator has allowSharedHosts=false")
    ) | .object)
  ' >"$evidence_dir/cross-environment-event.json"; then
  event_watch_status=0
else
  event_watch_status=$?
fi
set -o pipefail
if ((event_watch_status != 0)); then
  echo "native CrossEnvironmentSchedulingDenied Event did not arrive" >&2
  exit "$event_watch_status"
fi

# The native Event proves the grant has propagated. Check the final server
# authorization surface now so RBAC cache propagation cannot create a false red.
events_rbac_receipt=$evidence_dir/operator-events-rbac.receipt
: >"$events_rbac_receipt"
assert_can_i yes create events.events.k8s.io "$operator_subject" "$events_rbac_receipt"
assert_can_i yes patch events.events.k8s.io "$operator_subject" "$events_rbac_receipt"
assert_can_i no get events.events.k8s.io "$operator_subject" "$events_rbac_receipt"
assert_can_i no list events.events.k8s.io "$operator_subject" "$events_rbac_receipt"
assert_can_i no watch events.events.k8s.io "$operator_subject" "$events_rbac_receipt"
assert_can_i no update events.events.k8s.io "$operator_subject" "$events_rbac_receipt"
assert_can_i no delete events.events.k8s.io "$operator_subject" "$events_rbac_receipt"
assert_can_i no deletecollection events.events.k8s.io "$operator_subject" "$events_rbac_receipt"

jq -n --arg source "$head" --arg namespace "$namespace" \
  --arg digest "$manifest_digest" --arg host "$route_host" '
  {
    schema:"wamn-receiving-cluster-journey/v0.1",
    verdict:"pass",
    source:$source,
    namespace:$namespace,
    release_manifest_digest:$digest,
    route_host:$host,
    passing_arms:[
      "production-mint-and-attestation",
      "production-cdc-reader-session",
      "operator-before-host-2.8.0",
      "three-ready-default-hosts",
      "flow-http-workload-ready",
      "materializer-workload-ready",
      "operator-endpointslice",
      "exact-route-not-found-reachability",
      "receipt-root-causation",
      "inspection-derived-causation",
      "exactly-one-pending-inspection",
      "exact-materializer-durable-ack",
      "zero-materializer-dead-letter",
      "cross-environment-scheduling-refusal"
    ],
    evidence_scope:{
      cited_immutable_rc:{
        close:"851acb80",
        source:"79d2ab64",
        arms:["bootstrap","M2-supersession","socketguard","traceproof",
              "scoped-RegistryReader"]
      },
      rerun:["materializer-journey","native-scheduling","exact-cleanup"]
    },
    reachability_scope:"The exact 404 proves HTTP routing and guest execution only."
  }
' >"$evidence_dir/verdict.json"
run_complete=true
