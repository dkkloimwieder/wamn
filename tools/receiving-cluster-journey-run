  .spec.replicas == $replicas and .status.updatedReplicas == $replicas and
  .status.readyReplicas == $replicas and .status.availableReplicas == $replicas and
  any(.spec.template.spec.containers[]?; .image == $image)
' >/dev/null "$evidence_dir/host-deployment.json"
host_selector=$(jq -er '
  .spec.selector.matchLabels | to_entries |
  if length == 0 then error("empty host selector")
  else map("\(.key)=\(.value)") | join(",") end
' "$evidence_dir/host-deployment.json")
"${kube[@]}" -n "$namespace" get pods -l "$host_selector" -o json \
  >"$evidence_dir/host-pods.json"
jq -e --arg image "$host_image" --arg image_id "$host_runtime_digest" \
  --argjson replicas "$host_replicas" '
  (.items | length == $replicas) and all(.items[];
    ([.spec.containers[]? | select(.image == $image) | .name] |
      if length == 1 then .[0] else null end) as $container |
    ($container != null and
     any(.status.containerStatuses[]?;
       .name == $container and .ready == true and
       ((.imageID // "") | endswith($image_id)))))
' >/dev/null "$evidence_dir/host-pods.json"

for _ in $(seq 1 120); do
  if "${kube[@]}" -n "$system_namespace" get hosts -l hostgroup=default -o json \
      >"$work_dir/hosts.json" 2>/dev/null &&
     jq -e --arg namespace "$namespace" --argjson replicas "$host_replicas" '
       (.items | length == $replicas) and
       ([.items[].hostId] | unique | length == $replicas) and
       all(.items[];
         .metadata.labels.hostgroup == "default" and .environment == $namespace and
         (.hostId | length > 0) and (.hostname | length > 0) and .httpPort == 80 and
         any(.status.conditions[]?; .type == "Ready" and .status == "True"))
     ' >/dev/null "$work_dir/hosts.json"; then
    break
  fi
  sleep 2
done
cp "$work_dir/hosts.json" "$evidence_dir/hosts.json"
jq -e --arg namespace "$namespace" --argjson replicas "$host_replicas" '
  (.items | length == $replicas) and
  ([.items[].hostId] | unique | length == $replicas) and
  all(.items[];
    .metadata.labels.hostgroup == "default" and .environment == $namespace and
    (.hostId | length > 0) and (.hostname | length > 0) and .httpPort == 80 and
    any(.status.conditions[]?; .type == "Ready" and .status == "True"))
' >/dev/null "$evidence_dir/hosts.json"

workload_manifest=$work_dir/flow-http.yaml
declare -A workload_spec=(
  [template]=$repo_root/deploy/platform/http-route-workload.example.yaml
  [namespace]=$namespace
  [image]=$flow_http_ref
  [route_host]=$route_host
  [tenant]=$app_tenant
  [catalog]=$app_catalog
  [environment]=$app_environment
  [project]=$app_project
  [schema]=$app_schema
  [template_namespace]=$system_namespace
  [template_environment]=$system_namespace
  [template_image]=registry.wamn-system.svc.cluster.local:5000/wamn/flow-http:dev
  [template_interfaces]="interfaces: [incoming-handler]"
  [template_tenant]=00000000-0000-0000-0000-000000000001
  [template_catalog]=default
  [template_environment_value]=poc
  [template_project]=default
  [template_schema]=public
)
render_workload_manifest workload_spec "$workload_manifest"

if [[ "$session_host_proof" == true ]]; then
  # The native scheduler does not spread replicas. Each arm pins two
  # one-replica deployments to its two observed production host processes.
  run "${kube[@]}" create --dry-run=client -f "$workload_manifest" -o json \
    >"$work_dir/session-workload-source.json"
  jq -e 'if .kind == "List" and (.items | length) == 2 and
    ([.items[] | select(.kind == "Service" and .metadata.name == "flow-http")] | length) == 1 and
    ([.items[] | select(.kind == "WorkloadDeployment" and .metadata.name == "flow-http")] | length) == 1
    then .
    else error("session workload render must contain exactly its Service and WorkloadDeployment") end' \
    "$work_dir/session-workload-source.json" >"$evidence_dir/session-workload-source.json"
  printf '%s\n' "$head" >"$evidence_dir/session-source-head.txt"
  sha256sum Cargo.lock Dockerfile tools/receiving-cluster-journey-run \
    tests/integration/src/host_session_proof.rs tests/integration/src/route_authentication_live.rs \
    deploy/platform/identity/Chart.yaml deploy/platform/identity/values.yaml \
    deploy/platform/identity/templates/deployment.yaml deploy/platform/identity/templates/service.yaml \
    >"$evidence_dir/session-source-inputs.sha256"
  printf '#!/usr/bin/env bash\nexec %q --kubeconfig %q --context %q "$@"\n' \
    "$(command -v kubectl)" "$kubeconfig" "$context" >"$work_dir/session-kubectl"
  chmod 0700 "$work_dir/session-kubectl"

  session_key_command() {
    local receipt=$1; shift
    run timeout 30s "${kube[@]}" -n "$namespace" exec "deployment/$session_identity" \
      -c identity -- /usr/local/bin/wamn-identity "$@" >"$evidence_dir/$receipt.json"
  }

  session_pin_workloads() {
    local stage=$1
    run "${kube[@]}" -n "$namespace" get pods -l "$host_selector" -o json \
      >"$evidence_dir/$stage-pin-pods.json" || return 1
    run "${kube[@]}" -n "$system_namespace" get hosts -l hostgroup=default -o json \
      >"$evidence_dir/$stage-pin-hosts.json" || return 1
    jq -en --arg ns "$namespace" --arg image "$host_image" --arg digest "$host_runtime_digest" \
      --slurpfile pods "$evidence_dir/$stage-pin-pods.json" \
      --slurpfile hosts "$evidence_dir/$stage-pin-hosts.json" '
      [$pods[0].items[] | select(.metadata.deletionTimestamp == null)] as $pods |
      if ($pods | length) != 2 or (all($pods[];
        .status.phase == "Running" and
        any(.spec.containers[]; .name == "host" and .image == $image) and
        any(.status.containerStatuses[]?; .name == "host" and .ready == true and
          ((.imageID // "") | endswith($digest)))) | not)
      then error("two ready production host Pods are required") else
        [$pods[] | . as $pod | $hosts[0].items[] |
          select(.metadata.deletionTimestamp == null and .environment == $ns and .httpPort == 80 and
            (.hostId | length) > 0 and
            (.hostname == $pod.metadata.name or .hostname == $pod.status.podIP) and
            any(.status.conditions[]?; .type == "Ready" and .status == "True")) |
          {host_id:.hostId,pod_uid:$pod.metadata.uid,pod_name:$pod.metadata.name,pod_ip:$pod.status.podIP}] |
        if length == 2 and (map(.host_id) | unique | length) == 2 and
          (map(.pod_uid) | unique | length) == 2 and (map(.pod_ip) | unique | length) == 2
        then sort_by(.pod_name) | to_entries |
          map(.value + {deployment:("flow-http-session-" + (if .key == 0 then "a" else "b" end))})
        else error("two distinct ready Host records are required") end
      end
    ' >"$evidence_dir/$stage-pins.json" || return 1
    jq --slurpfile pins "$evidence_dir/$stage-pins.json" '
      (.items[] | select(.kind == "WorkloadDeployment")) as $template |
      .items = [(.items[] | select(.kind == "Service")),
        ($pins[0][] | . as $pin | $template |
          .metadata.name = $pin.deployment | .spec.replicas = 1 |
          .spec.template.spec.hostId = $pin.host_id)]
    ' "$evidence_dir/session-workload-source.json" >"$evidence_dir/$stage-workload.json" || return 1
    run "${kube[@]}" apply -f "$evidence_dir/$stage-workload.json"
  }

  session_host_endpoints() {
    local stage=$1
    local -a replica_names
    run "${kube[@]}" -n "$namespace" get workloaddeployment \
      flow-http-session-a flow-http-session-b -o json \
      >"$evidence_dir/$stage-workload-deployments.json" || return 1
    jq -e '(.items | length) == 2 and all(.items[];
      .spec.replicas == 1 and .status.currentReplicas == 1 and
      .status.replicas.expected == 1 and .status.replicas.current == 1 and
      .status.replicas.ready == 1 and (.status.replicas.unavailable // 0) == 0 and
      (.status.currentReplicaSet.name | type == "string" and length > 0) and
      any(.status.conditions[]?; .type == "Ready" and .status == "True"))' \
      "$evidence_dir/$stage-workload-deployments.json" >/dev/null || return 1
    mapfile -t replica_names < <(jq -r '.items[].status.currentReplicaSet.name' \
      "$evidence_dir/$stage-workload-deployments.json")
    run "${kube[@]}" -n "$namespace" get workloadreplicaset "${replica_names[@]}" \
      -o json >"$evidence_dir/$stage-workload-replicasets.json" || return 1
    run "${kube[@]}" -n "$namespace" get workloads -o json \
      >"$evidence_dir/$stage-workloads.json" || return 1
    run "${kube[@]}" -n "$namespace" get pods -l "$host_selector" -o json \
      >"$evidence_dir/$stage-host-pods.json" || return 1
    run "${kube[@]}" -n "$system_namespace" get hosts -l hostgroup=default -o json \
      >"$evidence_dir/$stage-hosts.json" || return 1
    run "${kube[@]}" -n "$namespace" get service flow-http -o json \
      >"$evidence_dir/$stage-service.json" || return 1
    run "${kube[@]}" -n "$namespace" get endpointslices \
      -l 'kubernetes.io/service-name=flow-http,wasmcloud.dev/route-manager=true' -o json \
      >"$evidence_dir/$stage-endpointslices.json" || return 1
    jq -en --arg ns "$namespace" --arg image "$host_image" --arg component "$flow_http_ref" \
      --arg digest "$host_runtime_digest" --arg route "$(jq -er '.route_path' "$session_fixture")" \
      --slurpfile pins "$evidence_dir/$stage-pins.json" \
      --slurpfile deployments "$evidence_dir/$stage-workload-deployments.json" \
      --slurpfile replicasets "$evidence_dir/$stage-workload-replicasets.json" \
      --slurpfile work "$evidence_dir/$stage-workloads.json" \
      --slurpfile pods "$evidence_dir/$stage-host-pods.json" \
      --slurpfile hosts "$evidence_dir/$stage-hosts.json" \
      --slurpfile slices "$evidence_dir/$stage-endpointslices.json" \
      --slurpfile service "$evidence_dir/$stage-service.json" '
      [$deployments[0].items[] | . as $deployment |
        $replicasets[0].items[] | select(.metadata.name == $deployment.status.currentReplicaSet.name and
          any(.metadata.ownerReferences[]?; .kind == "WorkloadDeployment" and .controller == true and
            .uid == $deployment.metadata.uid and .name == $deployment.metadata.name)) |
        . as $replicaset | $work[0].items[] |
        select(any(.metadata.ownerReferences[]?; .kind == "WorkloadReplicaSet" and .controller == true and
          .uid == $replicaset.metadata.uid and .name == $replicaset.metadata.name)) |
        {deployment:$deployment,replicaset:$replicaset,workload:.}] as $placements |
      [$slices[0].items[].endpoints[].addresses[]] as $addresses |
      if ($placements | length) != 2 or ($placements | map(.deployment.metadata.uid) | unique | length) != 2 or
         ($placements | map(.replicaset.metadata.uid) | unique | length) != 2 or
         ($placements | map(.workload.metadata.uid) | unique | length) != 2 or
         ($placements | map(.workload.status.hostId) | unique | length) != 2 or
         ($addresses | length) != 2 or ($addresses | unique | length) != 2 or
         (all($placements[];
           .deployment.metadata.namespace == $ns and .replicaset.metadata.namespace == $ns and
           .workload.metadata.namespace == $ns and .workload.status.environment == $ns and
           .replicaset.spec.replicas == 1 and
           (.deployment.spec.template.spec.components | length) == 1 and
           .deployment.spec.template.spec.components[0].image == $component and
           (.replicaset.spec.template.spec.components | length) == 1 and
           .replicaset.spec.template.spec.components[0].image == $component and
           (.workload.spec.components | length) == 1 and .workload.spec.components[0].image == $component and
           (.workload.status.conditions as $conditions | all(["Config","HostSelection","Placement","Sync","Ready"][];
             . as $type | any($conditions[]?; .type == $type and .status == "True")))) | not) or
         (all($slices[0].items[]; .addressType == "IPv4" and
           any(.metadata.ownerReferences[]?; .uid == $service[0].metadata.uid and .kind == "Service" and .controller == true) and
           (.ports | length) == 1 and .ports[0].port == 80 and .ports[0].protocol == "TCP" and
           all(.endpoints[]; .conditions.ready == true and .conditions.serving == true and (.addresses | length) == 1)) | not)
      then error("two-host placement is not ready") else
        [$placements[] | . as $placement | .workload.status.hostId as $id |
          $pins[0][] | select(.deployment == $placement.deployment.metadata.name and .host_id == $id and
            $placement.deployment.spec.template.spec.hostId == $id and
            $placement.replicaset.spec.template.spec.hostId == $id and
            $placement.workload.spec.hostId == $id and
            $placement.workload.spec.kubernetes.service.name == "flow-http") | . as $pin |
          $hosts[0].items[] | select(.hostId == $id and .environment == $ns and .httpPort == 80 and
            .metadata.deletionTimestamp == null and
            any(.status.conditions[]?; .type == "Ready" and .status == "True")) | .hostname as $hostname |
          $pods[0].items[] | select((.metadata.name == $hostname or .status.podIP == $hostname) and
            .metadata.uid == $pin.pod_uid and .metadata.deletionTimestamp == null and
            .status.phase == "Running" and any(.spec.containers[]; .name == "host" and .image == $image) and
            any(.status.containerStatuses[]?; .name == "host" and .ready == true and
              ((.imageID // "") | endswith($digest)))) |
          .status.podIP as $ip | select($addresses | index($ip)) |
          {deployment:$pin.deployment,deployment_uid:$placement.deployment.metadata.uid,
           replicaset_uid:$placement.replicaset.metadata.uid,
           workload_uid:$placement.workload.metadata.uid,host_id:$id,
           pod_uid:.metadata.uid,pod_name:.metadata.name,pod_ip:$ip,
           endpoint:("http://" + $ip + ":80" + $route)}] | sort_by(.host_id) |
        if length == 2 and (map(.pod_uid) | unique | length) == 2 and
           (map(.pod_ip) | unique | length) == 2 then .
        else error("two distinct host processes are not proven") end
      end
    ' >"$evidence_dir/$stage-host-endpoints.json"
  }

  for session_available in true false; do
    session_stage=host-session-reachable
    [[ "$session_available" != false ]] || session_stage=host-session-unreachable
    if [[ "$session_available" == false ]]; then
      # A new process pair makes this arm independently warm from the new key.
      # Recreate only the two owned pinned deployments, so no old Ready
      # condition can satisfy the next arm's native workload readiness wait.
      run "${kube[@]}" -n "$namespace" delete workloaddeployment \
        flow-http-session-a flow-http-session-b --cascade=foreground --wait=true --timeout=120s
      run "${kube[@]}" -n "$namespace" rollout restart deployment/hostgroup-default
      run "${kube[@]}" -n "$namespace" rollout status deployment/hostgroup-default --timeout=240s
    fi
    session_key_command "$session_stage-published" publish
    session_kid=$(jq -er '.kid | select(test("^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"))' \
      "$evidence_dir/$session_stage-published.json")
    session_key_command "$session_stage-activated" activate --kid "$session_kid"
    jq -e --arg kid "$session_kid" '.activated == true and .kid == $kid' \
      "$evidence_dir/$session_stage-activated.json" >/dev/null
    if [[ "$session_available" == true ]]; then
      # The native continuation proof uses the same real issuer through an
      # owned loopback bridge. Its token issuer stays the cluster HTTPS name;
      # only the explicitly configured fixture endpoint uses localhost.
      record_command timeout 240s "${kube[@]}" -n "$namespace" port-forward \
        --address=127.0.0.1 "service/$session_identity" :443
      coproc SESSION_NESTED_FORWARD {
        exec timeout 240s "${kube[@]}" -n "$namespace" port-forward \
          --address=127.0.0.1 "service/$session_identity" :443 2>&1
      }
      session_forward_pid=$SESSION_NESTED_FORWARD_PID
      exec {session_forward_fd}<&"${SESSION_NESTED_FORWARD[0]}"
      IFS= read -r -t 30 session_forward_line <&"$session_forward_fd" || {
        echo "nested session port-forward did not report its endpoint" >&2; exit 1;
      }
      printf '%s\n' "$session_forward_line" >"$evidence_dir/session-nested-port-forward.log"
      [[ "$session_forward_line" =~ ^Forwarding\ from\ 127\.0\.0\.1:([0-9]+)\ -\>\ 8443$ ]] || {
        echo "nested session port-forward reported an unexpected endpoint" >&2; exit 1;
      }
      session_nested_endpoint=https://localhost:${BASH_REMATCH[1]}
      record_command timeout 240s cargo test \
        route_authentication_live::production_nested_session_call_preserves_original_caller \
        '<private journey document; original issuer and explicit fixture HTTPS endpoint>'
      WAMN_JOURNEY_DOCUMENT="$journey_document" WAMN_IDENTITY_ISSUER="$session_issuer" \
      WAMN_IDENTITY_CA_FILE="$work_dir/session-ca.crt" \
      WAMN_SESSION_NESTED_HTTPS_ENDPOINT="$session_nested_endpoint" \
      CARGO_TARGET_DIR="$cargo_target_dir" RUSTC_WRAPPER= \
        timeout 240s cargo test -p wamn-proof-integration --lib --locked --offline \
        route_authentication_live::production_nested_session_call_preserves_original_caller \
        -- --ignored --exact --nocapture --test-threads=1 \
        2>&1 | tee "$evidence_dir/session-nested.log"
      assert_one_test_ran "$evidence_dir/session-nested.log" \
        production_nested_session_call_preserves_original_caller
      session_nested_receipt='HOST_SESSION_NESTED result=pass credential_kind=session invocations=2 fixture_release=3 manifest_format=1'
      [[ $(grep -Fxc -- "$session_nested_receipt" "$evidence_dir/session-nested.log") == 1 ]] || exit 1
      printf '%s\n' "$session_nested_receipt" >"$evidence_dir/session-nested.receipt"
      kill -TERM "$session_forward_pid"
      wait "$session_forward_pid" || true
      if kill -0 "$session_forward_pid" >/dev/null 2>&1; then exit 1; fi
      session_forward_pid=
      cat <&"$session_forward_fd" >>"$evidence_dir/session-nested-port-forward.log"
      exec {session_forward_fd}<&-
    fi
    if ! session_pin_workloads "$session_stage" ||
       ! run "${kube[@]}" -n "$namespace" wait --for=condition=Ready \
         workloaddeployment/flow-http-session-a workloaddeployment/flow-http-session-b --timeout=240s ||
       ! session_host_endpoints "$session_stage"; then
      run "${kube[@]}" -n "$namespace" get workloaddeployments,workloadreplicasets,workloads -o json \
        >"$evidence_dir/$session_stage-placement-state.json" 2>"$evidence_dir/$session_stage-placement-errors.log" || true
      run "${kube[@]}" -n "$namespace" logs -l "$host_selector" --all-containers --tail=-1 \
        >"$evidence_dir/$session_stage-placement-host.log" 2>&1 || true
      echo "two distinct session-serving hosts did not become ready" >&2
      exit 1
    fi
    if [[ "$session_available" == false ]]; then
      jq -en --slurpfile old "$evidence_dir/host-session-reachable-host-endpoints.json" \
        --slurpfile new "$evidence_dir/$session_stage-host-endpoints.json" '
        all(["deployment_uid","replicaset_uid","workload_uid","pod_uid","host_id"][];
          . as $field | ($old[0] | map(.[$field])) as $before |
          all($new[0][]; .[$field] as $id | ($before | index($id)) == null))
      ' >/dev/null
    fi
    session_endpoints=$(jq -er 'map(.endpoint) | join(",")' \
      "$evidence_dir/$session_stage-host-endpoints.json")
    jq -n --arg ns "$namespace" --arg name "$session_stage" --arg image "$gates_image" \
      --arg issuer "$session_issuer" --arg endpoints "$session_endpoints" --arg available "$session_available" '
      {apiVersion:"batch/v1",kind:"Job",metadata:{name:$name,namespace:$ns},
       spec:{backoffLimit:0,activeDeadlineSeconds:360,template:{spec:{restartPolicy:"Never",
        automountServiceAccountToken:false,containers:[{name:"host-session",image:$image,imagePullPolicy:"Never",
         command:["/usr/local/bin/wamn-gates","host-session-proof"],env:[
          {name:"WAMN_IDENTITY_ISSUER",value:$issuer},
          {name:"WAMN_IDENTITY_CA_FILE",value:"/etc/host-session-ca/ca.crt"},
          {name:"WAMN_HOST_SESSION_FIXTURE_FILE",value:"/etc/host-session-fixture/fixture.json"},
          {name:"WAMN_HOST_SESSION_ENDPOINTS",value:$endpoints},
          {name:"WAMN_HOST_SESSION_JWKS_AVAILABLE",value:$available}],
         volumeMounts:[{name:"ca",mountPath:"/etc/host-session-ca",readOnly:true},
           {name:"fixture",mountPath:"/etc/host-session-fixture",readOnly:true}]}],
        volumes:[{name:"ca",configMap:{name:"host-session-public-ca"}},
          {name:"fixture",secret:{secretName:"host-session-fixture",defaultMode:256}}]}}}}
    ' >"$evidence_dir/$session_stage-job.json"
    session_final="HOST_SESSION_PROOF result=pass hosts=2 jwks_available=$session_available"
    session_spec=$(jq -nc --arg name "$session_stage" --arg image "$gates_image" --arg receipt "$session_final" \
      '{name:$name,container:"host-session",expectation:"positive",exit_code:0,image:$image,log_contains:$receipt}')
    record_command env KUBECTL="$work_dir/session-kubectl" "$repo_root/tools/kubernetes-gate-run" \
      --namespace "$namespace" --timeout-secs 420 --manifest "$evidence_dir/$session_stage-job.json" \
      --verdict-record "$evidence_dir/$session_stage-verdict.json" --job "$session_spec"
    timeout 480s env KUBECTL="$work_dir/session-kubectl" "$repo_root/tools/kubernetes-gate-run" \
      --namespace "$namespace" --timeout-secs 420 --manifest "$evidence_dir/$session_stage-job.json" \
      --verdict-record "$evidence_dir/$session_stage-verdict.json" --job "$session_spec" \
      >"$evidence_dir/$session_stage-run.log" 2>&1 &
    session_gate_pid=$!
    run "${kube[@]}" -n "$namespace" wait --for=create "job/$session_stage" --timeout=60s
    session_warm=false
    record_command timeout 420s "${kube[@]}" -n "$namespace" logs -f "job/$session_stage" \
      -c host-session --pod-running-timeout=120s
    while IFS= read -r session_line; do
      printf '%s\n' "$session_line" >>"$evidence_dir/$session_stage-stream.log"
      if [[ "$session_line" == 'HOST_SESSION_WARM hosts=2' ]]; then
        [[ "$session_warm" == false ]] || { echo "duplicate session warm receipt" >&2; exit 1; }
        session_warm=true
        session_key_command "$session_stage-removed" remove --kid "$session_kid"
        jq -e --arg kid "$session_kid" '.removed == true and .kid == $kid' \
          "$evidence_dir/$session_stage-removed.json" >/dev/null
        if [[ "$session_available" == false ]]; then
          run "${kube[@]}" -n "$namespace" scale "deployment/$session_identity" --replicas=0
        fi
      fi
    done < <(timeout 420s "${kube[@]}" -n "$namespace" logs -f "job/$session_stage" \
      -c host-session --pod-running-timeout=120s 2>"$evidence_dir/$session_stage-stream-errors.log")
    session_gate_status=0
    wait "$session_gate_pid" || session_gate_status=$?
    session_gate_pid=
    run "${kube[@]}" -n "$namespace" get job "$session_stage" -o json \
      >"$evidence_dir/$session_stage-state.json"
    run "${kube[@]}" -n "$namespace" get pods -l "job-name=$session_stage" -o json \
      >"$evidence_dir/$session_stage-pods.json"
    run "${kube[@]}" -n "$namespace" logs "job/$session_stage" -c host-session \
      >"$evidence_dir/$session_stage.log"
    [[ "$session_warm" == true && "$session_gate_status" == 0 ]] || exit 1
    jq -e --arg image "$gates_image" --arg digest "$gates_runtime_digest" \
      --arg config "$gates_config_id" '.items | length == 1 and
      all(.[]; any(.spec.containers[]; .name == "host-session" and .image == $image) and
        any(.status.containerStatuses[]?; .name == "host-session" and
          .state.terminated.exitCode == 0 and
          (((.imageID // "") | endswith($digest)) or .imageID == $config)))' \
      "$evidence_dir/$session_stage-pods.json" >/dev/null
    [[ $(grep -Fxc -- "$session_final" "$evidence_dir/$session_stage.log") == 1 ]] || exit 1
    sed -n '/^HOST_SESSION/p' "$evidence_dir/$session_stage.log" >"$evidence_dir/$session_stage.receipt"
    while IFS= read -r session_pod; do
      run "${kube[@]}" -n "$namespace" logs "$session_pod" --all-containers \
        >"$evidence_dir/$session_stage-$session_pod.log"
    done < <(jq -r '.[].pod_name' "$evidence_dir/$session_stage-host-endpoints.json")
  done
