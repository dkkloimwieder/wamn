  run "${kube[@]}" -n "$namespace" wait --for=condition=Ready \
    "pod/$measurement_pod" --timeout=120s
  "${kube[@]}" -n "$namespace" get "pod/$measurement_pod" -o json \
    >"$evidence_dir/host-warm.json"
  jq -e --arg uid "$measurement_uid" '
    .metadata.uid == $uid and
    any(.status.containerStatuses[]?;
      .name == "host" and .ready == true and .restartCount == 1)
  ' >/dev/null "$evidence_dir/host-warm.json"
  "${kube[@]}" -n "$namespace" logs --timestamps "$measurement_pod" -c host \
    >"$evidence_dir/host-warm.log"
  "${kube[@]}" -n "$namespace" logs --previous --timestamps "$measurement_pod" -c host \
    >"$evidence_dir/host-cold-previous.log"
  restart_startup_ms=$(runtime_startup_ms "$evidence_dir/host-warm.log")

  for _ in $(seq 1 120); do
    "${kube[@]}" -n "$namespace" get workloads -o json \
      >"$work_dir/workloads-warm.json"
    jq -e --arg uid "$replicaset_uid" '
      [.items[] | select(any(.metadata.ownerReferences[]?; .uid == $uid))] |
      if length == 1 then .[0] else empty end
    ' "$work_dir/workloads-warm.json" \
      >"$work_dir/flow-http-workload-warm.json" 2>/dev/null || true
    "${kube[@]}" -n "$namespace" get endpointslices \
      -l 'kubernetes.io/service-name=flow-http,wasmcloud.dev/route-manager=true' -o json \
      >"$work_dir/flow-http-endpointslices-warm.json"
    if jq -e 'any(.status.conditions[]?; .type == "Ready" and .status == "True")' \
        >/dev/null "$work_dir/flow-http-workload-warm.json" 2>/dev/null &&
       jq -e '(.items | length == 1) and (.items[0].endpoints | length == 1) and
