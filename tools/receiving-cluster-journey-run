run "${kube[@]}" apply -f "$ca_copy"
run "${kube[@]}" apply -f "$repo_root/deploy/infra/wasmcloud-ca-issuer.yaml"
run "${kube[@]}" wait --for=condition=Ready clusterissuer/wasmcloud-ca --timeout=60s
environment_certs=$work_dir/host-environment-certs.yaml
sed "s/__ENVIRONMENT_NAMESPACE__/$namespace/g" \
  "$repo_root/deploy/platform/host-environment-certs.example.yaml" >"$environment_certs"
run "${kube[@]}" apply -f "$environment_certs"
run "${kube[@]}" -n "$namespace" wait --for=condition=Ready \
  certificate/wasmcloud-runtime-tls certificate/wasmcloud-data-tls --timeout=120s

host_replicas=3
if [[ "$measure_startup" == true ]]; then
  host_replicas=0
fi
host_base=$work_dir/host-base.yaml
awk -v target_namespace="$namespace" -v tag="$host_tag" -v replicas="$host_replicas" '
  /^    tag: dev$/ { print "    tag: " tag; next }
  /^      namespace: wamn-system$/ { print "      namespace: " target_namespace; next }
  /^      replicas: 3$/ { print "      replicas: " replicas; next }
