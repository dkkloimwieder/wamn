         .items[0].endpoints[0].conditions.serving == true' \
         >/dev/null "$work_dir/flow-http-endpointslices-warm.json"; then
      break
    fi
    sleep 2
  done
  cp "$work_dir/flow-http-workload-warm.json" \
    "$evidence_dir/flow-http-workload-warm.json"
  cp "$work_dir/flow-http-endpointslices-warm.json" \
    "$evidence_dir/flow-http-endpointslices-warm.json"
  jq -e 'any(.status.conditions[]?; .type == "Ready" and .status == "True")' \
    >/dev/null "$evidence_dir/flow-http-workload-warm.json"
  jq -e '(.items | length == 1) and (.items[0].endpoints | length == 1) and
    .items[0].endpoints[0].conditions.ready == true and
    .items[0].endpoints[0].conditions.serving == true' \
    >/dev/null "$evidence_dir/flow-http-endpointslices-warm.json"

  run_startup_request restart-first startup-restart-first \
    22222222222222222222222222222222 2222222222222222
  run_startup_request steady startup-steady \
    33333333333333333333333333333333 3333333333333333
  collect_trace_breakdown restart-first \
    22222222222222222222222222222222 true
