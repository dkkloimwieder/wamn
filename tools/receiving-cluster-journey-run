"${kube[@]}" -n "$namespace" get pods -l job-name=flow-http-reachability -o json \
  >"$evidence_dir/flow-http-probe-pod.json"
jq -e '.status.succeeded == 1 and
  any(.status.conditions[]?; .type == "Complete" and .status == "True")' \
  >/dev/null "$evidence_dir/flow-http-probe-job.json"
jq -e --arg image "$host_image" --arg image_id "$host_runtime_digest" '
  (.items | length == 1) and (.items[0] as $pod |
    $pod.status.phase == "Succeeded" and
    ($pod.spec.containers | length == 1) and $pod.spec.containers[0].image == $image and
    ($pod.status.containerStatuses | length == 1) and
    $pod.status.containerStatuses[0].ready == false and
    (($pod.status.containerStatuses[0].imageID // "") | endswith($image_id)))
' >/dev/null "$evidence_dir/flow-http-probe-pod.json"
"${kube[@]}" -n "$namespace" logs job/flow-http-reachability \
  >"$evidence_dir/flow-http-probe.log"
if [[ $(grep -Fc 'RECEIVING_HTTP_PROBE ' "$evidence_dir/flow-http-probe.log") -ne 1 ]]; then
  echo "flow-http probe did not emit exactly one typed-refusal receipt" >&2
  exit 1
fi
sed -n 's/^RECEIVING_HTTP_PROBE //p' "$evidence_dir/flow-http-probe.log" \
  >"$evidence_dir/flow-http-response.json"
jq -e --arg host "$route_host" '
  . == {status:404,content_type:"application/json",host:$host,
        body:{error:{code:"route-not-found"}}}
' >/dev/null "$evidence_dir/flow-http-response.json"

# Prepare the genuine post-commit trigger. It is applied only after the
# production reader, released HTTP workload, and materializer are all ready.
materializer_trigger=$work_dir/materializer-trigger.yaml
cat >"$materializer_trigger" <<EOF
apiVersion: batch/v1
kind: Job
metadata:
  name: receiving-materializer-trigger
  namespace: $namespace
spec:
  activeDeadlineSeconds: 90
  backoffLimit: 0
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: trigger
          image: $host_image
          imagePullPolicy: Never
          env:
            - name: ROUTE_CALLER_PAT
              valueFrom:
                secretKeyRef:
                  name: $route_caller_secret_name
                  key: token
          command: ["/bin/sh", "-ec"]
          args:
            - |
              update_status=\$(curl --silent --show-error --connect-timeout 5 --max-time 60 \
                --output /tmp/update.json --write-out '%{http_code}' \
                --header 'Host: $route_host' \
                --header 'Content-Type: application/json' \
                --header "Authorization: Bearer \$ROUTE_CALLER_PAT" \
                --data '[{"request_id":"materializer-order","id":"00000000-0000-0000-0000-000000000304","expected_row_version":"1","change":{"acme_inspection_required":true,"acme_quality_status":"pending"}}]' \
                'http://flow-http.$namespace.svc.cluster.local/acme/purchase_order/update')
              test "\$update_status" = 200
              receipt_status=\$(curl --silent --show-error --connect-timeout 5 --max-time 60 \
                --output /tmp/receipt.json --write-out '%{http_code}' \
                --header 'Host: $route_host' \
                --header 'Content-Type: application/json' \
                --header "Authorization: Bearer \$ROUTE_CALLER_PAT" \
                --data '[{"request_id":"materializer-receipt","value":{"idempotency_key":"materializer-receipt-command","purchase_order_id":"00000000-0000-0000-0000-000000000304","receipt_reference":"MATERIALIZER-RECEIPT","occurred_at":"2026-08-31T12:34:00.000000Z","line":[{"purchase_order_line_id":"00000000-0000-0000-0000-000000000504","quantity":"9.0000","location_id":"00000000-0000-0000-0000-000000000201"}]}}]' \
                'http://flow-http.$namespace.svc.cluster.local/acme/receiving/record_receipt')
              test "\$receipt_status" = 200
              printf 'RECEIVING_MATERIALIZER_UPDATE '
              tr -d '\n' </tmp/update.json
              printf '\nRECEIVING_MATERIALIZER_RECEIPT '
              tr -d '\n' </tmp/receipt.json
              printf '\n'
EOF
materializer_manifest=$work_dir/materializer.yaml
awk -v target_namespace="$namespace" -v image="$materializer_ref" '
  /^  name: materializer-demo$/ { print "  name: receiving-materializer"; next }
  /^  namespace: wamn-system$/ { print "  namespace: " target_namespace; next }
  /^      environment: wamn-system$/ { print "      environment: " target_namespace; next }
  /^        image: registry\.wamn-system\.svc\.cluster\.local:5000\/wamn\/materializer:dev$/ {
    print "        image: " image; next
  }
  /wamn\.tenant: t1$/ { print "            wamn.tenant: receiving-route-auth"; next }
  /wamn\.project: default$/ { print "            wamn.project: receiving"; next }
  /wamn\.environment: menv$/ { print "            wamn.environment: dev"; next }
  /WAMN_MAT_STREAM: EVT_morg_menv$/ { print "              WAMN_MAT_STREAM: EVT_acme_dev"; next }
  /WAMN_MAT_ORG: morg$/ { print "              WAMN_MAT_ORG: acme"; next }
  /WAMN_MAT_PROJECT: mproj$/ { print "              WAMN_MAT_PROJECT: receiving"; next }
  /WAMN_MAT_ENV: menv$/ { print "              WAMN_MAT_ENV: dev"; next }
  /WAMN_MAT_TENANT: t1$/ {
