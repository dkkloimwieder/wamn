# The PostgreSQL image opens a temporary server while applying init scripts,
# then stops it and starts the final server. An early pg_isready can observe the
# temporary process and race the restart. Require the second readiness marker
# over its mapped loopback port, then separately prove the kind-network address
# handed to production verbs and emitted into the original Secret artifacts.
postgres_ready=false
for _ in $(seq 1 90); do
  readiness_markers=$(docker logs "$postgres_container" 2>&1 \
    | grep -Fc 'database system is ready to accept connections' || true)
  if [[ $readiness_markers -ge 2 ]] &&
     PGPASSWORD=probe psql -h 127.0.0.1 -p "$postgres_host_port" -U postgres -d postgres \
       -Atqc 'SELECT current_setting('\''server_version_num'\'')::int >= 180000' \
       | grep -Fx t >/dev/null &&
     PGPASSWORD=probe psql -h "$postgres_ip" -p 5432 -U postgres -d postgres \
       -Atqc 'SELECT current_setting('\''server_version_num'\'')::int >= 180000' \
       | grep -Fx t >/dev/null; then
    postgres_ready=true
    break
  fi
  sleep 1
done
if [[ "$postgres_ready" != true ]]; then
  echo "owned PostgreSQL 18 did not reach final externally reachable readiness" >&2
  exit 1
fi

