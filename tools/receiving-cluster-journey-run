      [.items[] | select(.involvedObject.uid == $uid and .type == "Warning" and
        .reason == "CrossEnvironmentSchedulingDenied" and .action == "Reject")] | length >= 1
    ' >/dev/null "$work_dir/events.json"; then
    break
  fi
  sleep 2
done
jq --arg uid "$negative_uid" '
  [.items[] | select(.involvedObject.uid == $uid and .type == "Warning" and
    .reason == "CrossEnvironmentSchedulingDenied" and .action == "Reject")]
' "$work_dir/events.json" >"$evidence_dir/cross-environment-events.json"
jq -e 'length >= 1' >/dev/null "$evidence_dir/cross-environment-events.json"

