    33333333333333333333333333333333 false
  "${kube[@]}" -n "$namespace" exec "$measurement_pod" -c host -- \
    find /tmp/wamn-wasmtime-cache/modules -type f ! -name '*.stats' \
      -printf '%i %T@ %s %p\n' \
