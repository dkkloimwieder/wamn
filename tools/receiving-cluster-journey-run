  }
  { print }
' "$repo_root/deploy/platform/materializer.example.yaml" >"$materializer_manifest"
run "${kube[@]}" apply -f "$materializer_manifest"
run "${kube[@]}" -n "$namespace" wait --for=condition=Ready \
  workloaddeployment/receiving-materializer --timeout=240s
"${kube[@]}" -n "$namespace" get workloaddeployment receiving-materializer -o json \
