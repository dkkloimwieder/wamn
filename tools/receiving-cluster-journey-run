#!/usr/bin/env bash
# Prove the Receiving release on one disposable cluster without addressing kind-wamn.

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: receiving-cluster-journey-run [--apply] [--measure-startup] [--throughput] [--fresh-auth-bench] [--membershipproof] [--session-host-proof] --evidence-dir DIR

Without --apply, print the immutable plan and exit.

  --apply              Build and run the journey, then tear down owned resources
  --measure-startup    Measure cold/restart startup and two warm requests, then stop
  --throughput         After the steady request, sweep concurrency 1..64 across the
                       route, a no-DB route and the statement direct (implies
                       --measure-startup); evidence under throughput/
  --membershipproof    Prove human membership through deployed HTTP, then stop;
                       cannot combine with startup or throughput measurement
  --session-host-proof Prove session-key removal on two deployed hosts, with
                       reachable and unavailable JWKS; cannot combine modes
  --fresh-auth-bench    Repeat the existing throughput sweep three times for each
                       of service and human PATs; implies --throughput
  --evidence-dir DIR   New directory retaining commands and machine evidence

The fixed scratch cluster is wamn-receiving-journey. Every Kubernetes and Helm
command carries its private kubeconfig and context. The frozen kind-wamn cluster
is never a target.
EOF
}

apply=false
measure_startup=false
throughput=false
membershipproof=false
session_host_proof=false
standard_images=false
fresh_auth_bench=false
evidence_dir=
while (($#)); do
  case "$1" in
    --apply) apply=true; shift ;;
    --measure-startup) measure_startup=true; shift ;;
    --throughput) throughput=true; measure_startup=true; shift ;;
    --membershipproof) membershipproof=true; shift ;;
    --session-host-proof) session_host_proof=true; shift ;;
    --fresh-auth-bench) fresh_auth_bench=true; throughput=true; measure_startup=true; shift ;;
    --evidence-dir) evidence_dir=${2-}; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage; exit 2 ;;
  esac
done
if [[ "$membershipproof" == true && "$measure_startup" == true ]]; then
  echo "--membershipproof cannot combine with --measure-startup or --throughput" >&2
  exit 2
fi
if [[ "$session_host_proof" == true && ( "$membershipproof" == true || "$measure_startup" == true ) ]]; then
  echo "--session-host-proof cannot combine with other proof or measurement modes" >&2
  exit 2
fi
if [[ "$membershipproof" == true || "$session_host_proof" == true ]]; then
  standard_images=true
fi

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "$script_dir/.." && pwd)
# The shared journey harness. Each function it defines reads only what it is
# handed; see tools/journey-host-values.sh for the contract.
# shellcheck source=tools/journey-host-values.sh
source "$script_dir/journey-host-values.sh"
# shellcheck source=tools/journey-host-secrets.sh
source "$script_dir/journey-host-secrets.sh"
# shellcheck source=tools/journey-rendered-identity.sh
source "$script_dir/journey-rendered-identity.sh"
# shellcheck source=tools/journey-trace.sh
source "$script_dir/journey-trace.sh"
# shellcheck source=tools/journey-workload.sh
source "$script_dir/journey-workload.sh"
# shellcheck source=tools/journey-materializer.sh
source "$script_dir/journey-materializer.sh"
# shellcheck source=tools/journey-probe.sh
source "$script_dir/journey-probe.sh"
# shellcheck source=tools/journey-document.sh
source "$script_dir/journey-document.sh"
# shellcheck source=tools/journey-throughput.sh
source "$script_dir/journey-throughput.sh"
cd -- "$repo_root"

head=$(git rev-parse --verify HEAD)
short_head=${head:0:12}
cluster=wamn-receiving-journey
context=kind-wamn-receiving-journey
namespace=wamn-receiving-journey
system_namespace=wamn-system

# The APPLICATION'S OWN IDENTITY, named once and derived from everywhere else.
# These decide which tenant's data route authorization resolves against, so a
# renderer that hardcoded them would deploy a second application under the
# first one's tenant -- and the journey would PASS, proving the wrong thing.
app_org=acme
app_project=receiving
app_environment=dev
app_schema=receiving
app_tenant=receiving-route-auth
# The FIFTH identity claim, and the reason it is declared rather than left at
# the template's placeholder: the production activation path sets five claims
# (services/ctl/src/dev/activation.rs, flow_http_identity_claims) and this
# journey substituted four. wamn.catalog rode through as the template's
# "default" -- no anchor, no substitution, no assertion -- so a second
# application would resolve routes in the first one's catalog.
#
# THE VALUE IS default BECAUSE THAT IS WHAT THE PLATFORM PRODUCES, not because
# it is a safe-looking word. wamn-ctl provision-project-env takes --org,
# --project, --env, --schema and --tenant and has no --catalog; the dev path
# requires catalog as a validated non-empty config field, and every value it
# is ever given in this tree is "default". Naming it here says that out loud
# and gives a per-application catalog exactly one line to change when the
# provisioning vocabulary grows one.
app_catalog=default
# The workload role families THIS application's host mounts. WorkloadRoleFamily
# is a closed twelve-variant PLATFORM enum; which subset a host mounts is the
# APPLICATION's declaration. Every secret anchor below is derived from this
# list as wamn-<family>-<org>--<project>--<env>, never spelled out. The App
# family is named separately because it is the one variant whose cli_stem and
# component_stem disagree: its anchor is the platform-fixed wamn-host-db and
# its emitted file is guest-sql.json.
app_role_families=(executor-platform identity-reader http-admitter event-materializer)
app_guest_secret_anchor=wamn-host-db
app_guest_secret_file=guest-sql.json
# The host values overlay THIS application deploys. Per-app by ruling: the
# file is per-app-named, lives in the production tier, and each carries its
# own trusted identity claims, which the render asserts rather than rewrites.
app_host_values_overlay=deploy/platform/values-host-receiving-pat.yaml
# The probe request THIS application's startup measurement issues. A probe is
# THREE things -- a route, a body, and what the answer must contain -- and a
# harness holding any of them deploys one application and measures another's
# route. The third is the one worth naming: without it the probe proves only
# that something answered 200, and the restart-first 404 is exactly the case
# where that is not enough.
#
# The body is a JSON OBJECT, not a fragment: the harness merges request_id in
# with jq, so a malformed declaration fails on this machine at render time
# rather than as a 400 inside a Job forty minutes into a cluster run. The
# answer check is a jq predicate evaluated against .value of the single item.
app_probe_route=/purchase_order/get
app_probe_body='{"id":"00000000-0000-0000-0000-000000000301"}'
app_probe_value_check='.id == "00000000-0000-0000-0000-000000000301"'
# How many SQL statements THIS application's probe route issues. Everything
# else trace_is_complete checks is platform shape -- authenticate, resolve,
# pull, compile, link, instantiate, the two authority classes -- and holds for
# any caller. This one is the route's own, and a consumer whose route issues a
# different number would fail inside a platform-sounding assertion.
app_probe_statement_spans=1
# The JetStream stream the platform creates for this application's events.
# Derived, not spelled: EVT_<org>_<env> is the platform's naming, and a second
# application reading a literal would assert against the first one's stream.
app_event_stream=EVT_${app_org}_${app_environment}
# The CDC materializer workload THIS application deploys, and the Job that
# pokes it. deploy/platform/materializer.example.yaml is a GENERIC example, so
# unlike the host overlay its name is the harness's to choose -- but choosing
# it as a literal is how the second application's materializer lands under the
# first one's name, and only one of them survives the apply.
app_materializer_workload=${app_project}-materializer
app_materializer_trigger=${app_materializer_workload}-trigger
# The virtualized guest artifacts THIS application ships. The journey builds
# and pushes exactly these; a second application names its own. The names are
# the virtualizer's output stems, which is why they carry underscores where
# the package names carry hyphens.
app_components=(receiving client_acme_receiving)
chart=oci://ghcr.io/wasmcloud/charts/runtime-operator
chart_version=2.8.0
route_host=receiving.localhost
run_id=$$
host_tag=receiving-${short_head}-${run_id}-release
host_image=wamn-host:${host_tag}
gates_image=wamn-gates:${host_tag}
identity_image=wamn-identity:${host_tag}
postgres_container=wamn-receiving-pg18-${short_head}-${run_id}
registry_container=wamn-receiving-registry-${short_head}-${run_id}
nats_container=wamn-receiving-nats-${short_head}-${run_id}
cargo_target_dir=${CARGO_TARGET_DIR:-$repo_root/target}

if [[ "$apply" != true ]]; then
  printf 'Receiving cluster journey dry-run (no mutation)\n'
  printf '  source: %s\n' "$head"
  printf '  cluster/context: %s / %s\n' "$cluster" "$context"
  printf '  namespace: %s\n' "$namespace"
  printf '  route host: %s (setup overlay only)\n' "$route_host"
  if [[ "$session_host_proof" == true ]]; then
    printf '  order: Dockerfile host + gates + identity -> disposable v1 session release -> two distinct deployed hosts -> reachable/unavailable JWKS removal Jobs (300 seconds each) -> exact teardown\n'
  elif [[ "$membershipproof" == true ]]; then
    printf '  order: Dockerfile host + gates -> production mint/attest -> operator 2.8.0 -> deployed HTTP membershipproof Job -> exact teardown\n'
  elif [[ "$throughput" == true ]]; then
    printf '  order: build -> production mint/attest -> operator 2.8.0 -> cold request -> same-Pod restart -> restart-first/steady requests -> throughput sweep (route, no-DB route, direct statement; c=1..64) -> exact teardown\n'
  elif [[ "$measure_startup" == true ]]; then
    printf '  order: build -> production mint/attest -> operator 2.8.0 -> cold request -> same-Pod restart -> restart-first/steady requests -> exact teardown\n'
  else
    printf '  order: build -> production mint/attest -> CDC + JetStream -> operator 2.8.0 -> host + materializer ready -> HTTP receipt -> causal inspection + ACK -> cross-environment refusal -> exact teardown\n'
  fi
  exit 0
fi

if [[ -z "$evidence_dir" ]]; then
  usage
  exit 2
fi
# A sibling worktree may refresh Beads' passive export; it is not build input.
if [[ -n $(git status --porcelain --untracked-files=normal -- . \
    ':(exclude).beads/issues.jsonl' ':(exclude).beads/interactions.jsonl') ]]; then
  echo "refusing to build a non-clean source tree; commit the final tip first" >&2
  exit 2
fi
if [[ $(uname -m) != x86_64 ]]; then
  echo "the debug host image requires an x86_64 build host" >&2
  exit 2
fi
for required in awk bash cargo chmod cmp cp curl date docker find flock git grep head helm \
    install jq kind kubectl mkdir openssl psql rm sed seq sha256sum sleep sort tee \
    stat timeout tr wash xargs; do
  if ! command -v "$required" >/dev/null 2>&1; then
    echo "required executable not found: $required" >&2
    exit 2
  fi
done
if [[ -e "$evidence_dir" ]]; then
  echo "--evidence-dir must not already exist: $evidence_dir" >&2
  exit 2
fi
mkdir -m 0700 -- "$evidence_dir"
evidence_dir=$(cd -- "$evidence_dir" && pwd)
commands_record=$evidence_dir/commands.log
: >"$commands_record"

record_command() {
  local argument
  printf '%s ' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$commands_record"
  for argument in "$@"; do
    printf '%q ' "$argument" >>"$commands_record"
  done
  printf '\n' >>"$commands_record"
}

run() {
  record_command "$@"
  "$@"
}

run_sensitive() {
  local label=$1
  shift
  record_command "$label" '<credential-bearing arguments redacted>'
  "$@"
}

assert_can_i() {
  local expected=$1
  local verb=$2
  local resource=$3
  local subject=$4
  local receipt=$5
  local output status

  record_command "${kube[@]}" auth can-i "$verb" "$resource" \
    --namespace "$namespace" --as "$subject"
  if output=$("${kube[@]}" auth can-i "$verb" "$resource" \
      --namespace "$namespace" --as "$subject"); then
    status=0
  else
    status=$?
  fi
  case "$expected:$status:$output" in
    yes:0:yes|no:1:no) ;;
    *)
      printf 'unexpected authorization answer: verb=%s resource=%s expected=%s status=%s output=%s\n' \
        "$verb" "$resource" "$expected" "$status" "$output" >&2
      return 1
      ;;
  esac
  printf '%s=%s\n' "$verb" "$output" >>"$receipt"
}

work_dir=$(mktemp -d)
kubeconfig=$work_dir/kubeconfig
kind_config=$work_dir/kind-config.yaml
cluster_owned=false
postgres_owned=false
registry_owned=false
nats_owned=false
reader_owned=false
reader_pid=
host_image_owned=false
gates_image_owned=false
identity_image_owned=false
session_gate_pid=
session_forward_pid=
run_complete=false

cleanup() {
  local status=$? cleanup_failed=false failure_capture_errors
  trap - EXIT HUP INT TERM
  # Opt-in hold BEFORE teardown, so an observer can keep watching cluster state
  # past the point where this run gives up. Unset by default, so no run changes
  # behaviour unless it is asked for. It exists because the question "does the
  # route ever come back after the restart arm fails" is unanswerable once the
  # cluster is deleted (wamn-0h0g.17.20).
  if [[ -n "${WAMN_JOURNEY_HOLD_SECONDS:-}" ]]; then
    echo "journey holding ${WAMN_JOURNEY_HOLD_SECONDS}s before teardown (status=$status)" >&2
    sleep "$WAMN_JOURNEY_HOLD_SECONDS" || true
  fi
  set +e

  if [[ -n "$session_gate_pid" ]]; then
    kill -TERM "$session_gate_pid" >/dev/null 2>&1 || true
    wait "$session_gate_pid" >/dev/null 2>&1 || true
  fi
  if [[ -n "$session_forward_pid" ]]; then
    kill -TERM "$session_forward_pid" >/dev/null 2>&1 || true
    wait "$session_forward_pid" >/dev/null 2>&1 || true
    kill -0 "$session_forward_pid" >/dev/null 2>&1 && cleanup_failed=true
  fi

  if [[ "$reader_owned" == true && -n "$reader_pid" ]]; then
    if kill -0 "$reader_pid" 2>/dev/null; then
      record_command kill -TERM "$reader_pid"
      kill -TERM "$reader_pid" >/dev/null 2>&1 || cleanup_failed=true
      for _ in $(seq 1 50); do
        kill -0 "$reader_pid" 2>/dev/null || break
        sleep 0.1
      done
      if kill -0 "$reader_pid" 2>/dev/null; then
        kill -KILL "$reader_pid" >/dev/null 2>&1 || true
        cleanup_failed=true
      fi
    fi
    wait "$reader_pid" >/dev/null 2>&1 || true
    kill -0 "$reader_pid" 2>/dev/null && cleanup_failed=true
  fi

  if [[ $status -ne 0 && "$cluster_owned" == true && -s "$kubeconfig" ]] &&
     kind get clusters 2>/dev/null | grep -Fx -- "$cluster" >/dev/null; then
    failure_capture_errors=$evidence_dir/failure-capture-errors.log
    record_command kubectl --kubeconfig "$kubeconfig" --context "$context" \
      -n "$namespace" get deployment hostgroup-default -o json
    kubectl --kubeconfig "$kubeconfig" --context "$context" \
      -n "$namespace" get deployment hostgroup-default -o json \
      >"$evidence_dir/failure-host-deployment.json" 2>>"$failure_capture_errors"
    record_command kubectl --kubeconfig "$kubeconfig" --context "$context" \
      -n "$namespace" get pods -o json
    kubectl --kubeconfig "$kubeconfig" --context "$context" \
      -n "$namespace" get pods -o json \
      >"$evidence_dir/failure-pods.json" 2>>"$failure_capture_errors"
    record_command kubectl --kubeconfig "$kubeconfig" --context "$context" \
      -n "$namespace" get events -o json
    kubectl --kubeconfig "$kubeconfig" --context "$context" \
      -n "$namespace" get events -o json \
      >"$evidence_dir/failure-events.json" 2>>"$failure_capture_errors"
    record_command kubectl --kubeconfig "$kubeconfig" --context "$context" \
      -n "$namespace" get secrets -o name
    kubectl --kubeconfig "$kubeconfig" --context "$context" \
      -n "$namespace" get secrets -o name \
      >"$evidence_dir/failure-secret-names.txt" 2>>"$failure_capture_errors"

    # Everything above says WHAT failed. This says why. A probe Job writes its
    # HTTP status and body to stdout, and those go with the Pod when it is
    # reaped -- so a run that dies on a probe leaves behind an exit code and no
    # cause, and diagnosing it costs a whole second cluster. One `logs` call per
    # unfinished Job is the cheapest evidence in this file.
    record_command kubectl --kubeconfig "$kubeconfig" --context "$context" \
      -n "$namespace" get jobs -o json
    kubectl --kubeconfig "$kubeconfig" --context "$context" \
      -n "$namespace" get jobs -o json \
      >"$evidence_dir/failure-jobs.json" 2>>"$failure_capture_errors"
    # Unfinished means "no Complete condition" rather than "Failed condition":
    # a Job still retrying, or one whose Pod never scheduled, has neither, and
    # those are exactly the cases with no other explanation.
    while read -r unfinished_job; do
      [[ -n "$unfinished_job" ]] || continue
      record_command kubectl --kubeconfig "$kubeconfig" --context "$context" \
        -n "$namespace" logs "job/$unfinished_job" --all-containers --tail=-1
      kubectl --kubeconfig "$kubeconfig" --context "$context" \
        -n "$namespace" logs "job/$unfinished_job" --all-containers --tail=-1 \
        >"$evidence_dir/failure-job-$unfinished_job.log" 2>>"$failure_capture_errors"
    done < <(jq -r '
      .items[]
      | select(((.status.conditions // [])
          | any(.type == "Complete" and .status == "True")) | not)
      | .metadata.name
    ' "$evidence_dir/failure-jobs.json" 2>>"$failure_capture_errors")
  fi

  if [[ "$cluster_owned" == true ]] &&
     kind get clusters 2>/dev/null | grep -Fx -- "$cluster" >/dev/null; then
    record_command kind delete cluster --name "$cluster"
    kind delete cluster --name "$cluster" >/dev/null 2>&1 || cleanup_failed=true
  fi
  if [[ "$postgres_owned" == true ]] &&
     docker container inspect "$postgres_container" >/dev/null 2>&1; then
    record_command docker rm --force --volumes "$postgres_container"
    docker rm --force --volumes "$postgres_container" >/dev/null 2>&1 || cleanup_failed=true
  fi
  if [[ "$registry_owned" == true ]] &&
     docker container inspect "$registry_container" >/dev/null 2>&1; then
    record_command docker rm --force --volumes "$registry_container"
    docker rm --force --volumes "$registry_container" >/dev/null 2>&1 || cleanup_failed=true
  fi
  if [[ "$nats_owned" == true ]] &&
     docker container inspect "$nats_container" >/dev/null 2>&1; then
    record_command docker rm --force --volumes "$nats_container"
    docker rm --force --volumes "$nats_container" >/dev/null 2>&1 || cleanup_failed=true
  fi
  if [[ "$gates_image_owned" == true ]] &&
     docker image inspect "$gates_image" >/dev/null 2>&1; then
    record_command docker image rm "$gates_image"
    docker image rm "$gates_image" >/dev/null 2>&1 || cleanup_failed=true
  fi
  if [[ "$host_image_owned" == true ]] &&
     docker image inspect "$host_image" >/dev/null 2>&1; then
    record_command docker image rm "$host_image"
    docker image rm "$host_image" >/dev/null 2>&1 || cleanup_failed=true
  fi
  if [[ "$identity_image_owned" == true ]] &&
     docker image inspect "$identity_image" >/dev/null 2>&1; then
    record_command docker image rm "$identity_image"
    docker image rm "$identity_image" >/dev/null 2>&1 || cleanup_failed=true
  fi

  if kind get clusters 2>/dev/null | grep -Fx -- "$cluster" >/dev/null; then
    cleanup_failed=true
  fi
  if docker container inspect "$postgres_container" >/dev/null 2>&1; then
    cleanup_failed=true
  fi
  if docker container inspect "$registry_container" >/dev/null 2>&1; then
    cleanup_failed=true
  fi
  if docker container inspect "$nats_container" >/dev/null 2>&1; then
    cleanup_failed=true
  fi
  if docker image inspect "$host_image" >/dev/null 2>&1; then
    cleanup_failed=true
  fi
  if [[ "$standard_images" == true ]] &&
     docker image inspect "$gates_image" >/dev/null 2>&1; then
    cleanup_failed=true
  fi
  if [[ "$session_host_proof" == true ]] &&
     docker image inspect "$identity_image" >/dev/null 2>&1; then
    cleanup_failed=true
  fi
  record_command rm -rf -- "$work_dir"
  rm -rf -- "$work_dir" || cleanup_failed=true
  [[ ! -e "$work_dir" ]] || cleanup_failed=true

  if [[ "$cleanup_failed" == false ]]; then
    printf 'verdict=pass cluster=%s containers=%s,%s,%s reader_pid=%s image=%s\n' \
      "$cluster" "$postgres_container" "$registry_container" "$nats_container" \
      "$reader_pid" "$host_image" \
      >"$evidence_dir/cleanup.receipt"
  else
    printf 'verdict=fail cluster=%s containers=%s,%s,%s reader_pid=%s image=%s\n' \
      "$cluster" "$postgres_container" "$registry_container" "$nats_container" \
      "$reader_pid" "$host_image" \
      >"$evidence_dir/cleanup.receipt"
    [[ $status -ne 0 ]] || status=1
  fi
  if [[ "$standard_images" == true ]]; then
    printf 'gates_image=%s\n' "$gates_image" >>"$evidence_dir/cleanup.receipt"
  fi
  if [[ "$session_host_proof" == true ]]; then
    printf 'identity_image=%s\n' "$identity_image" >>"$evidence_dir/cleanup.receipt"
  fi

  if [[ $status -eq 0 && "$run_complete" == true && "$cleanup_failed" == false ]]; then
    if [[ "$session_host_proof" == true ]]; then
      printf 'RECEIVING HOST SESSION PROOF PASS source=%s namespace=%s hosts=2 reachable=pass unreachable=pass cleanup=pass\n' \
        "$head" "$namespace" >"$evidence_dir/session-host-proof-journey.receipt"
    elif [[ "$membershipproof" == true ]]; then
      printf 'RECEIVING MEMBERSHIP PROOF PASS source=%s namespace=%s rerun=human-membership-http,production-ctl,exact-cleanup\n' \
        "$head" "$namespace" >"$evidence_dir/membershipproof-journey.receipt"
    elif [[ "$measure_startup" == true ]]; then
      printf 'RECEIVING STARTUP MEASUREMENT PASS source=%s namespace=%s\n' \
        "$head" "$namespace" >"$evidence_dir/startup-measurement.receipt"
    else
      printf 'RECEIVING CLUSTER JOURNEY PASS source=%s namespace=%s host=%s cited=RC-851acb80:bootstrap,M2-supersession,socketguard,traceproof,scoped-RegistryReader rerun=materializer-journey,native-scheduling,exact-cleanup\n' \
        "$head" "$namespace" "$route_host" >"$evidence_dir/journey.receipt"
    fi
    (
      cd -- "$evidence_dir" || exit 1
      find . -maxdepth 1 -type f ! -name evidence.sha256 -print0 \
        | sort -z | xargs -0 sha256sum >evidence.sha256
    ) || status=1
  elif [[ $status -eq 0 ]]; then
    status=1
  fi

  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

lock_file=${TMPDIR:-/tmp}/wamn-receiving-cluster-journey.lock
exec 9>"$lock_file"
if ! flock -n 9; then
  echo "another Receiving cluster journey owns the fixed scratch name" >&2
  exit 2
fi
if kind get clusters | grep -Fx -- "$cluster" >/dev/null; then
  echo "refusing pre-existing kind cluster: $cluster" >&2
  exit 2
fi
for container in "$postgres_container" "$registry_container" "$nats_container"; do
  if docker container inspect "$container" >/dev/null 2>&1; then
    echo "refusing pre-existing container: $container" >&2
    exit 2
  fi
done
if docker image inspect "$host_image" >/dev/null 2>&1; then
  echo "refusing pre-existing host image: $host_image" >&2
  exit 2
fi
if [[ "$standard_images" == true ]] &&
   docker image inspect "$gates_image" >/dev/null 2>&1; then
  echo "refusing pre-existing gates image: $gates_image" >&2
  exit 2
fi
if [[ "$session_host_proof" == true ]] &&
   docker image inspect "$identity_image" >/dev/null 2>&1; then
  echo "refusing pre-existing identity image: $identity_image" >&2
  exit 2
fi

awk '
  /^    extraPortMappings:/ { skipping = 1; next }
  skipping && /^      / { next }
  { skipping = 0; print }
' "$repo_root/deploy/infra/kind-config.yaml" >"$kind_config"
if [[ $(grep -c '^  - role:' "$kind_config") -ne 3 ]] ||
   grep -q 'extraPortMappings\|hostPort:' "$kind_config"; then
  echo "rendered kind config did not retain exactly three nodes without host ports" >&2
  exit 2
fi

run env CARGO_TARGET_DIR="$cargo_target_dir" RUSTC_WRAPPER= \
  "$repo_root/tools/build-components" m1
# THE HOST IS A RELEASE BUILD (wamn-0h0g.17.31). Through 6-throughput.md the
# journey copied target/debug/wamn-host into its image and measured that: 15-33
# ms of host CPU per request, a knee at four clients on a 2-core quota. The
# two-stage Dockerfile has always built the host with --release; only this path
