  first_gates_image_tuple=
  while IFS= read -r node; do
    inspect=$(docker exec "$node" crictl inspecti -o json "$gates_image")
    # Containerd may expose only the config digest for a locally loaded gates
    # image (as in the retained IDENTITY-SESSION deployed evidence).
    runtime_digest=$(jq -er --arg session "$session_host_proof" '
      .status as $status |
      [.status.repoDigests[]? |
       capture("@(?<digest>sha256:[0-9a-f]{64})$").digest] | unique |
      if length == 1 then .[0]
      elif length == 0 and $session == "true" then
        $status.id | select(test("^sha256:[0-9a-f]{64}$"))
      else error("runtime digest missing or ambiguous") end
    ' <<<"$inspect")
    config_id=$(jq -er '.status.id | select(test("^sha256:[0-9a-f]{64}$"))' <<<"$inspect")
    tuple="$runtime_digest $config_id"
    if [[ -z "$first_gates_image_tuple" ]]; then
      first_gates_image_tuple=$tuple
    elif [[ "$first_gates_image_tuple" != "$tuple" ]]; then
      echo "gates image tuple differs across kind nodes" >&2
