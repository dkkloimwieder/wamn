      '{node:$node,runtime_digest:$digest,config_id:$config}' \
      >>"$evidence_dir/gates-image-nodes.jsonl"
  done < <(kind get nodes --name "$cluster" | sort)
  read -r gates_runtime_digest gates_config_id <<<"$first_gates_image_tuple"
fi
if [[ "$session_host_proof" == true ]]; then
