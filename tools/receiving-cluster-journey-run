jq -e --arg namespace "$namespace" '
  ([.[] | select(.name == "wamn" and .namespace == "wamn-system" and
                 .status == "deployed" and .chart == "runtime-operator-2.8.0" and
                 .app_version == "2.8.0")] | length == 1) and
  ([.[] | select(.name == "wamn-host" and .namespace == $namespace and
                 .status == "deployed" and .chart == "runtime-operator-2.8.0" and
                 .app_version == "2.8.0")] | length == 1)
' >/dev/null "$evidence_dir/helm-releases.json"
"${kube[@]}" -n "$namespace" get deployment hostgroup-default -o json \
  >"$evidence_dir/host-deployment.json"
jq -e --arg image "$host_image" --argjson replicas "$host_replicas" '
  .status.observedGeneration == .metadata.generation and
  .spec.replicas == $replicas and .status.updatedReplicas == $replicas and
  .status.readyReplicas == $replicas and .status.availableReplicas == $replicas and
  any(.spec.template.spec.containers[]?; .image == $image)
' >/dev/null "$evidence_dir/host-deployment.json"
host_selector=$(jq -er '
  .spec.selector.matchLabels | to_entries |
  if length == 0 then error("empty host selector")
  else map("\(.key)=\(.value)") | join(",") end
' "$evidence_dir/host-deployment.json")
"${kube[@]}" -n "$namespace" get pods -l "$host_selector" -o json \
  >"$evidence_dir/host-pods.json"
jq -e --arg image "$host_image" --arg image_id "$host_runtime_digest" \
  --argjson replicas "$host_replicas" '
