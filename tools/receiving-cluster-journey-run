      capture("@(?<digest>sha256:[0-9a-f]{64})$").digest] | unique |
      if length == 1 then .[0] else error("identity runtime digest missing or ambiguous") end' \
      "$evidence_dir/identity-image-$node.json")
    config_id=$(jq -er '.status.id | select(test("^sha256:[0-9a-f]{64}$"))' \
      "$evidence_dir/identity-image-$node.json")
    tuple="$runtime_digest $config_id"
    if [[ -z "$first_identity_image_tuple" ]]; then
      first_identity_image_tuple=$tuple
    elif [[ "$first_identity_image_tuple" != "$tuple" ]]; then
      echo "identity image tuple differs across kind nodes" >&2
      exit 1
    fi
  done < <(kind get nodes --name "$cluster" | sort)
  read -r identity_runtime_digest identity_config_id <<<"$first_identity_image_tuple"
fi

