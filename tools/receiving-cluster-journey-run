if [[ "$measure_startup" == true ]]; then
  run_startup_request() {
    local phase=$1 request_id=$2 trace_id=$3 parent_span_id=$4 job="startup-request-$1"
    local manifest=$work_dir/$job.yaml
    cat >"$manifest" <<EOF
apiVersion: batch/v1
kind: Job
metadata:
  name: $job
  namespace: $namespace
spec:
  activeDeadlineSeconds: 90
  backoffLimit: 0
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: probe
          image: $host_image
          imagePullPolicy: Never
          env:
            - name: ROUTE_CALLER_PAT
              valueFrom:
                secretKeyRef:
                  name: $route_caller_secret_name
                  key: token
          command: ["/bin/sh", "-ec"]
          args:
            - |
              # BOUNDED RETRY, reporting EVERY attempt. The question this
              # answers is product-versus-journey: a route that returns 404
              # immediately after a host restart and then recovers means
              # Kubernetes readiness precedes in-host route registration and
              # this journey waited on the wrong signal; one that never
              # recovers means released routes are lost across a restart. A
              # single attempt cannot tell those apart, and every attempt's
              # status and elapsed time is the measurement.
              probe_start=\$(date +%s)
              attempt=0
              while :; do
                attempt=\$((attempt + 1))
                metrics=\$(curl --silent --show-error --connect-timeout 5 --max-time 60 \\
                  --output /tmp/body --write-out '%{http_code} %{time_starttransfer} %{time_total}' \\
                  --header 'Host: $route_host' \\
                  --header 'Content-Type: application/json' \\
                  --header "Authorization: Bearer \$ROUTE_CALLER_PAT" \\
                  --header 'traceparent: 00-$trace_id-$parent_span_id-01' \\
                  --data '[{"request_id":"$request_id","id":"00000000-0000-0000-0000-000000000301"}]' \\
                  'http://flow-http.$namespace.svc.cluster.local/purchase_order/get') || metrics='000 0 0'
                set -- \$metrics
                probe_elapsed=\$(( \$(date +%s) - probe_start ))
                printf '%s\\n' \\
                  "RECEIVING_STARTUP_ATTEMPT phase=$phase attempt=\$attempt status=\$1 since_restart_seconds=\$probe_elapsed time_total_seconds=\$3"
                [ "\$1" = 200 ] && break
                [ "\$probe_elapsed" -ge 45 ] && break
                sleep 1
              done
              # REPORT BEFORE ASSERTING. The shell is `sh -ec`, so a failing
              # `test` exits here and anything printed after it is never
              # printed at all -- which made a non-200 probe silent by
              # construction: exit 1, an empty log, and no way to tell a 503
              # from a timeout without another cluster.
              printf '%s\n' \\
                "RECEIVING_STARTUP_REQUEST phase=$phase status=\$1 time_starttransfer_seconds=\$2 time_total_seconds=\$3"
              printf 'RECEIVING_STARTUP_BODY '
              tr -d '\n' </tmp/body
              printf '\n'
              test "\$1" = 200
EOF
    run "${kube[@]}" apply -f "$manifest"
    run "${kube[@]}" -n "$namespace" wait --for=condition=Complete \
      "job/$job" --timeout=90s
    "${kube[@]}" -n "$namespace" logs "job/$job" \
      >"$evidence_dir/first-request-$phase.log"
    if [[ $(grep -Fc 'RECEIVING_STARTUP_REQUEST ' \
        "$evidence_dir/first-request-$phase.log") -ne 1 ]]; then
      echo "$phase request emitted no unique timing receipt" >&2
      exit 1
    fi
    sed -n 's/^RECEIVING_STARTUP_BODY //p' \
      "$evidence_dir/first-request-$phase.log" \
      >"$evidence_dir/first-request-$phase-response.json"
    jq -e --arg request_id "$request_id" '
      type == "array" and length == 1 and
      .[0].request_id == $request_id and
      (.[0] | has("error") | not) and
      .[0].value.id == "00000000-0000-0000-0000-000000000301"
    ' >/dev/null "$evidence_dir/first-request-$phase-response.json"
    awk -v phase="$phase" '
      /^RECEIVING_STARTUP_REQUEST / {
        for (field = 1; field <= NF; field++) {
          split($field, pair, "=")
          if (pair[1] == "status") status = pair[2]
          if (pair[1] == "time_starttransfer_seconds") first = pair[2]
          if (pair[1] == "time_total_seconds") total = pair[2]
        }
      }
      END {
        if (status != "200" || first !~ /^[0-9]+\.[0-9]+$/ ||
            total !~ /^[0-9]+\.[0-9]+$/) exit 1
        printf "verdict=pass phase=%s status=%s first_byte_ms=%.3f total_ms=%.3f\n",
          phase, status, first * 1000, total * 1000
      }
    ' "$evidence_dir/first-request-$phase.log" \
      >"$evidence_dir/first-request-$phase.receipt"
    printf '%s\n' "$trace_id" >"$evidence_dir/first-request-$phase.trace-id"
  }

  collect_trace_breakdown() {
    local phase=$1 trace_id=$2 expect_executor=$3
    local trace_file=$evidence_dir/trace-$phase.json
    local breakdown_file=$evidence_dir/trace-breakdown-$phase.json
    local proxy_path=/api/v1/namespaces/$system_namespace/services/http:tempo:3200/proxy/api/traces/$trace_id
