for _ in $(seq 1 120); do
  if "${kube[@]}" -n "$namespace" get workload flow-http-cross-environment -o json \
      >"$work_dir/cross-environment-workload.json" 2>/dev/null &&
     jq -e '
       any(.status.conditions[]?; .type == "HostSelection" and .status == "False")
     ' >/dev/null "$work_dir/cross-environment-workload.json"; then
    break
  fi
  sleep 2
done
cp "$work_dir/cross-environment-workload.json" \
  "$evidence_dir/cross-environment-workload.json"
