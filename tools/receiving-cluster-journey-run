#!/usr/bin/env bash
# The Rust application test owns inputs, names, readiness, results, and cleanup.
set -euo pipefail
action=${1:?lifecycle action}
cluster=${2:?cluster or container name}
case "$cluster" in wamn) printf 'The kind-wamn cluster is frozen.\n' >&2; exit 64 ;; esac
chart=oci://ghcr.io/wasmcloud/charts/runtime-operator
cache="$(dirname -- "${BASH_SOURCE[0]}")/journey-image-cache"
case "$action" in
  docker-version) docker info --format '{{json .ServerVersion}}' ;;
  clusters) kind get clusters ;;
  containers) docker container ls --all --format '{{json .Names}}' ;;
  images) docker image ls --format '{{json .Repository}} {{json .Tag}}' ;;
  prepare-registry) docker run --rm -i --entrypoint htpasswd httpd:2-alpine -Bni "${3:?username}" ;;
  build-images)
    repository=${4:?repository}; source=${5:?source}; tag=${6:?tag}; shift 6
    # An image of this source is reused when one exists, and relabeled to the
    # run's own tag. Only the identity image survives the run (wamn-szr0).
    for target in "$@"; do
      "$cache" ensure "$repository" "$target" "$target" "$source" "$tag" "$cluster"
    done
    ;;
  build-identity)
    repository=${3:?repository}; source=${4:?source}; tag=${5:?tag}
    "$cache" ensure "$repository" identity identity "$source" "$tag" "$cluster"
    ;;
  create)
    work=${3:?work directory}; repository=${4:?repository}; shift 4
    kind create cluster --name "$cluster" --config "$work/kind.yaml" --kubeconfig "$work/kubeconfig"
    if [[ -n ${WAMN_DELIVERY_CANDIDATE:-} ]]; then
      for node in $(kind get nodes --name "$cluster"); do
        if [[ -f $work/native-registry-authority ]]; then
          authority=$(cat "$work/native-registry-authority")
          docker exec "$node" mkdir -p "/etc/containerd/certs.d/$authority"
          docker cp "$work/native-registry-hosts.toml" "$node:/etc/containerd/certs.d/$authority/hosts.toml"
        fi
        for image in "$@"; do
          # CRI removes a tag when resolving a digest-pinned image.
          pull_image=${image%@*}
          if [[ ${pull_image##*/} == *:* ]]; then pull_image=${pull_image%:*}; fi
          pull_image="$pull_image@${image##*@}"
          timeout 180 docker exec "$node" ctr --namespace k8s.io images pull \
            --hosts-dir /etc/containerd/certs.d --platform linux/amd64 "$pull_image" || {
            printf 'Cannot pull supplied image %s into owned node %s; its registry must permit access without additional credentials.\n' "$image" "$node" >&2
            exit 1
          }
          docker exec "$node" crictl inspecti -o json "$image" >/dev/null
        done
      done
    else
      for image in "$@"; do kind load docker-image "$image" --name "$cluster"; done
    fi
    docker run --detach --name "$cluster-postgres" --network kind --env POSTGRES_PASSWORD=probe \
      --publish 127.0.0.1::5432 \
      --volume "$repository/deploy/sql/postgres-init.sql:/docker-entrypoint-initdb.d/postgres-init.sql:ro" \
      postgres:18 -c wal_level=logical -c max_replication_slots=10 -c max_wal_senders=10
    docker run --detach --name "$cluster-registry" --network kind --env REGISTRY_AUTH=htpasswd \
      --env 'REGISTRY_AUTH_HTPASSWD_REALM=WAMN Receiving cluster journey' --env REGISTRY_AUTH_HTPASSWD_PATH=/auth/htpasswd \
      --volume "$work/registry/htpasswd:/auth/htpasswd:ro" registry:2
    docker run --detach --name "$cluster-nats" --network kind \
      --volume "$work/event-nats/nats.conf:/etc/nats/event-nats.conf:ro" \
      nats:2.10-alpine --config /etc/nats/event-nats.conf --jetstream --store_dir /data
    ;;
  install-operator)
    work=${3:?work directory}; values=${4:?operator values}
    helm upgrade --install --create-namespace --kubeconfig "$work/kubeconfig" \
      --kube-context "kind-$cluster" --namespace wamn-system wamn "$chart" --version 2.10.0 \
      -f "$work/operator-base.yaml" -f "$values" --wait --timeout 5m
    ;;
  install-host)
    work=${3:?work directory}; namespace=${4:?namespace}; base=${5:?base values}; overlay=${6:?overlay values}
    helm upgrade --install --kubeconfig "$work/kubeconfig" --kube-context "kind-$cluster" \
      --namespace "$namespace" wamn-host "$chart" --version 2.10.0 \
      -f "$base" -f "$overlay" --wait --timeout 5m
    ;;
  helm-releases) helm list --kubeconfig "${3:?work directory}/kubeconfig" --kube-context "kind-$cluster" --all-namespaces -o json ;;
  inspect) docker container inspect --format '{{json .NetworkSettings}}' "$cluster" ;;
  container-logs) docker logs "$cluster" 2>&1 ;;
  broker-varz) docker exec "$cluster" wget -qO- -T 5 http://127.0.0.1:8222/varz ;;
  container-cpu) docker exec "$cluster" cat /sys/fs/cgroup/cpu.stat ;;
  image-labels) docker image inspect --format '{{json .Config.Labels}}' "$cluster" ;;
  image-layers) docker image inspect --format '{{json .RootFS.Layers}}' "$cluster" ;;
  nodes) kind get nodes --name "$cluster" ;;
  node-image) docker exec "$cluster" crictl inspecti -o json "${3:?image}" ;;
  # A kind load can report success while the node's CRI does not hold the
  # image. These two views of one node say which of them is missing it,
  # and they run when the image check fails (wamn-y2ml).
  node-cri-images) docker exec "$cluster" crictl images -o json ;;
  node-containerd-images) docker exec "$cluster" ctr --namespace k8s.io images ls ;;
  edge-bucket)
    # The object store of the kind edge holds one build, readable without
    # credentials. minio.env names MINIO_ROOT_USER and MINIO_ROOT_PASSWORD.
    work=${3:?work directory}; dist=${4:?build directory}
    docker run --detach --name "$cluster-minio" --network kind --env-file "$work/minio.env" \
      minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e server /data
    docker run --rm --network "container:$cluster-minio" --env-file "$work/minio.env" \
      --volume "$dist:/dist:ro" --entrypoint sh \
      minio/mc@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727 -c '
        for attempt in $(seq 60); do
          mc alias set edge http://127.0.0.1:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null 2>&1 && break
          sleep 1
        done
        mc mb edge/web && mc cp --recursive /dist/ edge/web/ && mc anonymous set download edge/web'
    ;;
  remove)
    # Without the work directory, as after a killed run, this removes the
    # cluster and its containers, and skips the kubeconfig and the registry.
    work=${3:-}; shift $(($# < 3 ? $# : 3))
    status=0
    kubeconfig=()
    [[ -z $work ]] || kubeconfig=(--kubeconfig "$work/kubeconfig")
    kind delete cluster --name "$cluster" "${kubeconfig[@]}" || status=$?
    for suffix in postgres registry nats minio; do
      if docker container inspect "$cluster-$suffix" >/dev/null 2>&1; then
        docker rm --force --volumes "$cluster-$suffix" || status=$?
      fi
    done
    if [[ -n $work && -f $work/native-registry-owned ]]; then
      "$(dirname -- "${BASH_SOURCE[0]}")/delivery-owned" remove-native "$cluster" "$work" || status=$?
    fi
    for image in "$@"; do
      if docker image inspect "$image" >/dev/null 2>&1; then
        docker image rm --force "$image" || status=$?
      fi
    done
    # The run's own tags are gone above. The identity images stay for the next
    # run of this source, bounded by the retention rule (wamn-szr0).
    "$cache" release "$cluster" || status=$?
    for name in host gates identity; do
      "$cache" retain "$name" || status=$?
    done
    exit "$status"
    ;;
  *) printf 'Unknown lifecycle action: %s\n' "$action" >&2; exit 64 ;;
esac
