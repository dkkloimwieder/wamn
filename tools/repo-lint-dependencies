#!/usr/bin/env python3
"""Enforce native dependency boundaries."""

import subprocess
import sys

EDGE_REFUSED = {
    "wamn-runtime": "the edge never links the cloud plugin set",
    "wamn-workflow": "the edge links no workflow layer",
    "wamn-router": "routes-router rule 7: the base platform and the edge do not link the router",
    "wamn-execution-host": "the cloud execution host depends on wamn-runtime",
    "wamn-platform-identity": "it links tokio-postgres; the edge verifies sessions through wamn-identity-protocol",
    "tokio-postgres": "the edge links no Postgres",
    "deadpool-postgres": "the edge links no Postgres",
    "postgres-types": "the edge links no Postgres",
    "async-nats": "the edge links no NATS",
    "object_store": "the edge links no network service",
    "redis": "the edge links no network service",
    "oci-client": "the edge links no OCI registry client",
    "oci-wasm": "the edge links no OCI registry client",
    "opentelemetry-otlp": "the edge links no OTLP gRPC exporter",
    "tonic": "the edge links no OTLP gRPC exporter"
}

EDGE_WASH = [
    "async-nats",
    "opentelemetry-otlp",
    "redis",
    "tonic"
]

ENGINE_REFUSED = {
    "tokio-postgres": "the engine links no Postgres",
    "deadpool-postgres": "the engine links no Postgres",
    "postgres-types": "the engine links no Postgres",
    "async-nats": "the engine links no network service",
    "object_store": "the engine links no network service",
    "redis": "the engine links no network service",
    "oci-client": "the engine links no OCI registry client",
    "oci-wasm": "the engine links no OCI registry client",
    "hyper-util": "the engine links no HTTP client",
    "hyper-rustls": "the engine links no HTTP client",
    "reqwest": "the engine links no HTTP client",
    "opentelemetry-otlp": "the engine links no OTLP gRPC exporter",
    "tonic": "the engine links no OTLP gRPC exporter",
    "wamn-router": "routes-router rule 7: the base platform and the edge do not link the router",
    "wamn-runtime": "the plugin set sits above the engine and the edge never links it"
}

ENGINE_WASH = [
    "async-nats",
    "hyper-rustls",
    "hyper-util",
    "opentelemetry-otlp",
    "redis",
    "tonic"
]


def dependencies(package, *extra):
    command = [sys.argv[1], "tree", "-p", package, "-e", "normal", *extra,
               "--prefix", "none", "--locked", "--offline"]
    result = subprocess.run(command, check=True, capture_output=True, text=True)
    return {line.split()[0] for line in result.stdout.splitlines() if line.split()}


def require(condition, reason):
    if not condition:
        raise ValueError(reason)


def boundary(package, refused, accepted, *target):
    # Requirement: edge/engine own no cloud plugins outside wash-runtime (docs/architecture/overview.md, Runtime owners).
    outside = dependencies(package, *target, "--prune", "wash-runtime")
    violations = {name: rule for name, rule in refused.items() if name in outside}
    require(not violations, f"{package} {target} links forbidden dependencies: {violations}")
    linked = dependencies(package, *target)
    present = set(refused) & linked
    # Requirement: only the service dependencies accepted in wamn-qt1t can enter through wash-runtime.
    require(present <= set(accepted),
            f"{package} {target} links forbidden dependencies through wash-runtime: {present - set(accepted)}")
    return linked


try:
    # Requirement: the edge keeps its cloud-service boundary on native and device targets.
    for target in [(), ("--target", "aarch64-unknown-linux-gnu")]:
        boundary("wamn-edge", EDGE_REFUSED, EDGE_WASH, *target)
    # Requirement: the engine links no Postgres, OCI or cloud plugins (docs/architecture/overview.md, Runtime owners).
    engine = boundary("wamn-engine", ENGINE_REFUSED, ENGINE_WASH)
    # Requirement: the base platform links no workflow layer (docs/architecture/execution.md, Workflows).
    require("wamn-workflow" not in engine, "wamn-engine links wamn-workflow")
    # Requirement: the base platform links neither workflow nor router (docs/architecture/execution.md, Workflows rule 7 and layering).
    for package in ["wamn-runtime", "wamn-execution-host"]:
        linked = dependencies(package)
        require(not ({"wamn-workflow", "wamn-router"} & linked),
                f"{package} links the workflow layer or router")
except (subprocess.CalledProcessError, ValueError) as error:
    print(f"repo-lint: dependency boundaries: {error}", file=sys.stderr)
    if isinstance(error, subprocess.CalledProcessError):
        print(error.stderr, file=sys.stderr)
    sys.exit(65)
