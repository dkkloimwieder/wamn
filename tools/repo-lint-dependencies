def purity_modules(package, paths, root):
    require(len(paths) == len(set(paths)), f"{package}: duplicate PURE_MODULES entry")
    graph = RustModules(root)
    def scan(module, start=0, end=None, seen=None):
        seen = set() if seen is None else seen
        key = (module, start, end)
        if key in seen:
            return
        seen.add(key)
        data = graph.modules[module]
        if data["exempt"]:
            return
        source = data["code"][start:end]
        for match in re.finditer(r"\.\s*([A-Za-z_]\w*)\s*\(", source):
            position = data["offset"] + start + match.start()
            line = data["full_source"][:position].count("\n") + 1
            require(match[1] not in PURE_METHODS,
                    f"{data['file']}:{line}: pure {package}::{marked} refuses filesystem call .{match[1]}()")
        for match in re.finditer(r"\b[A-Za-z_]\w*(?:\s*::\s*[A-Za-z_]\w*)*", source):
            parts = re.split(r"\s*::\s*", match[0])
            resolved = graph.resolve(module, parts)
            paths = [parts, resolved or ()]
            refused = None
            for index, path in enumerate(paths):
                checked = list(path)
                if index:
                    for own, part in zip(module, path):
                        if own != part:
                            break
                        checked.pop(0)
                joined = "::".join(path)
                refused = next((token for token in checked if token in PURE_TOKENS), None)
                refused = refused or next((token for token in PURE_CALLS
                                           if joined == token or joined.startswith(token + "::")), None)
                if len(path) >= 2 and path[-1] in PURE_HELPERS.get(path[-2], set()):
                    refused = joined
                if refused:
                    break
            position = data["offset"] + start + match.start()
            line = data["full_source"][:position].count("\n") + 1
            require(not refused, f"{data['file']}:{line}: pure {package}::{marked} refuses {refused}")
            # Follow local helper functions through imports, aliases and re-exports.
            if (resolved and resolved[:-1] in graph.modules
                    and not source[:match.start()].rstrip().endswith(".")
                    and re.match(r"\s*(?:::<[^;{}]*?>\s*)?\(", source[match.end():])):
                owner = graph.modules[resolved[:-1]]
                function = owner["functions"].get(resolved[-1])
                if function:
                    scan(resolved[:-1], *function, seen)
        for child in graph.modules:
            if start == 0 and end is None and len(child) == len(module) + 1 and child[:-1] == module:
                scan(child, seen=seen)
    for path in paths:
        marked = path or "<crate>"
        module = tuple(path.split("::")) if path else ()
        require(module in graph.modules, f"{package}: missing pure module {path}")
        scan(module)


def library_roots():
    """Each package's manifest and library root, read from the manifests under crates/."""
    roots = {}
    for manifest in (Path(__file__).resolve().parent.parent / "crates").rglob("Cargo.toml"):
        data = tomllib.loads(manifest.read_text())
        if "package" in data:
            library = manifest.parent / data.get("lib", {}).get("path", "src/lib.rs")
            roots[data["package"]["name"]] = (manifest, library)
    return roots


def purity():
    packages = library_roots()
    for package in PURE_CRATES:
        require(package in packages, f"unknown pure package {package}")
        linked = dependencies(package)
        refused = {name: rule for name, rule in PURE_REFUSED.items() if name in linked}
        manifest = packages[package][0]
        require(not refused, f"{manifest}:1: pure {package} links forbidden dependencies: {refused}")
    for package in PURE_MODULES.keys() | PURE_CRATES.keys():
        paths = PURE_MODULES.get(package, [])
        if package in PURE_CRATES:
            paths = ["", *paths]
        require(package in packages, f"unknown pure package {package}")
        library = packages[package][1]
        require(library.is_file(), f"{package}: expected one library target")
        purity_modules(package, paths, library)


try:
    purity()
    for target in [(), ("--target", "aarch64-unknown-linux-gnu")]:
        boundary("wamn-edge", EDGE_REFUSED, EDGE_WASH, *target)
    engine = boundary("wamn-engine", ENGINE_REFUSED, ENGINE_WASH)
    direct = dependencies("wamn-engine", "--depth", "1") - {"wamn-engine"}
    require(direct == set(ENGINE_ACCEPTED),
            f"wamn-engine direct dependencies changed: {direct}; give each dependency a reason in ENGINE_ACCEPTED")
    require("wamn-workflow" not in engine, "wamn-engine links wamn-workflow")
    for package in ["wamn-runtime", "wamn-execution-host"]:
        linked = dependencies(package)
        require(not ({"wamn-workflow", "wamn-router"} & linked),
                f"{package} links the workflow layer or router")
    require("wamn-workflow" in dependencies("wamn-host"), "wamn-host must link wamn-workflow")
except (subprocess.CalledProcessError, ValueError) as error:
    print(f"repo-lint: dependency boundaries: {error}", file=sys.stderr)
    if isinstance(error, subprocess.CalledProcessError):
        print(error.stderr, file=sys.stderr)
    sys.exit(65)
