def dependencies(package, *extra):
    command = [sys.argv[1], "tree", "-p", package, "-e", "normal", *extra,
               "--prefix", "none", "--locked", "--offline"]
    result = subprocess.run(command, check=True, capture_output=True, text=True)
    return {line.split()[0] for line in result.stdout.splitlines() if line.split()}


def require(condition, reason):
    if not condition:
        raise ValueError(reason)


def boundary(package, refused, accepted, *target):
    outside = dependencies(package, *target, "--prune", "wash-runtime")
    violations = {name: rule for name, rule in refused.items() if name in outside}
    require(not violations, f"{package} {target} links forbidden dependencies: {violations}")
    linked = dependencies(package, *target)
    present = set(refused) & linked
    require(present == set(accepted),
            f"{package} {target} wash-runtime exceptions changed: {present}, expected {accepted}")
    return linked


RAW_STRING = re.compile(r'(?:br|cr|r)(#*)"')
CHAR_LITERAL = re.compile(r"'(?:\\(?:u\{[0-9a-fA-F_]+\}|x[0-9a-fA-F]{2}|.)|[^'\\\n])'")


def rust_code(source):
    """Mask comments and literals while preserving source positions."""
    code = list(source)
    index = 0

    def blank(start, end):
        for position in range(start, end):
            if code[position] != "\n":
                code[position] = " "

    while index < len(source):
        if source.startswith("//", index):
            end = source.find("\n", index)
            end = len(source) if end < 0 else end
            blank(index, end)
            index = end
        elif source.startswith("/*", index):
            start = index
            index += 2
            depth = 1
            while index < len(source) and depth:
                if source.startswith("/*", index):
                    depth += 1
                    index += 2
                elif source.startswith("*/", index):
                    depth -= 1
                    index += 2
                else:
                    index += 1
            blank(start, index)
        elif source[index] in "rbc" and (match := RAW_STRING.match(source, index)):
            terminator = '"' + match[1]
            end = source.find(terminator, match.end())
            end = len(source) if end < 0 else end + len(terminator)
            blank(index, end)
            index = end
        elif source[index] == '"' or (source[index] == "'" and CHAR_LITERAL.match(source, index)):
            quote = source[index]
            start = index
            index += 1
            while index < len(source):
                if source[index] == "\\":
                    index += 2
                elif source[index] == quote:
                    index += 1
                    break
                else:
                    index += 1
            blank(start, min(index, len(source)))
        else:
            index += 1
    return "".join(code)


def closing(code, start):
    pairs = {"(": ")", "[": "]", "{": "}"}
    stack = [pairs[code[start]]]
    for index in range(start + 1, len(code)):
        char = code[index]
        if char in pairs:
            stack.append(pairs[char])
        elif char in ")]}":
            require(stack and stack[-1] == char, "unbalanced Rust source")
            stack.pop()
            if not stack:
                return index + 1
    raise ValueError("unclosed Rust item")


def source_items(source):
    """Yield complete items, with attributes and original source offsets."""
    code = rust_code(source)
    index = 0
    while index < len(code):
        while index < len(code) and code[index].isspace():
            index += 1
        start = index
        attributes = []
        while code.startswith("#", index):
            bracket = index + 1
            if code.startswith("!", bracket):
                bracket += 1
            if bracket >= len(code) or code[bracket] != "[":
                break
            end = closing(code, bracket)
            attributes.append(source[index:end])
            index = end
            while index < len(code) and code[index].isspace():
                index += 1
        head = index
        while index < len(code):
            char = code[index]
            if char in "([":
                index = closing(code, index)
            elif char == ";":
                index += 1
                break
            elif char == "{":
                index = closing(code, index)
                # use groups and brace structs can end in a semicolon.
                while index < len(code) and code[index].isspace():
                    index += 1
                if index < len(code) and code[index] == ";":
                    index += 1
                break
            else:
                index += 1
        if head < index:
            yield start, head, index, attributes


def test_item(attributes):
    return any(re.fullmatch(r"#\s*\[\s*cfg\s*\(\s*test\s*\)\s*\]", attribute)
               for attribute in attributes)


def production_code(source):
    """Remove complete cfg(test) items, including methods and inline modules."""
    code = rust_code(source)
    pattern = re.compile(r"#\s*\[\s*cfg\s*\(\s*test\s*\)\s*\]")
    position = 0
    while match := pattern.search(code, position):
        start = match.start()
        _, _, length, _ = next(source_items(source[start:]))
        end = start + length
        code = code[:start] + re.sub(r"[^\n]", " ", code[start:end]) + code[end:]
        position = end
    return code


def use_paths(text):
    """Expand Rust use trees, including renamed and glob imports."""
    tokens = re.findall(r"[A-Za-z_][A-Za-z_0-9]*|::|[{},*]", text)
    def tree(index, prefix):
        path = list(prefix)
        paths = []
        while index < len(tokens):
            token = tokens[index]
            if token == "{":
                index += 1
                while index < len(tokens) and tokens[index] != "}":
                    children, index = tree(index, path)
                    paths.extend(children)
                    if index < len(tokens) and tokens[index] == ",":
                        index += 1
                return paths, index + 1
            if token in (",", "}"):
                break
            if token == "as":
                return [(tokens[index + 1], path)], index + 2
            if token != "::":
                path.append(token)
            index += 1
        if path:
            if path[-1] == "self":
                path.pop()
            paths.append((path[-1], path))
        return paths, index
    return tree(0, [])[0]


class RustModules:
    def __init__(self, root):
        self.modules = {}
        self.load((), root, root.parent)

    def load(self, name, path, directory, source=None, offset=0, exempt=False, inline=False):
        require(name not in self.modules, f"duplicate Rust module {'::'.join(name)}")
        source = path.read_text() if source is None else source
        code = "" if exempt else production_code(source)
        module = {"file": path, "source": source, "code": code, "offset": offset,
                  "exempt": exempt, "imports": {}, "globs": [], "functions": {},
                  "full_source": path.read_text()}
        self.modules[name] = module
        if exempt:
            return
        raw = rust_code(source)
        for start, head, end, attributes in source_items(source):
            item = raw[head:end]
            declaration = re.match(r"(?:pub(?:\([^)]*\))?\s+)?mod\s+(\w+)\s*([;{])", item)
            if declaration:
                child, form = declaration.groups()
                attribute_base = directory if inline else path.parent
                explicit = [match[1] for attribute in attributes
                            if (match := re.search(r'\bpath\s*=\s*"([^"]+)"', attribute))]
                test = exempt or test_item(attributes)
                if form == "{":
                    brace = head + item.index("{")
                    last = closing(raw, brace) - 1
                    child_directory = attribute_base / explicit[0] if explicit else directory / child
                    self.load((*name, child), path, child_directory,
                              source[brace + 1:last], offset + brace + 1, test, inline=True)
                else:
                    candidates = ([attribute_base / explicit[0]] if explicit else
                                  [directory / f"{child}.rs", directory / child / "mod.rs"])
                    present = [candidate for candidate in candidates if candidate.is_file()]
                    require(len(present) == 1,
                            f"{path}: missing or ambiguous module {child}: {candidates}")
                    target = present[0]
                    child_directory = target.parent if target.name == "mod.rs" else target.with_suffix("")
                    self.load((*name, child), target, child_directory, exempt=test)
            if exempt or test_item(attributes):
                continue
            imported = re.match(r"(?:pub(?:\([^)]*\))?\s+)?use\s+", item)
            if imported:
                for alias, target in use_paths(item[imported.end():]):
                    if alias == "*":
                        module["globs"].append(target[:-1])
                    elif alias != "_":
                        module["imports"][alias] = target
            function = re.match(r"(?:pub(?:\([^)]*\))?\s+)?(?:async\s+|const\s+|unsafe\s+)*fn\s+(\w+)", item)
            if function:
                module["functions"][function[1]] = (head, end)

    def resolve(self, module, path, seen=frozenset()):
        if not path:
            return None
        key = (module, tuple(path))
        if key in seen:
            return None
        seen = seen | {key}
        first, *rest = path
        if first == "crate":
            return self.resolve((), rest, seen) if rest else ()
        if first == "self":
            return self.resolve(module, rest, seen) if rest else module
        if first == "super":
            return (self.resolve(module[:-1], rest, seen) if rest else module[:-1]) if module else None
        data = self.modules.get(module)
        if data is None:
            return (*module, *path)
        if rest and (*module, first) in self.modules:
            return self.resolve((*module, first), rest, seen)
        if first in data["imports"]:
            return self.resolve(module, [*data["imports"][first], *rest], seen)
        if (*module, first) in self.modules or first in data["functions"]:
            return (*module, *path)
        for glob in data["globs"]:
            owner = self.resolve(module, glob, seen)
            if owner in self.modules:
                found = self.resolve(owner, path, seen)
                if found is not None:
                    return found
        return tuple(path)


