#!/usr/bin/env bash
set -euo pipefail

readonly WAMN_USAGE='usage:
  tools/workspace-tier list [TIER]
  tools/workspace-tier dry-run TIER WORKSPACE MODE
  tools/workspace-tier run TIER WORKSPACE MODE

WORKSPACE is root or one of the component workspaces declared in
architecture/workspace-tiers.json source_inventory.component_workspaces.
Root MODE is check, build, test, or test-all.
Component MODE is check-wasm or build-wasm.'

wamn_fail() {
  local -r exit_code="$1"
  shift
  printf 'workspace-tier: %s\n' "$*" >&2
  exit "$exit_code"
}

wamn_usage_error() {
  printf '%s\n' "$WAMN_USAGE" >&2
  wamn_fail 64 "$*"
}

readonly WAMN_TOOL_DIRECTORY="$(
  CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_REPOSITORY_ROOT="$(
  CDPATH= cd -- "$WAMN_TOOL_DIRECTORY/.." >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_TIER_MANIFEST="$WAMN_REPOSITORY_ROOT/architecture/workspace-tiers.json"
readonly WAMN_PACKAGE_ROLES="$WAMN_REPOSITORY_ROOT/architecture/package-roles.json"

command -v jq >/dev/null 2>&1 || wamn_fail 127 'jq is required'
[[ -r "$WAMN_TIER_MANIFEST" ]] || {
  wamn_fail 65 "cannot read $WAMN_TIER_MANIFEST"
}
[[ -r "$WAMN_PACKAGE_ROLES" ]] || {
  wamn_fail 65 "cannot read $WAMN_PACKAGE_ROLES"
}

jq -e '
  .schema_version == "0.1"
  and (.tiers | type == "object" and length > 0)
  and all(
    .tiers[];
    (.root_packages | type == "array")
    and (.component_packages | type == "array")
    and (.non_cargo_inputs | type == "array")
    and (.command_semantics | type == "string" and length > 0)
  )
' "$WAMN_TIER_MANIFEST" >/dev/null 2>&1 || {
  wamn_fail 65 'workspace tier manifest does not satisfy schema version 0.1'
}

wamn_require_tier() {
  local -r tier="$1"
  jq -e --arg tier "$tier" '.tiers | has($tier)' \
    "$WAMN_TIER_MANIFEST" >/dev/null 2>&1 || {
    wamn_usage_error "unknown tier '$tier'"
  }
}

wamn_list() {
  if (($# == 0)); then
    jq -S '
      .tiers
      | to_entries
      | sort_by(.key)
      | map({
          name: .key,
          root_count: (.value.root_packages | length),
          component_count: (.value.component_packages | length),
          non_cargo_count: (.value.non_cargo_inputs | length)
        })
    ' "$WAMN_TIER_MANIFEST"
    return
  fi

  (($# == 1)) || wamn_usage_error 'list accepts at most one tier'
  local -r tier="$1"
  wamn_require_tier "$tier"
  jq -S --arg tier "$tier" \
    '{name: $tier} + .tiers[$tier]' "$WAMN_TIER_MANIFEST"
}

# Every crate name one component workspace holds, read from the crates' own
# manifests.
#
# Planning must not run Cargo: this helper is proved against a fake Cargo that
# refuses every call, and the plan has to exist before Cargo is executed. So the
# owning workspace of a derived package component is resolved from the tree
# instead. The component workspaces nest, so every OTHER declared workspace
# directory is pruned rather than assuming where a package component lives
# (wamn-10yt.10.39).
wamn_workspace_crate_names() {
  local -r workspace_manifest="$1"
  local -a search=("$WAMN_REPOSITORY_ROOT/$(dirname -- "$workspace_manifest")")
  local other
  while IFS= read -r other; do
    if [[ "$other" != "$workspace_manifest" ]]; then
      search+=(-path "$WAMN_REPOSITORY_ROOT/$(dirname -- "$other")" -prune -o)
    fi
  done < <(
    jq -er '.source_inventory.component_workspaces[].manifest' "$WAMN_TIER_MANIFEST"
  )

  find "${search[@]}" -name Cargo.toml -print0 |
    while IFS= read -r -d '' crate_manifest; do
      awk '
        /^\[/ { in_package = ($0 ~ /^\[package\]/) }
        in_package && /^name[[:space:]]*=/ {
          sub(/^[^=]*=[[:space:]]*"/, "")
          sub(/".*$/, "")
          print
          exit
        }
      ' "$crate_manifest"
    done
}

declare WAMN_WORKING_DIRECTORY
declare WAMN_CARGO_MANIFEST
declare WAMN_QUALIFICATION
declare -a WAMN_PACKAGES
declare -a WAMN_CARGO_ARGUMENTS

wamn_load_plan() {
  local -r tier="$1"
  local -r workspace="$2"
  local -r mode="$3"
  local selection_key

  wamn_require_tier "$tier"

  local workspace_family manifest_relative
  case "$workspace" in
    root)
      workspace_family='root'
      selection_key='root_packages'
      WAMN_WORKING_DIRECTORY="$WAMN_REPOSITORY_ROOT"
      WAMN_CARGO_MANIFEST="$WAMN_REPOSITORY_ROOT/Cargo.toml"
      ;;
    *)
      # More than one component workspace exists, because Cargo feature
      # unification is additive-only inside one invocation. The canonical
      # inventory owns which manifests those are.
      manifest_relative="$(
        jq -er --arg workspace "$workspace" '
          .source_inventory.component_workspaces[]
          | select(.workspace == $workspace)
          | .manifest
        ' "$WAMN_TIER_MANIFEST" 2>/dev/null
      )" || wamn_usage_error "unknown workspace '$workspace'"
      workspace_family='components'
      selection_key='component_packages'
      WAMN_CARGO_MANIFEST="$WAMN_REPOSITORY_ROOT/$manifest_relative"
      WAMN_WORKING_DIRECTORY="$(dirname -- "$WAMN_CARGO_MANIFEST")"
      ;;
  esac

  local -a fixed_arguments
  case "$workspace_family:$mode" in
    root:check)
      fixed_arguments=(check --locked)
      ;;
    root:build)
      fixed_arguments=(build --locked)
      ;;
    root:test)
      fixed_arguments=(test --locked --no-fail-fast)
      ;;
    root:test-all)
      fixed_arguments=(test --locked --all-targets --no-fail-fast)
      ;;
    components:check-wasm)
      fixed_arguments=(check --locked --target wasm32-wasip2)
      ;;
    components:build-wasm)
      fixed_arguments=(build --locked --target wasm32-wasip2)
      ;;
    *)
      wamn_usage_error "mode '$mode' is not valid for workspace '$workspace'"
      ;;
  esac

  jq -e --arg tier "$tier" --arg key "$selection_key" '
    .tiers[$tier][$key] as $selection
    | ($selection | type == "array")
      and all($selection[]; type == "string" and test("^[A-Za-z0-9_-]+$"))
      and (($selection | unique | length) == ($selection | length))
  ' "$WAMN_TIER_MANIFEST" >/dev/null 2>&1 || {
    wamn_fail 65 "$tier.$selection_key must contain unique Cargo package names"
  }

  # A tier names every component package it covers, regardless of which
  # component workspace owns it; the classification source resolves the owner.
  #
  # The tier list is the PLATFORM half. A package declares its own components,
  # so the package half is derived here the same way tools/build-components
  # derives it, and a new package is swept without an edit to this file or to
  # the tier manifest (wamn-10yt.10.39).
  local -a selection_filter=(--arg tier "$tier" --arg key "$selection_key")
  local selection_program='.tiers[$tier][$key]'
  if [[ "$workspace_family" == 'components' ]]; then
    local package_components
    package_components="$(
      {
        if [[ -d "$WAMN_REPOSITORY_ROOT/packages" ]]; then
          for wamn_package_manifest in "$WAMN_REPOSITORY_ROOT"/packages/*/wamn.json; do
            [[ -r "$wamn_package_manifest" ]] || continue
            jq -er '(.components // {}) | keys[]' "$wamn_package_manifest" || {
              wamn_fail 65 "cannot read components from $wamn_package_manifest"
            }
          done
        fi
      } | tr '_' '-' | sort -u | jq -Rn '[inputs | select(length > 0)]'
    )" || wamn_fail 65 'could not derive the package component set'
    # The classification source carries the platform half only, so the owner of
    # a derived component is read off the tree instead.
    local owned_package_components
    owned_package_components="$(
      wamn_workspace_crate_names "$manifest_relative" \
        | jq -Rn --argjson declared "$package_components" \
            '[inputs | select(. as $name | $declared | index($name) != null)]'
    )" || wamn_fail 65 "could not resolve the package components $workspace holds"
    selection_filter+=(--arg workspace "$workspace"
      --argjson package_components "$package_components"
      --argjson owned_package_components "$owned_package_components"
      --slurpfile roles "$WAMN_PACKAGE_ROLES")
    selection_program='([$roles[0].packages[]
                         | select(.workspace == $workspace)
                         | .name] + $owned_package_components) as $owned
                       | [((.tiers[$tier][$key] + $package_components) | unique)[]
                          | select(. as $package
                                   | $owned | index($package) != null)]'
  fi

  local selection_length
  selection_length="$(
    jq -r "${selection_filter[@]}" "$selection_program | length" \
      "$WAMN_TIER_MANIFEST"
  )"
  ((selection_length > 0)) || {
    wamn_fail 65 "$tier has an empty $workspace package selection"
  }

  mapfile -t WAMN_PACKAGES < <(
    jq -r "${selection_filter[@]}" "$selection_program | .[]" \
      "$WAMN_TIER_MANIFEST"
  )
  WAMN_QUALIFICATION="$(
    jq -er --arg tier "$tier" \
      '.tiers[$tier].command_semantics' "$WAMN_TIER_MANIFEST"
  )"

  WAMN_CARGO_ARGUMENTS=("${fixed_arguments[@]}" --manifest-path "$WAMN_CARGO_MANIFEST")
  local package
  for package in "${WAMN_PACKAGES[@]}"; do
    WAMN_CARGO_ARGUMENTS+=(--package "$package")
  done
}

wamn_plan_json() {
  local -r tier="$1"
  local -r workspace="$2"
  local -r mode="$3"
  local -r cargo_executable="${CARGO:-cargo}"
  local -a plan_argv=("$cargo_executable" "${WAMN_CARGO_ARGUMENTS[@]}")

  jq -n -S \
    --arg tier "$tier" \
    --arg workspace "$workspace" \
    --arg mode "$mode" \
    --arg working_directory "$WAMN_WORKING_DIRECTORY" \
    --arg qualification "$WAMN_QUALIFICATION" \
    --args '
      $ARGS.named + {argv: $ARGS.positional}
    ' -- "${plan_argv[@]}"
}

wamn_run() {
  local -r cargo_executable="${CARGO:-cargo}"
  if [[ "$cargo_executable" == */* ]]; then
    [[ -x "$cargo_executable" ]] || {
      wamn_fail 127 "Cargo executable is not executable: $cargo_executable"
    }
  else
    command -v "$cargo_executable" >/dev/null 2>&1 || {
      wamn_fail 127 "Cargo executable was not found: $cargo_executable"
    }
  fi

  printf 'workspace-tier: %s\n' "$WAMN_QUALIFICATION" >&2
  cd -- "$WAMN_WORKING_DIRECTORY"
  exec "$cargo_executable" "${WAMN_CARGO_ARGUMENTS[@]}"
}

(($# > 0)) || wamn_usage_error 'missing command'
readonly WAMN_COMMAND="$1"
shift

case "$WAMN_COMMAND" in
  list)
    wamn_list "$@"
    ;;
  dry-run | run)
    (($# == 3)) || wamn_usage_error "$WAMN_COMMAND requires TIER WORKSPACE MODE"
    readonly WAMN_TIER="$1"
    readonly WAMN_WORKSPACE="$2"
    readonly WAMN_MODE="$3"
    wamn_load_plan "$WAMN_TIER" "$WAMN_WORKSPACE" "$WAMN_MODE"
    if [[ "$WAMN_COMMAND" == 'dry-run' ]]; then
      wamn_plan_json "$WAMN_TIER" "$WAMN_WORKSPACE" "$WAMN_MODE"
    else
      wamn_run
    fi
    ;;
  *)
    wamn_usage_error "unknown command '$WAMN_COMMAND'"
    ;;
esac
