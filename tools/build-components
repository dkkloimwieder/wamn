#!/usr/bin/env bash
set -euo pipefail

readonly WAMN_USAGE='usage: tools/build-components m1 | proof'

wamn_fail() {
  local -r exit_code="$1"
  shift
  printf 'build-components: %s\n' "$*" >&2
  exit "$exit_code"
}

wamn_usage_error() {
  printf '%s\n' "$WAMN_USAGE" >&2
  wamn_fail 64 "$*"
}

(($# == 1)) || wamn_usage_error 'exactly one component profile is required'
readonly WAMN_PROFILE="$1"
case "$WAMN_PROFILE" in
  m1 | proof) ;;
  *) wamn_usage_error "unknown component profile '$WAMN_PROFILE'" ;;
esac

readonly WAMN_TOOL_DIRECTORY="$(
  CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_REPOSITORY_ROOT="$(
  CDPATH= cd -- "$WAMN_TOOL_DIRECTORY/.." >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_TIER_MANIFEST="$WAMN_REPOSITORY_ROOT/architecture/workspace-tiers.json"
readonly WAMN_VIRTUALIZATION_MANIFEST="$WAMN_REPOSITORY_ROOT/tools/component-virtualization.json"
readonly WAMN_CARGO="${CARGO:-cargo}"

command -v jq >/dev/null 2>&1 || wamn_fail 127 'jq is required'
[[ -r "$WAMN_TIER_MANIFEST" ]] || {
  wamn_fail 65 "cannot read $WAMN_TIER_MANIFEST"
}
[[ -r "$WAMN_VIRTUALIZATION_MANIFEST" ]] || {
  wamn_fail 65 "cannot read $WAMN_VIRTUALIZATION_MANIFEST"
}
if [[ "$WAMN_CARGO" == */* ]]; then
  [[ -x "$WAMN_CARGO" ]] || {
    wamn_fail 127 "Cargo executable is not executable: $WAMN_CARGO"
  }
else
  command -v "$WAMN_CARGO" >/dev/null 2>&1 || {
    wamn_fail 127 "Cargo executable was not found: $WAMN_CARGO"
  }
fi
cd -- "$WAMN_REPOSITORY_ROOT"

# The guests are split across more than one Cargo workspace, because Cargo
# feature unification is additive-only within a single invocation and would
# force std into the `no_std` guests. One metadata read and at most one build
# per declared workspace; the canonical inventory says which is which.
declare WAMN_MANIFEST_LIST
WAMN_MANIFEST_LIST="$(
  jq -er '.source_inventory.component_workspaces
          | select(length > 0)
          | .[].manifest' "$WAMN_TIER_MANIFEST"
)" || wamn_fail 65 'canonical inventory declares no component workspace'
readonly WAMN_MANIFEST_LIST
mapfile -t WAMN_MANIFESTS <<<"$WAMN_MANIFEST_LIST"
readonly WAMN_MANIFESTS

declare -a WAMN_METADATA=()
declare WAMN_WORKSPACE_METADATA
for manifest in "${WAMN_MANIFESTS[@]}"; do
  WAMN_WORKSPACE_METADATA="$("$WAMN_CARGO" metadata \
    --manifest-path "$WAMN_REPOSITORY_ROOT/$manifest" \
    --locked --offline --no-deps --format-version 1)" || {
    wamn_fail 65 "locked component Cargo metadata failed for $manifest"
  }
  WAMN_METADATA+=("$WAMN_WORKSPACE_METADATA")
done
readonly WAMN_METADATA

declare WAMN_PLAN
WAMN_PLAN="$(
  printf '%s\n' "${WAMN_METADATA[@]}" | jq -e -s --arg profile "$WAMN_PROFILE" '
    .[0] as $contract
    | .[1:] as $metadata
    | $contract.source_inventory.component_workspaces as $workspaces
    | $contract.profiles.components as $profiles
    | [$metadata[]
       | (.packages | map({key: .id, value: .name}) | from_entries) as $names
       | [.workspace_members[] | $names[.]]] as $membership
    | ($membership | add) as $members
    | (if $profile == "m1"
       then $profiles.m1_inventory_tier
       else $profiles.proof_inventory_tier
       end) as $tier
    | $contract.tiers[$tier].component_packages as $packages
    | select($contract.schema_version == "0.1")
    | select($workspaces | length == ($membership | length))
    | select([range($workspaces | length) as $index
              | select(($membership[$index] | length)
                       != $workspaces[$index].package_count)] | length == 0)
    | select($members | length == (unique | length))
    | select($packages | length == $profiles.expected_package_counts[$profile])
    | select($packages | length == (unique | length))
    | select(($contract.tiers[$profiles.proof_inventory_tier].component_packages | sort)
             == ($members | sort))
    | [range($workspaces | length) as $index
       | {manifest: $workspaces[$index].manifest,
          packages: [$packages[]
                     | select(. as $package
                              | $membership[$index] | index($package) != null)]}]
    | select(([.[].packages] | add | length) == ($packages | length))
    | map(select(.packages | length > 0))
  ' "$WAMN_TIER_MANIFEST" -
)" || wamn_fail 65 'component profile, canonical inventory, and locked metadata drifted'
readonly WAMN_PLAN

# This is an allowlist, not discovery: upstream import filtering does not cover
# filesystem imports, so an undeclared std guest must remain raw and fail its
# own admission rather than inherit this profile implicitly.
declare WAMN_VIRTUALIZATION_PLAN
WAMN_VIRTUALIZATION_PLAN="$(
  printf '%s\n' "${WAMN_METADATA[@]}" | jq -e -s \
    --slurpfile tier "$WAMN_TIER_MANIFEST" \
    --slurpfile virtualization "$WAMN_VIRTUALIZATION_MANIFEST" \
    --arg profile "$WAMN_PROFILE" '
    def basename:
      type == "string"
      and length > 0
      and (contains("/") | not)
      and . != "."
      and . != "..";
    def relative_path:
      type == "string"
      and length > 0
      and (startswith("/") | not)
      and (split("/") | all(length > 0 and . != "." and . != ".."));

    . as $metadata
    | $tier[0] as $contract
    | $virtualization[0] as $virtual
    | $contract.source_inventory.component_workspaces as $workspaces
    | (if $profile == "m1"
       then $contract.profiles.components.m1_inventory_tier
       else $contract.profiles.components.proof_inventory_tier
       end) as $tier_name
    | $contract.tiers[$tier_name].component_packages as $selected
    | select(($virtual | keys | sort)
             == (["artifacts", "output_subdirectory", "profile", "tool"] | sort))
    | select(($virtual.tool | keys | sort) == ["manifest", "package"])
    | select($virtual.profile | test("^[a-z0-9][a-z0-9-]*$"))
    | select($virtual.output_subdirectory == ("virtualized/" + $virtual.profile))
    | select($virtual.tool.manifest | relative_path)
    | select($virtual.tool.package | type == "string" and length > 0)
    | select($metadata | length == ($workspaces | length))
    | [range($workspaces | length) as $index
       | {manifest: $workspaces[$index].manifest,
          metadata: $metadata[$index]}] as $owners
    | select([$virtual.artifacts[]
              | select((keys | sort)
                       != ["output_file", "package", "raw_file", "workspace_manifest"])]
             | length == 0)
    | select($virtual.artifacts | length > 0)
    | select(($virtual.artifacts | map(.package) | length)
             == ($virtual.artifacts | map(.package) | unique | length))
    | select(($virtual.artifacts | map(.workspace_manifest + "\u0000" + .raw_file) | length)
             == ($virtual.artifacts
                 | map(.workspace_manifest + "\u0000" + .raw_file) | unique | length))
    | select(($virtual.artifacts | map(.output_file) | length)
             == ($virtual.artifacts | map(.output_file) | unique | length))
    | select([$virtual.artifacts[] as $artifact
              | select(($artifact.package | type != "string" or length == 0)
                       or ($artifact.workspace_manifest | relative_path | not)
                       or ($artifact.raw_file | basename | not)
                       or ($artifact.output_file | basename | not)
                       or ($artifact.raw_file | endswith(".wasm") | not)
                       or ($artifact.output_file | endswith(".wasm") | not)
                       or ($contract.tiers.product_components.component_packages
                           | index($artifact.package) == null))]
             | length == 0)
    | [$virtual.artifacts[] as $artifact
       | [$owners[] | select(.manifest == $artifact.workspace_manifest)] as $matching_owners
       | select($matching_owners | length == 1)
       | $matching_owners[0] as $owner
       | [$owner.metadata.packages[]
          | select(.name == $artifact.package)
          | select(.id as $id | $owner.metadata.workspace_members | index($id) != null)] as $packages
       | select($packages | length == 1)
       | $packages[0] as $package
       | [$package.targets[] | select(.crate_types | index("cdylib") != null)] as $targets
       | select($targets | length == 1)
       | select($artifact.raw_file == ($targets[0].name + ".wasm"))
       | {package: $artifact.package,
          raw: ($owner.metadata.target_directory
                + "/wasm32-wasip2/debug/" + $artifact.raw_file),
          output: ($owner.metadata.target_directory + "/"
                   + $virtual.output_subdirectory + "/" + $artifact.output_file)}] as $artifacts
    | select($artifacts | length == ($virtual.artifacts | length))
    | select([$artifacts[] | select(.raw == .output)] | length == 0)
    | {profile: $virtual.profile,
       tool: $virtual.tool,
       artifacts: [$artifacts[] | select(.package as $package | $selected | index($package) != null)]}
    | select(.artifacts | length > 0)
  '
)" || wamn_fail 65 'component virtualization allowlist and locked metadata drifted'
readonly WAMN_VIRTUALIZATION_PLAN

readonly WAMN_LEG_COUNT="$(jq -r 'length' <<<"$WAMN_PLAN")"
((WAMN_LEG_COUNT > 0)) || wamn_fail 65 "$WAMN_PROFILE has an empty component selection"
printf 'build-components: %s selects %s component packages across %s workspaces\n' \
  "$WAMN_PROFILE" "$(jq -r '[.[].packages[]] | length' <<<"$WAMN_PLAN")" \
  "$WAMN_LEG_COUNT" >&2

# Every leg runs: the workspaces are isolated precisely so that one workspace's
# failure does not describe the other's state.
WAMN_EXIT_STATUS=0
for ((leg = 0; leg < WAMN_LEG_COUNT; leg += 1)); do
  manifest="$(jq -r --argjson leg "$leg" '.[$leg].manifest' <<<"$WAMN_PLAN")"
  declare -a WAMN_ARGUMENTS=(
    build --locked --offline --target wasm32-wasip2
    --manifest-path "$WAMN_REPOSITORY_ROOT/$manifest"
  )
  while IFS= read -r package; do
    WAMN_ARGUMENTS+=(-p "$package")
  done < <(jq -r --argjson leg "$leg" '.[$leg].packages[]' <<<"$WAMN_PLAN")
  leg_status=0
  "$WAMN_CARGO" "${WAMN_ARGUMENTS[@]}" || leg_status=$?
  if ((leg_status != 0)); then
    printf 'build-components: FAIL: %s (exit %d)\n' "$manifest" "$leg_status" >&2
    if ((WAMN_EXIT_STATUS == 0)); then
      WAMN_EXIT_STATUS="$leg_status"
    fi
  fi
done
if ((WAMN_EXIT_STATUS != 0)); then
  exit "$WAMN_EXIT_STATUS"
fi

readonly WAMN_VIRTUALIZATION_PROFILE="$(jq -r '.profile' <<<"$WAMN_VIRTUALIZATION_PLAN")"
readonly WAMN_VIRTUALIZER_MANIFEST="$WAMN_REPOSITORY_ROOT/$(
  jq -r '.tool.manifest' <<<"$WAMN_VIRTUALIZATION_PLAN"
)"
readonly WAMN_VIRTUALIZER_PACKAGE="$(jq -r '.tool.package' <<<"$WAMN_VIRTUALIZATION_PLAN")"
readonly WAMN_VIRTUALIZATION_COUNT="$(jq -r '.artifacts | length' <<<"$WAMN_VIRTUALIZATION_PLAN")"

# The profile directory is wholly owned output. Clear it after every raw build
# succeeds and before emitting any current artifact, so a removed allowlist row
# cannot survive as a stale component and satisfy a later byte-level proof.
declare -A WAMN_VIRTUALIZATION_DIRECTORIES=()
while IFS= read -r output; do
  directory="$(dirname -- "$output")"
  [[ -n "$directory" && "$directory" != / \
     && "$directory" == */virtualized/"$WAMN_VIRTUALIZATION_PROFILE" ]] || {
    wamn_fail 65 "unsafe virtualization output directory: $directory"
  }
  WAMN_VIRTUALIZATION_DIRECTORIES["$directory"]=1
done < <(jq -r '.artifacts[].output' <<<"$WAMN_VIRTUALIZATION_PLAN")
readonly WAMN_VIRTUALIZATION_DIRECTORIES
for directory in "${!WAMN_VIRTUALIZATION_DIRECTORIES[@]}"; do
  rm -rf -- "$directory"
  mkdir -p -- "$directory"
done

WAMN_PENDING_OUTPUT=''
wamn_cleanup_partial_output() {
  if [[ -n "$WAMN_PENDING_OUTPUT" ]]; then
    rm -f -- "$WAMN_PENDING_OUTPUT"
  fi
}
trap wamn_cleanup_partial_output EXIT

printf 'build-components: %s normalizes %s declared artifacts with profile %s\n' \
  "$WAMN_PROFILE" "$WAMN_VIRTUALIZATION_COUNT" "$WAMN_VIRTUALIZATION_PROFILE" >&2
for ((artifact = 0; artifact < WAMN_VIRTUALIZATION_COUNT; artifact += 1)); do
  input="$(jq -r --argjson artifact "$artifact" \
    '.artifacts[$artifact].raw' <<<"$WAMN_VIRTUALIZATION_PLAN")"
  output="$(jq -r --argjson artifact "$artifact" \
    '.artifacts[$artifact].output' <<<"$WAMN_VIRTUALIZATION_PLAN")"
  package="$(jq -r --argjson artifact "$artifact" \
    '.artifacts[$artifact].package' <<<"$WAMN_VIRTUALIZATION_PLAN")"

  [[ -s "$input" ]] || wamn_fail 65 "raw component is missing or empty for $package: $input"
  mkdir -p -- "$(dirname -- "$output")"
  WAMN_PENDING_OUTPUT="${output}.partial.$$"
  rm -f -- "$WAMN_PENDING_OUTPUT"

  virtualizer_status=0
  "$WAMN_CARGO" run --locked --offline \
    --manifest-path "$WAMN_VIRTUALIZER_MANIFEST" \
    -p "$WAMN_VIRTUALIZER_PACKAGE" -- \
    --input "$input" --output "$WAMN_PENDING_OUTPUT" || virtualizer_status=$?
  if ((virtualizer_status != 0)); then
    wamn_fail "$virtualizer_status" \
      "virtualization failed for $package with profile $WAMN_VIRTUALIZATION_PROFILE"
  fi
  [[ -s "$WAMN_PENDING_OUTPUT" ]] || {
    wamn_fail 65 "virtualizer produced no component for $package"
  }
  mv -f -- "$WAMN_PENDING_OUTPUT" "$output"
  WAMN_PENDING_OUTPUT=''
  printf 'build-components: normalized %s -> %s\n' "$package" "$output" >&2
done
