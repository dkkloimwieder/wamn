#!/usr/bin/env bash
set -euo pipefail

readonly WAMN_USAGE='usage:
  tools/build-components app APP_DIRECTORY... | proof
  tools/build-components build-only app APP_DIRECTORY... | proof
  tools/build-components watch-roots app APP_DIRECTORY... | proof
  tools/build-components virtualize-only ARTIFACT_PLAN'

wamn_fail() {
  local -r exit_code="$1"
  shift
  printf 'build-components: %s\n' "$*" >&2
  exit "$exit_code"
}

wamn_usage_error() {
  printf '%s\n' "$WAMN_USAGE" >&2
  wamn_fail 64 "$*"
}

WAMN_MODE='combined'
WAMN_PROFILE=''
WAMN_ARTIFACT_PLAN_PATH=''
WAMN_SUPPLIED_ARTIFACT_PLAN=''
declare -a WAMN_APPLICATIONS=()
case "${1:-}" in
  build-only | watch-roots)
    WAMN_MODE="$1"
    shift
    ;;
  virtualize-only)
    (($# == 2)) || wamn_usage_error 'virtualize-only requires one artifact plan'
    WAMN_MODE='virtualize-only'
    WAMN_ARTIFACT_PLAN_PATH="$2"
    shift 2
    ;;
esac
if [[ "$WAMN_MODE" != virtualize-only ]]; then
  case "${1:-}" in
    app)
      (($# > 1)) || wamn_usage_error 'app requires an application directory'
      WAMN_PROFILE='app'
      shift
      for application in "$@"; do
        WAMN_APPLICATIONS+=("$(CDPATH= cd -- "$application" && pwd -P)") || {
          wamn_usage_error "cannot read application directory $application"
        }
      done
      ;;
    proof)
      (($# == 1)) || wamn_usage_error 'proof takes no application directories'
      WAMN_PROFILE='proof'
      ;;
    *)
      wamn_usage_error 'expected app APP_DIRECTORY... or proof'
      ;;
  esac
fi
readonly WAMN_MODE
readonly WAMN_ARTIFACT_PLAN_PATH

readonly WAMN_TOOL_DIRECTORY="$(
  CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_REPOSITORY_ROOT="$(
  CDPATH= cd -- "$WAMN_TOOL_DIRECTORY/.." >/dev/null 2>&1
  pwd -P
)"
readonly WAMN_VIRTUALIZATION_MANIFEST="$WAMN_REPOSITORY_ROOT/tools/component-virtualization.json"
readonly WAMN_CARGO="${CARGO:-cargo}"

command -v jq >/dev/null 2>&1 || wamn_fail 127 'jq is required'
command -v sha256sum >/dev/null 2>&1 || wamn_fail 127 'sha256sum is required'
if [[ "$WAMN_MODE" == virtualize-only ]]; then
  [[ -r "$WAMN_ARTIFACT_PLAN_PATH" ]] || {
    wamn_fail 65 "cannot read artifact plan $WAMN_ARTIFACT_PLAN_PATH"
  }
  WAMN_SUPPLIED_ARTIFACT_PLAN="$(
    jq -cseS '
      def exact_keys($expected): keys | sort == ($expected | sort);
      select(length == 1)
      | .[0]
      | select(exact_keys(["applications", "build", "profile", "virtualization"]))
      | select(.profile == "app" or .profile == "proof")
      | select(.applications | type == "array")
      | select(all(.applications[]; type == "string" and startswith("/")))
      | select(if .profile == "app" then (.applications | length > 0)
               else (.applications | length == 0) end)
      | select(.build | type == "array" and length > 0)
      | select([.build[]
                | select((exact_keys(["manifest", "packages"]) | not)
                         or (.manifest | type != "string" or length == 0)
                         or (.packages | type != "array" or length == 0)
                         or ([.packages[] | select(type != "string" or length == 0)]
                             | length > 0))]
               | length == 0)
      | select(.virtualization | exact_keys(["artifacts", "profile", "tool"]))
      | select(.virtualization.profile | type == "string" and length > 0)
      | select(.virtualization.tool | exact_keys(["manifest", "package"]))
      | select(.virtualization.artifacts | type == "array" and length > 0)
      | select([.virtualization.artifacts[]
                | select((exact_keys(["output", "package", "raw", "sha256"]) | not)
                         or (.package | type != "string" or length == 0)
                         or (.raw | type != "string" or length == 0)
                         or (.output | type != "string" or length == 0)
                         or (.sha256 | test("^[0-9a-f]{64}$") | not))]
               | length == 0)
    ' "$WAMN_ARTIFACT_PLAN_PATH"
  )" || wamn_fail 65 "invalid artifact plan $WAMN_ARTIFACT_PLAN_PATH"
  WAMN_PROFILE="$(jq -r '.profile' <<<"$WAMN_SUPPLIED_ARTIFACT_PLAN")"
  mapfile -t WAMN_APPLICATIONS < <(jq -r '.applications[]' <<<"$WAMN_SUPPLIED_ARTIFACT_PLAN")
fi
readonly WAMN_SUPPLIED_ARTIFACT_PLAN
readonly WAMN_PROFILE
[[ -r "$WAMN_VIRTUALIZATION_MANIFEST" ]] || {
  wamn_fail 65 "cannot read $WAMN_VIRTUALIZATION_MANIFEST"
}
if [[ "$WAMN_CARGO" == */* ]]; then
  [[ -x "$WAMN_CARGO" ]] || {
    wamn_fail 127 "Cargo executable is not executable: $WAMN_CARGO"
  }
else
  command -v "$WAMN_CARGO" >/dev/null 2>&1 || {
    wamn_fail 127 "Cargo executable was not found: $WAMN_CARGO"
  }
fi
cd -- "$WAMN_REPOSITORY_ROOT"

# Separate Cargo workspaces keep no-std guests isolated from std features.
readonly -a WAMN_MANIFESTS=(components/Cargo.toml components/no-std/Cargo.toml)
readonly WAMN_MANIFEST_LIST="$(printf '%s\n' "${WAMN_MANIFESTS[@]}" | jq -Rn '[inputs]')"
readonly WAMN_APPLICATION_LIST="$(printf '%s\n' "${WAMN_APPLICATIONS[@]}" | jq -Rn '[inputs | select(length > 0)]')"

# Application manifests declare the components that need virtualization.
# Proof builds select every Cargo member and read all application declarations.
declare -a WAMN_APPLICATION_MANIFESTS=()
if [[ "$WAMN_PROFILE" == app ]]; then
  for application in "${WAMN_APPLICATIONS[@]}"; do
    WAMN_APPLICATION_MANIFESTS+=("$application/wamn.json")
  done
else
  for application in "$WAMN_REPOSITORY_ROOT"/{packages,apps}/*/wamn.json; do
    [[ -f "$application" ]] || continue
    WAMN_APPLICATION_MANIFESTS+=("$application")
  done
fi
declare WAMN_PACKAGE_COMPONENTS
WAMN_PACKAGE_COMPONENTS="$(
  for application in "${WAMN_APPLICATION_MANIFESTS[@]}"; do
    jq -er '(.components // {}) | keys[]' "$application" || {
      wamn_fail 65 "cannot read components from $application"
    }
  done | tr '_' '-' | sort -u | jq -Rn '[inputs | select(length > 0)]'
)" || wamn_fail 65 'could not read application component declarations'
readonly WAMN_PACKAGE_COMPONENTS

declare -a WAMN_METADATA=()
declare WAMN_WORKSPACE_METADATA
for manifest in "${WAMN_MANIFESTS[@]}"; do
  WAMN_WORKSPACE_METADATA="$("$WAMN_CARGO" metadata \
    --manifest-path "$WAMN_REPOSITORY_ROOT/$manifest" \
    --locked --offline --no-deps --format-version 1)" || {
    wamn_fail 65 "locked component Cargo metadata failed for $manifest"
  }
  WAMN_METADATA+=("$WAMN_WORKSPACE_METADATA")
done
readonly WAMN_METADATA

# Every application component must be a declared Cargo workspace member.
declare WAMN_ABSENT_PACKAGE_COMPONENTS
WAMN_ABSENT_PACKAGE_COMPONENTS="$(
  printf '%s\n' "${WAMN_METADATA[@]}" | jq -er -s \
    --argjson package_components "$WAMN_PACKAGE_COMPONENTS" '
    [.[]
     | (.packages | map({key: .id, value: .name}) | from_entries) as $names
     | .workspace_members[] | $names[.]] as $members
    | ($package_components - $members) | join(", ")
  '
)" || wamn_fail 65 'could not read component workspace membership from locked metadata'
readonly WAMN_ABSENT_PACKAGE_COMPONENTS
if [[ -n "$WAMN_ABSENT_PACKAGE_COMPONENTS" ]]; then
  wamn_fail 65 "package component crates are absent from the declared component workspaces: $WAMN_ABSENT_PACKAGE_COMPONENTS. Create each missing crate. Add each crate to its Cargo workspace members."
fi

declare WAMN_PLAN
WAMN_PLAN="$(
  printf '%s\n' "${WAMN_METADATA[@]}" | jq -e -s --arg profile "$WAMN_PROFILE" \
    --argjson manifests "$WAMN_MANIFEST_LIST" \
    --argjson package_components "$WAMN_PACKAGE_COMPONENTS" '
    [to_entries[]
     | .key as $index
     | .value as $metadata
     | $metadata.packages[]
     | select(.id as $id | $metadata.workspace_members | index($id) != null)
     | select($profile == "proof" or (.name as $name | $package_components | index($name) != null))
     | {manifest: $manifests[$index], packages: [.name]}]
    | sort_by(.manifest, .packages[0])
    | select(length > 0)
  '
)" || wamn_fail 65 'component selection contains no Cargo workspace members'
readonly WAMN_PLAN

if [[ "$WAMN_MODE" == watch-roots ]]; then
  jq -nceS --arg profile "$WAMN_PROFILE" --argjson build "$WAMN_PLAN" '
    {profile: $profile,
     workspace_roots:
       [$build[].manifest
        | select(endswith("/Cargo.toml"))
        | sub("/Cargo.toml$"; "")]
       | unique}
    | select(.workspace_roots | length == ($build | map(.manifest) | unique | length))
  '
  exit 0
fi

# This is an allowlist, not discovery: upstream import filtering does not cover
# filesystem imports, so an undeclared std guest must remain raw and fail its
# own admission rather than inherit this profile implicitly.
declare WAMN_VIRTUALIZATION_PLAN
WAMN_VIRTUALIZATION_PLAN="$(
  printf '%s\n' "${WAMN_METADATA[@]}" | jq -e -s \
    --argjson manifests "$WAMN_MANIFEST_LIST" \
    --argjson build "$WAMN_PLAN" \
    --slurpfile virtualization "$WAMN_VIRTUALIZATION_MANIFEST" \
    --argjson package_components "$WAMN_PACKAGE_COMPONENTS" \
    --arg profile "$WAMN_PROFILE" '
    def basename:
      type == "string"
      and length > 0
      and (contains("/") | not)
      and . != "."
      and . != "..";
    def relative_path:
      type == "string"
      and length > 0
      and (startswith("/") | not)
      and (split("/") | all(length > 0 and . != "." and . != ".."));

    . as $metadata
    | $virtualization[0] as $virtual
    | [$build[].packages[]] as $selected
    | select(($virtual | keys | sort)
             == (["artifacts", "output_subdirectory", "profile", "tool"] | sort))
    | select(($virtual.tool | keys | sort) == ["manifest", "package"])
    | select($virtual.profile | test("^[a-z0-9][a-z0-9-]*$"))
    | select($virtual.output_subdirectory == ("virtualized/" + $virtual.profile))
    | select($virtual.tool.manifest | relative_path)
    | select($virtual.tool.package | type == "string" and length > 0)
    | select($metadata | length == ($manifests | length))
    | [range($manifests | length) as $index
       | {manifest: $manifests[$index],
          metadata: $metadata[$index]}] as $owners
    # The package half of the allowlist, synthesized from the package manifests
    # rather than listed. The owning workspace is whichever one actually holds
    # the crate, so nothing here hardcodes where a package component lives, and
    # a component a package names but no workspace contains is simply absent
    # from the plan and fails the count check below.
    | [$package_components[] as $component
       | [$owners[] | select([.metadata.packages[] | select(.name == $component)] | length == 1)]
         as $holders
       | select($holders | length == 1)
       | {package: $component,
          workspace_manifest: $holders[0].manifest,
          raw_file: (($component | gsub("-"; "_")) + ".wasm"),
          output_file: (($component | gsub("-"; "_")) + ".wasm")}] as $derived_artifacts
    | ($virtual.artifacts + $derived_artifacts) as $all_artifacts
    | select([$all_artifacts[]
              | select((keys | sort)
                       != ["output_file", "package", "raw_file", "workspace_manifest"])]
             | length == 0)
    | select($all_artifacts | length > 0)
    | select(($all_artifacts | map(.package) | length)
             == ($all_artifacts | map(.package) | unique | length))
    | select(($all_artifacts | map(.workspace_manifest + "\u0000" + .raw_file) | length)
             == ($all_artifacts
                 | map(.workspace_manifest + "\u0000" + .raw_file) | unique | length))
    | select(($all_artifacts | map(.output_file) | length)
             == ($all_artifacts | map(.output_file) | unique | length))
    | select([$all_artifacts[] as $artifact
              | select(($artifact.package | type != "string" or length == 0)
                       or ($artifact.workspace_manifest | relative_path | not)
                       or ($artifact.raw_file | basename | not)
                       or ($artifact.output_file | basename | not)
                       or ($artifact.raw_file | endswith(".wasm") | not)
                       or ($artifact.output_file | endswith(".wasm") | not))]
             | length == 0)
    | [$all_artifacts[] as $artifact
       | [$owners[] | select(.manifest == $artifact.workspace_manifest)] as $matching_owners
       | select($matching_owners | length == 1)
       | $matching_owners[0] as $owner
       | [$owner.metadata.packages[]
          | select(.name == $artifact.package)
          | select(.id as $id | $owner.metadata.workspace_members | index($id) != null)] as $packages
       | select($packages | length == 1)
       | $packages[0] as $package
       | [$package.targets[] | select(.crate_types | index("cdylib") != null)] as $targets
       | select($targets | length == 1)
       | select($artifact.raw_file == ($targets[0].name + ".wasm"))
       | {package: $artifact.package,
          raw: ($owner.metadata.target_directory
                + "/wasm32-wasip2/release/" + $artifact.raw_file),
          output: ($owner.metadata.target_directory + "/"
                   + $virtual.output_subdirectory + "/" + $artifact.output_file)}] as $artifacts
    | select($artifacts | length == ($all_artifacts | length))
    | select([$artifacts[] | select(.raw == .output)] | length == 0)
    | {profile: $virtual.profile,
       tool: $virtual.tool,
       artifacts: [$artifacts[] | select(.package as $package | $selected | index($package) != null)]}
    | select(.artifacts | length > 0)
  '
)" || wamn_fail 65 'component virtualization allowlist and locked metadata drifted'
readonly WAMN_VIRTUALIZATION_PLAN

readonly WAMN_LEG_COUNT="$(jq -r 'length' <<<"$WAMN_PLAN")"
((WAMN_LEG_COUNT > 0)) || wamn_fail 65 "$WAMN_PROFILE has an empty component selection"
printf 'build-components: %s selects %s component packages across %s Cargo invocations\n' \
  "$WAMN_PROFILE" "$(jq -r '[.[].packages[]] | length' <<<"$WAMN_PLAN")" \
  "$WAMN_LEG_COUNT" >&2

wamn_build() {
  local exit_status=0
  local leg manifest package leg_status
  local -a arguments

  # Every leg runs: one invocation's failure does not describe another
  # selection, including selections that share a workspace.
  for ((leg = 0; leg < WAMN_LEG_COUNT; leg += 1)); do
    manifest="$(jq -r --argjson leg "$leg" '.[$leg].manifest' <<<"$WAMN_PLAN")"
    # RELEASE, NOT DEBUG. The served guest was a debug artifact: 20,496,492
    # bytes against 533,473 for the same component under
    # components/Cargo.toml's [profile.release] (opt-level "s", strip true) --
    # 38x on the wire, and 24.4 s of compile against 9.2 s. The profile existed
    # and this build path never asked for it, so every OCI push, every cold
    # pull and every host compile paid for debuginfo nobody reads. The Dockerfile's
    # component-builder stage has always used --release; only this path did not.
    #
    # It does NOT change instantiate: 350 us release against 345 us debug,
    # inside the run-to-run spread (docs/perf/2026.09/4-instantiate/).
    arguments=(
      build --locked --offline --release --target wasm32-wasip2
      --manifest-path "$WAMN_REPOSITORY_ROOT/$manifest"
    )
    while IFS= read -r package; do
      arguments+=(-p "$package")
    done < <(jq -r --argjson leg "$leg" '.[$leg].packages[]' <<<"$WAMN_PLAN")
    leg_status=0
    # DIGEST STABILITY, second of two channels. Relocation (wamn-10yt.10.29) put
    # every guest-consumed crate inside this workspace so `-C metadata` stops
    # deriving from an absolute path; this closes the other channel, the
    # `file!()` strings that `include!`d package sources bake into the artifact.
    # `trim-paths` would say it at profile level but is unstable in Cargo 1.98.
    RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }--remap-path-prefix=$WAMN_REPOSITORY_ROOT=/wamn" \
      "$WAMN_CARGO" "${arguments[@]}" || leg_status=$?
    if ((leg_status != 0)); then
      printf 'build-components: FAIL: %s (exit %d)\n' "$manifest" "$leg_status" >&2
      if ((exit_status == 0)); then
        exit_status="$leg_status"
      fi
    fi
  done
  return "$exit_status"
}

wamn_artifact_plan() {
  local virtualization_plan="$WAMN_VIRTUALIZATION_PLAN"
  local count artifact input package digest
  count="$(jq -r '.artifacts | length' <<<"$virtualization_plan")"
  for ((artifact = 0; artifact < count; artifact += 1)); do
    input="$(jq -r --argjson artifact "$artifact" \
      '.artifacts[$artifact].raw' <<<"$virtualization_plan")"
    package="$(jq -r --argjson artifact "$artifact" \
      '.artifacts[$artifact].package' <<<"$virtualization_plan")"
    [[ -s "$input" ]] || {
      wamn_fail 65 "raw component is missing or empty for $package: $input"
    }
    digest="$(sha256sum -- "$input")" || {
      wamn_fail 65 "cannot hash raw component for $package: $input"
    }
    digest="${digest%% *}"
    virtualization_plan="$(
      jq -ceS --argjson artifact "$artifact" --arg digest "$digest" \
        '.artifacts[$artifact].sha256 = $digest' <<<"$virtualization_plan"
    )"
  done

  jq -nceS \
    --arg profile "$WAMN_PROFILE" \
    --argjson applications "$WAMN_APPLICATION_LIST" \
    --argjson build "$WAMN_PLAN" \
    --argjson virtualization "$virtualization_plan" \
    '{profile: $profile, applications: $applications, build: $build, virtualization: $virtualization}'
}

WAMN_PENDING_OUTPUT=''
wamn_cleanup_partial_output() {
  if [[ -n "$WAMN_PENDING_OUTPUT" ]]; then
    rm -f -- "$WAMN_PENDING_OUTPUT"
  fi
}

wamn_virtualize() {
  local -r artifact_plan="$1"
  local virtualization_profile virtualizer_manifest virtualizer_package count
  local output directory artifact input package virtualizer_status
  local -A directories=()

  virtualization_profile="$(jq -r '.virtualization.profile' <<<"$artifact_plan")"
  virtualizer_manifest="$WAMN_REPOSITORY_ROOT/$(
    jq -r '.virtualization.tool.manifest' <<<"$artifact_plan"
  )"
  virtualizer_package="$(jq -r '.virtualization.tool.package' <<<"$artifact_plan")"
  count="$(jq -r '.virtualization.artifacts | length' <<<"$artifact_plan")"

  # Clear outputs only after the full plan and every raw digest are valid.
  # App builds own only their selected files. Proof owns the full directory.
  while IFS= read -r output; do
    directory="$(dirname -- "$output")"
    [[ -n "$directory" && "$directory" != / \
       && "$directory" == */virtualized/"$virtualization_profile" ]] || {
      wamn_fail 65 "unsafe virtualization output directory: $directory"
    }
    directories["$directory"]=1
  done < <(jq -r '.virtualization.artifacts[].output' <<<"$artifact_plan")
  for directory in "${!directories[@]}"; do
    if [[ "$WAMN_PROFILE" == proof ]]; then
      rm -rf -- "$directory"
    fi
    mkdir -p -- "$directory"
  done
  if [[ "$WAMN_PROFILE" == app ]]; then
    while IFS= read -r output; do
      rm -f -- "$output"
    done < <(jq -r '.virtualization.artifacts[].output' <<<"$artifact_plan")
  fi

  trap wamn_cleanup_partial_output EXIT
  printf 'build-components: %s normalizes %s declared artifacts with profile %s\n' \
    "$WAMN_PROFILE" "$count" "$virtualization_profile" >&2
  for ((artifact = 0; artifact < count; artifact += 1)); do
    input="$(jq -r --argjson artifact "$artifact" \
      '.virtualization.artifacts[$artifact].raw' <<<"$artifact_plan")"
    output="$(jq -r --argjson artifact "$artifact" \
      '.virtualization.artifacts[$artifact].output' <<<"$artifact_plan")"
    package="$(jq -r --argjson artifact "$artifact" \
      '.virtualization.artifacts[$artifact].package' <<<"$artifact_plan")"

    mkdir -p -- "$(dirname -- "$output")"
    WAMN_PENDING_OUTPUT="${output}.partial.$$"
    rm -f -- "$WAMN_PENDING_OUTPUT"

    virtualizer_status=0
    "$WAMN_CARGO" run --locked --offline \
      --manifest-path "$virtualizer_manifest" \
      -p "$virtualizer_package" -- \
      --input "$input" --output "$WAMN_PENDING_OUTPUT" || virtualizer_status=$?
    if ((virtualizer_status != 0)); then
      wamn_fail "$virtualizer_status" \
        "virtualization failed for $package with profile $virtualization_profile"
    fi
    [[ -s "$WAMN_PENDING_OUTPUT" ]] || {
      wamn_fail 65 "virtualizer produced no component for $package"
    }
    mv -f -- "$WAMN_PENDING_OUTPUT" "$output"
    WAMN_PENDING_OUTPUT=''
    printf 'build-components: normalized %s -> %s\n' "$package" "$output" >&2
  done
  trap - EXIT
}

if [[ "$WAMN_MODE" != virtualize-only ]]; then
  wamn_build
fi

WAMN_CURRENT_ARTIFACT_PLAN="$(wamn_artifact_plan)"
readonly WAMN_CURRENT_ARTIFACT_PLAN
if [[ "$WAMN_MODE" == build-only ]]; then
  printf '%s\n' "$WAMN_CURRENT_ARTIFACT_PLAN"
  exit 0
fi
if [[ "$WAMN_MODE" == virtualize-only \
      && "$WAMN_SUPPLIED_ARTIFACT_PLAN" != "$WAMN_CURRENT_ARTIFACT_PLAN" ]]; then
  wamn_fail 65 'artifact plan is stale or does not match the current component selection'
fi

wamn_virtualize "$WAMN_CURRENT_ARTIFACT_PLAN"
