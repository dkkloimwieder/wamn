{
  "schema_version": "0.1",
  "scope": {
    "included_authority": "Wamn-owned production PostgreSQL tables and generated table families",
    "excluded_external_authorities": [
      "kubernetes-desired-and-observed-state",
      "secret-bytes-and-native-metadata",
      "oci-and-signing-artifacts",
      "jetstream-transport-state",
      "backup-objects-and-native-metadata",
      "telemetry"
    ]
  },
  "principals": {
    "system-schema-installer": {
      "path": "deploy/sql/system-schema.sql",
      "role": "migration"
    },
    "control-portable-store-installer": {
      "path": "deploy/sql/control-portable-store.sql",
      "role": "migration"
    },
    "catalog-schema-installer": {
      "path": "deploy/sql/catalog-schema.sql",
      "role": "migration"
    },
    "registry-store": {
      "path": "crates/control/registry",
      "role": "persistence"
    },
    "provision-store": {
      "path": "crates/control/provision",
      "role": "persistence"
    },
    "schema-control": {
      "path": "crates/schema/control",
      "role": "migration"
    },
    "project-state": {
      "path": "crates/identity/project-state",
      "role": "semantic"
    },
    "platform-identity": {
      "path": "crates/identity/platform",
      "role": "persistence"
    },
    "event-registration-model": {
      "path": "components/events/registration",
      "role": "semantic"
    },
    "run-state": {
      "path": "crates/execution/run-state",
      "role": "persistence"
    },
    "execution-host": {
      "path": "crates/execution/host",
      "role": "effect"
    },
    "execution-contract": {
      "path": "components/execution/contract",
      "role": "semantic"
    },
    "catalog-model": {
      "path": "crates/catalog/model",
      "role": "semantic"
    },
    "ctl-copy": {
      "path": "services/ctl/src/copy_project_env.rs",
      "role": "effect",
      "note": "carries all relations verbatim; authors none"
    },
    "ctl-apply-package": {
      "path": "services/ctl/src/apply_package.rs",
      "role": "effect"
    },
    "ctl-publish-release": {
      "path": "services/ctl/src/publish_release.rs",
      "role": "effect"
    },
    "ctl-author-wiring": {
      "path": "services/ctl/src/author_wiring.rs",
      "role": "effect"
    },
    "ctl-promote": {
      "path": "services/ctl/src/promote.rs",
      "role": "effect"
    },
    "ctl-push": {
      "path": "services/ctl/src/push_component.rs",
      "role": "effect"
    },
    "ctl-env-policies": {
      "path": "services/ctl/src/env_policies.rs",
      "role": "migration"
    },
    "ctl-reconcile-run-plane": {
      "path": "services/ctl/src/reconcile_run_plane.rs",
      "role": "effect"
    },
    "ctl-terminalize": {
      "path": "services/ctl/src/terminalize_effect_uncertain.rs",
      "role": "effect"
    },
    "dispatcher": {
      "path": "services/dispatcher",
      "role": "effect"
    },
    "scenario-worker": {
      "path": "services/scenario-worker",
      "role": "effect"
    },
    "cdc-reader": {
      "path": "services/cdc-reader",
      "role": "reader"
    },
    "platform-runtime": {
      "path": "crates/platform/runtime",
      "role": "reader",
      "note": "reader-only: the host's wiring-resolution and claim snapshots name catalog relations in production SQL but author none"
    },
    "event-materializer": {
      "path": "components/events/materializer",
      "role": "reader",
      "note": "reader-only: the materializer guest's registration sweep SQL"
    },
    "run-state-schema-installer": {
      "path": "deploy/sql/run-state.sql",
      "role": "reader",
      "note": "reader-only: the run-plane DDL's trigger bodies read the durability projection and the effect ledger; the relations' migration owners are schema-control and run-state"
    },
    "materializer": {
      "path": "components/execution/materializer",
      "role": "effect"
    }
  },
  "canonical_sources": [
    {
      "path": "deploy/sql/system-schema.sql",
      "kind": "ddl",
      "scope": "production-control-database"
    },
    {
      "path": "deploy/sql/ops-schema.sql",
      "kind": "ddl",
      "scope": "production-control-database-ops"
    },
    {
      "path": "deploy/sql/control-portable-store.sql",
      "kind": "ddl",
      "scope": "production-control-database-portable-store"
    },
    {
      "path": "deploy/sql/catalog-schema.sql",
      "kind": "ddl",
      "scope": "production-project-database"
    },
    {
      "path": "deploy/sql/app-schema.sql",
      "kind": "ddl",
      "scope": "production-project-database"
    },
    {
      "path": "deploy/sql/run-state.sql",
      "kind": "ddl",
      "scope": "production-project-database"
    },
    {
      "path": "deploy/sql/run-queue.sql",
      "kind": "ddl",
      "scope": "production-project-database"
    },
    {
      "path": "crates/control/provision/src/sql.rs",
      "kind": "inline-family",
      "scope": "production-project-database",
      "marker": "CREATE TABLE IF NOT EXISTS {schema}.wamn_"
    }
  ],
  "excluded_sources": [
    {
      "path": "deploy/sql/postgres-init.sql",
      "source_class": "gate-fixture-stand-in",
      "reason": "S2 benchmark and host-plugin fixtures are not production PostgreSQL authority",
      "expected_objects": [
        "s2.bench",
        "s2.rls_secrets",
        "s2.scratch",
        "s2.fkchild"
      ]
    }
  ],
  "scan_policy": {
    "roots": [
      "crates",
      "services",
      "components",
      "deploy/sql"
    ],
    "extensions": [
      "rs",
      "sql"
    ],
    "rust_cfg_test_modules": "exclude",
    "exclusions": [
      {
        "kind": "path-segment",
        "value": "tests",
        "source_class": "repository-test"
      },
      {
        "kind": "path-segment",
        "value": "examples",
        "source_class": "repository-example"
      },
      {
        "kind": "path-prefix",
        "value": "components/fixtures",
        "source_class": "gate-fixture"
      },
      {
        "kind": "exact-file",
        "value": "deploy/sql/postgres-init.sql",
        "source_class": "gate-fixture-stand-in"
      },
      {
        "kind": "exact-file",
        "value": "crates/schema/generator/src/sql.rs",
        "source_class": "package-corpus-generator"
      }
    ],
    "unqualified_contexts": [
      {
        "path_prefix": "crates/execution/run-state/src",
        "default_schema": "wamn_run"
      },
      {
        "path_prefix": "crates/schema/control/src/run_plane.rs",
        "default_schema": "wamn_run"
      },
      {
        "path_prefix": "services/scenario-worker/src",
        "default_schema": "wamn_run"
      },
      {
        "path_prefix": "services/ctl/src/copy_project_env.rs",
        "default_schema": "wamn_run"
      },
      {
        "path_prefix": "services/ctl/src/reconcile_run_plane.rs",
        "default_schema": "wamn_run"
      }
    ],
    "dynamic_writers": [],
    "ignored_literals": [
      {
        "path": "services/cdc-reader/src/lib.rs",
        "literal": "TRUNCATE observed — not published",
        "reason": "telemetry for an observed replication event, not a SQL statement"
      },
      {
        "path": "crates/schema/generator/src/sql_lex.rs",
        "literal": "UPDATE is missing SET",
        "reason": "semantic analyzer diagnostic, not an executed SQL statement"
      }
    ]
  },
