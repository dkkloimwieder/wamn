      "scope": "production-project-database"
    },
    {
      "path": "deploy/sql/run-state.sql",
      "kind": "ddl",
      "scope": "production-project-database"
    },
    {
      "path": "deploy/sql/run-queue.sql",
      "kind": "ddl",
      "scope": "production-project-database"
    },
    {
      "path": "crates/control/provision/src/sql.rs",
      "kind": "inline-family",
      "scope": "production-project-database",
      "marker": "CREATE TABLE IF NOT EXISTS {schema}.wamn_entities"
    },
    {
      "path": "crates/schema/compiler/src/emit.rs",
      "kind": "generated-family",
      "scope": "production-project-database",
      "marker": "CREATE TABLE {}"
    }
  ],
  "excluded_sources": [
    {
      "path": "deploy/sql/postgres-init.sql",
      "source_class": "gate-fixture-stand-in",
      "reason": "S2/S3 benchmark and host-plugin fixtures are not production PostgreSQL authority",
      "expected_objects": [
        "s2.bench",
        "s2.rls_secrets",
        "s2.scratch",
        "s2.fkchild",
        "s3.flows",
        "s3.sink",
        "s3.runs"
      ]
    }
  ],
  "scan_policy": {
    "roots": [
      "crates",
      "services",
      "components",
      "deploy/sql"
    ],
    "extensions": [
      "rs",
      "sql"
    ],
    "rust_cfg_test_modules": "exclude",
    "exclusions": [
      {
        "kind": "path-segment",
        "value": "tests",
        "source_class": "repository-test"
      },
      {
        "kind": "path-segment",
        "value": "examples",
        "source_class": "repository-example"
      },
      {
        "kind": "path-prefix",
        "value": "components/fixtures",
        "source_class": "gate-fixture"
      },
      {
        "kind": "exact-file",
        "value": "deploy/sql/postgres-init.sql",
        "source_class": "gate-fixture-stand-in"
      }
    ],
    "unqualified_contexts": [
      {
        "path_prefix": "crates/execution/run-state/src",
        "default_schema": "wamn_run"
      },
      {
        "path_prefix": "crates/schema/control/src/run_plane.rs",
        "default_schema": "wamn_run"
      },
      {
        "path_prefix": "services/scenario-worker/src",
        "default_schema": "wamn_run"
      },
      {
        "path_prefix": "services/ctl/src/publish_catalog.rs",
        "default_schema": "wamn_run"
      },
      {
        "path_prefix": "services/ctl/src/copy_project_env.rs",
        "default_schema": "wamn_run"
      },
      {
        "path_prefix": "services/ctl/src/reconcile_run_plane.rs",
        "default_schema": "wamn_run"
      }
    ],
    "dynamic_writers": [
      {
        "path": "crates/data/entity-access/src/planner.rs",
        "principal": "entity-access",
        "family": "generated-tenant-entities",
        "marker": "INSERT INTO {}",
        "operations": [
          "insert",
          "update",
          "delete"
        ]
      },
      {
        "path": "crates/schema/compiler/src/seed/emit.rs",
        "principal": "schema-compiler",
        "family": "generated-tenant-entities",
        "marker": "INSERT INTO {tbl}",
        "operations": [
          "insert"
        ]
      }
    ],
    "ignored_literals": [
      {
        "path": "services/cdc-reader/src/lib.rs",
        "literal": "TRUNCATE observed — not published",
        "reason": "telemetry for an observed replication event, not a SQL statement"
      }
    ]
  },
