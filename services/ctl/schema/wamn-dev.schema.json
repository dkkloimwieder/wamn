{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "LocalArtifacts": {
      "additionalProperties": false,
      "description": "Explicit local candidate files owned by one disposable development session.",
      "properties": {
        "bindings": {
          "type": [
            "string",
            "null"
          ]
        },
        "directory": {
          "type": "string"
        },
        "flow_http_component": {
          "type": "string"
        }
      },
      "required": [
        "directory",
        "flow_http_component"
      ],
      "type": "object"
    }
  },
  "description": "Sole field authority for the strict deployment-owned `dev.json` document.",
  "if": {
    "not": {
      "required": [
        "local_artifacts"
      ]
    }
  },
  "properties": {
    "catalog": {
      "type": "string"
    },
    "component_artifact_base": {
      "default": "",
      "type": "string"
    },
    "dup_window_secs": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "effective_release_id": {
      "format": "uint32",
      "minimum": 1.0,
      "type": "integer"
    },
    "environment": {
      "type": "string"
    },
    "event_materializer_database_url": {
      "type": "string"
    },
    "event_nats_password_file": {
      "type": "string"
    },
    "event_nats_url": {
      "type": "string"
    },
    "event_nats_username": {
      "type": "string"
    },
    "executor_platform_database_url": {
      "type": "string"
    },
    "flow_http_workload_image": {
      "default": "",
      "type": "string"
    },
    "gate_bearer_token": {
      "type": "string"
    },
    "gate_url": {
      "type": "string"
    },
    "guest_database_url": {
      "type": "string"
    },
    "host_binary": {
      "type": "string"
    },
    "host_group": {
      "type": "string"
    },
    "host_name": {
      "type": "string"
    },
    "http_admitter_database_url": {
      "type": "string"
    },
    "identity_database_url": {
      "type": "string"
    },
    "insecure_registry": {
      "default": false,
      "type": "boolean"
    },
    "local_artifacts": {
      "allOf": [
        {
          "$ref": "#/definitions/LocalArtifacts"
        }
      ],
      "default": null
    },
    "operator_bearer_token": {
      "default": null,
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "otel_exporter_otlp_endpoint": {
      "type": "string"
    },
    "package_sources": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "project": {
      "type": "string"
    },
    "registry_auth_file": {
      "default": "",
      "type": "string"
    },
    "release_artifact_base": {
      "default": "",
      "type": "string"
    },
    "route_host": {
      "type": "string"
    },
    "runner": {
      "type": "string"
    },
    "scheduler_nats_url": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "stream_replicas": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "system_database_url": {
      "type": "string"
    },
    "target_database_acl_file": {
      "type": "string"
    },
    "target_database_url": {
      "type": "string"
    },
    "target_privileges_file": {
      "type": "string"
    },
    "target_template_database": {
      "type": "string"
    },
    "tempo_query_url": {
      "type": "string"
    },
    "tenant": {
      "type": "string"
    },
    "verification_database_url": {
      "type": "string"
    },
    "wasmtime_cache_dir": {
      "type": "string"
    }
  },
  "required": [
    "catalog",
    "dup_window_secs",
    "effective_release_id",
    "environment",
    "event_materializer_database_url",
    "event_nats_password_file",
    "event_nats_url",
    "event_nats_username",
    "executor_platform_database_url",
    "gate_bearer_token",
    "gate_url",
    "guest_database_url",
    "host_binary",
    "host_group",
    "host_name",
    "http_admitter_database_url",
    "identity_database_url",
    "org",
    "otel_exporter_otlp_endpoint",
    "package_sources",
    "project",
    "route_host",
    "runner",
    "scheduler_nats_url",
    "schema",
    "stream_replicas",
    "system_database_url",
    "target_database_acl_file",
    "target_database_url",
    "target_privileges_file",
    "target_template_database",
    "tempo_query_url",
    "tenant",
    "verification_database_url",
    "wasmtime_cache_dir"
  ],
  "then": {
    "required": [
      "component_artifact_base",
      "release_artifact_base",
      "registry_auth_file",
      "insecure_registry",
      "flow_http_workload_image"
    ]
  },
  "title": "DevConfigDocument",
  "type": "object"
}
