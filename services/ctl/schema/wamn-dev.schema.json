      "type": "string"
    },
    "event_nats_url": {
      "type": "string"
    },
    "executor_platform_database_url": {
      "type": "string"
    },
    "flow_http_workload_image": {
      "type": "string"
    },
    "gate_bearer_token": {
      "type": "string"
    },
    "gate_url": {
      "type": "string"
    },
    "guest_database_url": {
      "type": "string"
    },
    "host_binary": {
      "type": "string"
    },
    "host_group": {
      "type": "string"
    },
    "host_name": {
      "type": "string"
    },
    "http_admitter_database_url": {
      "type": "string"
    },
    "identity_database_url": {
      "type": "string"
    },
    "insecure_registry": {
      "type": "boolean"
