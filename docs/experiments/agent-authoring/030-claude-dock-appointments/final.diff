diff --git a/packages/dock/query/appointment_by_dock_day.sql b/packages/dock/query/appointment_by_dock_day.sql
new file mode 100644
index 00000000..c47b915c
--- /dev/null
+++ b/packages/dock/query/appointment_by_dock_day.sql
@@ -0,0 +1,14 @@
+SELECT
+    appointment.id AS appointment_id,
+    appointment.dock_id,
+    appointment.carrier_id,
+    appointment.slot_start,
+    appointment.slot_end,
+    appointment.status,
+    appointment.arrived_at
+FROM appointment
+WHERE appointment.dock_id = $1
+    AND appointment.slot_start >= $2
+    AND appointment.slot_start < $3
+    AND ($4::text IS NULL OR appointment.status = $4::text)
+ORDER BY appointment.slot_start ASC, appointment.id ASC;
