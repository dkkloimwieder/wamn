diff --git a/components/application/dock/src/canonical.rs b/components/application/dock/src/canonical.rs
new file mode 100644
index 00000000..9f438413
--- /dev/null
+++ b/components/application/dock/src/canonical.rs
@@ -0,0 +1,98 @@
+//! Pure canonical spellings shared by every dock operation.
+//!
+//! Canonicalization is not validation. The command identity that
+//! `appointment.book` stores is the canonical JSON of the re-spelled input, so
+//! every member the manifest names is parsed and written back here before it
+//! reaches the command bytes.
+
+use chrono::{DateTime, NaiveDate, SecondsFormat};
+
+/// Re-spell one canonical lowercase-hyphenated UUID.
+pub(crate) fn canonical_uuid(value: &str) -> Option<String> {
+    uuid::Uuid::parse_str(value)
+        .ok()
+        .map(|parsed| parsed.hyphenated().to_string())
+        .filter(|spelled| spelled == value)
+}
+
+/// Re-spell any RFC 3339 timestamp as UTC with six fractional digits.
+///
+/// Canonicalization, not validation. The command identity `appointment.book`
+/// stores is the canonical JSON of the re-spelled input, so a retry that sends
+/// `...T08:00:00Z` where the first call sent `...T08:00:00.000000Z` names the
+/// same instant and therefore the same command, not a conflicting one.
+pub(crate) fn utc_timestamp(value: &str) -> Option<String> {
+    DateTime::parse_from_rfc3339(value).ok().map(|timestamp| {
+        timestamp
+            .to_utc()
+            .to_rfc3339_opts(SecondsFormat::Micros, true)
+    })
+}
+
+/// Half-open UTC bounds of one `YYYY-MM-DD` calendar day.
+///
+/// A slot is an instant, so "one day" needs a zone. This package names UTC and
+/// nothing else, which is why the bounds are derived here rather than supplied.
+pub(crate) fn utc_day_bounds(day: &str) -> Option<(String, String)> {
+    let date = NaiveDate::parse_from_str(day, "%Y-%m-%d").ok()?;
+    if date.format("%Y-%m-%d").to_string() != day {
+        return None;
+    }
+    let start = date.and_hms_opt(0, 0, 0)?.and_utc();
+    let end = date.succ_opt()?.and_hms_opt(0, 0, 0)?.and_utc();
+    Some((
+        start.to_rfc3339_opts(SecondsFormat::Micros, true),
+        end.to_rfc3339_opts(SecondsFormat::Micros, true),
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{canonical_uuid, utc_day_bounds, utc_timestamp};
+
+    #[test]
+    fn only_the_canonical_uuid_spelling_is_accepted() {
+        let canonical = "1b4e28ba-2fa1-11d2-883f-0016d3cca427";
+        assert_eq!(canonical_uuid(canonical).as_deref(), Some(canonical));
+        assert_eq!(canonical_uuid("1B4E28BA-2FA1-11D2-883F-0016D3CCA427"), None);
+        assert_eq!(canonical_uuid("1b4e28ba2fa111d2883f0016d3cca427"), None);
+        assert_eq!(canonical_uuid("not-a-uuid"), None);
+    }
+
+    #[test]
+    fn every_spelling_of_one_instant_becomes_one_timestamp() {
+        let canonical = "2026-09-10T08:00:00.000000Z";
+        for spelling in [
+            canonical,
+            "2026-09-10T08:00:00Z",
+            "2026-09-10T09:00:00+01:00",
+            "2026-09-10T08:00:00.000Z",
+        ] {
+            assert_eq!(utc_timestamp(spelling).as_deref(), Some(canonical));
+        }
+        assert_eq!(utc_timestamp("2026-09-10"), None);
+        assert_eq!(utc_timestamp("2026-09-10T08:00:00"), None);
+        assert_eq!(utc_timestamp(""), None);
+    }
+
+    #[test]
+    fn a_day_becomes_half_open_utc_bounds() {
+        assert_eq!(
+            utc_day_bounds("2026-09-10"),
+            Some((
+                "2026-09-10T00:00:00.000000Z".to_owned(),
+                "2026-09-11T00:00:00.000000Z".to_owned(),
+            ))
+        );
+        assert_eq!(
+            utc_day_bounds("2026-12-31"),
+            Some((
+                "2026-12-31T00:00:00.000000Z".to_owned(),
+                "2027-01-01T00:00:00.000000Z".to_owned(),
+            ))
+        );
+        assert_eq!(utc_day_bounds("2026-9-10"), None);
+        assert_eq!(utc_day_bounds("2026-02-30"), None);
+        assert_eq!(utc_day_bounds(""), None);
+    }
+}
diff --git a/components/application/dock/src/error.rs b/components/application/dock/src/error.rs
new file mode 100644
index 00000000..1a100112
--- /dev/null
+++ b/components/application/dock/src/error.rs
@@ -0,0 +1,197 @@
+//! Contextual refusals translated once at the dock operation boundary.
+
+use std::error::Error;
+use std::fmt;
+
+use wamn_postgres_statements::{StatementError, StatementErrorKind};
+
+/// Every refusal literal the dock package declares.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum RefusalKind {
+    InvalidInput,
+    NotFound,
+    DockNotFound,
+    CarrierNotFound,
+    SlotUnavailable,
+    IdempotencyConflict,
+    AppointmentNotScheduled,
+    CarrierCodeConflict,
+    DockCodeConflict,
+    Retry,
+    Timeout,
+    PermissionDenied,
+    InternalError,
+}
+
+impl RefusalKind {
+    /// Frozen operation-contract literal for this refusal.
+    pub(crate) const fn literal(self) -> &'static str {
+        match self {
+            Self::InvalidInput => "invalid_input",
+            Self::NotFound => "not_found",
+            Self::DockNotFound => "dock_not_found",
+            Self::CarrierNotFound => "carrier_not_found",
+            Self::SlotUnavailable => "slot_unavailable",
+            Self::IdempotencyConflict => "idempotency_conflict",
+            Self::AppointmentNotScheduled => "appointment_not_scheduled",
+            Self::CarrierCodeConflict => "carrier_code_conflict",
+            Self::DockCodeConflict => "dock_code_conflict",
+            Self::Retry => "retry",
+            Self::Timeout => "timeout",
+            Self::PermissionDenied => "permission_denied",
+            Self::InternalError => "internal_error",
+        }
+    }
+}
+
+/// One refused operation item, with the structured detail its code declares.
+#[derive(Debug)]
+pub(crate) struct Refusal {
+    kind: RefusalKind,
+    context: Box<str>,
+    field: Option<&'static str>,
+    id: Option<Box<str>>,
+    constraint: Option<Box<str>>,
+}
+
+impl Refusal {
+    /// Stable class; callers never match display text.
+    pub(crate) const fn kind(&self) -> RefusalKind {
+        self.kind
+    }
+
+    /// Input field this refusal belongs to.
+    pub(crate) const fn field(&self) -> Option<&'static str> {
+        self.field
+    }
+
+    /// Subject identity carried by a `field`+`id` detail.
+    pub(crate) fn id(&self) -> Option<&str> {
+        self.id.as_deref()
+    }
+
+    /// Named PostgreSQL constraint carried by a constraint detail.
+    pub(crate) fn constraint(&self) -> Option<&str> {
+        self.constraint.as_deref()
+    }
+
+    pub(crate) fn invalid(context: impl Into<Box<str>>, field: &'static str) -> Self {
+        Self::named(RefusalKind::InvalidInput, context, field)
+    }
+
+    pub(crate) fn named(
+        kind: RefusalKind,
+        context: impl Into<Box<str>>,
+        field: &'static str,
+    ) -> Self {
+        Self {
+            field: Some(field),
+            ..Self::new(kind, context)
+        }
+    }
+
+    pub(crate) fn subject(
+        kind: RefusalKind,
+        context: impl Into<Box<str>>,
+        field: &'static str,
+        id: impl Into<Box<str>>,
+    ) -> Self {
+        Self {
+            id: Some(id.into()),
+            ..Self::named(kind, context, field)
+        }
+    }
+
+    pub(crate) fn internal(context: impl Into<Box<str>>) -> Self {
+        Self::new(RefusalKind::InternalError, context)
+    }
+
+    /// Translate one statement failure, honouring this operation's constraints.
+    pub(crate) fn from_statement(
+        context: impl Into<Box<str>>,
+        source: &StatementError,
+        constraints: &[(&str, RefusalKind)],
+    ) -> Self {
+        let mapped = source.constraint().and_then(|name| {
+            constraints
+                .iter()
+                .find(|(candidate, _)| *candidate == name)
+                .map(|(_, kind)| (name.to_owned(), *kind))
+        });
+        if let Some((name, kind)) = mapped {
+            return Self {
+                constraint: Some(name.into_boxed_str()),
+                ..Self::new(kind, context)
+            };
+        }
+        Self::new(classify(source.kind()), context)
+    }
+
+    fn new(kind: RefusalKind, context: impl Into<Box<str>>) -> Self {
+        Self {
+            kind,
+            context: context.into(),
+            field: None,
+            id: None,
+            constraint: None,
+        }
+    }
+}
+
+impl fmt::Display for Refusal {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "{}: {}", self.kind.literal(), self.context)
+    }
+}
+
+impl Error for Refusal {}
+
+fn classify(kind: StatementErrorKind) -> RefusalKind {
+    match kind {
+        StatementErrorKind::SerializationFailure | StatementErrorKind::ConnectionUnavailable => {
+            RefusalKind::Retry
+        }
+        StatementErrorKind::StatementTimeout => RefusalKind::Timeout,
+        StatementErrorKind::PermissionDenied => RefusalKind::PermissionDenied,
+        StatementErrorKind::UnknownStatement
+        | StatementErrorKind::StatementContractMismatch
+        | StatementErrorKind::RowLimitExceeded
+        | StatementErrorKind::UniqueViolation
+        | StatementErrorKind::ForeignKeyViolation
+        | StatementErrorKind::CheckViolation
+        | StatementErrorKind::QueryError
+        | StatementErrorKind::InvalidResult => RefusalKind::InternalError,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{RefusalKind, classify};
+    use wamn_postgres_statements::StatementErrorKind;
+
+    #[test]
+    fn only_contractual_database_classes_cross_the_boundary() {
+        for (source, expected) in [
+            (StatementErrorKind::SerializationFailure, RefusalKind::Retry),
+            (
+                StatementErrorKind::ConnectionUnavailable,
+                RefusalKind::Retry,
+            ),
+            (StatementErrorKind::StatementTimeout, RefusalKind::Timeout),
+            (
+                StatementErrorKind::PermissionDenied,
+                RefusalKind::PermissionDenied,
+            ),
+            (
+                StatementErrorKind::UniqueViolation,
+                RefusalKind::InternalError,
+            ),
+            (
+                StatementErrorKind::CheckViolation,
+                RefusalKind::InternalError,
+            ),
+        ] {
+            assert_eq!(classify(source), expected);
+        }
+    }
+}
