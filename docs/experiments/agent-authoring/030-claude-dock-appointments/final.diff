+//! The public envelope every dock operation reads and writes.
+//!
+//! One request is a JSON array of items. Each item carries its own
+//! `request_id` and succeeds or is refused on its own, so one bad item never
+//! decides the fate of its neighbours.
+
+use serde::Serialize;
+use serde::de::DeserializeOwned;
+use serde_json::Value;
+
+use crate::error::{Refusal, RefusalKind};
+
+const MAX_ENVELOPE_ITEMS: usize = 100;
+
+/// Envelope refusal translated to the frozen node invalid-input arm.
+#[derive(Debug)]
+pub struct InvocationError {
+    context: &'static str,
+}
+
+impl InvocationError {
+    /// Frozen WIT error-detail code.
+    #[expect(
+        clippy::unused_self,
+        reason = "the node error boundary reads code and context off one value"
+    )]
+    pub const fn code(&self) -> &'static str {
+        "invalid_input"
+    }
+
+    /// Stable, non-database refusal description.
+    pub const fn context(&self) -> &'static str {
+        self.context
+    }
+
+    const fn new(context: &'static str) -> Self {
+        Self { context }
+    }
+}
+
+/// One envelope item: its identity and the body the operation parses.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct EnvelopeItem {
+    pub(crate) request_id: Box<str>,
+    pub(crate) body: Value,
+}
+
+/// Split one raw request into bounded, identified items.
+pub(crate) fn prepare_envelope(input: &str) -> Result<Box<[EnvelopeItem]>, InvocationError> {
+    let value: Value = serde_json::from_str(input)
+        .map_err(|_| InvocationError::new("operation input must be a JSON array"))?;
+    let Value::Array(values) = value else {
+        return Err(InvocationError::new("operation input must be a JSON array"));
+    };
+    if !(1..=MAX_ENVELOPE_ITEMS).contains(&values.len()) {
+        return Err(InvocationError::new(
+            "operation input item count must be 1..=100",
+        ));
+    }
+
+    values
+        .into_iter()
+        .map(|value| {
+            let Value::Object(mut object) = value else {
+                return Err(InvocationError::new(
+                    "every operation item must be a JSON object",
+                ));
+            };
+            let request_id = match object.remove("request_id") {
+                Some(Value::String(request_id)) if !request_id.is_empty() => request_id,
+                _ => {
+                    return Err(InvocationError::new(
+                        "every operation item must carry a nonempty string request_id",
+                    ));
+                }
+            };
+            Ok(EnvelopeItem {
+                request_id: request_id.into_boxed_str(),
+                body: Value::Object(object),
+            })
+        })
+        .collect::<Result<Vec<_>, _>>()
+        .map(Vec::into_boxed_slice)
+}
+
+/// Decode one item body into its declared input contract.
+pub(crate) fn parse_item<T: DeserializeOwned>(item: &EnvelopeItem) -> Result<T, Refusal> {
+    serde_json::from_value(item.body.clone())
+        .map_err(|_| Refusal::invalid("operation item does not match its input contract", "input"))
+}
+
+/// What one item produced: its value, or the refusal that replaced it.
+#[derive(Debug, Serialize)]
+#[serde(untagged)]
+pub(crate) enum ItemResult<T> {
+    Succeeded {
+        request_id: Box<str>,
+        value: T,
+    },
+    Refused {
+        request_id: Box<str>,
+        error: OperationError,
+    },
+}
+
+/// One serialized refusal: its code and the detail that code declares.
+#[derive(Debug, Serialize)]
+pub(crate) struct OperationError {
+    code: &'static str,
+    detail: ErrorDetail,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(untagged)]
+enum ErrorDetail {
+    Field(FieldDetail),
+    FieldId(FieldIdDetail),
+    Constraint(ConstraintDetail),
+    Permission(PermissionDetail),
+    Empty(EmptyDetail),
+}
+
+#[derive(Debug, Serialize)]
+struct FieldDetail {
+    field: &'static str,
+}
+
+#[derive(Debug, Serialize)]
+struct FieldIdDetail {
+    field: &'static str,
+    id: Box<str>,
+}
+
+#[derive(Debug, Serialize)]
+struct ConstraintDetail {
+    constraint: Box<str>,
+}
+
+#[derive(Debug, Serialize)]
+struct PermissionDetail {
+    operation: &'static str,
+}
+
+#[derive(Debug, Serialize)]
+struct EmptyDetail {}
+
+/// Bounded-list values travel under one `rows` member.
+#[derive(Debug, Serialize)]
+pub(crate) struct RowsValue<T> {
+    pub(crate) rows: Box<[T]>,
+}
+
+/// Render one refusal in the exact detail shape its code declares.
+pub(crate) fn operation_error(refusal: &Refusal, operation: &'static str) -> OperationError {
+    let internal = || OperationError {
+        code: RefusalKind::InternalError.literal(),
+        detail: ErrorDetail::Empty(EmptyDetail {}),
+    };
+    let detail = match refusal.kind() {
+        RefusalKind::InvalidInput | RefusalKind::IdempotencyConflict => {
+            let Some(field) = refusal.field() else {
+                return internal();
+            };
+            ErrorDetail::Field(FieldDetail { field })
+        }
+        RefusalKind::NotFound
+        | RefusalKind::DockNotFound
+        | RefusalKind::CarrierNotFound
+        | RefusalKind::SlotUnavailable
+        | RefusalKind::AppointmentNotScheduled => {
+            let (Some(field), Some(id)) = (refusal.field(), refusal.id()) else {
+                return internal();
+            };
+            ErrorDetail::FieldId(FieldIdDetail {
+                field,
+                id: id.into(),
+            })
+        }
+        RefusalKind::CarrierCodeConflict | RefusalKind::DockCodeConflict => {
+            let Some(constraint) = refusal.constraint() else {
+                return internal();
+            };
+            ErrorDetail::Constraint(ConstraintDetail {
+                constraint: constraint.into(),
+            })
+        }
+        RefusalKind::PermissionDenied => ErrorDetail::Permission(PermissionDetail { operation }),
+        RefusalKind::Retry | RefusalKind::Timeout | RefusalKind::InternalError => {
+            ErrorDetail::Empty(EmptyDetail {})
+        }
+    };
+    OperationError {
+        code: refusal.kind().literal(),
+        detail,
+    }
+}
+
+/// Replace one item with its refusal.
+pub(crate) fn refused<T>(
+    request_id: Box<str>,
+    refusal: &Refusal,
+    operation: &'static str,
+) -> ItemResult<T> {
+    ItemResult::Refused {
+        request_id,
+        error: operation_error(refusal, operation),
+    }
+}
+
+/// Serialize one complete operation response.
+pub(crate) fn serialized<T: Serialize>(output: &[ItemResult<T>]) -> String {
+    serde_json::to_string(output).expect("closed operation results always serialize")
+}
+
+#[cfg(test)]
+mod tests {
+    use serde_json::json;
+
+    use super::{ItemResult, operation_error, prepare_envelope, serialized};
+    use crate::error::{Refusal, RefusalKind};
+
+    #[test]
+    fn the_envelope_admits_only_identified_bounded_items() {
+        let items = prepare_envelope(r#"[{"request_id":"r1","dock_code":"D1"}]"#)
+            .expect("one identified item is admitted");
+        assert_eq!(items.len(), 1);
+        assert_eq!(items[0].request_id.as_ref(), "r1");
+        assert_eq!(items[0].body, json!({"dock_code": "D1"}));
+
+        assert!(prepare_envelope("[]").is_err());
+        assert!(prepare_envelope(r#"{"request_id":"r1"}"#).is_err());
+        assert!(prepare_envelope(r#"[{"request_id":""}]"#).is_err());
+        assert!(prepare_envelope(r#"[{"dock_code":"D1"}]"#).is_err());
+        assert!(prepare_envelope("not json").is_err());
+    }
+
+    #[test]
+    fn each_refusal_carries_the_detail_its_code_declares() {
+        let slot = Refusal::subject(
+            RefusalKind::SlotUnavailable,
+            "the slot overlaps an appointment",
+            "value.slot_start",
+            "1b4e28ba-2fa1-11d2-883f-0016d3cca427",
+        );
+        let rendered =
+            serde_json::to_value(operation_error(&slot, "appointment.book")).expect("serializes");
+        assert_eq!(
+            rendered,
+            json!({
+                "code": "slot_unavailable",
+                "detail": {
+                    "field": "value.slot_start",
+                    "id": "1b4e28ba-2fa1-11d2-883f-0016d3cca427",
+                },
+            })
+        );
+
+        let conflict =
+            Refusal::invalid("the key names a different request", "value.idempotency_key");
+        let rendered = serde_json::to_value(operation_error(&conflict, "appointment.book"))
+            .expect("serializes");
+        assert_eq!(
+            rendered["detail"],
+            json!({"field": "value.idempotency_key"})
+        );
+
+        let internal = Refusal::internal("the statement returned an unknown outcome");
+        let rendered = serde_json::to_value(operation_error(&internal, "appointment.book"))
+            .expect("serializes");
+        assert_eq!(rendered, json!({"code": "internal_error", "detail": {}}));
+    }
+
+    #[test]
+    fn a_response_pairs_every_item_with_its_request_id() {
+        let output = vec![
+            ItemResult::Succeeded {
+                request_id: "r1".into(),
+                value: json!({"dock_id": "d"}),
+            },
+            ItemResult::Refused {
+                request_id: "r2".into(),
+                error: operation_error(&Refusal::invalid("bad", "dock_code"), "dock.create"),
+            },
+        ];
+        assert_eq!(
+            serde_json::from_str::<serde_json::Value>(&serialized(&output)).expect("valid JSON"),
+            json!([
+                {"request_id": "r1", "value": {"dock_id": "d"}},
+                {
+                    "request_id": "r2",
+                    "error": {"code": "invalid_input", "detail": {"field": "dock_code"}},
+                },
+            ])
+        );
+    }
+}
