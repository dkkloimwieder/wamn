+/// Execute `appointment.query` against its verified projection.
+pub async fn appointment_query(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output: Vec<ItemResult<RowsValue<AppointmentValue>>> = Vec::with_capacity(items.len());
+    for item in items.into_vec() {
+        let result = async {
+            let parsed = parse_item::<QueryInput>(&item)?;
+            let dock_id = canonical_uuid(&parsed.dock_id).ok_or_else(|| {
+                Refusal::invalid("dock_id must be a canonical lowercase UUID", "dock_id")
+            })?;
+            let (day_start, day_end) = utc_day_bounds(&parsed.day).ok_or_else(|| {
+                Refusal::invalid("day must be a UTC calendar date spelled YYYY-MM-DD", "day")
+            })?;
+            let status = parsed.status.as_deref().map(status_filter).transpose()?;
+            let mut transaction = begin(&mut connection, "begin appointment query").await?;
+            let rows = query_sql::list_appointments(
+                &mut transaction,
+                WamnUuid(dock_id),
+                TimestampTz(day_start),
+                TimestampTz(day_end),
+                status,
+            )
+            .await
+            .map_err(|source| {
+                Refusal::from_statement("list appointments", &source, &NO_CONSTRAINTS)
+            })?;
+            commit(transaction, "commit appointment query").await?;
+            Ok::<_, Refusal>(RowsValue {
+                rows: rows
+                    .into_iter()
+                    .map(list_value)
+                    .collect::<Result<Vec<_>, _>>()?
+                    .into_boxed_slice(),
+            })
+        }
+        .await;
+        output.push(match result {
+            Ok(value) => ItemResult::Succeeded {
+                request_id: item.request_id,
+                value,
+            },
+            Err(refusal) => refused(item.request_id, &refusal, "appointment.query"),
+        });
+    }
+    Ok(serialized(&output))
+}
+
+async fn begin(connection: &mut Connection, context: &'static str) -> Result<Transaction, Refusal> {
+    connection
+        .begin()
+        .await
+        .map_err(|source| Refusal::from_statement(context, &source, &NO_CONSTRAINTS))
+}
+
+async fn commit(transaction: Transaction, context: &'static str) -> Result<(), Refusal> {
+    transaction
+        .commit()
+        .await
+        .map_err(|source| Refusal::from_statement(context, &source, &NO_CONSTRAINTS))
+}
+
+fn require_nonempty(value: &str, field: &'static str) -> Result<(), Refusal> {
+    if value.is_empty() {
+        Err(Refusal::invalid("value must not be empty", field))
+    } else {
+        Ok(())
+    }
+}
+
+fn status_filter(value: &str) -> Result<String, Refusal> {
+    if APPOINTMENT_STATUS.contains(&value) {
+        Ok(value.to_owned())
+    } else {
+        Err(Refusal::invalid(
+            "status is outside the closed appointment vocabulary",
+            "status",
+        ))
+    }
+}
+
+/// Re-spell every named member, then hash what was re-spelled.
+fn prepare_booking(value: &BookValue) -> Result<PreparedBooking, Refusal> {
+    require_nonempty(&value.idempotency_key, "value.idempotency_key")?;
+    let dock_id = canonical_uuid(&value.dock_id).ok_or_else(|| {
+        Refusal::invalid(
+            "value.dock_id must be a canonical lowercase UUID",
+            "value.dock_id",
+        )
+    })?;
+    let carrier_id = canonical_uuid(&value.carrier_id).ok_or_else(|| {
+        Refusal::invalid(
+            "value.carrier_id must be a canonical lowercase UUID",
+            "value.carrier_id",
+        )
+    })?;
+    let slot_start = utc_timestamp(&value.slot_start).ok_or_else(|| {
+        Refusal::invalid(
+            "value.slot_start must be an RFC 3339 timestamp with an offset",
+            "value.slot_start",
+        )
+    })?;
+    let slot_end = utc_timestamp(&value.slot_end).ok_or_else(|| {
+        Refusal::invalid(
+            "value.slot_end must be an RFC 3339 timestamp with an offset",
+            "value.slot_end",
+        )
+    })?;
+    // Both spellings are fixed-width UTC, so text order is time order.
+    if slot_end <= slot_start {
+        return Err(Refusal::invalid(
+            "value.slot_end must be after value.slot_start",
+            "value.slot_end",
+        ));
+    }
+    let canonical_value = json!({
+        "carrier_id": carrier_id,
+        "dock_id": dock_id,
+        "slot_end": slot_end,
+        "slot_start": slot_start,
+    });
+    Ok(PreparedBooking {
+        idempotency_key: value.idempotency_key.to_string(),
+        dock_id,
+        carrier_id,
+        slot_start,
+        slot_end,
+        canonical_command: canonical_json_bytes(&canonical_value),
+    })
+}
+
+async fn book_in(
+    transaction: &mut Transaction,
+    command: &PreparedBooking,
+) -> Result<AppointmentValue, Refusal> {
+    if let Some(replay) = book_sql::find_replay(transaction, command.idempotency_key.clone())
+        .await
+        .map_err(|source| {
+            Refusal::from_statement("find appointment replay", &source, &NO_CONSTRAINTS)
+        })?
+    {
+        return replay_value(replay, command);
+    }
+
+    let claim = book_sql::claim_command(
+        transaction,
+        command.idempotency_key.clone(),
+        command.canonical_command.clone(),
+    )
+    .await
+    .map_err(|source| {
+        Refusal::from_statement(
+            "claim appointment idempotency key",
+            &source,
+            &NO_CONSTRAINTS,
+        )
+    })?;
+    let Some(claim) = claim else {
+        let replay = book_sql::find_replay(transaction, command.idempotency_key.clone())
+            .await
+            .map_err(|source| {
+                Refusal::from_statement(
+                    "load concurrent appointment replay",
+                    &source,
+                    &NO_CONSTRAINTS,
+                )
+            })?
+            .ok_or_else(|| Refusal::internal("conflicting command claim has no durable result"))?;
+        return replay_value(replay, command);
+    };
+
+    if book_sql::lock_dock(transaction, WamnUuid(command.dock_id.clone()))
+        .await
+        .map_err(|source| Refusal::from_statement("lock dock", &source, &NO_CONSTRAINTS))?
+        .is_none()
+    {
+        return Err(Refusal::subject(
+            RefusalKind::DockNotFound,
+            "dock does not exist",
+            "value.dock_id",
+            command.dock_id.clone(),
+        ));
+    }
+    if book_sql::find_carrier(transaction, WamnUuid(command.carrier_id.clone()))
+        .await
+        .map_err(|source| Refusal::from_statement("find carrier", &source, &NO_CONSTRAINTS))?
+        .is_none()
+    {
+        return Err(Refusal::subject(
+            RefusalKind::CarrierNotFound,
+            "carrier does not exist",
+            "value.carrier_id",
+            command.carrier_id.clone(),
+        ));
+    }
+
+    let row = book_sql::insert_appointment(
+        transaction,
+        claim.appointment_id,
+        WamnUuid(command.dock_id.clone()),
+        WamnUuid(command.carrier_id.clone()),
+        TimestampTz(command.slot_start.clone()),
+        TimestampTz(command.slot_end.clone()),
+    )
+    .await
+    .map_err(|source| Refusal::from_statement("insert appointment", &source, &NO_CONSTRAINTS))?;
+    booked_value(row)
+}
+
+fn replay_value(
+    replay: book_sql::FindReplayRow,
+    command: &PreparedBooking,
+) -> Result<AppointmentValue, Refusal> {
+    if replay.canonical_command != command.canonical_command {
+        return Err(Refusal::named(
+            RefusalKind::IdempotencyConflict,
+            "the idempotency key already names a different request",
+            "value.idempotency_key",
+        ));
+    }
+    appointment_value(
+        AppointmentColumns {
+            appointment_id: Some(replay.appointment_id),
+            dock_id: replay.dock_id,
+            carrier_id: replay.carrier_id,
+            slot_start: replay.slot_start,
+            slot_end: replay.slot_end,
+            status: replay.status,
+            arrived_at: replay.arrived_at,
+        },
+        "a claimed idempotency key has no appointment",
+    )
+}
+
+fn booked_value(row: book_sql::InsertAppointmentRow) -> Result<AppointmentValue, Refusal> {
+    match row.outcome.as_deref() {
+        Some("slot_unavailable") => {
+            let Some(conflicting) = row.conflicting_appointment_id else {
+                return Err(Refusal::internal(
+                    "the slot refusal omitted the conflicting appointment",
+                ));
+            };
+            Err(Refusal::subject(
+                RefusalKind::SlotUnavailable,
+                "the requested slot overlaps an appointment on this dock",
+                "value.slot_start",
+                conflicting.0,
+            ))
+        }
+        Some("booked") => appointment_value(
+            AppointmentColumns {
+                appointment_id: row.appointment_id,
+                dock_id: row.dock_id,
+                carrier_id: row.carrier_id,
+                slot_start: row.slot_start,
+                slot_end: row.slot_end,
+                status: row.status,
+                arrived_at: row.arrived_at,
+            },
+            "the booking returned an incomplete row",
+        ),
+        _ => Err(Refusal::internal(
+            "appointment.book returned a null or unknown outcome",
+        )),
+    }
+}
+
+fn check_in_value(
+    row: check_in_sql::CheckInAppointmentRow,
+    appointment_id: &str,
+) -> Result<AppointmentValue, Refusal> {
+    match row.outcome.as_deref() {
+        Some("not_found") => Err(Refusal::subject(
+            RefusalKind::NotFound,
+            "appointment does not exist",
+            "appointment_id",
+            appointment_id,
+        )),
+        Some("not_scheduled") => Err(Refusal::subject(
+            RefusalKind::AppointmentNotScheduled,
+            "appointment has already left the scheduled status",
+            "appointment_id",
+            appointment_id,
+        )),
+        Some("arrived") => appointment_value(
+            AppointmentColumns {
+                appointment_id: row.appointment_id,
+                dock_id: row.dock_id,
+                carrier_id: row.carrier_id,
+                slot_start: row.slot_start,
+                slot_end: row.slot_end,
+                status: row.status,
+                arrived_at: row.arrived_at,
+            },
+            "the check-in returned an incomplete row",
+        ),
+        _ => Err(Refusal::internal(
+            "appointment.check_in returned a null or unknown outcome",
+        )),
+    }
+}
+
+fn list_value(row: query_sql::ListAppointmentsRow) -> Result<AppointmentValue, Refusal> {
+    Ok(AppointmentValue {
+        appointment_id: row.appointment_id.0.into_boxed_str(),
+        dock_id: row.dock_id.0.into_boxed_str(),
+        carrier_id: row.carrier_id.0.into_boxed_str(),
+        slot_start: wire_timestamp(&row.slot_start)?,
+        slot_end: wire_timestamp(&row.slot_end)?,
+        status: row.status.into_boxed_str(),
+        arrived_at: row.arrived_at.as_ref().map(wire_timestamp).transpose()?,
+    })
+}
+
+fn appointment_value(
+    columns: AppointmentColumns,
+    context: &'static str,
+) -> Result<AppointmentValue, Refusal> {
+    let (
+        Some(appointment_id),
+        Some(dock_id),
+        Some(carrier_id),
+        Some(slot_start),
+        Some(slot_end),
+        Some(status),
+    ) = (
+        columns.appointment_id,
+        columns.dock_id,
+        columns.carrier_id,
+        columns.slot_start,
+        columns.slot_end,
+        columns.status,
+    )
+    else {
+        return Err(Refusal::internal(context));
+    };
+    Ok(AppointmentValue {
+        appointment_id: appointment_id.0.into_boxed_str(),
+        dock_id: dock_id.0.into_boxed_str(),
+        carrier_id: carrier_id.0.into_boxed_str(),
+        slot_start: wire_timestamp(&slot_start)?,
+        slot_end: wire_timestamp(&slot_end)?,
+        status: status.into_boxed_str(),
+        arrived_at: columns
+            .arrived_at
+            .as_ref()
+            .map(wire_timestamp)
+            .transpose()?,
+    })
+}
+
+fn wire_timestamp(value: &TimestampTz) -> Result<Box<str>, Refusal> {
+    utc_timestamp(&value.0)
+        .map(String::into_boxed_str)
+        .ok_or_else(|| Refusal::internal("a stored timestamp is not RFC 3339"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{BookValue, prepare_booking, status_filter};
+    use crate::error::RefusalKind;
+
+    fn booking(idempotency_key: &str, slot_start: &str) -> BookValue {
+        BookValue {
+            idempotency_key: idempotency_key.into(),
+            dock_id: "11111111-1111-1111-1111-111111111111".into(),
+            carrier_id: "22222222-2222-2222-2222-222222222222".into(),
+            slot_start: slot_start.into(),
+            slot_end: "2026-09-10T09:00:00.000000Z".into(),
+        }
+    }
+
+    #[test]
+    fn the_command_identity_ignores_the_idempotency_key() {
+        let first = prepare_booking(&booking("key-a", "2026-09-10T08:00:00.000000Z"))
+            .expect("a canonical booking is admitted");
+        let second = prepare_booking(&booking("key-b", "2026-09-10T08:00:00.000000Z"))
+            .expect("a canonical booking is admitted");
+        assert_eq!(first.canonical_command, second.canonical_command);
+        assert_eq!(
+            String::from_utf8(first.canonical_command).expect("canonical JSON is UTF-8"),
+            concat!(
+                r#"{"carrier_id":"22222222-2222-2222-2222-222222222222","#,
+                r#""dock_id":"11111111-1111-1111-1111-111111111111","#,
+                r#""slot_end":"2026-09-10T09:00:00.000000Z","#,
+                r#""slot_start":"2026-09-10T08:00:00.000000Z"}"#,
+            )
+        );
+    }
+
+    #[test]
+    fn one_instant_spelled_two_ways_is_one_command() {
+        let canonical = prepare_booking(&booking("key-a", "2026-09-10T08:00:00.000000Z"))
+            .expect("a canonical booking is admitted");
+        let respelled = prepare_booking(&booking("key-a", "2026-09-10T09:00:00+01:00"))
+            .expect("an offset booking is admitted");
+        assert_eq!(canonical.canonical_command, respelled.canonical_command);
+    }
+
+    #[test]
+    fn a_different_slot_is_a_different_command() {
+        let first = prepare_booking(&booking("key-a", "2026-09-10T08:00:00.000000Z"))
+            .expect("a canonical booking is admitted");
+        let moved = prepare_booking(&booking("key-a", "2026-09-10T08:30:00.000000Z"))
+            .expect("a canonical booking is admitted");
+        assert_ne!(first.canonical_command, moved.canonical_command);
+    }
+
+    #[test]
+    fn a_booking_refuses_noncanonical_and_empty_slots() {
+        let refusal = prepare_booking(&booking("key-a", "2026-09-10"))
+            .expect_err("a date without a time is refused");
+        assert_eq!(refusal.kind(), RefusalKind::InvalidInput);
+        assert_eq!(refusal.field(), Some("value.slot_start"));
+
+        let refusal = prepare_booking(&booking("", "2026-09-10T08:00:00.000000Z"))
+            .expect_err("an empty key is refused");
+        assert_eq!(refusal.field(), Some("value.idempotency_key"));
+
+        let refusal = prepare_booking(&booking("key-a", "2026-09-10T09:00:00.000000Z"))
+            .expect_err("an empty slot is refused");
+        assert_eq!(refusal.field(), Some("value.slot_end"));
+
+        let refusal = prepare_booking(&booking("key-a", "2026-09-10T10:00:00.000000Z"))
+            .expect_err("an inverted slot is refused");
+        assert_eq!(refusal.field(), Some("value.slot_end"));
+    }
+
+    #[test]
+    fn the_status_filter_is_a_closed_vocabulary() {
+        for status in ["scheduled", "arrived", "departed"] {
+            assert_eq!(
+                status_filter(status).expect("a declared status is admitted"),
+                status
+            );
+        }
+        let refusal = status_filter("cancelled").expect_err("an unknown status is refused");
+        assert_eq!(refusal.field(), Some("status"));
+    }
+}
