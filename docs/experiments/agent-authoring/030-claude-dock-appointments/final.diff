diff --git a/packages/dock/command/book_appointment/insert_appointment.sql b/packages/dock/command/book_appointment/insert_appointment.sql
new file mode 100644
index 00000000..86d808d8
--- /dev/null
+++ b/packages/dock/command/book_appointment/insert_appointment.sql
@@ -0,0 +1,37 @@
+WITH conflicting AS (
+    SELECT appointment.id
+    FROM appointment
+    WHERE appointment.dock_id = $2
+        AND appointment.slot_start < $5
+        AND appointment.slot_end > $4
+    ORDER BY appointment.slot_start, appointment.id
+    LIMIT 1
+),
+booked AS (
+    INSERT INTO appointment (
+        id,
+        dock_id,
+        carrier_id,
+        slot_start,
+        slot_end
+    )
+    SELECT $1, $2, $3, $4, $5
+    WHERE NOT EXISTS (SELECT 1 FROM conflicting)
+    RETURNING id, dock_id, carrier_id, slot_start, slot_end, status, arrived_at
+)
+SELECT
+    CASE
+        WHEN booked.id IS NULL THEN 'slot_unavailable'
+        ELSE 'booked'
+    END AS outcome,
+    booked.id AS appointment_id,
+    booked.dock_id,
+    booked.carrier_id,
+    booked.slot_start,
+    booked.slot_end,
+    booked.status,
+    booked.arrived_at,
+    conflicting.id AS conflicting_appointment_id
+FROM (SELECT 1) AS singleton
+LEFT JOIN booked ON TRUE
+LEFT JOIN conflicting ON TRUE;
