+++ b/components/application/dock/src/lib.rs
@@ -0,0 +1,97 @@
+#![expect(
+    clippy::same_length_and_capacity,
+    reason = "wit-bindgen emits Vec::from_raw_parts with equal length and capacity"
+)]
+
+//! One package-grain component exporting every dock appointment operation.
+
+use exports::dock::appointment::book::Guest as AppointmentBook;
+use exports::dock::appointment::check_in::Guest as AppointmentCheckIn;
+use exports::dock::appointment::query::Guest as AppointmentQuery;
+use exports::dock::carrier::create::Guest as CarrierCreate;
+use exports::dock::dock::create::Guest as DockCreate;
+use wamn::node::types::{Emission, ErrorDetail, NodeContext, NodeError};
+
+use crate::wire::InvocationError;
+
+mod canonical;
+mod error;
+mod generated;
+mod operation;
+mod wire;
+
+wit_bindgen::generate!({
+    world: "dock:component/dock@1.0.0",
+    inline: r#"
+        package dock:component@1.0.0;
+
+        world dock {
+          import wamn:postgres/types@0.1.0;
+          import wamn:postgres/statements@0.1.0;
+          export dock:carrier/create@1.0.0;
+          export dock:dock/create@1.0.0;
+          export dock:appointment/book@1.0.0;
+          export dock:appointment/check-in@1.0.0;
+          export dock:appointment/query@1.0.0;
+        }
+    "#,
+    path: [
+        "../../data/receiving-data/wit/deps/wamn-node",
+        "../../data/receiving-data/wit/deps/wamn-postgres",
+        "wit/deps/dock-appointment",
+        "wit/deps/dock-carrier",
+        "wit/deps/dock-dock",
+    ],
+    generate_all,
+});
+
+struct Component;
+
+fn invoke<F>(operation: F) -> Result<Emission, NodeError>
+where
+    F: Future<Output = Result<String, InvocationError>>,
+{
+    futures_executor::block_on(operation)
+        .map(|payload| Emission {
+            payload,
+            port: None,
+        })
+        .map_err(|error| {
+            NodeError::InvalidInput(ErrorDetail {
+                message: error.context().to_owned(),
+                code: Some(error.code().to_owned()),
+            })
+        })
+}
+
+impl CarrierCreate for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(operation::carrier_create(&input))
+    }
+}
+
+impl DockCreate for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(operation::dock_create(&input))
+    }
+}
+
+impl AppointmentBook for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(operation::appointment_book(&input))
+    }
+}
+
+impl AppointmentCheckIn for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(operation::appointment_check_in(&input))
+    }
+}
+
+impl AppointmentQuery for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(operation::appointment_query(&input))
+    }
+}
+
+export!(Component);
diff --git a/components/application/dock/src/operation.rs b/components/application/dock/src/operation.rs
new file mode 100644
index 00000000..927ffa18
--- /dev/null
+++ b/components/application/dock/src/operation.rs
@@ -0,0 +1,707 @@
+//! The five dock operations, each backed only by generated static SQL.
+
+use serde::{Deserialize, Serialize};
+use serde_json::json;
+use wamn_execution_contract::canonical_json_bytes;
+use wamn_postgres_statements::{Connection, TimestampTz, Transaction, Uuid as WamnUuid};
+
+use crate::canonical::{canonical_uuid, utc_day_bounds, utc_timestamp};
+use crate::error::{Refusal, RefusalKind};
+use crate::generated::{
+    appointment_book as book_sql, appointment_check_in as check_in_sql,
+    appointment_query as query_sql, carrier_create as carrier_sql, dock_create as dock_sql,
+};
+use crate::wire::{
+    InvocationError, ItemResult, RowsValue, parse_item, prepare_envelope, refused, serialized,
+};
+
+const APPOINTMENT_STATUS: [&str; 3] = ["scheduled", "arrived", "departed"];
+const CARRIER_CONSTRAINTS: [(&str, RefusalKind); 1] =
+    [("carrier_carrier_code_key", RefusalKind::CarrierCodeConflict)];
+const DOCK_CONSTRAINTS: [(&str, RefusalKind); 1] =
+    [("dock_dock_code_key", RefusalKind::DockCodeConflict)];
+const NO_CONSTRAINTS: [(&str, RefusalKind); 0] = [];
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CreateCarrierInput {
+    carrier_code: Box<str>,
+    carrier_name: Box<str>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CreateDockInput {
+    dock_code: Box<str>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct BookInput {
+    value: BookValue,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct BookValue {
+    idempotency_key: Box<str>,
+    dock_id: Box<str>,
+    carrier_id: Box<str>,
+    slot_start: Box<str>,
+    slot_end: Box<str>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CheckInInput {
+    appointment_id: Box<str>,
+    arrived_at: Box<str>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct QueryInput {
+    dock_id: Box<str>,
+    day: Box<str>,
+    #[serde(default)]
+    status: Option<Box<str>>,
+}
+
+#[derive(Debug, Serialize)]
+#[expect(
+    clippy::struct_field_names,
+    reason = "these are the wire member names the generated carrier.create result contract fixes"
+)]
+struct CarrierValue {
+    carrier_id: Box<str>,
+    carrier_code: Box<str>,
+    carrier_name: Box<str>,
+}
+
+#[derive(Debug, Serialize)]
+struct DockValue {
+    dock_id: Box<str>,
+    dock_code: Box<str>,
+}
+
+#[derive(Debug, Serialize)]
+struct AppointmentValue {
+    appointment_id: Box<str>,
+    dock_id: Box<str>,
+    carrier_id: Box<str>,
+    slot_start: Box<str>,
+    slot_end: Box<str>,
+    status: Box<str>,
+    arrived_at: Option<Box<str>>,
+}
+
+/// The appointment columns every statement returns, before completeness.
+#[derive(Debug)]
+struct AppointmentColumns {
+    appointment_id: Option<WamnUuid>,
+    dock_id: Option<WamnUuid>,
+    carrier_id: Option<WamnUuid>,
+    slot_start: Option<TimestampTz>,
+    slot_end: Option<TimestampTz>,
+    status: Option<String>,
+    arrived_at: Option<TimestampTz>,
+}
+
+/// One booking after every member the manifest names is re-spelled.
+#[derive(Debug)]
+struct PreparedBooking {
+    idempotency_key: String,
+    dock_id: String,
+    carrier_id: String,
+    slot_start: String,
+    slot_end: String,
+    canonical_command: Vec<u8>,
+}
+
+/// Execute `carrier.create` as one transaction per input item.
+pub async fn carrier_create(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output: Vec<ItemResult<CarrierValue>> = Vec::with_capacity(items.len());
+    for item in items.into_vec() {
+        let result = async {
+            let parsed = parse_item::<CreateCarrierInput>(&item)?;
+            require_nonempty(&parsed.carrier_code, "carrier_code")?;
+            require_nonempty(&parsed.carrier_name, "carrier_name")?;
+            let mut transaction = begin(&mut connection, "begin carrier creation").await?;
+            let row = carrier_sql::insert_carrier(
+                &mut transaction,
+                parsed.carrier_code.to_string(),
+                parsed.carrier_name.to_string(),
+            )
+            .await
+            .map_err(|source| {
+                Refusal::from_statement("insert carrier", &source, &CARRIER_CONSTRAINTS)
+            })?;
+            commit(transaction, "commit carrier creation").await?;
+            Ok::<_, Refusal>(CarrierValue {
+                carrier_id: row.id.0.into_boxed_str(),
+                carrier_code: row.carrier_code.into_boxed_str(),
+                carrier_name: row.carrier_name.into_boxed_str(),
+            })
+        }
+        .await;
+        output.push(match result {
+            Ok(value) => ItemResult::Succeeded {
+                request_id: item.request_id,
+                value,
+            },
+            Err(refusal) => refused(item.request_id, &refusal, "carrier.create"),
+        });
+    }
+    Ok(serialized(&output))
+}
+
+/// Execute `dock.create` as one transaction per input item.
+pub async fn dock_create(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output: Vec<ItemResult<DockValue>> = Vec::with_capacity(items.len());
+    for item in items.into_vec() {
+        let result = async {
+            let parsed = parse_item::<CreateDockInput>(&item)?;
+            require_nonempty(&parsed.dock_code, "dock_code")?;
+            let mut transaction = begin(&mut connection, "begin dock creation").await?;
+            let row = dock_sql::insert_dock(&mut transaction, parsed.dock_code.to_string())
+                .await
+                .map_err(|source| {
+                    Refusal::from_statement("insert dock", &source, &DOCK_CONSTRAINTS)
+                })?;
+            commit(transaction, "commit dock creation").await?;
+            Ok::<_, Refusal>(DockValue {
+                dock_id: row.id.0.into_boxed_str(),
+                dock_code: row.dock_code.into_boxed_str(),
+            })
+        }
+        .await;
+        output.push(match result {
+            Ok(value) => ItemResult::Succeeded {
+                request_id: item.request_id,
+                value,
+            },
+            Err(refusal) => refused(item.request_id, &refusal, "dock.create"),
+        });
+    }
+    Ok(serialized(&output))
+}
+
+/// Execute `appointment.book` as one transaction per input item.
+///
+/// A refusal drops the transaction, so the idempotency claim it took is rolled
+/// back with it: a key names a booking only once one exists.
+pub async fn appointment_book(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output: Vec<ItemResult<AppointmentValue>> = Vec::with_capacity(items.len());
+    for item in items.into_vec() {
+        let result = async {
+            let parsed = parse_item::<BookInput>(&item)?;
+            let command = prepare_booking(&parsed.value)?;
+            let mut transaction = begin(&mut connection, "begin appointment booking").await?;
+            let value = book_in(&mut transaction, &command).await?;
+            commit(transaction, "commit appointment booking").await?;
+            Ok::<_, Refusal>(value)
+        }
+        .await;
+        output.push(match result {
+            Ok(value) => ItemResult::Succeeded {
+                request_id: item.request_id,
+                value,
+            },
+            Err(refusal) => refused(item.request_id, &refusal, "appointment.book"),
+        });
+    }
+    Ok(serialized(&output))
+}
+
+/// Execute `appointment.check_in` as one transaction per input item.
+pub async fn appointment_check_in(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output: Vec<ItemResult<AppointmentValue>> = Vec::with_capacity(items.len());
+    for item in items.into_vec() {
+        let result = async {
+            let parsed = parse_item::<CheckInInput>(&item)?;
+            let appointment_id = canonical_uuid(&parsed.appointment_id).ok_or_else(|| {
+                Refusal::invalid(
+                    "appointment_id must be a canonical lowercase UUID",
+                    "appointment_id",
+                )
+            })?;
+            let arrived_at = utc_timestamp(&parsed.arrived_at).ok_or_else(|| {
+                Refusal::invalid(
+                    "arrived_at must be an RFC 3339 timestamp with an offset",
+                    "arrived_at",
+                )
+            })?;
+            let mut transaction = begin(&mut connection, "begin appointment check-in").await?;
+            let row = check_in_sql::check_in_appointment(
+                &mut transaction,
+                WamnUuid(appointment_id.clone()),
+                TimestampTz(arrived_at),
+            )
+            .await
+            .map_err(|source| {
+                Refusal::from_statement("check in appointment", &source, &NO_CONSTRAINTS)
+            })?;
+            let value = check_in_value(row, &appointment_id)?;
+            commit(transaction, "commit appointment check-in").await?;
+            Ok::<_, Refusal>(value)
+        }
+        .await;
+        output.push(match result {
+            Ok(value) => ItemResult::Succeeded {
+                request_id: item.request_id,
+                value,
+            },
+            Err(refusal) => refused(item.request_id, &refusal, "appointment.check_in"),
+        });
+    }
+    Ok(serialized(&output))
+}
