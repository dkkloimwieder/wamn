diff --git a/packages/dock/command/check_in_appointment/check_in_appointment.sql b/packages/dock/command/check_in_appointment/check_in_appointment.sql
new file mode 100644
index 00000000..5f18e043
--- /dev/null
+++ b/packages/dock/command/check_in_appointment/check_in_appointment.sql
@@ -0,0 +1,29 @@
+WITH target AS (
+    SELECT appointment.id
+    FROM appointment
+    WHERE appointment.id = $1
+),
+arrived AS (
+    UPDATE appointment
+    SET
+        status = 'arrived',
+        arrived_at = $2
+    WHERE appointment.id = $1
+        AND appointment.status = 'scheduled'
+    RETURNING id, dock_id, carrier_id, slot_start, slot_end, status, arrived_at
+)
+SELECT
+    CASE
+        WHEN NOT EXISTS (SELECT 1 FROM target) THEN 'not_found'
+        WHEN arrived.id IS NULL THEN 'not_scheduled'
+        ELSE 'arrived'
+    END AS outcome,
+    arrived.id AS appointment_id,
+    arrived.dock_id,
+    arrived.carrier_id,
+    arrived.slot_start,
+    arrived.slot_end,
+    arrived.status,
+    arrived.arrived_at
+FROM (SELECT 1) AS singleton
+LEFT JOIN arrived ON TRUE;
