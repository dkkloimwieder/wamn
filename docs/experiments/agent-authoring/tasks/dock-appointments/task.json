{
  "task": "dock-appointments",
  "identity": {
    "org": "acme",
    "project": "receiving",
    "env": "dev",
    "schema": "acme_receiving_dev",
    "tenant": "receiving-route-auth",
    "route_host": "receiving.localhost"
  },
  "package_sources": ["packages/receiving"],
  "overlay_root": "packages/dock",
  "allowed_paths": [
    "packages/dock/**",
    "components/application/dock/**",
    "components/Cargo.toml",
    "components/Cargo.lock"
  ],
  "grade": {
    "steps": "steps.json",
    "checks": ["claim-replay", "row_version", "naming"],
    "fence_reports": ["capability-surface", "additive-migration", "no-environment-data"]
  }
}
