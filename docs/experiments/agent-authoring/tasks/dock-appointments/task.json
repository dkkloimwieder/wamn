{
  "task": "dock-appointments",
  "identity": {
    "org": "acme",
    "project": "receiving",
    "env": "dev",
    "schema": "receiving",
    "tenant": "receiving-route-auth",
    "route_host": "receiving.localhost"
  },
  "package_sources": [
    "apps/wamn_receiving"
  ],
  "overlay_root": "apps/wamn_dock",
  "allowed_paths": [
    "apps/wamn_dock/**",
    "apps/Cargo.toml",
    "apps/Cargo.lock"
  ],
  "grade": {
    "steps": "steps.json",
    "checks": [
      "claim-replay",
      "row_version",
      "naming"
    ],
    "fence_reports": [
      "capability-surface",
      "additive-migration",
      "no-environment-data"
    ]
  },
  "package_id": "wamn_dock",
  "environment": {
    "event_stream_replicas": 1,
    "event_dup_window_secs": 120
  }
}
