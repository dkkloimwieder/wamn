+#![expect(
+    clippy::same_length_and_capacity,
+    reason = "wit-bindgen emits Vec::from_raw_parts with equal length and capacity"
+)]
+
+//! One package-grain component for the executable dock appointment operations.
+
+mod error;
+mod generated;
+pub mod operation;
+
+use exports::wamn_dock::appointment::book::Guest as AppointmentBook;
+use exports::wamn_dock::appointment::check_in::Guest as AppointmentCheckIn;
+use exports::wamn_dock::appointment::query::Guest as AppointmentQuery;
+use exports::wamn_dock::carrier::create::Guest as CarrierCreate;
+use exports::wamn_dock::dock::create::Guest as DockCreate;
+use wamn::node::types::{Emission, ErrorDetail, NodeContext, NodeError};
+
+use crate::operation::InvocationError;
+
+wit_bindgen::generate!({
+    world: "wamn-dock:component/dock@1.0.0",
+    inline: r#"
+        package wamn-dock:component@1.0.0;
+
+        world dock {
+          import wamn:postgres/types@0.1.0;
+          import wamn:postgres/statements@0.1.0;
+          export wamn-dock:carrier/create@1.0.0;
+          export wamn-dock:dock/create@1.0.0;
+          export wamn-dock:appointment/book@1.0.0;
+          export wamn-dock:appointment/check-in@1.0.0;
+          export wamn-dock:appointment/query@1.0.0;
+        }
+    "#,
+    path: [
+        "../../data/receiving-data/wit/deps/wamn-node",
+        "../../data/receiving-data/wit/deps/wamn-postgres",
+        "wit/deps/wamn-dock-appointment",
+        "wit/deps/wamn-dock-carrier",
+        "wit/deps/wamn-dock-dock",
+    ],
+    generate_all,
+});
+
+struct Component;
+
+fn invoke<F>(operation: F) -> Result<Emission, NodeError>
+where
+    F: Future<Output = Result<String, InvocationError>>,
+{
+    futures_executor::block_on(operation)
+        .map(|payload| Emission {
+            payload,
+            port: None,
+        })
+        .map_err(|error| {
+            NodeError::InvalidInput(ErrorDetail {
+                message: error.context().to_owned(),
+                code: Some(error.code().to_owned()),
+            })
+        })
+}
+
+impl CarrierCreate for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(crate::operation::carrier_create(&input))
+    }
+}
+
+impl DockCreate for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(crate::operation::dock_create(&input))
+    }
+}
+
+impl AppointmentBook for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(crate::operation::appointment_book(&input))
+    }
+}
+
+impl AppointmentCheckIn for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(crate::operation::appointment_check_in(&input))
+    }
+}
+
+impl AppointmentQuery for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(crate::operation::appointment_query(&input))
+    }
+}
+
+export!(Component);
diff --git a/components/application/dock/src/operation.rs b/components/application/dock/src/operation.rs
new file mode 100644
index 00000000..437eee12
--- /dev/null
+++ b/components/application/dock/src/operation.rs
@@ -0,0 +1,775 @@
+//! Wire adapters for the dock appointment operations over generated SQL.
+
+use std::pin::Pin;
+
+use chrono::{DateTime, NaiveDate, SecondsFormat, TimeDelta, Utc};
+use serde::de::DeserializeOwned;
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use wamn_execution_contract::canonical_json_bytes;
+use wamn_postgres_statements::{
+    Connection, StatementError, TimestampTz, Transaction, Uuid as WamnUuid, run_transaction,
+};
+
+use crate::error::{Failure, FailureKind};
+use crate::generated::{
+    appointment_book as book_sql, appointment_check_in as check_in_sql,
+    appointment_query as query_sql, carrier_create as carrier_sql, dock_create as dock_sql,
+};
+
+/// Largest array envelope one invocation accepts.
+const MAX_ENVELOPE_ITEMS: usize = 100;
+/// Closed appointment status vocabulary.
+const STATUS_VALUES: [&str; 3] = ["scheduled", "arrived", "departed"];
+
+impl From<StatementError> for Failure {
+    fn from(source: StatementError) -> Self {
+        Self::from_statement("run the operation transaction", source)
+    }
+}
+
+/// Envelope refusal translated to the frozen node invalid-input arm.
+#[derive(Debug)]
+pub struct InvocationError {
+    context: &'static str,
+}
+
+impl InvocationError {
+    /// Frozen WIT error-detail code.
+    pub const fn code(&self) -> &'static str {
+        "invalid_input"
+    }
+
+    /// Stable, non-database refusal description.
+    pub const fn context(&self) -> &'static str {
+        self.context
+    }
+
+    const fn new(context: &'static str) -> Self {
+        Self { context }
+    }
+}
+
+#[derive(Clone, Debug)]
+struct EnvelopeItem {
+    request_id: Box<str>,
+    body: Value,
+}
+
+fn prepare_envelope(input: &str) -> Result<Vec<EnvelopeItem>, InvocationError> {
+    let value: Value = serde_json::from_str(input)
+        .map_err(|_| InvocationError::new("operation input must be a JSON array"))?;
+    let Value::Array(values) = value else {
+        return Err(InvocationError::new("operation input must be a JSON array"));
+    };
+    if !(1..=MAX_ENVELOPE_ITEMS).contains(&values.len()) {
+        return Err(InvocationError::new(
+            "operation input item count must be 1..=100",
+        ));
+    }
+    values
+        .into_iter()
+        .map(|value| {
+            let Value::Object(mut object) = value else {
+                return Err(InvocationError::new(
+                    "every operation item must be a JSON object",
+                ));
+            };
+            let request_id = match object.remove("request_id") {
+                Some(Value::String(request_id)) if !request_id.is_empty() => request_id,
+                _ => {
+                    return Err(InvocationError::new(
+                        "every operation item must carry a nonempty string request_id",
+                    ));
+                }
+            };
+            Ok(EnvelopeItem {
+                request_id: request_id.into_boxed_str(),
+                body: Value::Object(object),
+            })
+        })
+        .collect()
+}
+
+#[derive(Debug, Serialize)]
+#[serde(untagged)]
+enum ItemResult<T> {
+    Succeeded { request_id: Box<str>, value: T },
+    Refused { request_id: Box<str>, error: WireError },
+}
+
+#[derive(Debug, Serialize)]
+struct WireError {
+    code: &'static str,
+    detail: WireDetail,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(untagged)]
+enum WireDetail {
+    Field { field: &'static str },
+    FieldId { field: &'static str, id: String },
+    Operation { operation: &'static str },
+    Empty {},
+}
+
+fn wire_error(failure: &Failure, operation: &'static str) -> WireError {
+    let internal = WireError {
+        code: FailureKind::InternalError.literal(),
+        detail: WireDetail::Empty {},
+    };
+    let detail = match failure.kind() {
+        FailureKind::InvalidInput | FailureKind::IdempotencyConflict => {
+            match failure.field() {
+                Some(field) => WireDetail::Field { field },
+                None => return internal,
+            }
+        }
+        FailureKind::NotFound | FailureKind::SlotUnavailable | FailureKind::InvalidTransition => {
+            match (failure.field(), failure.id()) {
+                (Some(field), Some(id)) => WireDetail::FieldId {
+                    field,
+                    id: id.to_owned(),
+                },
+                _ => return internal,
+            }
+        }
+        FailureKind::PermissionDenied => WireDetail::Operation { operation },
+        FailureKind::Retry | FailureKind::Timeout | FailureKind::InternalError => {
+            WireDetail::Empty {}
+        }
+    };
+    WireError {
+        code: failure.kind().literal(),
+        detail,
+    }
+}
+
+fn item_result<T>(
+    request_id: Box<str>,
+    operation: &'static str,
+    outcome: Result<T, Failure>,
+) -> ItemResult<T> {
+    match outcome {
+        Ok(value) => ItemResult::Succeeded { request_id, value },
+        Err(failure) => ItemResult::Refused {
+            request_id,
+            error: wire_error(&failure, operation),
+        },
+    }
+}
+
+fn serialized<T: Serialize>(output: &[ItemResult<T>]) -> String {
+    serde_json::to_string(output).expect("closed operation results always serialize")
+}
+
+fn parse_item<T: DeserializeOwned>(item: &EnvelopeItem) -> Result<T, Failure> {
+    serde_json::from_value(item.body.clone())
+        .map_err(|_| Failure::invalid("operation item does not match its input contract", "input"))
+}
+
+fn parse_uuid(value: &str, field: &'static str) -> Result<WamnUuid, Failure> {
+    uuid::Uuid::parse_str(value)
+        .ok()
+        .filter(|parsed| parsed.hyphenated().to_string() == value)
+        .map(|parsed| WamnUuid(parsed.hyphenated().to_string()))
+        .ok_or_else(|| Failure::invalid("input is not a canonical UUID", field))
+}
+
+fn parse_instant(value: &str, field: &'static str) -> Result<DateTime<Utc>, Failure> {
+    DateTime::parse_from_rfc3339(value)
+        .map(|parsed| parsed.with_timezone(&Utc))
+        .map_err(|_| Failure::invalid("input is not an RFC 3339 timestamp", field))
+}
+
+fn parse_name(value: &str) -> Result<String, Failure> {
+    let name = value.trim();
+    if name.is_empty() {
+        Err(Failure::invalid("name must not be blank", "name"))
+    } else {
+        Ok(name.to_owned())
+    }
+}
+
+/// Frozen canonical-command spelling: RFC 3339 UTC, six fractional digits.
+fn canonical_instant(instant: DateTime<Utc>) -> String {
+    instant.to_rfc3339_opts(SecondsFormat::Micros, true)
+}
+
+/// Wire spelling: RFC 3339 UTC in the shortest exact sub-second form.
+fn wire_instant(instant: DateTime<Utc>) -> String {
+    instant.to_rfc3339_opts(SecondsFormat::AutoSi, true)
+}
+
+fn bind_instant(instant: DateTime<Utc>) -> TimestampTz {
+    TimestampTz(canonical_instant(instant))
+}
+
+/// Re-spell one host timestamp, which arrives with six fractional digits.
+fn wire_instant_text(value: &TimestampTz) -> Result<String, Failure> {
+    DateTime::parse_from_rfc3339(&value.0)
+        .map(|parsed| wire_instant(parsed.with_timezone(&Utc)))
+        .map_err(|_| Failure::internal("database returned a non-RFC-3339 timestamp"))
+}
+
+async fn in_transaction<T, F>(connection: &mut Connection, body: F) -> Result<T, Failure>
+where
+    F: for<'a> FnOnce(&'a mut Transaction) -> Pin<Box<dyn Future<Output = Result<T, Failure>> + 'a>>,
+{
+    run_transaction(connection, body).await
+}
+
+// ---------------------------------------------------------------------------
+// carrier.create and dock.create
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CreateNamedInput {
+    name: String,
+}
+
+#[derive(Debug, Serialize)]
+struct CarrierValue {
+    carrier_id: String,
+    name: String,
+}
+
+#[derive(Debug, Serialize)]
+struct DockValue {
+    dock_id: String,
+    name: String,
+}
+
+/// Execute `carrier.create`, one independent transaction per envelope item.
+pub async fn carrier_create(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output = Vec::with_capacity(items.len());
+    for item in items {
+        let outcome = match parse_item::<CreateNamedInput>(&item).and_then(|p| parse_name(&p.name))
+        {
+            Ok(name) => {
+                in_transaction(&mut connection, move |transaction| {
+                    Box::pin(async move {
+                        let row = carrier_sql::insert_carrier(transaction, name.clone())
+                            .await
+                            .map_err(|source| Failure::from_statement("insert carrier", source))?;
+                        Ok(CarrierValue {
+                            carrier_id: row.id.0,
+                            name,
+                        })
+                    })
+                })
+                .await
+            }
+            Err(failure) => Err(failure),
+        };
+        output.push(item_result(item.request_id, "carrier.create", outcome));
+    }
+    Ok(serialized(&output))
+}
+
+/// Execute `dock.create`, one independent transaction per envelope item.
+pub async fn dock_create(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output = Vec::with_capacity(items.len());
+    for item in items {
+        let outcome = match parse_item::<CreateNamedInput>(&item).and_then(|p| parse_name(&p.name))
+        {
+            Ok(name) => {
+                in_transaction(&mut connection, move |transaction| {
+                    Box::pin(async move {
+                        let row = dock_sql::insert_dock(transaction, name.clone())
+                            .await
+                            .map_err(|source| Failure::from_statement("insert dock", source))?;
+                        Ok(DockValue {
+                            dock_id: row.id.0,
+                            name,
+                        })
+                    })
+                })
+                .await
+            }
+            Err(failure) => Err(failure),
+        };
+        output.push(item_result(item.request_id, "dock.create", outcome));
+    }
+    Ok(serialized(&output))
+}
+
+// ---------------------------------------------------------------------------
+// appointment.book
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct BookInput {
+    idempotency_key: String,
+    carrier_id: String,
+    dock_id: String,
+    slot_start: String,
+    slot_end: String,
+}
+
+#[derive(Debug, Serialize)]
+struct BookingValue {
+    appointment_id: String,
+    status: String,
+}
+
+#[derive(Clone, Debug)]
+struct PreparedBooking {
+    idempotency_key: String,
+    carrier_id: WamnUuid,
+    dock_id: WamnUuid,
+    slot_start: DateTime<Utc>,
+    slot_end: DateTime<Utc>,
+    canonical_command: Vec<u8>,
+}
+
+/// Canonicalize, then hash: the claim keys the re-spelled command, never the
+/// caller's spelling.
+fn prepare_booking(command: &BookInput) -> Result<PreparedBooking, Failure> {
+    if command.idempotency_key.is_empty() {
+        return Err(Failure::invalid(
+            "idempotency_key must not be empty",
+            "idempotency_key",
+        ));
+    }
+    let carrier_id = parse_uuid(&command.carrier_id, "carrier_id")?;
+    let dock_id = parse_uuid(&command.dock_id, "dock_id")?;
+    let slot_start = parse_instant(&command.slot_start, "slot_start")?;
+    let slot_end = parse_instant(&command.slot_end, "slot_end")?;
+    if slot_start >= slot_end {
+        return Err(Failure::invalid(
+            "slot_start must be earlier than slot_end",
+            "slot_start",
+        ));
+    }
+    let canonical = json!({
+        "carrier_id": carrier_id.0,
+        "dock_id": dock_id.0,
+        "slot_start": canonical_instant(slot_start),
+        "slot_end": canonical_instant(slot_end),
+    });
+    Ok(PreparedBooking {
+        idempotency_key: command.idempotency_key.clone(),
+        carrier_id,
+        dock_id,
+        slot_start,
+        slot_end,
+        canonical_command: canonical_json_bytes(&canonical),
+    })
+}
+
+fn replay_value(
+    replay: book_sql::FindReplayRow,
+    canonical_command: &[u8],
+) -> Result<BookingValue, Failure> {
+    if replay.canonical_command == canonical_command {
+        Ok(BookingValue {
+            appointment_id: replay.appointment_id.0,
+            status: "scheduled".to_owned(),
+        })
+    } else {
+        Err(Failure::idempotency_conflict("idempotency_key"))
+    }
+}
+
+async fn book_in(
+    transaction: &mut Transaction,
+    command: PreparedBooking,
+) -> Result<BookingValue, Failure> {
+    if let Some(replay) =
+        book_sql::find_replay(transaction, command.idempotency_key.clone())
+            .await
+            .map_err(|source| Failure::from_statement("find booking replay", source))?
+    {
+        return replay_value(replay, &command.canonical_command);
+    }
+
+    let claim = book_sql::claim_command(
+        transaction,
+        command.idempotency_key.clone(),
+        command.canonical_command.clone(),
+    )
+    .await
+    .map_err(|source| Failure::from_statement("claim the idempotency key", source))?;
+    let Some(claim) = claim else {
+        let replay = book_sql::find_replay(transaction, command.idempotency_key.clone())
+            .await
+            .map_err(|source| Failure::from_statement("load concurrent replay", source))?
+            .ok_or_else(|| Failure::internal("a conflicting claim has no durable result"))?;
+        return replay_value(replay, &command.canonical_command);
+    };
+
+    book_sql::load_carrier(transaction, command.carrier_id.clone())
+        .await
+        .map_err(|source| Failure::from_statement("load carrier", source))?
+        .ok_or_else(|| {
+            Failure::not_found(
+                "carrier does not exist",
+                "carrier_id",
+                command.carrier_id.0.clone(),
+            )
+        })?;
+
+    // The dock row lock, taken BEFORE the overlap read, is what makes DOCK-1
+    // hold under contention: every booking on one dock serializes here, so no
+    // second booker can read a clear slot that a first booker is about to fill.
+    book_sql::lock_dock(transaction, command.dock_id.clone())
+        .await
+        .map_err(|source| Failure::from_statement("lock dock", source))?
+        .ok_or_else(|| {
+            Failure::not_found("dock does not exist", "dock_id", command.dock_id.0.clone())
+        })?;
+
+    let overlap = book_sql::find_overlap(
+        transaction,
+        command.dock_id.clone(),
+        bind_instant(command.slot_start),
+        bind_instant(command.slot_end),
+    )
+    .await
+    .map_err(|source| Failure::from_statement("find an overlapping appointment", source))?;
+    if let Some(overlap) = overlap {
+        return Err(Failure::slot_unavailable("dock_id", overlap.id.0));
+    }
+
+    let row = book_sql::insert_appointment(
+        transaction,
+        claim.appointment_id,
+        command.idempotency_key,
+        command.carrier_id,
+        command.dock_id,
+        bind_instant(command.slot_start),
+        bind_instant(command.slot_end),
+    )
+    .await
+    .map_err(|source| Failure::from_statement("insert appointment", source))?;
+    Ok(BookingValue {
+        appointment_id: row.id.0,
+        status: row.status,
+    })
+}
+
+/// Execute `appointment.book`, one independent transaction per envelope item.
+pub async fn appointment_book(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output = Vec::with_capacity(items.len());
+    for item in items {
+        let outcome = match parse_item::<BookInput>(&item).and_then(|p| prepare_booking(&p)) {
+            Ok(command) => {
+                in_transaction(&mut connection, move |transaction| {
+                    Box::pin(book_in(transaction, command))
+                })
+                .await
+            }
+            Err(failure) => Err(failure),
+        };
+        output.push(item_result(item.request_id, "appointment.book", outcome));
+    }
+    Ok(serialized(&output))
+}
+
+// ---------------------------------------------------------------------------
+// appointment.check_in
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CheckInInput {
+    appointment_id: String,
+    arrived_at: String,
+}
+
+#[derive(Debug, Serialize)]
+struct CheckInValue {
+    appointment_id: String,
+    status: String,
+    arrived_at: String,
+    row_version: String,
+}
+
+async fn check_in_in(
+    transaction: &mut Transaction,
+    appointment_id: WamnUuid,
+    arrived_at: DateTime<Utc>,
+) -> Result<CheckInValue, Failure> {
+    let current = check_in_sql::lock_appointment(transaction, appointment_id.clone())
+        .await
+        .map_err(|source| Failure::from_statement("lock appointment", source))?
+        .ok_or_else(|| {
+            Failure::not_found(
+                "appointment does not exist",
+                "appointment_id",
+                appointment_id.0.clone(),
+            )
+        })?;
+    if current.status != "scheduled" {
+        return Err(Failure::invalid_transition(
+            format!("appointment status is already {}", current.status),
+            "appointment_id",
+            appointment_id.0,
+        ));
+    }
+    let row = check_in_sql::check_in_appointment(transaction, appointment_id, bind_instant(arrived_at))
+        .await
+        .map_err(|source| Failure::from_statement("check the appointment in", source))?;
+    Ok(CheckInValue {
+        appointment_id: row.id.0,
+        status: row.status,
+        arrived_at: wire_instant_text(&row.arrived_at)?,
+        row_version: row.row_version.to_string(),
+    })
+}
+
+/// Execute `appointment.check_in`, one independent transaction per item.
+pub async fn appointment_check_in(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output = Vec::with_capacity(items.len());
+    for item in items {
+        let parsed = parse_item::<CheckInInput>(&item).and_then(|parsed| {
+            let appointment_id = parse_uuid(&parsed.appointment_id, "appointment_id")?;
+            let arrived_at = parse_instant(&parsed.arrived_at, "arrived_at")?;
+            Ok((appointment_id, arrived_at))
+        });
+        let outcome = match parsed {
+            Ok((appointment_id, arrived_at)) => {
+                in_transaction(&mut connection, move |transaction| {
+                    Box::pin(check_in_in(transaction, appointment_id, arrived_at))
+                })
+                .await
+            }
+            Err(failure) => Err(failure),
+        };
+        output.push(item_result(item.request_id, "appointment.check_in", outcome));
+    }
+    Ok(serialized(&output))
+}
+
+// ---------------------------------------------------------------------------
+// appointment.query
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct QueryInput {
+    dock_id: String,
+    day: String,
+    status: String,
+}
+
+#[derive(Debug, Serialize)]
+struct QueryValue {
+    dock_id: String,
+    day: String,
+    status: String,
+    appointments: Vec<AppointmentValue>,
+}
+
+#[derive(Debug, Serialize)]
+struct AppointmentValue {
+    appointment_id: String,
+    carrier_id: String,
+    dock_id: String,
+    slot_start: String,
+    slot_end: String,
+    status: String,
+    arrived_at: Option<String>,
+}
+
+#[derive(Clone, Debug)]
+struct PreparedQuery {
+    dock_id: WamnUuid,
+    day: String,
+    status: String,
+    day_start: DateTime<Utc>,
+    day_end: DateTime<Utc>,
+}
+
+/// A day is one UTC calendar day: `[day 00:00Z, next day 00:00Z)`.
+fn prepare_query(request: &QueryInput) -> Result<PreparedQuery, Failure> {
+    let dock_id = parse_uuid(&request.dock_id, "dock_id")?;
+    let day = NaiveDate::parse_from_str(&request.day, "%Y-%m-%d")
+        .map_err(|_| Failure::invalid("day must be a YYYY-MM-DD calendar day", "day"))?;
+    if !STATUS_VALUES.contains(&request.status.as_str()) {
+        return Err(Failure::invalid(
+            "status is outside the closed vocabulary",
+            "status",
+        ));
+    }
+    let day_start = day
+        .and_hms_opt(0, 0, 0)
+        .ok_or_else(|| Failure::invalid("day has no midnight", "day"))?
+        .and_utc();
+    let day_end = day_start
+        .checked_add_signed(TimeDelta::days(1))
+        .ok_or_else(|| Failure::invalid("day is outside the representable range", "day"))?;
+    Ok(PreparedQuery {
+        dock_id,
+        day: request.day.clone(),
+        status: request.status.clone(),
+        day_start,
+        day_end,
+    })
+}
+
+async fn query_in(
+    transaction: &mut Transaction,
+    request: PreparedQuery,
+) -> Result<QueryValue, Failure> {
+    let rows = query_sql::appointment_by_dock_day(
+        transaction,
+        request.dock_id.clone(),
+        bind_instant(request.day_start),
+        bind_instant(request.day_end),
+        request.status.clone(),
+    )
+    .await
+    .map_err(|source| Failure::from_statement("list dock appointments", source))?;
+    let appointments = rows
+        .into_iter()
+        .map(|row| {
+            Ok(AppointmentValue {
+                appointment_id: row.id.0,
+                carrier_id: row.carrier_id.0,
+                dock_id: row.dock_id.0,
+                slot_start: wire_instant_text(&row.slot_start)?,
+                slot_end: wire_instant_text(&row.slot_end)?,
+                status: row.status,
+                arrived_at: row
+                    .arrived_at
+                    .as_ref()
+                    .map(wire_instant_text)
+                    .transpose()?,
+            })
+        })
+        .collect::<Result<Vec<_>, Failure>>()?;
+    Ok(QueryValue {
+        dock_id: request.dock_id.0,
+        day: request.day,
+        status: request.status,
+        appointments,
+    })
+}
+
+/// Execute `appointment.query`, one read transaction per envelope item.
+pub async fn appointment_query(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output = Vec::with_capacity(items.len());
+    for item in items {
+        let outcome = match parse_item::<QueryInput>(&item).and_then(|p| prepare_query(&p)) {
+            Ok(request) => {
+                in_transaction(&mut connection, move |transaction| {
+                    Box::pin(query_in(transaction, request))
+                })
+                .await
+            }
+            Err(failure) => Err(failure),
+        };
+        output.push(item_result(item.request_id, "appointment.query", outcome));
+    }
+    Ok(serialized(&output))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{
+        BookInput, QueryInput, canonical_instant, parse_instant, prepare_booking, prepare_query,
+        wire_instant,
+    };
+    use crate::error::FailureKind;
+
+    fn booking(key: &str, start: &str, end: &str) -> BookInput {
+        BookInput {
+            idempotency_key: key.to_owned(),
+            carrier_id: "11111111-1111-4111-8111-111111111111".to_owned(),
+            dock_id: "22222222-2222-4222-8222-222222222222".to_owned(),
+            slot_start: start.to_owned(),
+            slot_end: end.to_owned(),
+        }
+    }
+
+    #[test]
+    fn the_same_instant_spelled_two_ways_canonicalizes_to_one_command() {
+        let first = prepare_booking(&booking(
+            "k",
+            "2026-10-01T09:00:00Z",
+            "2026-10-01T10:00:00Z",
+        ))
+        .expect("the booking is valid");
+        let second = prepare_booking(&booking(
+            "k",
+            "2026-10-01T11:00:00+02:00",
+            "2026-10-01T10:00:00.000Z",
+        ))
+        .expect("the booking is valid");
+        assert_eq!(first.canonical_command, second.canonical_command);
+    }
+
+    #[test]
+    fn a_different_slot_under_one_key_is_a_different_command() {
+        let first = prepare_booking(&booking(
+            "k",
+            "2026-10-01T09:00:00Z",
+            "2026-10-01T10:00:00Z",
+        ))
+        .expect("the booking is valid");
+        let changed = prepare_booking(&booking(
+            "k",
+            "2026-10-01T14:00:00Z",
+            "2026-10-01T15:00:00Z",
+        ))
+        .expect("the booking is valid");
+        assert_ne!(first.canonical_command, changed.canonical_command);
+    }
+
+    #[test]
+    fn an_inverted_slot_refuses_before_any_statement_runs() {
+        let failure = prepare_booking(&booking(
+            "k",
+            "2026-10-01T10:00:00Z",
+            "2026-10-01T09:00:00Z",
+        ))
+        .expect_err("an inverted slot is refused");
+        assert_eq!(failure.kind(), FailureKind::InvalidInput);
+        assert_eq!(failure.field(), Some("slot_start"));
+    }
+
+    #[test]
+    fn a_whole_second_instant_reaches_the_wire_as_the_caller_spelled_it() {
+        let instant = parse_instant("2026-10-01T09:07:00Z", "arrived_at").expect("valid instant");
+        assert_eq!(wire_instant(instant), "2026-10-01T09:07:00Z");
+        assert_eq!(canonical_instant(instant), "2026-10-01T09:07:00.000000Z");
+    }
+
+    #[test]
+    fn a_day_is_one_utc_calendar_day() {
+        let request = prepare_query(&QueryInput {
+            dock_id: "22222222-2222-4222-8222-222222222222".to_owned(),
+            day: "2026-10-01".to_owned(),
+            status: "scheduled".to_owned(),
+        })
+        .expect("the request is valid");
+        assert_eq!(wire_instant(request.day_start), "2026-10-01T00:00:00Z");
+        assert_eq!(wire_instant(request.day_end), "2026-10-02T00:00:00Z");
+    }
+
+    #[test]
+    fn a_status_outside_the_vocabulary_refuses() {
+        let failure = prepare_query(&QueryInput {
+            dock_id: "22222222-2222-4222-8222-222222222222".to_owned(),
+            day: "2026-10-01".to_owned(),
+            status: "cancelled".to_owned(),
+        })
+        .expect_err("an unknown status is refused");
+        assert_eq!(failure.kind(), FailureKind::InvalidInput);
+        assert_eq!(failure.field(), Some("status"));
+    }
+}
