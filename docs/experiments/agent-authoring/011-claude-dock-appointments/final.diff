@@ -0,0 +1,156 @@
+//! One contextual refusal, translated to the wire exactly once by `operation`.
+
+use std::error::Error;
+use std::fmt;
+
+use wamn_postgres_statements::{StatementError, StatementErrorKind};
+
+/// Frozen manifest-owned refusal vocabulary of this package.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum FailureKind {
+    InvalidInput,
+    NotFound,
+    SlotUnavailable,
+    IdempotencyConflict,
+    InvalidTransition,
+    Retry,
+    Timeout,
+    PermissionDenied,
+    InternalError,
+}
+
+impl FailureKind {
+    /// Frozen wire literal declared by `wamn.json`.
+    pub(crate) const fn literal(self) -> &'static str {
+        match self {
+            Self::InvalidInput => "invalid_input",
+            Self::NotFound => "not_found",
+            Self::SlotUnavailable => "slot_unavailable",
+            Self::IdempotencyConflict => "idempotency_conflict",
+            Self::InvalidTransition => "invalid_transition",
+            Self::Retry => "retry",
+            Self::Timeout => "timeout",
+            Self::PermissionDenied => "permission_denied",
+            Self::InternalError => "internal_error",
+        }
+    }
+}
+
+/// Contextual failure carrying the structured detail its code declares.
+#[derive(Debug)]
+pub(crate) struct Failure {
+    kind: FailureKind,
+    context: String,
+    field: Option<&'static str>,
+    id: Option<String>,
+    source: Option<StatementError>,
+}
+
+impl Failure {
+    /// Stable class; callers must not match display text.
+    pub(crate) const fn kind(&self) -> FailureKind {
+        self.kind
+    }
+
+    /// Input path that owns the refusal, when the code declares one.
+    pub(crate) const fn field(&self) -> Option<&'static str> {
+        self.field
+    }
+
+    /// Offending identity, when the code declares one.
+    pub(crate) fn id(&self) -> Option<&str> {
+        self.id.as_deref()
+    }
+
+    pub(crate) fn invalid(context: impl Into<String>, field: &'static str) -> Self {
+        Self::new(FailureKind::InvalidInput, context, Some(field), None)
+    }
+
+    pub(crate) fn not_found(
+        context: impl Into<String>,
+        field: &'static str,
+        id: impl Into<String>,
+    ) -> Self {
+        Self::new(FailureKind::NotFound, context, Some(field), Some(id.into()))
+    }
+
+    pub(crate) fn slot_unavailable(field: &'static str, id: impl Into<String>) -> Self {
+        Self::new(
+            FailureKind::SlotUnavailable,
+            "the requested slot overlaps an appointment already on that dock",
+            Some(field),
+            Some(id.into()),
+        )
+    }
+
+    pub(crate) fn idempotency_conflict(field: &'static str) -> Self {
+        Self::new(
+            FailureKind::IdempotencyConflict,
+            "the idempotency key was used with a different request",
+            Some(field),
+            None,
+        )
+    }
+
+    pub(crate) fn invalid_transition(
+        context: impl Into<String>,
+        field: &'static str,
+        id: impl Into<String>,
+    ) -> Self {
+        Self::new(
+            FailureKind::InvalidTransition,
+            context,
+            Some(field),
+            Some(id.into()),
+        )
+    }
+
+    pub(crate) fn internal(context: impl Into<String>) -> Self {
+        Self::new(FailureKind::InternalError, context, None, None)
+    }
+
+    fn new(
+        kind: FailureKind,
+        context: impl Into<String>,
+        field: Option<&'static str>,
+        id: Option<String>,
+    ) -> Self {
+        Self {
+            kind,
+            context: context.into(),
+            field,
+            id,
+            source: None,
+        }
+    }
+
+    /// Translate one statement-capability failure at its single owning point.
+    pub(crate) fn from_statement(context: &str, source: StatementError) -> Self {
+        let kind = match source.kind() {
+            StatementErrorKind::SerializationFailure
+            | StatementErrorKind::ConnectionUnavailable => FailureKind::Retry,
+            StatementErrorKind::StatementTimeout => FailureKind::Timeout,
+            StatementErrorKind::PermissionDenied => FailureKind::PermissionDenied,
+            _ => FailureKind::InternalError,
+        };
+        Self {
+            kind,
+            context: format!("{context}: {source}"),
+            field: None,
+            id: None,
+            source: Some(source),
+        }
+    }
+}
+
+impl fmt::Display for Failure {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(&self.context)
+    }
+}
+
+impl Error for Failure {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        self.source.as_ref().map(|source| source as &dyn Error)
+    }
+}
