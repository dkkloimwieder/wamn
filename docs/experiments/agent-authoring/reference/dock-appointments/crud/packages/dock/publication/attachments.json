  "appointment-book-http": {
    "kind": "http",
    "package-id": "wamn_dock",
    "wiring-id": "appointment_book",
    "wiring-version": 1,
    "definition-hash": "sha256:a5ea138faa803a5faf0bdeb3ed8fe935ef551dff4a67191e07817996dd9147eb",
    "definition": {
      "id": "appointment-book-http",
      "kind": "http",
      "route": {
        "path": "/appointment/book",
        "method": "POST"
      },
      "raw-body-bytes": {
        "maximum": 1048576
      },
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "request_id",
            "idempotency_key",
            "carrier_id",
            "dock_id",
            "slot_start",
            "slot_end"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "idempotency_key": {
              "type": "string",
              "minLength": 1
            },
            "carrier_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "dock_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "slot_start": {
              "type": "string",
              "format": "date-time"
            },
            "slot_end": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "auth-policy": {
      "mode": "pat"
    },
    "registered-operation": "wamn-dock:appointment/book@1.0.0"
  },
