  "appointment-query-http": {
    "kind": "http",
    "package-id": "wamn_dock",
    "wiring-id": "appointment_query",
    "wiring-version": 1,
    "definition-hash": "sha256:248a13a09eb2f073549adb4f7fe7870999b5662c15c5d45ffbb02f810a95fc84",
    "definition": {
      "id": "appointment-query-http",
      "kind": "http",
      "route": {
        "path": "/appointment/query",
        "method": "POST"
      },
      "raw-body-bytes": {
        "maximum": 1048576
      },
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "request_id",
            "dock_id",
            "day",
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "dock_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "day": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "status": {
              "enum": [
                "scheduled",
                "arrived",
                "departed"
              ]
            }
          }
        }
      }
    },
    "auth-policy": {
      "mode": "pat"
    },
    "registered-operation": "wamn-dock:appointment/query@1.0.0"
  }
