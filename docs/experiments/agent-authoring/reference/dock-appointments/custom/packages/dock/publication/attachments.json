  "appointment-book-http": {
    "kind": "http",
    "package-id": "wamn_dock",
    "wiring-id": "appointment_book",
    "wiring-version": 1,
    "definition-hash": "sha256:a86a9a9b0021076a5fe65e388849cf8ab5db54ad280f688fb561390b1f8c08aa",
    "definition": {
      "id": "appointment-book-http",
      "kind": "http",
      "route": {
        "path": "/appointment/book",
        "method": "POST"
      },
      "raw-body-bytes": {
        "maximum": 1048576
      },
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "request_id",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "object",
              "required": [
                "idempotency_key",
                "carrier_id",
                "dock_id",
                "slot_start",
                "slot_end"
              ],
              "additionalProperties": false,
              "properties": {
                "idempotency_key": {
                  "type": "string",
                  "minLength": 1
                },
                "carrier_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "dock_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "slot_start": {
                  "type": "string",
                  "format": "date-time"
                },
                "slot_end": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    },
    "auth-policy": {
      "mode": "pat"
    },
    "registered-operation": "wamn-dock:appointment/book@1.0.0"
  },
