{
  "commands": [
    [
      "rustfmt",
      "--check",
      "--edition",
      "2024",
      "crates/platform/runtime/tests/native_dispatch_binding.rs",
      "crates/platform/runtime/tests/native_dispatch_deadline.rs"
    ],
    [
      "git",
      "diff",
      "--cached",
