[workspace]
resolver = "2"
# A SECOND component workspace, named for the property that forces it to exist.
#
# Cargo unifies features across every member of one invocation, and unification
# is ADDITIVE-ONLY: no downstream declaration can switch a feature off that an
# upstream crate switches on. Members of ../Cargo.toml reach `serde_json/std`
# through boon, jmespath and schemars — external crates with no feature knob —
# so any `no_std` guest that supplies its own `#[panic_handler]` collides with
# std's the moment it shares that invocation (E0152, duplicate lang item
# `panic_impl`). Isolation is therefore a separate workspace, not a feature
# flag; `resolver = "2"` does not isolate members within one invocation.
#
# Do not fold these members back into ../Cargo.toml. See wamn-0h0g.11.56 and
# wamn-1yj4, which measured the alternatives: dropping `no_std` compiles but
# adds ten wasi:cli imports that TENANT_WASI_PACKAGES denies, making both
# guests unpublishable, and declaring `serde_json` with default-features = false
# does not help because the std request is not local.
#
# These two are not every `no_std` guest in the tree. The fixture
# `../fixtures/connection-http-standard` is a third and stays in `../Cargo.toml`:
# it has no `serde_json` dependency, so it has no unification to escape (owner
# ruling, wamn-6i30).
members = ["http-request", "label-render", "label-template", "transform"]

# Lint policy. IDENTICAL to the root workspace's by intent -- see the root
# `Cargo.toml` for the full rationale and the measured exemption counts. It is
# duplicated rather than inherited because Cargo has no way to share a lints
# table ACROSS workspaces, and this is a separate workspace by necessity, not by
# preference. Keep the two in step: if the root policy moves, move this too.
#
# M-LINT-OVERRIDE-EXPECT: override with `#[expect(..., reason = "...")]`, never
# `#[allow]`.
[workspace.lints.rust]
ambiguous_negative_literals = "deny"
redundant_lifetimes = "deny"
trivial_numeric_casts = "deny"
unsafe_op_in_unsafe_fn = "deny"
unused_lifetimes = "deny"
missing_debug_implementations = "warn"
redundant_imports = "warn"

[workspace.lints.clippy]
correctness = { level = "deny", priority = -1 }
suspicious = { level = "deny", priority = -1 }
cargo = { level = "warn", priority = -1 }
complexity = { level = "warn", priority = -1 }
pedantic = { level = "warn", priority = -1 }
perf = { level = "warn", priority = -1 }
style = { level = "warn", priority = -1 }

must_use_candidate = "allow"
missing_errors_doc = "allow"
doc_markdown = "allow"
cargo_common_metadata = "allow"
too_many_lines = "allow"
missing_panics_doc = "allow"
multiple_crate_versions = "allow"
return_self_not_must_use = "allow"

[workspace.package]
version = "0.1.0"
edition = "2024"

[workspace.dependencies]
dlmalloc = { version = "0.2.14", features = ["global"] }
wit-bindgen = { version = "0.44", default-features = false, features = ["macros", "realloc"] }

[profile.release]
opt-level = "s"
strip = true
