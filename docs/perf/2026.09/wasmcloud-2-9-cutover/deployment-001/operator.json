        ],
        "verbs": [
          "create",
          "patch"
        ]
      },
      {
        "apiGroups": [
          ""
        ],
        "resources": [
          "pods"
        ],
        "verbs": [
          "get",
          "list",
          "patch",
          "watch"
        ]
      },
      {
        "apiGroups": [
          "runtime.wasmcloud.dev"
        ],
        "resources": [
          "hosts",
          "hosts/finalizers"
        ],
        "verbs": [
          "get",
          "list",
          "watch",
          "create",
          "update",
          "patch",
          "delete"
        ]
      },
      {
        "apiGroups": [
          "runtime.wasmcloud.dev"
        ],
        "resources": [
          "hosts/status"
        ],
        "verbs": [
          "get",
          "update",
          "patch"
        ]
      }
    ]
  },
