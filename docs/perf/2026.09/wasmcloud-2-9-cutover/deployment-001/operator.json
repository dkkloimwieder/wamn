[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "runtime-operator",
      "namespace": "wamn-system",
      "labels": {
        "wasmcloud.com/name": "runtime-operator",
        "helm.sh/chart": "runtime-operator-2.9.0",
        "app.kubernetes.io/name": "runtime-operator",
        "app.kubernetes.io/instance": "wamn",
        "app.kubernetes.io/version": "2.9.0",
        "app.kubernetes.io/managed-by": "Helm"
      }
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "wasmcloud.com/name": "runtime-operator"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "wasmcloud.com/name": "runtime-operator",
            "helm.sh/chart": "runtime-operator-2.9.0",
            "app.kubernetes.io/name": "runtime-operator",
            "app.kubernetes.io/instance": "wamn",
            "app.kubernetes.io/version": "2.9.0",
            "app.kubernetes.io/managed-by": "Helm"
          }
        },
        "spec": {
          "automountServiceAccountToken": true,
          "securityContext": {
            "fsGroup": 65532,
            "runAsGroup": 65532,
            "runAsNonRoot": true,
            "runAsUser": 65532,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "volumes": [
            {
              "name": "operator-cert",
              "secret": {
                "secretName": "wasmcloud-operator-tls"
              }
            }
          ],
          "serviceAccountName": "wamn-runtime-operator",
          "containers": [
            {
              "name": "runtime-operator",
              "image": "ghcr.io/wasmcloud/runtime-operator:2.9.0",
              "args": [
                "-nats-url=nats://nats.wamn-system.svc.cluster.local:4222",
                "-nats-ca=/operator-cert/ca.crt",
                "-nats-client-cert=/operator-cert/tls.crt",
                "-nats-client-key=/operator-cert/tls.key",
                "-watch-namespaces=wamn-system",
                "-allow-shared-hosts=false",
                "-leader-elect"
              ],
              "env": [
                {
                  "name": "OPERATOR_NAMESPACE",
                  "valueFrom": {
                    "fieldRef": {
                      "fieldPath": "metadata.namespace"
                    }
                  }
                }
              ],
              "imagePullPolicy": "Always",
              "volumeMounts": [
                {
                  "name": "operator-cert",
                  "mountPath": "/operator-cert",
                  "readOnly": true
                }
              ],
              "resources": {
                "limits": {
                  "memory": "192Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "64Mi"
                }
              },
              "ports": [
                {
                  "name": "health",
                  "containerPort": 8082,
                  "protocol": "TCP"
                }
              ],
              "startupProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "health"
                },
                "periodSeconds": 5,
                "failureThreshold": 24
              },
              "livenessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "health"
                },
                "initialDelaySeconds": 15,
                "periodSeconds": 20,
                "failureThreshold": 3
              },
              "readinessProbe": {
                "httpGet": {
                  "path": "/readyz",
                  "port": "health"
                },
                "initialDelaySeconds": 5,
                "periodSeconds": 10,
                "failureThreshold": 3
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true
              }
            }
          ],
          "dnsPolicy": "ClusterFirst",
          "restartPolicy": "Always",
          "terminationGracePeriodSeconds": 45
        }
      }
    }
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
