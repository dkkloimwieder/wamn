package wamn:postgres@0.1.0 {
  interface types {
    variant sql-value {
      null,
      boolean(bool),
      int32(s32),
      int64(s64),
      %float64(f64),
      text(string),
      bytes(list<u8>),
      numeric(string),
      timestamptz(string),
      json(string),
      uuid(string),
    }

    record column {
      name: string,
      type-name: string,
    }

    record row-set {
      columns: list<column>,
      rows: list<list<sql-value>>,
    }

    variant pg-error {
      serialization-failure,
      connection-unavailable,
      statement-timeout,
      row-limit-exceeded(u64),
      unique-violation(string),
      foreign-key-violation(string),
      check-violation(string),
      exclusion-violation(string),
      permission-denied,
      query-error(tuple<string, string>),
    }
  }
  interface client {
    use types.{sql-value, row-set, pg-error};

    query: func(sql: string, params: list<sql-value>) -> result<row-set, pg-error>;
  }
}


package wamn:jetstream@0.1.0 {
  interface types {
    variant js-error {
      connection-unavailable,
      not-found(string),
      publish-rejected(string),
      ack-failed(string),
      other(string),
    }
  }
  interface registration {
    use types.{js-error};

    record consumer-config {
      stream-name: string,
      durable: string,
      filter-subject: string,
      ack-wait-ms: u64,
      max-deliver: u32,
    }

    prepare: func(package-id: string, registration-id: string, config: consumer-config) -> result<_, js-error>;
  }
}


package wasmcloud:nats@0.1.0 {
  interface types {
    record header-entry {
      name: string,
      value: string,
    }

    record nats-message {
      subject: string,
      body: list<u8>,
      reply-to: option<string>,
      headers: option<list<header-entry>>,
    }

    enum denial-reason {
      reserved,
      not-granted,
      wildcard-not-allowed,
    }

    variant denied-resource {
      subject,
      %stream,
      bucket,
      message(u64),
    }

    record denial {
      reason: denial-reason,
      target: denied-resource,
      name: string,
    }

    variant nats-error {
      connection(string),
      timeout(string),
      no-responders,
      denied(denial),
      max-payload-exceeded(u64),
      invalid-header(string),
      jetstream(string),
      key-not-found,
      revision-mismatch(u64),
      no-messages,
      limit-exceeded(string),
      not-found(string),
      unsupported-by-server(string),
      disconnected,
      already-settled,
      ack-owned-by-host,
      unexpected(string),
    }
  }
  interface jetstream {
    use types.{nats-message, nats-error};

    resource message-handle {
      message: func() -> nats-message;
      sequence: func() -> u64;
      ack-sync: async func() -> result<_, nats-error>;
      nak: async func(delay-ms: option<u32>) -> result<_, nats-error>;
      term: async func() -> result<_, nats-error>;
    }

    resource pull-consumer {
      fetch: async func(batch: u32, timeout-ms: u32) -> result<fetched-batch, nats-error>;
    }

    enum fetch-stop {
      batch-filled,
      drained,
      byte-limit,
    }

    record fetched-batch {
      messages: list<message-handle>,
      stop: fetch-stop,
    }

    open-pull-consumer: async func(stream-name: string, consumer: string) -> result<pull-consumer, nats-error>;
  }
}


package wamn:flow-http-routing@0.1.0 {
  interface routing {
    resource authenticated-caller;
  }
}


package wamn:router-delivery@0.1.0 {
  interface delivery {
    use wamn:flow-http-routing/routing@0.1.0.{authenticated-caller};

    variant source {
      attachment(string),
      registration(string),
    }

    record trace-context {
      traceparent: string,
      tracestate: option<string>,
    }

    record parent-causation {
      root: string,
      depth: u32,
    }

    record delivery-request {
      source: source,
      delivery-id: string,
      payload: string,
      caller: option<authenticated-caller>,
      trace: option<trace-context>,
      parent-causation: option<parent-causation>,
    }

    record emission {
      event: string,
      dedup-id: string,
    }

    enum failure-kind {
      terminal,
      retry-exhausted,
      invalid-input,
      hop-limit,
      unreleased-caller,
      missing-dedup-id,
      respond-without-caller,
      second-verdict,
    }

    record delivery-failure {
      kind: failure-kind,
      code: option<string>,
      message: string,
    }

    record permission-denial {
      operation: string,
    }

    variant delivery-error {
      source-not-found,
      invalid-request,
      invalid-payload,
      execution-failed,
      permission-denied(permission-denial),
      fresh-credential-required(permission-denial),
    }

    variant failed-outcome {
      failed(delivery-failure),
      error(delivery-error),
      cancelled,
    }

    enum effect-outcome {
      refused-before-dispatch,
      responded,
      timeout,
      cancelled,
      effect-uncertain,
      response-lost,
    }

    record partial-completion {
      committed-result: string,
      failed-outcome: failed-outcome,
      effect-outcome: option<effect-outcome>,
    }

    variant delivery-outcome {
      respond(string),
      emit(emission),
      discard,
      failed(delivery-failure),
      partially-completed(partial-completion),
      cancelled,
    }

    deliver: func(request: delivery-request) -> result<delivery-outcome, delivery-error>;
  }
}


package wasi:io@0.2.9 {
  interface poll {
    resource pollable {
      block: func();
    }

    poll: func(in: list<borrow<pollable>>) -> list<u32>;
  }
  interface error {
    resource error;
  }
  interface streams {
    use error.{error};
    use poll.{pollable};

    resource input-stream;

    resource output-stream {
      check-write: func() -> result<u64, stream-error>;
      write: func(contents: list<u8>) -> result<_, stream-error>;
      blocking-flush: func() -> result<_, stream-error>;
      subscribe: func() -> pollable;
    }

    variant stream-error {
      last-operation-failed(error),
      closed,
    }
  }
}


package wasi:clocks@0.2.9 {
  interface monotonic-clock {
    use wasi:io/poll@0.2.9.{pollable};

    type instant = u64;

    type duration = u64;

    subscribe-instant: func(when: instant) -> pollable;

    subscribe-duration: func(when: duration) -> pollable;
  }
  interface wall-clock {
    record datetime {
      seconds: u64,
      nanoseconds: u32,
    }
  }
}


package wasi:cli@0.2.9 {
  interface stdout {
    use wasi:io/streams@0.2.9.{output-stream};

    get-stdout: func() -> output-stream;
  }
  interface stderr {
    use wasi:io/streams@0.2.9.{output-stream};

    get-stderr: func() -> output-stream;
  }
  interface stdin {
    use wasi:io/streams@0.2.9.{input-stream};

    get-stdin: func() -> input-stream;
  }
  interface environment {
    get-environment: func() -> list<tuple<string, string>>;
  }
  interface exit {
    exit: func(status: result);
  }
  interface terminal-input {
    resource terminal-input;
  }
  interface terminal-output {
    resource terminal-output;
  }
  interface terminal-stdin {
    use terminal-input.{terminal-input};

    get-terminal-stdin: func() -> option<terminal-input>;
  }
  interface terminal-stdout {
    use terminal-output.{terminal-output};

    get-terminal-stdout: func() -> option<terminal-output>;
  }
  interface terminal-stderr {
    use terminal-output.{terminal-output};

    get-terminal-stderr: func() -> option<terminal-output>;
  }
}


package wasi:filesystem@0.2.9 {
  interface types {
    use wasi:io/streams@0.2.9.{input-stream, output-stream};
    use wasi:clocks/wall-clock@0.2.9.{datetime};

    resource descriptor {
      read-via-stream: func(offset: filesize) -> result<input-stream, error-code>;
      write-via-stream: func(offset: filesize) -> result<output-stream, error-code>;
      append-via-stream: func() -> result<output-stream, error-code>;
      get-flags: func() -> result<descriptor-flags, error-code>;
      stat: func() -> result<descriptor-stat, error-code>;
      open-at: func(path-flags: path-flags, path: string, open-flags: open-flags, %flags: descriptor-flags) -> result<descriptor, error-code>;
      metadata-hash: func() -> result<metadata-hash-value, error-code>;
    }

    type filesize = u64;

    enum error-code {
      access,
      would-block,
      already,
      bad-descriptor,
      busy,
      deadlock,
      quota,
      exist,
      file-too-large,
      illegal-byte-sequence,
      in-progress,
      interrupted,
      invalid,
      io,
      is-directory,
      loop,
      too-many-links,
      message-size,
      name-too-long,
      no-device,
      no-entry,
      no-lock,
      insufficient-memory,
      insufficient-space,
      not-directory,
      not-empty,
      not-recoverable,
      unsupported,
      no-tty,
      no-such-device,
      overflow,
      not-permitted,
      pipe,
      read-only,
      invalid-seek,
      text-file-busy,
      cross-device,
    }

    flags descriptor-flags {
      read,
      write,
      file-integrity-sync,
      data-integrity-sync,
      requested-write-sync,
      mutate-directory,
    }

    enum descriptor-type {
      unknown,
      block-device,
      character-device,
      directory,
      fifo,
      symbolic-link,
      regular-file,
      socket,
    }

    type link-count = u64;

    record descriptor-stat {
      %type: descriptor-type,
      link-count: link-count,
      size: filesize,
      data-access-timestamp: option<datetime>,
      data-modification-timestamp: option<datetime>,
      status-change-timestamp: option<datetime>,
    }

    flags path-flags {
      symlink-follow,
    }

    flags open-flags {
      create,
      directory,
      exclusive,
      truncate,
    }

    record metadata-hash-value {
      lower: u64,
      upper: u64,
    }
  }
  interface preopens {
    use types.{descriptor};

    get-directories: func() -> list<tuple<descriptor, string>>;
  }
}


package wasi:random@0.2.9 {
  interface insecure-seed {
    insecure-seed: func() -> tuple<u64, u64>;
  }
}


package wasi:cli@0.2.0 {
  interface run {
    run: func() -> result;
  }
}
