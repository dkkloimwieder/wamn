+    let package = run(&catalog(false), &manifest(), &QUERY_SOURCES).unwrap();
+    let sql = std::str::from_utf8(
+        package
+            .file("generated/sql/purchase_order/update.sql")
+            .unwrap()
+            .bytes(),
+    )
+    .unwrap();
+    let returning = sql
+        .split_once("    RETURNING\n")
+        .unwrap()
+        .1
+        .split_once("\n)\nSELECT")
+        .unwrap()
+        .0;
