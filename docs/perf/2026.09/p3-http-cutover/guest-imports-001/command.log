package wamn:flow-http-routing@0.1.0 {
  interface routing {
    resource authenticated-caller;

    resource route-permit;

    record header {
      name: string,
      value: string,
    }

    record auth-rejection {
      status: u16,
      code: string,
    }

    enum mapping-source {
      body,
      path,
      query,
      header,
    }

    enum cardinality {
      one,
      many,
    }

    record mapping {
      %from: mapping-source,
      name: string,
      to: string,
      optional: bool,
      cardinality: cardinality,
    }

    record route-definition {
      attachment-id: string,
      host: string,
      path: string,
      method: string,
      mappings: list<mapping>,
      body-limit: u64,
      mapped-limit: u64,
    }

    routes: func(method: string, authority: string) -> result<list<route-definition>, string>;

    authenticate: func(attachment-id: string, headers: list<header>) -> result<option<authenticated-caller>, auth-rejection>;

    validate-input: func(attachment-id: string, payload: string) -> result<_, string>;

    try-acquire: func(attachment-id: string) -> result<option<route-permit>, string>;
  }
}


package wamn:router-delivery@0.1.0 {
  interface delivery {
    use wamn:flow-http-routing/routing@0.1.0.{authenticated-caller};

    variant source {
      attachment(string),
      registration(string),
    }

    record trace-context {
      traceparent: string,
      tracestate: option<string>,
    }

    record parent-causation {
      root: string,
      depth: u32,
    }

    record delivery-request {
      source: source,
      delivery-id: string,
      payload: string,
      caller: option<authenticated-caller>,
      trace: option<trace-context>,
      parent-causation: option<parent-causation>,
    }

    record emission {
      event: string,
      dedup-id: string,
    }

    enum failure-kind {
      terminal,
      retry-exhausted,
      invalid-input,
      hop-limit,
      unreleased-caller,
      missing-dedup-id,
      respond-without-caller,
      second-verdict,
    }

    record delivery-failure {
      kind: failure-kind,
      code: option<string>,
      message: string,
    }

    record permission-denial {
      operation: string,
    }

    variant delivery-error {
      source-not-found,
      invalid-request,
      invalid-payload,
      execution-failed,
      permission-denied(permission-denial),
      fresh-credential-required(permission-denial),
    }

    variant failed-outcome {
      failed(delivery-failure),
      error(delivery-error),
      cancelled,
    }

    enum effect-outcome {
      refused-before-dispatch,
      responded,
      timeout,
      cancelled,
      effect-uncertain,
      response-lost,
    }

    record partial-completion {
      committed-result: string,
      failed-outcome: failed-outcome,
      effect-outcome: option<effect-outcome>,
    }

    variant delivery-outcome {
      respond(string),
      emit(emission),
      discard,
      failed(delivery-failure),
      partially-completed(partial-completion),
      cancelled,
    }

    deliver: func(request: delivery-request) -> result<delivery-outcome, delivery-error>;
  }
}


package wasi:random@0.2.12 {
  interface random {
    get-random-bytes: func(len: u64) -> list<u8>;
  }
}


package wasi:http@0.3.0 {
  interface types {
    resource fields {
      constructor();
      set: func(name: field-name, value: list<field-value>) -> result<_, header-error>;
      copy-all: func() -> list<tuple<field-name, field-value>>;
    }

    type trailers = fields;

    record DNS-error-payload {
      rcode: option<string>,
      info-code: option<u16>,
    }

    record TLS-alert-received-payload {
      alert-id: option<u8>,
      alert-message: option<string>,
    }

    record field-size-payload {
      field-name: option<string>,
      field-size: option<u32>,
    }

    variant error-code {
      DNS-timeout,
      DNS-error(DNS-error-payload),
      destination-not-found,
      destination-unavailable,
      destination-IP-prohibited,
      destination-IP-unroutable,
      connection-refused,
      connection-terminated,
      connection-timeout,
      connection-read-timeout,
      connection-write-timeout,
      connection-limit-reached,
      TLS-protocol-error,
      TLS-certificate-error,
      TLS-alert-received(TLS-alert-received-payload),
      HTTP-request-denied,
      HTTP-request-length-required,
      HTTP-request-body-size(option<u64>),
      HTTP-request-method-invalid,
      HTTP-request-URI-invalid,
      HTTP-request-URI-too-long,
      HTTP-request-header-section-size(option<u32>),
      HTTP-request-header-size(option<field-size-payload>),
      HTTP-request-trailer-section-size(option<u32>),
      HTTP-request-trailer-size(field-size-payload),
      HTTP-response-incomplete,
      HTTP-response-header-section-size(option<u32>),
      HTTP-response-header-size(field-size-payload),
      HTTP-response-body-size(option<u64>),
      HTTP-response-trailer-section-size(option<u32>),
      HTTP-response-trailer-size(field-size-payload),
      HTTP-response-transfer-coding(option<string>),
      HTTP-response-content-coding(option<string>),
      HTTP-response-timeout,
      HTTP-upgrade-failed,
      HTTP-protocol-error,
      loop-detected,
      configuration-error,
      internal-error(option<string>),
    }

    resource request {
      get-method: func() -> method;
      get-path-with-query: func() -> option<string>;
      get-authority: func() -> option<string>;
      get-headers: func() -> headers;
      consume-body: static func(this: request, res: future<result<_, error-code>>) -> tuple<stream<u8>, future<result<option<trailers>, error-code>>>;
    }

    type headers = fields;

    resource response {
      new: static func(headers: headers, contents: option<stream<u8>>, trailers: future<result<option<trailers>, error-code>>) -> tuple<response, future<result<_, error-code>>>;
      set-status-code: func(status-code: status-code) -> result;
    }

    type status-code = u16;

    type field-name = string;

    type field-value = list<u8>;

    variant header-error {
      invalid-syntax,
      forbidden,
      immutable,
      size-exceeded,
      other(option<string>),
    }

    variant method {
      get,
      head,
      post,
      put,
      delete,
      connect,
      options,
      trace,
      patch,
      other(string),
    }
  }
  interface handler {
    use types.{request, response, error-code};

    handle: async func(request: request) -> result<response, error-code>;
  }
}


package wasi:io@0.2.9 {
  interface poll {
    resource pollable {
      block: func();
    }

    poll: func(in: list<borrow<pollable>>) -> list<u32>;
  }
  interface error {
    resource error;
  }
  interface streams {
    use error.{error};
    use poll.{pollable};

    resource input-stream;

    resource output-stream {
      check-write: func() -> result<u64, stream-error>;
      write: func(contents: list<u8>) -> result<_, stream-error>;
      blocking-flush: func() -> result<_, stream-error>;
      subscribe: func() -> pollable;
    }

    variant stream-error {
      last-operation-failed(error),
      closed,
    }
  }
}


package wasi:clocks@0.2.9 {
  interface monotonic-clock {
    use wasi:io/poll@0.2.9.{pollable};

    type duration = u64;

    subscribe-duration: func(when: duration) -> pollable;
  }
}


package wasi:cli@0.2.9 {
  interface stdout {
    use wasi:io/streams@0.2.9.{output-stream};

    get-stdout: func() -> output-stream;
  }
  interface stderr {
    use wasi:io/streams@0.2.9.{output-stream};

    get-stderr: func() -> output-stream;
  }
  interface stdin {
    use wasi:io/streams@0.2.9.{input-stream};

    get-stdin: func() -> input-stream;
  }
  interface environment {
    get-environment: func() -> list<tuple<string, string>>;
  }
  interface exit {
    exit: func(status: result);
  }
  interface terminal-input {
    resource terminal-input;
  }
  interface terminal-output {
    resource terminal-output;
  }
  interface terminal-stdin {
    use terminal-input.{terminal-input};

    get-terminal-stdin: func() -> option<terminal-input>;
  }
  interface terminal-stdout {
    use terminal-output.{terminal-output};

    get-terminal-stdout: func() -> option<terminal-output>;
  }
  interface terminal-stderr {
    use terminal-output.{terminal-output};

    get-terminal-stderr: func() -> option<terminal-output>;
  }
}
