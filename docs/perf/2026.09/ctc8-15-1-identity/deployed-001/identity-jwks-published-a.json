{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "identity-jwks-published-a",
    "namespace": "wamn-identity-jwks"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 120,
    "template": {
      "metadata": {
        "labels": {
          "app": "identity-jwks"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "identity-jwks",
            "image": "wamn-gates:jwks-9ab1c62278e9-3144219",
            "imagePullPolicy": "Never",
            "args": [
              "identity-jwks"
            ],
            "env": [
              {
                "name": "WAMN_IDENTITY_ISSUER",
                "value": "https://wamn-identity.wamn-identity-jwks.svc.cluster.local"
              },
              {
                "name": "WAMN_IDENTITY_JWKS_URL",
                "value": "https://wamn-identity.wamn-identity-jwks.svc.cluster.local/.well-known/jwks.json"
              },
              {
                "name": "WAMN_IDENTITY_CA_FILE",
                "value": "/etc/wamn-identity-ca/ca.crt"
              },
              {
                "name": "WAMN_IDENTITY_WRONG_CA_FILE",
                "value": "/etc/wamn-identity-ca/wrong-ca.crt"
              },
              {
                "name": "WAMN_IDENTITY_EXPECTED_KIDS",
                "value": "[\"5797cf87-8777-4814-9ebf-155fcfc4872c\"]"
              }
            ],
            "volumeMounts": [
              {
                "name": "public-ca",
                "mountPath": "/etc/wamn-identity-ca",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "public-ca",
            "configMap": {
              "name": "identity-jwks-public"
            }
          }
        ]
      }
    }
  }
}
