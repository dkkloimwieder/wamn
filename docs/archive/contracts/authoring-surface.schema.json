{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AuthoringCommand": {
      "description": "Frontend-independent command inventory for the minimum authoring loop.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "input": {
              "$ref": "#/definitions/SaveFlowDraft"
            },
            "kind": {
              "enum": [
                "save-flow-draft"
              ],
              "type": "string"
            }
          },
          "required": [
            "input",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "input": {
              "$ref": "#/definitions/ValidateDraft"
            },
            "kind": {
              "enum": [
                "validate"
              ],
              "type": "string"
            }
          },
          "required": [
            "input",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "input": {
              "$ref": "#/definitions/DraftRun"
            },
            "kind": {
              "enum": [
                "draft-run"
              ],
              "type": "string"
            }
          },
          "required": [
            "input",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "input": {
              "$ref": "#/definitions/PublishValidatedDraft"
            },
            "kind": {
              "enum": [
                "publish"
              ],
              "type": "string"
            }
          },
          "required": [
            "input",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "AuthoringCommandKind": {
      "description": "Stable command names used to attribute a refusal without parsing prose.",
      "enum": [
        "save-flow-draft",
        "validate",
        "draft-run",
        "publish"
      ],
      "type": "string"
    },
    "AuthoringOutcome": {
      "description": "A successful typed result or a typed product refusal.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "completed"
              ],
              "type": "string"
            },
            "value": {
              "$ref": "#/definitions/AuthoringSuccess"
            }
          },
          "required": [
            "status",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "refused"
              ],
              "type": "string"
            },
            "value": {
              "$ref": "#/definitions/CommandRefusal"
            }
          },
          "required": [
            "status",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "AuthoringRefusal": {
      "description": "Product refusals; infrastructure faults remain outside this taxonomy.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "authorization-denied"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "unsupported-contract-version"
              ],
              "type": "string"
            },
            "requested": {
              "type": "string"
            },
            "supported": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "requested",
            "supported"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "actual-revision": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "expected-revision": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 0.0,
              "type": "integer"
            },
            "kind": {
              "enum": [
                "revision-conflict"
              ],
              "type": "string"
            }
          },
          "required": [
            "expected-revision",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "resource-not-found"
              ],
              "type": "string"
            },
            "resource": {
              "$ref": "#/definitions/ResourceKind"
            }
          },
          "required": [
            "id",
            "kind",
            "resource"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "issues": {
              "items": {
                "$ref": "#/definitions/ValidationIssue"
              },
              "type": "array"
            },
            "kind": {
              "enum": [
                "invalid-draft"
              ],
              "type": "string"
            }
          },
          "required": [
            "issues",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "catalog-drift"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "unresolved-nodes"
              ],
              "type": "string"
            },
            "node-types": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "node-types"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "validated-draft-drift"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "connection-names": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "enum": [
                "draft-connections-denied"
              ],
              "type": "string"
            }
          },
          "required": [
            "connection-names",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "publish-executable-drift"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "publish-blocked-by-nonterminal-runs"
              ],
              "type": "string"
            },
            "run-ids": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "run-ids"
          ],
          "type": "object"
        }
      ]
    },
    "AuthoringRequest": {
      "additionalProperties": false,
      "description": "One idempotent client command.",
      "properties": {
        "command": {
          "$ref": "#/definitions/AuthoringCommand"
        },
        "command-id": {
          "description": "Client-generated correlation and exact-retry identity.",
          "type": "string"
        },
        "schema-version": {
          "enum": [
            "0.1"
          ],
          "type": "string"
        }
      },
      "required": [
        "command",
        "command-id",
        "schema-version"
      ],
      "type": "object"
    },
    "AuthoringResponse": {
      "additionalProperties": false,
      "description": "Result or typed refusal for one command identity.",
      "properties": {
        "command-id": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/definitions/AuthoringOutcome"
        },
        "schema-version": {
          "enum": [
            "0.1"
          ],
          "type": "string"
        }
      },
      "required": [
        "command-id",
        "outcome",
        "schema-version"
      ],
      "type": "object"
    },
    "AuthoringScope": {
      "additionalProperties": false,
      "description": "Project and environment selected by a client.\n\nOrganization and principal are authenticated adapter context, not fields a client may assert in this document.",
      "properties": {
        "environment": {
          "type": "string"
        },
        "project-id": {
          "type": "string"
        }
      },
      "required": [
        "environment",
        "project-id"
      ],
      "type": "object"
    },
    "AuthoringSuccess": {
      "description": "The successful result paired with each command.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "enum": [
                "save-flow-draft"
              ],
              "type": "string"
            },
            "result": {
              "$ref": "#/definitions/DraftIdentity"
            }
          },
          "required": [
            "command",
            "result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "enum": [
                "validate"
              ],
              "type": "string"
            },
            "result": {
              "$ref": "#/definitions/ValidatedDraftIdentity"
            }
          },
          "required": [
            "command",
            "result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "enum": [
                "draft-run"
              ],
              "type": "string"
            },
            "result": {
              "$ref": "#/definitions/DraftRunReceipt"
            }
          },
          "required": [
            "command",
            "result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "enum": [
                "publish"
              ],
              "type": "string"
            },
            "result": {
              "$ref": "#/definitions/PublishedFlowIdentity"
            }
          },
          "required": [
            "command",
            "result"
          ],
          "type": "object"
        }
      ]
    },
    "CatalogIdentity": {
      "additionalProperties": false,
      "description": "Applied catalog identity pinned by validation.",
      "properties": {
        "catalog-id": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "catalog-id",
        "version"
      ],
      "type": "object"
    },
    "CommandRefusal": {
      "additionalProperties": false,
      "description": "A refusal attributed to an exact command kind.",
      "properties": {
        "command": {
          "$ref": "#/definitions/AuthoringCommandKind"
        },
        "reason": {
          "$ref": "#/definitions/AuthoringRefusal"
        }
      },
      "required": [
        "command",
        "reason"
      ],
      "type": "object"
    },
    "CommitProvenance": {
      "additionalProperties": false,
      "description": "Where a client read the submitted definition from.\n\n**Attribution only.** A checkout client knows the commit its working tree came from; recording that makes a stored revision traceable to the source it was edited in. It authorizes nothing: it selects no principal, widens no role, and changes no result. Two otherwise identical commands, one with this and one without, produce the same outcome and the same stored document.\n\nThe platform never clones a repository, runs Git, or verifies any of these values. They are the client's claim about its own working tree, retained verbatim beside the verified principal that actually authorized the command. No field here is an identity: a subject lives on the audited principal, and nothing in this object may be read as one.",
      "properties": {
        "commit": {
          "description": "Exact commit the working tree was at.",
          "type": "string"
        },
        "dirty": {
          "description": "Whether the submitted content differs from that commit. A dirty tree means the content is descended from `commit`, not equal to it.",
          "type": "boolean"
        },
        "ref": {
          "description": "Ref the checkout was on, or null when the client cannot name one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "commit",
        "dirty"
      ],
      "type": "object"
    },
    "DraftIdentity": {
      "additionalProperties": false,
      "description": "Stable identity returned after a draft save.",
      "properties": {
        "draft-id": {
          "type": "string"
        },
        "flow-id": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "draft-id",
        "flow-id",
        "revision"
      ],
      "type": "object"
    },
    "DraftRevisionRef": {
      "additionalProperties": false,
      "description": "Select one exact mutable draft revision.",
      "properties": {
        "draft-id": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "draft-id",
        "revision"
      ],
      "type": "object"
    },
    "DraftRun": {
      "additionalProperties": false,
      "description": "Execute one input against an exact validated draft.",
      "properties": {
        "capture": {
          "allOf": [
            {
              "$ref": "#/definitions/DraftRunCapture"
            }
          ],
          "default": "full",
          "description": "Whether this one draft run captures node input and output. Omission is full capture; other admission paths expose no such choice."
        },
        "input": true,
        "scope": {
          "$ref": "#/definitions/AuthoringScope"
        },
        "validated-draft": {
          "$ref": "#/definitions/ValidatedDraftRef"
        }
      },
      "required": [
        "input",
        "scope",
        "validated-draft"
      ],
      "type": "object"
    },
    "DraftRunCapture": {
      "description": "Capture choice for one direct draft run: full capture or no capture.",
      "enum": [
        "full",
        "off"
      ],
      "type": "string"
    },
    "DraftRunReceipt": {
      "additionalProperties": false,
      "description": "Receipt for one admitted draft run.",
      "properties": {
        "run-id": {
          "type": "string"
        },
        "validated-draft": {
          "$ref": "#/definitions/ValidatedDraftRef"
        }
      },
      "required": [
        "run-id",
        "validated-draft"
      ],
      "type": "object"
    },
    "PublishValidatedDraft": {
      "additionalProperties": false,
      "description": "Publish exactly the executable proven by a successful report.",
      "properties": {
        "scope": {
          "$ref": "#/definitions/AuthoringScope"
        },
        "successful-report-id": {
          "type": "string"
        },
        "validated-draft": {
          "$ref": "#/definitions/ValidatedDraftRef"
        }
      },
      "required": [
        "scope",
        "successful-report-id",
        "validated-draft"
      ],
      "type": "object"
    },
    "PublishedFlowIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity produced by publishing the tested draft.",
      "properties": {
        "artifact-hash": {
          "type": "string"
        },
        "flow-id": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "artifact-hash",
        "flow-id",
        "version"
      ],
      "type": "object"
    },
    "ResourceKind": {
      "description": "Stable resource categories for typed not-found refusals.",
      "enum": [
        "draft",
        "draft-revision",
        "validated-draft",
        "report"
      ],
      "type": "string"
    },
    "SaveFlowDraft": {
      "additionalProperties": false,
      "description": "Save one flow draft document under optimistic revision control.",
      "properties": {
        "definition": {
          "description": "Exact UTF-8 flow document text, stored byte-for-byte. Save does not parse or validate it, so a half-finished edit is preserved rather than refused; [`AuthoringCommand::Validate`] owns that boundary.",
          "type": "string"
        },
        "draft-id": {
          "type": "string"
        },
        "expected-revision": {
          "description": "Zero creates a draft; a positive value replaces exactly that revision.",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0.0,
          "type": "integer"
        },
        "flow-id": {
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/definitions/CommitProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional source attribution. Omitting it is always allowed and always equivalent in outcome."
        },
        "scope": {
          "$ref": "#/definitions/AuthoringScope"
        }
      },
      "required": [
        "definition",
        "draft-id",
        "expected-revision",
        "flow-id",
        "scope"
      ],
      "type": "object"
    },
    "ValidateDraft": {
      "additionalProperties": false,
      "description": "Validate one exact saved draft revision.",
      "properties": {
        "draft": {
          "$ref": "#/definitions/DraftRevisionRef"
        },
        "scope": {
          "$ref": "#/definitions/AuthoringScope"
        }
      },
      "required": [
        "draft",
        "scope"
      ],
      "type": "object"
    },
    "ValidatedDraftIdentity": {
      "additionalProperties": false,
      "description": "Public pins for the exact executable accepted by validation.",
      "properties": {
        "artifact-hash": {
          "type": "string"
        },
        "catalog": {
          "$ref": "#/definitions/CatalogIdentity"
        },
        "draft": {
          "$ref": "#/definitions/DraftIdentity"
        },
        "environment": {
          "type": "string"
        },
        "execution-bundle-hash": {
          "type": "string"
        },
        "runtime-flow-version": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "validated-draft-id": {
          "type": "string"
        }
      },
      "required": [
        "artifact-hash",
        "catalog",
        "draft",
        "environment",
        "execution-bundle-hash",
        "runtime-flow-version",
        "validated-draft-id"
      ],
      "type": "object"
    },
    "ValidatedDraftRef": {
      "additionalProperties": false,
      "description": "An opaque reference to the exact validated executable.",
      "properties": {
        "validated-draft-id": {
          "type": "string"
        }
      },
      "required": [
        "validated-draft-id"
      ],
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "description": "Machine-readable validation issue; `message` is explanatory only.",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/ValidationSeverity"
        }
      },
      "required": [
        "code",
        "message",
        "path",
        "severity"
      ],
      "type": "object"
    },
    "ValidationSeverity": {
      "enum": [
        "error",
        "warning"
      ],
      "type": "string"
    }
  },
  "description": "A complete request or response document on the authoring contract.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/definitions/AuthoringRequest"
        },
        "document": {
          "enum": [
            "request"
          ],
          "type": "string"
        }
      },
      "required": [
        "body",
        "document"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/definitions/AuthoringResponse"
        },
        "document": {
          "enum": [
            "response"
          ],
          "type": "string"
        }
      },
      "required": [
        "body",
        "document"
      ],
      "type": "object"
    }
  ],
  "title": "AuthoringDocument"
}
