# Schema-first request collection for authoring-surface.schema.json version 0.1.
#
# The caller supplies the complete adapter endpoint and one principal's bearer
# token. Neither value has a checked-in default. The POST method is this
# collection's runner convention, not an additional route contract.
#
# CLI naming: `promote` sends the public schema command `publish`.

### save-flow-draft
POST {{$processEnv WAMN_AUTHORING_ENDPOINT}}
Authorization: Bearer {{$processEnv WAMN_AUTHORING_BEARER_TOKEN}}
Accept: application/json
Content-Type: application/json

{
  "document": "request",
  "body": {
    "schema-version": "0.1",
    "command-id": "save-receiving-draft-3",
    "command": {
      "kind": "save-flow-draft",
      "input": {
        "scope": {
          "project-id": "receiving",
          "environment": "dev"
        },
        "draft-id": "draft-receiving",
        "flow-id": "receive-material",
        "expected-revision": 2,
        "definition": "{\"schema-version\":\"0.1\",\"flow-id\":\"receive-material\",\"version\":4,\"nodes\":[{\"id\":\"request\",\"type\":\"request\",\"config\":{\"input-schema\":true}},{\"id\":\"respond\",\"type\":\"respond\",\"config\":{\"status\":200}}],\"edges\":[{\"from\":\"request\",\"to\":\"respond\"}]}",
        "provenance": {
          "commit": "0123456789abcdef0123456789abcdef01234567",
          "ref": "refs/heads/main",
          "dirty": false
        }
      }
    }
  }
}

