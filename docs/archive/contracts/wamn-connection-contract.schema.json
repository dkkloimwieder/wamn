{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "$ref": "#/definitions/ConnectionTypeDescriptor"
    }
  ],
  "definitions": {
    "ConnectionAuthorityModel": {
      "description": "The authority interpretation fixed by a connection type.",
      "enum": [
        "http-origin"
      ],
      "type": "string"
    },
    "ConnectionField": {
      "description": "A field whose ownership is fixed by a connection-type descriptor.",
      "enum": [
        "method",
        "relative-target",
        "headers",
        "body",
        "authority",
        "tls",
        "redirect",
        "proxy",
        "credential"
      ],
      "type": "string"
    },
    "ConnectionFieldOwner": {
      "description": "The principal allowed to supply one connection field.",
      "enum": [
        "author",
        "environment",
        "system"
      ],
      "type": "string"
    },
    "ConnectionFieldOwnership": {
      "additionalProperties": false,
      "description": "Canonical ownership for one connection field.",
      "properties": {
        "field": {
          "$ref": "#/definitions/ConnectionField"
        },
        "owner": {
          "$ref": "#/definitions/ConnectionFieldOwner"
        }
      },
      "required": [
        "field",
        "owner"
      ],
      "type": "object"
    },
    "ConnectionTypeDescriptor": {
      "additionalProperties": false,
      "description": "Versioned portable semantics for one connection type.",
      "properties": {
        "authority-model": {
          "$ref": "#/definitions/ConnectionAuthorityModel"
        },
        "contract": {
          "type": "string"
        },
        "credential-injection": {
          "$ref": "#/definitions/CredentialInjection"
        },
        "descriptor-version": {
          "type": "string"
        },
        "field-ownership": {
          "items": {
            "$ref": "#/definitions/ConnectionFieldOwnership"
          },
          "type": "array"
        },
        "requirement-type": {
          "type": "string"
        }
      },
      "required": [
        "authority-model",
        "contract",
        "credential-injection",
        "descriptor-version",
        "field-ownership",
        "requirement-type"
      ],
      "type": "object"
    },
    "CredentialInjection": {
      "description": "How environment-owned credentials enter a request.",
      "enum": [
        "environment-selected-http-header"
      ],
      "type": "string"
    }
  },
  "title": "ConnectionContractDocument"
}
