{
  "schema-version": "wamn-node-cases/v0",
  "cases": [
    {
      "name": "severe-recommendation-does-not-match-accept",
      "input": {
        "hold": {
          "material": "resin-A",
          "moisture_pct": "12.00",
          "moisture_max_pct": "5.00"
        },
        "history": [],
        "decision": "accept"
      },
      "expect": {
        "ok": {
          "value": {
            "recommendation": "reject",
            "confidence": "0.80",
            "matched": false
          },
          "match": "exact"
        }
      }
    },
    {
      "name": "mild-recommendation-matches-use-as-is",
      "input": {
        "hold": {
          "material": "resin-A",
          "moisture_pct": "6.00",
          "moisture_max_pct": "5.00"
        },
        "history": [],
        "decision": "use-as-is"
      },
      "expect": {
        "ok": {
          "value": {
            "recommendation": "use-as-is",
            "confidence": "0.50",
            "matched": true
          },
          "match": "exact"
        }
      }
    },
    {
      "name": "in-spec-recommendation-matches-accept",
      "input": {
        "hold": {
          "material": "resin-A",
          "moisture_pct": "4.00",
          "moisture_max_pct": "5.00"
        },
        "history": [],
        "decision": "accept"
      },
      "expect": {
        "ok": {
          "value": {
            "recommendation": "accept",
            "confidence": "0.70",
            "matched": true
          },
          "match": "exact"
        }
      }
    },
    {
      "name": "history-support-retains-two-decimal-string-confidence",
      "input": {
        "hold": {
          "material": "resin-A",
          "moisture_pct": "12.00",
          "moisture_max_pct": "5.00"
        },
        "history": [
          { "decision": "reject" },
          { "decision": "accept" }
        ],
        "decision": "reject"
      },
      "expect": {
        "ok": {
          "value": {
            "recommendation": "reject",
            "confidence": "0.88",
            "matched": true
          },
          "match": "exact"
        }
      }
    },
    {
      "name": "old-shape-without-decision-is-invalid-input",
      "input": {
        "hold": {
          "material": "resin-A",
          "moisture_pct": "6.00",
          "moisture_max_pct": "5.00"
        },
        "history": []
      },
      "expect": { "error": "invalid-input" }
    },
    {
      "name": "unknown-decision-is-invalid-input",
      "input": {
        "hold": {
          "material": "resin-A",
          "moisture_pct": "6.00",
          "moisture_max_pct": "5.00"
        },
        "history": [],
        "decision": "approve"
      },
      "expect": { "error": "invalid-input" }
    },
    {
      "name": "malformed-hold-is-invalid-input",
      "input": {
        "hold": {
          "material": "resin-A",
          "moisture_pct": "not-a-decimal",
          "moisture_max_pct": "5.00"
        },
        "history": [],
        "decision": "accept"
      },
      "expect": { "error": "invalid-input" }
    }
  ]
}
