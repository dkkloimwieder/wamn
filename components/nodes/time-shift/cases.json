{
  "schema-version": "wamn-node-cases/v0",
  "cases": [
    {
      "name": "f3-shifts-scheduled-at-back-48-hours",
      "config": { "base": "scheduled-at", "offset-ms": -172800000, "format": "iso" },
      "input": { "scheduled-at": "2023-11-14T22:13:20Z", "fired-at": "2023-11-14T22:13:23Z" },
      "expect": { "ok": { "value": { "cutoff": "2023-11-12T22:13:20Z" }, "match": "exact" } }
    },
    {
      "name": "timezone-normalizes-to-utc",
      "config": { "base": "scheduled-at", "offset-ms": 250, "key": "shifted" },
      "input": { "scheduled-at": "2024-03-10T01:59:59.875-05:00" },
      "expect": { "ok": { "value": { "shifted": "2024-03-10T07:00:00.125Z" }, "match": "exact" } }
    },
    {
      "name": "malformed-rfc3339-is-invalid-input",
      "config": { "base": "scheduled-at", "offset-ms": 0 },
      "input": { "scheduled-at": "2024-02-30T00:00:00Z" },
      "expect": { "error": "invalid-input" }
    },
    {
      "name": "upper-boundary-overflow-is-terminal",
      "config": { "base": "scheduled-at", "offset-ms": 1 },
      "input": { "scheduled-at": "9999-12-31T23:59:59.999Z" },
      "expect": { "error": "terminal" }
    },
    {
      "name": "lower-boundary-underflow-is-terminal",
      "config": { "base": "scheduled-at", "offset-ms": -1 },
      "input": { "scheduled-at": "0000-01-01T00:00:00Z" },
      "expect": { "error": "terminal" }
    }
  ]
}
