package wamn:flow-http-routing@0.1.0;

/// Authoritative HTTP definition lookup and selected-policy authentication.
///
/// The provider projects routes from the process's welded serving manifest.
interface routing {
  record header {
    name: string,
    value: string,
  }

  enum mapping-source {
    body,
    path,
    query,
    header,
  }

  enum cardinality {
    one,
    many,
  }

  record mapping {
    %from: mapping-source,
    name: string,
    to: string,
    optional: bool,
    cardinality: cardinality,
  }

  record route-definition {
    attachment-id: string,
    host: string,
    path: string,
    method: string,
    auth-policy: string,
    mappings: list<mapping>,
    input-schema: string,
    body-limit: u64,
    mapped-limit: u64,
  }

  record auth-rejection {
    status: u16,
    code: string,
  }

  /// Return route definitions carried by this process's release.
  routes: func(method: string, authority: string) -> result<list<route-definition>, string>;

  /// Authenticate only after route selection has supplied the policy.
  authenticate: func(policy: string, headers: list<header>) -> result<string, auth-rejection>;
}
