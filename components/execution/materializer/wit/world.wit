package wamn:materializer@0.1.0;

/// The Service-first materializer (EVT-MAT, D19 v3 §5 / l5i9.17): a
/// wasi:cli/run SERVICE workload (CRD `spec.service`) — the first importer of
/// `wamn:jetstream` — that delivers CDC row events through released wirings.
///
/// Each registration chooses event-at-a-time or one ordered fetch batch. The
/// guest calls the host-owned router bridge with only the registration id; the
/// host re-resolves its exact wiring target from the carried release. Source
/// messages are acknowledged only after a successful terminal router outcome.
///
/// The event-plane NATS connection, database credential, release manifest,
/// wiring coordinates, router, and component pools remain host-owned.
world materializer {
  import wamn:postgres/types@0.1.0;
  import wamn:postgres/client@0.1.0;
  import wamn:jetstream/types@0.1.0;
  import wamn:jetstream/consumer@0.1.0;
  import wamn:router-delivery/delivery@0.1.0;
}
