package wamn:flowrunner@0.1.0;

/// Single-shot execution of one admitted run.
///
/// The runner executes the run's immutable plan from start to finish in memory.
/// Queue ownership, resolution supply, and effect authority are host concerns;
/// legacy operational helpers are not part of this product world.
world flowrunner {
  import wamn:postgres/types@0.1.0;
  import wamn:postgres/client@0.1.0;
  import wamn:runner/causation@0.1.0;
  import wamn:runner/http-effect@0.1.0;
  import wasi:logging/logging@0.1.0-draft;

  export run: func(run-id: string, payload: string) -> result<u32, string>;
}
