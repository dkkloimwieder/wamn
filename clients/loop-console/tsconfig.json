{
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts", "vitest-setup.ts", "vitest.config.ts"]
}
