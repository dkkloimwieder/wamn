{
  "inventory-move-http": {
    "kind": "http",
    "package-id": "wamn_wms",
    "wiring-id": "inventory_move_and_label",
    "wiring-version": 1,
    "definition-hash": "sha256:e828d1908ab670d3c36a8eb9d4c50d737645f3f84f3c0629659f6425f0af26a2",
    "definition": {
      "id": "inventory-move-http",
      "kind": "http",
      "route": {
        "path": "/inventory/move",
        "method": "POST"
      },
      "raw-body-bytes": {
        "maximum": 1048576
      },
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "request_id",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "object",
              "required": [
                "idempotency_key",
                "pallet_id",
                "to_location_id",
                "expected_row_version",
                "occurred_at"
              ],
              "additionalProperties": false,
              "properties": {
                "idempotency_key": {
                  "type": "string",
                  "minLength": 1
                },
                "pallet_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "to_location_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "expected_row_version": {
                  "type": "integer",
                  "minimum": 1
                },
                "occurred_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    },
    "auth-policy": {
      "mode": "pat"
    },
    "registered-operation": "wamn-wms:inventory/move@1.0.0"
  }
}
