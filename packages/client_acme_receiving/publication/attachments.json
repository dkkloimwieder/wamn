{
  "client-acme-receiving-purchase-order-get-http": {
    "kind": "http",
    "package-id": "client_acme_receiving",
    "wiring-id": "purchase_order_get",
    "wiring-version": 1,
    "definition-hash": "sha256:155964d242ac6a831e67a57af5a0e9a6d7a48184c886f29ec2589f563ebda715",
    "definition": {
      "id": "client-acme-receiving-purchase-order-get-http",
      "kind": "http",
      "route": {"path": "/acme/purchase_order/get", "method": "POST"},
      "raw-body-bytes": {"maximum": 1048576},
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": ["request_id", "id"],
          "additionalProperties": false,
          "properties": {
            "request_id": {"type": "string", "minLength": 1},
            "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
          }
        }
      }
    },
    "auth-policy": {"mode": "pat"},
    "registered-operation": "client-acme-receiving:purchase-order/get@3.0.0"
  },
  "client-acme-receiving-purchase-order-update-http": {
    "kind": "http",
    "package-id": "client_acme_receiving",
    "wiring-id": "purchase_order_update",
    "wiring-version": 1,
    "definition-hash": "sha256:077fe760dc3c65136ca31e9642f671cf5e5ce02b88a0a05108d56a2178c7f8b9",
    "definition": {
      "id": "client-acme-receiving-purchase-order-update-http",
      "kind": "http",
      "route": {"path": "/acme/purchase_order/update", "method": "POST"},
      "raw-body-bytes": {"maximum": 1048576},
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": ["request_id", "id", "expected_row_version", "change"],
          "additionalProperties": false,
          "properties": {
            "request_id": {"type": "string", "minLength": 1},
            "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
            "expected_row_version": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)$"},
            "change": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "acme_inspection_required": {
                  "type": ["boolean", "null"],
                  "x-wamn-explicit-null": "invalid_input"
                },
                "acme_quality_status": {
                  "type": ["string", "null"],
                  "enum": ["not_required", "pending", "approved", null],
                  "x-wamn-explicit-null": "invalid_input"
                }
              }
            }
          }
        }
      }
    },
    "auth-policy": {"mode": "pat"},
    "registered-operation": "client-acme-receiving:purchase-order/update@3.0.0"
  },
  "client-acme-receiving-receiving-record-receipt-http": {
    "kind": "http",
    "package-id": "client_acme_receiving",
    "wiring-id": "receiving_record_receipt",
    "wiring-version": 1,
    "definition-hash": "sha256:2e0c1a505b894b406fdfd8114ffae32fbf130813bb0de11487930a0e53e00c60",
    "definition": {
      "id": "client-acme-receiving-receiving-record-receipt-http",
      "kind": "http",
      "route": {"path": "/acme/receiving/record_receipt", "method": "POST"},
      "raw-body-bytes": {"maximum": 1048576},
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": ["request_id", "value"],
          "additionalProperties": false,
          "properties": {
            "request_id": {"type": "string", "minLength": 1},
            "value": {
              "type": "object",
              "required": ["idempotency_key", "purchase_order_id", "receipt_reference", "occurred_at", "line"],
              "additionalProperties": false,
              "properties": {
                "idempotency_key": {"type": "string", "minLength": 1},
                "purchase_order_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
                "receipt_reference": {"type": "string", "minLength": 1},
                "occurred_at": {"type": "string"},
                "line": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "required": ["purchase_order_line_id", "quantity", "location_id"],
                    "additionalProperties": false,
                    "properties": {
                      "purchase_order_line_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
                      "quantity": {"type": "string"},
                      "location_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "auth-policy": {"mode": "pat"},
    "registered-operation": "client-acme-receiving:receiving/record-receipt@3.0.0"
  },
