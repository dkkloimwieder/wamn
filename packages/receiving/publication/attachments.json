{
  "purchase-order-get-http": {
    "kind": "http",
    "package-id": "wamn_receiving",
    "wiring-id": "purchase_order_get",
    "wiring-version": 1,
    "definition-hash": "sha256:6c71b033475231b73e178a4ec2a45861d73816bb065150ea16130ff56f934157",
    "definition": {
      "id": "purchase-order-get-http",
      "kind": "http",
      "route": {"host": "receiving.localhost.direct", "path": "/purchase_order/get", "method": "POST"},
      "raw-body-bytes": {"maximum": 1048576},
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": ["request_id", "id"],
          "additionalProperties": false,
          "properties": {
            "request_id": {"type": "string", "minLength": 1},
            "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
          }
        }
      }
    },
    "auth-policy": {"mode": "pat"},
    "registered-operation": "wamn_receiving@1.0.0::purchase_order.get"
  },
  "purchase-order-query-http": {
    "kind": "http",
    "package-id": "wamn_receiving",
    "wiring-id": "purchase_order_query",
    "wiring-version": 1,
    "definition-hash": "sha256:48d21ae7caca5bc71d837d5294fbe49d923b9a8d5b876b50615cc1f662420a98",
    "definition": {
      "id": "purchase-order-query-http",
      "kind": "http",
      "route": {"host": "receiving.localhost.direct", "path": "/purchase_order/query", "method": "POST"},
      "raw-body-bytes": {"maximum": 1048576},
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": ["request_id"],
          "additionalProperties": false,
          "properties": {
            "request_id": {"type": "string", "minLength": 1},
            "filter": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "supplier_id": {"type": "array", "items": {"type": "string"}},
                "status": {"type": "array", "items": {"enum": ["open", "complete", "cancelled"]}}
              }
            },
            "sort": {
              "type": "object",
              "required": ["field", "direction"],
              "additionalProperties": false,
              "properties": {
                "field": {"enum": ["purchase_order_number", "status", "created_at"]},
                "direction": {"enum": ["ascending", "descending"]}
              }
            },
            "cursor": {"type": "string", "minLength": 1},
            "limit": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        }
      }
    },
    "auth-policy": {"mode": "pat"},
    "registered-operation": "wamn_receiving@1.0.0::purchase_order.query"
  },
  "purchase-order-update-http": {
    "kind": "http",
    "package-id": "wamn_receiving",
    "wiring-id": "purchase_order_update",
    "wiring-version": 1,
    "definition-hash": "sha256:99fd57332ee3b4a862a41b52fdcb28350378be123e16e84ebb0e2ee2478a62bf",
    "definition": {
      "id": "purchase-order-update-http",
      "kind": "http",
      "route": {"host": "receiving.localhost.direct", "path": "/purchase_order/update", "method": "POST"},
      "raw-body-bytes": {"maximum": 1048576},
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": ["request_id", "id", "expected_row_version", "change"],
          "additionalProperties": false,
          "properties": {
            "request_id": {"type": "string", "minLength": 1},
            "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
            "expected_row_version": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)$"},
            "change": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "supplier_id": {"type": ["string", "null"], "x-wamn-explicit-null": "invalid_input"}
              }
            }
          }
        }
      }
    },
    "auth-policy": {"mode": "pat"},
    "registered-operation": "wamn_receiving@1.0.0::purchase_order.update"
  },
