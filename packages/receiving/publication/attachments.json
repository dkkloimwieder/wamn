  "receiving-record-receipt-http": {
    "kind": "http",
    "package-id": "wamn_receiving",
    "wiring-id": "receiving_record_receipt",
    "wiring-version": 1,
    "definition-hash": "sha256:b05c845d10f8eb8302cab1fdc4a750b25e6a279b30bb75dcaa1402ec4aec71e7",
    "definition": {
      "id": "receiving-record-receipt-http",
      "kind": "http",
      "route": {"host": "receiving.localhost.direct", "path": "/receiving/record_receipt", "method": "POST"},
      "raw-body-bytes": {"maximum": 1048576},
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": ["request_id", "value"],
          "additionalProperties": false,
          "properties": {
            "request_id": {"type": "string", "minLength": 1},
            "value": {
              "type": "object",
              "required": ["idempotency_key", "purchase_order_id", "receipt_reference", "occurred_at", "line"],
              "additionalProperties": false,
              "properties": {
                "idempotency_key": {"type": "string", "minLength": 1},
                "purchase_order_id": {"type": "string"},
                "receipt_reference": {"type": "string", "minLength": 1},
                "occurred_at": {"type": "string"},
                "line": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "required": ["purchase_order_line_id", "quantity", "location_id"],
                    "additionalProperties": false,
                    "properties": {
                      "purchase_order_line_id": {"type": "string"},
                      "quantity": {"type": "string"},
                      "location_id": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "auth-policy": {"mode": "pat"},
    "registered-operation": "wamn_receiving@1.0.0::receiving.record_receipt"
  }
