    "wiring-version": 1,
    "definition-hash": "sha256:aa3411356694d4a6a224d42ca6b34bc9f28cfd88f5a07aa53fd61bb87f2bbba1",
    "definition": {
      "id": "purchase-order-get-http",
      "kind": "http",
      "route": {
        "path": "/purchase_order/get",
        "method": "POST"
      },
      "raw-body-bytes": {
        "maximum": 1048576
      },
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "request_id",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        }
      }
    },
    "auth-policy": {
      "mode": "pat"
    },
    "registered-operation": "wamn-receiving:purchase-order/get@1.0.0"
  },
  "purchase-order-query-http": {
    "kind": "http",
    "package-id": "wamn_receiving",
    "wiring-id": "purchase_order_query",
    "wiring-version": 1,
    "definition-hash": "sha256:f778f59783fd49fc1afc00d733fb068b4f43f161dffac4aa0eb21ae7f448cc0a",
    "definition": {
      "id": "purchase-order-query-http",
      "kind": "http",
      "route": {
        "path": "/purchase_order/query",
        "method": "POST"
      },
      "raw-body-bytes": {
        "maximum": 1048576
      },
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "request_id"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "filter": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "supplier_id": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "status": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "open",
                      "complete",
                      "cancelled"
                    ]
                  }
                }
              }
            },
            "sort": {
              "type": "object",
              "required": [
                "field",
                "direction"
              ],
              "additionalProperties": false,
              "properties": {
                "field": {
                  "enum": [
                    "purchase_order_number",
                    "status",
                    "created_at"
                  ]
                },
                "direction": {
                  "enum": [
                    "ascending",
                    "descending"
                  ]
                }
              }
            },
            "cursor": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    },
    "auth-policy": {
      "mode": "pat"
    },
    "registered-operation": "wamn-receiving:purchase-order/query@1.0.0"
  },
  "purchase-order-update-http": {
    "kind": "http",
    "package-id": "wamn_receiving",
    "wiring-id": "purchase_order_update",
    "wiring-version": 1,
    "definition-hash": "sha256:9ded5b10c3e29a6ab36b7add270a41010a619adf6e05df449683063994173847",
    "definition": {
      "id": "purchase-order-update-http",
      "kind": "http",
      "route": {
        "path": "/purchase_order/update",
        "method": "POST"
      },
      "raw-body-bytes": {
        "maximum": 1048576
      },
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "request_id",
            "id",
            "expected_row_version",
            "change"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "expected_row_version": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            },
            "change": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "supplier_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-wamn-explicit-null": "invalid_input"
                }
              }
            }
          }
        }
      }
    },
    "auth-policy": {
      "mode": "pat"
    },
    "registered-operation": "wamn-receiving:purchase-order/update@1.0.0"
  },
