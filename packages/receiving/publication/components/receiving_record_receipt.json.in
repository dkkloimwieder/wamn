{
  "scope": {
    "tenant-id": "__TENANT_ID__",
    "package-id": "wamn_receiving",
    "package-version": "1.0.0"
  },
  "component": "receiving_record_receipt",
  "interface-version": "0.1.0",
  "operation": "run",
  "registered-operation": "wamn_receiving@1.0.0::receiving.record_receipt",
  "input-ports": [{
    "name": "input",
    "schema": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["request_id", "value"],
        "additionalProperties": false,
        "properties": {
          "request_id": {"type": "string", "minLength": 1},
          "value": {
            "type": "object",
            "required": ["idempotency_key", "purchase_order_id", "receipt_reference", "occurred_at", "line"],
            "additionalProperties": false,
            "properties": {
              "idempotency_key": {"type": "string", "minLength": 1},
              "purchase_order_id": {"type": "string"},
              "receipt_reference": {"type": "string", "minLength": 1},
              "occurred_at": {"type": "string"},
              "line": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "required": ["purchase_order_line_id", "quantity", "location_id"],
                  "additionalProperties": false,
                  "properties": {
                    "purchase_order_line_id": {"type": "string"},
                    "quantity": {"type": "string"},
                    "location_id": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }],
  "output-ports": [{"name": "main", "schema": {"type": "array"}}],
  "parameters": [],
  "connections": []
}
