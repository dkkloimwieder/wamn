{
  "scope": {
    "tenant-id": "__TENANT_ID__",
    "package-id": "wamn_receiving",
    "package-version": "1.0.0"
  },
  "component": "purchase_order_query",
  "interface-version": "0.1.0",
  "operation": "run",
  "registered-operation": "wamn_receiving@1.0.0::purchase_order.query",
  "input-ports": [{
    "name": "input",
    "schema": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["request_id"],
        "additionalProperties": false,
        "properties": {
          "request_id": {"type": "string", "minLength": 1},
          "filter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "supplier_id": {"type": "array", "items": {"type": "string"}},
              "status": {"type": "array", "items": {"enum": ["open", "complete", "cancelled"]}}
            }
          },
          "sort": {
            "type": "object",
            "required": ["field", "direction"],
            "additionalProperties": false,
            "properties": {
              "field": {"enum": ["purchase_order_number", "status", "created_at"]},
              "direction": {"enum": ["ascending", "descending"]}
            }
          },
          "cursor": {"type": "string", "minLength": 1},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100}
        }
      }
    }
  }],
  "output-ports": [{"name": "main", "schema": {"type": "array"}}],
  "parameters": [],
  "connections": []
}
