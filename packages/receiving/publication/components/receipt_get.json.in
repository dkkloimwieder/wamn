{
  "scope": {
    "tenant-id": "__TENANT_ID__",
    "package-id": "wamn_receiving",
    "package-version": "1.0.0"
  },
  "component": "receipt_get",
  "interface-version": "0.1.0",
  "operation": "run",
  "registered-operation": "wamn_receiving@1.0.0::receipt.get",
  "input-ports": [{
    "name": "input",
    "schema": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["request_id", "id"],
        "additionalProperties": false,
        "properties": {
          "request_id": {"type": "string", "minLength": 1},
          "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
        }
      }
    }
  }],
  "output-ports": [{"name": "main", "schema": {"type": "array"}}],
  "parameters": [],
  "connections": []
}
