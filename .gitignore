
.env
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Rust build artifacts, and the wamn build output under apps/target/wamn
/target
/apps/target
/apps/platform/no-std/target
*.wasm
# The wamn build output of a test fixture package
**/target/wamn/

# Temporary acceptance output
/evidence/

# Client workspace artifacts
/node_modules/
node_modules/

# bv (beads viewer) local config and caches
.bv/

# Per-lane wave logs. Parallel lanes all resolve the same scratchpad directory,
# so a conventional filename there is silently overwritten by another lane and
# a lane reads a false red out of someone else's tree (wamn-usck, measured in
# wave 54 at ~20 minutes lost). Lanes run in isolated worktrees, so a path
# inside the worktree is unique by construction rather than by convention.
.lane-logs/

# Checksum-pinned local command-line tools
/.tools/

# Local agent logs and scratch files.
scratchpad/
.beads/interactions.jsonl

# Generated clients inside their consuming package
/web/sync-bench/src/generated/
/apps/wamn_receiving/web/src/generated/
