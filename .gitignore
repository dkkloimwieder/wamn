
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Rust build artifacts
/target
/components/target
/components/no-std/target
*.wasm

# Client workspace artifacts
/node_modules/
/clients/*/node_modules/
/clients/*/dist/

# bv (beads viewer) local config and caches
.bv/

# Per-lane wave logs. Parallel lanes all resolve the same scratchpad directory,
# so a conventional filename there is silently overwritten by another lane and
# a lane reads a false red out of someone else's tree (wamn-usck, measured in
# wave 54 at ~20 minutes lost). Lanes run in isolated worktrees, so a path
# inside the worktree is unique by construction rather than by convention.
.lane-logs/
