{
  "schema_version": "0.1",
  "wash_runtime": {
    "cargo_tree_root": "wash-runtime v2.8.0 (https://github.com/dkkloimwieder/wasmCloud?rev=735b57982545358409a7d965a22549b08487ca09#735b5798)",
    "default_features": false
  },
  "live_store_paths": [
    "runtime: new_store_from_templates (single production site)",
    "wamn: ExecutionHost store (crates/execution/host)"
  ],
  "consumers": [
    {
      "package": "wamn-ctl",
      "manifest": "services/ctl/Cargo.toml",
      "features": [
        "oci",
        "washlet"
      ]
    },
    {
      "package": "wamn-executor",
      "manifest": "services/executor/Cargo.toml",
      "features": [
        "oci",
        "washlet",
        "wasm_component_model_implements"
      ]
    },
    {
      "package": "wamn-host",
      "manifest": "services/host/Cargo.toml",
      "features": [
        "oci",
        "wasi-config",
        "wasi-otel",
        "washlet",
        "wasm_component_model_implements"
      ]
    },
    {
      "package": "wamn-scenario-worker",
      "manifest": "services/scenario-worker/Cargo.toml",
      "features": [
        "oci"
      ]
    }
  ],
  "workload_manifests": [
    {
      "path": "deploy/platform/http-route-workload.example.yaml",
      "deployment_state": "template",
      "abi": "p2-components"
    },
    {
      "path": "deploy/platform/materializer.example.yaml",
      "deployment_state": "template",
      "abi": "p2-cli-service",
      "abi_evidence": {
        "path": "components/execution/materializer/Cargo.toml",
        "required_marker": "# A COMMAND component (wasi:cli/run via `main`), not a cdylib"
      }
    }
  ]
}
