{
  "schema_version": "0.1",
  "wash_runtime": {
    "cargo_tree_root": "wash-runtime v2.7.0 (https://github.com/dkkloimwieder/wasmCloud?rev=daba602901507338e99f277e07a8e923c61dc557#daba6029)",
    "default_features": false
  },
  "live_store_paths": [
    "fork: new_store_from_templates (single production site)",
    "wamn: ExecutionHost store (crates/execution/host)"
  ],
  "consumers": [
    {
      "package": "wamn-executor",
      "manifest": "services/executor/Cargo.toml",
      "features": [
        "oci",
        "washlet"
      ]
    },
    {
      "package": "wamn-host",
      "manifest": "services/host/Cargo.toml",
      "features": [
        "oci",
        "wasi-config",
        "wasi-otel",
        "washlet"
      ]
    },
    {
      "package": "wamn-scenario-worker",
      "manifest": "services/scenario-worker/Cargo.toml",
      "features": []
    }
  ],
  "workload_manifests": [
    {
      "path": "deploy/platform/flow-http-workload.example.yaml",
      "deployment_state": "template",
      "abi": "p2-components"
    },
    {
      "path": "deploy/platform/materializer.example.yaml",
      "deployment_state": "template",
      "abi": "p2-cli-service",
      "abi_evidence": {
        "path": "components/execution/materializer/Cargo.toml",
        "required_marker": "# A COMMAND component (wasi:cli/run via `main`), not a cdylib"
      }
    }
  ]
}
