{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@wamn/web-runtime": ["../runtime/src/index.ts"],
      "@wamn/ui": ["../ui/src/index.ts"],
      "solid-js": ["./node_modules/solid-js"],
      "solid-js/*": ["./node_modules/solid-js/*"],
      "@tanstack/solid-table": ["./node_modules/@tanstack/solid-table"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "stubs/**/*.ts", "test/**/*.ts", "test/**/*.tsx", "fixture/**/*.ts", "fixture/**/*.tsx"]
}
