{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@wamn/web-runtime": ["../runtime/src/index.ts"],
      "@wamn/ui": ["../ui/src/index.ts"],
      "@wamn/ui/admin": ["../ui/src/admin/index.ts"],
      "@wamn/control-client": ["../../target/wamn/wamn_control/client-ts/index.ts"],
      "@wamn/control-org-client": ["../../target/wamn/wamn_control/control/client-ts/index.ts"],
      "solid-js": ["./node_modules/solid-js"],
      "solid-js/*": ["./node_modules/solid-js/*"],
      "@tanstack/solid-table": ["./node_modules/@tanstack/solid-table"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "stubs/**/*.ts",
    "gallery/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "fixture/**/*.ts",
    "fixture/**/*.tsx"
  ]
}
