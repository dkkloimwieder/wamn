{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@wamn/web-runtime": ["../runtime/src/index.ts"],
      "@wamn/ui": ["../ui/src/index.ts"],
      "@wamn/ui/admin": ["../ui/src/admin/index.ts"],
      "@wamn/control-client": ["../../target/wamn/wamn_control/client-ts/index.ts"],
      "@wamn/control-org-client": ["../../target/wamn/wamn_control/control/client-ts/index.ts"],
      "solid-js": ["./node_modules/solid-js"],
      "solid-js/*": ["./node_modules/solid-js/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx", "vite.ts", "vitest.config.ts"]
}
