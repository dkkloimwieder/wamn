{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": {
      "d3-shape": ["./node_modules/@types/d3-shape"],
      "@wamn/web-runtime": ["../runtime/src/index.ts"],
      "@wamn/wms-client": ["../../apps/target/wamn/wamn_wms/client-ts/index.ts"],
      "@wamn/wms-client/*": ["../../apps/target/wamn/wamn_wms/client-ts/*"],
      "solid-js": ["./node_modules/solid-js"],
      "@solidjs/web": ["./node_modules/@solidjs/web"],
      "@solidjs/web/*": ["./node_modules/@solidjs/web/*"]
    }
  },
  "include": ["src", "test", "vite.config.ts"]
}
