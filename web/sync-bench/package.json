{
  "name": "@wamn/sync-bench",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "pnpm --workspace-root run wfe:build && vite build",
    "check": "pnpm --workspace-root run wfe:build && tsc --project tsconfig.json",
    "test": "pnpm --workspace-root run wfe:build && vitest run",
    "bench": "pnpm --workspace-root run wfe:build && vite build && node bench/run.mjs"
  },
  "wamn": {
    "clients": [
      "wamn_wms"
    ]
  },
  "dependencies": {
    "@wamn/web-runtime": "workspace:*",
    "@tanstack/db": "0.15.2",
    "@wfe/components": "workspace:*",
    "@wfe/generator": "workspace:*",
    "@wfe/sync": "workspace:*",
    "@solidjs/web": "2.0.0-rc.18",
    "solid-js": "2.0.0-rc.18"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@types/d3-shape": "3.1.8",
    "@types/node": "^24.19.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.1.2",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
