+++ b/components/application/dock/src/appointment_book.rs
@@ -0,0 +1,343 @@
+//! `appointment.book` — the contended command.
+//!
+//! One carrier joined to one dock for one slot, transactionally, with the
+//! overlap rule enforced at the row that actually contends.
+//!
+//! # The shape of one item
+//!
+//! ```text
+//! canonicalize the body
+//! → find a replay: same key ⇒ return the ORIGINAL result, unchanged
+//! → claim the key, which pre-generates the appointment id
+//! → lock the dock            (the serialization point)
+//! → validate the carrier
+//! → probe the dock's day for an overlapping slot
+//! → insert the appointment
+//! → finalize the claim with the result
+//! ```
+//!
+//! THE LOCK IS THE OVERLAP RULE. Two bookings on one dock must not both pass
+//! the overlap probe by reading a state neither has written yet, and the dock
+//! row is what makes them serialize: the second transaction waits, then sees
+//! the first one's appointment. A PostgreSQL `EXCLUDE` constraint would hold
+//! the rule in the table instead, but its `dock_id` equality half needs the
+//! `btree_gist` operator class, and a package migration admits only ordinary
+//! `CREATE TABLE` and additive `ALTER TABLE`. The lock is the enforcement this
+//! package can own.
+
+use serde::Deserialize;
+use wamn_postgres_statements::{Connection, TimestampTz, Transaction, Uuid};
+
+use crate::error::{self, AccessError, AccessErrorKind};
+use crate::generated::wamn::appointment_book as sql;
+use crate::scalar;
+
+#[cfg(test)]
+pub(crate) const REFUSALS: &[AccessErrorKind] = &[
+    AccessErrorKind::InvalidInput,
+    AccessErrorKind::CarrierNotFound,
+    AccessErrorKind::DockNotFound,
+    AccessErrorKind::SlotUnavailable,
+    AccessErrorKind::IdempotencyConflict,
+    AccessErrorKind::Retry,
+    AccessErrorKind::Timeout,
+    AccessErrorKind::PermissionDenied,
+    AccessErrorKind::InternalError,
+];
+
+/// One envelope item's command body.
+#[derive(Debug, Deserialize)]
+pub(crate) struct BookCommand {
+    pub(crate) idempotency_key: String,
+    pub(crate) carrier_id: String,
+    pub(crate) dock_id: String,
+    pub(crate) slot_start: String,
+    pub(crate) slot_end: String,
+}
+
+/// What one accepted booking answers with.
+#[derive(Debug, Eq, PartialEq)]
+pub(crate) struct BookResult {
+    pub(crate) appointment_id: String,
+    pub(crate) status: String,
+}
+
+impl BookResult {
+    pub(crate) fn to_json(&self) -> serde_json::Value {
+        serde_json::json!({
+            "appointment_id": self.appointment_id,
+            "status": self.status,
+        })
+    }
+}
+
+/// The command's scalars in their one wire spelling.
+#[derive(Debug)]
+pub(crate) struct Parsed {
+    carrier_id: Uuid,
+    dock_id: Uuid,
+    slot_start: TimestampTz,
+    slot_end: TimestampTz,
+}
+
+fn parse(command: &BookCommand) -> Result<Parsed, AccessError> {
+    let parsed = Parsed {
+        carrier_id: scalar::uuid("value.carrier_id", &command.carrier_id)?,
+        dock_id: scalar::uuid("value.dock_id", &command.dock_id)?,
+        slot_start: scalar::timestamp("value.slot_start", &command.slot_start)?,
+        slot_end: scalar::timestamp("value.slot_end", &command.slot_end)?,
+    };
+    // A slot that does not end after it starts is not a slot, and the table's
+    // own check would report it as internal_error rather than as bad input.
+    // The canonical timestamp is fixed-width UTC RFC 3339, so its lexical
+    // order IS its chronological order and no second parse is needed.
+    if parsed.slot_start.0 >= parsed.slot_end.0 {
+        return Err(AccessError::field(
+            AccessErrorKind::InvalidInput,
+            "value.slot_end",
+        ));
+    }
+    Ok(parsed)
+}
+
+/// The bytes the idempotency key keys: the RE-SPELLED command, so two
+/// deliveries of one booking canonicalize alike whatever case or offset each
+/// was written in.
+pub(crate) fn canonical_command(parsed: &Parsed) -> Vec<u8> {
+    wamn_execution_contract::canonical_json_bytes(&serde_json::json!({
+        "carrier_id": parsed.carrier_id.0,
+        "dock_id": parsed.dock_id.0,
+        "slot_start": parsed.slot_start.0,
+        "slot_end": parsed.slot_end.0,
+    }))
+}
+
+/// Run one command item in exactly one transaction.
+///
+/// # Errors
+///
+/// [`AccessError`] carrying the literal and detail the operation contract
+/// declares for that refusal.
+pub(crate) async fn execute(command: &BookCommand) -> Result<BookResult, AccessError> {
+    let parsed = parse(command)?;
+    let canonical = canonical_command(&parsed);
+    let mut connection = Connection::new();
+    let mut transaction = connection
+        .begin()
+        .await
+        .map_err(|error| error::from_statement(&error))?;
+    match run(&mut transaction, command, &parsed, &canonical).await {
+        Ok(value) => {
+            transaction
+                .commit()
+                .await
+                .map_err(|error| error::from_statement(&error))?;
+            Ok(value)
+        }
+        Err(refusal) => {
+            let _ = transaction.rollback().await;
+            Err(refusal)
+        }
+    }
+}
+
+async fn run(
+    transaction: &mut Transaction,
+    command: &BookCommand,
+    parsed: &Parsed,
+    canonical: &[u8],
+) -> Result<BookResult, AccessError> {
+    // A REPLAY RETURNS THE ORIGINAL RESULT, unchanged, and writes nothing.
+    if let Some(replay) = sql::find_replay(transaction, command.idempotency_key.clone())
+        .await
+        .map_err(|error| error::from_statement(&error))?
+    {
+        if replay.canonical_command != canonical {
+            return Err(AccessError::field(
+                AccessErrorKind::IdempotencyConflict,
+                "value.idempotency_key",
+            ));
+        }
+        let Some(status) = replay.status else {
+            return Err(AccessError::bare(AccessErrorKind::Retry));
+        };
+        return Ok(BookResult {
+            appointment_id: replay.appointment_id.0,
+            status,
+        });
+    }
+
+    let claim = sql::claim_command(
+        transaction,
+        command.idempotency_key.clone(),
+        canonical.to_vec(),
+    )
+    .await
+    .map_err(|error| error::from_statement(&error))?
+    .ok_or_else(|| AccessError::bare(AccessErrorKind::Retry))?;
+
+    // THE SERIALIZATION POINT.
+    sql::lock_dock(transaction, parsed.dock_id.clone())
+        .await
+        .map_err(|error| error::from_statement(&error))?
+        .ok_or_else(|| {
+            AccessError::missing(
+                AccessErrorKind::DockNotFound,
+                "value.dock_id",
+                &parsed.dock_id.0,
+            )
+        })?;
+
+    sql::find_carrier(transaction, parsed.carrier_id.clone())
+        .await
+        .map_err(|error| error::from_statement(&error))?
+        .ok_or_else(|| {
+            AccessError::missing(
+                AccessErrorKind::CarrierNotFound,
+                "value.carrier_id",
+                &parsed.carrier_id.0,
+            )
+        })?;
+
+    // Two slots overlap when one starts before the other ends and ends after
+    // the other starts. The probe names the appointment already holding the
+    // dock, so a dispatcher can look at what it collided with.
+    if let Some(overlap) = sql::find_overlap(
+        transaction,
+        parsed.dock_id.clone(),
+        parsed.slot_start.clone(),
+        parsed.slot_end.clone(),
+    )
+    .await
+    .map_err(|error| error::from_statement(&error))?
+    {
+        return Err(AccessError::missing(
+            AccessErrorKind::SlotUnavailable,
+            "value.slot_start",
+            &overlap.id.0,
+        ));
+    }
+
+    let inserted = sql::insert_appointment(
+        transaction,
+        claim.appointment_id.clone(),
+        parsed.dock_id.clone(),
+        parsed.carrier_id.clone(),
+        parsed.slot_start.clone(),
+        parsed.slot_end.clone(),
+    )
+    .await
+    .map_err(|error| error::from_statement(&error))?;
+
+    let finalized = sql::finalize_command(
+        transaction,
+        command.idempotency_key.clone(),
+        canonical.to_vec(),
+        inserted.status.clone(),
+    )
+    .await
+    .map_err(|error| error::from_statement(&error))?;
+    if finalized.status.is_none() {
+        return Err(AccessError::bare(AccessErrorKind::Retry));
+    }
+
+    Ok(BookResult {
+        appointment_id: claim.appointment_id.0,
+        status: inserted.status,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn command(dock: &str, slot_start: &str, slot_end: &str) -> BookCommand {
+        BookCommand {
+            idempotency_key: "k".to_owned(),
+            carrier_id: "00000000-0000-0000-0000-0000000000c1".to_owned(),
+            dock_id: dock.to_owned(),
+            slot_start: slot_start.to_owned(),
+            slot_end: slot_end.to_owned(),
+        }
+    }
+
+    fn bytes(command: &BookCommand) -> Vec<u8> {
+        canonical_command(&parse(command).expect("the fixture parses"))
+    }
+
+    /// Two spellings of one booking are ONE command under the key: the
+    /// canonical bytes come from the respelled scalars, not the caller's.
+    #[test]
+    fn the_canonical_command_is_spelling_independent_and_excludes_the_key() {
+        let upper = command(
+            "00000000-0000-0000-0000-0000000000D1",
+            "2026-10-01T11:00:00+02:00",
+            "2026-10-01T12:00:00+02:00",
+        );
+        let lower = command(
+            "00000000-0000-0000-0000-0000000000d1",
+            "2026-10-01T09:00:00.000000Z",
+            "2026-10-01T10:00:00.000000Z",
+        );
+        let mut other_key = lower_fixture();
+        other_key.idempotency_key = "different".to_owned();
+        assert_eq!(bytes(&upper), bytes(&lower));
+        assert_eq!(bytes(&lower), bytes(&other_key));
+        assert!(
+            !String::from_utf8(bytes(&lower))
+                .unwrap()
+                .contains("idempotency_key")
+        );
+    }
+
+    fn lower_fixture() -> BookCommand {
+        command(
+            "00000000-0000-0000-0000-0000000000d1",
+            "2026-10-01T09:00:00Z",
+            "2026-10-01T10:00:00Z",
+        )
+    }
+
+    /// A booking that differs in WHAT it books is a different command.
+    #[test]
+    fn a_different_slot_is_a_different_command() {
+        let here = lower_fixture();
+        let there = command(
+            "00000000-0000-0000-0000-0000000000d1",
+            "2026-10-01T10:00:00Z",
+            "2026-10-01T11:00:00Z",
+        );
+        assert_ne!(bytes(&here), bytes(&there));
+    }
+
+    #[test]
+    fn an_unspellable_scalar_is_refused_before_any_statement() {
+        let dock = command("not-a-uuid", "2026-10-01T09:00:00Z", "2026-10-01T10:00:00Z");
+        assert_eq!(parse(&dock).unwrap_err().detail()["field"], "value.dock_id");
+        let slot = command(
+            "00000000-0000-0000-0000-0000000000d1",
+            "2026-10-01T09:00:00Z",
+            "tomorrow",
+        );
+        assert_eq!(
+            parse(&slot).unwrap_err().detail()["field"],
+            "value.slot_end"
+        );
+    }
+
+    /// A slot that ends before it starts, or at the moment it starts, is not a
+    /// slot: the input is refused rather than the table's check constraint.
+    #[test]
+    fn a_slot_must_end_after_it_starts() {
+        for (start, end) in [
+            ("2026-10-01T10:00:00Z", "2026-10-01T09:00:00Z"),
+            ("2026-10-01T09:00:00Z", "2026-10-01T09:00:00Z"),
+        ] {
+            let refused = command("00000000-0000-0000-0000-0000000000d1", start, end);
+            assert_eq!(
+                parse(&refused).unwrap_err().detail()["field"],
+                "value.slot_end"
+            );
+        }
+    }
+}
