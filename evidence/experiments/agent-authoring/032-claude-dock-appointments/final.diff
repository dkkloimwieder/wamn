@@ -0,0 +1,85 @@
+//! The wasm32 export surface: five operation-named `wamn:node/handler` shapes.
+//!
+//! Nothing is decided here. Each export hands its envelope to the operation
+//! that owns it and translates one whole-invocation refusal into the frozen
+//! node error the router acts on.
+
+use wamn::node::types::{Emission, ErrorDetail, NodeContext, NodeError};
+
+use crate::operation;
+
+wit_bindgen::generate!({
+    world: "wamn-dock:component/dock@1.0.0",
+    inline: r#"
+        package wamn-dock:component@1.0.0;
+
+        world dock {
+          import wamn:postgres/types@0.1.0;
+          import wamn:postgres/statements@0.1.0;
+          export wamn-dock:carrier/create@1.0.0;
+          export wamn-dock:dock/create@1.0.0;
+          export wamn-dock:appointment/book@1.0.0;
+          export wamn-dock:appointment/check-in@1.0.0;
+          export wamn-dock:appointment/query@1.0.0;
+        }
+    "#,
+    path: [
+        "../../data/wms-data/wit/deps/wamn-node",
+        "../../data/wms-data/wit/deps/wamn-postgres",
+        "wit/deps/wamn-dock-carrier",
+        "wit/deps/wamn-dock-dock",
+        "wit/deps/wamn-dock-appointment",
+    ],
+    generate_all,
+});
+
+struct Component;
+
+fn invoke_operation<F>(operation: F) -> Result<Emission, NodeError>
+where
+    F: Future<Output = Result<String, operation::InvocationError>>,
+{
+    futures_executor::block_on(operation)
+        .map(|payload| Emission {
+            payload,
+            port: None,
+        })
+        .map_err(|error| {
+            NodeError::InvalidInput(ErrorDetail {
+                message: error.context().to_owned(),
+                code: Some(error.code().to_owned()),
+            })
+        })
+}
+
+impl exports::wamn_dock::carrier::create::Guest for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke_operation(operation::carrier_create_operation(&input))
+    }
+}
+
+impl exports::wamn_dock::dock::create::Guest for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke_operation(operation::dock_create_operation(&input))
+    }
+}
+
+impl exports::wamn_dock::appointment::book::Guest for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke_operation(operation::appointment_book_operation(&input))
+    }
+}
+
+impl exports::wamn_dock::appointment::check_in::Guest for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke_operation(operation::appointment_check_in_operation(&input))
+    }
+}
+
+impl exports::wamn_dock::appointment::query::Guest for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke_operation(operation::appointment_query_operation(&input))
+    }
+}
+
+export!(Component);
