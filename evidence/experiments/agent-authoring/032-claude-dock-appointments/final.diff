@@ -0,0 +1,277 @@
+//! `appointment.check_in` — the arrival a dock actually observed.
+//!
+//! Check-in moves one appointment from `scheduled` to `arrived` and records the
+//! arrival time the caller supplies, which is the operator's clock and not the
+//! server's. The claim mints the check-in's own identity, so a redelivery of
+//! one arrival returns the first answer instead of recording a second.
+//!
+//! # The shape of one item
+//!
+//! ```text
+//! canonicalize the body
+//! → find a replay: same key ⇒ return the ORIGINAL result, unchanged
+//! → claim the key, which pre-generates the check-in id
+//! → lock the appointment     (the serialization point)
+//! → refuse unless it is still scheduled
+//! → record the arrival
+//! → finalize the claim with the result
+//! ```
+
+use serde::Deserialize;
+use wamn_postgres_statements::{Connection, TimestampTz, Transaction, Uuid};
+
+use crate::error::{self, AccessError, AccessErrorKind};
+use crate::generated::wamn::appointment_check_in as sql;
+use crate::scalar;
+
+#[cfg(test)]
+pub(crate) const REFUSALS: &[AccessErrorKind] = &[
+    AccessErrorKind::InvalidInput,
+    AccessErrorKind::NotFound,
+    AccessErrorKind::AppointmentNotScheduled,
+    AccessErrorKind::IdempotencyConflict,
+    AccessErrorKind::Retry,
+    AccessErrorKind::Timeout,
+    AccessErrorKind::PermissionDenied,
+    AccessErrorKind::InternalError,
+];
+
+/// The one status a scheduled appointment can be checked in from.
+const SCHEDULED: &str = "scheduled";
+
+/// One envelope item's command body.
+#[derive(Debug, Deserialize)]
+pub(crate) struct CheckInCommand {
+    pub(crate) idempotency_key: String,
+    pub(crate) appointment_id: String,
+    pub(crate) arrived_at: String,
+}
+
+/// What one accepted check-in answers with.
+#[derive(Debug, Eq, PartialEq)]
+pub(crate) struct CheckInResult {
+    pub(crate) check_in_id: String,
+    pub(crate) appointment_id: String,
+    pub(crate) status: String,
+    pub(crate) arrived_at: String,
+}
+
+impl CheckInResult {
+    pub(crate) fn to_json(&self) -> serde_json::Value {
+        serde_json::json!({
+            "check_in_id": self.check_in_id,
+            "appointment_id": self.appointment_id,
+            "status": self.status,
+            "arrived_at": self.arrived_at,
+        })
+    }
+}
+
+/// The command's scalars in their one wire spelling.
+#[derive(Debug)]
+pub(crate) struct Parsed {
+    appointment_id: Uuid,
+    arrived_at: TimestampTz,
+}
+
+fn parse(command: &CheckInCommand) -> Result<Parsed, AccessError> {
+    Ok(Parsed {
+        appointment_id: scalar::uuid("value.appointment_id", &command.appointment_id)?,
+        arrived_at: scalar::timestamp("value.arrived_at", &command.arrived_at)?,
+    })
+}
+
+/// The bytes the idempotency key keys: the RE-SPELLED command.
+pub(crate) fn canonical_command(parsed: &Parsed) -> Vec<u8> {
+    wamn_execution_contract::canonical_json_bytes(&serde_json::json!({
+        "appointment_id": parsed.appointment_id.0,
+        "arrived_at": parsed.arrived_at.0,
+    }))
+}
+
+/// Run one command item in exactly one transaction.
+///
+/// # Errors
+///
+/// [`AccessError`] carrying the literal and detail the operation contract
+/// declares for that refusal.
+pub(crate) async fn execute(command: &CheckInCommand) -> Result<CheckInResult, AccessError> {
+    let parsed = parse(command)?;
+    let canonical = canonical_command(&parsed);
+    let mut connection = Connection::new();
+    let mut transaction = connection
+        .begin()
+        .await
+        .map_err(|error| error::from_statement(&error))?;
+    match run(&mut transaction, command, &parsed, &canonical).await {
+        Ok(value) => {
+            transaction
+                .commit()
+                .await
+                .map_err(|error| error::from_statement(&error))?;
+            Ok(value)
+        }
+        Err(refusal) => {
+            let _ = transaction.rollback().await;
+            Err(refusal)
+        }
+    }
+}
+
+async fn run(
+    transaction: &mut Transaction,
+    command: &CheckInCommand,
+    parsed: &Parsed,
+    canonical: &[u8],
+) -> Result<CheckInResult, AccessError> {
+    if let Some(replay) = sql::find_replay(transaction, command.idempotency_key.clone())
+        .await
+        .map_err(|error| error::from_statement(&error))?
+    {
+        if replay.canonical_command != canonical {
+            return Err(AccessError::field(
+                AccessErrorKind::IdempotencyConflict,
+                "value.idempotency_key",
+            ));
+        }
+        let (Some(status), Some(arrived_at)) = (replay.status, replay.arrived_at) else {
+            return Err(AccessError::bare(AccessErrorKind::Retry));
+        };
+        // The appointment is the one the matching canonical command names, so
+        // the replay hands back the id the caller already sent, re-spelled.
+        return Ok(CheckInResult {
+            check_in_id: replay.check_in_id.0,
+            appointment_id: parsed.appointment_id.0.clone(),
+            status,
+            arrived_at: arrived_at.0,
+        });
+    }
+
+    let claim = sql::claim_command(
+        transaction,
+        command.idempotency_key.clone(),
+        canonical.to_vec(),
+    )
+    .await
+    .map_err(|error| error::from_statement(&error))?
+    .ok_or_else(|| AccessError::bare(AccessErrorKind::Retry))?;
+
+    // THE SERIALIZATION POINT.
+    let locked = sql::lock_appointment(transaction, parsed.appointment_id.clone())
+        .await
+        .map_err(|error| error::from_statement(&error))?
+        .ok_or_else(|| {
+            AccessError::missing(
+                AccessErrorKind::NotFound,
+                "value.appointment_id",
+                &parsed.appointment_id.0,
+            )
+        })?;
+    if locked.status != SCHEDULED {
+        // Status only moves forward, so an appointment that already arrived or
+        // departed cannot check in again under a NEW key.
+        return Err(AccessError::missing(
+            AccessErrorKind::AppointmentNotScheduled,
+            "value.appointment_id",
+            &parsed.appointment_id.0,
+        ));
+    }
+
+    let recorded = sql::record_arrival(
+        transaction,
+        parsed.appointment_id.clone(),
+        parsed.arrived_at.clone(),
+    )
+    .await
+    .map_err(|error| error::from_statement(&error))?;
+
+    let finalized = sql::finalize_command(
+        transaction,
+        command.idempotency_key.clone(),
+        canonical.to_vec(),
+        recorded.status.clone(),
+        recorded.arrived_at.clone(),
+    )
+    .await
+    .map_err(|error| error::from_statement(&error))?;
+    if finalized.status.is_none() || finalized.arrived_at.is_none() {
+        return Err(AccessError::bare(AccessErrorKind::Retry));
+    }
+
+    Ok(CheckInResult {
+        check_in_id: claim.check_in_id.0,
+        appointment_id: parsed.appointment_id.0.clone(),
+        status: recorded.status,
+        arrived_at: recorded.arrived_at.0,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn command(appointment: &str, arrived_at: &str) -> CheckInCommand {
+        CheckInCommand {
+            idempotency_key: "k".to_owned(),
+            appointment_id: appointment.to_owned(),
+            arrived_at: arrived_at.to_owned(),
+        }
+    }
+
+    fn bytes(command: &CheckInCommand) -> Vec<u8> {
+        canonical_command(&parse(command).expect("the fixture parses"))
+    }
+
+    #[test]
+    fn the_canonical_command_is_spelling_independent_and_excludes_the_key() {
+        let upper = command(
+            "00000000-0000-0000-0000-0000000000A1",
+            "2026-10-01T11:05:00+02:00",
+        );
+        let lower = command(
+            "00000000-0000-0000-0000-0000000000a1",
+            "2026-10-01T09:05:00.000000Z",
+        );
+        let mut other_key = command(
+            "00000000-0000-0000-0000-0000000000a1",
+            "2026-10-01T09:05:00Z",
+        );
+        other_key.idempotency_key = "different".to_owned();
+        assert_eq!(bytes(&upper), bytes(&lower));
+        assert_eq!(bytes(&lower), bytes(&other_key));
+        assert!(
+            !String::from_utf8(bytes(&lower))
+                .unwrap()
+                .contains("idempotency_key")
+        );
+    }
+
+    /// A check-in that records a DIFFERENT arrival time is a different
+    /// command, which is what makes an idempotency conflict reachable.
+    #[test]
+    fn a_different_arrival_time_is_a_different_command() {
+        let here = command(
+            "00000000-0000-0000-0000-0000000000a1",
+            "2026-10-01T09:05:00Z",
+        );
+        let there = command(
+            "00000000-0000-0000-0000-0000000000a1",
+            "2026-10-01T09:06:00Z",
+        );
+        assert_ne!(bytes(&here), bytes(&there));
+    }
+
+    #[test]
+    fn an_unspellable_scalar_is_refused_before_any_statement() {
+        let appointment = command("not-a-uuid", "2026-10-01T09:05:00Z");
+        assert_eq!(
+            parse(&appointment).unwrap_err().detail()["field"],
+            "value.appointment_id"
+        );
+        let arrival = command("00000000-0000-0000-0000-0000000000a1", "this morning");
+        assert_eq!(
+            parse(&arrival).unwrap_err().detail()["field"],
+            "value.arrived_at"
+        );
+    }
+}
diff --git a/components/application/dock/src/appointment_query.rs b/components/application/dock/src/appointment_query.rs
new file mode 100644
index 00000000..6b7aca37
--- /dev/null
+++ b/components/application/dock/src/appointment_query.rs
@@ -0,0 +1,80 @@
+//! `appointment.query` — one dock's day, in slot order.
+//!
+//! Dispatch asks for one dock, one day and one status, and the answer is the
+//! dock's appointments in slot order. THE ORDER IS THE DATABASE'S: the
+//! statement sorts by `slot_start` and breaks ties on `id`, so two slots that
+//! start together still come back in one stable order.
+
+use serde::Deserialize;
+use wamn_postgres_statements::Connection;
+
+use crate::error::{self, AccessError};
+use crate::generated::wamn::appointment_query as sql;
+use crate::scalar;
+
+#[cfg(test)]
+pub(crate) const REFUSALS: &[crate::error::AccessErrorKind] = &[
+    crate::error::AccessErrorKind::InvalidInput,
+    crate::error::AccessErrorKind::Retry,
+    crate::error::AccessErrorKind::Timeout,
+    crate::error::AccessErrorKind::PermissionDenied,
+    crate::error::AccessErrorKind::InternalError,
+];
+
+/// One envelope item's read body: the item itself, less its correlation id.
+#[derive(Debug, Deserialize)]
+pub(crate) struct QueryInput {
+    pub(crate) dock_id: String,
+    pub(crate) day: String,
+    pub(crate) status: String,
+}
+
+/// Read one dock's day.
+///
+/// # Errors
+///
+/// [`AccessError`] carrying the literal and detail the operation contract
+/// declares for that refusal.
+pub(crate) async fn execute(input: &QueryInput) -> Result<serde_json::Value, AccessError> {
+    let dock_id = scalar::uuid("dock_id", &input.dock_id)?;
+    let day = scalar::day_bounds("day", &input.day)?;
+    let status = scalar::appointment_status("status", &input.status)?;
+
+    // A projection reads, so it takes the transaction the statement plan asks
+    // for and nothing wider.
+    let mut connection = Connection::new();
+    let mut transaction = connection
+        .begin()
+        .await
+        .map_err(|error| error::from_statement(&error))?;
+    let rows = sql::query_appointment(&mut transaction, dock_id, day.start, day.end, status).await;
+    let rows = match rows {
+        Ok(rows) => {
+            transaction
+                .commit()
+                .await
+                .map_err(|error| error::from_statement(&error))?;
+            rows
+        }
+        Err(failure) => {
+            let _ = transaction.rollback().await;
+            return Err(error::from_statement(&failure));
+        }
+    };
+
+    Ok(serde_json::json!({
+        "appointments": rows
+            .into_iter()
+            .map(|row| {
+                serde_json::json!({
+                    "appointment_id": row.id.0,
+                    "carrier_id": row.carrier_id.0,
+                    "dock_id": row.dock_id.0,
+                    "slot_start": row.slot_start.0,
+                    "slot_end": row.slot_end.0,
+                    "status": row.status,
+                })
+            })
+            .collect::<Vec<_>>(),
+    }))
+}
diff --git a/components/application/dock/src/carrier_create.rs b/components/application/dock/src/carrier_create.rs
new file mode 100644
index 00000000..70b2121a
--- /dev/null
+++ b/components/application/dock/src/carrier_create.rs
@@ -0,0 +1,191 @@
+//! `carrier.create` — one carrier, minted from a claim.
+//!
+//! The identity comes from the CLAIM, never from the work: the claim row
+//! pre-generates `carrier_id`, and the carrier row is inserted under it. A
+//! replay therefore returns the same id by construction rather than because
+//! some caller took an early return.
+
+use serde::Deserialize;
+use wamn_postgres_statements::{Connection, Transaction};
+
+use crate::error::{self, AccessError, AccessErrorKind};
+use crate::generated::wamn::carrier_create as sql;
+
+#[cfg(test)]
+pub(crate) const REFUSALS: &[AccessErrorKind] = &[
+    AccessErrorKind::InvalidInput,
+    AccessErrorKind::IdempotencyConflict,
+    AccessErrorKind::Retry,
+    AccessErrorKind::Timeout,
+    AccessErrorKind::PermissionDenied,
+    AccessErrorKind::InternalError,
+];
+
+/// One envelope item's command body.
+#[derive(Debug, Deserialize)]
+pub(crate) struct CreateCarrierCommand {
+    pub(crate) idempotency_key: String,
+    pub(crate) name: String,
+}
+
+/// What one accepted create answers with.
+#[derive(Debug, Eq, PartialEq)]
+pub(crate) struct CreateCarrierResult {
+    pub(crate) carrier_id: String,
+}
+
+impl CreateCarrierResult {
+    pub(crate) fn to_json(&self) -> serde_json::Value {
+        serde_json::json!({ "carrier_id": self.carrier_id })
+    }
+}
+
+/// The bytes the idempotency key keys: the command less its envelope.
+///
+/// The key itself and `request_id` are EXCLUDED, because two deliveries of one
+/// operator action differ in neither, only in the envelope that carried them.
+pub(crate) fn canonical_command(command: &CreateCarrierCommand) -> Vec<u8> {
+    wamn_execution_contract::canonical_json_bytes(&serde_json::json!({
+        "name": command.name,
+    }))
+}
+
+fn parse(command: &CreateCarrierCommand) -> Result<(), AccessError> {
+    if command.name.is_empty() {
+        return Err(AccessError::field(
+            AccessErrorKind::InvalidInput,
+            "value.name",
+        ));
+    }
+    Ok(())
+}
+
+/// Run one command item in exactly one transaction.
+///
+/// # Errors
+///
+/// [`AccessError`] carrying the literal and detail the operation contract
+/// declares for that refusal.
+pub(crate) async fn execute(
+    command: &CreateCarrierCommand,
+) -> Result<CreateCarrierResult, AccessError> {
+    parse(command)?;
+    let canonical = canonical_command(command);
+    let mut connection = Connection::new();
+    let mut transaction = connection
+        .begin()
+        .await
+        .map_err(|error| error::from_statement(&error))?;
+    match run(&mut transaction, command, &canonical).await {
+        Ok(value) => {
+            transaction
+                .commit()
+                .await
+                .map_err(|error| error::from_statement(&error))?;
+            Ok(value)
+        }
+        // Dropping the transaction rolls it back; the explicit rollback makes
+        // the refusal path say so rather than relying on a Drop nobody reads.
+        Err(refusal) => {
+            let _ = transaction.rollback().await;
+            Err(refusal)
+        }
+    }
+}
+
+async fn run(
+    transaction: &mut Transaction,
+    command: &CreateCarrierCommand,
+    canonical: &[u8],
+) -> Result<CreateCarrierResult, AccessError> {
+    if let Some(replay) = sql::find_replay(transaction, command.idempotency_key.clone())
+        .await
+        .map_err(|error| error::from_statement(&error))?
+    {
+        if replay.canonical_command != canonical {
+            // Same key, different command. That is two carriers wearing one
+            // identity, and answering either would be wrong.
+            return Err(AccessError::field(
+                AccessErrorKind::IdempotencyConflict,
+                "value.idempotency_key",
+            ));
+        }
+        if replay.finalized_at.is_none() {
+            // Claimed but never finalized: the first attempt died between the
+            // claim and the commit. Retryable under the same claim.
+            return Err(AccessError::bare(AccessErrorKind::Retry));
+        }
+        return Ok(CreateCarrierResult {
+            carrier_id: replay.carrier_id.0,
+        });
+    }
+
+    let claim = sql::claim_command(
+        transaction,
+        command.idempotency_key.clone(),
+        canonical.to_vec(),
+    )
+    .await
+    .map_err(|error| error::from_statement(&error))?
+    .ok_or_else(|| AccessError::bare(AccessErrorKind::Retry))?;
+
+    sql::insert_carrier(transaction, claim.carrier_id.clone(), command.name.clone())
+        .await
+        .map_err(|error| error::from_statement(&error))?;
+
+    let finalized = sql::finalize_command(
+        transaction,
+        command.idempotency_key.clone(),
+        canonical.to_vec(),
+        claim.carrier_id.clone(),
+    )
+    .await
+    .map_err(|error| error::from_statement(&error))?;
+    if finalized.finalized_at.is_none() {
+        // The guarded finalize matched nothing, so a concurrent attempt already
+        // finished this claim. Refusing beats reporting a result this
+        // transaction did not write.
+        return Err(AccessError::bare(AccessErrorKind::Retry));
+    }
+
+    Ok(CreateCarrierResult {
+        carrier_id: claim.carrier_id.0,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn command(name: &str, key: &str) -> CreateCarrierCommand {
+        CreateCarrierCommand {
+            idempotency_key: key.to_owned(),
+            name: name.to_owned(),
+        }
+    }
+
+    /// The key and the correlation id are not part of what the command IS, so
+    /// the same carrier under two keys hashes alike and two carriers do not.
+    #[test]
+    fn the_canonical_command_excludes_the_key_and_separates_two_carriers() {
+        let first = canonical_command(&command("Blue Line Freight", "a"));
+        let same = canonical_command(&command("Blue Line Freight", "b"));
+        let other = canonical_command(&command("Red Line Freight", "a"));
+        assert_eq!(first, same);
+        assert_ne!(first, other);
+        assert!(
+            !String::from_utf8(first)
+                .unwrap()
+                .contains("idempotency_key")
+        );
+    }
+
+    #[test]
+    fn an_empty_name_is_refused_before_any_statement() {
+        assert_eq!(
+            parse(&command("", "a")).unwrap_err().detail()["field"],
+            "value.name"
+        );
+        assert!(parse(&command("Blue Line Freight", "a")).is_ok());
+    }
+}
