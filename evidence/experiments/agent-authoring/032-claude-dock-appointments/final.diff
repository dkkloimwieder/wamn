diff --git a/packages/dock/query/appointment_query.sql b/packages/dock/query/appointment_query.sql
new file mode 100644
index 00000000..4c1574bb
--- /dev/null
+++ b/packages/dock/query/appointment_query.sql
@@ -0,0 +1,15 @@
+SELECT
+    appointment.id,
+    appointment.carrier_id,
+    appointment.dock_id,
+    appointment.slot_start,
+    appointment.slot_end,
+    appointment.status
+FROM appointment AS appointment
+WHERE appointment.dock_id = $1
+    AND appointment.slot_start >= $2
+    AND appointment.slot_start < $3
+    AND appointment.status = $4
+ORDER BY
+    appointment.slot_start ASC,
+    appointment.id ASC;
