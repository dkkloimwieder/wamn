+[package]
+name = "dock"
+version.workspace = true
+edition.workspace = true
+description = "Package-grain Dock appointment operation component"
+license = "Apache-2.0"
+
+[dependencies]
+chrono = { workspace = true, features = ["std"] }
+futures-executor = "0.3"
+serde = { workspace = true, features = ["derive"] }
+serde_json.workspace = true
+uuid = "1"
+wamn-execution-contract = { workspace = true }
+wamn-postgres-statements = { workspace = true }
+wit-bindgen = { workspace = true }
+
+# Both crate types, so the operation logic can be unit-tested natively while the
+# same source componentizes for wasm32-wasip2. The WIT export shell lives in
+# `guest`, which is compiled only for wasm32; the tests below it never link a
+# host import.
+[lib]
+crate-type = ["cdylib", "rlib"]
+
+[lints]
+workspace = true
diff --git a/components/application/dock/src/error.rs b/components/application/dock/src/error.rs
new file mode 100644
index 00000000..d9a1d8ec
--- /dev/null
+++ b/components/application/dock/src/error.rs
@@ -0,0 +1,152 @@
+//! One contextual failure carried from a statement to the operation boundary.
+
+use std::error::Error;
+use std::fmt;
+
+use serde::Serialize;
+use wamn_postgres_statements::{StatementError, StatementErrorKind};
+
+/// Structured detail serialized beside a refusal code.
+///
+/// The variants are exactly the shapes `wamn.json` declares for this package's
+/// error codes, so a refusal cannot carry a detail its contract does not name.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+#[serde(untagged)]
+pub enum FailureDetail {
+    Field { field: &'static str },
+    FieldId { field: &'static str, id: Box<str> },
+    Operation { operation: &'static str },
+    Empty {},
+}
+
+/// One refused operation item, in the terms its declared contract uses.
+#[derive(Debug)]
+pub struct Failure {
+    code: &'static str,
+    detail: FailureDetail,
+    context: Box<str>,
+    source: Option<StatementError>,
+}
+
+impl Failure {
+    /// Frozen wire refusal literal.
+    pub const fn code(&self) -> &'static str {
+        self.code
+    }
+
+    /// Structured detail this refusal carries.
+    pub const fn detail(&self) -> &FailureDetail {
+        &self.detail
+    }
+
+    /// Stable description; callers never match on it.
+    pub fn context(&self) -> &str {
+        &self.context
+    }
+
+    pub(crate) fn invalid_input(context: impl Into<Box<str>>, field: &'static str) -> Self {
+        Self::new("invalid_input", FailureDetail::Field { field }, context)
+    }
+
+    pub(crate) fn field(
+        code: &'static str,
+        context: impl Into<Box<str>>,
+        field: &'static str,
+    ) -> Self {
+        Self::new(code, FailureDetail::Field { field }, context)
+    }
+
+    pub(crate) fn field_id(
+        code: &'static str,
+        context: impl Into<Box<str>>,
+        field: &'static str,
+        id: &str,
+    ) -> Self {
+        Self::new(code, FailureDetail::FieldId { field, id: id.into() }, context)
+    }
+
+    pub(crate) fn internal(context: impl Into<Box<str>>) -> Self {
+        Self::new("internal_error", FailureDetail::Empty {}, context)
+    }
+
+    /// Translate one statement failure exactly once, at this boundary.
+    pub(crate) fn from_statement(
+        context: impl Into<Box<str>>,
+        operation: &'static str,
+        source: StatementError,
+    ) -> Self {
+        let (code, detail) = match source.kind() {
+            StatementErrorKind::SerializationFailure
+            | StatementErrorKind::ConnectionUnavailable => ("retry", FailureDetail::Empty {}),
+            StatementErrorKind::StatementTimeout => ("timeout", FailureDetail::Empty {}),
+            StatementErrorKind::PermissionDenied => {
+                ("permission_denied", FailureDetail::Operation { operation })
+            }
+            StatementErrorKind::UnknownStatement
+            | StatementErrorKind::StatementContractMismatch
+            | StatementErrorKind::RowLimitExceeded
+            | StatementErrorKind::UniqueViolation
+            | StatementErrorKind::ForeignKeyViolation
+            | StatementErrorKind::CheckViolation
+            | StatementErrorKind::QueryError
+            | StatementErrorKind::InvalidResult => ("internal_error", FailureDetail::Empty {}),
+        };
+        Self {
+            code,
+            detail,
+            context: context.into(),
+            source: Some(source),
+        }
+    }
+
+    fn new(code: &'static str, detail: FailureDetail, context: impl Into<Box<str>>) -> Self {
+        Self {
+            code,
+            detail,
+            context: context.into(),
+            source: None,
+        }
+    }
+}
+
+impl fmt::Display for Failure {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "{}: {}", self.code, self.context)
+    }
+}
+
+impl Error for Failure {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        self.source.as_ref().map(|source| source as &(dyn Error + 'static))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::Failure;
+
+    #[test]
+    fn a_refusal_carries_the_detail_its_contract_declares() {
+        let refusal = Failure::field_id(
+            "not_found",
+            "appointment does not exist",
+            "appointment_id",
+            "00000000-0000-0000-0000-000000000000",
+        );
+        assert_eq!(refusal.code(), "not_found");
+        assert_eq!(
+            serde_json::to_string(refusal.detail()).expect("detail serializes"),
+            r#"{"field":"appointment_id","id":"00000000-0000-0000-0000-000000000000"}"#
+        );
+    }
+
+    #[test]
+    fn an_internal_refusal_carries_an_empty_detail_object() {
+        let refusal = Failure::internal("unreachable");
+        assert_eq!(refusal.code(), "internal_error");
+        assert_eq!(
+            serde_json::to_string(refusal.detail()).expect("detail serializes"),
+            "{}"
+        );
+    }
+}
