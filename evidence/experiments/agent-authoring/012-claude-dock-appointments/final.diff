diff --git a/packages/dock/query/appointment_by_slot_start.sql b/packages/dock/query/appointment_by_slot_start.sql
new file mode 100644
index 00000000..992c5b6e
--- /dev/null
+++ b/packages/dock/query/appointment_by_slot_start.sql
@@ -0,0 +1,16 @@
+SELECT
+    id,
+    dock_id,
+    carrier_id,
+    slot_start,
+    slot_end,
+    status,
+    arrived_at,
+    row_version
+FROM appointment
+WHERE dock_id = $1
+    AND status = $2
+    AND slot_start >= $3
+    AND slot_start < $4
+ORDER BY slot_start ASC, id ASC
+LIMIT 200;
