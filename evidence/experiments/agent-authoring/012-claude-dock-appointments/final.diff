+//! One spelling for every scalar this package puts on the wire or in a bind.
+//!
+//! Two spellings exist and they are not the same thing. The BIND spelling is
+//! what a value must look like before it is hashed into a command identity or
+//! sent to PostgreSQL: RFC 3339, UTC, six fractional digits, exactly as
+//! `wamn.json` freezes it. The WIRE spelling is what a caller reads back: the
+//! same instant, with the fraction omitted when it is zero, so a caller that
+//! sent `2026-10-01T09:07:00Z` reads that instant back in the spelling it sent
+//! rather than in a padded one.
+
+use chrono::{DateTime, SecondsFormat, TimeZone as _, Utc};
+
+use crate::error::Failure;
+
+/// Canonical hyphenated lowercase UUID text.
+pub(crate) fn parse_uuid(value: &str, field: &'static str) -> Result<String, Failure> {
+    uuid::Uuid::parse_str(value)
+        .ok()
+        .map(|parsed| parsed.hyphenated().to_string())
+        .filter(|canonical| canonical == value)
+        .ok_or_else(|| Failure::invalid_input("value is not a canonical UUID", field))
+}
+
+/// Parse one caller timestamp into the instant it names.
+pub(crate) fn parse_timestamp(value: &str, field: &'static str) -> Result<DateTime<Utc>, Failure> {
+    DateTime::parse_from_rfc3339(value)
+        .map(|parsed| parsed.with_timezone(&Utc))
+        .map_err(|_| Failure::invalid_input("value is not an RFC 3339 timestamp", field))
+}
+
+/// The frozen bind and command-identity spelling.
+pub(crate) fn bind_timestamp(instant: DateTime<Utc>) -> String {
+    instant.to_rfc3339_opts(SecondsFormat::Micros, true)
+}
+
+/// The spelling a caller reads back, from what PostgreSQL returned.
+pub(crate) fn wire_timestamp(stored: &str) -> Result<String, Failure> {
+    let instant = DateTime::parse_from_rfc3339(stored)
+        .map(|parsed| parsed.with_timezone(&Utc))
+        .map_err(|_| Failure::internal("stored timestamp is not RFC 3339"))?;
+    Ok(spell(instant))
+}
+
+fn spell(instant: DateTime<Utc>) -> String {
+    if instant.timestamp_subsec_nanos() == 0 {
+        instant.to_rfc3339_opts(SecondsFormat::Secs, true)
+    } else {
+        instant.to_rfc3339_opts(SecondsFormat::Micros, true)
+    }
+}
+
+/// Half-open UTC bounds of one calendar day named as `YYYY-MM-DD`.
+///
+/// The day is read in UTC. A dock is a physical door and its operators keep
+/// local time, but this package is given no zone for one, and inventing a
+/// server default would silently move every boundary appointment.
+pub(crate) fn parse_day(
+    value: &str,
+    field: &'static str,
+) -> Result<(DateTime<Utc>, DateTime<Utc>), Failure> {
+    let invalid = || Failure::invalid_input("value is not a YYYY-MM-DD day", field);
+    let date = chrono::NaiveDate::parse_from_str(value, "%Y-%m-%d").map_err(|_| invalid())?;
+    if date.format("%Y-%m-%d").to_string() != value {
+        return Err(invalid());
+    }
+    let start = Utc
+        .from_utc_datetime(&date.and_hms_opt(0, 0, 0).ok_or_else(invalid)?);
+    let end = start + chrono::Duration::days(1);
+    Ok((start, end))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{bind_timestamp, parse_day, parse_timestamp, parse_uuid, wire_timestamp};
+
+    #[test]
+    fn a_caller_reads_back_the_second_precision_spelling_it_sent() {
+        let sent = "2026-10-01T09:07:00Z";
+        let instant = parse_timestamp(sent, "arrived_at").expect("sent value parses");
+        assert_eq!(bind_timestamp(instant), "2026-10-01T09:07:00.000000Z");
+        assert_eq!(
+            wire_timestamp("2026-10-01T09:07:00.000000+00:00").expect("stored value parses"),
+            sent
+        );
+    }
+
+    #[test]
+    fn a_nonzero_fraction_survives_the_wire_spelling() {
+        assert_eq!(
+            wire_timestamp("2026-10-01T09:07:00.250000+00:00").expect("stored value parses"),
+            "2026-10-01T09:07:00.250000Z"
+        );
+    }
+
+    #[test]
+    fn an_offset_timestamp_binds_as_the_instant_it_names() {
+        let instant = parse_timestamp("2026-10-01T11:00:00+02:00", "slot_start")
+            .expect("offset value parses");
+        assert_eq!(bind_timestamp(instant), "2026-10-01T09:00:00.000000Z");
+    }
+
+    #[test]
+    fn only_a_canonical_uuid_is_admitted() {
+        assert_eq!(
+            parse_uuid("0f1e2d3c-4b5a-4968-8776-655443322110", "dock_id")
+                .expect("canonical uuid is admitted"),
+            "0f1e2d3c-4b5a-4968-8776-655443322110"
+        );
+        for rejected in [
+            "0F1E2D3C-4B5A-4968-8776-655443322110",
+            "0f1e2d3c4b5a49688776655443322110",
+            "not-a-uuid",
+        ] {
+            assert!(parse_uuid(rejected, "dock_id").is_err(), "{rejected}");
+        }
+    }
+
+    #[test]
+    fn a_day_is_a_half_open_utc_interval() {
+        let (start, end) = parse_day("2026-10-01", "day").expect("day parses");
+        assert_eq!(bind_timestamp(start), "2026-10-01T00:00:00.000000Z");
+        assert_eq!(bind_timestamp(end), "2026-10-02T00:00:00.000000Z");
+        assert!(parse_day("2026-10-1", "day").is_err());
+        assert!(parse_day("2026-13-01", "day").is_err());
+    }
+}
