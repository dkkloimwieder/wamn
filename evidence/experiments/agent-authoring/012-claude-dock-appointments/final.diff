+//! Dock appointment operations over the frozen PostgreSQL statement capability.
+
+mod error;
+mod generated;
+pub mod operation;
+mod wire;
+
+// The WIT export shell is meaningful only inside a component. Gating it keeps
+// `cargo test` on the host from linking guest imports that have no host side.
+#[cfg(target_arch = "wasm32")]
+mod guest;
+
+pub use error::{Failure, FailureDetail};
diff --git a/components/application/dock/src/operation.rs b/components/application/dock/src/operation.rs
new file mode 100644
index 00000000..40530fc2
--- /dev/null
+++ b/components/application/dock/src/operation.rs
@@ -0,0 +1,851 @@
+//! Wire adapters for the Dock operations, backed by admitted static SQL.
+
+use serde::de::DeserializeOwned;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use wamn_execution_contract::canonical_json_bytes;
+use wamn_postgres_statements::{Connection, TimestampTz, Transaction, Uuid as WamnUuid};
+
+use crate::error::{Failure, FailureDetail};
+use crate::generated::{
+    appointment_book as book_sql, appointment_check_in as check_in_sql,
+    appointment_query as query_sql, carrier_create as carrier_sql, dock_create as dock_sql,
+};
+use crate::wire::{bind_timestamp, parse_day, parse_timestamp, parse_uuid, wire_timestamp};
+
+const MAX_ENVELOPE_ITEMS: usize = 100;
+const STATUS_VALUES: [&str; 3] = ["scheduled", "arrived", "departed"];
+
+/// Envelope refusal, which precedes every per-item result.
+#[derive(Debug)]
+pub struct InvocationError {
+    context: &'static str,
+}
+
+impl InvocationError {
+    /// Frozen WIT error-detail code.
+    pub const fn code(&self) -> &'static str {
+        "invalid_input"
+    }
+
+    /// Stable, non-database refusal description.
+    pub const fn context(&self) -> &'static str {
+        self.context
+    }
+
+    const fn new(context: &'static str) -> Self {
+        Self { context }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+struct EnvelopeItem {
+    request_id: Box<str>,
+    body: Value,
+}
+
+fn prepare_envelope(input: &str) -> Result<Box<[EnvelopeItem]>, InvocationError> {
+    let value: Value = serde_json::from_str(input)
+        .map_err(|_| InvocationError::new("operation input must be a JSON array"))?;
+    let Value::Array(values) = value else {
+        return Err(InvocationError::new("operation input must be a JSON array"));
+    };
+    if !(1..=MAX_ENVELOPE_ITEMS).contains(&values.len()) {
+        return Err(InvocationError::new(
+            "operation input item count must be 1..=100",
+        ));
+    }
+    values
+        .into_iter()
+        .map(|value| {
+            let Value::Object(mut object) = value else {
+                return Err(InvocationError::new(
+                    "every operation item must be a JSON object",
+                ));
+            };
+            let request_id = match object.remove("request_id") {
+                Some(Value::String(request_id)) if !request_id.is_empty() => request_id,
+                _ => {
+                    return Err(InvocationError::new(
+                        "every operation item must carry a nonempty string request_id",
+                    ));
+                }
+            };
+            Ok(EnvelopeItem {
+                request_id: request_id.into_boxed_str(),
+                body: Value::Object(object),
+            })
+        })
+        .collect::<Result<Vec<_>, _>>()
+        .map(Vec::into_boxed_slice)
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct NameInput {
+    name: Box<str>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct BookInput {
+    idempotency_key: Box<str>,
+    carrier_id: Box<str>,
+    dock_id: Box<str>,
+    slot_start: Box<str>,
+    slot_end: Box<str>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CheckInInput {
+    appointment_id: Box<str>,
+    arrived_at: Box<str>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct QueryInput {
+    dock_id: Box<str>,
+    day: Box<str>,
+    status: Box<str>,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(untagged)]
+enum ItemResult<T> {
+    Succeeded {
+        request_id: Box<str>,
+        value: T,
+    },
+    Refused {
+        request_id: Box<str>,
+        error: OperationError,
+    },
+}
+
+#[derive(Debug, Serialize)]
+struct OperationError {
+    code: &'static str,
+    detail: FailureDetail,
+}
+
+#[derive(Debug, Serialize)]
+struct CarrierValue {
+    carrier_id: Box<str>,
+    name: Box<str>,
+}
+
+#[derive(Debug, Serialize)]
+struct DockValue {
+    dock_id: Box<str>,
+    name: Box<str>,
+}
+
+#[derive(Debug, Serialize)]
+struct AppointmentValue {
+    appointment_id: Box<str>,
+    dock_id: Box<str>,
+    carrier_id: Box<str>,
+    slot_start: Box<str>,
+    slot_end: Box<str>,
+    status: Box<str>,
+    arrived_at: Option<Box<str>>,
+    row_version: Box<str>,
+}
+
+#[derive(Debug, Serialize)]
+struct AppointmentsValue {
+    appointments: Box<[AppointmentValue]>,
+}
+
+/// Build one wire appointment from any statement row that projects it.
+///
+/// Four admitted statements return the same eight appointment columns, and each
+/// generates its own row struct, so the shared conversion takes the members
+/// rather than the struct.
+fn appointment_value(
+    id: &str,
+    dock_id: &str,
+    carrier_id: &str,
+    slot_start: &str,
+    slot_end: &str,
+    status: String,
+    arrived_at: Option<&str>,
+    row_version: i64,
+) -> Result<AppointmentValue, Failure> {
+    Ok(AppointmentValue {
+        appointment_id: id.into(),
+        dock_id: dock_id.into(),
+        carrier_id: carrier_id.into(),
+        slot_start: wire_timestamp(slot_start)?.into_boxed_str(),
+        slot_end: wire_timestamp(slot_end)?.into_boxed_str(),
+        status: status.into_boxed_str(),
+        arrived_at: arrived_at
+            .map(|stored| wire_timestamp(stored).map(String::into_boxed_str))
+            .transpose()?,
+        row_version: row_version.to_string().into_boxed_str(),
+    })
+}
+
+macro_rules! into_appointment_value {
+    ($row:expr) => {{
+        let row = $row;
+        appointment_value(
+            &row.id.0,
+            &row.dock_id.0,
+            &row.carrier_id.0,
+            &row.slot_start.0,
+            &row.slot_end.0,
+            row.status,
+            row.arrived_at.as_ref().map(|value| value.0.as_str()),
+            row.row_version,
+        )
+    }};
+}
+
+fn parse_item<T: DeserializeOwned>(item: &EnvelopeItem) -> Result<T, Failure> {
+    serde_json::from_value(item.body.clone())
+        .map_err(|_| Failure::invalid_input("item does not match its input contract", "input"))
+}
+
+fn succeeded<T>(request_id: Box<str>, value: T) -> ItemResult<T> {
+    ItemResult::Succeeded { request_id, value }
+}
+
+fn refused<T>(request_id: Box<str>, failure: &Failure) -> ItemResult<T> {
+    ItemResult::Refused {
+        request_id,
+        error: OperationError {
+            code: failure.code(),
+            detail: failure.detail().clone(),
+        },
+    }
+}
+
+fn serialized<T: Serialize>(output: &[ItemResult<T>]) -> String {
+    serde_json::to_string(output).expect("closed operation results always serialize")
+}
+
+async fn begin(
+    connection: &mut Connection,
+    operation: &'static str,
+) -> Result<Transaction, Failure> {
+    connection
+        .begin()
+        .await
+        .map_err(|source| Failure::from_statement("begin the command", operation, source))
+}
+
+async fn commit(transaction: Transaction, operation: &'static str) -> Result<(), Failure> {
+    transaction
+        .commit()
+        .await
+        .map_err(|source| Failure::from_statement("commit the command", operation, source))
+}
+
+fn required_name(input: &NameInput, field: &'static str) -> Result<String, Failure> {
+    if input.name.trim().is_empty() {
+        Err(Failure::invalid_input("name must not be blank", field))
+    } else {
+        Ok(input.name.to_string())
+    }
+}
+
+/// Create one carrier and return the identity later operations address it by.
+pub async fn carrier_create(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output: Vec<ItemResult<CarrierValue>> = Vec::with_capacity(items.len());
+    for item in items.into_vec() {
+        let result = async {
+            let parsed = parse_item::<NameInput>(&item)?;
+            let name = required_name(&parsed, "name")?;
+            let mut transaction = begin(&mut connection, "carrier.create").await?;
+            let row = carrier_sql::insert_carrier(&mut transaction, name)
+                .await
+                .map_err(|source| {
+                    Failure::from_statement("insert carrier", "carrier.create", source)
+                })?;
+            commit(transaction, "carrier.create").await?;
+            Ok::<_, Failure>(CarrierValue {
+                carrier_id: row.id.0.into_boxed_str(),
+                name: row.name.into_boxed_str(),
+            })
+        }
+        .await;
+        output.push(match result {
+            Ok(value) => succeeded(item.request_id, value),
+            Err(failure) => refused(item.request_id, &failure),
+        });
+    }
+    Ok(serialized(&output))
+}
+
+/// Create one dock and return the identity later operations address it by.
+pub async fn dock_create(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output: Vec<ItemResult<DockValue>> = Vec::with_capacity(items.len());
+    for item in items.into_vec() {
+        let result = async {
+            let parsed = parse_item::<NameInput>(&item)?;
+            let name = required_name(&parsed, "name")?;
+            let mut transaction = begin(&mut connection, "dock.create").await?;
+            let row = dock_sql::insert_dock(&mut transaction, name)
+                .await
+                .map_err(|source| Failure::from_statement("insert dock", "dock.create", source))?;
+            commit(transaction, "dock.create").await?;
+            Ok::<_, Failure>(DockValue {
+                dock_id: row.id.0.into_boxed_str(),
+                name: row.name.into_boxed_str(),
+            })
+        }
+        .await;
+        output.push(match result {
+            Ok(value) => succeeded(item.request_id, value),
+            Err(failure) => refused(item.request_id, &failure),
+        });
+    }
+    Ok(serialized(&output))
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct PreparedBooking {
+    idempotency_key: String,
+    carrier_id: String,
+    dock_id: String,
+    slot_start: String,
+    slot_end: String,
+    canonical_command: Vec<u8>,
+}
+
+/// Canonicalize one booking, then hash what was canonicalized.
+///
+/// The identity excludes `request_id` and `idempotency_key` exactly as
+/// `wamn.json` declares, so a redelivery of one booking under its own key
+/// replays instead of conflicting, and a different booking under the same key
+/// refuses.
+fn prepare_booking(parsed: &BookInput) -> Result<PreparedBooking, Failure> {
+    if parsed.idempotency_key.is_empty() {
+        return Err(Failure::invalid_input(
+            "idempotency_key must not be empty",
+            "idempotency_key",
+        ));
+    }
+    let carrier_id = parse_uuid(&parsed.carrier_id, "carrier_id")?;
+    let dock_id = parse_uuid(&parsed.dock_id, "dock_id")?;
+    let slot_start = parse_timestamp(&parsed.slot_start, "slot_start")?;
+    let slot_end = parse_timestamp(&parsed.slot_end, "slot_end")?;
+    if slot_end <= slot_start {
+        return Err(Failure::invalid_input(
+            "slot_end must be after slot_start",
+            "slot_end",
+        ));
+    }
+    let slot_start = bind_timestamp(slot_start);
+    let slot_end = bind_timestamp(slot_end);
+    let canonical = serde_json::json!({
+        "carrier_id": carrier_id,
+        "dock_id": dock_id,
+        "slot_end": slot_end,
+        "slot_start": slot_start,
+    });
+    Ok(PreparedBooking {
+        idempotency_key: parsed.idempotency_key.to_string(),
+        carrier_id,
+        dock_id,
+        slot_start,
+        slot_end,
+        canonical_command: canonical_json_bytes(&canonical),
+    })
+}
+
+async fn replay_booking(
+    transaction: &mut Transaction,
+    stored_command: &[u8],
+    appointment_id: WamnUuid,
+    presented_command: &[u8],
+) -> Result<AppointmentValue, Failure> {
+    if stored_command != presented_command {
+        return Err(Failure::field(
+            "idempotency_conflict",
+            "idempotency_key was already used with a different request",
+            "idempotency_key",
+        ));
+    }
+    let row = book_sql::load_appointment(transaction, appointment_id)
+        .await
+        .map_err(|source| {
+            Failure::from_statement("load the claimed appointment", "appointment.book", source)
+        })?;
+    into_appointment_value!(row)
+}
+
+async fn book_in(
+    transaction: &mut Transaction,
+    booking: &PreparedBooking,
+) -> Result<AppointmentValue, Failure> {
+    if let Some(replay) = book_sql::find_replay(transaction, booking.idempotency_key.clone())
+        .await
+        .map_err(|source| {
+            Failure::from_statement("find the booking replay", "appointment.book", source)
+        })?
+    {
+        return replay_booking(
+            transaction,
+            &replay.canonical_command,
+            replay.appointment_id,
+            &booking.canonical_command,
+        )
+        .await;
+    }
+
+    let claim = book_sql::claim_command(
+        transaction,
+        booking.idempotency_key.clone(),
+        booking.canonical_command.clone(),
+        WamnUuid(booking.dock_id.clone()),
+    )
+    .await
+    .map_err(|source| {
+        Failure::from_statement("claim the idempotency key", "appointment.book", source)
+    })?;
+    let Some(claim) = claim else {
+        let replay = book_sql::find_replay(transaction, booking.idempotency_key.clone())
+            .await
+            .map_err(|source| {
+                Failure::from_statement(
+                    "load the concurrent booking replay",
+                    "appointment.book",
+                    source,
+                )
+            })?
+            .ok_or_else(|| {
+                Failure::internal("a conflicting command claim has no durable result")
+            })?;
+        return replay_booking(
+            transaction,
+            &replay.canonical_command,
+            replay.appointment_id,
+            &booking.canonical_command,
+        )
+        .await;
+    };
+
+    book_sql::load_carrier(transaction, WamnUuid(booking.carrier_id.clone()))
+        .await
+        .map_err(|source| Failure::from_statement("load the carrier", "appointment.book", source))?
+        .ok_or_else(|| {
+            Failure::field_id(
+                "carrier_not_found",
+                "carrier does not exist",
+                "carrier_id",
+                &booking.carrier_id,
+            )
+        })?;
+
+    // The dock row is the serialization point for this dock. Every booking on
+    // it takes this lock before it reads the neighbours, so two bookings that
+    // overlap cannot both pass the probe below.
+    book_sql::lock_dock(transaction, WamnUuid(booking.dock_id.clone()))
+        .await
+        .map_err(|source| Failure::from_statement("lock the dock", "appointment.book", source))?
+        .ok_or_else(|| {
+            Failure::field_id(
+                "dock_not_found",
+                "dock does not exist",
+                "dock_id",
+                &booking.dock_id,
+            )
+        })?;
+
+    if book_sql::find_overlap(
+        transaction,
+        WamnUuid(booking.dock_id.clone()),
+        TimestampTz(booking.slot_start.clone()),
+        TimestampTz(booking.slot_end.clone()),
+    )
+    .await
+    .map_err(|source| {
+        Failure::from_statement("probe the dock slot", "appointment.book", source)
+    })?
+    .is_some()
+    {
+        return Err(Failure::field(
+            "slot_unavailable",
+            "the requested slot overlaps an appointment already on that dock",
+            "slot_start",
+        ));
+    }
+
+    let row = book_sql::insert_appointment(
+        transaction,
+        claim.appointment_id,
+        WamnUuid(booking.dock_id.clone()),
+        WamnUuid(booking.carrier_id.clone()),
+        TimestampTz(booking.slot_start.clone()),
+        TimestampTz(booking.slot_end.clone()),
+    )
+    .await
+    .map_err(|source| {
+        Failure::from_statement("insert the appointment", "appointment.book", source)
+    })?;
+    into_appointment_value!(row)
+}
+
+/// Book one slot on one dock for one carrier, under an idempotency key.
+pub async fn appointment_book(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output: Vec<ItemResult<AppointmentValue>> = Vec::with_capacity(items.len());
+    for item in items.into_vec() {
+        let result = async {
+            let parsed = parse_item::<BookInput>(&item)?;
+            let booking = prepare_booking(&parsed)?;
+            let mut transaction = begin(&mut connection, "appointment.book").await?;
+            let value = book_in(&mut transaction, &booking).await?;
+            commit(transaction, "appointment.book").await?;
+            Ok::<_, Failure>(value)
+        }
+        .await;
+        output.push(match result {
+            Ok(value) => succeeded(item.request_id, value),
+            Err(failure) => refused(item.request_id, &failure),
+        });
+    }
+    Ok(serialized(&output))
+}
+
+async fn check_in_at(
+    transaction: &mut Transaction,
+    appointment_id: &str,
+    arrived_at: String,
+) -> Result<AppointmentValue, Failure> {
+    let locked = check_in_sql::lock_appointment(transaction, WamnUuid(appointment_id.to_owned()))
+        .await
+        .map_err(|source| {
+            Failure::from_statement("lock the appointment", "appointment.check_in", source)
+        })?
+        .ok_or_else(|| {
+            Failure::field_id(
+                "not_found",
+                "appointment does not exist",
+                "appointment_id",
+                appointment_id,
+            )
+        })?;
+    if locked.status != "scheduled" {
+        return Err(Failure::field_id(
+            "appointment_not_scheduled",
+            "appointment already moved past scheduled",
+            "appointment_id",
+            appointment_id,
+        ));
+    }
+    let row = check_in_sql::record_arrival(
+        transaction,
+        WamnUuid(appointment_id.to_owned()),
+        TimestampTz(arrived_at),
+    )
+    .await
+    .map_err(|source| {
+        Failure::from_statement("record the arrival", "appointment.check_in", source)
+    })?;
+    into_appointment_value!(row)
+}
+
+/// Record an arrival against one booked appointment.
+pub async fn appointment_check_in(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output: Vec<ItemResult<AppointmentValue>> = Vec::with_capacity(items.len());
+    for item in items.into_vec() {
+        let result = async {
+            let parsed = parse_item::<CheckInInput>(&item)?;
+            let appointment_id = parse_uuid(&parsed.appointment_id, "appointment_id")?;
+            let arrived_at = bind_timestamp(parse_timestamp(&parsed.arrived_at, "arrived_at")?);
+            let mut transaction = begin(&mut connection, "appointment.check_in").await?;
+            let value = check_in_at(&mut transaction, &appointment_id, arrived_at).await?;
+            commit(transaction, "appointment.check_in").await?;
+            Ok::<_, Failure>(value)
+        }
+        .await;
+        output.push(match result {
+            Ok(value) => succeeded(item.request_id, value),
+            Err(failure) => refused(item.request_id, &failure),
+        });
+    }
+    Ok(serialized(&output))
+}
+
+/// List one dock's appointments for one day, filtered by status, in slot order.
+pub async fn appointment_query(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output: Vec<ItemResult<AppointmentsValue>> = Vec::with_capacity(items.len());
+    for item in items.into_vec() {
+        let result = async {
+            let parsed = parse_item::<QueryInput>(&item)?;
+            let dock_id = parse_uuid(&parsed.dock_id, "dock_id")?;
+            let (day_start, day_end) = parse_day(&parsed.day, "day")?;
+            if !STATUS_VALUES.contains(&parsed.status.as_ref()) {
+                return Err(Failure::invalid_input(
+                    "status is outside the closed vocabulary",
+                    "status",
+                ));
+            }
+            let mut transaction = begin(&mut connection, "appointment.query").await?;
+            let rows = query_sql::appointment_by_slot_start(
+                &mut transaction,
+                WamnUuid(dock_id),
+                parsed.status.to_string(),
+                TimestampTz(bind_timestamp(day_start)),
+                TimestampTz(bind_timestamp(day_end)),
+            )
+            .await
+            .map_err(|source| {
+                Failure::from_statement("list the dock day", "appointment.query", source)
+            })?;
+            commit(transaction, "appointment.query").await?;
+            let appointments = rows
+                .into_iter()
+                .map(|row| into_appointment_value!(row))
+                .collect::<Result<Vec<_>, Failure>>()?;
+            Ok::<_, Failure>(AppointmentsValue {
+                appointments: appointments.into_boxed_slice(),
+            })
+        }
+        .await;
+        output.push(match result {
+            Ok(value) => succeeded(item.request_id, value),
+            Err(failure) => refused(item.request_id, &failure),
+        });
+    }
+    Ok(serialized(&output))
+}
