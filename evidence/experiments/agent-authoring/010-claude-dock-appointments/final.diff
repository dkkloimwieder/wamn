@@ -0,0 +1,170 @@
+//! `appointment.check_in` — the arrival, recorded against a booked appointment.
+//!
+//! Status only moves forward, so the row is locked before it is read: a second
+//! check-in on the same appointment waits, sees `arrived`, and is refused rather
+//! than overwriting the first arrival time.
+
+use serde::Deserialize;
+use wamn_postgres_statements::{Connection, TimestampTz, Transaction, Uuid};
+
+use crate::error::{self, AccessError, AccessErrorKind};
+use crate::generated::wamn::appointment_check_in as sql;
+use crate::scalar;
+
+pub(crate) const REFUSALS: &[AccessErrorKind] = &[
+    AccessErrorKind::InvalidInput,
+    AccessErrorKind::NotFound,
+    AccessErrorKind::InvalidTransition,
+    AccessErrorKind::Retry,
+    AccessErrorKind::Timeout,
+    AccessErrorKind::PermissionDenied,
+    AccessErrorKind::InternalError,
+];
+
+/// One envelope item's command body.
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct CheckInCommand {
+    pub(crate) appointment_id: String,
+    pub(crate) arrived_at: String,
+}
+
+/// What one accepted check-in answers with.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct CheckInResult {
+    pub(crate) appointment_id: String,
+    pub(crate) status: String,
+    pub(crate) arrived_at: String,
+    pub(crate) row_version: i64,
+}
+
+impl CheckInResult {
+    pub(crate) fn to_json(&self) -> serde_json::Value {
+        serde_json::json!({
+            "appointment_id": self.appointment_id,
+            "status": self.status,
+            "arrived_at": self.arrived_at,
+            "row_version": self.row_version,
+        })
+    }
+}
+
+#[derive(Debug)]
+struct Parsed {
+    appointment_id: Uuid,
+    arrived_at: TimestampTz,
+}
+
+fn parse(command: &CheckInCommand) -> Result<Parsed, AccessError> {
+    Ok(Parsed {
+        appointment_id: scalar::uuid("appointment_id", &command.appointment_id)?,
+        arrived_at: scalar::timestamp("arrived_at", &command.arrived_at)?,
+    })
+}
+
+/// Run one command item in exactly one transaction.
+///
+/// # Errors
+///
+/// [`AccessError`] carrying the literal and detail the operation contract
+/// declares for that refusal.
+pub(crate) async fn execute(command: &CheckInCommand) -> Result<CheckInResult, AccessError> {
+    let parsed = parse(command)?;
+
+    let mut connection = Connection::new();
+    let mut transaction = connection
+        .begin()
+        .await
+        .map_err(|e| error::from_statement(&e))?;
+    match run(&mut transaction, command, &parsed).await {
+        Ok(value) => {
+            transaction
+                .commit()
+                .await
+                .map_err(|e| error::from_statement(&e))?;
+            Ok(value)
+        }
+        Err(refusal) => {
+            let _ = transaction.rollback().await;
+            Err(refusal)
+        }
+    }
+}
+
+async fn run(
+    transaction: &mut Transaction,
+    command: &CheckInCommand,
+    parsed: &Parsed,
+) -> Result<CheckInResult, AccessError> {
+    let locked = sql::lock_appointment(transaction, parsed.appointment_id.clone())
+        .await
+        .map_err(|e| error::from_statement(&e))?
+        .ok_or_else(|| {
+            AccessError::missing(
+                AccessErrorKind::NotFound,
+                "appointment_id",
+                &command.appointment_id,
+            )
+        })?;
+    if locked.status != scalar::SCHEDULED {
+        return Err(AccessError::transition("status", &locked.status));
+    }
+
+    let arrived = sql::record_arrival(
+        transaction,
+        parsed.appointment_id.clone(),
+        parsed.arrived_at.clone(),
+    )
+    .await
+    .map_err(|e| error::from_statement(&e))?;
+
+    // The table's own check constraint ties a non-scheduled status to an arrival
+    // time, so an absent one here means the row no longer matches the contract.
+    let arrived_at = arrived.arrived_at.ok_or_else(|| {
+        AccessError::new(AccessErrorKind::InternalError, serde_json::json!({}))
+    })?;
+
+    Ok(CheckInResult {
+        appointment_id: arrived.id.0,
+        status: arrived.status,
+        arrived_at: scalar::wire_timestamp(&arrived_at),
+        row_version: arrived.row_version,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn an_unspellable_scalar_is_refused_before_any_statement() {
+        let mut command = CheckInCommand {
+            appointment_id: "not-a-uuid".to_owned(),
+            arrived_at: "2026-10-01T09:07:00Z".to_owned(),
+        };
+        assert_eq!(
+            parse(&command).unwrap_err().detail()["field"],
+            "appointment_id"
+        );
+
+        command.appointment_id = "00000000-0000-0000-0000-000000000301".to_owned();
+        command.arrived_at = "this morning".to_owned();
+        assert_eq!(parse(&command).unwrap_err().detail()["field"], "arrived_at");
+    }
+
+    /// The arrival the caller supplies reaches the database in the durable
+    /// spelling and comes back in the wire one.
+    #[test]
+    fn the_arrival_is_stored_canonically_and_answered_on_the_wire() {
+        let command = CheckInCommand {
+            appointment_id: "00000000-0000-0000-0000-000000000301".to_owned(),
+            arrived_at: "2026-10-01T09:07:00Z".to_owned(),
+        };
+        let parsed = parse(&command).unwrap();
+        assert_eq!(parsed.arrived_at.0, "2026-10-01T09:07:00.000000Z");
+        assert_eq!(
+            scalar::wire_timestamp(&parsed.arrived_at),
+            "2026-10-01T09:07:00Z"
+        );
+    }
+}
diff --git a/components/application/dock/src/dock.rs b/components/application/dock/src/dock.rs
new file mode 100644
index 00000000..1b2aaa78
--- /dev/null
+++ b/components/application/dock/src/dock.rs
@@ -0,0 +1,99 @@
+//! `dock.create` — one dock, minted once under its name.
+//!
+//! A dock is a physical door, so its name is the claim: the insert yields
+//! nothing when the name is already held, and the original row is read back. A
+//! second delivery of one create therefore returns the first dock id rather than
+//! opening a second door.
+
+use serde::Deserialize;
+use wamn_postgres_statements::Connection;
+
+use crate::error::{self, AccessError, AccessErrorKind};
+use crate::generated::wamn::dock_create as sql;
+use crate::scalar;
+
+pub(crate) const REFUSALS: &[AccessErrorKind] = &[
+    AccessErrorKind::InvalidInput,
+    AccessErrorKind::Retry,
+    AccessErrorKind::Timeout,
+    AccessErrorKind::PermissionDenied,
+    AccessErrorKind::InternalError,
+];
+
+/// One envelope item's command body.
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct CreateDock {
+    pub(crate) name: String,
+}
+
+/// What one accepted create answers with.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct DockResult {
+    pub(crate) dock_id: String,
+    pub(crate) name: String,
+}
+
+impl DockResult {
+    pub(crate) fn to_json(&self) -> serde_json::Value {
+        serde_json::json!({
+            "dock_id": self.dock_id,
+            "name": self.name,
+        })
+    }
+}
+
+/// Run one command item in exactly one transaction.
+///
+/// # Errors
+///
+/// [`AccessError`] carrying the literal and detail the operation contract
+/// declares for that refusal.
+pub(crate) async fn execute(command: &CreateDock) -> Result<DockResult, AccessError> {
+    let name = scalar::name("name", &command.name)?;
+
+    let mut connection = Connection::new();
+    let mut transaction = connection
+        .begin()
+        .await
+        .map_err(|e| error::from_statement(&e))?;
+
+    let claimed = sql::claim_dock(&mut transaction, name.clone())
+        .await
+        .map_err(|e| error::from_statement(&e));
+    let result = match claimed {
+        Ok(Some(row)) => Ok(DockResult {
+            dock_id: row.id.0,
+            name: row.name,
+        }),
+        Ok(None) => sql::find_dock(&mut transaction, name)
+            .await
+            .map_err(|e| error::from_statement(&e))
+            .and_then(|found| {
+                found
+                    .map(|row| DockResult {
+                        dock_id: row.id.0,
+                        name: row.name,
+                    })
+                    // The name was held when the insert ran and gone when the
+                    // read did. Nothing deletes a dock, so this is a concurrent
+                    // attempt still in flight: send the same create again.
+                    .ok_or_else(|| AccessError::new(AccessErrorKind::Retry, serde_json::json!({})))
+            }),
+        Err(refusal) => Err(refusal),
+    };
+
+    match result {
+        Ok(value) => {
+            transaction
+                .commit()
+                .await
+                .map_err(|e| error::from_statement(&e))?;
+            Ok(value)
+        }
+        Err(refusal) => {
+            let _ = transaction.rollback().await;
+            Err(refusal)
+        }
+    }
+}
diff --git a/components/application/dock/src/error.rs b/components/application/dock/src/error.rs
new file mode 100644
index 00000000..a4ff33fa
--- /dev/null
+++ b/components/application/dock/src/error.rs
@@ -0,0 +1,184 @@
+//! The refusals the Dock operations declare, and the one translation into them.
+//!
+//! Every literal here is one some operation's contract names. Each module lists
+//! what it can refuse with, and the test below holds every list to that
+//! operation's generated errors contract, so a caller never observes a class the
+//! contract it read did not promise.
+
+use std::error::Error;
+use std::fmt;
+
+use wamn_postgres_statements::{StatementError, StatementErrorKind};
+
+/// Stable operation-contract literal for one refusal.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum AccessErrorKind {
+    /// The body was not what the input contract admits.
+    InvalidInput,
+    /// The named appointment does not exist.
+    NotFound,
+    /// The named carrier does not exist.
+    CarrierNotFound,
+    /// The named dock does not exist.
+    DockNotFound,
+    /// The requested slot overlaps an appointment already on that dock.
+    SlotUnavailable,
+    /// A second delivery under one key carried a DIFFERENT command body.
+    IdempotencyConflict,
+    /// The appointment is not in the status this move starts from.
+    InvalidTransition,
+    /// Transient; the caller may send the same command again.
+    Retry,
+    /// The statement exceeded its time budget.
+    Timeout,
+    /// The caller may not invoke this operation.
+    PermissionDenied,
+    /// Anything the contract does not name. Deliberately opaque.
+    InternalError,
+}
+
+impl AccessErrorKind {
+    /// Frozen operation-contract literal.
+    #[must_use]
+    pub const fn literal(self) -> &'static str {
+        match self {
+            Self::InvalidInput => "invalid_input",
+            Self::NotFound => "not_found",
+            Self::CarrierNotFound => "carrier_not_found",
+            Self::DockNotFound => "dock_not_found",
+            Self::SlotUnavailable => "slot_unavailable",
+            Self::IdempotencyConflict => "idempotency_conflict",
+            Self::InvalidTransition => "invalid_transition",
+            Self::Retry => "retry",
+            Self::Timeout => "timeout",
+            Self::PermissionDenied => "permission_denied",
+            Self::InternalError => "internal_error",
+        }
+    }
+}
+
+/// One refusal, with the structured detail its literal declares.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct AccessError {
+    kind: AccessErrorKind,
+    detail: serde_json::Value,
+}
+
+impl AccessError {
+    /// A refusal carrying the detail members its literal requires.
+    #[must_use]
+    pub fn new(kind: AccessErrorKind, detail: serde_json::Value) -> Self {
+        Self { kind, detail }
+    }
+
+    /// A refusal naming the offending field.
+    #[must_use]
+    pub fn field(kind: AccessErrorKind, field: &str) -> Self {
+        Self::new(kind, serde_json::json!({ "field": field }))
+    }
+
+    /// A refusal that names the field AND the id it looked for.
+    #[must_use]
+    pub fn missing(kind: AccessErrorKind, field: &str, id: &str) -> Self {
+        Self::new(kind, serde_json::json!({ "field": field, "id": id }))
+    }
+
+    /// A move refused by the status the row actually carries.
+    #[must_use]
+    pub fn transition(field: &str, observed: &str) -> Self {
+        Self::new(
+            AccessErrorKind::InvalidTransition,
+            serde_json::json!({ "field": field, "observed": observed }),
+        )
+    }
+
+    /// What went wrong.
+    #[must_use]
+    pub const fn kind(&self) -> AccessErrorKind {
+        self.kind
+    }
+
+    /// The declared detail members.
+    #[must_use]
+    pub const fn detail(&self) -> &serde_json::Value {
+        &self.detail
+    }
+}
+
+impl fmt::Display for AccessError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "{}", self.kind.literal())
+    }
+}
+
+impl Error for AccessError {}
+
+/// The ONE translation of a statement failure into the contract vocabulary.
+///
+/// Every unmapped kind lands on `internal_error` rather than leaking a class the
+/// contract never named: an unknown statement or a contract mismatch is a
+/// deployment fault, not something a caller can act on.
+#[must_use]
+pub fn from_statement(error: &StatementError) -> AccessError {
+    let kind = match error.kind() {
+        StatementErrorKind::SerializationFailure | StatementErrorKind::ConnectionUnavailable => {
+            AccessErrorKind::Retry
+        }
+        StatementErrorKind::StatementTimeout => AccessErrorKind::Timeout,
+        StatementErrorKind::PermissionDenied => AccessErrorKind::PermissionDenied,
+        _ => AccessErrorKind::InternalError,
+    };
+    AccessError::new(kind, serde_json::json!({}))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Every literal an operation can produce is one ITS contract declares.
+    /// The lists are the modules' own; a refusal added to a module without being
+    /// added to the manifest fails here, before a caller sees it.
+    #[test]
+    fn every_operation_refuses_only_what_its_contract_declares() {
+        let contracts: [(&str, &[AccessErrorKind]); 5] = [
+            ("appointment/book", crate::book::REFUSALS),
+            ("appointment/check_in", crate::check_in::REFUSALS),
+            ("appointment/query", crate::query::REFUSALS),
+            ("carrier/create", crate::carrier::REFUSALS),
+            ("dock/create", crate::dock::REFUSALS),
+        ];
+        for (operation, refusals) in contracts {
+            let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+                .join("../../../packages/dock/generated/contracts")
+                .join(format!("{operation}.errors.json"));
+            let contract: serde_json::Value = serde_json::from_slice(
+                &std::fs::read(&path).unwrap_or_else(|error| panic!("{}: {error}", path.display())),
+            )
+            .expect("parses");
+            let declared: Vec<&str> = contract["cases"]
+                .as_array()
+                .expect("cases")
+                .iter()
+                .map(|case| case["literal"].as_str().expect("literal"))
+                .collect();
+            assert!(
+                !refusals.is_empty(),
+                "{operation} lists what it refuses with"
+            );
+            for kind in refusals {
+                assert!(
+                    declared.contains(&kind.literal()),
+                    "{operation}: {} is not declared by the contract: {declared:?}",
+                    kind.literal()
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn a_transition_refusal_carries_the_status_the_row_actually_holds() {
+        let error = AccessError::transition("status", "arrived");
+        assert_eq!(error.kind().literal(), "invalid_transition");
+        assert_eq!(error.detail()["observed"], "arrived");
+    }
+}
