diff --git a/components/application/dock/src/book.rs b/components/application/dock/src/book.rs
new file mode 100644
index 00000000..f941c1e7
--- /dev/null
+++ b/components/application/dock/src/book.rs
@@ -0,0 +1,331 @@
+//! `appointment.book` — the contended command.
+//!
+//! One carrier joined to one dock for one slot, transactionally, under an
+//! idempotency key. The generator wrote every statement and its decoding; what is
+//! authored here is the ORDER those statements run in and what each refusal
+//! means.
+//!
+//! # The shape of one item
+//!
+//! ```text
+//! canonicalize the body
+//! → find a replay: same key ⇒ return the ORIGINAL result, unchanged
+//! → claim the key, which pre-generates the appointment id
+//! → lock the dock            (the serialization point)
+//! → validate the carrier
+//! → probe the slot for an overlap
+//! → insert the appointment under the claimed id
+//! ```
+//!
+//! THE DOCK ROW IS WHAT MAKES TWO BOOKINGS SERIALIZE. Two overlapping bookings
+//! on one dock both reach the lock; the second waits, then sees the first
+//! appointment and is refused. Without the lock both would probe an empty slot
+//! and both would insert.
+//!
+//! The claim and the insert commit together, so a claim never outlives the
+//! appointment it minted the id for, and a refused booking frees its key.
+
+use serde::Deserialize;
+use wamn_postgres_statements::{Connection, TimestampTz, Transaction, Uuid};
+
+use crate::error::{self, AccessError, AccessErrorKind};
+use crate::generated::wamn::appointment_book as sql;
+use crate::scalar;
+
+pub(crate) const REFUSALS: &[AccessErrorKind] = &[
+    AccessErrorKind::InvalidInput,
+    AccessErrorKind::CarrierNotFound,
+    AccessErrorKind::DockNotFound,
+    AccessErrorKind::SlotUnavailable,
+    AccessErrorKind::IdempotencyConflict,
+    AccessErrorKind::Retry,
+    AccessErrorKind::Timeout,
+    AccessErrorKind::PermissionDenied,
+    AccessErrorKind::InternalError,
+];
+
+/// One envelope item's command body.
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct BookCommand {
+    pub(crate) idempotency_key: String,
+    pub(crate) carrier_id: String,
+    pub(crate) dock_id: String,
+    pub(crate) slot_start: String,
+    pub(crate) slot_end: String,
+}
+
+/// What one accepted booking answers with.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct BookResult {
+    pub(crate) appointment_id: String,
+    pub(crate) carrier_id: String,
+    pub(crate) dock_id: String,
+    pub(crate) slot_start: String,
+    pub(crate) slot_end: String,
+    pub(crate) status: String,
+    pub(crate) row_version: i64,
+}
+
+impl BookResult {
+    pub(crate) fn to_json(&self) -> serde_json::Value {
+        serde_json::json!({
+            "appointment_id": self.appointment_id,
+            "carrier_id": self.carrier_id,
+            "dock_id": self.dock_id,
+            "slot_start": self.slot_start,
+            "slot_end": self.slot_end,
+            "status": self.status,
+            "row_version": self.row_version,
+        })
+    }
+}
+
+/// The command's scalars in their one durable spelling.
+#[derive(Debug)]
+struct Parsed {
+    carrier_id: Uuid,
+    dock_id: Uuid,
+    slot_start: TimestampTz,
+    slot_end: TimestampTz,
+}
+
+fn parse(command: &BookCommand) -> Result<Parsed, AccessError> {
+    let parsed = Parsed {
+        carrier_id: scalar::uuid("carrier_id", &command.carrier_id)?,
+        dock_id: scalar::uuid("dock_id", &command.dock_id)?,
+        slot_start: scalar::timestamp("slot_start", &command.slot_start)?,
+        slot_end: scalar::timestamp("slot_end", &command.slot_end)?,
+    };
+    // A slot is a start and an end, and an end that does not follow its start is
+    // not a slot. The table refuses it too, but a check violation reads as
+    // `internal_error`, which tells the caller nothing.
+    if parsed.slot_end.0 <= parsed.slot_start.0 {
+        return Err(AccessError::field(
+            AccessErrorKind::InvalidInput,
+            "slot_end",
+        ));
+    }
+    if command.idempotency_key.is_empty() {
+        return Err(AccessError::field(
+            AccessErrorKind::InvalidInput,
+            "idempotency_key",
+        ));
+    }
+    Ok(parsed)
+}
+
+/// The bytes the idempotency key keys: the RE-SPELLED command, so two deliveries
+/// of one booking canonicalize alike whatever case or offset each was written in.
+///
+/// The key itself and `request_id` are EXCLUDED: two deliveries of one operator
+/// action differ in neither the dock booked nor the slot, only in the envelope
+/// that carried them.
+fn canonical_command(parsed: &Parsed) -> Vec<u8> {
+    wamn_execution_contract::canonical_json_bytes(&serde_json::json!({
+        "carrier_id": parsed.carrier_id.0,
+        "dock_id": parsed.dock_id.0,
+        "slot_start": parsed.slot_start.0,
+        "slot_end": parsed.slot_end.0,
+    }))
+}
+
+/// Run one command item in exactly one transaction.
+///
+/// # Errors
+///
+/// [`AccessError`] carrying the literal and detail the operation contract
+/// declares for that refusal.
+pub(crate) async fn execute(command: &BookCommand) -> Result<BookResult, AccessError> {
+    let parsed = parse(command)?;
+    let canonical = canonical_command(&parsed);
+
+    let mut connection = Connection::new();
+    let mut transaction = connection
+        .begin()
+        .await
+        .map_err(|e| error::from_statement(&e))?;
+    match run(&mut transaction, command, &canonical, &parsed).await {
+        Ok(value) => {
+            transaction
+                .commit()
+                .await
+                .map_err(|e| error::from_statement(&e))?;
+            Ok(value)
+        }
+        // Dropping the transaction rolls it back; the explicit rollback makes the
+        // refusal path say so rather than relying on a Drop nobody reads.
+        Err(refusal) => {
+            let _ = transaction.rollback().await;
+            Err(refusal)
+        }
+    }
+}
+
+async fn run(
+    transaction: &mut Transaction,
+    command: &BookCommand,
+    canonical: &[u8],
+    parsed: &Parsed,
+) -> Result<BookResult, AccessError> {
+    // A REPLAY RETURNS THE ORIGINAL RESULT, unchanged. Not a fresh execution that
+    // happens to agree: the claim row holds the appointment id the first attempt
+    // minted, and the appointment row holds what it decided.
+    if let Some(replay) = sql::find_replay(transaction, command.idempotency_key.clone())
+        .await
+        .map_err(|e| error::from_statement(&e))?
+    {
+        if replay.canonical_command != canonical {
+            // Same key, different command. That is two bookings wearing one
+            // identity, and answering either would be wrong.
+            return Err(AccessError::field(
+                AccessErrorKind::IdempotencyConflict,
+                "idempotency_key",
+            ));
+        }
+        return Ok(BookResult {
+            appointment_id: replay.appointment_id.0,
+            carrier_id: replay.carrier_id.0,
+            dock_id: replay.dock_id.0,
+            slot_start: scalar::wire_timestamp(&replay.slot_start),
+            slot_end: scalar::wire_timestamp(&replay.slot_end),
+            status: replay.status,
+            row_version: replay.row_version,
+        });
+    }
+
+    let claim = sql::claim_book(
+        transaction,
+        command.idempotency_key.clone(),
+        canonical.to_vec(),
+    )
+    .await
+    .map_err(|e| error::from_statement(&e))?
+    // The key was free when the replay read ran and held when the insert did:
+    // a concurrent delivery of this same command won it and has not committed.
+    .ok_or_else(|| AccessError::new(AccessErrorKind::Retry, serde_json::json!({})))?;
+
+    // THE SERIALIZATION POINT. It also proves the dock exists.
+    sql::lock_dock(transaction, parsed.dock_id.clone())
+        .await
+        .map_err(|e| error::from_statement(&e))?
+        .ok_or_else(|| {
+            AccessError::missing(AccessErrorKind::DockNotFound, "dock_id", &command.dock_id)
+        })?;
+
+    sql::validate_carrier(transaction, parsed.carrier_id.clone())
+        .await
+        .map_err(|e| error::from_statement(&e))?
+        .ok_or_else(|| {
+            AccessError::missing(
+                AccessErrorKind::CarrierNotFound,
+                "carrier_id",
+                &command.carrier_id,
+            )
+        })?;
+
+    if let Some(overlap) = sql::find_overlap(
+        transaction,
+        parsed.dock_id.clone(),
+        parsed.slot_start.clone(),
+        parsed.slot_end.clone(),
+    )
+    .await
+    .map_err(|e| error::from_statement(&e))?
+    {
+        return Err(AccessError::missing(
+            AccessErrorKind::SlotUnavailable,
+            "slot_start",
+            &overlap.id.0,
+        ));
+    }
+
+    let booked = sql::insert_appointment(
+        transaction,
+        claim.appointment_id.clone(),
+        parsed.carrier_id.clone(),
+        parsed.dock_id.clone(),
+        parsed.slot_start.clone(),
+        parsed.slot_end.clone(),
+    )
+    .await
+    .map_err(|e| error::from_statement(&e))?;
+
+    Ok(BookResult {
+        appointment_id: booked.id.0,
+        carrier_id: booked.carrier_id.0,
+        dock_id: booked.dock_id.0,
+        slot_start: scalar::wire_timestamp(&booked.slot_start),
+        slot_end: scalar::wire_timestamp(&booked.slot_end),
+        status: booked.status,
+        row_version: booked.row_version,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn command(dock_id: &str, slot_start: &str) -> BookCommand {
+        BookCommand {
+            idempotency_key: "k".to_owned(),
+            carrier_id: "00000000-0000-0000-0000-000000000101".to_owned(),
+            dock_id: dock_id.to_owned(),
+            slot_start: slot_start.to_owned(),
+            slot_end: "2026-10-01T10:00:00Z".to_owned(),
+        }
+    }
+
+    fn bytes(command: &BookCommand) -> Vec<u8> {
+        canonical_command(&parse(command).unwrap())
+    }
+
+    /// Two spellings of one booking are ONE command under the key: the canonical
+    /// bytes come from the respelled scalars, not the caller's.
+    #[test]
+    fn the_canonical_command_is_spelling_independent_and_excludes_the_key() {
+        let upper = command("00000000-0000-0000-0000-00000000020A", "2026-10-01T11:00:00+02:00");
+        let lower = command("00000000-0000-0000-0000-00000000020a", "2026-10-01T09:00:00.000000Z");
+        let mut other_key = command("00000000-0000-0000-0000-00000000020a", "2026-10-01T09:00:00Z");
+        other_key.idempotency_key = "different".to_owned();
+
+        assert_eq!(bytes(&upper), bytes(&lower));
+        assert_eq!(bytes(&lower), bytes(&other_key));
+        assert!(
+            !String::from_utf8(bytes(&lower))
+                .unwrap()
+                .contains("idempotency_key")
+        );
+    }
+
+    /// A booking that differs in WHAT it books is a different command, so the
+    /// bytes must separate one from another. This is the difference the replay
+    /// path refuses `idempotency_conflict` on.
+    #[test]
+    fn a_different_slot_is_a_different_command() {
+        let here = command("00000000-0000-0000-0000-00000000020a", "2026-10-01T09:00:00Z");
+        let mut there = command("00000000-0000-0000-0000-00000000020a", "2026-10-01T09:00:00Z");
+        there.slot_start = "2026-10-01T14:00:00Z".to_owned();
+        there.slot_end = "2026-10-01T15:00:00Z".to_owned();
+        assert_ne!(bytes(&here), bytes(&there));
+    }
+
+    #[test]
+    fn an_unspellable_or_inverted_slot_is_refused_before_any_statement() {
+        let mut refused = command("not-a-uuid", "2026-10-01T09:00:00Z");
+        assert_eq!(parse(&refused).unwrap_err().detail()["field"], "dock_id");
+
+        refused = command("00000000-0000-0000-0000-00000000020a", "yesterday");
+        assert_eq!(parse(&refused).unwrap_err().detail()["field"], "slot_start");
+
+        refused = command("00000000-0000-0000-0000-00000000020a", "2026-10-01T10:00:00Z");
+        assert_eq!(parse(&refused).unwrap_err().detail()["field"], "slot_end");
+
+        refused = command("00000000-0000-0000-0000-00000000020a", "2026-10-01T09:00:00Z");
+        refused.idempotency_key = String::new();
+        assert_eq!(
+            parse(&refused).unwrap_err().detail()["field"],
+            "idempotency_key"
+        );
+    }
+}
diff --git a/components/application/dock/src/carrier.rs b/components/application/dock/src/carrier.rs
new file mode 100644
index 00000000..777300e1
--- /dev/null
+++ b/components/application/dock/src/carrier.rs
@@ -0,0 +1,100 @@
+//! `carrier.create` — one carrier, minted once under its name.
+//!
+//! The request carries no idempotency key, so the NAME is the claim: the insert
+//! yields nothing when the name is already held, and the original row is read
+//! back. A second delivery of one create therefore returns the first carrier id
+//! rather than minting a second identity for one carrier.
+
+use serde::Deserialize;
+use wamn_postgres_statements::Connection;
+
+use crate::error::{self, AccessError, AccessErrorKind};
+use crate::generated::wamn::carrier_create as sql;
+use crate::scalar;
+
+pub(crate) const REFUSALS: &[AccessErrorKind] = &[
+    AccessErrorKind::InvalidInput,
+    AccessErrorKind::Retry,
+    AccessErrorKind::Timeout,
+    AccessErrorKind::PermissionDenied,
+    AccessErrorKind::InternalError,
+];
+
+/// One envelope item's command body.
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct CreateCarrier {
+    pub(crate) name: String,
+}
+
+/// What one accepted create answers with.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct CarrierResult {
+    pub(crate) carrier_id: String,
+    pub(crate) name: String,
+}
+
+impl CarrierResult {
+    pub(crate) fn to_json(&self) -> serde_json::Value {
+        serde_json::json!({
+            "carrier_id": self.carrier_id,
+            "name": self.name,
+        })
+    }
+}
+
+/// Run one command item in exactly one transaction.
+///
+/// # Errors
+///
+/// [`AccessError`] carrying the literal and detail the operation contract
+/// declares for that refusal.
+pub(crate) async fn execute(command: &CreateCarrier) -> Result<CarrierResult, AccessError> {
+    let name = scalar::name("name", &command.name)?;
+
+    let mut connection = Connection::new();
+    let mut transaction = connection
+        .begin()
+        .await
+        .map_err(|e| error::from_statement(&e))?;
+
+    let claimed = sql::claim_carrier(&mut transaction, name.clone())
+        .await
+        .map_err(|e| error::from_statement(&e));
+    let result = match claimed {
+        Ok(Some(row)) => Ok(CarrierResult {
+            carrier_id: row.id.0,
+            name: row.name,
+        }),
+        Ok(None) => sql::find_carrier(&mut transaction, name)
+            .await
+            .map_err(|e| error::from_statement(&e))
+            .and_then(|found| {
+                found
+                    .map(|row| CarrierResult {
+                        carrier_id: row.id.0,
+                        name: row.name,
+                    })
+                    // The name was held when the insert ran and gone when the
+                    // read did. Nothing deletes a carrier, so this is a
+                    // concurrent attempt still in flight: send the same create
+                    // again.
+                    .ok_or_else(|| AccessError::new(AccessErrorKind::Retry, serde_json::json!({})))
+            }),
+        Err(refusal) => Err(refusal),
+    };
+
+    match result {
+        Ok(value) => {
+            transaction
+                .commit()
+                .await
+                .map_err(|e| error::from_statement(&e))?;
+            Ok(value)
+        }
+        Err(refusal) => {
+            let _ = transaction.rollback().await;
+            Err(refusal)
+        }
+    }
+}
