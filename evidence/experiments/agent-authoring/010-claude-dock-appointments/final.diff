diff --git a/components/application/dock/src/lib.rs b/components/application/dock/src/lib.rs
new file mode 100644
index 00000000..1297511a
--- /dev/null
+++ b/components/application/dock/src/lib.rs
@@ -0,0 +1,106 @@
+#![expect(
+    clippy::same_length_and_capacity,
+    reason = "wit-bindgen emits Vec::from_raw_parts with equal length and capacity"
+)]
+
+//! One package-grain component exporting every Dock appointment operation.
+//!
+//! Runtime access uses content-addressed [`wamn_postgres_statements`] accessors
+//! and the generated Wamn projections; this crate authors no SQL. Every command
+//! follows the law the authored SQL already obeys: the identity a booking hands
+//! out comes from its claim, never from the work.
+
+mod book;
+mod carrier;
+mod check_in;
+mod dock;
+mod error;
+mod generated;
+pub mod operation;
+mod query;
+mod scalar;
+
+pub use error::{AccessError, AccessErrorKind};
+
+use exports::wamn_dock::appointment::book::Guest as AppointmentBook;
+use exports::wamn_dock::appointment::check_in::Guest as AppointmentCheckIn;
+use exports::wamn_dock::appointment::query::Guest as AppointmentQuery;
+use exports::wamn_dock::carrier::create::Guest as CarrierCreate;
+use exports::wamn_dock::dock::create::Guest as DockCreate;
+use wamn::node::types::{Emission, ErrorDetail, NodeContext, NodeError};
+
+wit_bindgen::generate!({
+    world: "wamn:dock-component/dock@0.1.0",
+    inline: r#"
+        package wamn:dock-component@0.1.0;
+
+        world dock {
+          import wamn:postgres/types@0.1.0;
+          import wamn:postgres/statements@0.1.0;
+          export wamn-dock:carrier/create@1.0.0;
+          export wamn-dock:dock/create@1.0.0;
+          export wamn-dock:appointment/book@1.0.0;
+          export wamn-dock:appointment/check-in@1.0.0;
+          export wamn-dock:appointment/query@1.0.0;
+        }
+    "#,
+    path: [
+        "../../data/receiving-data/wit/deps/wamn-node",
+        "../../data/receiving-data/wit/deps/wamn-postgres",
+        "wit/deps/wamn-dock-appointment",
+        "wit/deps/wamn-dock-carrier",
+        "wit/deps/wamn-dock-dock",
+    ],
+    generate_all,
+});
+
+struct Component;
+
+fn invoke<F>(operation: F) -> Result<Emission, NodeError>
+where
+    F: Future<Output = Result<String, operation::InvocationError>>,
+{
+    futures_executor::block_on(operation)
+        .map(|payload| Emission {
+            payload,
+            port: None,
+        })
+        .map_err(|error| {
+            NodeError::InvalidInput(ErrorDetail {
+                message: error.context().to_owned(),
+                code: Some(error.code().to_owned()),
+            })
+        })
+}
+
+impl CarrierCreate for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(operation::carrier_create(&input))
+    }
+}
+
+impl DockCreate for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(operation::dock_create(&input))
+    }
+}
+
+impl AppointmentBook for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(operation::appointment_book(&input))
+    }
+}
+
+impl AppointmentCheckIn for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(operation::appointment_check_in(&input))
+    }
+}
+
+impl AppointmentQuery for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(operation::appointment_query(&input))
+    }
+}
+
+export!(Component);
diff --git a/components/application/dock/src/operation.rs b/components/application/dock/src/operation.rs
new file mode 100644
index 00000000..90d8cfe7
--- /dev/null
+++ b/components/application/dock/src/operation.rs
@@ -0,0 +1,268 @@
+//! The array envelope, and the five operations this component exports.
+//!
+//! Every registered operation takes an array and returns a correlated array, and
+//! each outer item executes INDEPENDENTLY under `per_input` semantics: one item's
+//! refusal does not roll back its neighbours, because each holds its own
+//! transaction.
+//!
+//! One item shape, for reads and commands alike: the item IS its body, beside the
+//! `request_id` that correlates the answer.
+
+use serde::de::DeserializeOwned;
+use serde::{Deserialize, Serialize};
+use serde_json::{Map, Value};
+
+use crate::error::{AccessError, AccessErrorKind};
+use crate::{book, carrier, check_in, dock, query};
+
+/// Hard bound from the operation contracts' envelope declaration.
+const MAX_ITEMS: usize = 100;
+
+/// A whole-invocation failure: the envelope itself was not admissible, so no
+/// item ran and there is nothing to correlate.
+#[derive(Debug)]
+pub struct InvocationError {
+    code: &'static str,
+    context: String,
+}
+
+impl InvocationError {
+    fn new(code: &'static str, context: impl Into<String>) -> Self {
+        Self {
+            code,
+            context: context.into(),
+        }
+    }
+
+    /// Stable refusal literal.
+    #[must_use]
+    pub const fn code(&self) -> &'static str {
+        self.code
+    }
+
+    /// What was wrong with the envelope.
+    #[must_use]
+    pub fn context(&self) -> &str {
+        &self.context
+    }
+}
+
+#[derive(Debug, Deserialize)]
+struct EnvelopeItem {
+    request_id: String,
+    #[serde(flatten)]
+    body: Map<String, Value>,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(untagged)]
+enum ItemResult {
+    Succeeded { request_id: String, value: Value },
+    Refused { request_id: String, error: Value },
+}
+
+fn prepare_envelope(input: &str) -> Result<Vec<EnvelopeItem>, InvocationError> {
+    let items: Vec<EnvelopeItem> = serde_json::from_str(input)
+        .map_err(|error| InvocationError::new("invalid_input", error.to_string()))?;
+    if items.is_empty() {
+        return Err(InvocationError::new(
+            "invalid_input",
+            "an envelope carries at least one item",
+        ));
+    }
+    if items.len() > MAX_ITEMS {
+        return Err(InvocationError::new(
+            "invalid_input",
+            format!("an envelope carries at most {MAX_ITEMS} items"),
+        ));
+    }
+    Ok(items)
+}
+
+/// The item's body: the item itself, less its correlation id.
+fn body<T: DeserializeOwned>(body: Map<String, Value>) -> Result<T, AccessError> {
+    serde_json::from_value(Value::Object(body)).map_err(|error| {
+        AccessError::new(
+            AccessErrorKind::InvalidInput,
+            serde_json::json!({ "field": error.to_string() }),
+        )
+    })
+}
+
+fn outcome(request_id: String, result: Result<Value, AccessError>) -> ItemResult {
+    match result {
+        Ok(value) => ItemResult::Succeeded { request_id, value },
+        Err(error) => ItemResult::Refused {
+            request_id,
+            error: serde_json::json!({
+                "code": error.kind().literal(),
+                "detail": error.detail(),
+            }),
+        },
+    }
+}
+
+fn serialized(output: &[ItemResult]) -> String {
+    serde_json::to_string(output).expect("closed operation results always serialize")
+}
+
+/// Execute only `carrier.create`.
+///
+/// # Errors
+///
+/// [`InvocationError`] when the ENVELOPE is inadmissible. A single item's refusal
+/// is carried in that item's result instead, so its neighbours still report what
+/// they did.
+pub async fn carrier_create(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut output = Vec::with_capacity(items.len());
+    for item in items {
+        let result = match body::<carrier::CreateCarrier>(item.body) {
+            Ok(command) => carrier::execute(&command).await.map(|value| value.to_json()),
+            Err(error) => Err(error),
+        };
+        output.push(outcome(item.request_id, result));
+    }
+    Ok(serialized(&output))
+}
+
+/// Execute only `dock.create`.
+///
+/// # Errors
+///
+/// [`InvocationError`] when the ENVELOPE is inadmissible.
+pub async fn dock_create(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut output = Vec::with_capacity(items.len());
+    for item in items {
+        let result = match body::<dock::CreateDock>(item.body) {
+            Ok(command) => dock::execute(&command).await.map(|value| value.to_json()),
+            Err(error) => Err(error),
+        };
+        output.push(outcome(item.request_id, result));
+    }
+    Ok(serialized(&output))
+}
+
+/// Execute only `appointment.book`.
+///
+/// # Errors
+///
+/// [`InvocationError`] when the ENVELOPE is inadmissible.
+pub async fn appointment_book(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut output = Vec::with_capacity(items.len());
+    for item in items {
+        let result = match body::<book::BookCommand>(item.body) {
+            Ok(command) => book::execute(&command).await.map(|value| value.to_json()),
+            Err(error) => Err(error),
+        };
+        output.push(outcome(item.request_id, result));
+    }
+    Ok(serialized(&output))
+}
+
+/// Execute only `appointment.check_in`.
+///
+/// # Errors
+///
+/// [`InvocationError`] when the ENVELOPE is inadmissible.
+pub async fn appointment_check_in(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut output = Vec::with_capacity(items.len());
+    for item in items {
+        let result = match body::<check_in::CheckInCommand>(item.body) {
+            Ok(command) => check_in::execute(&command).await.map(|value| value.to_json()),
+            Err(error) => Err(error),
+        };
+        output.push(outcome(item.request_id, result));
+    }
+    Ok(serialized(&output))
+}
+
+/// Execute only `appointment.query`.
+///
+/// # Errors
+///
+/// [`InvocationError`] when the ENVELOPE is inadmissible.
+pub async fn appointment_query(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut output = Vec::with_capacity(items.len());
+    for item in items {
+        let result = match body::<query::QueryInput>(item.body) {
+            Ok(input) => query::execute(&input).await.map(|page| page.to_json()),
+            Err(error) => Err(error),
+        };
+        output.push(outcome(item.request_id, result));
+    }
+    Ok(serialized(&output))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// An envelope that is not an array is a WHOLE-INVOCATION refusal: there are
+    /// no items to correlate a per-item error with.
+    #[test]
+    fn a_non_array_envelope_refuses_the_invocation() {
+        let error = prepare_envelope("{}").expect_err("an object is not an envelope");
+        assert_eq!(error.code(), "invalid_input");
+        assert!(prepare_envelope("[]").is_err());
+    }
+
+    /// The bound is the contract's, and exceeding it refuses before any item
+    /// runs: a caller learns the envelope was too large rather than watching the
+    /// first hundred succeed.
+    #[test]
+    fn an_oversized_envelope_refuses_before_any_item_runs() {
+        let item = r#"{"request_id":"r","name":"Door 7"}"#;
+        let oversized = format!("[{}]", vec![item; MAX_ITEMS + 1].join(","));
+        let error = prepare_envelope(&oversized).expect_err("101 items refuse");
+        assert!(error.context().contains("100"), "{}", error.context());
+
+        let exact = format!("[{}]", vec![item; MAX_ITEMS].join(","));
+        assert!(prepare_envelope(&exact).is_ok(), "100 items are admissible");
+    }
+
+    /// A missing correlation id refuses the whole envelope; a malformed body
+    /// refuses only its item, naming what was wrong.
+    #[test]
+    fn the_correlation_id_is_the_envelopes_and_the_body_is_the_items() {
+        assert!(prepare_envelope(r#"[{"id":"x"}]"#).is_err());
+
+        let items = prepare_envelope(
+            r#"[{"request_id":"a","name":"Door 7"},{"request_id":"b","surplus":true}]"#,
+        )
+        .unwrap();
+        assert_eq!(items[0].request_id, "a");
+        assert_eq!(
+            body::<dock::CreateDock>(items[0].body.clone()).unwrap().name,
+            "Door 7"
+        );
+        let error = body::<dock::CreateDock>(items[1].body.clone()).unwrap_err();
+        assert_eq!(error.kind(), AccessErrorKind::InvalidInput);
+        assert!(
+            error.detail()["field"]
+                .as_str()
+                .unwrap()
+                .contains("unknown field")
+        );
+    }
+
+    #[test]
+    fn a_refusal_serializes_as_code_and_detail_beside_its_request_id() {
+        let output = [outcome(
+            "r".to_owned(),
+            Err(AccessError::missing(
+                AccessErrorKind::NotFound,
+                "appointment_id",
+                "x",
+            )),
+        )];
+        assert_eq!(
+            serialized(&output),
+            r#"[{"request_id":"r","error":{"code":"not_found","detail":{"field":"appointment_id","id":"x"}}}]"#
+        );
+    }
+}
diff --git a/components/application/dock/src/query.rs b/components/application/dock/src/query.rs
new file mode 100644
index 00000000..ca09a57b
--- /dev/null
+++ b/components/application/dock/src/query.rs
@@ -0,0 +1,150 @@
+//! `appointment.query` — one dock's day, filtered by status and slot-ordered.
+//!
+//! The order is the SQL's, not the guest's: the statement orders by slot start
+//! and breaks ties by id, so two appointments that begin together still come back
+//! in one stable order.
+
+use serde::Deserialize;
+use serde_json::{Value, json};
+use wamn_postgres_statements::Connection;
+
+use crate::error::{self, AccessError, AccessErrorKind};
+use crate::generated::wamn::appointment_query as sql;
+use crate::scalar;
+
+pub(crate) const REFUSALS: &[AccessErrorKind] = &[
+    AccessErrorKind::InvalidInput,
+    AccessErrorKind::Retry,
+    AccessErrorKind::Timeout,
+    AccessErrorKind::PermissionDenied,
+    AccessErrorKind::InternalError,
+];
+
+/// One envelope item's read body.
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct QueryInput {
+    pub(crate) dock_id: String,
+    pub(crate) day: String,
+    pub(crate) status: String,
+}
+
+/// One dock's appointments for one day, in slot order.
+#[derive(Debug)]
+pub(crate) struct AppointmentPage {
+    rows: Vec<sql::AppointmentByDockDayRow>,
+}
+
+impl AppointmentPage {
+    pub(crate) fn to_json(&self) -> Value {
+        json!({
+            "appointments": self
+                .rows
+                .iter()
+                .map(|row| {
+                    json!({
+                        "appointment_id": row.id.0,
+                        "carrier_id": row.carrier_id.0,
+                        "dock_id": row.dock_id.0,
+                        "slot_start": scalar::wire_timestamp(&row.slot_start),
+                        "slot_end": scalar::wire_timestamp(&row.slot_end),
+                        "status": row.status,
+                        "arrived_at": row
+                            .arrived_at
+                            .as_ref()
+                            .map_or(Value::Null, |value| Value::String(scalar::wire_timestamp(value))),
+                        "row_version": row.row_version,
+                    })
+                })
+                .collect::<Vec<_>>(),
+        })
+    }
+}
+
+/// Read one dock's day.
+///
+/// # Errors
+///
+/// [`AccessError`] carrying the literal the operation contract declares.
+pub(crate) async fn execute(input: &QueryInput) -> Result<AppointmentPage, AccessError> {
+    let dock_id = scalar::uuid("dock_id", &input.dock_id)?;
+    let status = scalar::status("status", &input.status)?;
+    let (day_start, day_end) = scalar::day_bounds("day", &input.day)?;
+
+    let mut connection = Connection::new();
+    let mut transaction = connection
+        .begin()
+        .await
+        .map_err(|e| error::from_statement(&e))?;
+    let rows = sql::appointment_by_dock_day(&mut transaction, dock_id, status, day_start, day_end)
+        .await
+        .map_err(|e| error::from_statement(&e));
+    match rows {
+        Ok(rows) => {
+            transaction
+                .commit()
+                .await
+                .map_err(|e| error::from_statement(&e))?;
+            Ok(AppointmentPage { rows })
+        }
+        Err(refusal) => {
+            let _ = transaction.rollback().await;
+            Err(refusal)
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use wamn_postgres_statements::{TimestampTz, Uuid};
+
+    fn row(id: &str, slot_start: &str, arrived_at: Option<&str>) -> sql::AppointmentByDockDayRow {
+        sql::AppointmentByDockDayRow {
+            id: Uuid(id.to_owned()),
+            carrier_id: Uuid("00000000-0000-0000-0000-000000000101".to_owned()),
+            dock_id: Uuid("00000000-0000-0000-0000-000000000201".to_owned()),
+            slot_start: TimestampTz(slot_start.to_owned()),
+            slot_end: TimestampTz("2026-10-01T12:00:00.000000+00:00".to_owned()),
+            status: "scheduled".to_owned(),
+            arrived_at: arrived_at.map(|value| TimestampTz(value.to_owned())),
+            row_version: 1,
+        }
+    }
+
+    /// The answer keeps the SQL's order and spells every instant on the wire.
+    #[test]
+    fn the_page_answers_under_appointments_in_the_order_the_statement_returned() {
+        let page = AppointmentPage {
+            rows: vec![
+                row(
+                    "00000000-0000-0000-0000-000000000301",
+                    "2026-10-01T09:00:00.000000+00:00",
+                    None,
+                ),
+                row(
+                    "00000000-0000-0000-0000-000000000302",
+                    "2026-10-01T11:00:00.000000+00:00",
+                    Some("2026-10-01T11:04:00.000000+00:00"),
+                ),
+            ],
+        };
+        let value = page.to_json();
+        let appointments = value["appointments"].as_array().unwrap();
+        assert_eq!(appointments.len(), 2);
+        assert_eq!(appointments[0]["slot_start"], "2026-10-01T09:00:00Z");
+        assert_eq!(appointments[1]["slot_start"], "2026-10-01T11:00:00Z");
+        assert_eq!(appointments[0]["arrived_at"], Value::Null);
+        assert_eq!(appointments[1]["arrived_at"], "2026-10-01T11:04:00Z");
+        assert_eq!(
+            appointments[0]["appointment_id"],
+            "00000000-0000-0000-0000-000000000301"
+        );
+    }
+
+    #[test]
+    fn an_empty_day_answers_with_an_empty_list() {
+        let page = AppointmentPage { rows: Vec::new() };
+        assert_eq!(page.to_json()["appointments"], json!([]));
+    }
+}
diff --git a/components/application/dock/src/scalar.rs b/components/application/dock/src/scalar.rs
new file mode 100644
index 00000000..a329b8f1
--- /dev/null
+++ b/components/application/dock/src/scalar.rs
@@ -0,0 +1,153 @@
+//! The wire scalars every Dock operation parses, spelled once.
+//!
+//! Parse and RE-SPELL, not merely validate. Two spellings of one booking must
+//! canonicalize to the same bytes, or the idempotency key would key two
+//! different commands. The DURABLE spelling of an instant is UTC RFC 3339 with
+//! six fractional digits, which is the repository's canonical form.
+//!
+//! The WIRE spelling of an instant is UTC RFC 3339 with `Z`, and fractional
+//! digits only when the instant carries them. It is a separate rule because the
+//! canonical form is an identity rule for hashing, and an answer is read by a
+//! caller who sent `2026-10-01T09:07:00Z` and expects to read it back.
+
+use wamn_postgres_statements::{TimestampTz, Uuid};
+
+use crate::error::{AccessError, AccessErrorKind};
+
+/// The only status a booked appointment starts in.
+pub(crate) const SCHEDULED: &str = "scheduled";
+
+/// Every status an appointment can hold, in the order it moves through them.
+pub(crate) const STATUS: [&str; 3] = [SCHEDULED, "arrived", "departed"];
+
+pub(crate) fn uuid(field: &str, value: &str) -> Result<Uuid, AccessError> {
+    value
+        .parse::<uuid::Uuid>()
+        .map(|parsed| Uuid(parsed.hyphenated().to_string()))
+        .map_err(|_| AccessError::field(AccessErrorKind::InvalidInput, field))
+}
+
+/// One instant in the durable canonical spelling.
+pub(crate) fn timestamp(field: &str, value: &str) -> Result<TimestampTz, AccessError> {
+    chrono::DateTime::parse_from_rfc3339(value)
+        .map(|parsed| TimestampTz(parsed.to_utc().format("%Y-%m-%dT%H:%M:%S%.6fZ").to_string()))
+        .map_err(|_| AccessError::field(AccessErrorKind::InvalidInput, field))
+}
+
+/// One instant in the wire spelling a caller reads back.
+pub(crate) fn wire_timestamp(value: &TimestampTz) -> String {
+    let Ok(parsed) = chrono::DateTime::parse_from_rfc3339(&value.0) else {
+        return value.0.clone();
+    };
+    let instant = parsed.to_utc();
+    if instant.timestamp_subsec_nanos() == 0 {
+        instant.format("%Y-%m-%dT%H:%M:%SZ").to_string()
+    } else {
+        instant.format("%Y-%m-%dT%H:%M:%S%.6fZ").to_string()
+    }
+}
+
+/// The half-open instant range of one UTC calendar day.
+///
+/// A day is a calendar date and an instant is not, so the two are joined by a
+/// time zone. This package reads a day as the UTC day, which is the same zone
+/// every instant on its wire is spelled in.
+pub(crate) fn day_bounds(
+    field: &str,
+    value: &str,
+) -> Result<(TimestampTz, TimestampTz), AccessError> {
+    let refuse = || AccessError::field(AccessErrorKind::InvalidInput, field);
+    let date = chrono::NaiveDate::parse_from_str(value, "%Y-%m-%d").map_err(|_| refuse())?;
+    // Parse AND re-spell: chrono admits `2026-10-1`, and a day with two
+    // spellings is a day two callers disagree about.
+    if date.format("%Y-%m-%d").to_string() != value {
+        return Err(refuse());
+    }
+    let start = date.and_hms_opt(0, 0, 0).ok_or_else(refuse)?.and_utc();
+    let end = start
+        .checked_add_days(chrono::Days::new(1))
+        .ok_or_else(refuse)?;
+    let spell =
+        |instant: chrono::DateTime<chrono::Utc>| TimestampTz(instant.format("%Y-%m-%dT%H:%M:%S%.6fZ").to_string());
+    Ok((spell(start), spell(end)))
+}
+
+/// A carrier or dock name, stored exactly as sent.
+///
+/// The name is the natural key a create is idempotent on, so it carries no
+/// leading or trailing space: two names that differ only there would be two
+/// rows for one carrier.
+pub(crate) fn name(field: &str, value: &str) -> Result<String, AccessError> {
+    if value.is_empty() || value.trim() != value {
+        Err(AccessError::field(AccessErrorKind::InvalidInput, field))
+    } else {
+        Ok(value.to_owned())
+    }
+}
+
+/// One declared appointment status.
+pub(crate) fn status(field: &str, value: &str) -> Result<String, AccessError> {
+    if STATUS.contains(&value) {
+        Ok(value.to_owned())
+    } else {
+        Err(AccessError::field(AccessErrorKind::InvalidInput, field))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn uuids_and_instants_are_respelled_canonically() {
+        assert_eq!(
+            uuid("f", "01234567-89AB-CDEF-0123-456789ABCDEF").unwrap().0,
+            "01234567-89ab-cdef-0123-456789abcdef"
+        );
+        assert!(uuid("f", "not-a-uuid").is_err());
+        assert_eq!(
+            timestamp("f", "2026-10-01T11:00:00+02:00").unwrap().0,
+            "2026-10-01T09:00:00.000000Z"
+        );
+        assert!(timestamp("f", "tomorrow").is_err());
+    }
+
+    /// The answer a caller reads back carries the spelling they sent, not the
+    /// six-digit durable one: a whole second is written without a fraction.
+    #[test]
+    fn the_wire_spelling_drops_a_zero_fraction_and_keeps_a_real_one() {
+        assert_eq!(
+            wire_timestamp(&TimestampTz("2026-10-01T09:07:00.000000+00:00".to_owned())),
+            "2026-10-01T09:07:00Z"
+        );
+        assert_eq!(
+            wire_timestamp(&TimestampTz("2026-10-01T09:07:00.250000+00:00".to_owned())),
+            "2026-10-01T09:07:00.250000Z"
+        );
+        assert_eq!(
+            wire_timestamp(&TimestampTz("2026-10-01T11:07:00+02:00".to_owned())),
+            "2026-10-01T09:07:00Z"
+        );
+    }
+
+    #[test]
+    fn a_day_is_the_half_open_utc_calendar_day() {
+        let (start, end) = day_bounds("f", "2026-10-01").unwrap();
+        assert_eq!(start.0, "2026-10-01T00:00:00.000000Z");
+        assert_eq!(end.0, "2026-10-02T00:00:00.000000Z");
+        for refused in ["", "2026-10-1", "2026-13-01", "2026-10-01T00:00:00Z"] {
+            assert!(day_bounds("f", refused).is_err(), "{refused:?} must refuse");
+        }
+    }
+
+    #[test]
+    fn a_name_carries_no_surrounding_space_and_a_status_is_declared() {
+        assert_eq!(name("f", "Door 7").unwrap(), "Door 7");
+        for refused in ["", " Door 7", "Door 7 "] {
+            assert!(name("f", refused).is_err(), "{refused:?} must refuse");
+        }
+        assert!(status("f", "scheduled").is_ok());
+        assert!(status("f", "departed").is_ok());
+        assert!(status("f", "cancelled").is_err());
+    }
+}
