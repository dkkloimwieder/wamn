@@ -0,0 +1,238 @@
+//! `appointment.check_in` -- the arrival an appointment moves on.
+//!
+//! ```text
+//! canonicalize the body
+//! → find a replay: same key ⇒ return the ORIGINAL arrival
+//! → claim the key, which pre-generates the check-in id
+//! → lock the appointment   (the serialization point)
+//! → refuse an appointment that already moved past scheduled
+//! → write the arrival time and move the status to arrived
+//! → finalize the claim
+//! ```
+//!
+//! The check-in carries an id of its own. That is what the claim law needs: a
+//! command idempotent by claim pre-generates at least one identity, and a
+//! replay then hands back the SAME arrival record rather than a fresh one.
+
+use serde::Deserialize;
+use wamn_postgres_statements::{Connection, Transaction, Uuid};
+
+use crate::create::{finish, replayed};
+use crate::error::{self, AccessError, AccessErrorKind};
+use crate::generated::wamn::appointment_check_in as sql;
+use crate::scalar::{self, Moment};
+
+#[cfg(test)]
+pub(crate) const REFUSALS: &[AccessErrorKind] = &[
+    AccessErrorKind::InvalidInput,
+    AccessErrorKind::NotFound,
+    AccessErrorKind::AppointmentNotScheduled,
+    AccessErrorKind::IdempotencyConflict,
+    AccessErrorKind::Retry,
+    AccessErrorKind::Timeout,
+    AccessErrorKind::PermissionDenied,
+    AccessErrorKind::InternalError,
+];
+
+/// The only status a check-in may move an appointment from.
+const SCHEDULED: &str = "scheduled";
+
+/// The status a check-in moves an appointment to.
+const ARRIVED: &str = "arrived";
+
+/// One envelope item's command body.
+#[derive(Debug, Deserialize)]
+pub(crate) struct CheckInCommand {
+    pub(crate) idempotency_key: String,
+    pub(crate) appointment_id: String,
+    pub(crate) arrived_at: String,
+}
+
+/// The command's scalars in their one wire spelling.
+#[derive(Debug)]
+pub(crate) struct Parsed {
+    appointment_id: Uuid,
+    arrived_at: Moment,
+}
+
+pub(crate) fn parse(command: &CheckInCommand) -> Result<Parsed, AccessError> {
+    Ok(Parsed {
+        appointment_id: scalar::uuid("value.appointment_id", &command.appointment_id)?,
+        arrived_at: scalar::timestamp("value.arrived_at", &command.arrived_at)?,
+    })
+}
+
+/// The bytes the idempotency key keys, less the key and the `request_id`.
+pub(crate) fn canonical_command(parsed: &Parsed) -> Vec<u8> {
+    wamn_execution_contract::canonical_json_bytes(&serde_json::json!({
+        "appointment_id": parsed.appointment_id.0,
+        "arrived_at": parsed.arrived_at.text(),
+    }))
+}
+
+/// Run one command item in exactly one transaction.
+///
+/// # Errors
+///
+/// [`AccessError`] carrying the literal and detail the operation contract
+/// declares for that refusal.
+pub(crate) async fn execute(command: &CheckInCommand) -> Result<serde_json::Value, AccessError> {
+    let parsed = parse(command)?;
+    let canonical = canonical_command(&parsed);
+    let mut connection = Connection::new();
+    let mut transaction = connection.begin().await.map_err(|e| error::from_statement(&e))?;
+    let result = run(&mut transaction, command, &parsed, &canonical).await;
+    finish(transaction, result).await
+}
+
+async fn run(
+    transaction: &mut Transaction,
+    command: &CheckInCommand,
+    parsed: &Parsed,
+    canonical: &[u8],
+) -> Result<serde_json::Value, AccessError> {
+    // A REPLAY RETURNS THE ORIGINAL RESULT. The key pins the body, so the
+    // arrival time in this delivery is the one the first call recorded.
+    if let Some(replay) = sql::find_replay(transaction, command.idempotency_key.clone())
+        .await
+        .map_err(|e| error::from_statement(&e))?
+    {
+        replayed(
+            &replay.canonical_command,
+            canonical,
+            replay.finalized_at.as_ref().map(|at| at.0.as_str()),
+        )?;
+        return Ok(result(
+            &replay.check_in_id.0,
+            &parsed.appointment_id.0,
+            ARRIVED,
+            &parsed.arrived_at.text(),
+        ));
+    }
+
+    let claim = sql::claim_command(
+        transaction,
+        command.idempotency_key.clone(),
+        canonical.to_vec(),
+    )
+    .await
+    .map_err(|e| error::from_statement(&e))?
+    .ok_or_else(AccessError::retry)?;
+
+    // THE SERIALIZATION POINT.
+    let locked = sql::lock_appointment(transaction, parsed.appointment_id.clone())
+        .await
+        .map_err(|e| error::from_statement(&e))?
+        .ok_or_else(|| {
+            AccessError::missing(
+                AccessErrorKind::NotFound,
+                "value.appointment_id",
+                &parsed.appointment_id.0,
+            )
+        })?;
+    if locked.status != SCHEDULED {
+        return Err(AccessError::missing(
+            AccessErrorKind::AppointmentNotScheduled,
+            "value.appointment_id",
+            &parsed.appointment_id.0,
+        ));
+    }
+
+    let arrived = sql::record_arrival(
+        transaction,
+        parsed.appointment_id.clone(),
+        parsed.arrived_at.bind(),
+    )
+    .await
+    .map_err(|e| error::from_statement(&e))?
+    .ok_or_else(AccessError::retry)?;
+
+    sql::finalize_command(
+        transaction,
+        command.idempotency_key.clone(),
+        canonical.to_vec(),
+        claim.check_in_id.clone(),
+    )
+    .await
+    .map_err(|e| error::from_statement(&e))?
+    .ok_or_else(AccessError::retry)?;
+
+    let recorded = arrived
+        .arrived_at
+        .map(|at| at.0)
+        .unwrap_or_else(|| parsed.arrived_at.text());
+    Ok(result(
+        &claim.check_in_id.0,
+        &arrived.id.0,
+        &arrived.status,
+        &recorded,
+    ))
+}
+
+fn result(
+    check_in_id: &str,
+    appointment_id: &str,
+    status: &str,
+    arrived_at: &str,
+) -> serde_json::Value {
+    serde_json::json!({
+        "check_in_id": check_in_id,
+        "appointment_id": appointment_id,
+        "status": status,
+        "arrived_at": arrived_at,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn command(appointment: &str, arrived_at: &str) -> CheckInCommand {
+        CheckInCommand {
+            idempotency_key: "k".to_owned(),
+            appointment_id: appointment.to_owned(),
+            arrived_at: arrived_at.to_owned(),
+        }
+    }
+
+    const APPOINTMENT: &str = "00000000-0000-0000-0000-0000000000a1";
+
+    #[test]
+    fn the_canonical_command_is_spelling_independent() {
+        let offset = command(
+            "00000000-0000-0000-0000-0000000000A1",
+            "2026-10-01T11:05:00+02:00",
+        );
+        let utc = command(APPOINTMENT, "2026-10-01T09:05:00.000000Z");
+        assert_eq!(
+            canonical_command(&parse(&offset).unwrap()),
+            canonical_command(&parse(&utc).unwrap())
+        );
+    }
+
+    #[test]
+    fn a_different_arrival_is_a_different_command() {
+        let five = command(APPOINTMENT, "2026-10-01T09:05:00Z");
+        let six = command(APPOINTMENT, "2026-10-01T09:06:00Z");
+        assert_ne!(
+            canonical_command(&parse(&five).unwrap()),
+            canonical_command(&parse(&six).unwrap())
+        );
+    }
+
+    #[test]
+    fn an_unspellable_scalar_is_refused_before_any_statement() {
+        assert_eq!(
+            parse(&command("not-a-uuid", "2026-10-01T09:05:00Z"))
+                .unwrap_err()
+                .detail()["field"],
+            "value.appointment_id"
+        );
+        assert_eq!(
+            parse(&command(APPOINTMENT, "this morning"))
+                .unwrap_err()
+                .detail()["field"],
+            "value.arrived_at"
+        );
+    }
+}
