--- /dev/null
+++ b/components/application/dock/src/book.rs
@@ -0,0 +1,277 @@
+//! `appointment.book` -- the contended command.
+//!
+//! One slot on one dock, transactionally. The generator wrote every statement;
+//! what is authored here is the ORDER those statements run in and what each
+//! refusal means.
+//!
+//! ```text
+//! canonicalize the body
+//! → find a replay: same key ⇒ return the ORIGINAL appointment id
+//! → claim the key, which pre-generates the appointment id
+//! → validate the carrier
+//! → lock the dock          (the serialization point)
+//! → look for an overlapping appointment on that dock
+//! → insert the appointment UNDER the claimed id
+//! → finalize the claim
+//! ```
+//!
+//! The lock is on `dock` and not on `appointment`: two concurrent bookings of
+//! one dock must not both pass the overlap read, and the dock row is what makes
+//! them serialize. Nothing else in this package writes an appointment's slot,
+//! so no overlapping pair can reach the table.
+
+use serde::Deserialize;
+use wamn_postgres_statements::{Connection, Transaction, Uuid};
+
+use crate::create::{finish, replayed};
+use crate::error::{self, AccessError, AccessErrorKind};
+use crate::generated::wamn::appointment_book as sql;
+use crate::scalar::{self, Moment};
+
+#[cfg(test)]
+pub(crate) const REFUSALS: &[AccessErrorKind] = &[
+    AccessErrorKind::InvalidInput,
+    AccessErrorKind::CarrierNotFound,
+    AccessErrorKind::DockNotFound,
+    AccessErrorKind::SlotUnavailable,
+    AccessErrorKind::IdempotencyConflict,
+    AccessErrorKind::Retry,
+    AccessErrorKind::Timeout,
+    AccessErrorKind::PermissionDenied,
+    AccessErrorKind::InternalError,
+];
+
+/// The status every accepted booking starts in.
+const SCHEDULED: &str = "scheduled";
+
+/// One envelope item's command body.
+#[derive(Debug, Deserialize)]
+pub(crate) struct BookCommand {
+    pub(crate) idempotency_key: String,
+    pub(crate) carrier_id: String,
+    pub(crate) dock_id: String,
+    pub(crate) slot_start: String,
+    pub(crate) slot_end: String,
+}
+
+/// The command's scalars in their one wire spelling.
+#[derive(Debug)]
+pub(crate) struct Parsed {
+    carrier_id: Uuid,
+    dock_id: Uuid,
+    slot_start: Moment,
+    slot_end: Moment,
+}
+
+/// Parse, re-spell, and refuse a slot that does not run forwards.
+///
+/// An empty or reversed slot overlaps nothing, so the database check alone
+/// would report it as `internal_error`. It is a bad request, and it says so.
+pub(crate) fn parse(command: &BookCommand) -> Result<Parsed, AccessError> {
+    let parsed = Parsed {
+        carrier_id: scalar::uuid("value.carrier_id", &command.carrier_id)?,
+        dock_id: scalar::uuid("value.dock_id", &command.dock_id)?,
+        slot_start: scalar::timestamp("value.slot_start", &command.slot_start)?,
+        slot_end: scalar::timestamp("value.slot_end", &command.slot_end)?,
+    };
+    if parsed.slot_end <= parsed.slot_start {
+        return Err(AccessError::field(
+            AccessErrorKind::InvalidInput,
+            "value.slot_end",
+        ));
+    }
+    Ok(parsed)
+}
+
+/// The bytes the idempotency key keys: the RE-SPELLED command, so two
+/// deliveries of one booking canonicalize alike whatever case or offset each
+/// was written in.
+pub(crate) fn canonical_command(parsed: &Parsed) -> Vec<u8> {
+    wamn_execution_contract::canonical_json_bytes(&serde_json::json!({
+        "carrier_id": parsed.carrier_id.0,
+        "dock_id": parsed.dock_id.0,
+        "slot_start": parsed.slot_start.text(),
+        "slot_end": parsed.slot_end.text(),
+    }))
+}
+
+/// Run one command item in exactly one transaction.
+///
+/// # Errors
+///
+/// [`AccessError`] carrying the literal and detail the operation contract
+/// declares for that refusal.
+pub(crate) async fn execute(command: &BookCommand) -> Result<serde_json::Value, AccessError> {
+    let parsed = parse(command)?;
+    let canonical = canonical_command(&parsed);
+    let mut connection = Connection::new();
+    let mut transaction = connection.begin().await.map_err(|e| error::from_statement(&e))?;
+    let result = run(&mut transaction, command, &parsed, &canonical).await;
+    finish(transaction, result).await
+}
+
+async fn run(
+    transaction: &mut Transaction,
+    command: &BookCommand,
+    parsed: &Parsed,
+    canonical: &[u8],
+) -> Result<serde_json::Value, AccessError> {
+    if let Some(replay) = sql::find_replay(transaction, command.idempotency_key.clone())
+        .await
+        .map_err(|e| error::from_statement(&e))?
+    {
+        replayed(
+            &replay.canonical_command,
+            canonical,
+            replay.finalized_at.as_ref().map(|at| at.0.as_str()),
+        )?;
+        return Ok(result(&replay.appointment_id.0, SCHEDULED));
+    }
+
+    let claim = sql::claim_command(
+        transaction,
+        command.idempotency_key.clone(),
+        canonical.to_vec(),
+    )
+    .await
+    .map_err(|e| error::from_statement(&e))?
+    .ok_or_else(AccessError::retry)?;
+
+    sql::validate_carrier(transaction, parsed.carrier_id.clone())
+        .await
+        .map_err(|e| error::from_statement(&e))?
+        .ok_or_else(|| {
+            AccessError::missing(
+                AccessErrorKind::CarrierNotFound,
+                "value.carrier_id",
+                &parsed.carrier_id.0,
+            )
+        })?;
+
+    // THE SERIALIZATION POINT.
+    sql::lock_dock(transaction, parsed.dock_id.clone())
+        .await
+        .map_err(|e| error::from_statement(&e))?
+        .ok_or_else(|| {
+            AccessError::missing(
+                AccessErrorKind::DockNotFound,
+                "value.dock_id",
+                &parsed.dock_id.0,
+            )
+        })?;
+
+    if sql::find_overlap(
+        transaction,
+        parsed.dock_id.clone(),
+        parsed.slot_start.bind(),
+        parsed.slot_end.bind(),
+    )
+    .await
+    .map_err(|e| error::from_statement(&e))?
+    .is_some()
+    {
+        return Err(AccessError::field(
+            AccessErrorKind::SlotUnavailable,
+            "value.slot_start",
+        ));
+    }
+
+    let inserted = sql::insert_appointment(
+        transaction,
+        claim.appointment_id.clone(),
+        parsed.carrier_id.clone(),
+        parsed.dock_id.clone(),
+        parsed.slot_start.bind(),
+        parsed.slot_end.bind(),
+    )
+    .await
+    .map_err(|e| error::from_statement(&e))?;
+
+    sql::finalize_command(
+        transaction,
+        command.idempotency_key.clone(),
+        canonical.to_vec(),
+        claim.appointment_id.clone(),
+    )
+    .await
+    .map_err(|e| error::from_statement(&e))?
+    .ok_or_else(AccessError::retry)?;
+
+    Ok(result(&inserted.id.0, &inserted.status))
+}
+
+fn result(appointment_id: &str, status: &str) -> serde_json::Value {
+    serde_json::json!({ "appointment_id": appointment_id, "status": status })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn command(carrier: &str, start: &str, end: &str) -> BookCommand {
+        BookCommand {
+            idempotency_key: "k".to_owned(),
+            carrier_id: carrier.to_owned(),
+            dock_id: "00000000-0000-0000-0000-0000000000d1".to_owned(),
+            slot_start: start.to_owned(),
+            slot_end: end.to_owned(),
+        }
+    }
+
+    const CARRIER: &str = "00000000-0000-0000-0000-0000000000c1";
+
+    /// Two spellings of one booking are ONE command under the key: the
+    /// canonical bytes come from the respelled scalars, not the caller's.
+    #[test]
+    fn the_canonical_command_is_spelling_independent() {
+        let offset = command(
+            "00000000-0000-0000-0000-0000000000C1",
+            "2026-10-01T11:00:00+02:00",
+            "2026-10-01T12:00:00+02:00",
+        );
+        let utc = command(
+            CARRIER,
+            "2026-10-01T09:00:00.000000Z",
+            "2026-10-01T10:00:00Z",
+        );
+        assert_eq!(
+            canonical_command(&parse(&offset).unwrap()),
+            canonical_command(&parse(&utc).unwrap())
+        );
+    }
+
+    /// A booking of a different slot is a different command, so the bytes must
+    /// still separate one from another.
+    #[test]
+    fn a_different_slot_is_a_different_command() {
+        let nine = command(CARRIER, "2026-10-01T09:00:00Z", "2026-10-01T10:00:00Z");
+        let ten = command(CARRIER, "2026-10-01T10:00:00Z", "2026-10-01T11:00:00Z");
+        assert_ne!(
+            canonical_command(&parse(&nine).unwrap()),
+            canonical_command(&parse(&ten).unwrap())
+        );
+    }
+
+    #[test]
+    fn a_slot_that_does_not_run_forwards_is_refused() {
+        for (start, end) in [
+            ("2026-10-01T10:00:00Z", "2026-10-01T09:00:00Z"),
+            ("2026-10-01T10:00:00Z", "2026-10-01T10:00:00Z"),
+        ] {
+            let refusal = parse(&command(CARRIER, start, end)).unwrap_err();
+            assert_eq!(refusal.kind(), AccessErrorKind::InvalidInput);
+            assert_eq!(refusal.detail()["field"], "value.slot_end");
+        }
+    }
+
+    #[test]
+    fn an_unspellable_scalar_is_refused_before_any_statement() {
+        let refusal = parse(&command(
+            "not-a-uuid",
+            "2026-10-01T09:00:00Z",
+            "2026-10-01T10:00:00Z",
+        ))
+        .unwrap_err();
+        assert_eq!(refusal.detail()["field"], "value.carrier_id");
+    }
+}
