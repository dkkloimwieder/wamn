diff --git a/packages/dock/query/appointment_by_dock_day.sql b/packages/dock/query/appointment_by_dock_day.sql
new file mode 100644
index 00000000..7a27f6bf
--- /dev/null
+++ b/packages/dock/query/appointment_by_dock_day.sql
@@ -0,0 +1,14 @@
+SELECT
+    id,
+    carrier_id,
+    dock_id,
+    slot_start,
+    slot_end,
+    status,
+    arrived_at
+FROM appointment
+WHERE dock_id = $1
+    AND slot_start >= $2
+    AND slot_start < $3
+    AND status = $4
+ORDER BY slot_start ASC, id ASC;
