@@ -0,0 +1,265 @@
+//! `carrier.create` and `dock.create` -- the two operations that hand out the
+//! identities every later operation addresses a carrier and a dock by.
+//!
+//! Both run the same four steps, and the generator wrote every statement:
+//!
+//! ```text
+//! find a replay: same key, same body ⇒ return the ORIGINAL id
+//! → claim the key, which pre-generates the id
+//! → insert the row UNDER that id
+//! → finalize the claim
+//! ```
+//!
+//! The id comes from the claim and never from the insert, so a second delivery
+//! of one operator action cannot mint a second identity.
+
+use serde::Deserialize;
+use wamn_postgres_statements::{Connection, Transaction};
+
+use crate::error::{self, AccessError, AccessErrorKind};
+use crate::generated::wamn::{carrier_create, dock_create};
+
+#[cfg(test)]
+pub(crate) const REFUSALS: &[AccessErrorKind] = &[
+    AccessErrorKind::InvalidInput,
+    AccessErrorKind::IdempotencyConflict,
+    AccessErrorKind::Retry,
+    AccessErrorKind::Timeout,
+    AccessErrorKind::PermissionDenied,
+    AccessErrorKind::InternalError,
+];
+
+/// One envelope item's command body. Both operations take the same body.
+#[derive(Debug, Deserialize)]
+pub(crate) struct CreateCommand {
+    pub(crate) idempotency_key: String,
+    pub(crate) name: String,
+}
+
+/// The bytes the idempotency key keys.
+///
+/// The key itself and `request_id` are EXCLUDED: two deliveries of one operator
+/// action differ in neither, only in the envelope that carried them.
+pub(crate) fn canonical_command(command: &CreateCommand) -> Vec<u8> {
+    wamn_execution_contract::canonical_json_bytes(&serde_json::json!({
+        "name": command.name,
+    }))
+}
+
+fn parse(command: &CreateCommand) -> Result<(), AccessError> {
+    if command.name.is_empty() {
+        return Err(AccessError::field(AccessErrorKind::InvalidInput, "value.name"));
+    }
+    Ok(())
+}
+
+/// Run one `carrier.create` item in exactly one transaction.
+///
+/// # Errors
+///
+/// [`AccessError`] carrying the literal and detail the operation contract
+/// declares for that refusal.
+pub(crate) async fn create_carrier(command: &CreateCommand) -> Result<serde_json::Value, AccessError> {
+    parse(command)?;
+    let canonical = canonical_command(command);
+    let mut connection = Connection::new();
+    let mut transaction = connection.begin().await.map_err(|e| error::from_statement(&e))?;
+    let result = run_carrier(&mut transaction, command, &canonical).await;
+    finish(transaction, result).await
+}
+
+/// Run one `dock.create` item in exactly one transaction.
+///
+/// # Errors
+///
+/// [`AccessError`] carrying the literal and detail the operation contract
+/// declares for that refusal.
+pub(crate) async fn create_dock(command: &CreateCommand) -> Result<serde_json::Value, AccessError> {
+    parse(command)?;
+    let canonical = canonical_command(command);
+    let mut connection = Connection::new();
+    let mut transaction = connection.begin().await.map_err(|e| error::from_statement(&e))?;
+    let result = run_dock(&mut transaction, command, &canonical).await;
+    finish(transaction, result).await
+}
+
+/// Commit an accepted item, and roll one refusal back.
+///
+/// Dropping the transaction rolls it back; the explicit rollback makes the
+/// refusal path say so rather than relying on a `Drop` nobody reads.
+pub(crate) async fn finish(
+    transaction: Transaction,
+    result: Result<serde_json::Value, AccessError>,
+) -> Result<serde_json::Value, AccessError> {
+    match result {
+        Ok(value) => {
+            transaction.commit().await.map_err(|e| error::from_statement(&e))?;
+            Ok(value)
+        }
+        Err(refusal) => {
+            let _ = transaction.rollback().await;
+            Err(refusal)
+        }
+    }
+}
+
+/// Compare a replayed claim against this delivery's bytes.
+///
+/// Same key and different bytes is two commands wearing one identity, and
+/// answering either would be wrong. Claimed but never finalized means the first
+/// attempt died before its commit: retryable, and the retry re-runs the work
+/// under the same claim.
+pub(crate) fn replayed(
+    stored: &[u8],
+    canonical: &[u8],
+    finalized: Option<&str>,
+) -> Result<(), AccessError> {
+    if stored != canonical {
+        return Err(AccessError::field(
+            AccessErrorKind::IdempotencyConflict,
+            "value.idempotency_key",
+        ));
+    }
+    if finalized.is_none() {
+        return Err(AccessError::retry());
+    }
+    Ok(())
+}
+
+async fn run_carrier(
+    transaction: &mut Transaction,
+    command: &CreateCommand,
+    canonical: &[u8],
+) -> Result<serde_json::Value, AccessError> {
+    if let Some(replay) = carrier_create::find_replay(transaction, command.idempotency_key.clone())
+        .await
+        .map_err(|e| error::from_statement(&e))?
+    {
+        replayed(
+            &replay.canonical_command,
+            canonical,
+            replay.finalized_at.as_ref().map(|at| at.0.as_str()),
+        )?;
+        return Ok(serde_json::json!({ "carrier_id": replay.carrier_id.0 }));
+    }
+
+    let claim = carrier_create::claim_command(
+        transaction,
+        command.idempotency_key.clone(),
+        canonical.to_vec(),
+    )
+    .await
+    .map_err(|e| error::from_statement(&e))?
+    .ok_or_else(AccessError::retry)?;
+
+    let inserted =
+        carrier_create::insert_carrier(transaction, claim.carrier_id.clone(), command.name.clone())
+            .await
+            .map_err(|e| error::from_statement(&e))?;
+
+    carrier_create::finalize_command(
+        transaction,
+        command.idempotency_key.clone(),
+        canonical.to_vec(),
+        claim.carrier_id.clone(),
+    )
+    .await
+    .map_err(|e| error::from_statement(&e))?
+    .ok_or_else(AccessError::retry)?;
+
+    Ok(serde_json::json!({ "carrier_id": inserted.id.0 }))
+}
+
+async fn run_dock(
+    transaction: &mut Transaction,
+    command: &CreateCommand,
+    canonical: &[u8],
+) -> Result<serde_json::Value, AccessError> {
+    if let Some(replay) = dock_create::find_replay(transaction, command.idempotency_key.clone())
+        .await
+        .map_err(|e| error::from_statement(&e))?
+    {
+        replayed(
+            &replay.canonical_command,
+            canonical,
+            replay.finalized_at.as_ref().map(|at| at.0.as_str()),
+        )?;
+        return Ok(serde_json::json!({ "dock_id": replay.dock_id.0 }));
+    }
+
+    let claim = dock_create::claim_command(
+        transaction,
+        command.idempotency_key.clone(),
+        canonical.to_vec(),
+    )
+    .await
+    .map_err(|e| error::from_statement(&e))?
+    .ok_or_else(AccessError::retry)?;
+
+    let inserted = dock_create::insert_dock(transaction, claim.dock_id.clone(), command.name.clone())
+        .await
+        .map_err(|e| error::from_statement(&e))?;
+
+    dock_create::finalize_command(
+        transaction,
+        command.idempotency_key.clone(),
+        canonical.to_vec(),
+        claim.dock_id.clone(),
+    )
+    .await
+    .map_err(|e| error::from_statement(&e))?
+    .ok_or_else(AccessError::retry)?;
+
+    Ok(serde_json::json!({ "dock_id": inserted.id.0 }))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn command(key: &str, name: &str) -> CreateCommand {
+        CreateCommand {
+            idempotency_key: key.to_owned(),
+            name: name.to_owned(),
+        }
+    }
+
+    /// Two deliveries of one create are ONE command under the key, and two
+    /// different names are two commands.
+    #[test]
+    fn the_canonical_command_excludes_the_key_and_separates_the_names() {
+        let first = canonical_command(&command("a", "Blue Line Freight"));
+        let repeat = canonical_command(&command("b", "Blue Line Freight"));
+        let other = canonical_command(&command("a", "Red Line Freight"));
+        assert_eq!(first, repeat);
+        assert_ne!(first, other);
+        assert!(!String::from_utf8(first).unwrap().contains("idempotency_key"));
+    }
+
+    #[test]
+    fn an_empty_name_is_refused_before_any_statement() {
+        assert_eq!(
+            parse(&command("a", "")).unwrap_err().detail()["field"],
+            "value.name"
+        );
+        assert!(parse(&command("a", "Blue Line Freight")).is_ok());
+    }
+
+    /// A replay of the SAME body returns; a different body under one key is a
+    /// typed conflict; an unfinalized claim is retryable.
+    #[test]
+    fn a_replay_admits_only_the_body_the_key_already_carries() {
+        let canonical = canonical_command(&command("a", "Blue Line Freight"));
+        assert!(replayed(&canonical, &canonical, Some("2026-10-01T09:00:00.000000Z")).is_ok());
+        assert_eq!(
+            replayed(b"other", &canonical, Some("2026-10-01T09:00:00.000000Z"))
+                .unwrap_err()
+                .kind(),
+            AccessErrorKind::IdempotencyConflict
+        );
+        assert_eq!(
+            replayed(&canonical, &canonical, None).unwrap_err().kind(),
+            AccessErrorKind::Retry
+        );
+    }
+}
