diff --git a/packages/dock/migrations/0001_initial.sql b/packages/dock/migrations/0001_initial.sql
new file mode 100644
index 00000000..ac0651eb
--- /dev/null
+++ b/packages/dock/migrations/0001_initial.sql
@@ -0,0 +1,71 @@
+CREATE TABLE receiving.carrier (
+    id uuid CONSTRAINT carrier_id_pkey PRIMARY KEY DEFAULT gen_random_uuid(),
+    name text NOT NULL,
+    created_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP
+);
+
+CREATE TABLE receiving.dock (
+    id uuid CONSTRAINT dock_id_pkey PRIMARY KEY DEFAULT gen_random_uuid(),
+    name text NOT NULL,
+    created_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP
+);
+
+CREATE TABLE receiving.appointment (
+    id uuid CONSTRAINT appointment_id_pkey PRIMARY KEY DEFAULT gen_random_uuid(),
+    carrier_id uuid NOT NULL
+        CONSTRAINT appointment_carrier_id_fkey REFERENCES receiving.carrier (id),
+    dock_id uuid NOT NULL
+        CONSTRAINT appointment_dock_id_fkey REFERENCES receiving.dock (id),
+    slot_start timestamptz NOT NULL,
+    slot_end timestamptz NOT NULL,
+    status text NOT NULL DEFAULT 'scheduled',
+    arrived_at timestamptz,
+    created_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    CONSTRAINT appointment_status_check
+        CHECK (status IN ('scheduled', 'arrived', 'departed')),
+    CONSTRAINT appointment_slot_start_slot_end_check CHECK (slot_end > slot_start)
+);
+
+CREATE TABLE receiving.create_carrier_command (
+    idempotency_key text
+        CONSTRAINT create_carrier_command_idempotency_key_pkey PRIMARY KEY,
+    canonical_command bytea NOT NULL,
+    carrier_id uuid NOT NULL DEFAULT gen_random_uuid()
+        CONSTRAINT create_carrier_command_carrier_id_key UNIQUE,
+    finalized_at timestamptz,
+    CONSTRAINT create_carrier_command_canonical_command_check
+        CHECK (octet_length(canonical_command) > 0)
+);
+
+CREATE TABLE receiving.create_dock_command (
+    idempotency_key text
+        CONSTRAINT create_dock_command_idempotency_key_pkey PRIMARY KEY,
+    canonical_command bytea NOT NULL,
+    dock_id uuid NOT NULL DEFAULT gen_random_uuid()
+        CONSTRAINT create_dock_command_dock_id_key UNIQUE,
+    finalized_at timestamptz,
+    CONSTRAINT create_dock_command_canonical_command_check
+        CHECK (octet_length(canonical_command) > 0)
+);
+
+CREATE TABLE receiving.book_appointment_command (
+    idempotency_key text
+        CONSTRAINT book_appointment_command_idempotency_key_pkey PRIMARY KEY,
+    canonical_command bytea NOT NULL,
+    appointment_id uuid NOT NULL DEFAULT gen_random_uuid()
+        CONSTRAINT book_appointment_command_appointment_id_key UNIQUE,
+    finalized_at timestamptz,
+    CONSTRAINT book_appointment_command_canonical_command_check
+        CHECK (octet_length(canonical_command) > 0)
+);
+
+CREATE TABLE receiving.check_in_command (
+    idempotency_key text
+        CONSTRAINT check_in_command_idempotency_key_pkey PRIMARY KEY,
+    canonical_command bytea NOT NULL,
+    check_in_id uuid NOT NULL DEFAULT gen_random_uuid()
+        CONSTRAINT check_in_command_check_in_id_key UNIQUE,
+    finalized_at timestamptz,
+    CONSTRAINT check_in_command_canonical_command_check
+        CHECK (octet_length(canonical_command) > 0)
+);
