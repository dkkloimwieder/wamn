+package dock:appointment@0.1.0;
+
+interface book {
+  use wamn:node/types@0.1.0.{json, node-context, emission, node-error};
+
+  run: func(ctx: node-context, input: json) -> result<emission, node-error>;
+}
+
+interface check-in {
+  use wamn:node/types@0.1.0.{json, node-context, emission, node-error};
+
+  run: func(ctx: node-context, input: json) -> result<emission, node-error>;
+}
+
+interface query {
+  use wamn:node/types@0.1.0.{json, node-context, emission, node-error};
+
+  run: func(ctx: node-context, input: json) -> result<emission, node-error>;
