@@ -0,0 +1,106 @@
+#![expect(
+    clippy::same_length_and_capacity,
+    reason = "wit-bindgen emits Vec::from_raw_parts with equal length and capacity"
+)]
+
+//! One package-grain component for the executable dock-appointment operations.
+
+use exports::dock::appointment::book::Guest as AppointmentBook;
+use exports::dock::appointment::check_in::Guest as AppointmentCheckIn;
+use exports::dock::appointment::query::Guest as AppointmentQuery;
+use exports::dock::carrier::create::Guest as CarrierCreate;
+use exports::dock::dock::create::Guest as DockCreate;
+use wamn::node::types::{Emission, ErrorDetail, NodeContext, NodeError};
+
+use crate::operation::InvocationError;
+
+mod error;
+mod generated;
+pub mod operation;
+mod wire;
+
+pub use error::{DockError, DockErrorKind};
+
+wit_bindgen::generate!({
+    world: "dock:component/dock@0.1.0",
+    inline: r#"
+        package dock:component@0.1.0;
+
+        world dock {
+          import wamn:postgres/types@0.1.0;
+          import wamn:postgres/statements@0.1.0;
+          export dock:carrier/create@0.1.0;
+          export dock:dock/create@0.1.0;
+          export dock:appointment/book@0.1.0;
+          export dock:appointment/check-in@0.1.0;
+          export dock:appointment/query@0.1.0;
+        }
+    "#,
+    path: [
+        "../../data/receiving-data/wit/deps/wamn-node",
+        "../../data/receiving-data/wit/deps/wamn-postgres",
+        "wit/deps/dock-appointment",
+        "wit/deps/dock-carrier",
+        "wit/deps/dock-dock",
+    ],
+    generate_all,
+});
+
+struct Component;
+
+fn emission(payload: String) -> Emission {
+    Emission {
+        payload,
+        port: None,
+    }
+}
+
+/// Drive one public operation and translate its envelope refusal exactly once.
+///
+/// Every item-level refusal already travels inside the payload, so the only
+/// failure that reaches the node boundary is a malformed envelope.
+fn invoke<F>(operation: F) -> Result<Emission, NodeError>
+where
+    F: Future<Output = Result<String, InvocationError>>,
+{
+    futures_executor::block_on(operation)
+        .map(emission)
+        .map_err(|error| {
+            NodeError::InvalidInput(ErrorDetail {
+                message: error.context().to_owned(),
+                code: Some(error.code().to_owned()),
+            })
+        })
+}
+
+impl CarrierCreate for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(operation::carrier_create(&input))
+    }
+}
+
+impl DockCreate for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(operation::dock_create(&input))
+    }
+}
+
+impl AppointmentBook for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(operation::appointment_book(&input))
+    }
+}
+
+impl AppointmentCheckIn for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(operation::appointment_check_in(&input))
+    }
+}
+
+impl AppointmentQuery for Component {
+    fn run(_context: NodeContext, input: String) -> Result<Emission, NodeError> {
+        invoke(operation::appointment_query(&input))
+    }
+}
+
+export!(Component);
diff --git a/components/application/dock/src/operation.rs b/components/application/dock/src/operation.rs
new file mode 100644
index 00000000..d727cb75
--- /dev/null
+++ b/components/application/dock/src/operation.rs
@@ -0,0 +1,723 @@
+//! Wire adapters for the five dock operations backed by generated SQL.
+
+use serde::de::DeserializeOwned;
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use wamn_execution_contract::canonical_json_bytes;
+use wamn_postgres_statements::{
+    Connection, TimestampTz, Transaction, Uuid as WamnUuid, run_transaction,
+};
+
+use crate::error::{DockError, DockErrorKind};
+use crate::generated::{
+    appointment_book as book_sql, appointment_check_in as check_in_sql,
+    appointment_query as query_sql, carrier_create as carrier_sql, dock_create as dock_sql,
+};
+use crate::wire;
+
+/// Outer envelope bound declared by every public dock operation.
+const MAX_ENVELOPE_ITEMS: usize = 100;
+
+/// Envelope refusal translated to the frozen node invalid-input arm.
+#[derive(Debug)]
+pub struct InvocationError {
+    context: &'static str,
+}
+
+impl InvocationError {
+    /// Frozen WIT error-detail code.
+    pub const fn code(&self) -> &'static str {
+        "invalid_input"
+    }
+
+    /// Stable, non-database refusal description.
+    pub const fn context(&self) -> &'static str {
+        self.context
+    }
+
+    const fn new(context: &'static str) -> Self {
+        Self { context }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+struct EnvelopeItem {
+    request_id: Box<str>,
+    body: Value,
+}
+
+fn prepare_envelope(input: &str) -> Result<Box<[EnvelopeItem]>, InvocationError> {
+    let value: Value = serde_json::from_str(input)
+        .map_err(|_| InvocationError::new("operation input must be a JSON array"))?;
+    let Value::Array(values) = value else {
+        return Err(InvocationError::new("operation input must be a JSON array"));
+    };
+    if !(1..=MAX_ENVELOPE_ITEMS).contains(&values.len()) {
+        return Err(InvocationError::new(
+            "operation input item count must be 1..=100",
+        ));
+    }
+    values
+        .into_iter()
+        .map(|value| {
+            let Value::Object(mut object) = value else {
+                return Err(InvocationError::new(
+                    "every operation item must be a JSON object",
+                ));
+            };
+            let request_id = match object.remove("request_id") {
+                Some(Value::String(request_id)) if !request_id.is_empty() => request_id,
+                _ => {
+                    return Err(InvocationError::new(
+                        "every operation item must carry a nonempty string request_id",
+                    ));
+                }
+            };
+            Ok(EnvelopeItem {
+                request_id: request_id.into_boxed_str(),
+                body: Value::Object(object),
+            })
+        })
+        .collect::<Result<Vec<_>, _>>()
+        .map(Vec::into_boxed_slice)
+}
+
+fn parse_item<T: DeserializeOwned>(item: &EnvelopeItem) -> Result<T, DockError> {
+    serde_json::from_value(item.body.clone()).map_err(|_| {
+        DockError::invalid("operation item does not match its input contract", "value")
+    })
+}
+
+#[derive(Debug, Serialize)]
+#[serde(untagged)]
+enum ItemResult<T> {
+    Succeeded {
+        request_id: Box<str>,
+        value: T,
+    },
+    Refused {
+        request_id: Box<str>,
+        error: OperationError,
+    },
+}
+
+#[derive(Debug, Serialize)]
+struct OperationError {
+    code: &'static str,
+    detail: ErrorDetail,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(untagged)]
+enum ErrorDetail {
+    Field(FieldDetail),
+    FieldId(FieldIdDetail),
+    Permission(PermissionDetail),
+    Empty(EmptyDetail),
+}
+
+#[derive(Debug, Serialize)]
+struct FieldDetail {
+    field: &'static str,
+}
+
+#[derive(Debug, Serialize)]
+struct FieldIdDetail {
+    field: &'static str,
+    id: Box<str>,
+}
+
+#[derive(Debug, Serialize)]
+struct PermissionDetail {
+    operation: &'static str,
+}
+
+#[derive(Debug, Serialize)]
+struct EmptyDetail {}
+
+/// Shape one refusal into the exact detail keys its manifest code declares.
+fn operation_error(error: &DockError, operation: &'static str) -> OperationError {
+    let empty = || ErrorDetail::Empty(EmptyDetail {});
+    let internal = || OperationError {
+        code: "internal_error",
+        detail: empty(),
+    };
+    let detail = match error.kind() {
+        DockErrorKind::InvalidInput | DockErrorKind::IdempotencyConflict => {
+            let Some(field) = error.field() else {
+                return internal();
+            };
+            ErrorDetail::Field(FieldDetail { field })
+        }
+        DockErrorKind::NotFound
+        | DockErrorKind::DockNotFound
+        | DockErrorKind::CarrierNotFound
+        | DockErrorKind::SlotUnavailable
+        | DockErrorKind::InvalidStatusTransition => {
+            let (Some(field), Some(id)) = (error.field(), error.id()) else {
+                return internal();
+            };
+            ErrorDetail::FieldId(FieldIdDetail {
+                field,
+                id: id.into(),
+            })
+        }
+        DockErrorKind::PermissionDenied => ErrorDetail::Permission(PermissionDetail { operation }),
+        DockErrorKind::Retry | DockErrorKind::Timeout | DockErrorKind::InternalError => empty(),
+    };
+    OperationError {
+        code: error.kind().literal(),
+        detail,
+    }
+}
+
+fn refused<T>(request_id: Box<str>, error: OperationError) -> ItemResult<T> {
+    ItemResult::Refused { request_id, error }
+}
+
+fn serialized<T: Serialize>(output: &[ItemResult<T>]) -> String {
+    serde_json::to_string(output).expect("closed operation results always serialize")
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct NameInput {
+    name: Box<str>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct BookInput {
+    idempotency_key: Box<str>,
+    dock_id: Box<str>,
+    carrier_id: Box<str>,
+    slot_start: Box<str>,
+    slot_end: Box<str>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CheckInInput {
+    appointment_id: Box<str>,
+    arrived_at: Box<str>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct QueryInput {
+    dock_id: Box<str>,
+    day: Box<str>,
+    #[serde(default)]
+    status: Option<Box<str>>,
+}
+
+#[derive(Debug, Serialize)]
+struct CarrierValue {
+    carrier_id: Box<str>,
+    name: Box<str>,
+}
+
+#[derive(Debug, Serialize)]
+struct DockValue {
+    dock_id: Box<str>,
+    name: Box<str>,
+}
+
+#[derive(Debug, Serialize)]
+struct AppointmentValue {
+    appointment_id: Box<str>,
+    dock_id: Box<str>,
+    carrier_id: Box<str>,
+    slot_start: Box<str>,
+    slot_end: Box<str>,
+    status: Box<str>,
+    row_version: Box<str>,
+}
+
+#[derive(Debug, Serialize)]
+struct CheckInValue {
+    appointment_id: Box<str>,
+    status: Box<str>,
+    arrived_at: Box<str>,
+    row_version: Box<str>,
+}
+
+#[derive(Debug, Serialize)]
+struct ScheduleValue {
+    dock_id: Box<str>,
+    day: Box<str>,
+    appointments: Box<[ScheduledAppointment]>,
+}
+
+#[derive(Debug, Serialize)]
+struct ScheduledAppointment {
+    appointment_id: Box<str>,
+    carrier_id: Box<str>,
+    slot_start: Box<str>,
+    slot_end: Box<str>,
+    status: Box<str>,
+    arrived_at: Option<Box<str>>,
+}
+
+/// Execute only `carrier.create`.
+pub async fn carrier_create(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output: Vec<ItemResult<CarrierValue>> = Vec::with_capacity(items.len());
+    for item in items.into_vec() {
+        let result = async {
+            let parsed = parse_item::<NameInput>(&item)?;
+            let name = nonempty(&parsed.name, "name")?;
+            let row = run_transaction(&mut connection, move |transaction| {
+                Box::pin(async move {
+                    carrier_sql::insert_carrier(transaction, name)
+                        .await
+                        .map_err(|source| DockError::from_statement("insert carrier", &source))
+                })
+            })
+            .await?;
+            Ok::<_, DockError>(CarrierValue {
+                carrier_id: row.id.0.into_boxed_str(),
+                name: row.name.into_boxed_str(),
+            })
+        }
+        .await;
+        output.push(match result {
+            Ok(value) => ItemResult::Succeeded {
+                request_id: item.request_id,
+                value,
+            },
+            Err(error) => refused(item.request_id, operation_error(&error, "carrier.create")),
+        });
+    }
+    Ok(serialized(&output))
+}
+
+/// Execute only `dock.create`.
+pub async fn dock_create(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output: Vec<ItemResult<DockValue>> = Vec::with_capacity(items.len());
+    for item in items.into_vec() {
+        let result = async {
+            let parsed = parse_item::<NameInput>(&item)?;
+            let name = nonempty(&parsed.name, "name")?;
+            let row = run_transaction(&mut connection, move |transaction| {
+                Box::pin(async move {
+                    dock_sql::insert_dock(transaction, name)
+                        .await
+                        .map_err(|source| DockError::from_statement("insert dock", &source))
+                })
+            })
+            .await?;
+            Ok::<_, DockError>(DockValue {
+                dock_id: row.id.0.into_boxed_str(),
+                name: row.name.into_boxed_str(),
+            })
+        }
+        .await;
+        output.push(match result {
+            Ok(value) => ItemResult::Succeeded {
+                request_id: item.request_id,
+                value,
+            },
+            Err(error) => refused(item.request_id, operation_error(&error, "dock.create")),
+        });
+    }
+    Ok(serialized(&output))
+}
+
+fn nonempty(value: &str, field: &'static str) -> Result<String, DockError> {
+    if value.is_empty() {
+        Err(DockError::invalid(
+            format!("{field} must not be empty"),
+            field,
+        ))
+    } else {
+        Ok(value.to_owned())
+    }
+}
+
+/// One booking command, canonicalized before its idempotency key binds it.
+#[derive(Debug)]
+struct PreparedBooking {
+    idempotency_key: String,
+    dock_id: String,
+    carrier_id: String,
+    slot_start: String,
+    slot_end: String,
+    canonical_command: Vec<u8>,
+}
+
+/// Canonicalize, then hash. The bytes a key binds must not carry the caller's
+/// own spelling of a UUID or an instant.
+fn prepare_booking(parsed: &BookInput) -> Result<PreparedBooking, DockError> {
+    let idempotency_key = nonempty(&parsed.idempotency_key, "idempotency_key")?;
+    let dock_id = wire::uuid(&parsed.dock_id, "dock_id")?;
+    let carrier_id = wire::uuid(&parsed.carrier_id, "carrier_id")?;
+    let slot_start = wire::instant(&parsed.slot_start, "slot_start")?;
+    let slot_end = wire::instant(&parsed.slot_end, "slot_end")?;
+    let (slot_start, slot_end) = wire::slot(slot_start, slot_end)?;
+    let canonical = json!({
+        "carrier_id": carrier_id.hyphenated().to_string(),
+        "dock_id": dock_id.hyphenated().to_string(),
+        "slot_end": wire::canonical_instant(&slot_end),
+        "slot_start": wire::canonical_instant(&slot_start),
+    });
+    Ok(PreparedBooking {
+        idempotency_key,
+        dock_id: dock_id.hyphenated().to_string(),
+        carrier_id: carrier_id.hyphenated().to_string(),
+        slot_start: wire::canonical_instant(&slot_start),
+        slot_end: wire::canonical_instant(&slot_end),
+        canonical_command: canonical_json_bytes(&canonical),
+    })
+}
+
+/// Execute only `appointment.book`.
+pub async fn appointment_book(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output: Vec<ItemResult<AppointmentValue>> = Vec::with_capacity(items.len());
+    for item in items.into_vec() {
+        let result = async {
+            let parsed = parse_item::<BookInput>(&item)?;
+            let command = prepare_booking(&parsed)?;
+            run_transaction(&mut connection, move |transaction| {
+                Box::pin(book_in(transaction, command))
+            })
+            .await
+        }
+        .await;
+        output.push(match result {
+            Ok(value) => ItemResult::Succeeded {
+                request_id: item.request_id,
+                value,
+            },
+            Err(error) => refused(item.request_id, operation_error(&error, "appointment.book")),
+        });
+    }
+    Ok(serialized(&output))
+}
+
+/// Book one slot in exactly one transaction, with no automatic retry.
+///
+/// The dock row is locked before the overlap is read, so the read that decides
+/// `slot_unavailable` and the write that would break it are one serialized
+/// section per dock. Two concurrent bookings on one dock therefore cannot both
+/// observe a free slot.
+async fn book_in(
+    transaction: &mut Transaction,
+    command: PreparedBooking,
+) -> Result<AppointmentValue, DockError> {
+    if let Some(replay) = book_sql::find_replay(transaction, command.idempotency_key.clone())
+        .await
+        .map_err(|source| DockError::from_statement("find booking replay", &source))?
+    {
+        return replay_value(replay, &command.canonical_command);
+    }
+
+    let claim = book_sql::claim_command(
+        transaction,
+        command.idempotency_key.clone(),
+        command.canonical_command.clone(),
+    )
+    .await
+    .map_err(|source| DockError::from_statement("claim booking key", &source))?;
+    let Some(claim) = claim else {
+        let replay = book_sql::find_replay(transaction, command.idempotency_key.clone())
+            .await
+            .map_err(|source| DockError::from_statement("load concurrent replay", &source))?
+            .ok_or_else(|| {
+                DockError::internal("a conflicting booking claim has no durable result")
+            })?;
+        return replay_value(replay, &command.canonical_command);
+    };
+
+    book_sql::lock_dock(transaction, WamnUuid(command.dock_id.clone()))
+        .await
+        .map_err(|source| DockError::from_statement("lock dock", &source))?
+        .ok_or_else(|| {
+            DockError::subject(
+                DockErrorKind::DockNotFound,
+                "dock does not exist",
+                "dock_id",
+                command.dock_id.clone(),
+            )
+        })?;
+    book_sql::find_carrier(transaction, WamnUuid(command.carrier_id.clone()))
+        .await
+        .map_err(|source| DockError::from_statement("load carrier", &source))?
+        .ok_or_else(|| {
+            DockError::subject(
+                DockErrorKind::CarrierNotFound,
+                "carrier does not exist",
+                "carrier_id",
+                command.carrier_id.clone(),
+            )
+        })?;
+
+    let overlap = book_sql::find_overlap(
+        transaction,
+        WamnUuid(command.dock_id.clone()),
+        TimestampTz(command.slot_start.clone()),
+        TimestampTz(command.slot_end.clone()),
+    )
+    .await
+    .map_err(|source| DockError::from_statement("find overlapping appointment", &source))?;
+    if let Some(overlap) = overlap {
+        let held_start = instant_field(&overlap.slot_start, "slot_start")?;
+        let held_end = instant_field(&overlap.slot_end, "slot_end")?;
+        return Err(DockError::subject(
+            DockErrorKind::SlotUnavailable,
+            format!("the dock already holds an appointment from {held_start} to {held_end}"),
+            "slot_start",
+            overlap.id.0,
+        ));
+    }
+
+    let row = book_sql::insert_appointment(
+        transaction,
+        claim.appointment_id.clone(),
+        WamnUuid(command.dock_id.clone()),
+        WamnUuid(command.carrier_id.clone()),
+        TimestampTz(command.slot_start.clone()),
+        TimestampTz(command.slot_end.clone()),
+    )
+    .await
+    .map_err(|source| DockError::from_statement("insert appointment", &source))?;
+    Ok(AppointmentValue {
+        appointment_id: row.id.0.into_boxed_str(),
+        dock_id: row.dock_id.0.into_boxed_str(),
+        carrier_id: row.carrier_id.0.into_boxed_str(),
+        slot_start: instant_field(&row.slot_start, "slot_start")?,
+        slot_end: instant_field(&row.slot_end, "slot_end")?,
+        status: wire::status(&row.status)?.into(),
+        row_version: row.row_version.to_string().into_boxed_str(),
+    })
+}
+
+/// Answer one replay from its durable original, or refuse a rebound key.
+fn replay_value(
+    replay: book_sql::FindReplayRow,
+    canonical_command: &[u8],
+) -> Result<AppointmentValue, DockError> {
+    if replay.canonical_command != canonical_command {
+        return Err(DockError::new(
+            DockErrorKind::IdempotencyConflict,
+            "idempotency_key is already bound to a different booking",
+        )
+        .with_field("idempotency_key"));
+    }
+    let (
+        Some(dock_id),
+        Some(carrier_id),
+        Some(slot_start),
+        Some(slot_end),
+        Some(status),
+        Some(row_version),
+    ) = (
+        replay.dock_id,
+        replay.carrier_id,
+        replay.slot_start,
+        replay.slot_end,
+        replay.status,
+        replay.row_version,
+    )
+    else {
+        return Err(DockError::internal(
+            "a durable booking claim has no appointment row",
+        ));
+    };
+    Ok(AppointmentValue {
+        appointment_id: replay.appointment_id.0.into_boxed_str(),
+        dock_id: dock_id.0.into_boxed_str(),
+        carrier_id: carrier_id.0.into_boxed_str(),
+        slot_start: instant_field(&slot_start, "slot_start")?,
+        slot_end: instant_field(&slot_end, "slot_end")?,
+        status: wire::status(&status)?.into(),
+        row_version: row_version.to_string().into_boxed_str(),
+    })
+}
+
+fn instant_field(value: &TimestampTz, column: &'static str) -> Result<Box<str>, DockError> {
+    wire::row_instant(value, column).map(|instant| wire::wire_instant(&instant).into_boxed_str())
+}
+
+/// Execute only `appointment.check_in`.
+pub async fn appointment_check_in(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output: Vec<ItemResult<CheckInValue>> = Vec::with_capacity(items.len());
+    for item in items.into_vec() {
+        let result = async {
+            let parsed = parse_item::<CheckInInput>(&item)?;
+            let appointment_id = wire::uuid(&parsed.appointment_id, "appointment_id")?;
+            let arrived_at = wire::instant(&parsed.arrived_at, "arrived_at")?;
+            let identity = appointment_id.hyphenated().to_string();
+            let bound = wire::canonical_instant(&arrived_at);
+            let row = run_transaction(&mut connection, move |transaction| {
+                let identity = identity.clone();
+                Box::pin(async move {
+                    check_in_sql::check_in(
+                        transaction,
+                        WamnUuid(identity),
+                        TimestampTz(bound.clone()),
+                    )
+                    .await
+                    .map_err(|source| DockError::from_statement("check in appointment", &source))
+                })
+            })
+            .await?;
+            check_in_value(row, &appointment_id.hyphenated().to_string())
+        }
+        .await;
+        output.push(match result {
+            Ok(value) => ItemResult::Succeeded {
+                request_id: item.request_id,
+                value,
+            },
+            Err(error) => refused(
+                item.request_id,
+                operation_error(&error, "appointment.check_in"),
+            ),
+        });
+    }
+    Ok(serialized(&output))
+}
+
+/// Read the single classified row the check-in statement returns.
+fn check_in_value(
+    row: check_in_sql::CheckInRow,
+    appointment_id: &str,
+) -> Result<CheckInValue, DockError> {
+    match row.outcome.as_str() {
+        "not_found" => {
+            return Err(DockError::subject(
+                DockErrorKind::NotFound,
+                "appointment does not exist",
+                "appointment_id",
+                appointment_id,
+            ));
+        }
+        "invalid_status_transition" => {
+            return Err(DockError::subject(
+                DockErrorKind::InvalidStatusTransition,
+                "appointment is no longer scheduled",
+                "appointment_id",
+                appointment_id,
+            ));
+        }
+        "arrived" => {}
+        _ => {
+            return Err(DockError::internal(
+                "the check-in statement returned an outcome outside its contract",
+            ));
+        }
+    }
+    let (Some(id), Some(status), Some(arrived_at), Some(row_version)) = (
+        row.appointment_id,
+        row.status,
+        row.arrived_at,
+        row.row_version,
+    ) else {
+        return Err(DockError::internal(
+            "the check-in statement moved a row without returning it",
+        ));
+    };
+    Ok(CheckInValue {
+        appointment_id: id.0.into_boxed_str(),
+        status: wire::status(&status)?.into(),
+        arrived_at: instant_field(&arrived_at, "arrived_at")?,
+        row_version: row_version.to_string().into_boxed_str(),
+    })
+}
+
+/// Execute only `appointment.query`.
+pub async fn appointment_query(input: &str) -> Result<String, InvocationError> {
+    let items = prepare_envelope(input)?;
+    let mut connection = Connection::new();
+    let mut output: Vec<ItemResult<ScheduleValue>> = Vec::with_capacity(items.len());
+    for item in items.into_vec() {
+        let result = async {
+            let parsed = parse_item::<QueryInput>(&item)?;
+            let dock_id = wire::uuid(&parsed.dock_id, "dock_id")?;
+            let day = wire::day(&parsed.day, "day")?;
+            let status = match parsed.status.as_deref() {
+                None => None,
+                Some(value) => Some(wire::status(value).map_err(|_| {
+                    DockError::invalid("status is outside the appointment vocabulary", "status")
+                })?),
+            }
+            .map(str::to_owned);
+            let rows = read_schedule(
+                &mut connection,
+                &dock_id.hyphenated().to_string(),
+                &day,
+                status,
+            )
+            .await?;
+            Ok::<_, DockError>(ScheduleValue {
+                dock_id: dock_id.hyphenated().to_string().into_boxed_str(),
+                day: parsed.day.clone(),
+                appointments: rows,
+            })
+        }
+        .await;
+        output.push(match result {
+            Ok(value) => ItemResult::Succeeded {
+                request_id: item.request_id,
+                value,
+            },
+            Err(error) => refused(
+                item.request_id,
+                operation_error(&error, "appointment.query"),
+            ),
+        });
+    }
+    Ok(serialized(&output))
+}
+
+async fn read_schedule(
+    connection: &mut Connection,
+    dock_id: &str,
+    day: &wire::Day,
+    status: Option<String>,
+) -> Result<Box<[ScheduledAppointment]>, DockError> {
+    let day_start = wire::canonical_instant(&day.start);
+    let day_end = wire::canonical_instant(&day.end);
+    let mut transaction = connection
+        .begin()
+        .await
+        .map_err(|source| DockError::from_statement("begin appointment query", &source))?;
+    let rows = query_sql::list_appointment(
+        &mut transaction,
+        WamnUuid(dock_id.to_owned()),
+        TimestampTz(day_start),
+        TimestampTz(day_end),
+        status,
+    )
+    .await
+    .map_err(|source| DockError::from_statement("list appointments", &source))?;
+    transaction
+        .commit()
+        .await
+        .map_err(|source| DockError::from_statement("commit appointment query", &source))?;
+    rows.into_iter()
+        .map(|row| {
+            Ok(ScheduledAppointment {
+                appointment_id: row.id.0.into_boxed_str(),
+                carrier_id: row.carrier_id.0.into_boxed_str(),
+                slot_start: instant_field(&row.slot_start, "slot_start")?,
+                slot_end: instant_field(&row.slot_end, "slot_end")?,
+                status: wire::status(&row.status)?.into(),
+                arrived_at: row
+                    .arrived_at
+                    .as_ref()
+                    .map(|value| instant_field(value, "arrived_at"))
+                    .transpose()?,
+            })
+        })
+        .collect::<Result<Vec<_>, DockError>>()
+        .map(Vec::into_boxed_slice)
+}
diff --git a/components/application/dock/src/wire.rs b/components/application/dock/src/wire.rs
new file mode 100644
index 00000000..57b5880e
--- /dev/null
+++ b/components/application/dock/src/wire.rs
@@ -0,0 +1,175 @@
+//! Canonical wire spellings shared by every dock operation.
+
+use chrono::{DateTime, SecondsFormat, Utc};
+use uuid::Uuid;
+
+use crate::error::{DockError, DockErrorKind};
+
+/// One calendar day, read in UTC.
+///
+/// The scenario names a day and no zone, and the slots it books carry `Z`, so
+/// the package reads a day as the UTC day. A zoned day is a deployment binding
+/// this package does not have.
+pub(crate) struct Day {
+    pub(crate) start: DateTime<Utc>,
+    pub(crate) end: DateTime<Utc>,
+}
+
+/// Parse one RFC 3339 instant and return it in UTC.
+pub(crate) fn instant(value: &str, field: &'static str) -> Result<DateTime<Utc>, DockError> {
+    DateTime::parse_from_rfc3339(value)
+        .map(|timestamp| timestamp.to_utc())
+        .map_err(|_| DockError::invalid(format!("{field} must be an RFC 3339 instant"), field))
+}
+
+/// Spell one instant the way every dock result spells it.
+///
+/// UTC with a `Z`, and the fewest digits that still name the stored value: no
+/// fractional part for a whole second, six digits otherwise. The SQL `ORDER BY`
+/// remains the ordering authority, because two spellings of different precision
+/// do not compare lexically.
+pub(crate) fn wire_instant(value: &DateTime<Utc>) -> String {
+    if value.timestamp_subsec_nanos() == 0 {
+        value.to_rfc3339_opts(SecondsFormat::Secs, true)
+    } else {
+        value.to_rfc3339_opts(SecondsFormat::Micros, true)
+    }
+}
+
+/// Spell one instant the way durable command bytes spell it.
+///
+/// Six fractional digits, always, under the naming law. Canonicalize and then
+/// hash: an instant that reached the command bytes in the caller's own spelling
+/// would bind one idempotency key to two different byte strings.
+pub(crate) fn canonical_instant(value: &DateTime<Utc>) -> String {
+    value.to_rfc3339_opts(SecondsFormat::Micros, true)
+}
+
+/// Parse one UUID and return its canonical lowercase hyphenated spelling.
+pub(crate) fn uuid(value: &str, field: &'static str) -> Result<Uuid, DockError> {
+    Uuid::try_parse(value)
+        .ok()
+        .filter(|parsed| parsed.hyphenated().to_string() == value)
+        .ok_or_else(|| {
+            DockError::invalid(
+                format!("{field} must be a lowercase hyphenated UUID"),
+                field,
+            )
+        })
+}
+
+/// Read one `YYYY-MM-DD` day and return its half-open UTC bounds.
+pub(crate) fn day(value: &str, field: &'static str) -> Result<Day, DockError> {
+    let refuse = || DockError::invalid(format!("{field} must be a YYYY-MM-DD date"), field);
+    let date = chrono::NaiveDate::parse_from_str(value, "%Y-%m-%d").map_err(|_| refuse())?;
+    if date.format("%Y-%m-%d").to_string() != value {
+        return Err(refuse());
+    }
+    let start = date.and_hms_opt(0, 0, 0).ok_or_else(refuse)?.and_utc();
+    let end = date
+        .succ_opt()
+        .ok_or_else(refuse)?
+        .and_hms_opt(0, 0, 0)
+        .ok_or_else(refuse)?
+        .and_utc();
+    Ok(Day { start, end })
+}
+
+/// Refuse a slot whose end does not follow its start.
+pub(crate) fn slot(
+    start: DateTime<Utc>,
+    end: DateTime<Utc>,
+) -> Result<(DateTime<Utc>, DateTime<Utc>), DockError> {
+    if end > start {
+        Ok((start, end))
+    } else {
+        Err(DockError::invalid(
+            "slot_end must be later than slot_start",
+            "slot_end",
+        ))
+    }
+}
+
+/// Read one instant a statement returned.
+pub(crate) fn row_instant(
+    value: &wamn_postgres_statements::TimestampTz,
+    column: &'static str,
+) -> Result<DateTime<Utc>, DockError> {
+    DateTime::parse_from_rfc3339(&value.0)
+        .map(|timestamp| timestamp.to_utc())
+        .map_err(|_| DockError::internal(format!("stored {column} is not RFC 3339")))
+}
+
+/// Refuse a stored status outside the appointment vocabulary.
+pub(crate) fn status(value: &str) -> Result<&str, DockError> {
+    match value {
+        "scheduled" | "arrived" | "departed" => Ok(value),
+        _ => Err(DockError::new(
+            DockErrorKind::InternalError,
+            "stored status is outside the appointment vocabulary",
+        )),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{canonical_instant, day, instant, slot, uuid, wire_instant};
+
+    #[test]
+    fn a_result_spells_a_whole_second_without_a_fractional_part() {
+        let value = instant("2026-10-01T09:07:00Z", "arrived_at").expect("RFC 3339");
+        assert_eq!(wire_instant(&value), "2026-10-01T09:07:00Z");
+        assert_eq!(canonical_instant(&value), "2026-10-01T09:07:00.000000Z");
+    }
+
+    #[test]
+    fn one_instant_has_one_canonical_command_spelling_whatever_the_caller_sent() {
+        let zulu = instant("2026-10-01T09:00:00Z", "slot_start").expect("RFC 3339");
+        let offset = instant("2026-10-01T11:00:00+02:00", "slot_start").expect("RFC 3339");
+        assert_eq!(canonical_instant(&zulu), canonical_instant(&offset));
+    }
+
+    #[test]
+    fn a_result_keeps_six_digits_when_the_value_has_a_fraction() {
+        let value = instant("2026-10-01T09:07:00.500Z", "arrived_at").expect("RFC 3339");
+        assert_eq!(wire_instant(&value), "2026-10-01T09:07:00.500000Z");
+    }
+
+    #[test]
+    fn a_day_is_the_half_open_utc_interval_that_names_it() {
+        let bounds = day("2026-10-01", "day").expect("a calendar day");
+        assert_eq!(wire_instant(&bounds.start), "2026-10-01T00:00:00Z");
+        assert_eq!(wire_instant(&bounds.end), "2026-10-02T00:00:00Z");
+    }
+
+    #[test]
+    fn a_day_refuses_every_spelling_but_the_calendar_one() {
+        for candidate in [
+            "2026-10-1",
+            "2026-13-01",
+            "01-10-2026",
+            "2026-10-01T00:00:00Z",
+        ] {
+            assert!(day(candidate, "day").is_err(), "{candidate} was accepted");
+        }
+    }
+
+    #[test]
+    fn a_slot_must_end_after_it_starts() {
+        let start = instant("2026-10-01T09:00:00Z", "slot_start").expect("RFC 3339");
+        let end = instant("2026-10-01T10:00:00Z", "slot_end").expect("RFC 3339");
+        assert!(slot(start, end).is_ok());
+        assert!(slot(end, start).is_err());
+        assert!(slot(start, start).is_err());
+    }
+
+    #[test]
+    fn a_uuid_is_accepted_only_in_its_canonical_spelling() {
+        let canonical = "3f172e02-bfc2-4cea-882a-df88937d6a3c";
+        assert!(uuid(canonical, "dock_id").is_ok());
+        assert!(uuid("00000000-0000-0000-0000-000000000000", "dock_id").is_ok());
+        assert!(uuid("3f172e02bfc24cea882adf88937d6a3c", "dock_id").is_err());
+        assert!(uuid(&canonical.to_uppercase(), "dock_id").is_err());
+        assert!(uuid("not-a-uuid", "dock_id").is_err());
+    }
+}
