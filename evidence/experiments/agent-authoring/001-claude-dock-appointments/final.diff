diff --git a/packages/dock/command/appointment_check_in/check_in.sql b/packages/dock/command/appointment_check_in/check_in.sql
new file mode 100644
index 00000000..e6f5b7de
--- /dev/null
+++ b/packages/dock/command/appointment_check_in/check_in.sql
@@ -0,0 +1,34 @@
+WITH target AS MATERIALIZED (
+    SELECT id, status
+    FROM appointment
+    WHERE id = $1
+    FOR UPDATE
+),
+moved AS (
+    UPDATE appointment AS model
+    SET
+        status = 'arrived',
+        arrived_at = $2,
+        row_version = model.row_version + 1,
+        updated_at = CURRENT_TIMESTAMP
+    FROM target
+    WHERE model.id = target.id
+        AND target.status = 'scheduled'
+    RETURNING
+        model.id,
+        model.status,
+        model.arrived_at,
+        model.row_version
+)
+SELECT
+    CASE
+        WHEN NOT EXISTS (SELECT 1 FROM target) THEN 'not_found'
+        WHEN NOT EXISTS (SELECT 1 FROM moved) THEN 'invalid_status_transition'
+        ELSE 'arrived'
+    END AS outcome,
+    moved.id AS appointment_id,
+    moved.status,
+    moved.arrived_at,
+    moved.row_version
+FROM (SELECT 1) AS singleton
+LEFT JOIN moved ON TRUE;
