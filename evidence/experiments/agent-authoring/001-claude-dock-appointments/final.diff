diff --git a/components/application/dock/src/error.rs b/components/application/dock/src/error.rs
new file mode 100644
index 00000000..df9b4af5
--- /dev/null
+++ b/components/application/dock/src/error.rs
@@ -0,0 +1,193 @@
+//! One contextual data-access failure, translated once at the operation boundary.
+
+use std::error::Error;
+use std::fmt;
+
+use wamn_postgres_statements::{StatementError, StatementErrorKind};
+
+/// Stable refusal class carried by every dock operation.
+///
+/// The literals are the manifest's own error vocabulary. Callers match this
+/// class; they never match display text.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum DockErrorKind {
+    InvalidInput,
+    NotFound,
+    DockNotFound,
+    CarrierNotFound,
+    SlotUnavailable,
+    IdempotencyConflict,
+    InvalidStatusTransition,
+    Retry,
+    Timeout,
+    PermissionDenied,
+    InternalError,
+}
+
+impl DockErrorKind {
+    /// Frozen manifest-owned error literal.
+    pub const fn literal(self) -> &'static str {
+        match self {
+            Self::InvalidInput => "invalid_input",
+            Self::NotFound => "not_found",
+            Self::DockNotFound => "dock_not_found",
+            Self::CarrierNotFound => "carrier_not_found",
+            Self::SlotUnavailable => "slot_unavailable",
+            Self::IdempotencyConflict => "idempotency_conflict",
+            Self::InvalidStatusTransition => "invalid_status_transition",
+            Self::Retry => "retry",
+            Self::Timeout => "timeout",
+            Self::PermissionDenied => "permission_denied",
+            Self::InternalError => "internal_error",
+        }
+    }
+}
+
+/// Contextual dock failure with the detail its error code requires.
+#[derive(Debug)]
+pub struct DockError {
+    kind: DockErrorKind,
+    context: Box<str>,
+    field: Option<&'static str>,
+    id: Option<Box<str>>,
+}
+
+impl DockError {
+    /// Stable class owned by the manifest error set.
+    pub const fn kind(&self) -> DockErrorKind {
+        self.kind
+    }
+
+    /// Stable contextual description for the node error boundary.
+    pub fn context(&self) -> &str {
+        &self.context
+    }
+
+    /// Input field owned by a field-bearing refusal.
+    pub const fn field(&self) -> Option<&'static str> {
+        self.field
+    }
+
+    /// Subject identity owned by a field-and-id refusal.
+    pub fn id(&self) -> Option<&str> {
+        self.id.as_deref()
+    }
+
+    pub(crate) fn new(kind: DockErrorKind, context: impl Into<Box<str>>) -> Self {
+        Self {
+            kind,
+            context: context.into(),
+            field: None,
+            id: None,
+        }
+    }
+
+    pub(crate) fn invalid(context: impl Into<Box<str>>, field: &'static str) -> Self {
+        let mut error = Self::new(DockErrorKind::InvalidInput, context);
+        error.field = Some(field);
+        error
+    }
+
+    pub(crate) fn internal(context: impl Into<Box<str>>) -> Self {
+        Self::new(DockErrorKind::InternalError, context)
+    }
+
+    pub(crate) fn subject(
+        kind: DockErrorKind,
+        context: impl Into<Box<str>>,
+        field: &'static str,
+        id: impl Into<Box<str>>,
+    ) -> Self {
+        let mut error = Self::new(kind, context);
+        error.field = Some(field);
+        error.id = Some(id.into());
+        error
+    }
+
+    pub(crate) fn with_field(mut self, field: &'static str) -> Self {
+        self.field = Some(field);
+        self
+    }
+
+    /// Translate one transport failure into the operation vocabulary.
+    ///
+    /// No named constraint reaches a caller: every dock refusal a caller can
+    /// observe is decided before the write, so a constraint that still fires is
+    /// a defect and must not be re-spelled as a domain outcome.
+    pub(crate) fn from_statement(context: impl Into<Box<str>>, source: &StatementError) -> Self {
+        Self::new(classify(source.kind()), context)
+    }
+}
+
+/// Map one transport class to the operation class the caller may observe.
+const fn classify(kind: StatementErrorKind) -> DockErrorKind {
+    match kind {
+        StatementErrorKind::SerializationFailure | StatementErrorKind::ConnectionUnavailable => {
+            DockErrorKind::Retry
+        }
+        StatementErrorKind::StatementTimeout => DockErrorKind::Timeout,
+        StatementErrorKind::PermissionDenied => DockErrorKind::PermissionDenied,
+        StatementErrorKind::UniqueViolation
+        | StatementErrorKind::ForeignKeyViolation
+        | StatementErrorKind::CheckViolation
+        | StatementErrorKind::UnknownStatement
+        | StatementErrorKind::StatementContractMismatch
+        | StatementErrorKind::RowLimitExceeded
+        | StatementErrorKind::QueryError
+        | StatementErrorKind::InvalidResult => DockErrorKind::InternalError,
+    }
+}
+
+impl fmt::Display for DockError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "{}: {}", self.kind.literal(), self.context)
+    }
+}
+
+impl Error for DockError {}
+
+impl From<StatementError> for DockError {
+    fn from(source: StatementError) -> Self {
+        Self::from_statement("run dock statement", &source)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{DockErrorKind, classify};
+    use wamn_postgres_statements::StatementErrorKind;
+
+    #[test]
+    fn transport_classes_keep_their_router_meaning() {
+        let cases = [
+            (
+                StatementErrorKind::SerializationFailure,
+                DockErrorKind::Retry,
+            ),
+            (
+                StatementErrorKind::ConnectionUnavailable,
+                DockErrorKind::Retry,
+            ),
+            (StatementErrorKind::StatementTimeout, DockErrorKind::Timeout),
+            (
+                StatementErrorKind::PermissionDenied,
+                DockErrorKind::PermissionDenied,
+            ),
+            (StatementErrorKind::QueryError, DockErrorKind::InternalError),
+        ];
+        for (transport, expected) in cases {
+            assert_eq!(classify(transport), expected);
+        }
+    }
+
+    #[test]
+    fn a_named_constraint_never_becomes_a_domain_refusal() {
+        for transport in [
+            StatementErrorKind::UniqueViolation,
+            StatementErrorKind::ForeignKeyViolation,
+            StatementErrorKind::CheckViolation,
+        ] {
+            assert_eq!(classify(transport), DockErrorKind::InternalError);
+        }
+    }
+}
