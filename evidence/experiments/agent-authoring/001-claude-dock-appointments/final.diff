+    claim.canonical_command,
+    claim.appointment_id,
+    appointment.dock_id,
+    appointment.carrier_id,
+    appointment.slot_start,
+    appointment.slot_end,
+    appointment.status,
+    appointment.row_version
+FROM appointment_book_command AS claim
