      "spec": {
        "containers": [
          {
            "args": [
              "headers=/tmp/headers\nbody=/tmp/body\n# --retry-connrefused because the Service can be Ready before\n# kube-proxy has programmed it, and a refused connection returns\n# INSTANTLY, so --connect-timeout never applies (wamn-0h0g.15.137.14).\nstatus=$(curl --silent --show-error --connect-timeout 5 --max-time 15 \\\n  --retry 15 --retry-delay 1 --retry-connrefused \\\n  --dump-header \"$headers\" --output \"$body\" --write-out '%{http_code}' \\\n  --header 'Host: receiving.localhost' \\\n  'http://flow-http.wamn-receiving-postcommit.svc.cluster.local/no-such-route')\ncontent_type=$(sed -n 's/^[Cc]ontent-[Tt]ype:[[:space:]]*//p' \"$headers\" \\\n  | tr -d '\\r' | head -n 1)\ntest \"$status\" = 404\ntest \"$content_type\" = application/json\nprintf '%s' '{\"error\":{\"code\":\"route-not-found\"}}' >/tmp/expected\ncmp -s /tmp/expected \"$body\"\nprintf '%s\\n' 'RECEIVING_HTTP_PROBE {\"status\":404,\"content_type\":\"application/json\",\"host\":\"receiving.localhost\",\"body\":{\"error\":{\"code\":\"route-not-found\"}}}'\n"
            ],
            "command": [
              "/bin/sh",
              "-ec"
            ],
