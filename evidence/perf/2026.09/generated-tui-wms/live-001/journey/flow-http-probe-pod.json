                "containers": [
                    {
                        "args": [
                            "headers=/tmp/headers\nbody=/tmp/body\nstatus=$(curl --silent --show-error --connect-timeout 5 --max-time 15 \\\n  --dump-header \"$headers\" --output \"$body\" --write-out '%{http_code}' \\\n  --header 'Host: wms.localhost' \\\n  'http://flow-http.wamn-wms-journey.svc.cluster.local/no-such-route')\ncontent_type=$(sed -n 's/^[Cc]ontent-[Tt]ype:[[:space:]]*//p' \"$headers\" \\\n  | tr -d '\\r' | head -n 1)\ntest \"$status\" = 404\ntest \"$content_type\" = application/json\nprintf '%s' '{\"error\":{\"code\":\"route-not-found\"}}' \u003e/tmp/expected\ncmp -s /tmp/expected \"$body\"\nprintf '%s\\n' 'WMS_HTTP_PROBE {\"status\":404,\"content_type\":\"application/json\",\"host\":\"wms.localhost\",\"body\":{\"error\":{\"code\":\"route-not-found\"}}}'\n"
                        ],
                        "command": [
                            "/bin/sh",
