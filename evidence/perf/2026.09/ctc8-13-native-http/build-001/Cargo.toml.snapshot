[package]
name = "ctc8-13-native-http"
version = "0.0.0"
edition = "2024"
publish = false

# Disposable experiment, deliberately outside the production workspace.
[workspace]

[dependencies]
anyhow = "1"
bytes = "1"
futures-util = "0.3"
http-body-util = "0.1"
hyper = { version = "1", features = ["server", "http1", "http2"] }
hyper-util = { version = "0.1", features = ["client-legacy", "http1", "http2", "tokio"] }
mimalloc = "0.1"
rcgen = "0.14.8"
rustls = { version = "0.23", default-features = false, features = ["std", "aws_lc_rs", "tls12"] }
serde_json = "1"
tokio = { version = "1", features = ["macros", "rt-multi-thread", "net", "sync", "time", "io-util"] }
tokio-rustls = "0.26"
wamn-runtime = { path = "../../../crates/platform/runtime" }
wamn-execution-contract = { path = "../../../components/execution/contract" }
wash-runtime = { git = "https://github.com/dkkloimwieder/wasmCloud", rev = "735b57982545358409a7d965a22549b08487ca09", default-features = false }
wasmtime-wasi = "=47.0.3"
wasmtime-wasi-http = "=47.0.3"
