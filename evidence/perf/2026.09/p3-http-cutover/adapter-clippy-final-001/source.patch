-    seconds: u64,
-    nanoseconds: u32,
-  }
-
-  /// Read the current value of the clock.
-  ///
-  /// This clock is not monotonic, therefore calling this function repeatedly
-  /// will not necessarily produce a sequence of non-decreasing values.
