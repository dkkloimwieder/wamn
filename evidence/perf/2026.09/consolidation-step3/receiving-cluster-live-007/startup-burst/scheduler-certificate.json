{
  "apiVersion": "cert-manager.io/v1",
  "kind": "Certificate",
  "metadata": {
    "name": "receiving-startup-nats-tls",
    "namespace": "wamn-system"
  },
  "spec": {
    "commonName": "nats",
    "dnsNames": [
      "nats",
      "nats.wamn-system",
      "nats.wamn-system.svc",
      "nats.wamn-system.svc.cluster.local"
    ],
    "ipAddresses": [
      "127.0.0.1"
    ],
    "issuerRef": {
      "group": "cert-manager.io",
      "kind": "ClusterIssuer",
      "name": "wasmcloud-ca"
    },
    "secretName": "receiving-startup-nats-tls",
    "usages": [
      "server auth",
      "digital signature",
      "key encipherment"
    ]
  }
}