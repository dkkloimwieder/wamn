        "text": "#[tokio::test]"
      },
      {
        "line": 11,
        "text": "#[ignore = \"builds two independent Receiving installations and compares the unchanged overlay\"]"
      },
      {
        "line": 12,
        "text": "async fn unchanged_overlay_across_baseline_and_additive_installations() -> anyhow::Result<()> {"
      },
      {
        "line": 13,
        "text": "    let evidence = super::evidence_directory().await?;"
      },
      {
        "line": 14,
        "text": "    super::with_signals(&evidence, async {"
      },
      {
        "line": 15,
        "text": "        fs::create_dir(&evidence)?;"
      },
      {
        "line": 16,
        "text": "        super::postcommit_case::run_selected(BaseCandidate::Baseline, &evidence.join(\"baseline\"))"
      },
      {
        "line": 17,
        "text": "            .await?;"
      },
      {
        "line": 18,
        "text": "        super::postcommit_case::run_selected(BaseCandidate::Additive, &evidence.join(\"additive\"))"
      },
      {
        "line": 19,
        "text": "            .await?;"
      },
      {
        "line": 20,
        "text": "        let (source, baseline) = installation(&evidence.join(\"baseline\"), \"baseline\")?;"
      },
      {
        "line": 21,
        "text": "        let (additive_source, additive) = installation(&evidence.join(\"additive\"), \"additive\")?;"
      },
      {
        "line": 22,
        "text": "        ensure!("
      },
      {
        "line": 23,
        "text": "            source == additive_source,"
      },
      {
        "line": 24,
        "text": "            \"the two installations must use the same source commit\""
      },
      {
        "line": 25,
        "text": "        );"
      },
      {
        "line": 26,
        "text": "        let result = compare(&source, &baseline, &additive)?;"
      },
      {
        "line": 27,
        "text": "        fs::write("
      },
      {
        "line": 28,
        "text": "            evidence.join(\"pair.json\"),"
      },
      {
        "line": 29,
        "text": "            serde_json::to_vec_pretty(&result)?,"
      }
