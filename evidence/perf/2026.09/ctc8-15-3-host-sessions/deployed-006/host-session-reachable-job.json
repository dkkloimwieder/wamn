{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "host-session-reachable",
    "namespace": "wamn-receiving-journey"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 430,
    "template": {
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "host-session",
            "image": "wamn-gates:receiving-de6d70b3f324-1473121-release",
            "imagePullPolicy": "Never",
            "command": [
              "/usr/local/bin/wamn-gates",
              "host-session-proof"
            ],
            "env": [
              {
                "name": "WAMN_IDENTITY_ISSUER",
                "value": "https://host-session-identity.wamn-receiving-journey.svc.cluster.local"
              },
              {
                "name": "WAMN_IDENTITY_CA_FILE",
                "value": "/etc/host-session-ca/ca.crt"
              },
              {
                "name": "WAMN_HOST_SESSION_FIXTURE_FILE",
                "value": "/etc/host-session-fixture/fixture.json"
              },
              {
                "name": "WAMN_HOST_SESSION_ENDPOINTS",
                "value": "http://10.244.2.5:80/purchase_order/get,http://10.244.1.7:80/purchase_order/get"
              },
              {
                "name": "WAMN_HOST_SESSION_JWKS_AVAILABLE",
                "value": "true"
              }
            ],
            "volumeMounts": [
              {
                "name": "ca",
                "mountPath": "/etc/host-session-ca",
                "readOnly": true
              },
              {
                "name": "fixture",
                "mountPath": "/etc/host-session-fixture",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "ca",
            "configMap": {
              "name": "host-session-public-ca"
            }
          },
          {
            "name": "fixture",
            "secret": {
              "secretName": "host-session-fixture",
              "defaultMode": 256
            }
          }
        ]
      }
    }
  }
}
