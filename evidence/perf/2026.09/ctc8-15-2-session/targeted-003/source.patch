+/// Keep A connected while the real CLI upgrades the exact foundation ACL for B.
+async fn upgrade_foundation_surface(
+    admin: &Client,
+    admin_url: &str,
+    b_path: &Path,
+) -> anyhow::Result<()> {
+    let current = stable_acl(admin).await?;
