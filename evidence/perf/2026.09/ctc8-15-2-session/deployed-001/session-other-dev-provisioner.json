{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "identity-session-provision-other-dev",
    "namespace": "wamn-identity-jwks"
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "provisioner",
        "image": "wamn-gates:jwks-6766a6026230-4101634",
        "imagePullPolicy": "Never",
        "command": [
          "sleep",
          "1800"
        ],
        "env": [
          {
            "name": "WAMN_SYSTEM_ADMIN_URL",
            "valueFrom": {
              "secretKeyRef": {
                "name": "identity-postgres-admin",
                "key": "url"
              }
            }
          },
          {
            "name": "WAMN_TARGET_ADMIN_DATABASE_URL",
            "valueFrom": {
              "secretKeyRef": {
                "name": "identity-session-admin-other-dev",
                "key": "url"
              }
            }
          }
        ]
      }
    ]
  }
}
