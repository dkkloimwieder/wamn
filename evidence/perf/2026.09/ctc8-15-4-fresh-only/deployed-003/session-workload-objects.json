{
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
        "labels": {
            "app": "flow-http"
        },
        "name": "flow-http",
        "namespace": "wamn-receiving-journey"
    },
    "spec": {
        "ports": [
            {
                "name": "http",
                "port": 80,
                "protocol": "TCP",
                "targetPort": 80
            }
        ],
        "type": "ClusterIP"
    }
}
{
    "apiVersion": "runtime.wasmcloud.dev/v1alpha1",
    "kind": "WorkloadDeployment",
    "metadata": {
        "name": "flow-http",
        "namespace": "wamn-receiving-journey"
    },
    "spec": {
        "replicas": 1,
        "template": {
            "spec": {
                "components": [
                    {
                        "image": "172.28.0.16:5000/wamn/flow-http@sha256:c448986f93428fa0440501766049be41b864d90e3c38c3e2f419a688f17b10df",
                        "imagePullPolicy": "Always",
                        "localResources": {
                            "allowedIpNameLookups": [],
                            "config": {
                                "wamn.catalog": "default",
                                "wamn.environment": "dev",
                                "wamn.project": "receiving",
                                "wamn.schema": "receiving",
                                "wamn.tenant": "receiving-route-auth"
                            }
                        },
                        "name": "flow-http"
                    }
                ],
                "environment": "wamn-receiving-journey",
                "hostInterfaces": [
                    {
                        "config": {
                            "host": "receiving.localhost"
                        },
                        "interfaces": [
                            "incoming-handler"
                        ],
                        "namespace": "wasi",
                        "package": "http"
                    },
                    {
                        "interfaces": [
                            "routing"
                        ],
                        "namespace": "wamn",
                        "package": "flow-http-routing",
                        "version": "0.1.0"
                    },
                    {
                        "interfaces": [
                            "delivery"
                        ],
                        "namespace": "wamn",
                        "package": "router-delivery",
                        "version": "0.1.0"
                    }
                ],
                "hostSelector": {
                    "hostgroup": "default"
                },
                "kubernetes": {
                    "service": {
                        "name": "flow-http"
                    }
                }
            }
        }
    }
}
