                                            "currentReplicas": {
                                                "description": "CurrentReplicas is the number of workload instances currently running.\nExposed as the /scale subresource statusReplicasPath so HPA can read the\ncurrent replica count. Mirrors .status.replicas.current as a flat int.",
                                                "format": "int32",
