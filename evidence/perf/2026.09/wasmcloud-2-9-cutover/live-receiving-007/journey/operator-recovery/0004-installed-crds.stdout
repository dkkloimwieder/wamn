                                                                                    "type": "object"
                                                                                },
                                                                                "volumeMounts": {
                                                                                    "description": "VolumeMounts is a list of volume mounts that will be mounted into the workload component.\nThe volumes must be defined in the WorkloadSpec.Volumes field.",
                                                                                    "items": {
                                                                                        "description": "VolumeMount describes a mounting of a Volume within a component.",
                                                                                        "properties": {
                                                                                            "mountPath": {
                                                                                                "description": "MountPath is the path within the component where the volume should be mounted.",
                                                                                                "type": "string"
                                                                                            },
                                                                                            "name": {
                                                                                                "description": "Name must match the Name of a Volume defined in the WorkloadSpec.Volumes field.",
                                                                                                "type": "string"
                                                                                            },
                                                                                            "readOnly": {
                                                                                                "description": "ReadOnly indicates whether the volume should be mounted as read-only.",
                                                                                                "type": "boolean"
                                                                                            }
                                                                                        },
                                                                                        "required": [
                                                                                            "mountPath",
                                                                                            "name"
                                                                                        ],
                                                                                        "type": "object"
