                                                                                    "type": "array"
                                                                                }
                                                                            },
                                                                            "type": "object"
                                                                        },
                                                                        "maxConcurrency": {
                                                                            "description": "MaxConcurrency is how many calls one warm instance may serve at the same\ntime. Unset means one, which is what a component gets without asking.\nRaising it lets an instance overlap calls while it awaits I/O, and is\nonly safe for a guest that yields rather than blocks. Only meaningful\nalongside PoolSize.",
                                                                            "format": "int32",
                                                                            "minimum": 0,
                                                                            "type": "integer"
                                                                        },
                                                                        "maxInvocations": {
                                                                            "description": "MaxInvocations retires a warm instance once it has served this many\ncalls, and a fresh one takes its place. Unset means an instance serves\ncalls indefinitely. Only meaningful alongside PoolSize.",
                                                                            "format": "int32",
                                                                            "minimum": 0,
                                                                            "type": "integer"
                                                                        },
                                                                        "name": {
                                                                            "type": "string"
                                                                        },
                                                                        "poolSize": {
                                                                            "description": "PoolSize is how many instances of this component are kept warm between\ncalls. Unset means none are: every call gets a fresh instance, and the\ncomponent's state stays ephemeral.",
                                                                            "format": "int32",
                                                                            "minimum": 0,
                                                                            "type": "integer"
                                                                        },
                                                                        "reclaimMinInstances": {
                                                                            "description": "ReclaimMinInstances is how many warm instances an idle sweep never\nretires below. Unset lets a fully idle pool empty out, so the next call\nafter a quiet spell starts cold. Capped at PoolSize. This is a floor on\nreclaim, not a target to grow to: instances are still only built when a\ncall needs one. Only meaningful alongside ReclaimWindowSeconds.",
                                                                            "format": "int32",
                                                                            "minimum": 0,
                                                                            "type": "integer"
                                                                        },
                                                                        "reclaimWindowSeconds": {
                                                                            "description": "ReclaimWindowSeconds is how long the pool watches its own peak\nconcurrency before retiring the warm instances that peak did not need.\nA pool grows to PoolSize under load and, unset, stays there, so a\nspike's high-water mark outlives the spike. Set this and the pool\nsweeps every window, keeps the instances its measured peak actually\nneeded and drains the rest. Unset means warm instances are never\nreclaimed for idleness. Only meaningful alongside PoolSize.",
                                                                            "format": "int32",
                                                                            "minimum": 0,
                                                                            "type": "integer"
                                                                        }
                                                                    },
                                                                    "required": [
                                                                        "image",
                                                                        "name"
                                                                    ],
                                                                    "type": "object"
                                                                },
                                                                "type": "array"
                                                            },
                                                            "environment": {
                                                                "description": "Environment, if set, scopes scheduling to Hosts whose Environment\nmatches this value, regardless of the Workload's own namespace.\nThe value is matched against Host.Environment — typically a\nKubernetes namespace for in-cluster host pods, or any\noperator-defined identifier for out-of-cluster hosts (e.g. a\nregion or data center). Only honored when the operator is started\nwith allowSharedHosts=true, or when Environment equals the\nWorkload's namespace.",
                                                                "type": "string"
                                                            },
                                                            "hostId": {
                                                                "type": "string"
                                                            },
                                                            "hostInterfaces": {
                                                                "description": "HostInterfaces declares the host-provided interfaces this workload needs.\nTwo routing invariants are enforced at admission, complementing the\nhost-side checks:\n  1. No two entries may be exact duplicates (same namespace, package,\n     name, and version).\n  2. At most one entry of a given namespace:package may be unnamed — the\n     unnamed entry is the default route and cannot be shared. Declare\n     distinct `name`s to route multiple imports of the same package to\n     different backends. Semver-incompatible versions of the same package\n     may coexist (they are distinct interfaces).",
                                                                "items": {
                                                                    "properties": {
                                                                        "config": {
                                                                            "additionalProperties": {
                                                                                "type": "string"
                                                                            },
                                                                            "type": "object"
                                                                        },
                                                                        "configFrom": {
                                                                            "description": "ConfigFrom is a list of references to ConfigMaps that will be provided to the workload.\nThe keys and values of all referenced ConfigMaps will be merged. In case of key conflicts,\nthe last ConfigMap in the list wins.",
                                                                            "items": {
                                                                                "description": "LocalObjectReference contains enough information to let you locate the\nreferenced object inside the same namespace.",
                                                                                "properties": {
                                                                                    "name": {
                                                                                        "default": "",
                                                                                        "description": "Name of the referent.\nThis field is effectively required, but due to backwards compatibility is\nallowed to be empty. Instances of this type with an empty value here are\nalmost certainly wrong.\nMore info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names",
                                                                                        "type": "string"
                                                                                    }
                                                                                },
                                                                                "type": "object",
                                                                                "x-kubernetes-map-type": "atomic"
                                                                            },
                                                                            "type": "array"
                                                                        },
                                                                        "interfaces": {
                                                                            "items": {
                                                                                "type": "string"
                                                                            },
                                                                            "minItems": 1,
                                                                            "type": "array"
                                                                        },
                                                                        "name": {
                                                                            "description": "Name uniquely identifies this interface instance when multiple entries\nshare the same namespace+package. It is the `(implements \u003cname\u003e)` id the\nhost uses to route a component's named import to this interface's backend,\nso two imports of the same namespace:package can resolve to different\nbackends.\nRequired when multiple entries of the same namespace:package exist.",
                                                                            "maxLength": 64,
                                                                            "pattern": "^[a-z0-9][a-z0-9-]*$",
                                                                            "type": "string"
                                                                        },
                                                                        "namespace": {
                                                                            "maxLength": 128,
                                                                            "type": "string"
                                                                        },
                                                                        "package": {
                                                                            "maxLength": 128,
                                                                            "type": "string"
                                                                        },
                                                                        "secretFrom": {
                                                                            "description": "The keys and values of all referenced Secrets will be merged. In case of key conflicts,\nthe last Secret in the list wins.\nThe values of the Secrets will be base64-decoded, utf-8 decoded before being provided to the workload.",
                                                                            "items": {
                                                                                "description": "LocalObjectReference contains enough information to let you locate the\nreferenced object inside the same namespace.",
                                                                                "properties": {
                                                                                    "name": {
                                                                                        "default": "",
                                                                                        "description": "Name of the referent.\nThis field is effectively required, but due to backwards compatibility is\nallowed to be empty. Instances of this type with an empty value here are\nalmost certainly wrong.\nMore info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names",
                                                                                        "type": "string"
                                                                                    }
                                                                                },
                                                                                "type": "object",
                                                                                "x-kubernetes-map-type": "atomic"
                                                                            },
