":57,"highlight_start":1,"text":"    schemas: std::sync::RwLock<HashMap<String, String>>,"},{"highlight_end":79,"highlight_start":1,"text":"    /// component id → durable-queue lease owner (fqg.4). Absent (the default)"},{"highlight_end":76,"highlight_start":1,"text":"    /// leaves `app.runner` unset — so every non-claiming path (S2..S6, the"},{"highlight_end":65,"highlight_start":1,"text":"    /// gateway) is byte-unchanged. When set, the plugin injects"},{"highlight_end":79,"highlight_start":1,"text":"    /// `SET LOCAL app.runner` so a runner replica reads its owner identity to"},{"highlight_end":38,"highlight_start":1,"text":"    /// claim/renew queue rows under."},{"highlight_end":57,"highlight_start":1,"text":"    runners: std::sync::RwLock<HashMap<String, String>>,"},{"highlight_end":77,"highlight_start":1,"text":"    /// component id → the one host-owned workload authority admitted on the"},{"highlight_end":74,"highlight_start":1,"text":"    /// guest-visible WIT surface. Absence preserves ordinary `GuestSql`."},{"highlight_end":77,"highlight_start":1,"text":"    /// Values enter only from the workload binding config; the guest cannot"},{"highlight_end":45,"highlight_start":1,"text":"    /// select or mutate this discriminator."},{"highlight_end":78,"highlight_start":1,"text":"    workload_authorities: std::sync::RwLock<HashMap<String, AuthorityClass>>,"},{"highlight_end":78,"highlight_start":1,"text":"    /// component id → the caller's `app.role` claim (a `roles.name`). Absent"},{"highlight_end":74,"highlight_start":1,"text":"    /// (the default) binds the empty role, which is the deny floor every"},{"highlight_end":79,"highlight_start":1,"text":"    /// compiled role gate coalesces to. When set, a per-role RLS policy using"},{"highlight_end":78,"highlight_start":1,"text":"    /// the claim contract documented by `deploy/sql/app-schema.sql` gates on"},{"highlight_end":46,"highlight_start":1,"text":"    /// the caller's role instead of denying."},{"highlight_end":55,"highlight_start":1,"text":"    roles: std::sync::RwLock<HashMap<String, String>>,"},{"highlight_end":77,"highlight_start":1,"text":"    /// component id → the caller's `app.user_id` claim (a `users.id` uuid)."},{"highlight_end":72,"highlight_start":1,"text":"    /// Absent (the default) binds the empty string, which the compiled"},{"highlight_end":79,"highlight_start":1,"text":"    /// ownership predicate `NULLIF(…, '')::uuid` turns into NULL → deny. When"},{"highlight_end":73,"highlight_start":1,"text":"    /// set, a per-user RLS policy compares against the caller's own id."},{"highlight_end":55,"highlight_start":1,"text":"    users: std::sync::RwLock<HashMap<String, String>>,"},{"highlight_end":87,"highlight_start":1,"text":"    /// component id → the `(effective release id, manifest digest)` this pod carries."},{"highlight_end":78,"highlight_start":1,"text":"    /// Absent (the default) ⇒ the production claim records nothing, so every"},{"highlight_end":80,"highlight_start":1,"text":"    /// path that never mounted a release identity is byte-unchanged. When set,"},{"highlight_end":70,"highlight_start":1,"text":"    /// the claim writes the pair onto the run it leases, write-once."},{"highlight_end":77,"highlight_start":1,"text":"    release_identities: std::sync::RwLock<HashMap<String, ReleaseIdentity>>,"},{"highlight_end":79,"highlight_start":1,"text":"    /// component id → the causation context {run, root, depth} of the run the"},{"highlight_end":66,"highlight_start":1,"text":"    /// caller is currently driving (l5i9.12.2). Declared through"},{"highlight_end":78,"highlight_start":1,"text":"    /// [`set_current_run`](WamnPostgres::set_current_run), cleared (removed)"},{"highlight_end":80,"highlight_start":1,"text":"    /// between runs. Absent (the default) ⇒ no causation is stamped — so every"},{"highlight_end":77,"highlight_start":1,"text":"    /// non-run path (S2..S6, the gateway, benches without a declaration) is"},{"highlight_end":66,"highlight_start":1,"text":"    /// byte-unchanged. When set, [`begin_with_claims`] appends a"},{"highlight_end":80,"highlight_start":1,"text":"    /// TRANSACTIONAL `wamn.causation` logical message to every transaction the"},{"highlight_end":74,"highlight_start":1,"text":"    /// plugin opens for that component, which the CDC reader (l5i9.12.1)"},{"highlight_end":44,"highlight_start":1,"text":"    /// stitches onto the txn's row events."},{"highlight_end":64,"highlight_start":1,"text":"    current_run: std::sync::RwLock<HashMap<String, Causation>>,"},{"highlight_end":77,"highlight_start":1,"text":"    /// Verified SQL facts bound by operation plus the one invocation-active"},{"highlight_end":81,"highlight_start":1,"text":"    /// scope. The active scope is host-selected; a guest can only name a digest"},{"highlight_end":19,"highlight_start":1,"text":"    /// inside it."},{"highlight_end":69,"highlight_start":1,"text":"    pub(super) statement_scopes: std::sync::RwLock<StatementScopes>,"},{"highlight_end":78,"highlight_start":1,"text":"    /// Connections destroyed instead of repooled (chaos-gate observability)."},{"highlight_end":42,"highlight_start":1,"text":"    pub(super) destroyed: Arc<AtomicU64>,"},{"highlight_end":72,"highlight_start":1,"text":"    /// How many times each half of the un-fused workload bind has run."},{"highlight_end":51,"highlight_start":1,"text":"    pub(super) bind_counters: super::BindCounters,"},{"highlight_end":2,"highlight_start":1,"text":"}"}]}],"code":{"code":"missing_debug_implementations","explanation":null}}}
