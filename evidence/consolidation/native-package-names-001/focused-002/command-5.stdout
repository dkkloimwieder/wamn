Stand up the disposable environment the wamn dev loop runs against

Usage: wamn-dev-env [OPTIONS] --system-database-url <SYSTEM_DATABASE_URL> --root <ROOT> --scenario-worker-binary <SCENARIO_WORKER_BINARY> --nats-url <NATS_URL> --event-nats-url <EVENT_NATS_URL> --event-nats-username <EVENT_NATS_USERNAME> --event-nats-password-file <EVENT_NATS_PASSWORD_FILE> --event-provisioning-username <EVENT_PROVISIONING_USERNAME> --event-provisioning-password-file <EVENT_PROVISIONING_PASSWORD_FILE> --stream-replicas <STREAM_REPLICAS> --dup-window-secs <DUP_WINDOW_SECS> --tempo-query-url <TEMPO_QUERY_URL> --otel-exporter-otlp-endpoint <OTEL_EXPORTER_OTLP_ENDPOINT> --component-artifact-base <COMPONENT_ARTIFACT_BASE> --release-artifact-base <RELEASE_ARTIFACT_BASE> --registry-auth-file <REGISTRY_AUTH_FILE> --route-host <ROUTE_HOST> --flow-http-workload-image <FLOW_HTTP_WORKLOAD_IMAGE> --host-binary <HOST_BINARY> --package <PACKAGES>

Options:
      --system-database-url <SYSTEM_DATABASE_URL>
          Admin URL of the disposable PostgreSQL 18 cluster
          
          [env: WAMN_DEV_ENV_SYSTEM_DATABASE_URL=]

      --root <ROOT>
          Directory the emitted Secrets, SQL and `dev.json` are written to
          
          [env: WAMN_DEV_ENV_ROOT=]

      --scenario-worker-binary <SCENARIO_WORKER_BINARY>
          The built `wamn-scenario-worker` this command spawns as the Gate
          
          [env: WAMN_DEV_ENV_SCENARIO_WORKER_BIN=]

      --gate-bind <GATE_BIND>
          Address the authoring Gate listens on for the whole session.
          
          A nameable port, not an ephemeral one: the configuration written here outlives the process that writes it.
          
          [default: 127.0.0.1:8088]

      --nats-url <NATS_URL>
          [env: WAMN_DEV_ENV_NATS_URL=]

      --event-nats-url <EVENT_NATS_URL>
          Event broker endpoint, separate from the scheduler endpoint
          
          [env: WAMN_EVT_NATS_URL=]

      --event-nats-username <EVENT_NATS_USERNAME>
          Runtime credential for publication and the same environment's tap view
          
          [env: WAMN_EVT_NATS_USERNAME=]

      --event-nats-password-file <EVENT_NATS_PASSWORD_FILE>
          [env: WAMN_EVT_NATS_PASSWORD_FILE=]

      --event-provisioning-username <EVENT_PROVISIONING_USERNAME>
          Credential that creates the declared event streams
          
          [env: WAMN_DEV_ENV_EVENT_PROVISIONING_USERNAME=]

      --event-provisioning-password-file <EVENT_PROVISIONING_PASSWORD_FILE>
          [env: WAMN_DEV_ENV_EVENT_PROVISIONING_PASSWORD_FILE=]

      --stream-replicas <STREAM_REPLICAS>
          Declared NATS stream copies, separate from workload instances
          
          [env: WAMN_EVT_STREAM_REPLICAS=]

      --dup-window-secs <DUP_WINDOW_SECS>
          [env: WAMN_EVT_DUP_WINDOW_SECS=]

      --tempo-query-url <TEMPO_QUERY_URL>
          [env: WAMN_DEV_ENV_TEMPO_QUERY_URL=]

      --otel-exporter-otlp-endpoint <OTEL_EXPORTER_OTLP_ENDPOINT>
          [env: WAMN_DEV_ENV_OTEL_EXPORTER_OTLP_ENDPOINT=]

      --component-artifact-base <COMPONENT_ARTIFACT_BASE>
          [env: WAMN_DEV_ENV_COMPONENT_ARTIFACT_BASE=]

      --release-artifact-base <RELEASE_ARTIFACT_BASE>
          [env: WAMN_DEV_ENV_RELEASE_ARTIFACT_BASE=]

      --registry-auth-file <REGISTRY_AUTH_FILE>
          [env: WAMN_DEV_ENV_REGISTRY_AUTH_FILE=]

      --route-host <ROUTE_HOST>
          [env: WAMN_DEV_ENV_ROUTE_HOST=]

      --flow-http-workload-image <FLOW_HTTP_WORKLOAD_IMAGE>
          [env: WAMN_DEV_ENV_FLOW_HTTP_WORKLOAD_IMAGE=]

      --host-binary <HOST_BINARY>
          The built `wamn-host` the loop supervises
          
          [env: WAMN_DEV_ENV_HOST_BIN=]

      --package <PACKAGES>
          A package source root the loop owns. Repeat for more than one

      --overlay-root <OVERLAY_ROOT>
          Overlay package root, echoed into the printed `wamn dev` command

  -h, --help
          Print help (see a summary with '-h')
