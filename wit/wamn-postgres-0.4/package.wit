package wamn:postgres@0.4.0;

/// SQL values and errors shared by both SQL interfaces.
interface types {
  variant sql-value {
    null,
    boolean(bool),
    int32(s32),
    int64(s64),
    float64(f64),
    text(string),
    bytes(list<u8>),
    /// Canonical decimal string, e.g. "12.3400". Maps to pg numeric.
    numeric(string),
    /// RFC 3339 with offset. Maps to pg timestamptz.
    timestamptz(string),
    /// JSON document string. Maps to pg jsonb.
    json(string),
    /// Canonical UUID string.
    uuid(string),
  }

  type column-name = string;
  type row = list<sql-value>;

  variant pg-error {
    /// 40001 / 40P01: safe to retry the whole transaction.
    serialization-failure,
    /// Pool exhausted or backend unreachable (transient).
    connection-unavailable,
    /// Host-enforced statement timeout exceeded.
    statement-timeout,
    /// 23505 with constraint name.
    unique-violation(string),
    /// 23503 with constraint name.
    foreign-key-violation(string),
    /// 23514 with constraint name.
    check-violation(string),
    /// 23P01 with constraint name.
    exclusion-violation(string),
    /// RLS or privilege denial. Deliberately carries no detail about
    /// which policy denied (no cross-project reconnaissance).
    permission-denied,
    /// Anything else: sqlstate + message.
    query-error(tuple<string, string>),
  }
}

/// Dynamic reads on the SELECT-only login in a host read transaction.
interface client {
  use types.{sql-value, column-name, row, pg-error};

  /// Column names arrive first. Consume the rows, then await completion.
  /// Dropping the rows before completion aborts the read transaction.
  query: async func(sql: string, params: list<sql-value>) -> result<tuple<list<column-name>, stream<row>, future<result<_, pg-error>>>, pg-error>;
}

/// SQL in the host transaction shared by an operation and its composed members.
interface statements {
  use types.{sql-value, column-name, row, pg-error};

  // Numbering is removed by the numbering lane.
  variant statement-error {
    postgres(pg-error),
  }

  /// A borrowed handle. Only the host can finish the transaction.
  resource transaction {
    /// Column names, streamed rows, and the closing result of one query.
    query: async func(sql: string, params: list<sql-value>) -> result<tuple<list<column-name>, stream<row>, future<result<_, pg-error>>>, pg-error>;
    /// Execute SQL without parameters in the same host transaction.
    query-batch: async func(sql: string) -> result<_, pg-error>;
  }

  /// Borrow the current operation transaction. Dropping the handle leaves it open.
  operation-transaction: async func() -> result<transaction, pg-error>;

  /// Render the next number of sequence `name` of the composing application,
  /// and advance its counters in the operation transaction.
  ///
  /// `keys` maps each value that the sequence's pattern names (`per=`,
  /// `reset=` and `{field:}`) to its text, or to none for a null. A bare
  /// `{seq}` or `{date:}` pattern takes no keys. The renderer reads only the
  /// keys that the pattern names; a key given twice is refused. The keys are
  /// not a record: any command can call this, with values of its choice.
  /// The application comes from host state: the operation transaction holds
  /// the application it was begun for. It is never an argument and never
  /// the `app.application` identity, which guest SQL can rewrite. Outside an
  /// open operation transaction the host refuses. Added to 0.4.0 in place,
  /// with no version bump (docs/plan/platform-config.md, "Issues for C2").
  ///
  /// Refusals: `postgres(permission-denied)` outside an open operation
  /// transaction. `postgres(query-error)` with SQLSTATE `42704` for a
  /// sequence that the application does not own, `22004` for a null key,
  /// and `22023` for an empty key, a missing key, a key given twice, a
  /// stored pattern that does not parse, or a `timezone` setting that is
  /// not a time zone. A refused call advances no counter.
  next-number: async func(name: string, keys: list<tuple<string, option<string>>>) -> result<string, statement-error>;

  /// Render the current number of sequence `name` of the composing
  /// application: the last number issued for the counters `keys` names,
  /// with no lock and no advance. Never for assignment.
  ///
  /// `keys`, the application and the refusals are those of `next-number`.
  /// When no number was issued yet for a counter of the pattern, the host
  /// answers `postgres(query-error)` with SQLSTATE `P0002` (`no_data_found`).
  peek-number: async func(name: string, keys: list<tuple<string, option<string>>>) -> result<string, statement-error>;
}
