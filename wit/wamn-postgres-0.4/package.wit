package wamn:postgres@0.4.0;

/// SQL values and errors shared by both SQL interfaces.
interface types {
  variant sql-value {
    null,
    boolean(bool),
    int32(s32),
    int64(s64),
    float64(f64),
    text(string),
    bytes(list<u8>),
    /// Canonical decimal string, e.g. "12.3400". Maps to pg numeric.
    numeric(string),
    /// RFC 3339 with offset. Maps to pg timestamptz.
    timestamptz(string),
    /// JSON document string. Maps to pg jsonb.
    json(string),
    /// Canonical UUID string.
    uuid(string),
  }

  type column-name = string;
  type row = list<sql-value>;

  variant pg-error {
    /// 40001 / 40P01: safe to retry the whole transaction.
    serialization-failure,
    /// Pool exhausted or backend unreachable (transient).
    connection-unavailable,
    /// Host-enforced statement timeout exceeded.
    statement-timeout,
    /// 23505 with constraint name.
    unique-violation(string),
    /// 23503 with constraint name.
    foreign-key-violation(string),
    /// 23514 with constraint name.
    check-violation(string),
    /// 23P01 with constraint name.
    exclusion-violation(string),
    /// RLS or privilege denial. Deliberately carries no detail about
    /// which policy denied (no cross-project reconnaissance).
    permission-denied,
    /// Anything else: sqlstate + message.
    query-error(tuple<string, string>),
  }
}

/// Dynamic reads on the SELECT-only login in a host read transaction.
interface client {
  use types.{sql-value, column-name, row, pg-error};

  /// Column names arrive first. Consume the rows, then await completion.
  /// Dropping the rows before completion aborts the read transaction.
  query: async func(sql: string, params: list<sql-value>) -> result<tuple<list<column-name>, stream<row>, future<result<_, pg-error>>>, pg-error>;
}

/// SQL in the host transaction shared by an operation and its composed members.
interface statements {
  use types.{sql-value, column-name, row, pg-error};

  /// A borrowed handle. Only the host can finish the transaction.
  resource transaction {
    /// Column names, streamed rows, and the closing result of one query.
    query: async func(sql: string, params: list<sql-value>) -> result<tuple<list<column-name>, stream<row>, future<result<_, pg-error>>>, pg-error>;
    /// Execute SQL without parameters in the same host transaction.
    query-batch: async func(sql: string) -> result<_, pg-error>;
  }

  /// Borrow the current operation transaction. Dropping the handle leaves it open.
  operation-transaction: async func() -> result<transaction, pg-error>;
}
