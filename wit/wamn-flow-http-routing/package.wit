package wamn:flow-http-routing@0.1.0;

/// Authoritative HTTP definition lookup and selected-policy authentication.
///
/// The provider projects routes from the process's loaded serving manifest.
interface routing {
  record header {
    name: string,
    value: string,
  }

  record auth-rejection {
    status: u16,
    /// An empty code requests an empty HTTP response body.
    code: string,
  }

  /// Opaque host-owned handle for one authenticated originating caller.
  resource authenticated-caller {}

  /// Authenticate the credential accepted by the selected route.
  authenticate: async func(attachment-id: string, accepted: string, headers: list<header>, body: list<u8>) -> result<option<authenticated-caller>, auth-rejection>;
}
