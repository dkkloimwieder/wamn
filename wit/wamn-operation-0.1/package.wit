package wamn:operation@0.1.0;

/// Entry-owned operation boundary. Package members can import `statements`
/// without receiving this interface.
interface operation {
  use wamn:postgres/types@0.4.0.{pg-error};
  use wamn:node/types@0.1.0.{node-context, emission, node-error};
  use wamn:flow-http-routing/routing@0.1.0.{authenticated-caller};

  /// The existing operation id text, validated against the loaded release.
  type sealed-operation-id = string;

  variant refusal {
    conflict,
    unknown-operation,
    grant-denied,
    invalid-caller,
    not-begun,
    already-begun,
    postgres(pg-error),
    reads-claim-nothing,
    in-progress,
    outcome-unknown,
  }

  variant begun {
    /// The host-minted delivery id, which the application only reads.
    new(string),
    /// The stored result text. The entry returns it and runs no work.
    finished(string),
  }

  /// Authorize a read and bind its statement authority without a connection.
  authorize: async func(caller: option<borrow<authenticated-caller>>, operation: sealed-operation-id) -> result<_, refusal>;

  /// Call the typed application export under the current invocation authority.
  invoke: async func(operation: sealed-operation-id, context: node-context, input: string) -> result<emission, node-error>;

  /// Sign results after commit or replay, using the retained invocation authority.
  sign-result: async func(payload: string) -> result<string, node-error>;

  /// End an authorized read and record its delivery outcome without SQL.
  finish-read: async func() -> result<_, refusal>;

  /// Make sure of the host-issued caller and its grant, mint the delivery id, and
  /// claim the key. SQL claims share the work transaction. Calls without SQL
  /// commit the claim before external effects. The host stores the request
  /// hash unchanged. Reads refuse with reads-claim-nothing.
  /// Only one operation can be open per Store.
  /// A begin while one is open returns already-begun and leaves it open.
  /// Commit or rollback (ok or refusal) ends execution authority.
  /// The invocation retains signing authority until the next begin or Store drop.
  /// Finished leaves no operation open. Another begin is then allowed,
  /// with its own transaction and delivery id.
  /// Dropping the Store rolls back its open operation.
  begin-operation: async func(caller: option<borrow<authenticated-caller>>, operation: sealed-operation-id, idempotency-key: string, request-hash: list<u8>) -> result<begun, refusal>;

  /// Store the application's result JSON as text without inspecting it, emit
  /// the causation message, and commit. Without a new begin, this refuses.
  commit: async func(%result: string) -> result<_, refusal>;

  /// Roll back the open transaction and release its claim without a result.
  /// The key is unclaimed again. No open operation returns not-begun.
  rollback: async func() -> result<_, refusal>;

  /// Return pg_current_wal_lsn()::text on the open operation's connection.
  /// Without an open operation, this returns not-begun.
  wal-position: async func() -> result<string, refusal>;
}
