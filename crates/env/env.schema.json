{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnvFile",
  "type": "object",
  "required": [
    "database",
    "env",
    "org",
    "projects",
    "revocation_seconds",
    "target"
  ],
  "properties": {
    "connections": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Integration"
      }
    },
    "database": {
      "$ref": "#/definitions/Database"
    },
    "drain_bound_seconds": {
      "default": 300,
      "type": "integer",
      "format": "int32",
      "maximum": 2147483647.0,
      "minimum": 1.0
    },
    "env": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Project"
      },
      "minItems": 1
    },
    "readiness_budget_seconds": {
      "default": 600,
      "type": "integer",
      "format": "int32",
      "maximum": 2147483647.0,
      "minimum": 1.0
    },
    "revocation_seconds": {
      "type": "integer",
      "format": "uint32",
      "maximum": 3600.0,
      "minimum": 0.0
    },
    "target": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AppSelection": {
      "description": "An application's deployment selection and declared membership.",
      "type": "object",
      "properties": {
        "client": {
          "anyOf": [
            {
              "$ref": "#/definitions/Client"
            },
            {
              "type": "null"
            }
          ]
        },
        "connections": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ConnectionReference"
          }
        }
      },
      "additionalProperties": false
    },
    "Backup": {
      "description": "Base backup schedule and recovery window.",
      "type": "object",
      "required": [
        "cadence",
        "retention"
      ],
      "properties": {
        "cadence": {
          "type": "string",
          "pattern": "\\S"
        },
        "retention": {
          "type": "string",
          "pattern": "^[1-9][0-9]*[dwm]$"
        }
      },
      "additionalProperties": false
    },
    "Client": {
      "description": "A package and its immutable web artifact.",
      "type": "object",
      "required": [
        "package",
        "web"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "web": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "ConnectionReference": {
      "description": "A bare connection name. The version is pinned once for the environment.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "Database": {
      "description": "Database sizing for every project in this environment.",
      "type": "object",
      "required": [
        "cpu",
        "instances",
        "memory",
        "storage"
      ],
      "properties": {
        "backup": {
          "anyOf": [
            {
              "$ref": "#/definitions/Backup"
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu": {
          "type": "string",
          "pattern": "\\S"
        },
        "instances": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1.0
        },
        "memory": {
          "type": "string",
          "pattern": "\\S"
        },
        "storage": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "Integration": {
      "description": "The environment pin for a published integration type version.",
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "format": "int32",
          "minimum": 1.0
        }
      },
      "additionalProperties": false
    },
    "Project": {
      "type": "object",
      "required": [
        "apps",
        "name"
      ],
      "properties": {
        "apps": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/AppSelection"
          }
        },
        "name": {
          "type": "string"
        },
        "schema": {
          "default": {},
          "allOf": [
            {
              "$ref": "#/definitions/Schema"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Schema": {
      "description": "Schema behavior; an omitted mode follows the stored disposable designation.",
      "type": "object",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "$ref": "#/definitions/SchemaMode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "SchemaMode": {
      "description": "The schema lifecycle mode.",
      "type": "string",
      "enum": [
        "reset",
        "migrate"
      ]
    }
  }
}
