package wamn:engine@0.1.0;

/// Host-side bindgen world for the two imports of the http-route ingress
/// guest. The host IMPLEMENTS `wamn:flow-http-routing/routing`, serving routes
/// out of the loaded release, and `wamn:router-delivery/delivery`, which hands
/// each request to the host's delivery. See src/flow_http_routing.rs and
/// src/router_delivery.rs.
world route-plugins {
  import wamn:flow-http-routing/routing@0.1.0;
  import wamn:router-delivery/delivery@0.1.0;
}
