package wamn:host@0.1.0;

/// Host-side bindgen world for the wamn:postgres plugin (S1: stub; real
/// implementation lands with S2). Imports = interfaces the host implements.
world postgres-plugin {
  import wamn:postgres/types@0.1.0;
  import wamn:postgres/client@0.1.0;
  import wamn:postgres/statements@0.1.0;
}

/// Host-side bindgen world for the trusted typed HTTP connection adapter
/// (wamn-ko5r.8, landed): the host IMPLEMENTS `wamn:connection/http` with
/// host-derived authorization, credentials installed only after authorization,
/// direct-only transport and write-ahead effect intent. See
/// plugins/connection_http.rs.
world connection-http-plugin {
  import wamn:connection/http@0.1.0;
}

/// Host-side bindgen world for the trusted one-frame HTTP effect surface.
world runner-http-effect-plugin {
  import wamn:runner/http-effect@0.1.0;
}

/// Host-owned registration provisioning and the existing scheduler hint.
/// Native wasmcloud:nats owns materializer attachment, delivery and settlement.
world jetstream-plugin {
  import wamn:jetstream/types@0.1.0;
  import wamn:jetstream/registration@0.1.0;
  import wamn:jetstream/doorbell@0.1.0;
}

/// Host-side bindgen world for the S5 `wamn:logging` plugin: the host
/// IMPLEMENTS `wasi:logging/logging` (enrich + non-blocking enqueue + drop
/// counter), routing guest logs to an OTLP LoggerProvider the plugin owns. See
/// docs/archive/p0-exit-criteria.md S5.
world logging-plugin {
  import wasi:logging/logging@0.1.0-draft;
}

/// Host-side bindgen world for authoritative flow-http route supply
/// (wamn-0h0g.15.96): the host IMPLEMENTS `routes`, `authenticate` and
/// `caller-connected`, serving `route-definition` out of the mounted serving
/// manifest's attachment projection — reader 2 of the loaded release manifest. No
/// route read reaches the project database. See plugins/flow_http_routing.rs.
world flow-http-routing-plugin {
  import wamn:flow-http-routing/routing@0.1.0;
}

/// Host-side bindgen world for the WAMN blobstore plugin (§2b): the host
/// IMPLEMENTS `wasmcloud:blobstore@0.1.0` over `object_store`, with
/// binding-scoped credentials and bucket/prefix confinement. Upstream's
/// `wasi_blobstore` providers are prior-art source only and are never
/// registered — WAMN is the single runtime owner of this interface.
world blobstore-plugin {
  import wasmcloud:blobstore/types@0.1.0;
  import wasmcloud:blobstore/container@0.1.0;
  import wasmcloud:blobstore/blobstore@0.1.0;
}
