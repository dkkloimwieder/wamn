package wamn:host@0.1.0;

/// Host-side bindgen world for the wamn:postgres plugin. Imports = interfaces
/// the host implements.
world postgres-plugin {
  import wamn:postgres/types@0.4.0;
  import wamn:postgres/client@0.4.0;
  import wamn:postgres/statements@0.4.0;
  import wamn:operation/operation@0.1.0;
}

/// Host-side bindgen world for the trusted typed HTTP connection adapter
/// (wamn-ko5r.8, landed): the host IMPLEMENTS `wamn:connection/http` with
/// host-derived authorization, credentials installed only after authorization,
/// direct-only transport and write-ahead effect intent. See
/// plugins/connection_http.rs.
world connection-http-plugin {
  import wamn:connection/http@0.1.0;
}

/// Host-side bindgen world for the trusted one-frame HTTP effect surface.

/// Host-owned registration provisioning.

/// Host-side bindgen world for the WAMN blobstore plugin (§2b): the host
/// IMPLEMENTS `wasmcloud:blobstore@0.1.0` over `object_store`, with
/// binding-targeted credentials and bucket/prefix confinement. Upstream's
/// `wasi_blobstore` providers are prior-art source only and are never
/// registered — WAMN is the single runtime owner of this interface.
world blobstore-plugin {
  import wasmcloud:blobstore/types@0.1.0;
  import wasmcloud:blobstore/container@0.1.0;
  import wasmcloud:blobstore/blobstore@0.1.0;
}
