package wamn:jetstream@0.1.0;

/// Host-owned registration provisioning.
/// Native wasmcloud:nats owns materializer delivery and settlement.
interface types {
  variant js-error {
    connection-unavailable,
    not-found(string),
    other(string),
  }
}

interface registration {
  use types.{js-error};

  record consumer-config {
    stream-name: string,
    durable: string,
    filter-subject: string,
    ack-wait-ms: u64,
    max-deliver: u32,
  }

  /// Create the admitted registration consumer or refuse configuration drift.
  prepare: async func(package-id: string, registration-id: string, config: consumer-config) -> result<_, js-error>;

  /// Read enabled event workflow rows of the host's environment applications.
  triggers: async func() -> result<string, js-error>;

  /// Admit all matching workflows for one message in one host transaction.
  admit: async func(source-package: string, entity: string, envelope: string, sequence: u64, source-event-id: string) -> result<_, js-error>;
}
