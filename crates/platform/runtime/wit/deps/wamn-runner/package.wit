package wamn:runner@0.1.0;

interface egress {
  /// Supply the hosts the run the runner is about to dispatch may reach
  /// over outbound HTTP (resolved from its active connection, fqg.11).
  /// Replaces any prior declaration for this component. Enforcement is
  /// host-side on the outgoing-handler path: a request must pass BOTH the
  /// runner's host-level allowlist AND this resolved set (intersection);
  /// declared-empty — like never-declared — is DENY-ALL, and an entry the
  /// host cannot parse is dropped (fail-closed), never widened.
  set-allowed-hosts: func(hosts: list<string>);
}

interface causation {
  /// The causation context of a run — {run, root, depth} (wamn-l5i9.12). The
  /// runner declares the run it is about to drive so the host's
  /// `wamn:postgres` plugin stamps a TRANSACTIONAL `wamn.causation` logical
  /// message onto every run-owned transaction it opens; the CDC reader
  /// (l5i9.12.1) stitches that message onto the txn's row events. `root` is the
  /// run at the head of the causation chain and `depth` its distance from the
  /// root; a root run is its own root at depth 0. Event-triggered runs
  /// (materializer, l5i9.17) carry a real root/depth — the shape is ready for
  /// them with no further change.
  record run-context {
    run: string,
    root: string,
    depth: u32,
  }

  /// Declare (`some`) or clear (`none`) the run context the runner is
  /// driving. Replaces any prior declaration for this component. While set, the
  /// host stamps causation onto every transaction the plugin opens for this
  /// component; cleared, no causation is stamped. Trusted, compiled-in-only:
  /// a guest CANNOT set its own causation through the frozen `wamn:postgres`
  /// surface (a raw-SQL `wamn.*` emit is rejected there), so a stamped
  /// `wamn.causation` message is unforgeable.
  set-run-context: func(ctx: option<run-context>);
}
/// Trusted one-frame HTTP effect surface. Linked only into the digest-pinned
/// runner.
interface http-effect {
  record invocation-context {
    version: string,
    run-id: string,
    root-plan-hash: string,
    current-plan-hash: string,
    frame-id: u64,
    local-node-id: string,
    occurrence: u32,
    source-artifact-hash: string,
    requirement-name: string,
  }

  record header {
    name: string,
    value: list<u8>,
  }

  record relative-request {
    method: string,
    path-and-query: string,
    headers: list<header>,
    body: option<list<u8>>,
  }

  record response {
    status: u16,
    headers: list<header>,
    body: list<u8>,
  }

  variant effect-error {
    invalid-context,
    undeclared-requirement,
    node-not-permitted,
    unbound,
    inactive-generation,
    incompatible,
    authority-denied,
    credential-unavailable,
    timeout,
    transport(string),
  }

  send: func(
    context: invocation-context,
    request: relative-request,
  ) -> result<response, effect-error>;
}
