package wamn:flow-invocation@0.1.0;

interface invocation {
  type json = string;
  type principal-ref = string;

  record trace-context {
    traceparent: string,
    tracestate: option<string>,
  }

  record invoke-request {
    attachment-id: string,
    expected-catalog-version: u64,
    expected-definition-hash: string,
    client-request-fingerprint: string,
    payload: json,
    idempotency-key: option<string>,
    principal: principal-ref,
    deadline-override: option<u64>,
    trace: option<trace-context>,
  }

  record admitted { run-id: string }
  record rejection { status: u16, code: string }
  variant begin-result {
    admitted(admitted),
    rejected(rejection),
  }

  record response {
    run-id: string,
    body: json,
    status-hint: option<u16>,
  }

  record flow-error {
    code: string,
    message: option<string>,
    run-id: string,
    flow-id: string,
    flow-version: u32,
  }

  record failure { status: u16, error: flow-error }
  variant invoke-result {
    responded(response),
    failed(failure),
  }

  begin: func(req: invoke-request) -> begin-result;
  wait: func(run-id: string, timeout-ms: u32) -> option<invoke-result>;
}
