package wamn:runner@0.1.0;

/// Trusted one-frame HTTP effect surface. Linked only into the digest-pinned
/// runner.
interface http-effect {
  record invocation-context {
    version: string,
    run-id: string,
    root-plan-hash: string,
    current-plan-hash: string,
    frame-id: u64,
    local-node-id: string,
    occurrence: u32,
    source-artifact-hash: string,
    requirement-name: string,
  }

  record header {
    name: string,
    value: list<u8>,
  }

  record relative-request {
    method: string,
    path-and-query: string,
    headers: list<header>,
    body: option<list<u8>>,
  }

  record response {
    status: u16,
    headers: list<header>,
    body: list<u8>,
  }

  variant effect-error {
    invalid-context,
    undeclared-requirement,
    node-not-permitted,
    unbound,
    inactive-generation,
    incompatible,
    authority-denied,
    credential-unavailable,
    timeout,
    transport(string),
  }

  send: func(
    context: invocation-context,
    request: relative-request,
  ) -> result<response, effect-error>;
}
