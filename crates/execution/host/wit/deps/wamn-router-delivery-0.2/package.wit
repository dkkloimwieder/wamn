package wamn:router-delivery@0.2.0;

/// 0.2.0 is 0.1.0 with one added call, `deliver-stream`, which answers a
/// query read as the rows arrive (owner ruling on wamn-utci, 2026-09-26).
/// 0.1.0 is retired (wamn-lt7y): this is the one version in the tree, and it
/// declares every 0.1.0 type itself.

/// Host-owned delivery into the one production router driver.
interface delivery {
  use wamn:flow-http-routing/routing@0.1.0.{authenticated-caller};

  /// The trusted release projection the host must resolve by identifier.
  variant source {
    attachment(string),
    registration(string),
  }

  /// W3C trace context propagated into component invocations.
  record trace-context {
    traceparent: string,
    tracestate: option<string>,
  }

  /// Parent lineage supplied only by the trusted registration ingress. The
  /// host derives the current run from delivery-id and increments depth.
  record parent-causation {
    root: string,
    depth: u32,
  }

  /// One delivery. Wiring coordinates are deliberately absent: the host
  /// re-derives them from the loaded release and `source`.
  record delivery-request {
    source: source,
    delivery-id: string,
    payload: string,
    caller: option<authenticated-caller>,
    trace: option<trace-context>,
    parent-causation: option<parent-causation>,
    /// The If-None-Match value of a read. The host compares it with the
    /// read's ETag and answers not-modified on a match.
    if-none-match: option<string>,
  }

  /// The router's exhaustive terminal failure classes.
  enum failure-kind {
    terminal,
    retry-exhausted,
    invalid-input,
    hop-limit,
    unreleased-caller,
    missing-dedup-id,
    respond-without-caller,
    second-verdict,
  }

  /// Caller-facing failure truth. Retired node coordinates do not cross this
  /// boundary.
  record delivery-failure {
    kind: failure-kind,
    code: option<string>,
    message: string,
  }

  /// An Emit already stored (or deduped) by the host-owned JetStream
  /// publisher. Receiving this outcome is therefore permission to ACK a
  /// registration source message.
  record emission {
    event: string,
    dedup-id: string,
  }

  /// The router's terminal disposition, preserved without string matching.
  variant delivery-outcome {
    respond(string),
    emit(emission),
    discard,
    failed(delivery-failure),
    partially-completed(partial-completion),
    cancelled,
    /// The read's ETag matched If-None-Match. The response has no body.
    not-modified,
  }

  /// One exact registered operation the originating caller cannot invoke.
  record permission-denial {
    operation: string,
  }

  /// Failures owned by the bridge rather than by the routed wiring.
  variant delivery-error {
    source-not-found,
    invalid-request,
    invalid-payload,
    execution-failed,
    permission-denied(permission-denial),
    /// A session caller reached an operation that requires a fresh credential.
    fresh-credential-required(permission-denial),
  }

  /// An existing failure without a new failure taxonomy.
  variant failed-outcome {
    failed(delivery-failure),
    error(delivery-error),
    cancelled,
  }

  /// The same six outcomes as the platform effect observation contract.
  enum effect-outcome {
    refused-before-dispatch,
    responded,
    timeout,
    cancelled,
    effect-uncertain,
    response-lost,
  }

  /// Only the selected declared committed result and the later failure.
  record partial-completion {
    committed-result: string,
    failed-outcome: failed-outcome,
    effect-outcome: option<effect-outcome>,
  }

  record deadline-adjustment {
    node: string,
    requested-ms: u64,
    effective-ms: u64,
  }

  record delivery-report {
    outcome: result<delivery-outcome, delivery-error>,
    deadline-adjustments: list<deadline-adjustment>,
    /// Labels only for actor IDs in the authorized result.
    actor-labels: list<tuple<string, string>>,
    /// The ETag of a read that responded or was not modified.
    etag: option<string>,
  }

  /// A streamed read, known before its first row.
  record streamed-reply {
    /// The weak ETag of the list, from the model versions before the query ran.
    etag: option<string>,
    /// The reply lines: `{"row":…}` for each row, then one `{"outcome":…}`.
    /// A stream that ends without the outcome line is a failed read.
    lines: stream<string>,
  }

  deliver: async func(request: delivery-request) -> delivery-report;

  /// Deliver a query read as a stream of lines. A refusal, a not-modified
  /// answer, or a failure before the first row returns the report that
  /// `deliver` would return.
  deliver-stream: async func(request: delivery-request) -> result<streamed-reply, delivery-report>;
}
