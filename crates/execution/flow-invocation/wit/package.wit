package wamn:flow-invocation@0.1.0;

/// Stable invocation boundary between ingress and flow execution.
///
/// STATUS: FROZEN 0.1.0 (wamn-5wd1.38). This is the caller-facing flow
/// invocation protocol from FLOW-SPEC rev18 §8, §§9.1-9.7, and §11. It is
/// categorically separate from node execution internals.
interface invocation {
  /// A mapped, validated JSON document encoded as UTF-8 text.
  type json = string;

  /// Opaque authenticated identity verified by the ingress adapter.
  type principal-ref = string;

  /// W3C trace context propagated into the admitted run.
  record trace-context {
    traceparent: string,
    tracestate: option<string>,
  }

  /// Stage-B output presented to final admission.
  record invoke-request {
    attachment-id: string,
    expected-catalog-version: u64,
    expected-definition-hash: string,
    client-request-fingerprint: string,
    payload: json,
    idempotency-key: option<string>,
    principal: principal-ref,
    /// Optional caller-selected deadline override, in milliseconds.
    deadline-override: option<u64>,
    trace: option<trace-context>,
  }

  /// A durable run handle returned immediately after admission.
  record admitted {
    run-id: string,
  }

  /// A pre-run refusal. No run exists, so this deliberately has no run ID.
  record rejection {
    status: u16,
    code: string,
  }

  /// The first stage of the invocation handshake.
  variant begin-result {
    admitted(admitted),
    rejected(rejection),
  }

  /// A stored successful caller outcome.
  record response {
    run-id: string,
    body: json,
    status-hint: option<u16>,
  }

  /// A stored failed caller envelope.
  record flow-error {
    code: string,
    message: option<string>,
    run-id: string,
    flow-id: string,
    flow-version: u32,
  }

  /// A stored failure and its durable `caller_http_status`.
  record failure {
    status: u16,
    error: flow-error,
  }

  /// Exactly one stored caller outcome; there is no accepted/pending arm.
  variant invoke-result {
    responded(response),
    failed(failure),
  }

  /// Admit a new run or return a typed pre-run rejection.
  begin: func(req: invoke-request) -> begin-result;

  /// Wait at most `timeout-ms`; `none` means the run is still unreleased.
  wait: func(run-id: string, timeout-ms: u32) -> option<invoke-result>;
}
