import manifest

manifest.Package {
    package = {id = "file_fixture", version = "0.1.0"}
    required_platform_policy_contract = {id = "file_fixture_data_access", state = "satisfied"}
    models = {}
    connections = {
        files = {interface = "wasmcloud:blobstore/blobstore@0.1.0", mode = "write"}
        "files-read" = {interface = "wasmcloud:blobstore/blobstore@0.1.0", mode = "read"}
        "files-no-cdn" = {interface = "wasmcloud:blobstore/blobstore@0.1.0", mode = "write"}
    }
    components = {fixture = {connections = []}}
    routes = {
        auth_modes = ["session"]
        operations = {"fixture.run" = {id = "fixture-run-http", path = "/fixture/run"}}
    }
    custom_operations = {
        "fixture.run" = manifest.Command("fixture.run") {
            connection = None
            transaction = None
            automatic_retry = None
            idempotent_by = "stateless"
            input.fields = []
            result = {class = "one", fields = [{path = "value", type = "text"}]}
            errors = ["invalid_input", "permission_denied", "internal_error"]
        }
    }
}
