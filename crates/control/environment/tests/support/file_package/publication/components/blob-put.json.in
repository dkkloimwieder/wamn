{
  "target": {
    "project_env_key": "__PROJECT_ENV_KEY__",
    "package-id": "__PACKAGE_ID__",
    "package-version": "__PACKAGE_VERSION__"
  },
  "component": "blob-put",
  "interface-version": "0.1.0",
  "operations": {
    "wamn:node/async-handler@0.1.0": {
      "connections": [
        {
          "store-alias": "files",
          "requirement-type": "blobstore", "mode": "write"
        },
        {
          "store-alias": "files-read",
          "requirement-type": "blobstore", "mode": "read"
        },
        {
          "store-alias": "files-no-cdn",
          "requirement-type": "blobstore", "mode": "write"
        }
      ],
      "input-ports": [
        {
          "name": "input",
          "schema": {
            "type": "array"
          }
        }
      ],
      "output-ports": [
        {
          "name": "main",
          "schema": {
            "type": "array"
          }
        }
      ],
      "parameters": [
        {
          "name": "store_alias",
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "required": true
        },
        {
          "name": "key_field",
          "schema": {
            "type": "string",
            "pattern": "^(|/.*)$"
          },
          "required": true
        },
        {
          "name": "body_field",
          "schema": {
            "type": "string",
            "pattern": "^(|/.*)$"
          },
          "required": true
        }
      ]
    }
  }
}
