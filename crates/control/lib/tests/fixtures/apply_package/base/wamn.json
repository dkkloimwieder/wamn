{
  "package": {
    "id": "wamn_inventory",
    "version": "1.0.0"
  },
  "required_platform_policy_contract": {
    "id": "inventory_data_access",
    "state": "satisfied"
  },
  "models": {
    "ingot": {
      "schema": "inventory",
      "table": "ingot",
      "owner": "wamn_inventory",
      "server_owned_fields": [
        "id"
      ],
      "enum_fields": {},
      "audit_log": {
        "columns": [],
        "retention": "none"
      },
      "operations": {}
    },
    "dock": {
      "schema": "inventory",
      "table": "dock",
      "owner": "wamn_inventory",
      "server_owned_fields": [
        "id"
      ],
      "enum_fields": {},
      "audit_log": {
        "columns": [],
        "retention": "none"
      },
      "operations": {}
    },
    "panel": {
      "schema": "inventory",
      "table": "panel",
      "owner": "wamn_inventory",
      "client_field_extensible": true,
      "server_owned_fields": [
        "id",
        "panel_number",
        "status",
        "row_version",
        "created_at",
        "updated_at"
      ],
      "enum_fields": {
        "status": [
          "open",
          "complete",
          "cancelled"
        ]
      },
      "audit_log": {
        "columns": [
          "created_at",
          "created_by",
          "updated_at",
          "updated_by"
        ],
        "retention": "unlimited"
      },
      "operations": {
        "get": {
          "permission": "panel.get",
          "result": "one"
        },
        "update": {
          "permission": "panel.update",
          "writable_fields": [
            "stock_id"
          ],
          "revision_field": "row_version",
          "result": "one"
        }
      }
    },
    "panel_line": {
      "schema": "inventory",
      "table": "panel_line",
      "owner": "wamn_inventory",
      "server_owned_fields": [
        "id"
      ],
      "enum_fields": {},
      "audit_log": {
        "columns": [],
        "retention": "P30D"
      },
      "operations": {}
    },
    "rack": {
      "schema": "inventory",
      "table": "rack",
      "owner": "wamn_inventory",
      "server_owned_fields": [
        "id",
        "idempotency_key",
        "panel_id",
        "rack_reference",
        "occurred_at",
        "created_at"
      ],
      "enum_fields": {},
      "audit_log": {
        "columns": [
          "created_at",
          "created_by"
        ],
        "retention": "none"
      },
      "operations": {
        "get": {
          "permission": "rack.get",
          "result": "one"
        }
      }
    },
    "rack_line": {
      "schema": "inventory",
      "table": "rack_line",
      "owner": "wamn_inventory",
      "server_owned_fields": [
        "id"
      ],
      "enum_fields": {},
      "audit_log": {
        "columns": [],
        "retention": "none"
      },
      "operations": {}
    }
  },
  "internal_relations": {
    "record_rack_command": {
      "schema": "inventory",
      "table": "record_rack_command",
      "cdc": "excluded"
    }
  },
  "custom_operations": {},
  "connections": [
    "postgres"
  ],
  "components": {
    "inventory": {
      "connections": [
        "postgres"
      ]
    }
  }
}
