{
  "scope": {
    "env_key": "__ENV_KEY__",
    "package-id": "__PACKAGE_ID__",
    "package-version": "__PACKAGE_VERSION__"
  },
  "component": "blob-put",
  "interface-version": "0.1.0",
  "operations": {
    "wamn:node/async-handler@0.1.0": {
      "input-ports": [
        {
          "name": "input",
          "schema": {
            "type": "array"
          }
        }
      ],
      "output-ports": [
        {
          "name": "main",
          "schema": {
            "type": "array"
          }
        }
      ],
      "parameters": [
        {
          "name": "store_alias",
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "required": true
        },
        {
          "name": "key_field",
          "schema": {
            "type": "string",
            "pattern": "^(|/.*)$"
          },
          "required": true
        },
        {
          "name": "body_field",
          "schema": {
            "type": "string",
            "pattern": "^(|/.*)$"
          },
          "required": true
        }
      ]
    }
  },
  "connections": [
    {
      "store-alias": "files",
      "requirement-type": "blobstore"
    },
    {
      "store-alias": "files_read",
      "requirement-type": "blobstore"
    },
    {
      "store-alias": "files_no_cdn",
      "requirement-type": "blobstore"
    }
  ]
}
