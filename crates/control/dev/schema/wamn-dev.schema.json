{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "CdcReader": {
      "additionalProperties": false,
      "description": "The CDC reader the loop runs beside the host: the cluster's binary with the cluster's registration, credentials and broker identity.",
      "properties": {
        "binary": {
          "description": "The built `wamn-cdc-reader`.",
          "type": "string"
        },
        "cdc_sql_file": {
          "description": "The CDC SQL of `enable-cdc-project-env`, applied to every new target.",
          "type": "string"
        },
        "cdc_url": {
          "description": "The replication credential, the `url` of the rendered CDC Secret.",
          "type": "string"
        },
        "system_database_url": {
          "description": "The registry-reader generation that reads the registration.",
          "type": "string"
        }
      },
      "required": [
        "binary",
        "cdc_sql_file",
        "cdc_url",
        "system_database_url"
      ],
      "type": "object"
    },
    "LocalArtifacts": {
      "additionalProperties": false,
      "description": "Explicit local candidate files owned by one disposable development session.",
      "properties": {
        "directory": {
          "type": "string"
        },
        "flow_http_component": {
          "type": "string"
        },
        "materializer_component": {
          "description": "The built platform materializer, which the loop runs beside the release as the cluster does.",
          "type": "string"
        }
      },
      "required": [
        "directory",
        "flow_http_component",
        "materializer_component"
      ],
      "type": "object"
    },
    "SessionIdentity": {
      "additionalProperties": false,
      "description": "Public trust for the identity process owned by the development environment.",
      "properties": {
        "ca": {
          "type": "string"
        },
        "instance_suffix": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        }
      },
      "required": [
        "ca",
        "instance_suffix",
        "issuer"
      ],
      "type": "object"
    }
  },
  "description": "Sole field authority for the strict deployment-owned `dev.json` document.",
  "properties": {
    "administration_database_url": {
      "type": "string"
    },
    "catalog": {
      "type": "string"
    },
    "cdc_reader": {
      "anyOf": [
        {
          "$ref": "#/definitions/CdcReader"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The CDC reader that `wamn dev up` enabled. Absent means no reader runs."
    },
    "condition_bearer_token": {
      "type": "string"
    },
    "connection_database_url": {
      "default": null,
      "type": "string"
    },
    "dup_window_secs": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "environment": {
      "type": "string"
    },
    "event_materializer_database_url": {
      "type": "string"
    },
    "executor_platform_database_url": {
      "type": "string"
    },
    "guest_database_url": {
      "type": "string"
    },
    "host_binary": {
      "type": "string"
    },
    "host_config_file": {
      "description": "The materializer's events binding in the environment's private root, as the cluster mounts its Secret.",
      "type": "string"
    },
    "host_group": {
      "type": "string"
    },
    "host_name": {
      "type": "string"
    },
    "http_admitter_database_url": {
      "type": "string"
    },
    "identity_database_url": {
      "type": "string"
    },
    "local_artifacts": {
      "$ref": "#/definitions/LocalArtifacts"
    },
    "migration_database_url": {
      "type": "string"
    },
    "nats_tls_ca": {
      "type": "string"
    },
    "nats_tls_cert": {
      "type": "string"
    },
    "nats_tls_key": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "otel_exporter_otlp_endpoint": {
      "type": "string"
    },
    "package_sources": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "platform_domain": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "route_host": {
      "type": "string"
    },
    "runner": {
      "type": "string"
    },
    "scheduler_nats_url": {
      "type": "string"
    },
    "session_identity": {
      "anyOf": [
        {
          "$ref": "#/definitions/SessionIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stream_replicas": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "system_database_url": {
      "type": "string"
    },
    "target_database_url": {
      "type": "string"
    },
    "wasmtime_cache_dir": {
      "type": "string"
    }
  },
  "required": [
    "administration_database_url",
    "catalog",
    "condition_bearer_token",
    "dup_window_secs",
    "environment",
    "event_materializer_database_url",
    "executor_platform_database_url",
    "guest_database_url",
    "host_binary",
    "host_config_file",
    "host_group",
    "host_name",
    "http_admitter_database_url",
    "identity_database_url",
    "local_artifacts",
    "migration_database_url",
    "nats_tls_ca",
    "nats_tls_cert",
    "nats_tls_key",
    "org",
    "otel_exporter_otlp_endpoint",
    "package_sources",
    "platform_domain",
    "project",
    "route_host",
    "runner",
    "scheduler_nats_url",
    "stream_replicas",
    "system_database_url",
    "target_database_url",
    "wasmtime_cache_dir"
  ],
  "title": "DevConfigDocument",
  "type": "object"
}
