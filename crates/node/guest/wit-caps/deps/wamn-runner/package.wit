package wamn:runner@0.1.0;

/// Trusted one-frame HTTP effect surface, linked only into flowrunner.
interface http-effect {
  record invocation-context {
    version: string,
    tenant-id: string,
    environment: string,
    catalog-id: string,
    catalog-version: s32,
    run-id: string,
    flow-id: string,
    flow-version: u32,
    artifact-digest: string,
    node-id: string,
    occurrence: u32,
    attempt: u32,
    requirement-name: string,
  }

  record header { name: string, value: list<u8> }
  record relative-request {
    method: string,
    path-and-query: string,
    headers: list<header>,
    body: option<list<u8>>,
  }
  record response { status: u16, headers: list<header>, body: list<u8> }
  variant effect-error {
    invalid-context,
    undeclared-requirement,
    node-not-permitted,
    unbound,
    inactive-generation,
    incompatible,
    authority-denied,
    credential-unavailable,
    timeout,
    transport(string),
  }
  send: func(
    context: invocation-context,
    requirement-name: string,
    request: relative-request,
  ) -> result<response, effect-error>;
}
