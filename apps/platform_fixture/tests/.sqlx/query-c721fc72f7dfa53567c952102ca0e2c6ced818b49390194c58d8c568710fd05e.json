  "query": "SELECT\n    claim.canonical_command,\n    model.code,\n    model.created_at,\n    model.edit_version,\n    model.id,\n    model.maker_id,\n    model.note\nFROM widget_command AS claim\nJOIN widget AS model\n    ON model.id = claim.widget_id\nWHERE claim.idempotency_key = $1::text;\n",
