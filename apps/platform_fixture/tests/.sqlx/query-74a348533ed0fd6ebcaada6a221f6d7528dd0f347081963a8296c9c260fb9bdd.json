{
  "db_name": "PostgreSQL",
  "query": "SELECT\n    widget.code,\n    widget.created_at,\n    widget.edit_version,\n    widget.id,\n    widget.maker_id,\n    widget.note\nFROM widget AS widget\nWHERE\n    (\n        $1::jsonb IS NULL\n        OR widget.code IN (\n            SELECT filter.value\n            FROM jsonb_array_elements_text($1::jsonb) AS filter(value)\n        )\n    )\n    AND (\n        $2::timestamptz IS NULL\n        OR widget.created_at > $2::timestamptz\n        OR (\n            widget.created_at = $2::timestamptz\n            AND widget.id > $3::uuid\n        )\n    )\nORDER BY\n    widget.created_at ASC,\n    widget.id ASC\nLIMIT $4::int8;\n",
