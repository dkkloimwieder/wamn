  record create-row {
    code: string,
    created-at: string,
    edit-version: s64,
    id: string,
    maker-id: option<string>,
    note: option<string>,
  }

  record create-result {
    value: create-row,
  }

  record create-outcome {
    request-id: string,
    outcome: result<create-result, create-error>,
  }

  run: async func(ctx: node-context, input: list<create-item>) -> result<list<create-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

interface update {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record update-change {
    code: option<option<string>>,
    maker-id: option<option<string>>,
    note: option<option<string>>,
  }

  record update-request {
    id: string,
    expected-edit-version: s64,
    change: update-change,
  }

  record invalid-input-detail {
    field: string,
  }

  record not-found-detail {
    field: string,
    id: string,
  }

  record concurrency-conflict-detail {
    expected-row-version: s64,
    observed-row-version: s64,
  }

  record unique-violation-detail {
    constraint: string,
  }

  record foreign-key-violation-detail {
    constraint: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant update-error {
    invalid-input(invalid-input-detail),
    not-found(not-found-detail),
    concurrency-conflict(concurrency-conflict-detail),
    unique-violation(unique-violation-detail),
    foreign-key-violation(foreign-key-violation-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record update-item {
    request-id: string,
    input: result<update-request, invalid-input-detail>,
  }

  record update-result {
    code: string,
    created-at: string,
    edit-version: s64,
    id: string,
    maker-id: option<string>,
    note: option<string>,
  }

  record update-outcome {
    request-id: string,
    outcome: result<update-result, update-error>,
  }

  run: async func(ctx: node-context, input: list<update-item>) -> result<list<update-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}
