interface record-batch {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record record-batch-line {
    amount: string,
    widget-id: string,
  }

  record record-batch-request {
    expected-edit-version: s64,
    grade: string,
    idempotency-key: string,
    line: list<record-batch-line>,
    maker-id: option<string>,
    note: option<string>,
  }

  record idempotency-conflict-detail {
    field: string,
  }

  record invalid-input-detail {
    field: string,
    minimum: option<s64>,
    maximum: option<s64>,
    observed: option<s64>,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant record-batch-error {
    invalid-input(invalid-input-detail),
    idempotency-conflict(idempotency-conflict-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record record-batch-item {
    request-id: string,
    input: result<record-batch-request, invalid-input-detail>,
  }

  record record-batch-result {
    widget-id: string,
  }

  record record-batch-outcome {
    request-id: string,
    outcome: result<record-batch-result, record-batch-error>,
  }

  run: async func(ctx: node-context, input: list<record-batch-item>) -> result<list<record-batch-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}
