    note: option<option<string>>,
  }

  record invalid-input-detail {
    field: string,
  }

  record idempotency-conflict-detail {
    field: string,
  }

  record unique-violation-detail {
    constraint: string,
  }

  record foreign-key-violation-detail {
    constraint: string,
  }

  record check-violation-detail {
    constraint: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant create-error {
    invalid-input(invalid-input-detail),
    idempotency-conflict(idempotency-conflict-detail),
    unique-violation(unique-violation-detail),
    foreign-key-violation(foreign-key-violation-detail),
    check-violation(check-violation-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record create-item {
    request-id: string,
    input: result<create-request, invalid-input-detail>,
