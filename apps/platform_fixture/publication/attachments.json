  "widget-record-batch-http": {
    "kind": "http",
    "package-id": "platform_fixture",
    "component": "fixture",
    "operation": "platform-fixture:widget/record-batch@1.0.0",
    "definition-hash": "sha256:f80b3df7166aaf192b4967c0d799d07f2cc605430d9be4f5e6d5579bbba699df",
    "definition": {
      "id": "widget-record-batch-http",
      "kind": "http",
      "route": {
        "path": "/widget/record_batch",
        "method": "POST"
      },
      "raw-body-bytes": {
        "maximum": 1048576
      },
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "request_id",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "object",
              "required": [
                "idempotency_key",
                "expected_edit_version",
                "grade",
                "line"
              ],
              "additionalProperties": false,
              "properties": {
                "idempotency_key": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "maker_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                },
                "expected_edit_version": {
                  "type": "string"
                },
                "grade": {
                  "type": "string",
                  "enum": [
                    "first",
                    "second"
                  ]
                },
                "inspector_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                },
                "line": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 10,
                  "items": {
                    "type": "object",
                    "required": [
                      "widget_id",
                      "amount"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "widget_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "amount": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "auth-policy": {
      "modes": [
        "pat"
      ]
    },
    "registered-operation": "platform-fixture:widget/record-batch@1.0.0"
  },
