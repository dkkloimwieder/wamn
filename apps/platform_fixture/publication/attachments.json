          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "object",
              "required": [
                "idempotency_key",
                "expected_edit_version",
                "line"
              ],
              "additionalProperties": false,
              "properties": {
                "idempotency_key": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "maker_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                },
                "expected_edit_version": {
                  "type": "string"
                },
                "line": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 10,
                  "items": {
                    "type": "object",
                    "required": [
                      "widget_id",
                      "amount"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "widget_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "amount": {
