{
  "format-version": "0.1",
  "wiring-id": "rest_item",
  "version": 1,
  "entry": "begin",
  "nodes": {
    "page": {
      "component": "http-page",
      "interface-version": "0.1.0",
      "operation": "wamn:node/async-handler@0.1.0",
      "params": {
        "requirement": "upstream",
        "path-and-query": "/pages?limit=2",
        "page": {
          "style": "offset",
          "limit": "limit",
          "offset": "offset"
        },
        "items": "/items",
        "carry-input-pointer": "/due"
      }
    },
    "rows": {
      "component": "jsonata",
      "interface-version": "0.1.0",
      "operation": "wamn:node/handler@0.1.0",
      "params": {
        "expression": "[{\"request_id\": carry, \"value\": {\"external_system_id\": $parameters.external_system_id, \"idempotency_key\": carry, \"items\": [items.{\"key\": id, \"name\": name}]}}]",
        "port": "items"
      }
    },
    "record": {
      "component": "rest_consumer_fixture",
      "interface-version": "0.1.0",
      "operation": "rest-consumer-fixture:item/record",
      "operation-dependency": {
        "alias": "consumer",
        "operation": "item.record"
      }
    },
    "begin": {
      "component": "rest_connector",
      "interface-version": "0.1.0",
      "operation": "wamn:node/async-handler@0.1.0"
    },
    "finish": {
      "component": "rest_connector",
      "interface-version": "0.1.0",
      "operation": "rest-connector:sync/finish"
    }
  },
  "edges": [
    {
      "from": "begin",
      "to": "page"
    },
    {
      "from": "page",
      "to": "rows",
      "to-port": "input"
    },
    {
      "from": "rows",
      "from-port": "items",
      "to": "record"
    },
    {
      "from": "record",
      "to": "finish"
    }
  ]
}
