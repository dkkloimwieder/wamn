{
  "format-version": "0.3",
  "graph-id": "rest_item",
  "version": 1,
  "nodes": {
    "entry": {
      "entry": {
        "schedule": {
          "cron": "* * * * *"
        }
      }
    },
    "page": {
      "call": {
        "sibling": "wamn_palette-http-page",
        "export": "wamn:node/async-handler@0.2.0",
        "params": {
          "requirement": "upstream",
          "path-and-query": "/pages?limit=2",
          "page": {
            "style": "offset",
            "limit": "limit",
            "offset": "offset"
          },
          "items": "/items",
          "carry-input-pointer": "/due"
        }
      }
    },
    "rows": {
      "call": {
        "sibling": "wamn_palette-jsonata",
        "export": "wamn:node/handler@0.2.0",
        "params": {
          "expression": "($assert($type($) = \"object\" and $type(carry) = \"string\" and $type(external_system_id) = \"string\" and $contains(external_system_id, /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/) and $type(items) = \"array\", \"page must contain carry, external_system_id and items\"); [{\"request_id\": carry, \"value\": {\"external_system_id\": external_system_id, \"idempotency_key\": carry, \"items\": [items.{\"key\": id, \"name\": name}]}}])",
          "port": "items",
          "input-schema": {},
          "output-schema": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "request_id": {
                  "type": "string"
                },
                "value": {
                  "type": "object",
                  "properties": {
                    "external_system_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "idempotency_key": {
                      "type": "string"
                    },
                    "items": {}
                  },
                  "required": [
                    "external_system_id",
                    "idempotency_key",
                    "items"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "request_id",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          }
        }
      }
    },
    "record": {
      "call": {
        "sibling": "rest_consumer_fixture-rest_consumer_fixture",
        "export": "rest-consumer-fixture:item/record@0.1.1"
      }
    },
    "begin": {
      "call": {
        "sibling": "rest_connector-rest_connector",
        "export": "wamn:node/async-handler@0.2.0"
      }
    },
    "finish": {
      "call": {
        "sibling": "rest_connector-rest_connector",
        "export": "rest-connector:sync/finish@0.1.1"
      }
    },
    "completed": {
      "call": {
        "sibling": "wamn_palette-jsonata",
        "export": "wamn:node/handler@0.2.0",
        "params": {
          "expression": "($assert($count($) = 1 and $not($exists($[0].error)), \"consumer command did not succeed\"); $)",
          "port": "items",
          "input-schema": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "object",
                      "properties": {
                        "keys": {}
                      },
                      "required": [
                        "keys"
                      ],
                      "additionalProperties": false
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value",
                    "request_id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "error": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "idempotency_conflict"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {
                                "field": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "field"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "internal_error"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {},
                              "required": [],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "invalid_input"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {
                                "field": {
                                  "type": "string"
                                },
                                "minimum": {
                                  "type": "string"
                                },
                                "maximum": {
                                  "type": "string"
                                },
                                "observed": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "field"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "permission_denied"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {
                                "operation": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "operation"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "retry"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {},
                              "required": [],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "timeout"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {},
                              "required": [],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "request_id"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "output-schema": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "request_id": {
                  "type": "string"
                },
                "value": {
                  "type": "object",
                  "properties": {
                    "keys": {}
                  },
                  "required": [
                    "keys"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "request_id",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          }
        }
      }
    }
  },
  "edges": [
    {
      "from": "entry",
      "to": "begin"
    },
    {
      "from": "begin",
      "to": "page"
    },
    {
      "from": "page",
      "to": "rows",
      "to-port": "input"
    },
    {
      "from": "rows",
      "from-port": "items",
      "to": "record"
    },
    {
      "from": "record",
      "to": "completed",
      "to-port": "input"
    },
    {
      "from": "completed",
      "from-port": "items",
      "to": "finish"
    }
  ]
}
