{
  "format-version": "0.1",
  "wiring-id": "rest_item",
  "version": 1,
  "entry": "begin",
  "nodes": {
    "page": {
      "component": "http-page",
      "interface-version": "0.1.0",
      "operation": "wamn:node/async-handler@0.1.0",
      "params": {
        "requirement": "upstream",
        "path-and-query": "/pages?limit=2",
        "page": {
          "style": "offset",
          "limit": "limit",
          "offset": "offset"
        },
        "items": "/items",
        "carry-input-pointer": "/due"
      }
    },
    "rows": {
      "component": "jsonata",
      "interface-version": "0.1.0",
      "operation": "wamn:node/handler@0.1.0",
      "params": {
        "expression": "[{\"request_id\": carry, \"value\": {\"external_system_id\": external_system_id, \"idempotency_key\": carry, \"items\": [items.{\"key\": id, \"name\": name}]}}]",
        "port": "items",
        "input-schema": {},
        "output-schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string"
              },
              "value": {
                "type": "object",
                "properties": {
                  "external_system_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "idempotency_key": {
                    "type": "string"
                  },
                  "items": {}
                },
                "required": [
                  "external_system_id",
                  "idempotency_key",
                  "items"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "request_id",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100
        }
      }
    },
    "record": {
      "component": "rest_consumer_fixture",
      "interface-version": "0.1.0",
      "operation": "rest-consumer-fixture:item/record@0.1.1",
      "operation-dependency": {
        "alias": "consumer",
        "operation": "item.record"
      }
    },
    "begin": {
      "component": "rest_connector",
      "interface-version": "0.1.0",
      "operation": "wamn:node/async-handler@0.1.0"
    },
    "finish": {
      "component": "rest_connector",
      "interface-version": "0.1.0",
      "operation": "rest-connector:sync/finish@0.1.1"
    }
  },
  "edges": [
    {
      "from": "begin",
      "to": "page"
    },
    {
      "from": "page",
      "to": "rows",
      "to-port": "input"
    },
    {
      "from": "rows",
      "from-port": "items",
      "to": "record"
    },
    {
      "from": "record",
      "to": "finish"
    }
  ]
}
