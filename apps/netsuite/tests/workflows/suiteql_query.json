{
  "format-version": "0.3",
  "graph-id": "suiteql_query",
  "version": 1,
  "nodes": {
    "entry": {
      "entry": {
        "request": {
          "path": "/suiteql_query"
        }
      }
    },
    "map": {
      "call": {
        "sibling": "wamn_palette-jsonata",
        "export": "wamn:node/handler@0.2.0",
        "params": {
          "expression": "($assert($type(q) = \"string\" and $contains($lowercase(q), \"order by id\"), \"SuiteQL must order by the stable id key\"); {\"body\": {\"q\": q}, \"due\": null})",
          "input-schema": {
            "type": "object",
            "properties": {
              "q": {
                "type": "string",
                "examples": [
                  "SELECT id FROM customer ORDER BY id"
                ]
              }
            },
            "required": [
              "q"
            ],
            "additionalProperties": true
          },
          "output-schema": {}
        }
      }
    },
    "page": {
      "call": {
        "sibling": "wamn_palette-http-page",
        "export": "wamn:node/async-handler@0.2.0",
        "params": {
          "requirement": "upstream",
          "method": "POST",
          "path-and-query": "/services/rest/query/v1/suiteql?limit=1000",
          "body-input-pointer": "/body",
          "carry-input-pointer": "/due",
          "headers": {
            "Prefer": "transient"
          },
          "page": {
            "style": "offset",
            "limit": "limit",
            "offset": "offset",
            "has-more": "/hasMore"
          },
          "items": "/items"
        }
      }
    },
    "response": {
      "response": {
        "status": 200
      }
    }
  },
  "edges": [
    {
      "from": "entry",
      "to": "map"
    },
    {
      "from": "map",
      "to": "page"
    },
    {
      "from": "page",
      "to": "response"
    }
  ]
}
