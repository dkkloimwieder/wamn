{
  "format-version": "0.2",
  "wiring-id": "netsuite_pull",
  "version": 1,
  "nodes": {
    "entry": {
      "entry": {
        "schedule": {
          "cron": "* * * * *"
        }
      }
    },
    "begin": {
      "call": {
        "sibling": "wamn_palette-jsonata",
        "export": "wamn:node/handler@0.1.0",
        "params": {
          "expression": "[{\"key\": \"last_synced_at\", \"carry\": due}]",
          "port": "items",
          "input-schema": {
            "type": "object",
            "properties": {
              "due": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "due"
            ],
            "additionalProperties": true
          },
          "output-schema": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "carry": {}
              },
              "required": [
                "carry",
                "key"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          }
        }
      }
    },
    "read": {
      "call": {
        "sibling": "wamn_integration-wamn_integration",
        "export": "wamn-integration:setting/read@0.1.1"
      }
    },
    "window": {
      "call": {
        "sibling": "wamn_palette-jsonata",
        "export": "wamn:node/handler@0.1.0",
        "params": {
          "expression": "($assert($count($) = 1 and $exists($[0].value), \"checkpoint read failed\"); $state := $[0].value; $lower := $state.value != null ? $state.value : \"1970-01-01T00:00:00Z\"; $due := $state.carry; $assert($toMillis($lower) < $toMillis($due), \"window must advance\"); $stamp := function($t) { $replace($substring($fromMillis($toMillis($t)), 0, 19), \"T\", \" \") }; {\"due\": $due, \"body\": {\"q\": \"SELECT id, entityid AS name FROM customer WHERE lastmodifieddate >= TO_DATE('\" & $stamp($lower) & \"', 'YYYY-MM-DD HH24:MI:SS') AND lastmodifieddate < TO_DATE('\" & $stamp($due) & \"', 'YYYY-MM-DD HH24:MI:SS') ORDER BY id\"}})",
          "input-schema": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "object",
                      "properties": {
                        "value": {},
                        "carry": {}
                      },
                      "required": [
                        "carry",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "error": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "internal_error"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {},
                              "required": [],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "invalid_input"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {
                                "field": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "field"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "retry"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {},
                              "required": [],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "timeout"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {},
                              "required": [],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "output-schema": {}
        }
      }
    },
    "page": {
      "call": {
        "sibling": "wamn_palette-http-page",
        "export": "wamn:node/async-handler@0.1.0",
        "params": {
          "requirement": "upstream",
          "method": "POST",
          "path-and-query": "/services/rest/query/v1/suiteql?limit=1000",
          "body-input-pointer": "/body",
          "carry-input-pointer": "/due",
          "headers": {
            "Prefer": "transient"
          },
          "page": {
            "style": "offset",
            "limit": "limit",
            "offset": "offset",
            "has-more": "/hasMore"
          },
          "items": "/items"
        }
      }
    },
    "rows": {
      "call": {
        "sibling": "wamn_palette-jsonata",
        "export": "wamn:node/handler@0.1.0",
        "params": {
          "expression": "($assert($type($) = \"object\" and $type(carry) = \"string\" and $type(external_system_id) = \"string\" and $contains(external_system_id, /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/) and $type(items) = \"array\", \"page must contain carry, external_system_id and items\"); [{\"request_id\": carry, \"value\": {\"external_system_id\": external_system_id, \"idempotency_key\": carry, \"items\": [items.{\"key\": $string(id), \"name\": name}]}}])",
          "port": "items",
          "input-schema": {},
          "output-schema": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "request_id": {
                  "type": "string"
                },
                "value": {
                  "type": "object",
                  "properties": {
                    "external_system_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "idempotency_key": {
                      "type": "string"
                    },
                    "items": {}
                  },
                  "required": [
                    "external_system_id",
                    "idempotency_key",
                    "items"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "request_id",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          }
        }
      }
    },
    "record": {
      "call": {
        "sibling": "rest_consumer_fixture-rest_consumer_fixture",
        "export": "rest-consumer-fixture:item/record@0.1.1"
      }
    },
    "finish": {
      "call": {
        "sibling": "wamn_palette-jsonata",
        "export": "wamn:node/handler@0.1.0",
        "params": {
          "expression": "($assert($count($) = 1 and $type($lookup($[0].value, \"keys\")) = \"array\" and $not($exists($[0].error)), \"consumer command did not succeed\"); [{\"request_id\": $[0].request_id, \"value\": {\"due\": $[0].request_id}}])",
          "port": "items",
          "input-schema": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "object",
                      "properties": {
                        "keys": {}
                      },
                      "required": [
                        "keys"
                      ],
                      "additionalProperties": false
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value",
                    "request_id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "error": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "idempotency_conflict"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {
                                "field": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "field"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "internal_error"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {},
                              "required": [],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "invalid_input"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {
                                "field": {
                                  "type": "string"
                                },
                                "minimum": {
                                  "type": "string"
                                },
                                "maximum": {
                                  "type": "string"
                                },
                                "observed": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "field"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "permission_denied"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {
                                "operation": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "operation"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "retry"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {},
                              "required": [],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "const": "timeout"
                            },
                            "detail": {
                              "type": "object",
                              "properties": {},
                              "required": [],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "code",
                            "detail"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "request_id"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "output-schema": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "request_id": {
                  "type": "string"
                },
                "value": {
                  "type": "object",
                  "properties": {
                    "due": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "due"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "request_id",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          }
        }
      }
    },
    "write": {
      "call": {
        "sibling": "netsuite-netsuite",
        "export": "netsuite:sync/finish@0.1.1"
      }
    }
  },
  "edges": [
    {
      "from": "entry",
      "to": "begin"
    },
    {
      "from": "begin",
      "to": "read",
      "from-port": "items"
    },
    {
      "from": "read",
      "to": "window",
      "to-port": "input"
    },
    {
      "from": "window",
      "to": "page"
    },
    {
      "from": "page",
      "to": "rows",
      "to-port": "input"
    },
    {
      "from": "rows",
      "to": "record",
      "from-port": "items"
    },
    {
      "from": "record",
      "to": "finish",
      "to-port": "items"
    },
    {
      "from": "finish",
      "to": "write",
      "from-port": "items"
    }
  ]
}
