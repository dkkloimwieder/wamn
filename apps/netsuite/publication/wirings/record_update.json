{
  "format-version": "0.1",
  "wiring-id": "record_update",
  "version": 1,
  "entry": "map",
  "nodes": {
    "map": {
      "component": "jsonata",
      "interface-version": "0.1.0",
      "operation": "wamn:node/handler@0.1.0",
