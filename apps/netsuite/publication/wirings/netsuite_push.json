{
  "format-version": "0.1",
  "wiring-id": "netsuite_push",
  "version": 1,
  "entry": "map",
  "nodes": {
    "map": {
      "component": "jsonata",
      "interface-version": "0.1.0",
      "operation": "wamn:node/handler@0.1.0",
      "params": {
        "expression": "($assert(event = \"insert\" and $type(new.key) = \"string\" and $length(new.key) > 0, \"item insert requires a stable key\"); {\"path\": \"/services/rest/record/v1/\" & $encodeUrlComponent($parameters.record_type) & \"/eid:\" & $encodeUrlComponent(new.key), \"body\": {\"entityId\": new.name, \"externalId\": new.key}})",
        "parameters": {
          "record_type": "customer"
        }
      }
    },
    "request": {
      "component": "http-request",
      "interface-version": "0.1.0",
      "operation": "wamn:node/async-handler@0.1.0",
      "params": {
        "requirement": "upstream",
        "method": "PUT",
        "path-and-query": "/services/rest/record/v1/customer",
        "path-input-pointer": "/path",
        "body-input-pointer": "/body",
        "headers": {
          "Content-Type": "application/json"
        }
      }
    }
  },
  "edges": [
    {
      "from": "map",
      "to": "request"
    }
  ]
}
