{
  "format-version": "0.1",
  "wiring-id": "record_create",
  "version": 1,
  "entry": "map",
  "nodes": {
    "map": {
      "component": "jsonata",
      "interface-version": "0.1.0",
      "operation": "wamn:node/handler@0.1.0",
      "params": {
        "expression": "($pointer := $parameters.external_id_input_pointer; $upsert := $exists($pointer); $key := $upsert ? $reduce($split($substring($pointer, 1), \"/\"), function($v, $k) {($k := $replace($replace($k, \"~1\", \"/\"), \"~0\", \"~\"); $type($v) = \"array\" ? $v[$number($k)] : $lookup($v, $k))}, $) : \"\"; $assert($not($upsert) or ($substring($pointer, 0, 1) = \"/\" and $type($key) = \"string\" and $length($key) > 0), \"external id pointer must select a nonempty string\"); [{\"port\": $upsert ? \"items\" : \"main\", \"path\": \"/services/rest/record/v1/\" & $encodeUrlComponent($parameters.record_type) & ($upsert ? \"/eid:\" & $encodeUrlComponent($key) : \"\"), \"body\": body}])",
        "parameters": {
          "record_type": "customer"
        },
        "port-input-pointer": "/0/port"
      }
    },
    "post": {
      "component": "http-request",
      "interface-version": "0.1.0",
      "operation": "wamn:node/async-handler@0.1.0",
      "params": {
        "requirement": "upstream",
        "method": "POST",
        "path-and-query": "/services/rest/record/v1/customer",
        "path-input-pointer": "/0/path",
        "body-input-pointer": "/0/body",
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "put": {
      "component": "http-request",
      "interface-version": "0.1.0",
      "operation": "wamn:node/async-handler@0.1.0",
      "params": {
        "requirement": "upstream",
        "method": "PUT",
        "path-and-query": "/services/rest/record/v1/customer",
        "path-input-pointer": "/path",
        "body-input-pointer": "/body",
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "unwrap": {
      "component": "jsonata",
      "interface-version": "0.1.0",
      "operation": "wamn:node/handler@0.1.0",
      "params": {
        "expression": "$[0]"
      }
    }
  },
  "edges": [
    {
      "from": "map",
      "to": "post",
      "from-port": "main"
    },
    {
      "from": "map",
      "to": "unwrap",
      "from-port": "items",
      "to-port": "items"
    },
    {
      "from": "unwrap",
      "to": "put"
    }
  ]
}
