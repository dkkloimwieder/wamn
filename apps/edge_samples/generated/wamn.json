{
  "package": {
    "id": "edge_samples",
    "version": "2.1.0",
    "predecessor_version": "2.0.0"
  },
  "required_platform_policy_contract": {
    "id": "edge_samples_data_access",
    "state": "satisfied"
  },
  "models": {
    "sample": {
      "schema": "edge_samples",
      "table": "sample",
      "owner": "edge_samples",
      "server_owned_fields": [
        "id",
        "created_at"
      ],
      "enum_fields": {},
      "audit_log": {
        "columns": [
          "created_at"
        ],
        "retention": "none"
      },
      "operations": {
        "get": {
          "permission": "sample.get",
          "result": "one"
        }
      }
    }
  },
  "custom_operations": {
    "sample.record": {
      "type": "command",
      "visibility": "public",
      "permission": "sample.record",
      "connection": "postgres",
      "input": {
        "raw_body_maximum": 1048576,
        "envelope": {
          "minimum": 1,
          "maximum": 100
        },
        "fields": [
          {
            "path": "request_id",
            "type": "text",
            "nullable": false
          },
          {
            "path": "value.idempotency_key",
            "type": "text",
            "nullable": false
          },
          {
            "path": "value.frame",
            "type": "text",
            "nullable": false,
            "label": "Frame",
            "description": "The frame that the device sent, without its line ending."
          },
          {
            "path": "value.captured_at",
            "type": "timestamptz",
            "nullable": false,
            "label": "Captured at",
            "description": "When the edge box read the frame."
          }
        ]
      },
      "result": {
        "class": "one",
        "fields": [
          {
            "path": "sample_id",
            "type": "uuid",
            "nullable": false
          }
        ]
      },
      "errors": [
        "invalid_input",
        "idempotency_conflict",
        "retry",
        "timeout",
        "permission_denied",
        "internal_error"
      ],
      "error_details": {
        "idempotency_conflict": {
          "required": [
            "field"
          ]
        }
      },
      "constraint_errors": {},
      "relations": [
        {
          "schema": "edge_samples",
          "table": "sample",
          "select_fields": [
            "id"
          ],
          "insert_fields": [
            "captured_at",
            "frame"
          ],
          "update_fields": [],
          "lock": false,
          "constraints": [
            "sample_id_pkey"
          ]
        }
      ],
      "statements": {
        "record_sample": {
          "path": "command/sample/record.sql",
          "fetch": "one",
          "parameters": [
            {
              "name": "frame",
              "type": "text",
              "nullable": false
            },
            {
              "name": "captured_at",
              "type": "timestamptz",
              "nullable": false
            }
          ],
          "row": [
            {
              "name": "id",
              "type": "uuid",
              "nullable": false
            }
          ]
        }
      },
      "transaction": "explicit_per_input",
      "automatic_retry": false,
      "idempotent_by": "claim",
      "canonicalization": {
        "excluded_fields": [
          "request_id",
          "value.idempotency_key"
        ]
      },
      "label": "Record a sample",
      "description": "One reading that an edge box forwards. The edge sample key is the idempotency key."
    },
    "sample.read": {
      "type": "command",
      "visibility": "public",
      "permission": "sample.read",
      "input": {
        "fields": [
          {
            "path": "request_id",
            "type": "text",
            "nullable": false
          },
          {
            "path": "value.frame",
            "type": "text",
            "nullable": false,
            "label": "Frame",
            "description": "The frame that the device sent, without its line ending."
          },
          {
            "path": "value.captured_at",
            "type": "timestamptz",
            "nullable": false,
            "label": "Captured at",
            "description": "When the edge box read the frame."
          }
        ]
      },
      "result": {
        "class": "one",
        "fields": [
          {
            "path": "frame",
            "type": "text",
            "nullable": false
          },
          {
            "path": "captured_at",
            "type": "timestamptz",
            "nullable": false
          }
        ]
      },
      "errors": [
        "invalid_input",
        "permission_denied",
        "internal_error"
      ],
      "error_details": {},
      "idempotent_by": "stateless",
      "label": "Read a sample",
      "description": "The device operation of an edge box. It turns one frame from the serial device into the sample that the box stores and forwards. It declares no SQL."
    }
  },
  "connections": [
    "postgres"
  ],
  "components": {
    "samples": {
      "connections": [
        "postgres"
      ]
    }
  }
}
