package edge-samples:sample@1.0.0;

interface get {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record get-request {
    id: string,
  }

  record invalid-input-detail {
    field: string,
  }

  record not-found-detail {
    field: string,
    id: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant get-error {
    invalid-input(invalid-input-detail),
    not-found(not-found-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record get-item {
    input: result<get-request, invalid-input-detail>,
  }

  record get-row {
    captured-at: string,
    created-at: string,
    frame: string,
    id: string,
  }

  record get-result {
    value: get-row,
  }

  record get-outcome {
    outcome: result<get-result, get-error>,
  }

  run: async func(ctx: node-context, input: list<get-item>) -> result<list<get-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

interface read {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record read-request {
    captured-at: string,
    frame: string,
  }

  record invalid-input-detail {
    field: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant read-error {
    invalid-input(invalid-input-detail),
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record read-item {
    request-id: string,
    input: result<read-request, invalid-input-detail>,
  }

  record read-result {
    frame: string,
    captured-at: string,
  }

  record read-outcome {
    request-id: string,
    outcome: result<read-result, read-error>,
  }

  run: async func(ctx: node-context, input: list<read-item>) -> result<list<read-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

interface %record {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record %record-request {
    captured-at: string,
    frame: string,
    idempotency-key: string,
  }

  record idempotency-conflict-detail {
    field: string,
  }

  record invalid-input-detail {
    field: string,
    minimum: option<string>,
    maximum: option<string>,
    observed: option<string>,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant %record-error {
    invalid-input(invalid-input-detail),
    idempotency-conflict(idempotency-conflict-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record %record-item {
    request-id: string,
    input: result<%record-request, invalid-input-detail>,
  }

  record %record-result {
    sample-id: string,
  }

  record %record-outcome {
    request-id: string,
    outcome: result<%record-result, %record-error>,
  }

  run: async func(ctx: node-context, input: list<%record-item>) -> result<list<%record-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}
