{
  "name": "@wamn/platform-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm --workspace-root run wfe:build && node ../../web/host-route-clients.mjs && tsc --noEmit",
    "test": "pnpm --workspace-root run wfe:build && node ../../web/host-route-clients.mjs && vitest run",
    "build": "pnpm --workspace-root run wfe:build && node ../../web/host-route-clients.mjs && vite build"
  },
  "wamn": {
    "clients": [
      "wamn_control",
      "wamn_control_org"
    ]
  },
  "dependencies": {
    "@wfe/components": "workspace:*",
    "@wfe/form": "workspace:*",
    "@wfe/generator": "workspace:*",
    "@wfe/shell": "workspace:*",
    "@solidjs/web": "2.0.0-rc.18",
    "solid-js": "2.0.0-rc.18"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@types/d3-shape": "3.1.8",
    "@types/node": "^24.19.1",
    "jsdom": "^30.1.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
