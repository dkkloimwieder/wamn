  "custom_operations": {
    "receiving.record_receipt": {
      "kind": "command",
      "label": "Record a receipt",
      "description": "One submission records every line of one receipt against one purchase order.",
      "visibility": "public",
      "permission": "receiving.record_receipt",
      "connection": "postgres",
      "transaction": "explicit_per_input",
      "automatic_retry": false,
      "idempotent_by": "claim",
      "claim": {
        "table": "record_receipt_command",
        "identities": {
          "receipt_id": "receipt_id"
        },
        "claim": "claim_command",
        "replay": "find_replay",
        "finalize": "finalize_command"
      },
      "pre_commit": {
        "fields": [
          {
            "path": "receipt_id",
            "type": "uuid",
            "nullable": false
          },
          {
            "path": "purchase_order_id",
            "type": "uuid",
            "nullable": false
          }
        ]
      },
      "input": {
        "raw_body_maximum": 1048576,
        "envelope": {
          "minimum": 1,
          "maximum": 100
        },
        "line": {
          "minimum": 1,
          "maximum": 100,
          "label": "Receipt lines",
          "description": "One line for each order line this receipt records."
        },
        "fields": [
          {
            "path": "request_id",
            "type": "text",
            "nullable": false
          },
          {
            "path": "value.idempotency_key",
            "type": "text",
            "nullable": false
          },
          {
            "path": "value.purchase_order_id",
            "type": "uuid",
            "nullable": false,
            "label": "Purchase order",
            "references": {
              "model": "purchase_order"
            }
          },
          {
            "path": "value.receipt_reference",
            "type": "text",
            "nullable": false,
            "label": "Receipt reference"
          },
          {
            "path": "value.occurred_at",
            "type": "timestamptz",
            "nullable": false,
            "label": "Received at"
          },
          {
            "path": "value.line[].purchase_order_line_id",
            "type": "uuid",
            "nullable": false,
            "label": "Order line",
            "references": {
              "model": "purchase_order_line",
              "narrowed_by": "value.purchase_order_id"
            }
          },
          {
            "path": "value.line[].quantity",
            "type": "numeric",
            "nullable": false,
            "label": "Quantity",
            "description": "More than zero, and no more than the quantity the line still has remaining."
          },
          {
            "path": "value.line[].location_id",
            "type": "uuid",
            "nullable": false,
            "label": "Location",
            "references": {
              "model": "location"
            }
          }
        ]
      },
      "result": {
        "class": "one",
        "fields": [
          {
            "path": "receipt_id",
            "type": "uuid",
            "nullable": false,
            "label": "Receipt"
          },
          {
            "path": "purchase_order_id",
            "type": "uuid",
            "nullable": false,
            "label": "Purchase order"
          },
          {
            "path": "purchase_order_status",
            "type": "text",
            "nullable": false,
            "values": [
              "open",
              "complete"
            ],
            "label": "Status"
          },
          {
            "path": "row_version",
            "type": "int32",
            "nullable": false,
            "revision": true,
            "label": "Revision"
          }
        ]
      },
      "canonicalization": {
        "excluded_fields": [
          "request_id",
          "value.idempotency_key"
        ],
        "line_order": {
          "ascending_by": "purchase_order_line_id",
          "positive_member": "quantity"
        }
      },
      "errors": [
        "invalid_input",
        "purchase_order_not_found",
        "purchase_order_not_open",
        "purchase_order_line_not_found",
        "purchase_order_line_mismatch",
        "location_not_found",
        "quantity_exceeds_remaining",
        "receipt_reference_conflict",
        "idempotency_conflict",
        "retry",
        "timeout",
        "permission_denied",
        "internal_error"
      ],
      "error_details": {
        "purchase_order_not_found": {
          "required": [
            "field"
          ]
        },
        "purchase_order_not_open": {
          "required": [
            "field"
          ]
        },
        "purchase_order_line_not_found": {
          "required": [
            "field",
            "id"
          ]
        },
        "purchase_order_line_mismatch": {
          "required": [
            "field",
            "id"
          ]
        },
        "location_not_found": {
          "required": [
            "field",
            "id"
          ]
        },
        "quantity_exceeds_remaining": {
          "required": [
            "field",
            "id"
          ]
        },
        "receipt_reference_conflict": {
          "required": [
            "constraint"
          ]
        },
        "idempotency_conflict": {
          "required": [
            "field"
          ]
        }
      },
      "constraint_errors": {
        "receipt_purchase_order_id_receipt_reference_key": "receipt_reference_conflict"
      },
