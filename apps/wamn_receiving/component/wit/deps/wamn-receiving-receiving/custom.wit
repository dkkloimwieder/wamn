interface load-open-receipt-lines {
  use wamn:node/types@0.1.0.{node-context, node-error, json-value};

  type numeric = string;
  type revision = s32;
  type uuid = string;

  enum purchase-order-status-value {
    open,
    complete,
    cancelled,
  }

  record load-open-receipt-lines-feed {
    cursor: option<string>,
    limit: option<u32>,
  }

  record load-open-receipt-lines-request {
    feed: option<load-open-receipt-lines-feed>,
  }

  record invalid-input-detail {
    field: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant load-open-receipt-lines-error {
    cursor-expired,
    internal-error,
    invalid-input(invalid-input-detail),
    permission-denied(permission-denied-detail),
    retry,
    timeout,
  }

  record load-open-receipt-lines-item {
    input: result<load-open-receipt-lines-request, invalid-input-detail>,
  }

  record load-open-receipt-lines-row {
    purchase-order-id: uuid,
    purchase-order-number: string,
    purchase-order-status: purchase-order-status-value,
    supplier-id: uuid,
    purchase-order-row-version: revision,
    line-id: uuid,
    line-number: s32,
    item-id: uuid,
    item-number: string,
    ordered-quantity: numeric,
    received-quantity: numeric,
    remaining-quantity: numeric,
    row-version: s64,
  }

  record load-open-receipt-lines-page {
    item: list<load-open-receipt-lines-row>,
    next-cursor: option<string>,
    cursor: string,
  }

  record load-open-receipt-lines-change {
    id: string,
    row-version: s64,
    data: option<load-open-receipt-lines-row>,
  }

  record load-open-receipt-lines-changes {
    rows: list<load-open-receipt-lines-change>,
    next-cursor: string,
    complete: bool,
  }

  variant load-open-receipt-lines-result {
    page(load-open-receipt-lines-page),
    changes(load-open-receipt-lines-changes),
  }

  record load-open-receipt-lines-outcome {
    outcome: result<load-open-receipt-lines-result, load-open-receipt-lines-error>,
  }

  run: async func(ctx: node-context, input: list<load-open-receipt-lines-item>) -> result<list<load-open-receipt-lines-outcome>, node-error>;
}

interface load-purchase-order-history {
  use wamn:node/types@0.1.0.{node-context, node-error, json-value};

  type timestamp = string;
  type uuid = string;

  enum type-value {
    insert,
    update,
    delete,
  }

  record load-purchase-order-history-request {
    after-cursor: option<string>,
    id: uuid,
    limit: s32,
  }

  record invalid-input-detail {
    field: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant load-purchase-order-history-error {
    internal-error,
    invalid-input(invalid-input-detail),
    permission-denied(permission-denied-detail),
    retry,
    timeout,
  }

  record load-purchase-order-history-item {
    input: result<load-purchase-order-history-request, invalid-input-detail>,
  }

  record load-purchase-order-history-row {
    id: uuid,
    cursor: string,
    %type: type-value,
    operation: string,
    changed-by: uuid,
    changed-at: timestamp,
    before: string,
    after: string,
    current: string,
  }

  record load-purchase-order-history-result {
    rows: list<load-purchase-order-history-row>,
  }

  record load-purchase-order-history-outcome {
    outcome: result<load-purchase-order-history-result, load-purchase-order-history-error>,
  }

  run: async func(ctx: node-context, input: list<load-purchase-order-history-item>) -> result<list<load-purchase-order-history-outcome>, node-error>;
}

