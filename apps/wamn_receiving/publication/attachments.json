    "component": "receiving",
    "operation": "wamn-receiving:receiving/record-receipt@1.0.0",
    "definition-hash": "sha256:496de6b67604e420aaf924fea7b686ae817aa9954b7fcfa5b80f69d08544a825",
    "definition": {
      "id": "receiving-record-receipt-http",
      "kind": "http",
