{
  "receiving-record-receipt-http": {
    "kind": "http",
    "package-id": "wamn_receiving",
    "component": "receiving",
    "operation": "wamn-receiving:receiving/record-receipt",
    "definition-hash": "sha256:f6d4f629c6b9191c3ff89307333341c80f61707e71dbdc77d055aaba326299ee",
    "definition": {
      "id": "receiving-record-receipt-http",
      "kind": "http",
      "route": {
        "path": "/receiving/record_receipt"
      },
      "raw-body-bytes": {
        "maximum": 1048576
      },
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "request_id",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "object",
              "required": [
                "idempotency_key",
                "purchase_order_id",
                "receipt_reference",
                "occurred_at",
                "line"
              ],
              "additionalProperties": false,
              "properties": {
                "idempotency_key": {
                  "type": "string",
                  "minLength": 1
                },
                "purchase_order_id": {
                  "type": "string"
                },
                "receipt_reference": {
                  "type": "string",
                  "minLength": 1
                },
                "occurred_at": {
                  "type": "string"
                },
                "line": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "required": [
                      "purchase_order_line_id",
                      "quantity",
                      "location_id"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "purchase_order_line_id": {
                        "type": "string"
                      },
                      "quantity": {
                        "type": "string"
                      },
                      "location_id": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "auth-policy": {
      "modes": ["pat", "session"]
    },
    "registered-operation": "wamn-receiving:receiving/record-receipt"
  },
