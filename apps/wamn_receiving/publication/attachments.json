{
  "receiving-record-receipt-http": {
    "type": "http",
    "package-id": "wamn_receiving",
    "component": "receiving",
    "operation": "wamn-receiving:receiving/record-receipt",
    "definition-hash": "sha256:3378e6f031f08ecb2c91ef8c1ca49754b1761405eb84811a61b2927d4deea2bb",
    "definition": {
      "id": "receiving-record-receipt-http",
      "type": "http",
      "route": {
        "path": "/receiving/record_receipt"
      },
      "raw-body-bytes": {
        "maximum": 1048576
      },
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "request_id",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "object",
              "required": [
                "idempotency_key",
                "purchase_order_id",
                "receipt_reference",
                "occurred_at",
                "line"
              ],
              "additionalProperties": false,
              "properties": {
                "idempotency_key": {
                  "type": "string",
                  "minLength": 1
                },
                "purchase_order_id": {
                  "type": "string"
                },
                "receipt_reference": {
                  "type": "string",
                  "minLength": 1
                },
                "occurred_at": {
                  "type": "string"
                },
                "line": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "required": [
                      "purchase_order_line_id",
                      "quantity",
                      "location_id"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "purchase_order_line_id": {
                        "type": "string"
                      },
                      "quantity": {
                        "type": "string"
                      },
                      "location_id": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "auth-policy": {
      "modes": ["pat", "session"]
    },
    "registered-operation": "wamn-receiving:receiving/record-receipt"
  },
