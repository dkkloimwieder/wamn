                "purchase_order_id",
                "receipt_reference",
                "occurred_at",
                "line"
              ],
              "additionalProperties": false,
              "properties": {
                "idempotency_key": {
                  "type": "string",
                  "minLength": 1
                },
                "purchase_order_id": {
                  "type": "string"
                },
                "receipt_reference": {
                  "type": "string",
                  "minLength": 1
                },
                "occurred_at": {
                  "type": "string"
                },
                "line": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "required": [
                      "purchase_order_line_id",
                      "quantity",
                      "location_id"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "purchase_order_line_id": {
                        "type": "string"
                      },
                      "quantity": {
                        "type": "string"
                      },
                      "location_id": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
