package wamn-receiving:supplier@1.0.0;

interface query {
  use wamn:node/types@0.1.0.{node-context, node-error};

  record query-request {
    cursor: option<string>,
    limit: option<s64>,
  }

  record invalid-input-detail {
    field: string,
    minimum: option<string>,
    maximum: option<string>,
    observed: option<string>,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant query-error {
    invalid-input(invalid-input-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record query-row {
    created-at: string,
    id: string,
    name: string,
  }

  /// The record after the last row. A cursor means more rows follow.
  record query-end {
    next-cursor: option<string>,
  }

  run: async func(ctx: node-context, input: query-request) -> result<tuple<stream<query-row>, future<result<query-end, query-error>>>, node-error>;
  /// Each row as one JSON object, then the outcome as one JSON value.
  run-json: async func(ctx: node-context, input: string) -> result<tuple<stream<string>, future<string>>, node-error>;
}

interface create {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record create-request {
    idempotency-key: string,
    name: option<option<string>>,
  }

  record invalid-input-detail {
    field: string,
  }

  record idempotency-conflict-detail {
    field: string,
  }

  record unique-violation-detail {
    constraint: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant create-error {
    invalid-input(invalid-input-detail),
    idempotency-conflict(idempotency-conflict-detail),
    unique-violation(unique-violation-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record create-item {
    request-id: string,
    input: result<create-request, invalid-input-detail>,
  }

  record create-row {
    created-at: string,
    id: string,
    name: string,
  }

  record create-result {
    value: create-row,
  }

  record create-outcome {
    request-id: string,
    outcome: result<create-result, create-error>,
  }

  run: async func(ctx: node-context, input: list<create-item>) -> result<list<create-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

