package wamn-receiving:receiving@1.0.0;

interface load-purchase-order-history {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record load-purchase-order-history-request {
    after-cursor: option<string>,
    id: string,
    limit: s32,
  }

  record invalid-input-detail {
    field: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant load-purchase-order-history-error {
    invalid-input(invalid-input-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record load-purchase-order-history-item {
    input: result<load-purchase-order-history-request, invalid-input-detail>,
  }

  record load-purchase-order-history-row {
    cursor: string,
    kind: string,
    operation: string,
    changed-by: string,
    changed-at: string,
    before: string,
    after: string,
    current: string,
  }

  record load-purchase-order-history-result {
    rows: list<load-purchase-order-history-row>,
  }

  record load-purchase-order-history-outcome {
    outcome: result<load-purchase-order-history-result, load-purchase-order-history-error>,
  }

  run: async func(ctx: node-context, input: list<load-purchase-order-history-item>) -> result<list<load-purchase-order-history-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

interface load-receipt-screen {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record load-receipt-screen-request {
    purchase-order-id: string,
  }

  record invalid-input-detail {
    field: string,
  }

  record not-found-detail {
    field: string,
    id: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant load-receipt-screen-error {
    invalid-input(invalid-input-detail),
    not-found(not-found-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record load-receipt-screen-item {
    input: result<load-receipt-screen-request, invalid-input-detail>,
  }

  record load-receipt-screen-row {
    purchase-order-id: string,
    purchase-order-number: string,
    purchase-order-status: string,
    supplier-id: string,
    row-version: s32,
    line-id: option<string>,
    line-number: option<s32>,
    item-id: option<string>,
    item-number: option<string>,
    ordered-quantity: option<string>,
    received-quantity: option<string>,
    remaining-quantity: option<string>,
  }

  record load-receipt-screen-result {
    rows: list<load-receipt-screen-row>,
  }

  record load-receipt-screen-outcome {
    outcome: result<load-receipt-screen-result, load-receipt-screen-error>,
  }

  run: async func(ctx: node-context, input: list<load-receipt-screen-item>) -> result<list<load-receipt-screen-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

interface record-receipt {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record record-receipt-line {
    location-id: string,
    purchase-order-line-id: string,
    quantity: string,
  }

  record record-receipt-request {
    idempotency-key: string,
    line: list<record-receipt-line>,
    occurred-at: string,
    purchase-order-id: string,
    receipt-reference: string,
  }

  record idempotency-conflict-detail {
    field: string,
  }

  record invalid-input-detail {
    field: string,
    minimum: option<s64>,
    maximum: option<s64>,
    observed: option<s64>,
  }

  record location-not-found-detail {
    field: string,
    id: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  record purchase-order-line-mismatch-detail {
    field: string,
    id: string,
  }

  record purchase-order-line-not-found-detail {
    field: string,
    id: string,
  }

  record purchase-order-not-found-detail {
    field: string,
  }

  record purchase-order-not-open-detail {
    field: string,
  }

  record quantity-exceeds-remaining-detail {
    field: string,
    id: string,
  }

  record receipt-reference-conflict-detail {
    constraint: string,
  }

  variant record-receipt-error {
    invalid-input(invalid-input-detail),
    purchase-order-not-found(purchase-order-not-found-detail),
    purchase-order-not-open(purchase-order-not-open-detail),
    purchase-order-line-not-found(purchase-order-line-not-found-detail),
    purchase-order-line-mismatch(purchase-order-line-mismatch-detail),
    location-not-found(location-not-found-detail),
    quantity-exceeds-remaining(quantity-exceeds-remaining-detail),
    receipt-reference-conflict(receipt-reference-conflict-detail),
    idempotency-conflict(idempotency-conflict-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record record-receipt-item {
    request-id: string,
    input: result<record-receipt-request, invalid-input-detail>,
  }

  record record-receipt-result {
    receipt-id: string,
    purchase-order-id: string,
    purchase-order-status: string,
    row-version: s32,
  }

  record record-receipt-outcome {
    request-id: string,
    outcome: result<record-receipt-result, record-receipt-error>,
  }

  run: async func(ctx: node-context, input: list<record-receipt-item>) -> result<list<record-receipt-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}


interface record-receipt-pre-commit {
  use wamn:node/types@0.1.0.{node-context, node-error};

  record record-receipt-pre-commit-request {
    purchase-order-id: string,
    receipt-id: string,
  }

  run: async func(ctx: node-context, input: record-receipt-pre-commit-request) -> result<record-receipt-pre-commit-request, node-error>;
}
