{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@wamn/web-runtime": ["../../../web/runtime/src/index.ts"],
      "@wamn/ui": ["../../../web/ui/src/index.ts"],
      "@wamn/shell": ["../../../web/shell/src/index.ts"],
      "@wamn/receiving-client/*": ["../generated/client-ts/*"],
      "solid-js": ["./node_modules/solid-js"],
      "solid-js/*": ["./node_modules/solid-js/*"],
      "@solidjs/router": ["./node_modules/@solidjs/router"],
      "@tanstack/solid-table": ["./node_modules/@tanstack/solid-table"],
      "@tanstack/solid-form": ["./node_modules/@tanstack/solid-form"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
