{
  "name": "@wamn/receiving-web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ../../../web/host-route-clients.mjs && vite",
    "build": "pnpm --workspace-root run wfe:build && node ../../../web/host-route-clients.mjs && vite build",
    "check": "pnpm --workspace-root run wfe:build && node ../../../web/host-route-clients.mjs && tsc --project tsconfig.json",
    "test": "pnpm --workspace-root run wfe:build && node ../../../web/host-route-clients.mjs && vitest run"
  },
  "wamn": {
    "clients": [
      "wamn_receiving"
    ]
  },
  "dependencies": {
    "@wamn/web-runtime": "workspace:*",
    "@wfe/sync": "workspace:*",
    "@wfe/components": "workspace:*",
    "@wfe/form": "workspace:*",
    "@wfe/generator": "workspace:*",
    "@solidjs/web": "2.0.0-rc.18",
    "solid-js": "2.0.0-rc.18"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@types/d3-shape": "3.1.8",
    "@types/node": "^24.19.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
