  "query": "SELECT\n    model.code,\n    model.created_at,\n    model.id,\n    model.lifecycle,\n    model.location_id,\n    model.row_version,\n    model.type\nFROM packaging AS model\nWHERE\n    ($1::timestamptz IS NULL OR model.created_at > $1::timestamptz\n        OR (model.created_at = $1::timestamptz AND model.id > $2::uuid))\nORDER BY model.created_at ASC, model.id ASC\nLIMIT $3::int8;\n",
