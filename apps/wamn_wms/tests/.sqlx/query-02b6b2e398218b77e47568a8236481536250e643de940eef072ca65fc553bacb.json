{
  "db_name": "PostgreSQL",
  "query": "SELECT\n    model.created_at,\n    model.disposition,\n    model.id,\n    model.lifecycle,\n    model.location_id,\n    model.packaging_id,\n    model.product_id,\n    model.quantity,\n    model.row_version\nFROM inventory AS model\nWHERE\n    ($1::timestamptz IS NULL OR model.created_at > $1::timestamptz\n        OR (model.created_at = $1::timestamptz AND model.id > $2::uuid))\nORDER BY model.created_at ASC, model.id ASC\nLIMIT $3::int8;\n",
