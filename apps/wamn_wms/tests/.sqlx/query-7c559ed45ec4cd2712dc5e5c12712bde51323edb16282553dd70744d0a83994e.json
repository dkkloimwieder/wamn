  "query": "SELECT\n    claim.canonical_command,\n    model.created_at,\n    model.id,\n    model.product_code,\n    model.row_version\nFROM product_command AS claim\nJOIN product AS model\n    ON model.id = claim.product_id\nWHERE claim.idempotency_key = $1::text;\n",
