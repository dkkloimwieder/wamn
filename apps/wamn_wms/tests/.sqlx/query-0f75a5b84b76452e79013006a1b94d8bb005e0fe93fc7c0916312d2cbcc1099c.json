  "query": "SELECT\n    claim.canonical_command,\n    model.created_at,\n    model.created_by,\n    model.id,\n    model.location_id,\n    model.pallet_code,\n    model.row_version,\n    model.status,\n    model.updated_at,\n    model.updated_by\nFROM pallet_command AS claim\nJOIN pallet AS model\n    ON model.id = claim.pallet_id\nWHERE claim.idempotency_key = $1::text;\n",
