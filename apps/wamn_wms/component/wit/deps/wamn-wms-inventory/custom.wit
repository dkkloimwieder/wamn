interface split {
  use wamn:node/types@0.1.0.{node-context, node-error, json-value};

  type numeric = string;
  type revision = s32;
  type timestamp = string;
  type uuid = string;

  enum new-packaging-type-value {
    pallet,
    tote,
    bin,
    case,
    loose,
  }

  enum source-status-value {
    available,
    held,
    consumed,
  }

  enum status-value {
    available,
    held,
  }

  record split-request {
    expected-row-version: revision,
    idempotency-key: string,
    new-packaging-code: string,
    new-packaging-type: new-packaging-type-value,
    occurred-at: timestamp,
    product-id: uuid,
    quantity: numeric,
    source-packaging-id: uuid,
    status: status-value,
    to-location-id: uuid,
  }

  record concurrency-conflict-detail {
    expected-row-version: s32,
    observed-row-version: s32,
  }

  record idempotency-conflict-detail {
    field: string,
  }

  record insufficient-quantity-detail {
    field: string,
    maximum: option<string>,
    observed: option<string>,
  }

  record invalid-input-detail {
    field: string,
    minimum: option<string>,
    maximum: option<string>,
    observed: option<string>,
  }

  record location-not-found-detail {
    field: string,
    id: string,
  }

  record packaging-not-found-detail {
    field: string,
    id: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  record quantity-not-found-detail {
    field: string,
    id: string,
  }

  variant split-error {
    concurrency-conflict(concurrency-conflict-detail),
    idempotency-conflict(idempotency-conflict-detail),
    insufficient-quantity(insufficient-quantity-detail),
    internal-error,
    invalid-input(invalid-input-detail),
    location-not-found(location-not-found-detail),
    packaging-not-found(packaging-not-found-detail),
    permission-denied(permission-denied-detail),
    quantity-not-found(quantity-not-found-detail),
    retry,
    timeout,
  }

  record split-item {
    request-id: string,
    input: result<split-request, invalid-input-detail>,
  }

  record split-result {
    transaction-ids: list<uuid>,
    source-packaging-id: uuid,
    new-packaging-id: uuid,
    source-status: source-status-value,
    row-version: revision,
  }

  record split-outcome {
    request-id: string,
    outcome: result<split-result, split-error>,
  }

  run: async func(ctx: node-context, input: list<split-item>) -> result<list<split-outcome>, node-error>;
}
