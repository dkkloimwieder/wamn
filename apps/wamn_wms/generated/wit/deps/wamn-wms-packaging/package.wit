package wamn-wms:packaging@1.0.0;

interface get {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record get-request {
    id: string,
  }

  record invalid-input-detail {
    field: string,
  }

  record not-found-detail {
    field: string,
    id: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant get-error {
    invalid-input(invalid-input-detail),
    not-found(not-found-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record get-item {
    input: result<get-request, invalid-input-detail>,
  }

  record get-row {
    code: string,
    created-at: string,
    id: string,
    lifecycle: string,
    location-id: string,
    row-version: s32,
    %type: string,
  }

  record get-result {
    value: get-row,
  }

  record get-outcome {
    outcome: result<get-result, get-error>,
  }

  run: async func(ctx: node-context, input: list<get-item>) -> result<list<get-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

interface query {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record query-request {
    cursor: option<string>,
    limit: option<s64>,
  }

  record invalid-input-detail {
    field: string,
    minimum: option<s64>,
    maximum: option<s64>,
    observed: option<s64>,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant query-error {
    invalid-input(invalid-input-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record query-item {
    input: result<query-request, invalid-input-detail>,
  }

  record query-row {
    code: string,
    created-at: string,
    id: string,
    lifecycle: string,
    location-id: string,
    row-version: s32,
    %type: string,
  }

  record query-result {
    value: list<query-row>,
    next-cursor: option<string>,
  }

  record query-outcome {
    outcome: result<query-result, query-error>,
  }

  run: async func(ctx: node-context, input: list<query-item>) -> result<list<query-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

interface close {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record close-request {
    expected-row-version: s32,
    idempotency-key: string,
    packaging-id: string,
  }

  record concurrency-conflict-detail {
    expected-row-version: s32,
    observed-row-version: s32,
  }

  record idempotency-conflict-detail {
    field: string,
  }

  record invalid-input-detail {
    field: string,
    minimum: option<s64>,
    maximum: option<s64>,
    observed: option<s64>,
  }

  record not-found-detail {
    field: string,
    id: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant close-error {
    invalid-input(invalid-input-detail),
    not-found(not-found-detail),
    concurrency-conflict(concurrency-conflict-detail),
    idempotency-conflict(idempotency-conflict-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record close-item {
    request-id: string,
    input: result<close-request, invalid-input-detail>,
  }

  record close-result {
    operation-id: string,
    packaging-id: string,
    %type: string,
    code: string,
    location-id: string,
    lifecycle: string,
    row-version: s32,
  }

  record close-outcome {
    request-id: string,
    outcome: result<close-result, close-error>,
  }

  run: async func(ctx: node-context, input: list<close-item>) -> result<list<close-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

