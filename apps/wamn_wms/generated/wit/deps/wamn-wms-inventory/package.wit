package wamn-wms:inventory@1.0.0;

interface get {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record get-request {
    id: string,
  }

  record invalid-input-detail {
    field: string,
  }

  record not-found-detail {
    field: string,
    id: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant get-error {
    invalid-input(invalid-input-detail),
    not-found(not-found-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record get-item {
    input: result<get-request, invalid-input-detail>,
  }

  record get-row {
    created-at: string,
    disposition: string,
    id: string,
    lifecycle: string,
    location-id: string,
    packaging-id: string,
    product-id: string,
    quantity: string,
    row-version: s32,
  }

  record get-result {
    value: get-row,
  }

  record get-outcome {
    outcome: result<get-result, get-error>,
  }

  run: async func(ctx: node-context, input: list<get-item>) -> result<list<get-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

interface query {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record query-request {
    cursor: option<string>,
    limit: option<s64>,
  }

  record invalid-input-detail {
    field: string,
    minimum: option<s64>,
    maximum: option<s64>,
    observed: option<s64>,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant query-error {
    invalid-input(invalid-input-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record query-item {
    input: result<query-request, invalid-input-detail>,
  }

  record query-row {
    created-at: string,
    disposition: string,
    id: string,
    lifecycle: string,
    location-id: string,
    packaging-id: string,
    product-id: string,
    quantity: string,
    row-version: s32,
  }

  record query-result {
    value: list<query-row>,
    next-cursor: option<string>,
  }

  record query-outcome {
    outcome: result<query-result, query-error>,
  }

  run: async func(ctx: node-context, input: list<query-item>) -> result<list<query-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

interface adjust {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record adjust-request {
    expected-row-version: s32,
    idempotency-key: string,
    inventory-id: string,
    occurred-at: string,
    reason: string,
    to-quantity: string,
  }

  record concurrency-conflict-detail {
    expected-row-version: s32,
    observed-row-version: s32,
  }

  record idempotency-conflict-detail {
    field: string,
  }

  record invalid-input-detail {
    field: string,
    minimum: option<s64>,
    maximum: option<s64>,
    observed: option<s64>,
  }

  record not-found-detail {
    field: string,
    id: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant adjust-error {
    invalid-input(invalid-input-detail),
    not-found(not-found-detail),
    concurrency-conflict(concurrency-conflict-detail),
    idempotency-conflict(idempotency-conflict-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record adjust-item {
    request-id: string,
    input: result<adjust-request, invalid-input-detail>,
  }

  record adjust-result {
    operation-id: string,
    inventory-id: string,
    product-id: string,
    packaging-id: string,
    location-id: string,
    quantity: string,
    disposition: string,
    lifecycle: string,
    row-version: s32,
  }

  record adjust-outcome {
    request-id: string,
    outcome: result<adjust-result, adjust-error>,
  }

  run: async func(ctx: node-context, input: list<adjust-item>) -> result<list<adjust-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

interface aggregate {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  enum aggregate-request { request }

  record invalid-input-detail {
    field: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant aggregate-error {
    invalid-input(invalid-input-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record aggregate-item {
    input: result<aggregate-request, invalid-input-detail>,
  }

  record aggregate-row {
    product-id: string,
    location-id: string,
    disposition: string,
    quantity: string,
    packaging-count: s32,
  }

  record aggregate-result {
    rows: list<aggregate-row>,
  }

  record aggregate-outcome {
    outcome: result<aggregate-result, aggregate-error>,
  }

  run: async func(ctx: node-context, input: list<aggregate-item>) -> result<list<aggregate-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

