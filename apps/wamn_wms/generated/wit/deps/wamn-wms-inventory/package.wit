package wamn-wms:inventory@1.0.0;

interface adjust {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record adjust-request {
    expected-row-version: s32,
    idempotency-key: string,
    occurred-at: string,
    packaging-id: string,
    product-id: string,
    quantity: string,
    reason-code: string,
    status: string,
  }

  record concurrency-conflict-detail {
    expected-row-version: s32,
    observed-row-version: s32,
  }

  record idempotency-conflict-detail {
    field: string,
  }

  record invalid-input-detail {
    field: string,
    minimum: option<string>,
    maximum: option<string>,
    observed: option<string>,
  }

  record packaging-not-found-detail {
    field: string,
    id: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  record quantity-not-found-detail {
    field: string,
    id: string,
  }

  variant adjust-error {
    invalid-input(invalid-input-detail),
    packaging-not-found(packaging-not-found-detail),
    quantity-not-found(quantity-not-found-detail),
    concurrency-conflict(concurrency-conflict-detail),
    idempotency-conflict(idempotency-conflict-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record adjust-item {
    request-id: string,
    input: result<adjust-request, invalid-input-detail>,
  }

  record adjust-result {
    transaction-ids: list<string>,
    packaging-id: string,
    adjusted-quantity: string,
    packaging-status: string,
    row-version: s32,
  }

  record adjust-outcome {
    request-id: string,
    outcome: result<adjust-result, adjust-error>,
  }

  run: async func(ctx: node-context, input: list<adjust-item>) -> result<list<adjust-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

interface aggregate {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  enum aggregate-request { request }

  record invalid-input-detail {
    field: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant aggregate-error {
    invalid-input(invalid-input-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record aggregate-item {
    input: result<aggregate-request, invalid-input-detail>,
  }

  record aggregate-row {
    product-id: string,
    location-id: string,
    status: string,
    quantity: string,
    packaging-count: s32,
  }

  record aggregate-result {
    rows: list<aggregate-row>,
  }

  record aggregate-outcome {
    outcome: result<aggregate-result, aggregate-error>,
  }

  run: async func(ctx: node-context, input: list<aggregate-item>) -> result<list<aggregate-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

