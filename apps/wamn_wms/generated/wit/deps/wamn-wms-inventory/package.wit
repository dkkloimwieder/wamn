interface split {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record split-request {
    expected-row-version: s32,
    from-inventory-id: string,
    idempotency-key: string,
    occurred-at: string,
    quantity: string,
    to-location-id: string,
    to-packaging-id: string,
  }

  record concurrency-conflict-detail {
    expected-row-version: s32,
    observed-row-version: s32,
  }

  record idempotency-conflict-detail {
    field: string,
  }

  record insufficient-quantity-detail {
    field: string,
  }

  record invalid-input-detail {
    field: string,
    minimum: option<s64>,
    maximum: option<s64>,
    observed: option<s64>,
  }

  record not-found-detail {
    field: string,
    id: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant split-error {
    invalid-input(invalid-input-detail),
    not-found(not-found-detail),
    concurrency-conflict(concurrency-conflict-detail),
    idempotency-conflict(idempotency-conflict-detail),
    insufficient-quantity(insufficient-quantity-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record split-item {
    request-id: string,
    input: result<split-request, invalid-input-detail>,
  }

  record split-result {
    operation-id: string,
    inventory-id: string,
    product-id: string,
    packaging-id: string,
    location-id: string,
    quantity: string,
    disposition: string,
    lifecycle: string,
    row-version: s32,
    new-inventory-id: string,
  }

  record split-outcome {
    request-id: string,
    outcome: result<split-result, split-error>,
  }

  run: async func(ctx: node-context, input: list<split-item>) -> result<list<split-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}
