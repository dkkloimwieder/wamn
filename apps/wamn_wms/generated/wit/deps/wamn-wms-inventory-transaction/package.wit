package wamn-wms:inventory-transaction@1.0.0;

interface get {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record get-request {
    id: string,
  }

  record invalid-input-detail {
    field: string,
  }

  record not-found-detail {
    field: string,
    id: string,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant get-error {
    invalid-input(invalid-input-detail),
    not-found(not-found-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record get-item {
    input: result<get-request, invalid-input-detail>,
  }

  record get-row {
    created-at: string,
    from-disposition: option<string>,
    from-inventory-id: string,
    from-lifecycle: option<string>,
    from-location-id: option<string>,
    from-packaging-id: option<string>,
    from-product-id: option<string>,
    from-quantity: string,
    id: string,
    inventory-id: string,
    occurred-at: string,
    operation-id: string,
    reason: option<string>,
    to-disposition: string,
    to-inventory-id: string,
    to-lifecycle: string,
    to-location-id: string,
    to-packaging-id: string,
    to-product-id: string,
    to-quantity: string,
    %type: string,
  }

  record get-result {
    value: get-row,
  }

  record get-outcome {
    outcome: result<get-result, get-error>,
  }

  run: async func(ctx: node-context, input: list<get-item>) -> result<list<get-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

interface query {
  use wamn:node/types@0.1.0.{emission, node-context, node-error};

  record query-request {
    cursor: option<string>,
    limit: option<s64>,
  }

  record invalid-input-detail {
    field: string,
    minimum: option<s64>,
    maximum: option<s64>,
    observed: option<s64>,
  }

  record permission-denied-detail {
    operation: string,
  }

  variant query-error {
    invalid-input(invalid-input-detail),
    retry,
    timeout,
    permission-denied(permission-denied-detail),
    internal-error,
  }

  record query-item {
    input: result<query-request, invalid-input-detail>,
  }

  record query-row {
    created-at: string,
    from-disposition: option<string>,
    from-inventory-id: string,
    from-lifecycle: option<string>,
    from-location-id: option<string>,
    from-packaging-id: option<string>,
    from-product-id: option<string>,
    from-quantity: string,
    id: string,
    inventory-id: string,
    occurred-at: string,
    operation-id: string,
    reason: option<string>,
    to-disposition: string,
    to-inventory-id: string,
    to-lifecycle: string,
    to-location-id: string,
    to-packaging-id: string,
    to-product-id: string,
    to-quantity: string,
    %type: string,
  }

  record query-result {
    value: list<query-row>,
    next-cursor: option<string>,
  }

  record query-outcome {
    outcome: result<query-result, query-error>,
  }

  run: async func(ctx: node-context, input: list<query-item>) -> result<list<query-outcome>, node-error>;
  run-json: async func(ctx: node-context, input: string) -> result<emission, node-error>;
}

