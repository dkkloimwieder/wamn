{
  "format-version": "0.1",
  "wiring-id": "inventory_move_and_label",
  "version": 2,
  "entry": "shape",
  "nodes": {
    "shape": {
      "component": "jsonata",
      "interface-version": "0.1.0",
      "operation": "wamn:node/handler@0.1.0",
      "params": {
        "expression": "event = \"insert\" and new.kind = \"move\" ? [{\"request_id\": new.id, \"value\": {\"label_key\": new.idempotency_key, \"movement_id\": new.id, \"pallet_id\": new.pallet_id, \"location_id\": new.to_location_id}}] : []",
        "port": "items"
      }
    },
    "label": {
      "component": "label-render",
      "interface-version": "0.1.0",
      "operation": "wamn:node/handler@0.1.0",
      "params": {
        "template_id": "pallet"
      }
    },
    "store": {
      "component": "blob-put",
      "interface-version": "0.1.0",
      "operation": "wamn:node/async-handler@0.1.0",
      "params": {
        "store_alias": "labels",
        "key_field": "/label_key",
        "body_field": "/zpl"
      }
    }
  },
  "edges": [
    {
      "from": "shape",
      "from-port": "items",
      "to": "label"
    },
    {
      "from": "label",
      "to": "store"
    }
  ]
}
