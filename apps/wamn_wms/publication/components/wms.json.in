    "wamn-wms:inventory/move@1.0.0": {
      "registered-operation": "wamn-wms:inventory/move@1.0.0",
      "input-ports": [
        {
          "name": "input",
          "schema": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "request_id",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "request_id": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "object",
                  "required": [
                    "idempotency_key",
                    "inventory_id",
                    "to_packaging_id",
                    "to_location_id",
                    "expected_row_version",
                    "occurred_at"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "idempotency_key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "inventory_id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "to_packaging_id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "to_location_id": {
