        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "request_id",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "object",
              "required": [
                "idempotency_key",
                "pallet_id",
                "to_location_id",
                "expected_row_version",
                "occurred_at"
              ],
              "additionalProperties": false,
              "properties": {
                "idempotency_key": {
                  "type": "string",
                  "minLength": 1
                },
                "pallet_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "to_location_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "expected_row_version": {
                  "type": "integer"
                },
                "occurred_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    },
    "auth-policy": {
      "modes": ["pat", "session"]
    },
    "registered-operation": "wamn-wms:inventory/move@1.0.0"
  },
