{
  "inventory-move-http": {
    "type": "http",
    "package-id": "wamn_wms",
    "component": "wms",
    "operation": "wamn-wms:inventory/move",
    "definition-hash": "sha256:82e6b142d8f02ddb53eb3352fb8bf1e795602655a9c8cb83b2663dee008c9301",
    "definition": {
      "id": "inventory-move-http",
      "type": "http",
      "route": {
        "path": "/inventory/move"
      },
      "raw-body-bytes": {
        "maximum": 1048576
      },
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "request_id",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "object",
              "required": [
                "idempotency_key",
                "packaging_id",
                "to_location_id",
                "expected_row_version",
                "occurred_at"
              ],
              "additionalProperties": false,
              "properties": {
                "idempotency_key": {
                  "type": "string",
                  "minLength": 1
                },
                "packaging_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "to_location_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "expected_row_version": {
                  "type": "integer"
                },
                "occurred_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    },
    "auth-policy": {
      "modes": ["pat", "session"]
    },
    "registered-operation": "wamn-wms:inventory/move"
  },
