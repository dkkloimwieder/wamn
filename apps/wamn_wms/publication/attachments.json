  "pallet-query-http": {
    "kind": "http",
    "package-id": "wamn_wms",
    "wiring-id": "pallet_query",
    "wiring-version": 1,
    "definition-hash": "sha256:64d3d2b566b79b0661128d54ecc7472de52f445f7cf16032cb988966faa70e0e",
    "definition": {
      "id": "pallet-query-http",
      "kind": "http",
      "route": {
        "path": "/pallet/query",
        "method": "POST"
      },
      "raw-body-bytes": {
        "maximum": 1048576
      },
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "request_id"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "filter": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "available",
                      "held",
                      "consumed"
                    ]
                  }
                },
                "location_id": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "pallet_code": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "sort": {
              "type": "object",
              "required": [
                "field",
                "direction"
              ],
              "additionalProperties": false,
              "properties": {
                "field": {
                  "enum": [
                    "pallet_code",
                    "location_id",
                    "updated_at",
                    "created_at"
                  ]
                },
                "direction": {
                  "enum": [
                    "ascending",
                    "descending"
                  ]
                }
              }
            },
            "cursor": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    },
    "auth-policy": {
      "modes": ["pat"]
    },
    "registered-operation": "wamn-wms:pallet/query@1.0.0"
  },
  "inventory-move-http": {
    "kind": "http",
    "package-id": "wamn_wms",
