{
  "inventory-move-http": {
    "kind": "http",
    "package-id": "wamn_wms",
    "component": "wms",
    "operation": "wamn-wms:inventory/move@1.0.0",
    "definition-hash": "sha256:94d5db8cfee9e72c6e0022021af46102836d139305677285f6a4119c14958d66",
    "definition": {
      "id": "inventory-move-http",
      "kind": "http",
      "route": {
        "path": "/inventory/move"
      },
      "raw-body-bytes": {
        "maximum": 1048576
      },
      "input-schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "request_id",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "object",
              "required": [
                "idempotency_key",
                "packaging_id",
                "to_location_id",
                "expected_row_version",
                "occurred_at"
              ],
              "additionalProperties": false,
              "properties": {
                "idempotency_key": {
                  "type": "string",
                  "minLength": 1
                },
                "packaging_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "to_location_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "expected_row_version": {
                  "type": "integer"
                },
                "occurred_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    },
    "auth-policy": {
      "modes": ["pat", "session"]
    },
    "registered-operation": "wamn-wms:inventory/move@1.0.0"
  },
