package wamn:jetstream@0.1.0;

/// Host-owned registration provisioning and the retained scheduler hint.
/// Native wasmcloud:nats owns materializer delivery and settlement.
interface types {
  variant js-error {
    connection-unavailable,
    not-found(string),
    other(string),
  }
}

interface registration {
  use types.{js-error};

  record consumer-config {
    stream-name: string,
    durable: string,
    filter-subject: string,
    ack-wait-ms: u64,
    max-deliver: u32,
  }

  /// Create the admitted registration consumer or refuse configuration drift.
  prepare: func(package-id: string, registration-id: string, config: consumer-config) -> result<_, js-error>;
}

interface doorbell {
  use types.{js-error};

  /// Ring the caller's tenant doorbell with one run id (the enqueued run),
  /// strictly AFTER the enqueue transaction committed — a hint for uncommitted
  /// work would wake a runner into an empty claim.
  ring: func(run-id: string) -> result<_, js-error>;
}
