{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "kind",
        "gcp"
      ]
    },
    "traefik": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "platformDomain": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
      "description": "Base for wildcard TLS and the email domain for platform principals."
    },
    "registry": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.:-]*(/[a-z0-9][a-z0-9._-]*)*$"
    },
    "registryEndpoint": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "addressType": {
              "type": "string",
              "enum": [
                "IPv4",
                "IPv6",
                "FQDN"
              ]
            },
            "port": {
              "$ref": "#/definitions/port"
            },
            "address": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "addressType",
            "port",
            "address"
          ]
        }
      ]
    },
    "registryEgress": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cidr": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "$ref": "#/definitions/port"
          }
        },
        "required": ["cidr", "port"]
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxProjects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "Project streams across all environments. JetStream reserves 320 MiB per project per pod."
        },
        "identityIssuer": {
          "const": "https://identity.platform.svc.cluster.local"
        },
        "nats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schedulerUrl": {
              "const": "nats://wamn-nats.platform.svc.cluster.local:4222"
            }
          },
          "required": ["schedulerUrl"]
        }
      },
      "required": [
        "maxProjects",
        "identityIssuer",
        "nats"
      ]
    },
    "gcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusterName": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$|^[a-z]$"
        },
        "projectId": {
          "$ref": "#/definitions/projectId"
        },
        "zone": {
          "type": "string",
          "pattern": "^[a-z]+-[a-z]+[0-9]+-[a-z]$"
        },
        "buckets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "web": {
              "$ref": "#/definitions/bucket"
            },
            "otel": {
              "$ref": "#/definitions/bucket"
            },
            "state": {
              "$ref": "#/definitions/bucket"
            }
          },
          "required": [
            "web",
            "otel",
            "state"
          ]
        }
      },
      "required": [
        "clusterName",
        "projectId",
        "zone",
        "buckets"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string"
        },
        "oauthEncryption": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "local",
                "gcp"
              ]
            },
            "project": {
              "$ref": "#/definitions/projectId"
            },
            "region": {
              "type": "string",
              "pattern": "^[a-z]+-[a-z]+[0-9]+$"
            }
          },
          "required": [
            "provider"
          ],
          "if": {
            "properties": {
              "provider": {
                "const": "gcp"
              }
            }
          },
          "then": {
            "required": [
              "project",
              "region"
            ]
          },
          "else": {
            "properties": {
              "project": false,
              "region": false
            }
          }
        },
        "oauthSecret": {
          "type": "string",
          "maxLength": 253
        },
        "resendSecret": {
          "type": "string",
          "maxLength": 253
        },
        "resendFrom": {
          "type": "string",
          "pattern": "^$|^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "inviteUrl": {
          "type": "string"
        },
        "localMail": {
          "type": "string"
        },
        "authNats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tlsSecret": {
              "type": "string",
              "maxLength": 253,
              "description": "Secret with the NATS server trust roots in ca.crt."
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string"
        },
        "trustedProxyHops": {
          "type": "integer",
          "minimum": 0
        },
        "neg": {
          "type": "boolean"
        },
        "acme": {
          "type": [
            "null",
            "object"
          ],
          "description": "cert-manager ACME issuer spec."
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "nodePort": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/definitions/port"
                }
              ]
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "systemSql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string"
        }
      }
    },
    "applicationChart": {
      "type": "string"
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "pooler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxClientConnections", "control", "apply"],
          "properties": {
            "maxClientConnections": {
              "type": "integer",
              "minimum": 1
            },
            "control": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maxUserConnections", "maxDbConnections"],
              "properties": {
                "maxUserConnections": {"const": 8},
                "maxDbConnections": {"type": "integer", "minimum": 8}
              }
            },
            "apply": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maxUserConnections", "maxDbConnections", "queryWaitTimeout"],
              "properties": {
                "maxUserConnections": {"const": 16},
                "maxDbConnections": {"type": "integer", "minimum": 16},
                "queryWaitTimeout": {"const": 900}
              }
            }
          }
        }
      }
    },
    "runtime-operator": {
      "type": "object",
      "properties": {
        "operator": {
          "type": "object",
          "properties": {
            "watchNamespaces": {
              "type": "array",
              "maxItems": 0
            },
            "hostNamespaces": {
              "type": "array",
              "maxItems": 0
            },
            "extraArgs": {
              "type": "array",
              "items": {
                "type": "string",
                "not": {
                  "pattern": "^-{1,2}(watch|host)-namespaces($|=.+$)"
                }
              }
            }
          }
        },
        "runtime": {
          "type": "object",
          "properties": {
            "hostGroups": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      }
    },
    "nats": {
      "type": "object"
    },
    "plugin-barman-cloud": {
      "type": "object"
    },
    "opentelemetry-collector": {
      "type": "object"
    }
  },
  "required": [
    "provider",
    "platformDomain",
    "registry",
    "global"
  ],
  "if": {
    "properties": {
      "provider": {
        "const": "gcp"
      }
    }
  },
  "then": {
    "required": [
      "gcp"
    ]
  },
  "definitions": {
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
    },
    "bucket": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
