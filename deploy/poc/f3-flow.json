{
  "schema-version": "0.1",
  "flow-id": "escalate-stale-holds",
  "version": 1,
  "name": "F3 escalate-stale-holds",
  "nodes": [
    { "id": "cron", "type": "cron" },
    {
      "id": "cutoff-at-48h",
      "type": "time-shift",
      "config": {
        "base": "scheduled-at",
        "offset-ms": -172800000,
        "format": "iso",
        "key": "cutoff",
        "ctx": "@"
      }
    },
    {
      "id": "next-stale-hold",
      "type": "postgres-query",
      "config": {
        "mode": "query",
        "sql": "SELECT id, status, opened_at FROM quality_holds WHERE status = 'open' AND opened_at < $1::timestamptz ORDER BY opened_at, id LIMIT 1",
        "params": ["context().cutoff"]
      }
    },
    { "id": "found", "type": "conditional", "config": { "expression": "length(rows) > `0`" } },
    {
      "id": "mark",
      "type": "transform",
      "config": {
        "expression": "@",
        "ctx": "merge(context(), {hold: rows[0]})"
      }
    },
    {
      "id": "notify-manager",
      "type": "http-request",
      "credential": "notify-webhook",
      "config": {
        "method": "POST",
        "url": "https://notify.example/holds",
        "body": "context().hold",
        "idempotency-key": true
      }
    },
    {
      "id": "escalate-head",
      "type": "postgres-query",
      "config": {
        "mode": "execute",
        "sql": "UPDATE quality_holds SET status = 'escalated' WHERE id = $1::uuid AND status = 'open'",
        "params": ["context().hold.id"],
        "idempotent-with-key": true
      }
    },
    {
      "id": "notification-failed",
      "type": "fail",
      "config": { "code": "notification-failed" }
    }
  ],
  "edges": [
    { "from": "cron", "to": "cutoff-at-48h" },
    { "from": "cutoff-at-48h", "to": "next-stale-hold" },
    { "from": "next-stale-hold", "to": "found" },
    { "from": "found", "from-port": "true", "to": "mark" },
    { "from": "mark", "to": "notify-manager" },
    { "from": "notify-manager", "to": "escalate-head" },
    { "from": "notify-manager", "from-port": "error", "to": "notification-failed" },
    { "from": "escalate-head", "to": "next-stale-hold" }
  ],
  "credentials": [
    {
      "name": "notify-webhook",
      "kind": "api-key",
      "description": "manager notification endpoint"
    }
  ],
  "allowed-hosts": ["notify.example"]
}
