{
  "schema-version": "0.1",
  "flow-id": "disposition-recommendation",
  "version": 1,
  "name": "F2 disposition-recommendation",
  "nodes": [
    {
      "id": "request",
      "type": "request",
      "config": {
        "input-schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": ["hold", "history", "decision"],
          "properties": {
            "hold": {
              "type": "object",
              "required": ["material"],
              "properties": {
                "material": { "type": "string", "minLength": 1 },
                "reasons": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "moisture_pct": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
                },
                "moisture_max_pct": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
                },
                "weight_kg": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
                },
                "quantity_kg": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
                },
                "weight_tolerance_kg": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
                }
              },
              "anyOf": [
                { "required": ["moisture_pct", "moisture_max_pct"] },
                {
                  "required": [
                    "weight_kg",
                    "quantity_kg",
                    "weight_tolerance_kg"
                  ]
                }
              ],
              "additionalProperties": false
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["decision"],
                "properties": {
                  "decision": {
                    "enum": ["accept", "reject", "use-as-is"]
                  }
                },
                "additionalProperties": false
              }
            },
            "decision": {
              "enum": ["accept", "reject", "use-as-is"]
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "id": "recommend-disposition",
      "type": "disposition-recommendation"
    },
    {
      "id": "respond",
      "type": "respond",
      "config": {
        "status": 200
      }
    }
  ],
  "edges": [
    {
      "from": "request",
      "to": "recommend-disposition"
    },
    {
      "from": "recommend-disposition",
      "to": "respond"
    }
  ]
}
