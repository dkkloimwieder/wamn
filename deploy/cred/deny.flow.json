{
  "schema-version": "0.1",
  "flow-id": "egress-deny",
  "version": 1,
  "name": "Per-flow egress deny proof (fqg.11)",
  "nodes": [
    {
      "id": "in",
      "type": "request",
      "config": {
        "input-schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object"
        }
      }
    },
    {
      "id": "call",
      "type": "http-request",
      "config": { "method": "GET", "url": "{{echo}}" }
    },
    { "id": "out", "type": "respond", "config": { "status": 200 } }
  ],
  "edges": [
    { "from": "in", "to": "call" },
    { "from": "call", "to": "out" }
  ]
}
